<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
	xmlns="http://www.esferalia.com/webmail" targetNamespace="http://www.esferalia.com/webmail"
	elementFormDefault="qualified">
	<xs:element name="config">	
		<xs:complexType>
		    <xs:sequence>
		      <xs:element ref="webmail" />
		    </xs:sequence>				
			<xs:attribute name="version" type="xs:string" use="required" fixed="1.2"/>		    
		</xs:complexType>
	</xs:element>
	<xs:element name="webmail">
		<xs:complexType>
			<xs:attribute name="connect" type="xs:boolean" use="required"/>
			<xs:attribute name="showDomainMailAccounts" type="xs:boolean" use="required"/>
		</xs:complexType>
	</xs:element>
</xs:schema>