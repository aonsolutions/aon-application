<faces-config version="1.2"
	xmlns="http://java.sun.com/xml/ns/javaee"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://java.sun.com/xml/ns/javaee http://java.sun.com/xml/ns/javaee/web-facesconfig_1_2.xsd">

	<application>
		<resource-bundle>
		   <base-name>com.code.aon.ui.webmail.i18n.messages</base-name>
		   <var>webmailBundle</var>
		</resource-bundle>
	</application>

   <!-- ***************************************** -->
   <!-- ************ MANAGED BEANS ************** -->
   <!-- ***************************************** -->
	<managed-bean>
        <managed-bean-name>webmail</managed-bean-name>
        <managed-bean-class>
            com.code.aon.ui.webmail.controller.WebMailController
        </managed-bean-class>
        <managed-bean-scope>session</managed-bean-scope>
    </managed-bean>
	
	<!-- ************** TREE ************** -->
	<managed-bean>
        <managed-bean-name>webmailTree</managed-bean-name>
        <managed-bean-class>
            com.code.aon.ui.webmail.tree.FoldersTreeBean
        </managed-bean-class>
        <managed-bean-scope>session</managed-bean-scope>
    </managed-bean>
    
	<!-- ************** END TREE ************** -->
	
	<managed-bean>
        <managed-bean-name>webmailFolder</managed-bean-name>
        <managed-bean-class>
            com.code.aon.ui.webmail.controller.FolderController
        </managed-bean-class>
        <managed-bean-scope>session</managed-bean-scope>
    </managed-bean>
	
	<managed-bean>
        <managed-bean-name>webmailMessage</managed-bean-name>
        <managed-bean-class>
            com.code.aon.ui.webmail.controller.MessageController
        </managed-bean-class>
        <managed-bean-scope>session</managed-bean-scope>
    </managed-bean>
	
	<managed-bean>
        <managed-bean-name>webmailAttach</managed-bean-name>
        <managed-bean-class>
            com.code.aon.ui.webmail.controller.AttachController
        </managed-bean-class>
        <managed-bean-scope>session</managed-bean-scope>
    </managed-bean>

	<managed-bean>
        <managed-bean-name>webmailSearch</managed-bean-name>
        <managed-bean-class>
            com.code.aon.ui.webmail.controller.SearchController
        </managed-bean-class>
        <managed-bean-scope>session</managed-bean-scope>
    </managed-bean>
	
	<!-- ************ SIGNATURE ************** -->
	<managed-bean>
		<managed-bean-name>signature</managed-bean-name>
		<managed-bean-class>com.code.aon.ui.webmail.controller.SignatureController</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
		<managed-property>
			<property-name>queryOnStartUP</property-name>
			<value>true</value>
		</managed-property>
		<managed-property>
			<property-name>pojo</property-name>
			<value>com.code.aon.webmail.Signature</value>
		</managed-property>
		<managed-property>
			<property-name>beanName</property-name>
			<value>signature</value>
		</managed-property>
		<managed-property>
			<property-name>defaultOrder</property-name>
			<value>Signature_name</value>
		</managed-property>		
		<managed-property>
			<property-name>listenerClasses</property-name>
			<list-entries>
				<value-class>com.code.aon.ui.form.event.IControllerListener</value-class>
				<value>#{signatureControllerListener}</value>
			</list-entries>
		</managed-property>		
	</managed-bean>
	
	<managed-bean>
		<managed-bean-name>signatureControllerListener</managed-bean-name>
		<managed-bean-class>
			com.code.aon.ui.webmail.event.SignatureControllerListener
		</managed-bean-class>
		<managed-bean-scope>none</managed-bean-scope>
	</managed-bean>	


	<!-- ************ AUTOCOMPLETE ************** -->

	<managed-bean>
		<managed-bean-name>multiSelectionEmailBean</managed-bean-name>
		<managed-bean-class>
				com.code.aon.ui.webmail.controller.MultiSelectionEmailBean
			</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
	</managed-bean>
	
		<!-- ************ MAILACCOUNT ************** -->
	<managed-bean>
		<managed-bean-name>mailAccount</managed-bean-name>
		<managed-bean-class>com.code.aon.ui.webmail.controller.MailAccountController</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
		<managed-property>
			<property-name>queryOnStartUP</property-name>
			<value>true</value>
		</managed-property>
		<managed-property>
			<property-name>pojo</property-name>
			<value>com.code.aon.webmail.MailAccount</value>
		</managed-property>
		<managed-property>
			<property-name>beanName</property-name>
			<value>mailAccount</value>
		</managed-property>
		<managed-property>
			<property-name>defaultOrder</property-name>
			<value>MailAccount_email</value>
		</managed-property>		
		<managed-property>
			<property-name>listenerClasses</property-name>
			<list-entries>
				<value-class>com.code.aon.ui.form.event.IControllerListener</value-class>
				<value>#{mailAccountControllerListener}</value>
			</list-entries>
		</managed-property>		
	</managed-bean>
	
	<managed-bean>
		<managed-bean-name>mailAccountControllerListener</managed-bean-name>
		<managed-bean-class>
			com.code.aon.ui.webmail.event.MailAccountControllerListener
		</managed-bean-class>
		<managed-bean-scope>none</managed-bean-scope>
	</managed-bean>	

	<!-- ************ BWLIST ************** -->

	<managed-bean>
		<managed-bean-name>spam</managed-bean-name>
		<managed-bean-class>
				com.code.aon.ui.webmail.controller.SpamController
			</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
	</managed-bean>
	
	<!-- ************* CONTACT ***************** -->
	<managed-bean>
		<managed-bean-name>contact</managed-bean-name>
		<managed-bean-class>
			com.code.aon.ui.webmail.controller.ContactController
		</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
		<managed-property>
			<property-name>queryOnStartUP</property-name>
			<value>true</value>
		</managed-property>
		<managed-property>
			<property-name>pojo</property-name>
			<value>com.code.aon.webmail.Contact</value>
		</managed-property>
		<managed-property>
			<property-name>beanName</property-name>
			<value>contact</value>
		</managed-property>								
		<managed-property>
			<property-name>defaultOrder</property-name>
			<value>Contact_displayName</value>
		</managed-property>
	</managed-bean>	
	
	<!-- ***************************************** -->
    <!-- ************** CONVERTER ****************** -->
    <!-- ***************************************** -->
    <converter>
		<converter-id>longString</converter-id>
		<converter-class>
			com.code.aon.ui.webmail.converter.LongStringConverter
		</converter-class>
    </converter>

  <!-- ======================================================================= -->	
  <!-- =========================== Navigation Rules ========================== -->	
  <!-- ======================================================================= -->
  
	<navigation-rule>
		<navigation-case>
			<from-outcome>logout</from-outcome>
			<to-view-id>/home.jsf</to-view-id> 
			<redirect/>
		</navigation-case>
	</navigation-rule>
  
	<navigation-rule>
		<navigation-case>
			<from-outcome>login</from-outcome>
			<to-view-id>/home.xhtml</to-view-id>
			<redirect/>
		</navigation-case>
		<navigation-case>
			<from-outcome>folder</from-outcome>
			<to-view-id>/com/code/aon/ui/webmail/facelet/webmailFolder/folderView.xhtml</to-view-id>
		</navigation-case>
		<navigation-case>
			<from-outcome>message</from-outcome>
			<to-view-id>/com/code/aon/ui/webmail/facelet/webmailMessage/messageView.xhtml</to-view-id>
		</navigation-case>
		<navigation-case>
			<from-outcome>messageNew</from-outcome>
			<to-view-id>/com/code/aon/ui/webmail/facelet/webmailMessage/messageNew.xhtml</to-view-id>
		</navigation-case>
		<navigation-case>
			<from-outcome>messageSearch</from-outcome>
			<to-view-id>/com/code/aon/ui/webmail/facelet/webmailSearch/messageSearch.xhtml</to-view-id>
		</navigation-case>
		<navigation-case>
			<from-outcome>signature_list</from-outcome>
			<to-view-id>/com/code/aon/ui/webmail/facelet/signature/list.xhtml</to-view-id>
		</navigation-case>
		<navigation-case>
			<from-outcome>signature_form</from-outcome>
			<to-view-id>/com/code/aon/ui/webmail/facelet/signature/form.xhtml</to-view-id>
		</navigation-case>
		<navigation-case>
			<from-outcome>mailAccount_list</from-outcome>
			<to-view-id>/com/code/aon/ui/webmail/facelet/mailAccount/list.xhtml</to-view-id>
		</navigation-case>
		<navigation-case>
			<from-outcome>mailAccount_form</from-outcome>
			<to-view-id>/com/code/aon/ui/webmail/facelet/mailAccount/form.xhtml</to-view-id>
		</navigation-case>
		<navigation-case>
			<from-outcome>spam</from-outcome>
			<to-view-id>/com/code/aon/ui/webmail/facelet/spam/list.xhtml</to-view-id>
		</navigation-case>
	</navigation-rule>
	
	<!-- =================== Contact ================= -->	
	<navigation-rule>
		<navigation-case>
			<from-outcome>contact_form</from-outcome>
			<to-view-id>/com/code/aon/ui/webmail/facelet/contact/form.xhtml</to-view-id>
		</navigation-case>
		<navigation-case>
			<from-outcome>contact_list</from-outcome>
			<to-view-id>/com/code/aon/ui/webmail/facelet/contact/list.xhtml</to-view-id>
		</navigation-case>
		<navigation-case>
	        <from-outcome>contact_search</from-outcome>
	        <to-view-id>/com/code/aon/ui/webmail/facelet/contact/search.xhtml</to-view-id>
	    </navigation-case>
	</navigation-rule>	

</faces-config>
