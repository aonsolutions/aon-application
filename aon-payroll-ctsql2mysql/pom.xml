<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<parent>
		<groupId>com.code.aon</groupId>
		<artifactId>aon.parent</artifactId>
		<version>9.23-SNAPSHOT</version>
	</parent>
	<groupId>com.esferalia.aon</groupId>
	<artifactId>aon-payroll-ctsql2mysql</artifactId>
	<packaging>jar</packaging>

	<name>AON-PAYROLL-CTSQL2MYSQL</name>

	<properties>
		<project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
	</properties>

	<!--scm>
		<developerConnection>scm:svn:http://dev.esferalia.net/repos/aon-application/trunk/aon-payroll-ctsql2mysql</developerConnection>
		<connection>scm:svn:http://dev.esferalia.net/repos/aon-application/trunk/aon-payroll-ctsql2mysql</connection>
	</scm-->
	
	<dependencies>
		<dependency>
			<groupId>junit</groupId>
			<artifactId>junit</artifactId>
			<version>3.8.1</version>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>commons-cli</groupId>
			<artifactId>commons-cli</artifactId>
			<version>1.2</version>
			<scope>compile</scope>
			<optional>false</optional>
		</dependency>
		<dependency>
			<groupId>commons-lang</groupId>
			<artifactId>commons-lang</artifactId>
			<version>2.5</version>
			<scope>compile</scope>
			<optional>false</optional>
		</dependency>
		<dependency>
			<groupId>commons-codec</groupId>
			<artifactId>commons-codec</artifactId>
			<version>1.3</version>
			<scope>provided</scope>
		</dependency>
		<dependency>
			<groupId>com.transtools</groupId>
			<artifactId>ctsql-jdbc</artifactId>
			<version>2.2.3.6</version>
			<scope>runtime</scope>
			<optional>false</optional>
		</dependency>
		<dependency>
			<groupId>org.slf4j</groupId>
			<artifactId>slf4j-api</artifactId>
			<version>1.5.11</version>
			<scope>compile</scope>
			<optional>false</optional>
		</dependency>
		<dependency>
			<groupId>mysql</groupId>
			<artifactId>mysql-connector-java</artifactId>
			<version>5.1.10</version>
			<scope>runtime</scope>
			<optional>false</optional>
		</dependency>
		<dependency>
			<groupId>org.slf4j</groupId>
			<artifactId>slf4j-simple</artifactId>
			<version>1.5.11</version>
			<scope>runtime</scope>
			<optional>false</optional>
		</dependency>
		<dependency>
			<groupId>org.apache.velocity</groupId>
			<artifactId>velocity</artifactId>
			<version>1.6.3</version>
			<optional>false</optional>
		</dependency>
		<dependency>
			<groupId>com.code.aon</groupId>
			<artifactId>aon.registry</artifactId>
			<version>${project.version}</version>
			<scope>compile</scope>
			<optional>false</optional>
		</dependency>
		<dependency>
			<groupId>com.code.aon</groupId>
			<artifactId>aon.company</artifactId>
			<version>${project.version}</version>
			<scope>compile</scope>
			<optional>false</optional>
		</dependency>
		<dependency>
			<groupId>com.code.aon</groupId>
			<artifactId>aon.customer</artifactId>
			<version>${project.version}</version>
			<scope>compile</scope>
			<optional>false</optional>
		</dependency>

		<!--dependency>
			<groupId>com.den_4</groupId>
			<artifactId>inotify_java</artifactId>
			<version>2.0.2</version>
			<scope>compile</scope>
			<optional>false</optional>
		</dependency-->
		<dependency>
			<groupId>com.esferalia.aon</groupId>
			<artifactId>aon.payroll</artifactId>
			<version>${project.version}</version>
			<scope>compile</scope>
			<optional>false</optional>
		</dependency>
		<dependency>
			<groupId>com.esferalia.aon</groupId>
			<artifactId>aon.salary</artifactId>
			<version>${project.version}</version>
			<scope>compile</scope>
			<optional>false</optional>
		</dependency>
		<dependency>
			<groupId>com.esferalia.aon</groupId>
			<artifactId>aon.calendar</artifactId>
			<version>${project.version}</version>
			<scope>compile</scope>
			<optional>false</optional>
		</dependency>

		<dependency>
			<groupId>com.code.aon</groupId>
			<artifactId>aon-dbutils</artifactId>
			<version>${project.version}</version>
			<scope>compile</scope>
			<optional>false</optional>
		</dependency>
		<dependency>
			<groupId>com.code.aon</groupId>
			<artifactId>aon-master</artifactId>
			<version>${project.version}</version>
			<scope>compile</scope>
			<optional>false</optional>
		</dependency>

	</dependencies>

	<build>
		<plugins>
		</plugins>
	</build>

	<profiles>
		<profile>
			<id>rpm-release</id>
			<activation>
				<property>
					<name>rpm.release</name>
					<value>true</value>
				</property>
			</activation>
			<build>
				<plugins>
					<!-- Para construir el RPM -->
					<plugin>

						<groupId>org.codehaus.mojo</groupId>
						<artifactId>rpm-maven-plugin</artifactId>
						<version>2.0.1</version>
						<extensions>true</extensions>

						<executions>
							<execution>
								<id>rpm-build</id>
								<goals>
									<goal>attached-rpm</goal>
								</goals>
							</execution>
						</executions>

						<configuration>
							<group>Applications/Aon</group>
							<release>${buildNumber}</release>
							<copyright>2013, esferalia Networks S.A</copyright>
							<requires>
								<require>java</require>
								<require>vixie-cron</require>
								<require>inotify-java</require>
								<require>aon-dbutils</require>
								<require>aon-master</require>
								<require>jakarta-commons-lang</require>
								<require>jakarta-commons-codec</require>
								<require>jakarta-commons-logging</require>
								<require>mysql-connector-java</require>
							</requires>
							<mappings>

								<mapping>
									<directory>/usr/share/java</directory>
									<dependency>
										<includes>
											<include>org.slf4j:slf4j-api</include>
											<include>org.slf4j:slf4j-simple</include>
											<include>commons-cli:commons-cli</include>
											<include>com.code.aon:aon.config</include>
											<include>com.code.aon:aon.config</include>
											<include>com.code.aon:aon.common</include>
											<include>com.code.aon:aon.registry</include>
											<include>com.code.aon:aon.company</include>
											<include>com.code.aon:aon.customer</include>
											<include>com.esferalia.aon:aon.salary</include>
											<include>com.esferalia.aon:aon.payroll</include>
											<include>com.esferalia.aon:aon.calendar</include>
											<include>com.esferalia.aon:aon.entity.common</include>
											<include>com.transtools:ctsql-jdbc:2.2.3.6</include>
										</includes>
									</dependency>
									<sources>
										<source>
											<location>target</location>
											<includes>
												<include>${project.artifactId}-${project.version}.jar</include>
											</includes>
										</source>
										<softlinkSource>
											<location>/usr/share/java/commons-cli-1.2.jar</location>
											<destination>commons-cli.jar</destination>
										</softlinkSource>
										<softlinkSource>
											<location>/usr/share/java/slf4j-api-1.5.11.jar</location>
											<destination>slf4j-api.jar</destination>
										</softlinkSource>
										<softlinkSource>
											<location>/usr/share/java/slf4j-simple-1.5.11.jar</location>
											<destination>slf4j-simple.jar</destination>
										</softlinkSource>
										<softlinkSource>
											<location>/usr/share/java/${project.artifactId}-${project.version}.jar</location>
											<destination>${project.artifactId}.jar</destination>
										</softlinkSource>
										<softlinkSource>
											<location>/usr/share/java/aon.config-${project.version}.jar</location>
											<destination>aon-config.jar</destination>
										</softlinkSource>
										<softlinkSource>
											<location>/usr/share/java/aon.common-${project.version}.jar</location>
											<destination>aon-common.jar</destination>
										</softlinkSource>
										<softlinkSource>
											<location>/usr/share/java/aon.registry-${project.version}.jar</location>
											<destination>aon-registry.jar</destination>
										</softlinkSource>
										<softlinkSource>
											<location>/usr/share/java/aon.company-${project.version}.jar</location>
											<destination>aon-company.jar</destination>
										</softlinkSource>
										<softlinkSource>
											<location>/usr/share/java/aon.customer-${project.version}.jar</location>
											<destination>aon-customer.jar</destination>
										</softlinkSource>
										<softlinkSource>
											<location>/usr/share/java/aon.payroll-${project.version}.jar</location>
											<destination>aon-payroll.jar</destination>
										</softlinkSource>
										<softlinkSource>
											<location>/usr/share/java/aon.salary-${project.version}.jar</location>
											<destination>aon-salary.jar</destination>
										</softlinkSource>
										<softlinkSource>
											<location>/usr/share/java/aon.calendar-${project.version}.jar</location>
											<destination>aon-calendar.jar</destination>
										</softlinkSource>
										<softlinkSource>
											<location>/usr/share/java/aon.entity.common-${project.version}.jar</location>
											<destination>aon-entity-common.jar</destination>
										</softlinkSource>
										<softlinkSource>
											<location>/usr/share/java/ctsql-jdbc-2.2.3.6.jar</location>
											<destination>ctsql-jdbc.jar</destination>
										</softlinkSource>
										<softlinkSource>
											<location>/usr/share/java/javacsv-2.0.jar</location>
											<destination>javacsv.jar</destination>
										</softlinkSource>
										<softlinkSource>
											<location>/usr/share/java/log4jdbc-log4j2-jdbc4-1.15.jar</location>
											<destination>log4jdbc-log4j2-jdbc4.jar</destination>
										</softlinkSource>
									</sources>
								</mapping>

								<mapping>
									<sources>
										<source>
											<location>src/main/scripts/aon-payroll-ctsql2mysql</location>
										</source>
										<source>
											<location>src/main/scripts/aon-payroll-ctsql2mysqld</location>
										</source>
									</sources>
									<filemode>755</filemode>
									<directory>/usr/bin</directory>
								</mapping>

								<mapping>
									<sources>
										<source>
											<location>src/main/scripts/ctsql2mysqld</location>
										</source>
									</sources>
									<filemode>755</filemode>
									<directory>/etc/init.d</directory>
									<directoryIncluded>false</directoryIncluded>
								</mapping>

								<mapping>
									<sources>
										<source>
											<location>src/main/scripts/aon-payroll-ctsql2mysqld.conf</location>
										</source>
									</sources>
									<filemode>644</filemode>
									<directory>/etc</directory>
									<configuration>noreplace</configuration>
								</mapping>

								<mapping>
									<sources>
										<source>
											<location>src/main/scripts/ctsql2mysql</location>
										</source>
									</sources>
									<filemode>644</filemode>
									<directory>/etc/cron.d</directory>
									<directoryIncluded>false</directoryIncluded>
								</mapping>

							</mappings>

							<postinstallScriptlet>
								<scriptFile>src/main/scripts/postinstall</scriptFile>
								<fileEncoding>utf-8</fileEncoding>
							</postinstallScriptlet>

						</configuration>
					</plugin>


				</plugins>
			</build>
		</profile>
	</profiles>
</project>
