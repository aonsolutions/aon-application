<?xml version="1.0"?>
<components namespace="http://www.code.es/aon-ice-components">

	<component localName="commandButton">
    	<attribute name="styleClass" value="aon-form-input-text" />			
	</component>

	<component localName="commandLink">
    	<attribute name="styleClass" value="aon-navigation-link" />			
	</component>

	<component localName="confirmButton">
    	<attribute name="confirmAction" ignore="true" />			
    	<attribute name="confirmActionListener" ignore="true" />
    	<attribute name="confirmTitle" ignore="true" />
    	<attribute name="confirmMessage" ignore="true" />
	</component>

	<component localName="dataTable">
    	<attribute name="styleClass" value="aon-table" />			
    	<attribute name="headerClass" value="aon-table-header" />
    	<attribute name="footerClass" value="aon-table-footer" />
    	<attribute name="rowClasses" value="aon-table-row-odd, aon-table-row-even" />
	</component>

	<component localName="editDataTable">
    	<attribute name="styleClass" value="aon-edit-table" />			
    	<attribute name="headerClass" value="aon-edit-table-header" />
    	<attribute name="footerClass" value="aon-edit-table-footer" />
    	<attribute name="rowClasses" value="aon-edit-table-row-odd, aon-edit-table-row-even" />
	</component>

	<component localName="form">
    	<attribute name="styleClass" value="aon-form-input-text" />			
	</component>

	<component localName="graphicImage">
    	<attribute name="styleClass" value="aon-graphicImage" />			
	</component>

	<component localName="inputRichText">
    	<attribute name="styleClass" value="aon-form-input-text" />			
	</component>

	<component localName="inputSecret">
    	<attribute name="styleClass" value="aon-inputSecret" />			
	</component>

	<component localName="inputText">
    	<attribute name="styleClass" value="aon-form-input-text" />			
	</component>

	<component localName="inputTextarea">
    	<attribute name="styleClass" value="aon-form-input-text" />			
	</component>

	<component localName="messages">
    	<attribute name="showSummary" value="false" type="1" />			
    	<attribute name="showDetail" value="true" type="1" />
    	<attribute name="errorClass" value="aon-error-message" />
    	<attribute name="fatalClass" value="aon-fatal-error-message" />
    	<attribute name="infoClass" value="aon-info-message" />
	</component>

	<component localName="outputLabel">
    	<attribute name="styleClass" value="aon-outputLabel" />			
	</component>

	<component localName="outputText">
    	<attribute name="styleClass" value="aon-outputText" />			
	</component>

	<component localName="panelGrid">
    	<attribute name="styleClass" value="aon-panelGrid" />			
	</component>

	<component localName="rowSelector">
    	<attribute name="selectedClass" value="aon-table-row-selected" />
    	<attribute name="mouseOverClass" value="aon-table-row-hover" />
	</component>

	<component localName="selectBooleanCheckbox">
    	<attribute name="styleClass" value="aon-selectBooleanCheckbox" />			
	</component>

	<component localName="selectManyCheckbox">
    	<attribute name="styleClass" value="aon-selectManyCheckbox" />			
	</component>

	<component localName="selectOneMenu">
    	<attribute name="styleClass" value="aon-selectOneMenu" />			
	</component>

	<component localName="selectOneRadio">
    	<attribute name="styleClass" value="aon-selectOneRadio" />			
	</component>

</components>
