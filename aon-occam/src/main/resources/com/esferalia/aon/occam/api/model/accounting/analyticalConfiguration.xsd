<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<xs:schema version="1.0" xmlns:xs="http://www.w3.org/2001/XMLSchema">

  <xs:element name="analytical" type="JAXBAnalytical"/>

  <xs:complexType name="JAXBAnalytical">
    <xs:sequence>
      <xs:element name="configuration" type="JAXBAnalyticalConfiguration"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="JAXBAnalyticalConfiguration">
    <xs:sequence>
      <xs:element name="costCenter" type="JAXBAnalyticalCostCenter" nillable="true" minOccurs="0" maxOccurs="unbounded"/>
    </xs:sequence>
    <xs:attribute name="name" type="xs:string"/>
  </xs:complexType>
  
  <xs:complexType name="JAXBAnalyticalCostCenter">
    <xs:sequence>
      <xs:element name="accounts" type="JAXBAnalyticalAccounts"/>
      <xs:element name="entries" type="JAXBAnalyticalEntries"/>
    </xs:sequence>
    <xs:attribute name="name" type="xs:string" use="required"/>
    <xs:attribute name="percent" type="xs:double" use="required"/>
    <xs:attribute name="default" type="xs:boolean" use="required"/>
  </xs:complexType>

  <xs:complexType name="JAXBAnalyticalAccounts">
    <xs:sequence>
      <xs:element name="account" type="JAXBAnalyticalAccount" nillable="true" minOccurs="0" maxOccurs="unbounded"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="JAXBAnalyticalAccount">
    <xs:simpleContent>
      <xs:extension base="xs:string">
        <xs:attribute name="code" type="xs:string" use="required"/>
        <xs:attribute name="percent" type="xs:double" use="required"/>
      </xs:extension>
    </xs:simpleContent>
  </xs:complexType>

  <xs:complexType name="JAXBAnalyticalEntries">
    <xs:sequence>
      <xs:element name="entry" type="JAXBAnalyticalEntry"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="JAXBAnalyticalEntry">
    <xs:sequence>
      <xs:element name="accounts" type="JAXBAnalyticalAccounts"/>
    </xs:sequence>
    <xs:attribute name="id" type="xs:int" use="required"/>
  </xs:complexType>
</xs:schema>
