                <scope>provided</scope>
        </dependency>	
		<dependency>
    		<groupId>software.amazon.awssdk</groupId>
   			<artifactId>textract</artifactId>
    		<version>2.44.4</version>
	        <scope>provided</scope>
		</dependency>
	    <dependency>
                <groupId>es.translogia</groupId>
                <artifactId>tedi.api</artifactId>
                <version>${project.version}</version>
                <scope>provided</scope>
        </dependency>

	  </dependencies>
    </profile>
  </profiles>

</project>
