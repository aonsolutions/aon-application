<?xml version="1.0"?>
<!DOCTYPE faces-config PUBLIC
  "-//Sun Microsystems, Inc.//DTD JavaServer Faces Config 1.1//EN"
  "http://java.sun.com/dtd/web-facesconfig_1_1.dtd">

<faces-config>
	<!-- ************ tipovia LOOKUP ************** -->
        <managed-bean>
		<managed-bean-name>tipoviaLookup</managed-bean-name>
		<managed-bean-class>com.code.aon.faces.controller.RichLookupBean</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
		<managed-property>
			<property-name>beanName</property-name>
			<value>tipoviaLookup</value>
		</managed-property>
		<managed-property>
			<property-name>foreignPojo</property-name>
			<value>com.code.aon.payroll.tipos.Tipovia</value>
		</managed-property>
		<managed-property>
			<property-name>listPagePath</property-name>
			<value>/facelet/auxiliares/organismos_entidades/delegaciones/tipoViaLookup/list.xhtml</value>
		</managed-property>
	</managed-bean>

 <!--  ************ Provincia LOOKUP **************  -->	
	<managed-bean>
		<managed-bean-name>provinciaLookup</managed-bean-name>
		<managed-bean-class>com.code.aon.faces.controller.RichLookupBean</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
		<managed-property>
			<property-name>beanName</property-name>
			<value>provinciaLookup</value>
		</managed-property>
		<managed-property>
			<property-name>foreignPojo</property-name>
			<value>com.code.aon.payroll.auxiliares.organismosyentidades.Provincia</value>
		</managed-property>
		<managed-property>
			<property-name>listPagePath</property-name>
			<value>/facelet/auxiliares/organismos_entidades/delegaciones/provinciaLookup/list.xhtml</value>
		</managed-property>
	</managed-bean>	
	
	
</faces-config>