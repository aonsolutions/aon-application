<?xml version="1.0"?>
<!DOCTYPE faces-config PUBLIC
  "-//Sun Microsystems, Inc.//DTD JavaServer Faces Config 1.1//EN"
  "http://java.sun.com/dtd/web-facesconfig_1_1.dtd">

<faces-config>

	<managed-bean>
		<managed-bean-name>payrollController</managed-bean-name>
		<managed-bean-class>com.code.aon.ui.payroll.controller.PayrollController</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
	</managed-bean>

	<!-- ************* TIPOS DE DOCUMENTO ***************** -->
	<managed-bean>
		<managed-bean-name>tiposDocumento</managed-bean-name>
		<managed-bean-class>com.code.aon.ui.form.GridController</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
		<managed-property>
			<property-name>queryOnStartUP</property-name>
			<value>true</value>
		</managed-property>
		<managed-property>
			<property-name>pojo</property-name>
			<value>com.code.aon.payroll.tipos.Documento</value>
		</managed-property>
	</managed-bean>
	
	<!-- ************* TIPOS DE EMPRESARIOS ***************** -->
	<managed-bean>
		<managed-bean-name>tiposEmpresario</managed-bean-name>
		<managed-bean-class>com.code.aon.ui.form.GridController</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
		<managed-property>
			<property-name>queryOnStartUP</property-name>
			<value>true</value>
		</managed-property>
		<managed-property>
			<property-name>pojo</property-name>
			<value>com.code.aon.payroll.tipos.Empresario</value>
		</managed-property>
	</managed-bean>
	
	<!-- ************* TIPOS DE CNAE ***************** -->
	<managed-bean>
		<managed-bean-name>tiposCnae</managed-bean-name>
		<managed-bean-class>com.code.aon.ui.form.GridController</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
		<managed-property>
			<property-name>queryOnStartUP</property-name>
			<value>true</value>
		</managed-property>
		<managed-property>
			<property-name>pojo</property-name>
			<value>com.code.aon.payroll.tipos.Cnae</value>
		</managed-property>
		<managed-property>
			<property-name>listenerClasses</property-name>
			<list-entries>
				<value-class>com.code.aon.ui.form.event.IControllerListener</value-class>				
				<value>#{resourceControllerListener}</value>									
			</list-entries>
		</managed-property>		
	</managed-bean>
	
	<managed-bean>
		<managed-bean-name>resourceControllerListener</managed-bean-name>
		<managed-bean-class>
			com.esferalia.ui.scheduler.event.ResourceControllerListener
		</managed-bean-class>
		<managed-bean-scope>none</managed-bean-scope>
	</managed-bean>
	
	<!-- ************* TIPOS DE REGISTRO ***************** -->
	<managed-bean>
