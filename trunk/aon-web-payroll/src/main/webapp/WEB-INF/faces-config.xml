<faces-config version="1.2"
	xmlns="http://java.sun.com/xml/ns/javaee"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://java.sun.com/xml/ns/javaee http://java.sun.com/xml/ns/javaee/web-facesconfig_1_2.xsd">
	
	<application>
		<message-bundle>com.code.aon.ui.common.i18n.messages</message-bundle>
		<locale-config>
			<default-locale>es</default-locale>
			<supported-locale>en</supported-locale>
		</locale-config>
		<view-handler>com.sun.facelets.FaceletViewHandler</view-handler>
		<navigation-handler>com.code.aon.ui.audit.AuditNavigationHandler</navigation-handler>  
		<resource-bundle>
			<base-name>com.esferalia.aon.web.payroll.i18n.messages</base-name>
			<var>appBundle</var>
		</resource-bundle>
	</application>

	<!-- ********* ITransferObject CONVERTER ************* -->
	<converter>
	 <converter-for-class>com.code.aon.common.ITransferObject</converter-for-class>
	 <converter-class>com.code.aon.ui.common.converter.MappedTransferObjectConverter</converter-class>
	</converter>
	
	<!-- *************** RESOURCE RESOLVER ***************** --> 
	<managed-bean>
		<managed-bean-name>aonResource</managed-bean-name>
		<managed-bean-class>
			com.code.aon.ui.resources.bean.ResourceResolver
		</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
		<managed-property>
			<property-name>resourceURIPreffix</property-name>
			<value>/aonResource/5.0.0</value>
		</managed-property>		
	</managed-bean>

	<!--  **** AON CONFIGURATION **** -->
	<managed-bean>
		<managed-bean-name>aonConfiguration</managed-bean-name>
		<managed-bean-class>
			com.code.aon.ui.common.controller.ConfigurationController
		</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
		<managed-property>
			<property-name>styleSheets</property-name>
			<list-entries>
				<value>#{aonResource.resolve['/aon-richCss.css']}</value>
<!-- 				
				<value>#{aonResource.resolveLocal['/css/payroll.css']}</value>
 -->
			</list-entries>
		</managed-property>
	</managed-bean>

	<!-- *************************************** -->
	<!-- ************ NAVIGATION *************** -->
	<!-- *************************************** -->

	<navigation-rule>
		<navigation-case>
			<from-outcome>logout</from-outcome>
			<to-view-id>/home.jsf</to-view-id>
			<redirect />
		</navigation-case>
	</navigation-rule>

	<!-- =================== Application Menu Navigation Rules ================= -->	
	<navigation-rule>
		<navigation-case>
			<from-outcome>menu_procesos</from-outcome>
			<to-view-id>/facelet/menu/procesos.xhtml</to-view-id> 
		</navigation-case>
		<navigation-case>
			<from-outcome>menu_config</from-outcome>
			<to-view-id>/facelet/menu/config.xhtml</to-view-id> 
		</navigation-case>		
	</navigation-rule>

</faces-config>