<?xml version="1.0"?>
<!DOCTYPE faces-config PUBLIC
  "-//Sun Microsystems, Inc.//DTD JavaServer Faces Config 1.1//EN"
  "http://java.sun.com/dtd/web-facesconfig_1_1.dtd">
<faces-config>
	
	<!--  ********* CUSTOMER CONVERTER ***************** -->
	<converter>
		<converter-id>CustomerRegistryConverter</converter-id>
		<converter-class>com.code.aon.ui.customer.converter.CustomerRegistryConverter</converter-class>
	</converter>
	
	<!--  ********* CUSTOMER COLLECTIONS ***************** -->
	<managed-bean>
		<managed-bean-name>customerCollections</managed-bean-name>
		<managed-bean-class> com.code.aon.ui.customer.controller.CustomerCollectionsController 
		</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
	</managed-bean>

	<!--  ********* CUSTOMER WIZARD  ***************** -->
	<managed-bean>
		<managed-bean-name>customerWizard</managed-bean-name>
		<managed-bean-class> com.code.aon.ui.customer.controller.CustomerWizard </managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
	</managed-bean>
	<!--  **** CUSTOMER **** -->
	<managed-bean>
		<managed-bean-name>customer</managed-bean-name>
		<managed-bean-class> com.code.aon.ui.customer.controller.CustomerController</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
		<managed-property>
			<property-name>queryOnStartUP</property-name>
			<value>false</value>
		</managed-property>
		<managed-property>
			<property-name>beanName</property-name>
			<value>customer</value>
		</managed-property>
		<managed-property>
			<property-name>pojo</property-name>
			<value>com.code.aon.customer.Customer</value>
		</managed-property>
		<managed-property>
			<property-name>defaultOrder</property-name>
			<value>Customer_registry_surname,Customer_registry_name</value>
		</managed-property>
		<managed-property>
			<property-name>listenerClasses</property-name>
			<value>#{customerListeners}</value>
		</managed-property>
	</managed-bean>

	<managed-bean>
		<managed-bean-name>customerListeners</managed-bean-name>
	    <managed-bean-class>java.util.LinkedList</managed-bean-class>
		<managed-bean-scope>none</managed-bean-scope>
		<list-entries>
			<value-class>
				com.code.aon.ui.form.event.IControllerListener
			</value-class>
				<value>#{customerAddressListener}</value>
				<value>#{customerMediaListener}</value>
				<value>#{customerScopeListener}</value>				
				<value>#{customerObservationListener}</value>
		</list-entries>
	</managed-bean>

	<managed-bean>
		<managed-bean-name>customerScopeListener</managed-bean-name>
		<managed-bean-class>com.code.aon.ui.config.event.ScopeFilterListener</managed-bean-class>
		<managed-bean-scope>none</managed-bean-scope>
		<managed-property>
			<property-name>aliasName</property-name>
			<value>Customer_scope_id</value>
		</managed-property>
	</managed-bean>
	
	<managed-bean>
		<managed-bean-name>customerObservationListener</managed-bean-name>
		<managed-bean-class>com.code.aon.ui.customer.event.CustomerObservationListener</managed-bean-class>
		<managed-bean-scope>none</managed-bean-scope>
	</managed-bean>
	
	<managed-bean>
		<managed-bean-name>customerChildListener</managed-bean-name>
		<managed-bean-class> com.code.aon.ui.form.listener.ChildControllerListener</managed-bean-class>
		<managed-bean-scope>none</managed-bean-scope>
		<managed-property>
			<property-name>masterBean</property-name>
			<value>customer.registry</value>
		</managed-property>
		<managed-property>
			<property-name>masterPropertyName</property-name>
			<value>registry</value>
		</managed-property>
	</managed-bean>

	<!-- ****** Customer Observation ******** -->
	<managed-bean>
		<managed-bean-name>customerObservation</managed-bean-name>
		<managed-bean-class> com.code.aon.ui.registry.controller.RegistryObservationController 
		</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
	</managed-bean>

	<!--  **** ADDRESS **** -->
	<managed-bean>
		<managed-bean-name>customerAddress</managed-bean-name>
		<managed-bean-class> com.code.aon.ui.customer.controller.CustomerAddressController 
		</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
		<managed-property>
			<property-name>pojo</property-name>
			<value>com.code.aon.registry.RegistryAddress</value>
		</managed-property>
		<managed-property>
			<property-name>listenerClasses</property-name>
			<list-entries>
				<value-class>com.code.aon.ui.form.event.IControllerListener 
				</value-class>
				<value>#{customerChildListener}</value>
			</list-entries>
		</managed-property>
	</managed-bean>
	<managed-bean>
		<managed-bean-name>customerAddressListener</managed-bean-name>
		<managed-bean-class> com.code.aon.ui.form.listener.MasterControllerListener</managed-bean-class>
		<managed-bean-scope>none</managed-bean-scope>
		<managed-property>
			<property-name>childBean</property-name>
			<value>customerAddress</value>
		</managed-property>
		<managed-property>
			<property-name>aliasMap</property-name>
			<map-entries>
				<map-entry>
					<key>RegistryAddress_registry_id</key>
					<value>id</value>
				</map-entry>
			</map-entries>
		</managed-property>
	</managed-bean>

	<!--  **** MEDIA **** -->
	<managed-bean>
		<managed-bean-name>customerMedia</managed-bean-name>
		<managed-bean-class> com.code.aon.ui.customer.controller.CustomerMediaController 
		</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
		<managed-property>
			<property-name>pojo</property-name>
			<value>com.code.aon.registry.RegistryMedia</value>
		</managed-property>
		<managed-property>
			<property-name>listenerClasses</property-name>
			<list-entries>
				<value-class>com.code.aon.ui.form.event.IControllerListener 
				</value-class>
				<value>#{customerChildListener}</value>
			</list-entries>
		</managed-property>
	</managed-bean>
	<managed-bean>
		<managed-bean-name>customerMediaListener</managed-bean-name>
		<managed-bean-class> com.code.aon.ui.form.listener.MasterControllerListener</managed-bean-class>
		<managed-bean-scope>none</managed-bean-scope>
		<managed-property>
			<property-name>childBean</property-name>
			<value>customerMedia</value>
		</managed-property>
		<managed-property>
			<property-name>aliasMap</property-name>
			<map-entries>
				<map-entry>
					<key>RegistryMedia_registry_id</key>
					<value>id</value>
				</map-entry>
			</map-entries>
		</managed-property>
	</managed-bean>

	<!-- ************ CUSTOMER LOOKUP ************** -->
	<managed-bean>
		<managed-bean-name>customerLookup</managed-bean-name>
		<managed-bean-class>com.code.aon.faces.controller.RichLookupBean</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
		<managed-property>
			<property-name>beanName</property-name>
			<value>customerLookup</value>
		</managed-property>
		<managed-property>
			<property-name>foreignPojo</property-name>
			<value>com.code.aon.customer.Customer</value>
		</managed-property>
		<managed-property>
			<property-name>listPagePath</property-name>
			<value>/com/code/aon/ui/customer/facelet/lookup/customer/list.xhtml</value>
		</managed-property>
		<managed-property>
			<property-name>searchPagePath</property-name>
			<value>/com/code/aon/ui/customer/facelet/lookup/customer/search.xhtml</value>
		</managed-property>
	</managed-bean>

	<!-- =================== Customer ========================== -->
	<navigation-rule>
		<navigation-case>
			<from-outcome>customer_form</from-outcome>
			<to-view-id>/com/code/aon/ui/customer/facelet/customer/form.xhtml</to-view-id>
		</navigation-case>
		<navigation-case>
			<from-outcome>customer_list</from-outcome>
			<to-view-id>/com/code/aon/ui/customer/facelet/customer/list.xhtml</to-view-id>
		</navigation-case>
		<navigation-case>
			<from-outcome>customer_search</from-outcome>
			<to-view-id>/com/code/aon/ui/customer/facelet/customer/search.xhtml</to-view-id>
		</navigation-case>
	</navigation-rule>
</faces-config>