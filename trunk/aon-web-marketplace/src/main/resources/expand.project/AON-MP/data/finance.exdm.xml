<?xml version="1.0" encoding="UTF-8"?>
<table tableName="finance">
    <columns>
        <column label="Identificador unico del Vencimiento" name="id"
            sqlType="integer" type="integer"/>
        <column label="Indica si es un pago o un cobro" length="1"
            name="payment" sqlType="bit" type="string"/>
        <column label="Identificador del Cliente o Proveedor"
            name="registry" sqlType="integer" type="integer"/>
        <column label="Importe del Vencimiento" name="amount"
            sqlType="double" type="double"/>
        <column label="Concepto del Vencimiento" length="64"
            name="concept" sqlType="varchar" type="string"/>
        <column label="Identificador de la Factura" name="invoice"
            sqlType="integer" type="integer"/>
        <column label="Fecha de Vencimiento" name="due_date"
            sqlType="date" type="date"/>
        <column label="Identificador de la Forma de Pago"
            name="pay_method" sqlType="integer" type="integer"/>
        <column
            label="Identificador de la Entidad Bancaria del Vencimiento"
            name="bank" sqlType="integer" type="integer"/>
        <column
            label="Numero de cuenta en la Entidad Bancaria del Vencimiento"
            length="30" name="bank_account" sqlType="varchar" type="string"/>
        <column label="Estado del Vencimiento" length="2" name="status"
            sqlType="tinyint" type="string"/>
        <column label="Nivel de seguridad del Vencimiento" length="2"
            name="security_level" sqlType="tinyint" type="string"/>
    </columns>
    <virtualColumns/>
    <primaryKey>
        <column name="id"/>
    </primaryKey>
    <joins>
        <join description="finance_ibfk_1" foreignPath="data/registry.exdm.xml">
            <sourceColumns>
                <column name="registry"/>
            </sourceColumns>
        </join>
        <join description="finance_ibfk_2" foreignPath="data/pay_method.exdm.xml">
            <sourceColumns>
                <column name="pay_method"/>
            </sourceColumns>
        </join>
        <join description="finance_ibfk_3" foreignPath="data/bank.exdm.xml">
            <sourceColumns>
                <column name="bank"/>
            </sourceColumns>
        </join>
        <join description="finance_ibfk_4" foreignPath="data/invoice.exdm.xml">
            <sourceColumns>
                <column name="invoice"/>
            </sourceColumns>
        </join>
    </joins>
    <descriptionColumns/>
</table>
