<?xml version="1.0" encoding="ISO-8859-1"?>
<server>

  <mbean code="com.code.aon.jaas.vendor.jboss.JBossMainDeployer"
         name="jboss.admin:service=AonMainDeployer">         
		<attribute name="ConfigResource">file:/home/COMMON-RESOURCES/aon.workspace/deployed.xml</attribute>
		<depends>jboss.jmx:alias=jmx/rmi/RMIAdaptor</depends>
  </mbean>

  <mbean code="com.code.aon.jaas.vendor.jboss.JBossSecurity"
         name="jboss.admin:service=AonSecurity">
		<depends>jboss.admin:service=AonMainDeployer</depends>
  </mbean>

  <mbean code="com.code.aon.jaas.vendor.jboss.JBossSessionManager"
         name="jboss.admin:service=AonSessionManager">
		<depends>jboss.admin:service=AonMainDeployer</depends>
  </mbean>

</server>