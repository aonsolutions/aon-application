<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
	<parent>
		<groupId>com.code.aon</groupId>
		<artifactId>aon.parent</artifactId>
		<version>1.0.0</version>
	</parent>
	<modelVersion>4.0.0</modelVersion>
	<groupId>com.code.aon</groupId>
	<artifactId>aon.security</artifactId>
	<version>1.2.2</version>
	<description>AON SECURITY</description>
	<name>AON SECURITY</name>
	<dependencies>
		<dependency>
			<groupId>commons-digester</groupId>
			<artifactId>commons-digester</artifactId>
			<version>1.7</version>
			<scope>compile</scope>
		</dependency>

		<dependency>
			<groupId>com.oracle</groupId>
			<artifactId>ojdbc14</artifactId>
			<version>10.2.0.2.0</version>
			<scope>compile</scope>
		</dependency>

		<dependency>
			<groupId>jboss</groupId>
			<artifactId>jboss-system</artifactId>
			<version>4.2.1.GA</version>
			<scope>provided</scope>
		</dependency>

		<dependency>
			<groupId>jboss</groupId>
			<artifactId>jboss-jmx</artifactId>
			<version>4.2.1.GA</version>
			<scope>provided</scope>
		</dependency>

		<dependency>
			<groupId>org.apache.tomcat</groupId>
			<artifactId>coyote</artifactId>
			<version>6.0.13</version>
			<scope>provided</scope>
		</dependency>

		<dependency>
			<groupId>xdoclet</groupId>
			<artifactId>maven-xdoclet-plugin</artifactId>
			<version>1.2.3</version>
			<type>plugin</type>
		</dependency>

	</dependencies>					
					
	<profiles>
		<profile>
			<id>JBOSS-SAR-4.2.1</id>
			<build>
				<plugins>
					<plugin>
						<artifactId>xdoclet-maven-plugin</artifactId>
						  <groupId>org.codehaus.mojo</groupId>
						  <version>1.0-alpha-1</version>
						<executions>
						    <execution>
						      <phase>generate-sources</phase>
						      <goals>
						        <goal>xdoclet</goal>
						      </goals>
						      <configuration>
						        <tasks>
						
								    <jmxdoclet destdir="${basedir}/src/main/java" excludedtags="@version,@author">
								      <fileset dir="${basedir}/src/main/java">
								        <include name="com/code/aon/jaas/vendor/jboss/*.java"/>
								        <include name="com/code/aon/jaas/vendor/tomcat/*.java"/>
								      </fileset>
								      <mbeaninterface mergedir="${basedir}/templates"/>
								    </jmxdoclet>
						          
						        </tasks>
						      </configuration>
							</execution>
						</executions>
					</plugin>
					<plugin>
						<groupId>net.sf.maven-sar</groupId>
						<artifactId>maven-sar-plugin</artifactId>
						<version>1.0</version>
						<extensions>true</extensions>
					</plugin>
					<plugin>
						<artifactId>maven-jar-plugin</artifactId>
						<executions>
							<execution>
								<goals>
									<goal>jar</goal>
								</goals>
								<phase>package</phase>
							</execution>
						</executions>
						<configuration>
							<classifier>jar</classifier>
						</configuration>
					</plugin>
				</plugins>
			</build>
		</profile>
	</profiles>
	<packaging>sar</packaging>
</project>