<?xml version="1.0" encoding="UTF-8" ?>
<config
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.esferalia.com/finance finance.xsd"
	xmlns="http://www.esferalia.com/config" >
	<company:config version="1.0" xmlns:company="http://www.esferalia.com/company">
		<company:company 
			showRegistryBank="true" showCompanyOtherData="true"
			showPanelTabSet="false" showDigitalCertificate="false"
		/>
	</company:config>
	<customer:config version="1.0" xmlns:customer="http://www.esferalia.com/customer">
		<customer:customer
			showFinanceData="true" showProjectData="false"
			showFinanceFeeData="false" showAccount="true"
			showTariff="false" showSegment="false"
		/>
	</customer:config>
</config>
