<?xml version="1.0"?>
<!DOCTYPE faces-config PUBLIC
  "-//Sun Microsystems, Inc.//DTD JavaServer Faces Config 1.1//EN"
  "http://java.sun.com/dtd/web-facesconfig_1_1.dtd">

<faces-config>
	<!-- ************** LANGUAGE ************** -->
	<managed-bean>
		<managed-bean-name>i18n</managed-bean-name>
		<managed-bean-class>com.code.aon.ui.cms.controller.I18NController</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
	</managed-bean>

	<!-- ************** CONFIG ************** -->
	<managed-bean>
		<managed-bean-name>config</managed-bean-name>
		<managed-bean-class>com.code.aon.ui.cms.controller.ConfigController</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
		<managed-property>
			<property-name>pojo</property-name>
			<value>com.code.aon.cms.Config</value>
		</managed-property>
	</managed-bean>

	<!-- ************** LANGUAGE ************** -->
	<managed-bean>
		<managed-bean-name>language</managed-bean-name>
		<managed-bean-class>com.code.aon.ui.cms.controller.LanguageController</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
		<managed-property>
			<property-name>pojo</property-name>
			<value>com.code.aon.cms.Language</value>
		</managed-property>
	</managed-bean>

	<!-- ************** GENERIC PAGE ************** -->
	<managed-bean>
		<managed-bean-name>generic_page</managed-bean-name>
		<managed-bean-class>com.code.aon.ui.cms.controller.GenericPageController</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
		<managed-property>
			<property-name>pojo</property-name>
			<value>com.code.aon.cms.GenericPage</value>
		</managed-property>
		<managed-property>
			<property-name>pojoI18n</property-name>
			<value>com.code.aon.cms.GenericPageDetail</value>
		</managed-property>
		<managed-property>
			<property-name>joinAlias</property-name>
			<value>GenericPageDetail_generic_page_id</value>
		</managed-property>
		<managed-property>
			<property-name>languageAlias</property-name>
			<value>GenericPageDetail_language_id</value>
		</managed-property>
		<managed-property>
			<property-name>queryOnStartUP</property-name>
			<value>true</value>
		</managed-property>
	</managed-bean>

	<!-- ************** MENU ************** -->
	<managed-bean>
		<managed-bean-name>menu</managed-bean-name>
		<managed-bean-class>com.code.aon.ui.cms.controller.MenuController</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
		<managed-property>
			<property-name>pojo</property-name>
			<value>com.code.aon.cms.Menu</value>
		</managed-property>
	</managed-bean>

	<!-- ************** MENU OPTION ************** -->
	<managed-bean>
		<managed-bean-name>menu_option</managed-bean-name>
		<managed-bean-class>com.code.aon.ui.cms.controller.MenuOptionController</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
		<managed-property>
			<property-name>pojo</property-name>
			<value>com.code.aon.cms.MenuOption</value>
		</managed-property>
		<managed-property>
			<property-name>pojoI18n</property-name>
			<value>com.code.aon.cms.MenuOptionDetail</value>
		</managed-property>
		<managed-property>
			<property-name>joinAlias</property-name>
			<value>MenuOptionDetail_menu_option_id</value>
		</managed-property>
		<managed-property>
			<property-name>languageAlias</property-name>
			<value>MenuOptionDetail_language_id</value>
		</managed-property>
		<managed-property>
			<property-name>queryOnStartUP</property-name>
			<value>true</value>
		</managed-property>
	</managed-bean>

	<!-- ************** LINK CATEGORY ************** -->
	<managed-bean>
		<managed-bean-name>link_category</managed-bean-name>
		<managed-bean-class>com.code.aon.ui.cms.controller.LinkCategoryController</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
		<managed-property>
			<property-name>pojo</property-name>
			<value>com.code.aon.cms.LinkCategory</value>
		</managed-property>
		<managed-property>
			<property-name>pojoI18n</property-name>
			<value>com.code.aon.cms.LinkCategoryDetail</value>
		</managed-property>
		<managed-property>
			<property-name>joinAlias</property-name>
			<value>LinkCategoryDetail_linkCategory_id</value>
		</managed-property>
		<managed-property>
			<property-name>languageAlias</property-name>
			<value>LinkCategoryDetail_language_id</value>
		</managed-property>
		<managed-property>
			<property-name>queryOnStartUP</property-name>
			<value>true</value>
		</managed-property>
		<managed-property>
			<property-name>listenerClasses</property-name>
			<list-entries>
				<value-class>com.code.aon.ui.form.event.IControllerListener</value-class>
				<value>#{linkCategoryListener}</value>
			</list-entries>
		</managed-property>
	</managed-bean>

	<managed-bean>
		<managed-bean-name>linkCategoryListener</managed-bean-name>
		<managed-bean-class>com.code.aon.ui.cms.event.LinkCategoryControllerListener</managed-bean-class>
		<managed-bean-scope>none</managed-bean-scope>
	</managed-bean>

	<!-- ************** LINK ************** -->
	<managed-bean>
		<managed-bean-name>link</managed-bean-name>
		<managed-bean-class>com.code.aon.ui.cms.controller.LinkController</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
		<managed-property>
			<property-name>pojo</property-name>
			<value>com.code.aon.cms.Link</value>
		</managed-property>
		<managed-property>
			<property-name>pojoI18n</property-name>
			<value>com.code.aon.cms.LinkDetail</value>
		</managed-property>
		<managed-property>
			<property-name>joinAlias</property-name>
			<value>LinkDetail_link_id</value>
		</managed-property>
		<managed-property>
			<property-name>languageAlias</property-name>
			<value>LinkDetail_language_id</value>
		</managed-property>
		<managed-property>
			<property-name>queryOnStartUP</property-name>
			<value>true</value>
		</managed-property>
		<managed-property>
			<property-name>listenerClasses</property-name>
			<list-entries>
				<value-class>com.code.aon.ui.form.event.IControllerListener</value-class>
				<value>#{linkListener}</value>
			</list-entries>
		</managed-property>
	</managed-bean>

	<managed-bean>
		<managed-bean-name>linkListener</managed-bean-name>
		<managed-bean-class>com.code.aon.ui.cms.event.LinkControllerListener</managed-bean-class>
		<managed-bean-scope>none</managed-bean-scope>
	</managed-bean>

	<!-- ************** FAQ CATEGORY ************** -->
	<managed-bean>
		<managed-bean-name>faq_category</managed-bean-name>
		<managed-bean-class>com.code.aon.ui.cms.controller.FaqCategoryController</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
		<managed-property>
			<property-name>pojo</property-name>
			<value>com.code.aon.cms.FaqCategory</value>
		</managed-property>
		<managed-property>
			<property-name>pojoI18n</property-name>
			<value>com.code.aon.cms.FaqCategoryDetail</value>
		</managed-property>
		<managed-property>
			<property-name>joinAlias</property-name>
			<value>FaqCategoryDetail_faqCategory_id</value>
		</managed-property>
		<managed-property>
			<property-name>languageAlias</property-name>
			<value>FaqCategoryDetail_language_id</value>
		</managed-property>
		<managed-property>
			<property-name>queryOnStartUP</property-name>
			<value>true</value>
		</managed-property>
		<managed-property>
			<property-name>listenerClasses</property-name>
			<list-entries>
				<value-class>com.code.aon.ui.form.event.IControllerListener</value-class>
				<value>#{faqCategoryListener}</value>
			</list-entries>
		</managed-property>
	</managed-bean>

	<managed-bean>
		<managed-bean-name>faqCategoryListener</managed-bean-name>
		<managed-bean-class>com.code.aon.ui.cms.event.FaqCategoryControllerListener</managed-bean-class>
		<managed-bean-scope>none</managed-bean-scope>
	</managed-bean>

	<!-- ************** FAQ ************** -->
	<managed-bean>
		<managed-bean-name>faq</managed-bean-name>
		<managed-bean-class>com.code.aon.ui.cms.controller.FaqController</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
		<managed-property>
			<property-name>pojo</property-name>
			<value>com.code.aon.cms.Faq</value>
		</managed-property>
		<managed-property>
			<property-name>pojoI18n</property-name>
			<value>com.code.aon.cms.FaqDetail</value>
		</managed-property>
		<managed-property>
			<property-name>joinAlias</property-name>
			<value>FaqDetail_faq_id</value>
		</managed-property>
		<managed-property>
			<property-name>languageAlias</property-name>
			<value>FaqDetail_language_id</value>
		</managed-property>
		<managed-property>
			<property-name>queryOnStartUP</property-name>
			<value>true</value>
		</managed-property>
		<managed-property>
			<property-name>listenerClasses</property-name>
			<list-entries>
				<value-class>com.code.aon.ui.form.event.IControllerListener</value-class>
				<value>#{faqListener}</value>
			</list-entries>
		</managed-property>
	</managed-bean>

	<managed-bean>
		<managed-bean-name>faqListener</managed-bean-name>
		<managed-bean-class>com.code.aon.ui.cms.event.FaqControllerListener</managed-bean-class>
		<managed-bean-scope>none</managed-bean-scope>
	</managed-bean>

	<!-- ************** TEMPLATES ************** -->
	<managed-bean>
		<managed-bean-name>template</managed-bean-name>
		<managed-bean-class>com.code.aon.ui.cms.controller.TemplateController</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
	</managed-bean>

	<!-- ************** GENERATOR ************** -->
	<managed-bean>
		<managed-bean-name>generator</managed-bean-name>
		<managed-bean-class>com.code.aon.ui.cms.controller.GeneratorController</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
		<managed-property>
			<property-name>pojo</property-name>
			<value>com.code.aon.cms.Config</value>
		</managed-property>
	</managed-bean>

	<!-- ************** PREVIEW ************** -->
	<managed-bean>
		<managed-bean-name>preview</managed-bean-name>
		<managed-bean-class>com.code.aon.ui.cms.controller.PreviewController</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
	</managed-bean>

	<!-- ************** GALLERY ************** -->
	<managed-bean>
		<managed-bean-name>gallery</managed-bean-name>
		<managed-bean-class>com.code.aon.ui.cms.controller.GalleryController</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
	</managed-bean>

</faces-config>
