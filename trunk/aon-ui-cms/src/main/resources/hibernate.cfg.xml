<!DOCTYPE hibernate-configuration PUBLIC
	"-//Hibernate/Hibernate Configuration DTD 3.0//EN"
	"http://hibernate.sourceforge.net/hibernate-configuration-3.0.dtd">

<hibernate-configuration>

	<session-factory>

		<property name="connection.provider_class">com.code.aon.common.dao.hibernate.DBCPConnectionProvider</property>
		<property name="connection.service">jboss.admin:service=AonSecurity</property>

		<property name="connection.datasource">java:comp/env/jdbc/CMS</property>
		<property name="show_sql">true</property>
		<property name="dialect">org.hibernate.dialect.MySQLInnoDBDialect</property>

		<!-- Mapping files -->
		<mapping class="com.code.aon.cms.Language"/>
		<mapping class="com.code.aon.cms.Config"/>
		<mapping class="com.code.aon.cms.ConfigDetail"/>
		<mapping class="com.code.aon.cms.GenericPage"/>
		<mapping class="com.code.aon.cms.GenericPageDetail"/>
		<mapping class="com.code.aon.cms.Menu"/>
		<mapping class="com.code.aon.cms.MenuOption"/>
		<mapping class="com.code.aon.cms.MenuOptionDetail"/>
		<mapping class="com.code.aon.cms.Header"/>
		<mapping class="com.code.aon.cms.HeaderDetail"/>
		<mapping class="com.code.aon.cms.Footer"/>
		<mapping class="com.code.aon.cms.FooterDetail"/>
		<mapping class="com.code.aon.cms.Link"/>
		<mapping class="com.code.aon.cms.LinkDetail"/>
		<mapping class="com.code.aon.cms.LinkCategory"/>
		<mapping class="com.code.aon.cms.LinkCategoryDetail"/>
		<mapping class="com.code.aon.cms.Faq"/>
		<mapping class="com.code.aon.cms.FaqDetail"/>
		<mapping class="com.code.aon.cms.FaqCategory"/>
		<mapping class="com.code.aon.cms.FaqCategoryDetail"/>
		<mapping class="com.code.aon.cms.Brand"/>
		<mapping class="com.code.aon.cms.BrandDetail"/>
		<mapping class="com.code.aon.cms.ProductCategory"/>
		<mapping class="com.code.aon.cms.ProductCategoryDetail"/>
		<mapping class="com.code.aon.cms.Product"/>
		<mapping class="com.code.aon.cms.ProductDetail"/>
		<mapping class="com.code.aon.cms.Article"/>
		<mapping class="com.code.aon.cms.ArticleDetail"/>
		<mapping class="com.code.aon.cms.ArticleCategory"/>
		<mapping class="com.code.aon.cms.ArticleCategoryDetail"/>

	</session-factory>

</hibernate-configuration>