<?xml version="1.0" encoding="ISO-8859-1"?>

<!DOCTYPE report-config 
	PUBLIC "-//CODE-AON//DTD Report Config//EN" 
	"http://co-de.com/aon/report-config.dtd">

<report-config>
	
	<report id="customerReport" description="Customer report ">
		<template path="/com/code/aon/ui/registry/report/masterRegistryList.jasper" />
		<bean key="com.code.aon.customer.Customer" />
		<criteria provider="#{customer}"/>
		<params>
			<param id="REPORT_RESOURCE_BUNDLE" value="com.code.aon.ui.registry.i18n.report" />
			<param id="logoImageFile" value="#{company.getAttachAsInputStream}" />
			<param id="printHeader" value="#{company.isPrintHeader}" />
			<param id="company" value="#{company.obtainCompany}" />
			<param id="recordData" value="#{company.getCompanyRecordData}" />
			<param id="company" value="#{company.obtainCompany}" />
			<param id="phone" value="#{company.obtainPhone}" />
			<param id="fax" value="#{company.obtainFax}" />
			<param id="email" value="#{company.obtainEmail}" />
			<param id="web" value="#{company.obtainWeb}" />
			<param id="address" value="#{company.obtainAddress}" />
			<param id="printRecordData" value="#{company.isPrintRecordData}"/>
			<param id="title" value="#{customer.getReportTitle}" />
		</params>
	</report>
