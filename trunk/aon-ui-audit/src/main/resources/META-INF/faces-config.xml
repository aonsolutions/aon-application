<faces-config xmlns="http://java.sun.com/xml/ns/javaee" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://java.sun.com/xml/ns/j2ee http://java.sun.com/xml/ns/j2ee/web-facesconfig_1_2.xsd"
	version="1.2">

	<!--  *************** COLLECTIONS ***************** -->

	<managed-bean>
		<managed-bean-name>auditCollections</managed-bean-name>
		<managed-bean-class>
			com.code.aon.ui.audit.controller.AuditCollectionsController
		</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
	</managed-bean>

	<!-- ************ APPLICATION ************** -->
	<managed-bean>
		<managed-bean-name>auditApplication</managed-bean-name>
		<managed-bean-class>com.code.aon.ui.form.BasicController</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
		<managed-property>
			<property-name>queryOnStartUP</property-name>
			<value>true</value>
		</managed-property>
		<managed-property>
			<property-name>pojo</property-name>
			<value>com.code.aon.audit.Application</value>
		</managed-property>
		<managed-property>
			<property-name>beanName</property-name>
			<value>auditApplication</value>
		</managed-property>
		<managed-property>
			<property-name>listenerClasses</property-name>
			<list-entries>
				<value-class>com.code.aon.ui.form.event.IControllerListener</value-class>
				<value>#{applicationActionListener}</value>
			</list-entries>
		</managed-property>			
	</managed-bean>
			
	<managed-bean>
		<managed-bean-name>applicationActionListener</managed-bean-name>
		<managed-bean-class>
			com.code.aon.ui.audit.event.MasterControllerListener
		</managed-bean-class>
		<managed-bean-scope>none</managed-bean-scope>
		<managed-property>
			<property-name>childBean</property-name>
			<value>applicationAction</value>
		</managed-property>
		<managed-property>
			<property-name>aliasMap</property-name>
			<map-entries>
				<map-entry>
					<key>Action_application_id</key>
                    <value>id</value>
				</map-entry>
			</map-entries>
		</managed-property>
	</managed-bean>	

	<managed-bean>
		<managed-bean-name>applicationChildListener</managed-bean-name>
		<managed-bean-class>
			com.code.aon.ui.form.listener.ChildControllerListener
		</managed-bean-class>
		<managed-bean-scope>none</managed-bean-scope>
		<managed-property>
			<property-name>masterBean</property-name>
			<value>auditApplication</value>
		</managed-property>
		<managed-property>
			<property-name>masterPropertyName</property-name>
			<value>application</value>
		</managed-property>
	</managed-bean>	

	<!-- ************ DOMAIN ************** -->
	<managed-bean>
		<managed-bean-name>domain</managed-bean-name>
		<managed-bean-class>com.code.aon.ui.audit.controller.DomainController</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
		<managed-property>
			<property-name>queryOnStartUP</property-name>
			<value>true</value>
		</managed-property>
		<managed-property>
			<property-name>pojo</property-name>
			<value>com.code.aon.audit.Domain</value>
		</managed-property>
		<managed-property>
			<property-name>beanName</property-name>
			<value>domain</value> 
		</managed-property>
		<managed-property>
			<property-name>listenerClasses</property-name>
			<list-entries>
				<value-class>com.code.aon.ui.form.event.IControllerListener</value-class>
				<value>#{domainListener}</value>
				<value>#{domainUserListener}</value>
				<value>#{domainApplicationListener}</value>
			</list-entries>
		</managed-property>					
	</managed-bean>
	
	<managed-bean>
		<managed-bean-name>domainListener</managed-bean-name>
		<managed-bean-class>
			com.code.aon.ui.audit.event.DomainControllerListener
		</managed-bean-class>
		<managed-bean-scope>none</managed-bean-scope>
	</managed-bean>	
	
	<managed-bean>
		<managed-bean-name>domainUserListener</managed-bean-name>
		<managed-bean-class>
			com.code.aon.ui.audit.event.MasterControllerListener
		</managed-bean-class>
		<managed-bean-scope>none</managed-bean-scope>
		<managed-property>
			<property-name>childBean</property-name>
			<value>user</value>
		</managed-property>
		<managed-property>
			<property-name>aliasMap</property-name>
			<map-entries>
				<map-entry>
					<key>User_domain_id</key>
                    <value>id</value>
				</map-entry>
			</map-entries>
		</managed-property>
	</managed-bean>	

	<managed-bean>
		<managed-bean-name>domainApplicationListener</managed-bean-name>
		<managed-bean-class>
			com.code.aon.ui.audit.event.MasterControllerListener
		</managed-bean-class>
		<managed-bean-scope>none</managed-bean-scope>
		<managed-property>
			<property-name>childBean</property-name>
			<value>domainApplication</value>
		</managed-property>
		<managed-property>
			<property-name>aliasMap</property-name>
			<map-entries>
				<map-entry>
					<key>DomainApplication_domain_id</key>
                    <value>id</value>
				</map-entry>
			</map-entries>
		</managed-property>
	</managed-bean>		
	
	<managed-bean>
		<managed-bean-name>domainChildListener</managed-bean-name>
		<managed-bean-class>
			com.code.aon.ui.form.listener.ChildControllerListener
		</managed-bean-class>
		<managed-bean-scope>none</managed-bean-scope>
		<managed-property>
			<property-name>masterBean</property-name>
			<value>domain</value>
		</managed-property>
		<managed-property>
			<property-name>masterPropertyName</property-name>
			<value>domain</value>
		</managed-property>
	</managed-bean>		

	<!-- ************ SESSION ************** -->
	<managed-bean>
		<managed-bean-name>auditSession</managed-bean-name>
		<managed-bean-class>com.code.aon.ui.form.BasicController</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
		<managed-property>
			<property-name>queryOnStartUP</property-name>
			<value>true</value>
		</managed-property>
		<managed-property>
			<property-name>pojo</property-name>
			<value>com.code.aon.audit.Session</value>
		</managed-property>
		<managed-property>
			<property-name>beanName</property-name>
			<value>auditSession</value> 
		</managed-property>
		<managed-property>
			<property-name>listenerClasses</property-name>
			<list-entries>
				<value-class>com.code.aon.ui.form.event.IControllerListener</value-class>
				<value>#{sessionActionExecutionListener}</value>
				<value>#{sessionControllerListener}</value>
			</list-entries>
		</managed-property>					
	</managed-bean>
	
	<managed-bean>
		<managed-bean-name>sessionActionExecutionListener</managed-bean-name>
		<managed-bean-class>
			com.code.aon.ui.audit.event.MasterControllerListener
		</managed-bean-class>
		<managed-bean-scope>none</managed-bean-scope>
		<managed-property>
			<property-name>childBean</property-name>
			<value>actionExecution</value>
		</managed-property>
		<managed-property>
			<property-name>aliasMap</property-name>
			<map-entries>
				<map-entry>
					<key>ActionExecution_session_id</key>
                    <value>id</value>
				</map-entry>
			</map-entries>
		</managed-property>
	</managed-bean>		

	<managed-bean>
		<managed-bean-name>sessionControllerListener</managed-bean-name>
		<managed-bean-class>
			com.code.aon.ui.audit.event.SessionControllerListener
		</managed-bean-class>
		<managed-bean-scope>none</managed-bean-scope>
	</managed-bean>		

	<!-- ************ ACTION EXECUTION ************** -->
	<managed-bean>
		<managed-bean-name>actionExecution</managed-bean-name>
		<managed-bean-class>com.code.aon.ui.form.BasicController</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
		<managed-property>
			<property-name>queryOnStartUP</property-name>
			<value>true</value>
		</managed-property>
		<managed-property>
			<property-name>pojo</property-name>
			<value>com.code.aon.audit.ActionExecution</value>
		</managed-property>
		<managed-property>
			<property-name>beanName</property-name>
			<value>actionExecution</value> 
		</managed-property>
	</managed-bean>

	<!-- ************ ACTION ************** -->
	<managed-bean>
		<managed-bean-name>applicationAction</managed-bean-name>
		<managed-bean-class>com.code.aon.ui.form.BasicController</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
		<managed-property>
			<property-name>queryOnStartUP</property-name>
			<value>true</value>
		</managed-property>
		<managed-property>
			<property-name>pojo</property-name>
			<value>com.code.aon.audit.Action</value>
		</managed-property>
		<managed-property>
			<property-name>beanName</property-name>
			<value>applicationAction</value> 
		</managed-property>
		<managed-property>
			<property-name>listenerClasses</property-name>
			<list-entries>
				<value-class>com.code.aon.ui.form.event.IControllerListener</value-class>
				<value>#{applicationChildListener}</value>
			</list-entries>
		</managed-property>		
	</managed-bean>
	
	<!-- ************ USER ************** -->
	<managed-bean>
		<managed-bean-name>user</managed-bean-name>
		<managed-bean-class>com.code.aon.ui.form.BasicController</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
		<managed-property>
			<property-name>queryOnStartUP</property-name>
			<value>true</value>
		</managed-property>
		<managed-property>
			<property-name>pojo</property-name>
			<value>com.code.aon.audit.User</value>
		</managed-property>
		<managed-property>
			<property-name>beanName</property-name>
			<value>user</value> 
		</managed-property>
		<managed-property>
			<property-name>listenerClasses</property-name>
			<list-entries>
				<value-class>com.code.aon.ui.form.event.IControllerListener</value-class>
				<value>#{domainChildListener}</value>
			</list-entries>
		</managed-property>		
	</managed-bean>	

	<!-- ************ DOMAIN APPLICATION ************** -->
	<managed-bean>
		<managed-bean-name>domainApplication</managed-bean-name>
		<managed-bean-class>com.code.aon.ui.form.BasicController</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
		<managed-property>
			<property-name>queryOnStartUP</property-name>
			<value>true</value>
		</managed-property>
		<managed-property>
			<property-name>pojo</property-name>
			<value>com.code.aon.audit.DomainApplication</value>
		</managed-property>
		<managed-property>
			<property-name>beanName</property-name>
			<value>domainApplication</value> 
		</managed-property>
		<managed-property>
			<property-name>listenerClasses</property-name>
			<list-entries>
				<value-class>com.code.aon.ui.form.event.IControllerListener</value-class>
				<value>#{domainChildListener}</value>
			</list-entries>
		</managed-property>		
	</managed-bean>	

</faces-config>