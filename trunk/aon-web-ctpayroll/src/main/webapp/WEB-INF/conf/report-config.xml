<?xml version="1.0" encoding="ISO-8859-1"?>

<!DOCTYPE report-config 
	PUBLIC "-//CODE-AON//DTD Report Config//EN" 
	"http://co-de.com/aon/report-config.dtd">

<report-config>
	<default-config>
		<fetch-mode paginated="false" />
	</default-config>

	<!--  *********  Impresion a PDF de los Tipos de Documento  ********* -->
	<report id="tiposDocumentoList" description="Listado de Tipos de Documento">
		<template path="/com/code/aon/ui/payroll/report/tiposDocumentoList.jasper" />
		<bean key="com.code.aon.payroll.tipos.Documento" />
		<criteria provider="#{tiposDocumento}" />
		<params>
			<param id="REPORT_RESOURCE_BUNDLE" value="com.code.aon.ui.payroll.i18n.messages" />
			<param id="logoImageFile" value="#{payrollController.getLogo}" />
			<param id="companyName" value="#{payrollController.getCompanyName}" />
		</params>
	</report>
	
	<!--  *********  Impresion a PDF de los Tipos de Registro  ********* -->
	<report id="tiposRegistroList" description="Listado de Tipos de Registro">
		<template path="/com/code/aon/ui/payroll/report/tiposRegistroList.jasper" />
		<bean key="com.code.aon.payroll.tipos.Registro" />
		<criteria provider="#{tiposRegistro}" />
		<params>
			<param id="REPORT_RESOURCE_BUNDLE" value="com.code.aon.ui.payroll.i18n.messages" />
			<param id="logoImageFile" value="#{payrollController.getLogo}" />
			<param id="companyName" value="#{payrollController.getCompanyName}" />
		</params>
	</report>
	
	<!--  *********  Impresion a PDF de los Tipos de Incidencia  ********* -->
	<report id="tiposIncidenciaList" description="Listado de Tipos de Incidencia">
		<template path="/com/code/aon/ui/payroll/report/tiposIncidenciaList.jasper" />
		<bean key="com.code.aon.payroll.tipos.Incidencia" />
		<criteria provider="#{tiposIncidencia}" />
		<params>
			<param id="REPORT_RESOURCE_BUNDLE" value="com.code.aon.ui.payroll.i18n.messages" />
			<param id="logoImageFile" value="#{payrollController.getLogo}" />
			<param id="companyName" value="#{payrollController.getCompanyName}" />
		</params>
	</report>
	
	<!--  *********  Impresion a PDF de los Tipos de Autorizacion  ********* -->
	<report id="tiposAutorizacionList" description="Listado de Tipos de Autorizacion">
		<template path="/com/code/aon/ui/payroll/report/tiposAutorizacionList.jasper" />
		<bean key="com.code.aon.payroll.tipos.Autorizacion" />
		<criteria provider="#{tiposAutorizacion}" />
		<params>
			<param id="REPORT_RESOURCE_BUNDLE" value="com.code.aon.ui.payroll.i18n.messages" />
			<param id="logoImageFile" value="#{payrollController.getLogo}" />
			<param id="companyName" value="#{payrollController.getCompanyName}" />
		</params>
	</report>

</report-config>