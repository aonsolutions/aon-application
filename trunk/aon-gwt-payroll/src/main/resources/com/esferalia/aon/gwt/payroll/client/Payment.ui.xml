<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<ui:UiBinder xmlns:ui='urn:ui:com.google.gwt.uibinder'
	xmlns:g='urn:import:com.google.gwt.user.client.ui' xmlns:es3='urn:import:com.google.gwt.user.client.ui'
	xmlns:datepicker='urn:import:com.google.gwt.user.datepicker.client'>

	<ui:Style>
		.form {
			padding: 10px;
		}
		
		.label {
			margin-top: 10x;
			font-weight: bold;
			padding: 1px 0.5em;
			white-space: nowrap;
			background-color: #F2F2F2;
		}
		
		.labeltop {
			margin-top: 10x;
			font-weight: bold;
			padding: 1px 0.5em;
			vertical-align: top;
			white-space: nowrap;
			background-color: #F2F2F2;
		}
		
		.field {
			padding: 1px 0.5em;
		}
		
		.buttons {
			padding-top: 10px;
			text-align: right;
		}
		
		.info {
			
		}
		
		.warn {
			
		}
		
		.error {
			
		}
		
		.messages {
			padding-left: 0.5em;
			padding-bottom: 10px;
		}
		
		.form textarea {
			resize: none;
		}
		
		@sprite .fxButton {
			margin: 0px;
			padding: 0px;
			border: 0px;
			cursor: pointer;
			gwt-image: 'fx';
			background-position: left center;
		}
		
		@sprite .undoButton {
			margin: 0px;
			padding: 0px;
			border: 0px;
			cursor: pointer;
			gwt-image: 'undo';
			background-position: left center;
		}
	</ui:Style>

	<ui:image field='fx' src='fx.png' />
	<ui:image field='undo' src='undo.png' />
	<ui:image field='redo' src='redo.png' />


	<ui:import field="com.esferalia.aon.gwt.payroll.client.Payment.*" />

	<g:HTMLPanel styleName="{style.form}">


		<g:Grid width="100%" ui:field="mainGrid">
			<g:row>
				<g:customCell styleName="{style.label}">
					<g:Label>Concepto</g:Label>
				</g:customCell>
				<g:customCell styleName="{style.field}">
					<g:HorizontalPanel verticalAlignment="ALIGN_MIDDLE">
						<g:SuggestBox ui:field="conceptSuggestBox" />
						<g:Label>&nbsp;
						</g:Label>
						<g:Label ui:field="conceptDescriptionLabel" visible="false" />
					</g:HorizontalPanel>
				</g:customCell>
			</g:row>
			<g:row>
				<g:customCell styleName="{style.label}" >
					<g:Label>Recibo</g:Label>
				</g:customCell>
				<g:customCell styleName="{style.field}">
					<g:ListBox ui:field="receiptListBox">
					</g:ListBox>
				</g:customCell>
			</g:row>
			<g:row>
				<g:customCell styleName="{style.label}">
					<g:Label>Tipo</g:Label>
				</g:customCell>
				<g:customCell styleName="{style.field}">
					<g:HorizontalPanel>
						<g:ListBox ui:field="typeListBox" />
						<g:Button ui:field="resetTypeButton" styleName="aon-lookupButton-clear "
							visible="false" />
					</g:HorizontalPanel>
				</g:customCell>
			</g:row>
			<g:row>
				<g:customCell styleName="{style.label}">
					<g:Label>Descripci&oacute;n
					</g:Label>
				</g:customCell>
				<g:customCell styleName="{style.field}">
					<g:HorizontalPanel width="100%">
						<g:SuggestBox width="100%" ui:field="descriptionSuggestBox" />
						<g:Label>&nbsp;
						</g:Label>
						<g:cell width="16px">
							<g:Button ui:field="resetDescriptionButton" styleName="aon-lookupButton-clear"
								visible="false" />
						</g:cell>
					</g:HorizontalPanel>
				</g:customCell>
			</g:row>
			<g:row>
				<g:customCell styleName="{style.label}">
					<g:Label>Devengo</g:Label>
				</g:customCell>
				<g:customCell styleName="{style.field}">
					<g:HorizontalPanel verticalAlignment="ALIGN_MIDDLE"
						width="100%">
						<g:TextBox ui:field="paymentTextBox" width="100%" />
						<g:Label>&nbsp;
						</g:Label>
						<g:cell width="16px">
							<g:Button ui:field="fxPaymentButton" styleName="{style.fxButton}" />
						</g:cell>
						<g:cell width="16px">
							<g:Button ui:field="resetPaymentButton" styleName="aon-lookupButton-clear"
								visible="false" />
						</g:cell>
					</g:HorizontalPanel>
				</g:customCell>
			</g:row>
			<g:row>
				<g:customCell styleName="{style.label}">
					<g:Label>Tributa</g:Label>
				</g:customCell>
				<g:customCell styleName="{style.field}">
					<g:DeckPanel ui:field="taxPanel">
						<g:HorizontalPanel ui:field="listTaxPanel"
							width="auto">
							<g:ListBox ui:field="taxListBox" width="auto">
								<g:item value="{ALL}">Todo</g:item>
								<g:item value="{NONE}">Nada</g:item>
								<g:item value="{CUSTOM}">Manual...</g:item>
							</g:ListBox>
							<g:Button ui:field="resetTaxButton" styleName="aon-lookupButton-clear"
								visible="false" />
						</g:HorizontalPanel>
						<g:HorizontalPanel width="100%" ui:field="customTaxPanel"
							verticalAlignment="ALIGN_MIDDLE">
							<g:TextBox ui:field="taxTextBox" width="100%" />
							<g:Label>&nbsp;
							</g:Label>
							<g:cell width="16px">
								<g:Button ui:field="fxTaxButton" styleName="{style.fxButton}" />
							</g:cell>
							<g:cell width="16px">
								<g:Button ui:field="undoTaxButton" styleName=" {style.undoButton}" />
							</g:cell>
							<g:cell width="16px">
								<g:Button ui:field="resetCustomTaxButton" styleName="aon-lookupButton-clear"
									visible="false" />
							</g:cell>
						</g:HorizontalPanel>
					</g:DeckPanel>
				</g:customCell>
			</g:row>
			<g:row>
				<g:customCell styleName="{style.label}">
					<g:Label>Cotiza</g:Label>
				</g:customCell>
				<g:customCell styleName="{style.field}">
					<g:DeckPanel ui:field="quotePanel">
						<g:HorizontalPanel ui:field="listQuotePanel"
							width="auto">
							<g:ListBox ui:field="quoteListBox" width="auto">
								<g:item value="{ALL}">Todo</g:item>
								<g:item value="{NONE}">Nada</g:item>
								<g:item value="{IPREM}">Exceso en su conjuto del 20% del
									IPREM
									mensual</g:item>
								<g:item value="{CUSTOM}">Manual...</g:item>
							</g:ListBox>
							<g:Button ui:field="resetQuoteButton" styleName="aon-lookupButton-clear"
								visible="false" />
						</g:HorizontalPanel>
						<g:HorizontalPanel width="100%" ui:field="customQuotePanel"
							verticalAlignment="ALIGN_MIDDLE">
							<g:TextBox ui:field="quoteTextBox" width="100%" />
							<g:Label>&nbsp;
							</g:Label>
							<g:cell width="16px">
								<g:Button ui:field="fxQuoteButton"
									styleName="aon-editDataTable-button {style.fxButton}" />
							</g:cell>
							<g:cell width="16px">
								<g:Button ui:field="undoQuoteButton"
									styleName="aon-editDataTable-button {style.undoButton}" />
							</g:cell>
							<g:cell width="16px">
								<g:Button ui:field="resetCustomQuoteButton" styleName="aon-lookupButton-clear"
									visible="false" />
							</g:cell>
						</g:HorizontalPanel>
					</g:DeckPanel>
				</g:customCell>
			</g:row>
			<g:row>
				<g:customCell styleName="{style.label}">
					<g:Label>Mes</g:Label>
				</g:customCell>
				<g:customCell styleName="{style.field}">
					<g:ListBox ui:field="monthListBox">
					</g:ListBox>
				</g:customCell>
			</g:row>
		</g:Grid>

	</g:HTMLPanel>


</ui:UiBinder>