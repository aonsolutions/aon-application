* {
	padding:0;
	margin:0;
}
body {
	color: ${color_color_texto_pagina};
	background-color:${bgcolor_color_fondo_pagina};
	font-family:${font_fuente_texto_pagina};
	font-size:0.83em;
	margin:20px auto;
	margin-top:100px;
	width:760px;
}
a img{
border:none;
}
h1, h2, h3, h4, h5, h6, p, pre, blockquote, label, ul, ol, dl, 
fieldset, address { margin:1em 0;}
h1 {
	font-size:1.67em;
	color:${color_color_texto_titulo}
	}
h2 {font-size:1.39em;}
h3 {font-size:1.2em;}
h4 {font-size:1em;}
li, dd { margin-left:5%; }
fieldset { padding: .5em; }
a {
	color:${color_color_texto_pagina};
	background-color: ${bgcolor_color_fondo_pagina};
	font-weight: bold;
	text-decoration: none;
}
a:hover {
	color:${color_color_texto_menu_hover};
	background-color: ${bgcolor_color_fondo_pagina};
	font-weight: bold;
	text-decoration: underline;
}
#header {
	color: ${color_color_texto_pagina};
	width:760px;
	clear:both;
	height:25px;
	padding:30px;
}
#title {
	color:${color_color_texto_pagina};
	background-color:${bgcolor_color_fondo_pagina};
	color:${color_color_texto_titulo}
	font-size:3em;
	font-weight:bold;
	padding:0px 0px 0px 0px;
	float:left;
}
#contact {
	padding:0px 0px 0px 0px;
}
#contact a {
	color:${color_color_texto_pagina};
	background-color:${bgcolor_color_fondo_pagina};
	font-weight:bold;
	text-decoration:none;
}
#contact a:hover {
	color:${color_color_texto_menu_hover};
	background-color:${bgcolor_color_fondo_pagina};
	text-decoration:underline;
}
#slogan {
	background-color:${bgcolor_color_fondo_pagina};
	font-size:1.17em;
	font-weight:bold;
	font-style:normal;
	padding:0px 0px 0px 0px;
	width:520px;
	clear:both;
	float:left;
}
#nav {
	line-height:2.5em;
	padding:30px 0px 4px 0px;
	margin:0 0 5px 0;
	width:765px;
	clear:both;
	margin-top:0px;
	margin-bottom:-22px;
	text-align:center;
}
#nav a {
	color:${color_color_texto_menu};
	background-color:${bgcolor_color_fondo_menu};
	font-weight:bold;
	text-decoration:none;
	padding:4px 35px 4px 35px;
	border:1px solid #000000;
}
#nav .selected,#nav a:hover {
	color:${color_color_texto_menu_hover};
	text-decoration:none;
	padding:4px 35px 4px 35px;
}
#content {
	border-top:1px solid #cccccc;
	width:760px;
	clear:both;

}
#maincontent {
	font-size:1.0em;
	padding:0px 5px 0px 0px;
	background-color:${bgcolor_color_fondo_contenido};
	width:754px;
	border-left:1px solid #CCCCCC;
	border-right:1px solid #CCCCCC;
	border-top:1px solid #CCCCCC;
	float:left;
	padding-bottom:20px;
	padding-top:20px;
}
#maincontent p{
	padding-left:20px;
	padding-right:20px;}
#sidecontent {
	font-size:0.83em;
	padding:5px 0px 0px 0px;
	width:195px;
	float:right;
}
#footer {
	color: ${color_color_texto_pie};
	background-color:${bgcolor_color_fondo_pie};
	font-size:80%;
	line-height:1.5em;
	width: 760px;
	clear:both;
	text-align:center;
}
#footer	a {
	  
	  background-color: ${bgcolor_color_fondo_pie};
	  text-decoration: none;
	  }
#footer	a:hover {
	  
	  background-color: ${bgcolor_color_fondo_pie};
	  font-weight: bold;
	  text-decoration: underline;
	  }
#copyrightdesign {

	background-color:${bgcolor_color_fondo_pie};
	padding:5px 0px 5px 20px;
	width: 580px;
	float:left;
}
#footercontact {

	background-color:${bgcolor_color_fondo_pie};
	padding:5px 0px 5px 50px;
	width:110px;
	float:right;
}
.box{
	float:left;
	padding-left:40px;
	padding-top:30px;
	text-align:center;
	}
.gallery-navigation{
	text-align:center;}
.bold{
	text-align:center;
	}
.album-block{ 
	text-align:center;}
.formulario{
	margin-left:20px;
	float: left;
	margin-top:10px;
	}
.Formpedidos{
	width: 150px;
	float: left;
	}
#formpedidos{
	margin:150px;
	}
.fButtons{
	margin-left:-4px;
	}
.infoHelp{
	width:450px; 
	padding:15px;
	margin-top:20px;
	background-color:#dddddd;
	margin-left:258px;
	text-align:justify;
	}
.element.style {
	background-color:#DDDDDD;
	margin-left:150px;
	padding-bottom:10px;
	padding-left:10px;
	padding-right:10px;
	padding-top:10px;
	}
#float-left {
float:left;
margin-left:150px;
}
#float-right {
float:right;
margin-right:150px;
}
.volver {
margin-left:60px;
}
.copiesferalia {
	margin-left:40px;
	margin-top:20px;
	font-family: ${font_fuente_texto_pie} ;
	font-size:9px;
	color:${color_color_texto_pie};
	text-decoration:none;
padding-bottom:10px;
	}
.copiesferalia a{
	font-family: ${font_fuente_texto_pie} ;
	font-size:9px;
	color:${color_color_texto_pie};
	text-decoration:none;
	}
.copiesferalia a:hover{
	font-family: ${font_fuente_texto_pie} ;
	font-size: 9px;
	color:${color_color_texto_pie};
	text-decoration:underline;
	}
