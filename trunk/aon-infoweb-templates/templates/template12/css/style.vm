body {
	background:${bgcolor_color_fondo_pagina}  no-repeat scroll left top;
	font-family: ${font_fuente_texto_pagina} ;
	font-size: ${size_tamano_texto_pagina};
	font-style: normal;
	color: ${color_color_texto_pagina};
	text-indent: 5px;
	height:450px;
	margin:0 auto;
	margin-top:100px;
	text-align:left;
	width:750px;
	text-decoration: none;
	}
dd{
	margin-left:-4px;
	}
.fButtons{
	margin-left:-4px;
	}

#header{
	background-repeat: no-repeat;
	/*width: 750px;*/
	text-decoration: none;
	background-color:${bgcolor_color_fondo_cabecera};
	padding-top:20px;
	padding-left:20px;
	padding-bottom:10px;
	}
#header img {
	text-decoration: none;
	}
#header .inicio{
	width:750px;
	height:15px;
	margin-left:-20px;
	background-color:${color_color_fondo_inicio};
	text-decoration: none;
	}
#header .inicio{
	text-decoration: none;
	}
#header .inicio a {
	font-family: ${font_fuente_texto_pagina} ;
	font-size: ${size_tamano_texto_pagina};
	text-decoration: none;
	padding-right:5px;
	font-variant: small-caps;	
	}
.menu{
	clear:both;
	overflow:auto;
	width: 750px;
	background-repeat: repeat-x;
	background-position: left top; 
	background-color:${bgcolor_color_fondo_menu};
	border-bottom-width: 1px;
	border-bottom-style: solid;
	border-bottom-color: ${color_color_borde_pagina};
	text-decoration:none;

	}
.menu ul{
	margin:3px;
	padding:2px;
	}
.menu li{
	display:inline;
	border-right:${color_color_borde_pagina} 1px solid;
	padding-right:5px;
	padding-left:5px;
	}
.menu li a{
	text-decoration: none;
	color:#f70e76;
	text-transform:uppercase;
	font-size:${size_tamano_texto_pagina};
	font-weight: bold;
	margin-left:10px;
	margin-right:10px;
	}
.menu ul a:link {
	font-family: ${font_fuente_texto_pagina} ;
	font-size: ${size_tamano_texto_pagina};
	color: ${color_color_texto_menu};
	}
.menu ul a:visited {
	font-family: ${font_fuente_texto_pagina} ;
	font-size: ${size_tamano_texto_pagina};
	color: ${color_color_texto_menu};
	}
.menu ul a:hover {
	font-family: ${font_fuente_texto_pagina} ;
	font-size: ${size_tamano_texto_pagina};
	color:${color_color_texto_menu_hover};
	}
#ft{

	overflow:auto;
	width:750px;
	color: ${color_color_texto_pagina};
	padding-top: 4px; 
	background-color:${bgcolor_color_fondo_pie};
	background-repeat: repeat-x;
	background-position: left top;
	border-top-width: 10px;
	border-top-style: solid;
	border-top-color: ${color_color_borde_pie} ;
	text-align: center;
	font-size: 9px;
	}
a, img, a:hover, a:visited{
	text-decoration:none;
	}
.content-text{
	color:${color_color_texto_pagina}; 
	font-family:${font_fuente_texto_pagina}; 
	font-size:${size_tamano_texto_pagina};
	background-color:${bgcolor_color_fondo_pagina};
	width: 750px;
	height: 400px; 
	text-align:center;
	padding:6px 50px 0px;
	}
.box{
	float:left;
	margin-left:35px;
	padding-top:25px;
	text-align:center;
	}
#body-content{
	text-align:left; 
	padding-top:20px; 
	padding-left:10px;
	padding-bottom:20px;
	background-color:${bgcolor_color_fondo_contenido};
	}
.texto{
	text-align:right;
	}
.infoHelp{
	width:450px; 
	padding:15px;
	margin-top:20px;
	margin-left:255px;
	text-align:justify;
	}
.element.style {
	background-color:#DDDDDD;
	margin-left:150px;
	padding-bottom:10px;
	padding-left:10px;
	padding-right:10px;
	padding-top:10px;
	}
.gallery-navigation{
	text-align:center;}
.bold{
	text-align:right;
	margin-left:350px;
	}
.album-block{ 
	text-align:center;}
.formulario{
	margin-left:45px;
	float: left;
	margin-top:27px;
	}
.Formpedidos{
	width: 150px;
	float: left;
	}

#formpedidos{
	margin:150px;
	}
.copiesferalia {
	margin-left:40px;
	margin-top:0px;
	font-family: ${font_fuente_texto_pie} ;
	font-size:9px;
	color:${color_color_texto_pie};
	text-decoration:none;
padding-bottom:10px;
	}
.copiesferalia a{
	font-family: ${font_fuente_texto_pie} ;
	font-size:9px;
	color:${color_color_texto_pie};
	text-decoration:none;
	}
.copiesferalia a:hover{
	font-family: ${font_fuente_texto_pie} ;
	font-size: 9px;
	color:${color_color_texto_pie};
	text-decoration:underline;
	}
h1{
	margin-top:20px;
	font-family: ${font_fuente_texto_pagina} ;
	font-size: ${size_tamano_texto_titulo};
	color:${color_color_texto_titulo};
	padding-left:20px;
	font-weight: bold;
	text-align: center;
	}
	td img{padding:20px;}