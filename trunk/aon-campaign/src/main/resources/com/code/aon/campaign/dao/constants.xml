		<alias names="id,campaign_id,activity_id,processDetail_id,task_id,dossier_id,processDetail_position,task_endDate,task_dueDate" />
		<hibernate names="id,campaign.id,activity.id,processDetail.id,task.id,activity.dossier.id,processDetail.position,task.endDate,task.dueDate" />
