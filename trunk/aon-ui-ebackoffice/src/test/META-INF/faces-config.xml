<faces-config version="1.2" xmlns="http://java.sun.com/xml/ns/javaee"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://java.sun.com/xml/ns/javaee http://java.sun.com/xml/ns/javaee/web-facesconfig_1_2.xsd">

	<application>
		<resource-bundle>
			<base-name>com.code.aon.ui.ecommerce.i18n.messages</base-name>
			<var>ecommerceBundle</var>
		</resource-bundle>
	</application>

	<!-- ****** CATEGORY SEARCH GADGET ****** -->
	<managed-bean>
		<managed-bean-name>categoryGadget</managed-bean-name>
		<managed-bean-class>
			com.code.aon.ui.ecommerce.controller.CategoryGadget</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
	</managed-bean>

	<!-- ****** CATALOGUE SEARCH GADGET ****** -->
	<managed-bean>
		<managed-bean-name>catalogueGadget</managed-bean-name>
		<managed-bean-class>
			com.code.aon.ui.ecommerce.controller.CatalogueGadget</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
	</managed-bean>

	<!-- ****** OFFER ****** -->
	<managed-bean>
		<managed-bean-name>cartOffer</managed-bean-name>
		<managed-bean-class>
			com.code.aon.ui.ecommerce.controller.OfferController
		</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
		<managed-property>
			<property-name>queryOnStartUP</property-name>
			<value>true</value>
		</managed-property>
		<managed-property>
			<property-name>pojo</property-name>
			<value>com.code.aon.commercial.Offer</value>
		</managed-property>
		<managed-property>
			<property-name>beanName</property-name>
			<value>cartOffer</value>
		</managed-property>
		<managed-property>
			<property-name>listenerClasses</property-name>
			<list-entries>
				<value-class>
					com.code.aon.ui.form.event.IControllerListener
				</value-class>
				<!--  
				<value>#{offerHeaderControllerListener}</value>
				<value>#{offerControllerListener}</value>
				-->
				<value>#{cartOfferDetailChildListener}</value>
			</list-entries>
		</managed-property>
	</managed-bean>
	<managed-bean>
		<managed-bean-name>offerHeaderControllerListener</managed-bean-name>
		<managed-bean-class>com.code.aon.ui.config.event.HeaderControllerListener</managed-bean-class>
		<managed-bean-scope>none</managed-bean-scope>
		<managed-property>
			<property-name>table</property-name>
			<value>Offer</value>
		</managed-property>
	</managed-bean>
	<managed-bean>
		<managed-bean-name>cartOfferDetailChildListener</managed-bean-name>
		<managed-bean-class>
			com.code.aon.ui.form.listener.LinesControllerListener
		</managed-bean-class>
		<managed-bean-scope>none</managed-bean-scope>
		<managed-property>
			<property-name>childBean</property-name>
			<value>cartOfferDetail</value>
		</managed-property>
		<managed-property>
			<property-name>aliasMap</property-name>
			<map-entries>
				<map-entry>
					<key>OfferDetail_offer_id</key>
                    <value>id</value>
				</map-entry>
			</map-entries>
		</managed-property>
	</managed-bean>
	
	<!-- ****** OFFER DETAIL ****** -->
	<managed-bean>
		<managed-bean-name>cartOfferDetail</managed-bean-name>
		<managed-bean-class>
			com.code.aon.ui.ecommerce.controller.OfferDetailController
		</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
		<managed-property>
			<property-name>queryOnStartUP</property-name>
			<value>true</value>
		</managed-property>
		<managed-property>
			<property-name>pojo</property-name>
			<value>com.code.aon.commercial.OfferDetail</value>
		</managed-property>
		<managed-property>
			<property-name>beanName</property-name>
			<value>cartOfferDetail</value>
		</managed-property>
		<managed-property>
			<property-name>masterControllerName</property-name>
			<value>cartOffer</value>
		</managed-property>
		<managed-property>
			<property-name>propertyMap</property-name>
			<map-entries>
				<map-entry>
					<key>id</key>
					<value>offer.id</value>
				</map-entry>
			</map-entries>
		</managed-property>
		<managed-property>
			<property-name>cascadeDelete</property-name>
			<value>true</value>
		</managed-property>
	</managed-bean>
	
	<!-- ****** USER LOGIN ****** -->
	<managed-bean>
		<managed-bean-name>userLogin</managed-bean-name>
		<managed-bean-class>
			com.code.aon.ui.ecommerce.controller.LoginController</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
	</managed-bean>

	<!-- ****** SHOP ****** -->
	<managed-bean>
		<managed-bean-name>shop</managed-bean-name>
		<managed-bean-class>
			com.code.aon.ui.ecommerce.controller.ShopController</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
		<managed-property>
			<property-name>items</property-name>
			<value>true</value>
		</managed-property>
	</managed-bean>

	<!-- ****** SHOPITEM ****** -->
	<managed-bean>
		<managed-bean-name>shopItem</managed-bean-name>
		<managed-bean-class>
			com.code.aon.ui.ecommerce.controller.ShopItemController</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
		<managed-property>
			<property-name>queryOnStartUP</property-name>
			<value>true</value>
		</managed-property>
		<managed-property>
			<property-name>pojo</property-name>
			<value>com.code.aon.product.ItemAttachment</value>
		</managed-property>
		<managed-property>
			<property-name>beanName</property-name>
			<value>shopItem</value>
		</managed-property>
	</managed-bean>
	

	<!-- ****** SHOPITEMS ****** -->
	<managed-bean>
		<managed-bean-name>shopItems</managed-bean-name>
		<managed-bean-class>
			com.code.aon.ui.ecommerce.controller.ShopItemsController</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
	</managed-bean>

	<!-- ****** SHOPITEMS SEARCH ****** -->
	<managed-bean>
		<managed-bean-name>shopItemsSearch</managed-bean-name>
		<managed-bean-class>com.code.aon.ui.ecommerce.controller.SearchGadget</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
	</managed-bean>


	<!-- ****** SHOPPING CART CONTROLLER ****** -->
	<managed-bean>
		<managed-bean-name>shoppingCart</managed-bean-name>
		<managed-bean-class>
			com.code.aon.ui.ecommerce.controller.ShoppingCartController</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
	</managed-bean>
	
	<!-- ************* NAVIGATION RULES ***************** -->
	<navigation-rule>
		<navigation-case>
			<from-outcome>shop_form</from-outcome>
			<to-view-id>/com/code/aon/ui/ecommerce/facelet/shop/form.xhtml</to-view-id>
		</navigation-case>
	</navigation-rule>
	<!--  
	<navigation-rule>
		<navigation-case>
			<from-outcome>shopItem_grid</from-outcome>
			<to-view-id>/com/code/aon/ui/ecommerce/facelet/shop/detail/grid.xhtml</to-view-id>
		</navigation-case>
	</navigation-rule>
	<navigation-rule>
		<navigation-case>
			<from-outcome>shoppingCart_list</from-outcome>
			<to-view-id>/com/code/aon/ui/ecommerce/facelet/shoppingCart/list.xhtml</to-view-id>
		</navigation-case>
	</navigation-rule>
	-->
	<navigation-rule>
		<navigation-case>
			<from-outcome>registry_form</from-outcome>
			<to-view-id>/com/code/aon/ui/ecommerce/facelet/registry/form.xhtml</to-view-id>
		</navigation-case>
	</navigation-rule>
	<navigation-rule>
		<navigation-case>
			<from-outcome>new_registry_form</from-outcome>
			<to-view-id>/com/code/aon/ui/ecommerce/facelet/registry/form_newUser.xhtml</to-view-id>
		</navigation-case>
	</navigation-rule>
	<navigation-rule>
		<navigation-case>
			<from-outcome>offer_form</from-outcome>
			<to-view-id>/com/code/aon/ui/ecommerce/facelet/offer/form.xhtml</to-view-id>
		</navigation-case>
	</navigation-rule>


</faces-config>