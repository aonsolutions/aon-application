<faces-config version="1.2" xmlns="http://java.sun.com/xml/ns/javaee"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://java.sun.com/xml/ns/javaee http://java.sun.com/xml/ns/javaee/web-facesconfig_1_2.xsd">

	<application>
		<resource-bundle>
			<base-name>com.code.aon.ui.ebackoffice.i18n.messages</base-name>
			<var>ebackofficeBundle</var>
		</resource-bundle>
	</application>

	<managed-bean>
		<managed-bean-name>ectarget</managed-bean-name>
		<managed-bean-class>com.code.aon.ui.ebackoffice.controller.EctargetController</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
		<managed-property>
			<property-name>queryOnStartUP</property-name>
			<value>true</value>
		</managed-property>
		<managed-property>
			<property-name>pojo</property-name>
			<value>com.code.aon.ebackoffice.Ectarget</value>
		</managed-property>
		<managed-property>
			<property-name>beanName</property-name>
			<value>ectarget</value>
		</managed-property>
		<managed-property>
			<property-name>listenerClasses</property-name>
			<list-entries>
				<value-class>com.code.aon.ui.form.event.IControllerListener</value-class>
			</list-entries>
		</managed-property>
	</managed-bean>

	<managed-bean>
		<managed-bean-name>ecconfig</managed-bean-name>
		<managed-bean-class>com.code.aon.ui.ebackoffice.controller.EcconfigController</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
		<managed-property>
			<property-name>queryOnStartUP</property-name>
			<value>true</value>
		</managed-property>
		<managed-property>
			<property-name>pojo</property-name>
			<value>com.code.aon.ebackoffice.Ecconfig</value>
		</managed-property>
		<managed-property>
			<property-name>beanName</property-name>
			<value>ecconfig</value>
		</managed-property>
		<managed-property>
			<property-name>listenerClasses</property-name>
			<list-entries>
				<value-class>com.code.aon.ui.form.event.IControllerListener</value-class>
			</list-entries>
		</managed-property>
	</managed-bean>

	<managed-bean>
		<managed-bean-name>eccatalogue</managed-bean-name>
		<managed-bean-class>com.code.aon.ui.ebackoffice.controller.EccatalogueController</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
		<managed-property>
			<property-name>queryOnStartUP</property-name>
			<value>true</value>
		</managed-property>
		<managed-property>
			<property-name>pojo</property-name>
			<value>com.code.aon.ebackoffice.Eccatalogue</value>
		</managed-property>
		<managed-property>
			<property-name>beanName</property-name>
			<value>eccatalogue</value>
		</managed-property>
		<managed-property>
			<property-name>listenerClasses</property-name>
			<list-entries>
				<value-class>com.code.aon.ui.form.event.IControllerListener</value-class>
			</list-entries>
		</managed-property>
	</managed-bean>
	
	<navigation-rule>
		<navigation-case>
			<from-outcome>ectarget_grid</from-outcome>
			<to-view-id>/com/code/aon/ui/ebackoffice/facelet/ecTarget/grid.xhtml</to-view-id>
		</navigation-case>

		<navigation-case>
			<from-outcome>ecconfig_grid</from-outcome>
			<to-view-id>/com/code/aon/ui/ebackoffice/facelet/ecConfig/grid.xhtml</to-view-id>
		</navigation-case>
	   	
	    <navigation-case>
			<from-outcome>eccatalogue_grid</from-outcome>
			<to-view-id>/com/code/aon/ui/ebackoffice/facelet/ecCatalogue/grid.xhtml</to-view-id>
		</navigation-case>
	</navigation-rule>
</faces-config>
