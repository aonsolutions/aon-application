<?xml version="1.0"?>
<!DOCTYPE faces-config PUBLIC
  "-//Sun Microsystems, Inc.//DTD JavaServer Faces Config 1.1//EN"
  "http://java.sun.com/dtd/web-facesconfig_1_1.dtd">

<faces-config>

	<!-- ************* CONTROLADOR DE GENERAL DE NOMINAS ***************** -->
	<managed-bean>
		<managed-bean-name>payrollController</managed-bean-name>
		<managed-bean-class>com.code.aon.ui.payroll.controller.PayrollController</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
	</managed-bean>

	<!-- ************* TIPOS DE DOCUMENTO ***************** -->
	<managed-bean>
		<managed-bean-name>tiposDocumento</managed-bean-name>
		<managed-bean-class>com.code.aon.ui.form.BasicController</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
		<managed-property>
			<property-name>queryOnStartUP</property-name>
			<value>true</value>
		</managed-property>
		<managed-property>
			<property-name>pojo</property-name>
			<value>com.code.aon.payroll.tipos.Documento</value>
		</managed-property>
		<managed-property>
			<property-name>defaultOrder</property-name>
			<value>Documento_cdg</value>
		</managed-property>
	</managed-bean>

	<!-- ************* TIPOS DE REGISTRO ***************** -->
	<managed-bean>
		<managed-bean-name>tiposRegistro</managed-bean-name>
		<managed-bean-class>com.code.aon.ui.form.BasicController</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
		<managed-property>
			<property-name>queryOnStartUP</property-name>
			<value>true</value>
		</managed-property>
		<managed-property>
			<property-name>pageLimit</property-name>
			<value>20</value>
		</managed-property>
		<managed-property>
			<property-name>pojo</property-name>
			<value>com.code.aon.payroll.tipos.Registro</value>
		</managed-property>
		<managed-property>
			<property-name>defaultOrder</property-name>
			<value>Registro_cdg</value>
		</managed-property>
	</managed-bean>
	
	<!-- ************* TIPOS DE INCIDENCIA ***************** -->
	<managed-bean>
		<managed-bean-name>tiposIncidencia</managed-bean-name>
		<managed-bean-class>com.code.aon.ui.form.BasicController</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
		<managed-property>
			<property-name>queryOnStartUP</property-name>
			<value>true</value>
		</managed-property>
		<managed-property>
			<property-name>pojo</property-name>
			<value>com.code.aon.payroll.tipos.Incidencia</value>
		</managed-property>
	</managed-bean>
	
	<!-- ************* TIPOS DE AUTORIZACION ***************** -->
	<managed-bean>
		<managed-bean-name>tiposAutorizacion</managed-bean-name>
		<managed-bean-class>com.code.aon.ui.form.BasicController</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
		<managed-property>
			<property-name>queryOnStartUP</property-name>
			<value>true</value>
		</managed-property>
		<managed-property>
			<property-name>pojo</property-name>
			<value>com.code.aon.payroll.tipos.Autorizacion</value>
		</managed-property>
	</managed-bean>

	<!-- ************* TIPOS DE EMPRESARIOS ***************** -->
	<managed-bean>
		<managed-bean-name>tiposEmpresario</managed-bean-name>
		<managed-bean-class>com.code.aon.ui.form.BasicController</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
		<managed-property>
			<property-name>queryOnStartUP</property-name>
			<value>true</value>
		</managed-property>
		<managed-property>
			<property-name>pojo</property-name>
			<value>com.code.aon.payroll.tipos.Empresario</value>
		</managed-property>
	</managed-bean>
	
	<!-- ************* TIPOS DE CNAE ***************** -->
	<managed-bean>
		<managed-bean-name>tiposCnae</managed-bean-name>
		<managed-bean-class>com.code.aon.ui.form.BasicController</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
		<managed-property>
			<property-name>queryOnStartUP</property-name>
			<value>true</value>
		</managed-property>
		<managed-property>
			<property-name>pojo</property-name>
			<value>com.code.aon.payroll.tipos.Cnae</value>
		</managed-property>
		<managed-property>
			<property-name>listenerClasses</property-name>
			<list-entries>
				<value-class>com.code.aon.ui.form.event.IControllerListener</value-class>				
				<value>#{resourceControllerListener}</value>									
			</list-entries>
		</managed-property>		
	</managed-bean>
	
	<managed-bean>
		<managed-bean-name>resourceControllerListener</managed-bean-name>
		<managed-bean-class>
			com.esferalia.ui.scheduler.event.ResourceControllerListener
		</managed-bean-class>
		<managed-bean-scope>none</managed-bean-scope>
	</managed-bean>
	
	<!-- ************* TIPOS DE BONIFICACION ***************** -->
	<managed-bean>
		<managed-bean-name>tiposBonificacion</managed-bean-name>
		<managed-bean-class>com.code.aon.ui.form.BasicController</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
		<managed-property>
			<property-name>queryOnStartUP</property-name>
			<value>true</value>
		</managed-property>
		<managed-property>
			<property-name>pojo</property-name>
			<value>com.code.aon.payroll.tipos.Bonificacion</value>
		</managed-property>
	</managed-bean>
	
	<!-- ************* ORGANISMOS DE MNTO. DE ADMINISTRACION DE HACIENDA***************** -->
	<managed-bean>
		<managed-bean-name>organismosAdmon</managed-bean-name>
		<managed-bean-class>com.code.aon.ui.form.BasicController</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
		<managed-property>
			<property-name>queryOnStartUP</property-name>
			<value>true</value>
		</managed-property>
		<managed-property>
			<property-name>pojo</property-name>
			<value>com.code.aon.payroll.organismos_entidades.Admon</value>
		</managed-property>
	</managed-bean>
	
	<!-- ************* SISTEMA RED. COLECTIVOS***************** -->
	<managed-bean>
		<managed-bean-name>sistemaRedColectivos</managed-bean-name>
		<managed-bean-class>com.code.aon.ui.form.BasicController</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
		<managed-property>
			<property-name>queryOnStartUP</property-name>
			<value>true</value>
		</managed-property>
		<managed-property>
			<property-name>pojo</property-name>
			<value>com.code.aon.payroll.sistema_red.Colectivos</value>
		</managed-property>
	</managed-bean>

	<!-- ************* PORCENTAJE DE COTIZACIÓN ***************** -->
	<managed-bean>
		<managed-bean-name>porcentajeMaestro</managed-bean-name>
		<managed-bean-class>com.code.aon.ui.payroll.controller.PorcentajeMaestroController</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
		<managed-property>
			<property-name>queryOnStartUP</property-name>
			<value>true</value>
		</managed-property>
		<managed-property>
			<property-name>pojo</property-name>
			<value>com.code.aon.payroll.cotizacion.PorcentajeMaestro</value>
		</managed-property>
		<managed-property>
			<property-name>defaultOrder</property-name>
			<value>PorcentajeMaestro_ordpct</value>
		</managed-property>
		<managed-property>
			<property-name>listenerClasses</property-name>
			<list-entries>
				<value-class>com.code.aon.ui.form.event.IControllerListener</value-class>
				<value>#{porcentajeMaestroControllerListener}</value>
				<value>#{porcentajeListener}</value>
			</list-entries>
		</managed-property>
	</managed-bean>

	<managed-bean>
		<managed-bean-name>porcentajeMaestroControllerListener</managed-bean-name>
		<managed-bean-class>com.code.aon.ui.payroll.event.PorcentajeMaestroControllerListener</managed-bean-class>
		<managed-bean-scope>none</managed-bean-scope>
	</managed-bean>

	<managed-bean>
		<managed-bean-name>porcentajeListener</managed-bean-name>
		<managed-bean-class>com.code.aon.ui.form.listener.LinesControllerListener</managed-bean-class>
		<managed-bean-scope>none</managed-bean-scope>
		<managed-property>
			<property-name>childBean</property-name>
			<value>porcentaje</value>
		</managed-property>
		<managed-property>
			<property-name>aliasMap</property-name>
			<map-entries>
				<map-entry>
					<key>Porcentaje_porcentajeMaestro_cdg</key>
                    <value>cdg</value>
				</map-entry>
			</map-entries>
		</managed-property>
	</managed-bean>

	<managed-bean>
		<managed-bean-name>porcentaje</managed-bean-name>
		<managed-bean-class>com.code.aon.ui.form.LinesController</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
		<managed-property>
			<property-name>queryOnStartUP</property-name>
			<value>true</value>
		</managed-property>
		<managed-property>
			<property-name>pageLimit</property-name>
			<value>-1</value>
		</managed-property>
		<managed-property>
			<property-name>pojo</property-name>
			<value>com.code.aon.payroll.cotizacion.Porcentaje</value>
		</managed-property>
		<managed-property>
			<property-name>defaultOrder</property-name>
			<value>Porcentaje_id_fecini</value>
		</managed-property>
		<managed-property>
			<property-name>cascadeDelete</property-name>
			<value>true</value>
		</managed-property>
		<managed-property>
			<property-name>masterControllerName</property-name>
			<value>porcentajeMaestro</value>
		</managed-property>
		<managed-property>
			<property-name>propertyMap</property-name>
			<map-entries>
				<map-entry>
					<key>cdg</key>
					<value>porcentajeMaestro.cdg</value>
				</map-entry>
			</map-entries>
		</managed-property>
		<managed-property>
			<property-name>listenerClasses</property-name>
			<list-entries>
				<value-class>com.code.aon.ui.form.event.IControllerListener</value-class>
				<value>#{porcentajeControllerListener}</value>
			</list-entries>
		</managed-property>
	</managed-bean>

	<managed-bean>
		<managed-bean-name>porcentajeControllerListener</managed-bean-name>
		<managed-bean-class>com.code.aon.ui.payroll.event.PorcentajeControllerListener</managed-bean-class>
		<managed-bean-scope>none</managed-bean-scope>
	</managed-bean>

</faces-config>
