<?xml version="1.0"?>
<!DOCTYPE faces-config PUBLIC
  "-//Sun Microsystems, Inc.//DTD JavaServer Faces Config 1.1//EN"
  "http://java.sun.com/dtd/web-facesconfig_1_1.dtd">

<faces-config>
	<application>
		<message-bundle>
			com.code.aon.ui.common.i18n.messages
		</message-bundle>
		<locale-config>
			<default-locale>es</default-locale>
		</locale-config>
		<view-handler>
			com.icesoft.faces.facelets.D2DFaceletViewHandler
		</view-handler>
	</application>

	<!--  *************** COLLECTIONS ***************** -->
	<managed-bean>
		<managed-bean-name>registryCollections</managed-bean-name>
		<managed-bean-class>
			com.code.aon.ui.registry.controller.RegistryCollectionsController
		</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
	</managed-bean>
	<managed-bean>
		<managed-bean-name>configCollections</managed-bean-name>
		<managed-bean-class>
			com.code.aon.ui.config.controller.ConfigCollectionsController
		</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
	</managed-bean>

	<!--  *************** CONVERTERS ***************** -->
	<converter>
		<description>Conversor para los Enum</description>
		<converter-for-class>java.lang.Enum</converter-for-class>
		<converter-class>
			com.code.aon.ui.converter.EnumLocaleConverter
		</converter-class>
	</converter>

	<lifecycle>
		<phase-listener>
			com.code.aon.faces.component.sandbox.ValueChangePhaseListener
		</phase-listener>
	</lifecycle>

	<!--  *************** 
		COMMON
		***************** -->
	<managed-bean>
		<managed-bean-name>enviroment</managed-bean-name>
		<managed-bean-class>
			com.code.aon.ui.form.EnviromentController
		</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
	</managed-bean>

	<!--  *************** 
		ERROR MESSAGES
		***************** -->
	<managed-bean>
		<managed-bean-name>errorMessages</managed-bean-name>
		<managed-bean-class>
			com.code.aon.ui.task.controller.ErrorMessageController
		</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
	</managed-bean>


	<!--  *************** 
		AON CONFIGURATION
		***************** -->
	<managed-bean>
		<managed-bean-name>aonConfiguration</managed-bean-name>
		<managed-bean-class>
			com.code.aon.ui.common.controller.ConfigurationController
		</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
		<managed-property>
			<property-name>
				applicationLogoContextRelativePath
			</property-name>
			<value>/__theme_images/html/logo.gif</value>
		</managed-property>
		<managed-property>
			<property-name>
				applicationWelcomeContextRelativePath
			</property-name>
			<value>/__theme_images/html/aon-home.jpg</value>
		</managed-property>
		<managed-property>
			<property-name>style</property-name>
			<value>iceCss</value>
		</managed-property>
		<managed-property>
			<property-name>userStyleSheets</property-name>
			<list-entries>
				<value>/css/panelPopup.css</value>
				<value>/css/panelTabSet.css</value>
				<value>/css/selectInputDate.css</value>
				<value>/css/outputConnectionStatus.css</value>
				<value>/css/hyperview.css</value>
			</list-entries>
		</managed-property>
		<managed-property>
			<property-name>applicationBundles</property-name>
			<map-entries>
				<map-entry>
					<key>bundle</key>
					<value>com.code.aon.ui.common.i18n.messages</value>
				</map-entry>
				<map-entry>
					<key>appBundle</key>
					<value>com.code.aon.ui.task.i18n.messages</value>
				</map-entry>
				<map-entry>
					<key>menuBundle</key>
					<value>com.code.aon.ui.task.i18n.menu</value>
				</map-entry>
				<map-entry>
					<key>projectBundle</key>
					<value>com.code.aon.ui.project.i18n.messages</value>
				</map-entry>
				<map-entry>
					<key>registryBundle</key>
					<value>
						com.code.aon.ui.registry.i18n.messages
					</value>
				</map-entry>
				<map-entry>
					<key>customerBundle</key>
					<value>
						com.code.aon.ui.customer.i18n.messages
					</value>
				</map-entry>
				<map-entry>
					<key>groupwareBundle</key>
					<value>
						com.code.aon.ui.groupware.i18n.messages
					</value>
				</map-entry>
				<map-entry>
					<key>configBundle</key>
					<value>com.code.aon.ui.config.i18n.messages</value>
				</map-entry>
				<map-entry>
					<key>securityBundle</key>
					<value>com.code.aon.bridge.i18n.messages</value>
				</map-entry>
			</map-entries>
		</managed-property>
	</managed-bean>

	<!-- ******************
		TIMEZONE CONTROLLER
		*******************  	 -->
	<managed-bean>
		<managed-bean-name>timeZoneController</managed-bean-name>
		<managed-bean-class>
			com.code.aon.ui.common.controller.TimeZoneController
		</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
	</managed-bean>

	<!-- ************** EXCEPTION HANDLER ****************** -->
	<managed-bean>
		<managed-bean-name>exceptionBean</managed-bean-name>
		<managed-bean-class>
			com.code.aon.ui.common.controller.ExceptionBean
		</managed-bean-class>
		<managed-bean-scope>request</managed-bean-scope>
	</managed-bean>

	<!-- ***************** FAILED LOGIN ******************** -->
	<managed-bean>
		<managed-bean-name>failedLogin</managed-bean-name>
		<managed-bean-class>
			com.code.aon.bridge.session.FailedLogin
		</managed-bean-class>
		<managed-bean-scope>request</managed-bean-scope>
	</managed-bean>

	<!-- ************** REQUEST HANDLER ****************** -->
	<managed-bean>
		<managed-bean-name>requestController</managed-bean-name>
		<managed-bean-class>
			com.code.aon.ui.form.RequestController
		</managed-bean-class>
		<managed-bean-scope>request</managed-bean-scope>
	</managed-bean>

</faces-config>
