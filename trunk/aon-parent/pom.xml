<?xml version="1.0"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">

  <modelVersion>4.0.0</modelVersion>
  <groupId>com.code.aon</groupId>
  <artifactId>aon.parent</artifactId>
  <version>5.1.0-SNAPSHOT</version>
  <packaging>pom</packaging>
  <description>POM padre de los proyectos AON</description>
  <name>AON PARENT</name>
  <scm>
    <connection>
    scm:svn:http://dev.esferalia.com/repos/aon-application/trunk</connection>
    <url>http://dev.esferalia.com/websvn/wsvn</url>
  </scm>
  <organization>
    <name>esferalia Networks S.A.</name>
    <url>http://www.esferalia.com</url>
  </organization>
  <developers>
    <developer>
      <id>ecastellano</id>
    </developer>
    <developer>
      <id>girazu</id>
    </developer>
    <developer>
      <id>atellitu</id>
    </developer>
    <developer>
      <id>jurkiri</id>
    </developer>
    <developer>
      <id>jdiez</id>
    </developer>
    <developer>
      <id>igayarre</id>
    </developer>
    <developer>
      <id>iayerbe</id>
    </developer>
    <developer>
      <id>esalas</id>
    </developer>
    <developer>
      <id>rtrepiana</id>
    </developer>
    <developer>
      <id>duriarte</id>
    </developer>
    <developer>
      <id>eagirrezabal</id>
    </developer>
  </developers>
  <issueManagement>
    <system>Bugzilla</system>
    <url>http://bugzilla.esferalia.com/</url>
  </issueManagement>
  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <configuration>
          <source>1.6</source>
          <target>1.6</target>
          <encoding>ISO-8859-1</encoding>
        </configuration>
      </plugin>
      <plugin>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <workingDirectory>target</workingDirectory>
        </configuration>
      </plugin>
      <plugin>
        <artifactId>maven-jar-plugin</artifactId>
        <configuration>
          <archive>
            <manifest>
              <addDefaultSpecificationEntries>
              true</addDefaultSpecificationEntries>
              <addDefaultImplementationEntries>
              true</addDefaultImplementationEntries>
            </manifest>
          </archive>
        </configuration>
      </plugin>
      <plugin>
        <artifactId>maven-source-plugin</artifactId>
        <executions>
          <execution>
            <goals>
              <goal>jar</goal>
            </goals>
          </execution>
        </executions>
      </plugin>

        <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-release-plugin</artifactId>
                <version>2.0</version>
                <configuration>
                        <preparationGoals>clean</preparationGoals>
                        <releaseVersion>5.1.0</releaseVersion>
                        <developmentVersion>5.2.0-SNAPSHOT</developmentVersion>
                        <autoVersionSubmodules>true</autoVersionSubmodules>

                        <tag>5.1.x</tag>
                        <tagBase>http://dev.esferalia.com/repos/aon-application/releases</tagBase>
                </configuration>
        </plugin>

    </plugins>
  </build>
  <distributionManagement>
    <repository>
      <id>inhouse</id>
      <name>Inhouse Internal Release Repository</name>
      <url>
      scp://dev.esferalia.com/var/www/maven2_repositories/inhouse</url>
    </repository>
    <snapshotRepository>
      <id>inhouse_snapshot</id>
      <name>Inhouse Internal Snapshot Repository</name>
      <url>
      scp://dev.esferalia.com/var/www/maven2_repositories/inhouse_snapshot</url>
	<uniqueVersion>false</uniqueVersion>
    </snapshotRepository>
  </distributionManagement>
  <reporting>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-project-info-reports-plugin</artifactId>
        <reportSets>
          <reportSet>
            <reports>
              <report>index</report>
              <report>dependencies</report>
              <report>mailing-list</report>
              <report>project-team</report>
              <report>cim</report>
              <report>issue-tracking</report>
              <report>scm</report>
            </reports>
          </reportSet>
        </reportSets>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jxr-plugin</artifactId>
      </plugin>
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>jdepend-maven-plugin</artifactId>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-javadoc-plugin</artifactId>
        <configuration>
          <aggregate>true</aggregate>
          <debug>true</debug>
          <links>
            <link>http://java.sun.com/javase/6/docs/api/</link>
            <link>http://java.sun.com/javaee/5/docs/api</link>
          </links>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-changelog-plugin</artifactId>
      </plugin>
    </plugins>
  </reporting>
</project>
