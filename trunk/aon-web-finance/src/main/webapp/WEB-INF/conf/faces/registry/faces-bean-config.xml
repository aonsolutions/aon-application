			<map-entries>
				<map-entry>
					<key>RegistryMedia_registry_id</key>
                    <value>id</value>
				</map-entry>
			</map-entries>
		</managed-property>
	</managed-bean>

	<!-- **** CREDITOR RBANK **** -->
	<managed-bean>
