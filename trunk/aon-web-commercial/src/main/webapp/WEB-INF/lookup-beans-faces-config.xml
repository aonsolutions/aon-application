<?xml version="1.0"?>
<!DOCTYPE faces-config PUBLIC
  "-//Sun Microsystems, Inc.//DTD JavaServer Faces Config 1.1//EN"
  "http://java.sun.com/dtd/web-facesconfig_1_1.dtd">

<faces-config>

	<!-- ************ TARGET LOOKUP ************** -->
	<managed-bean>
		<managed-bean-name>targetLookup</managed-bean-name>
		<managed-bean-class>com.code.aon.faces.controller.RichLookupBean</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
		<managed-property>
			<property-name>beanName</property-name>
			<value>targetLookup</value>
		</managed-property>
		<managed-property>
			<property-name>foreignPojo</property-name>
			<value>com.code.aon.commercial.Target</value>
		</managed-property>
		<managed-property>
			<property-name>listPagePath</property-name>
			<value>/commercial/target/lookup/list.xhtml</value>
		</managed-property>
		<managed-property>
			<property-name>searchPagePath</property-name>
			<value>/commercial/target/lookup/search.xhtml</value>
		</managed-property>		
		<managed-property>
			<property-name>newPagePath</property-name>
			<value>/commercial/target/lookup/form.xhtml</value>
		</managed-property>		
		<managed-property>
			<property-name>listenerClasses</property-name>
			<list-entries>
				<value-class>com.code.aon.ui.form.event.IControllerListener</value-class>
				<value>#{targetLookupListener}</value>
				<value>#{communicationCenterTargetListener}</value>
			</list-entries>
		</managed-property>				
	</managed-bean>
	
	<managed-bean>
		<managed-bean-name>targetLookupListener</managed-bean-name>
		<managed-bean-class>com.code.aon.ui.commercial.event.TargetLookupListener</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
	</managed-bean>	

	<managed-bean>
		<managed-bean-name>communicationCenterTargetListener</managed-bean-name>
		<managed-bean-class>com.code.aon.ui.marketing.event.CommunicationCenterTargetListener</managed-bean-class>
		<managed-bean-scope>none</managed-bean-scope>
	</managed-bean>	
	
</faces-config>