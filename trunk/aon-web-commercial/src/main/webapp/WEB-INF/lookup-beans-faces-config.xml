<?xml version="1.0"?>
<!DOCTYPE faces-config PUBLIC
  "-//Sun Microsystems, Inc.//DTD JavaServer Faces Config 1.1//EN"
  "http://java.sun.com/dtd/web-facesconfig_1_1.dtd">

<faces-config>
	<!-- ************ SELLER LOOKUP ************** -->
	<managed-bean>
		<managed-bean-name>sellerLookup</managed-bean-name>
		<managed-bean-class>com.code.aon.faces.controller.RichLookupBean</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
		<managed-property>
			<property-name>beanName</property-name>
			<value>sellerLookup</value>
		</managed-property>
		<managed-property>
			<property-name>foreignPojo</property-name>
			<value>com.code.aon.sales.Seller</value>
		</managed-property>
		<managed-property>
			<property-name>listPagePath</property-name>
			<value>/commercial/seller/lookup/list.xhtml</value>
		</managed-property>
	</managed-bean>

	<!-- ************ TARGET LOOKUP ************** -->
	<managed-bean>
		<managed-bean-name>targetLookup</managed-bean-name>
		<managed-bean-class>com.code.aon.faces.controller.RichLookupBean</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
		<managed-property>
			<property-name>beanName</property-name>
			<value>targetLookup</value>
		</managed-property>
		<managed-property>
			<property-name>foreignPojo</property-name>
			<value>com.code.aon.commercial.Target</value>
		</managed-property>
		<managed-property>
			<property-name>listPagePath</property-name>
			<value>/commercial/target/lookup/list.xhtml</value>
		</managed-property>
		<managed-property>
			<property-name>searchPagePath</property-name>
			<value>/commercial/target/lookup/search.xhtml</value>
		</managed-property>		
		<managed-property>
			<property-name>newPagePath</property-name>
			<value>/commercial/target/lookup/form.xhtml</value>
		</managed-property>		
		<managed-property>
			<property-name>listenerClasses</property-name>
			<list-entries>
				<value-class>com.code.aon.ui.form.event.IControllerListener</value-class>
				<value>#{targetLookupListener}</value>
				<value>#{communicationCenterTargetListener}</value>
			</list-entries>
		</managed-property>				
	</managed-bean>
	
	<managed-bean>
		<managed-bean-name>targetLookupListener</managed-bean-name>
		<managed-bean-class>com.code.aon.ui.commercial.event.TargetLookupListener</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
	</managed-bean>	

	<managed-bean>
		<managed-bean-name>communicationCenterTargetListener</managed-bean-name>
		<managed-bean-class>com.code.aon.ui.marketing.event.CommunicationCenterTargetListener</managed-bean-class>
		<managed-bean-scope>none</managed-bean-scope>
	</managed-bean>	

	<!-- ************ ITEM LOOKUP ************** -->
	<managed-bean>
		<managed-bean-name>itemLookup</managed-bean-name>
		<managed-bean-class>com.code.aon.faces.controller.RichLookupBean</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
		<managed-property>
			<property-name>beanName</property-name>
			<value>itemLookup</value>
		</managed-property>
		<managed-property>
			<property-name>foreignPojo</property-name>
			<value>com.code.aon.product.Item</value>
		</managed-property>
		<managed-property>
			<property-name>defaultOrder</property-name>
			<value>Item_product_code</value>
		</managed-property>		
		<managed-property>
			<property-name>listPagePath</property-name>
			<value>/commercial/item/lookup/list.xhtml</value>
		</managed-property>
		<managed-property>
			<property-name>searchPagePath</property-name>
			<value>/commercial/item/lookup/search.xhtml</value>
		</managed-property>
	</managed-bean>

	<!-- ************ QUESTION LOOKUP ************** -->
	<managed-bean>
		<managed-bean-name>questionLookup</managed-bean-name>
		<managed-bean-class>com.code.aon.faces.controller.RichLookupBean</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
		<managed-property>
			<property-name>beanName</property-name>
			<value>questionLookup</value>
		</managed-property>
		<managed-property>
			<property-name>foreignPojo</property-name>
			<value>com.code.aon.marketing.Question</value>
		</managed-property>
		<managed-property>
			<property-name>defaultExpressions</property-name>
			<map-entries>
				<map-entry>
					<key>Question_active</key>
					<value>#{true}</value>
				</map-entry>
			</map-entries>
		</managed-property>				
		<managed-property>
			<property-name>listPagePath</property-name>
			<value>/marketing/question/lookup/list.xhtml</value>
		</managed-property>
	</managed-bean>
	
	<!-- ************ SURVEY LOOKUP ************** -->
	<managed-bean>
		<managed-bean-name>surveyLookup</managed-bean-name>
		<managed-bean-class>com.code.aon.faces.controller.RichLookupBean</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
		<managed-property>
			<property-name>beanName</property-name>
			<value>questionLookup</value>
		</managed-property>
		<managed-property>
			<property-name>foreignPojo</property-name>
			<value>com.code.aon.marketing.Survey</value>
		</managed-property>
		<managed-property>
			<property-name>defaultExpressions</property-name>
			<map-entries>
				<map-entry>
					<key>Survey_active</key>
					<value>#{true}</value>
				</map-entry>
			</map-entries>
		</managed-property>						
		<managed-property>
			<property-name>listPagePath</property-name>
			<value>/marketing/survey/lookup/list.xhtml</value>
		</managed-property>
		<managed-property>
			<property-name>listenerClasses</property-name>
			<list-entries>
				<value-class>com.code.aon.ui.form.event.IControllerListener</value-class>
				<value>#{communicationCenterSurveyListener}</value>
			</list-entries>
		</managed-property>						
	</managed-bean>	

	<managed-bean>
		<managed-bean-name>communicationCenterSurveyListener</managed-bean-name>
		<managed-bean-class>com.code.aon.ui.marketing.event.CommunicationCenterSurveyListener</managed-bean-class>
		<managed-bean-scope>none</managed-bean-scope>
	</managed-bean>	
	
	<!-- ************ CAMPAIGN ACTION LOOKUP ************** -->
	<managed-bean>
		<managed-bean-name>campaignActionLookup</managed-bean-name>
		<managed-bean-class>com.code.aon.faces.controller.RichLookupBean</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
		<managed-property>
			<property-name>beanName</property-name>
			<value>campaignActionLookup</value>
		</managed-property>
		<managed-property>
			<property-name>foreignPojo</property-name>
			<value>com.code.aon.marketing.Action</value>
		</managed-property>
		<managed-property>
			<property-name>defaultExpressions</property-name>
			<map-entries>
				<map-entry>
					<key>Action_campaign_active</key>
					<value>#{true}</value>
				</map-entry>
			</map-entries>
		</managed-property>								
		<managed-property>
			<property-name>listPagePath</property-name>
			<value>/marketing/action/lookup/list.xhtml</value>
		</managed-property>
		<managed-property>
			<property-name>listenerClasses</property-name>
			<list-entries>
				<value-class>com.code.aon.ui.form.event.IControllerListener</value-class>
				<value>#{communicationCenterActionListener}</value>
			</list-entries>
		</managed-property>				
	</managed-bean>	

	<managed-bean>
		<managed-bean-name>communicationCenterActionListener</managed-bean-name>
		<managed-bean-class>com.code.aon.ui.marketing.event.CommunicationCenterActionListener</managed-bean-class>
		<managed-bean-scope>none</managed-bean-scope>
	</managed-bean>	
	
</faces-config>