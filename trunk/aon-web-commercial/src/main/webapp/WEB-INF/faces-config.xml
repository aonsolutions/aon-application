<?xml version="1.0"?>
<!DOCTYPE faces-config PUBLIC
  "-//Sun Microsystems, Inc.//DTD JavaServer Faces Config 1.1//EN"
  "http://java.sun.com/dtd/web-facesconfig_1_1.dtd">

<faces-config>
	<application>
		<message-bundle>
			com.code.aon.ui.common.i18n.messages
		</message-bundle>
		<locale-config>
			<default-locale>es</default-locale>
		</locale-config>
	</application>

	<!--  *************** COLLECTIONS ***************** -->

	<managed-bean>
		<managed-bean-name>registryCollections</managed-bean-name>
		<managed-bean-class>
			com.code.aon.ui.registry.controller.RegistryCollectionsController
		</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
	</managed-bean>
	<managed-bean>
		<managed-bean-name>productCollections</managed-bean-name>
		<managed-bean-class>
			com.code.aon.ui.product.controller.ProductCollectionsController
		</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
	</managed-bean>

	<!-- *************** RESOURCE RESOLVER ***************** --> 
	<managed-bean>
		<managed-bean-name>aonResource</managed-bean-name>
		<managed-bean-class>
			com.code.aon.ui.resources.bean.ResourceResolver
		</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
		<managed-property>
			<property-name>resourceContextPath</property-name>
			<value>aon-desktop</value>
		</managed-property>		
		<managed-property>
			<property-name>resourceURIPreffix</property-name>
			<value>/aonResource/3.0.0</value>
		</managed-property>		
	</managed-bean>

	<!--  *************** 
		AON CONFIGURATION
		***************** -->
	<managed-bean>
		<managed-bean-name>aonConfiguration</managed-bean-name>
		<managed-bean-class>
			com.code.aon.ui.common.controller.ConfigurationController
		</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
		<managed-property>
			<property-name>styleSheets</property-name>
			<list-entries>
				<value>#{aonResource.resolve['/aon-richCss.css']}</value>
				<value>#{aonResource.resolveLocal['/css/commercial.css']}</value>
			</list-entries>
		</managed-property>
		<managed-property>
			<property-name>applicationBundles</property-name>
			<map-entries>
				<map-entry>
					<key>bundle</key>
					<value>com.code.aon.ui.common.i18n.messages</value>
				</map-entry>
				<map-entry>
					<key>appBundle</key>
					<value>com.code.aon.ui.commercial.i18n.messages</value>
				</map-entry>
				<map-entry>
					<key>commercialBundle</key>
					<value>com.code.aon.commercial.i18n.messages</value>
				</map-entry>
				<map-entry>
					<key>menuBundle</key>
					<value>com.code.aon.ui.commercial.i18n.menu</value>
				</map-entry>
				<map-entry>
					<key>securityBundle</key>
					<value>com.code.aon.bridge.i18n.messages</value>
				</map-entry>
				<map-entry>
					<key>registryBundle</key>
                    <value>com.code.aon.ui.registry.i18n.messages</value>
				</map-entry>
				<map-entry>
					<key>productBundle</key>
					<value>com.code.aon.ui.product.i18n.messages</value>
				</map-entry>			
				<map-entry>
					<key>marketingBundle</key>
					<value>com.code.aon.ui.marketing.i18n.messages</value>
				</map-entry>			
			</map-entries>
		</managed-property>
	</managed-bean>
   
</faces-config>
