<?xml version="1.0"?>
<components>

	<!-- Basic input controls -->

	<component localName="div" namespace="http://www.code.es/aon-rich-components">
    	<attribute name="layout" value="block" force="true"/>			
	</component>

	<component localName="panelGrid" namespace="http://www.code.es/aon-rich-components">
    	<attribute name="styleClass" value="aon-panelGrid" />			
	</component>

	<component localName="graphicImage" namespace="http://www.code.es/aon-rich-components">
    	<attribute name="styleClass" value="aon-graphicImage" />			
	</component>

	<component localName="outputText" namespace="http://www.code.es/aon-rich-components">
    	<attribute name="styleClass" value="aon-outputText" />			
	</component>

	<component localName="outputLabel" namespace="http://www.code.es/aon-rich-components">
    	<attribute name="styleClass" value="aon-outputLabel" />			
	</component>

	<component localName="form" namespace="http://www.code.es/aon-rich-components">
    	<attribute name="styleClass" value="aon-form-input-text" />			
	</component>

	<component localName="messages" namespace="http://www.code.es/aon-rich-components">
    	<attribute name="showSummary" value="false" type="1" />			
    	<attribute name="showDetail" value="true" type="1" />
    	<attribute name="errorClass" value="aon-error-message" />
    	<attribute name="fatalClass" value="aon-fatal-error-message" />
    	<attribute name="infoClass" value="aon-info-message" />
	</component>

	<component localName="commandButton" namespace="http://www.code.es/aon-rich-components">
    	<attribute name="styleClass" value="aon-form-input-text" />			
	</component>

	<component localName="panelTabSet" namespace="http://www.code.es/aon-rich-components">
    	<attribute name="switchType" value="ajax" />			
	</component>

</components>
