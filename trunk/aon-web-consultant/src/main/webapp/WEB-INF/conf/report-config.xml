	<!--  *********  feePrintList  ********* -->
	<report id="feePrintList" description="Fee Print">
		<template path="/com/code/aon/ui/sales/report/feeList.jasper"/>
		<bean key="com.code.aon.sales.CustomerFee" />
		<criteria provider="#{feePrint}"/>

		<params>
