<?xml version="1.0"?>
<!DOCTYPE faces-config PUBLIC
  "-//Sun Microsystems, Inc.//DTD JavaServer Faces Config 1.1//EN"
  "http://java.sun.com/dtd/web-facesconfig_1_1.dtd">

<faces-config>

	<!-- ************ APPLICATION ************** -->
	<managed-bean>
		<managed-bean-name>application</managed-bean-name>
		<managed-bean-class>com.code.aon.ui.form.BasicController</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
		<managed-property>
			<property-name>queryOnStartUP</property-name>
			<value>true</value>
		</managed-property>
		<managed-property>
			<property-name>pojo</property-name>
			<value>com.code.aon.audit.Application</value>
		</managed-property>
		<managed-property>
			<property-name>beanName</property-name>
			<value>application</value>
		</managed-property>
	</managed-bean>

	<!-- ************ DOMAIN ************** -->
	<managed-bean>
		<managed-bean-name>domain</managed-bean-name>
		<managed-bean-class>com.code.aon.ui.form.BasicController</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
		<managed-property>
			<property-name>queryOnStartUP</property-name>
			<value>true</value>
		</managed-property>
		<managed-property>
			<property-name>pojo</property-name>
			<value>com.code.aon.audit.Domain</value>
		</managed-property>
		<managed-property>
			<property-name>beanName</property-name>
			<value>domain</value> 
		</managed-property>
	</managed-bean>

	<!-- ************ SESSION ************** -->
	<managed-bean>
		<managed-bean-name>auditSession</managed-bean-name>
		<managed-bean-class>com.code.aon.ui.form.BasicController</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
		<managed-property>
			<property-name>queryOnStartUP</property-name>
			<value>true</value>
		</managed-property>
		<managed-property>
			<property-name>pojo</property-name>
			<value>com.code.aon.audit.Session</value>
		</managed-property>
		<managed-property>
			<property-name>beanName</property-name>
			<value>auditSession</value> 
		</managed-property>
	</managed-bean>

	<!-- ************ ACTION EXECUTION ************** -->
	<managed-bean>
		<managed-bean-name>actionExecution</managed-bean-name>
		<managed-bean-class>com.code.aon.ui.form.BasicController</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
		<managed-property>
			<property-name>queryOnStartUP</property-name>
			<value>true</value>
		</managed-property>
		<managed-property>
			<property-name>pojo</property-name>
			<value>com.code.aon.audit.ActionExecution</value>
		</managed-property>
		<managed-property>
			<property-name>beanName</property-name>
			<value>actionExecution</value> 
		</managed-property>
	</managed-bean>

</faces-config>