<?xml version="1.0" encoding="utf-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">

  <parent>
    <groupId>com.code.aon</groupId>
    <artifactId>aon.parent</artifactId>
    <version>5.0.0</version>
  </parent>
  <modelVersion>4.0.0</modelVersion>
  <groupId>com.code.aon</groupId>
  <artifactId>aon.web.parent</artifactId>
  <version>5.0.0</version>
  <packaging>pom</packaging>
  <description>POM padre de los proyectos WEB de AON</description>
  <name>AON WEB ENTITY PARENT</name>
  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-war-plugin</artifactId>
        <configuration>
          <archive>
	    <manifest>
	      <addDefaultSpecificationEntries>true</addDefaultSpecificationEntries>
              <addDefaultImplementationEntries>true</addDefaultImplementationEntries>
	     </manifest>
	    <manifestEntries>
              <dbVersion>${dbVersion}</dbVersion>
            </manifestEntries>
          </archive>
        </configuration>
      </plugin>

                       <plugin>

                                <groupId>org.codehaus.mojo</groupId>
                                <artifactId>rpm-maven-plugin</artifactId>
                                <version>2.0.1</version>
                                <extensions>true</extensions>

				<executions>
					<execution>
					<phase>deploy</phase>
					<goals>
						<goal>attached-rpm</goal>
					</goals>
					</execution>
				</executions>

                                <configuration>
	                            <group>Applications/Aon</group>
	                            <release>${env.BUILD_NUMBER}</release>
				    <copyright>2009, esferalia Networks S.A</copyright>
                                        <mappings>
                                                <mapping>
                                                        <!-- Incluimos úncamente el artifact principal (WAR) -->
                                                        <artifact>
                                                                <classifiers>
                                                                        <classifier></classifier>
                                                                </classifiers>
                                                        </artifact>
                                                        <filemode>755</filemode>
                                                        <username>jboss</username>
                                                        <groupname>jboss</groupname>
                                                        <directory>/var/lib/jbossas/server/default/deploy</directory>
                                                </mapping>
					</mappings>
					<requires>
						<require>aon-directory-client &gt; 5.0.0-4</require>
					</requires>
                                       <postinstallScriptlet>
                                                <scriptFile>src/main/scripts/postinstall</scriptFile>
                                                <fileEncoding>utf-8</fileEncoding>
                                        </postinstallScriptlet>
                                        
					
                                </configuration>
                        </plugin>


    </plugins>
  </build>
  <dependencies>
    <!-- para construir el war para JBOSS 4.2.1 -->
    <dependency>
      <groupId>org.hibernate</groupId>
      <artifactId>hibernate</artifactId>
      <version>3.2.4.sp1</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>org.hibernate</groupId>
      <artifactId>hibernate-annotations</artifactId>
      <version>3.3.0.ga</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>org.hibernate</groupId>
      <artifactId>hibernate-commons-annotations</artifactId>
      <version>3.3.0.ga</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>javax.mail</groupId>
      <artifactId>mail</artifactId>
      <version>1.4</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>javax.servlet</groupId>
      <artifactId>servlet-api</artifactId>
      <version>2.4</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>javax.faces</groupId>
      <artifactId>jsf-api</artifactId>
      <version>1.2_09</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>antlr</groupId>
      <artifactId>antlr</artifactId>
      <version>2.7.6</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>commons-logging</groupId>
      <artifactId>commons-logging</artifactId>
      <version>1.1</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>javax.el</groupId>
      <artifactId>el-api</artifactId>
      <version>1.0</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>org.jboss.slf4j</groupId>
      <artifactId>slf4j-jboss-logging</artifactId>
      <version>1.0.2.GA</version>
      <scope>runtime</scope>
      <exclusions>
        <exclusion>
          <groupId>org.jboss.logging</groupId>
          <artifactId>jboss-logging-spi</artifactId>
        </exclusion>
      </exclusions>
    </dependency>
    <!-- FIN para construir el war-->
  </dependencies>
  <profiles>
    <profile>
      <id>TOMCAT</id>
      <dependencies>
        <dependency>
          <groupId>org.hibernate</groupId>
          <artifactId>hibernate</artifactId>
          <version>3.2.4.sp1</version>
          <scope>compile</scope>
        </dependency>
        <dependency>
          <groupId>org.hibernate</groupId>
          <artifactId>hibernate-annotations</artifactId>
          <version>3.3.0.ga</version>
          <scope>compile</scope>
        </dependency>
        <dependency>
          <groupId>org.hibernate</groupId>
          <artifactId>hibernate-commons-annotations</artifactId>
          <version>3.3.0.ga</version>
          <scope>compile</scope>
        </dependency>
        <dependency>
          <groupId>commons-collections</groupId>
          <artifactId>commons-collections</artifactId>
          <version>3.1</version>
          <scope>runtime</scope>
        </dependency>
        <dependency>
          <groupId>commons-codec</groupId>
          <artifactId>commons-codec</artifactId>
          <version>1.3</version>
          <scope>runtime</scope>
        </dependency>
        <dependency>
          <groupId>antlr</groupId>
          <artifactId>antlr</artifactId>
          <version>2.7.6</version>
          <scope>runtime</scope>
        </dependency>
      </dependencies>
    </profile>
  </profiles>
</project>
