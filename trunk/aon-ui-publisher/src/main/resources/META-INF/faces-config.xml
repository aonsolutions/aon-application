<faces-config version="1.2"
	xmlns="http://java.sun.com/xml/ns/javaee"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://java.sun.com/xml/ns/javaee http://java.sun.com/xml/ns/javaee/web-facesconfig_1_2.xsd">

	<application>
		<resource-bundle>
			<base-name>com.code.aon.ui.publisher.i18n.messages</base-name>
			<var>publisherBundle</var>
		</resource-bundle>
	</application>
	
	<managed-bean>
		<managed-bean-name>publisher</managed-bean-name>
		<managed-bean-class>com.code.aon.ui.publisher.controller.PublisherController</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
	</managed-bean>
		
	<navigation-rule>
		<navigation-case>
			<from-outcome>publisher</from-outcome>
			<to-view-id>/com/code/aon/ui/publisher/facelet/publisher/form.xhtml</to-view-id>
		</navigation-case>
	</navigation-rule>		
	
</faces-config>