<faces-config version="1.2"
	xmlns="http://java.sun.com/xml/ns/javaee"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://java.sun.com/xml/ns/javaee http://java.sun.com/xml/ns/javaee/web-facesconfig_1_2.xsd">
	
	<application>
		<message-bundle>com.code.aon.ui.common.i18n.messages</message-bundle>
		<locale-config>
			<default-locale>es</default-locale>
			<supported-locale>en</supported-locale>
		</locale-config>
		<view-handler>com.sun.facelets.FaceletViewHandler</view-handler>  
		<resource-bundle>
			<base-name>com.code.aon.web.ecommerce.i18n.messages</base-name>
			<var>appBundle</var>
		</resource-bundle>
	</application>

	<!-- *************** RESOURCE RESOLVER ***************** --> 
	<managed-bean>
		<managed-bean-name>aonResource</managed-bean-name>
		<managed-bean-class>
			com.code.aon.ui.resources.bean.ResourceResolver
		</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
		<managed-property>
			<property-name>resourceContextPath</property-name>
			<value>aon-ecommerce</value>
		</managed-property>		
		<managed-property>
			<property-name>resourceURIPreffix</property-name>
			<value>/aonResource/3.7.0</value>
		</managed-property>		
	</managed-bean>

	<!--  **** AON CONFIGURATION **** -->
	<managed-bean>
		<managed-bean-name>aonConfiguration</managed-bean-name>
		<managed-bean-class>
			com.code.aon.ui.common.controller.ConfigurationController
		</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
		<managed-property>
			<property-name>styleSheets</property-name>
			<list-entries>
				<value>#{aonResource.resolve['/aon-richCss.css']}</value>
				<value>#{aonResource.resolveLocal['/css/ecomerce-default.css']}</value>
				<!--  
				-->
			</list-entries>
		</managed-property>

		<managed-property>
			<property-name>properties</property-name>
			<map-entries>
			<!--  
				<map-entry>
					<key>hideHeaderLinks</key>
					<value>#{true}</value>
				</map-entry>
				<map-entry>
					<key>middleHeader</key>
					<value>COMERCIO ELECTRONICO -i18n-</value>
				</map-entry>
			-->
				<map-entry>
					<key>hideMenuBar</key>
					<value>#{true}</value>
				</map-entry>
				
			</map-entries>
		</managed-property>
		
	</managed-bean>

	<!-- *************************************** -->
	<!-- ************ NAVIGATION *************** -->
	<!-- *************************************** -->

	<navigation-rule>
		<navigation-case>
			<from-outcome>logout</from-outcome>
			<to-view-id>/home.jsf</to-view-id>
			<redirect />
		</navigation-case>
	</navigation-rule>

	<!-- =================== Application Menu Navigation Rules ================= -->	
<!--  
-->
	<navigation-rule>
		<navigation-case>
			<from-outcome>menu_products</from-outcome>
			<to-view-id>/facelet/menu/products.xhtml</to-view-id> 
		</navigation-case>
	</navigation-rule>

	<navigation-rule>
		<navigation-case>
			<from-outcome>menu_commercial</from-outcome>
			<to-view-id>/facelet/menu/commercial.xhtml</to-view-id> 
		</navigation-case>
	</navigation-rule>
	
	
	
</faces-config>