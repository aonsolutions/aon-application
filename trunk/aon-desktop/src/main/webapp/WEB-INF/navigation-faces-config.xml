<?xml version="1.0"?>
<!DOCTYPE faces-config PUBLIC
  "-//Sun Microsystems, Inc.//DTD JavaServer Faces Config 1.1//EN"
  "http://java.sun.com/dtd/web-facesconfig_1_1.dtd">

<faces-config>

	<!-- =================== HOME ================= -->
	<navigation-rule>
		<navigation-case>
			<from-outcome>home</from-outcome>
			<to-view-id>/home.iface</to-view-id>
		</navigation-case>
	</navigation-rule>

	<!-- =================== HOME ================= -->
	<navigation-rule>
		<navigation-case>
			<from-outcome>index</from-outcome>
			<to-view-id>/index.iface</to-view-id>
		</navigation-case>
	</navigation-rule>

	<!-- =================== User ================= -->
	<navigation-rule>
		<navigation-case>
			<from-outcome>user_list</from-outcome>
			<to-view-id>/facelet/user/list.faces</to-view-id>
		</navigation-case>
		<navigation-case>
			<from-outcome>user_form</from-outcome>
			<to-view-id>/facelet/user/form.faces</to-view-id>
		</navigation-case>
		<navigation-case>
			<from-outcome>user_search</from-outcome>
			<to-view-id>/facelet/user/search.faces</to-view-id>
		</navigation-case>
		<navigation-case>
			<from-outcome>user_changepassword_form</from-outcome>
			<to-view-id>/facelet/user/changepassword.faces</to-view-id>
		</navigation-case>
	</navigation-rule>
	
	<!-- =================== Application Menu Navigation Rules ================= -->
	<navigation-rule>
		<navigation-case>
			<from-outcome>firstContent</from-outcome>
			<to-view-id>
				/facelet/homepage/firstContent.iface
			</to-view-id>
		</navigation-case>
		<navigation-case>
			<from-outcome>content</from-outcome>
			<to-view-id>/facelet/homepage/content.iface</to-view-id>
		</navigation-case>
		<navigation-case>
			<from-outcome>user</from-outcome>
			<to-view-id>/facelet/user/list.iface</to-view-id>
		</navigation-case>
		<navigation-case>
			<from-outcome>work_group</from-outcome>
			<to-view-id>/facelet/workGroup/grid.iface</to-view-id>
		</navigation-case>
		<navigation-case>
			<from-outcome>scope</from-outcome>
			<to-view-id>/facelet/scope/grid.iface</to-view-id>
		</navigation-case>
		<navigation-case>
			<from-outcome>application_list</from-outcome>
			<to-view-id>/facelet/profile/application/list.iface</to-view-id>
		</navigation-case>
		<navigation-case>
			<from-outcome>profile_list</from-outcome>
			<to-view-id>/facelet/profile/list.iface</to-view-id>
		</navigation-case>
		<navigation-case>
			<from-outcome>profile_form</from-outcome>
			<to-view-id>/facelet/profile/form.iface</to-view-id>
		</navigation-case>
		<navigation-case>
			<from-outcome>user_profile_form</from-outcome>
			<to-view-id>/facelet/profile/user/form.iface</to-view-id>
		</navigation-case>
	</navigation-rule>

	<!-- =================== Groupware Menu Navigation Rules ================= -->
  <navigation-rule>
    <navigation-case>
        <from-outcome>note</from-outcome>
        <to-view-id>/groupware/facelet/note/list.faces</to-view-id>
    </navigation-case>
    <navigation-case>
        <from-outcome>notice</from-outcome>
        <to-view-id>/groupware/facelet/notice/list.faces</to-view-id>
    </navigation-case>
 	<navigation-case>
        <from-outcome>alarm</from-outcome>
        <to-view-id>/groupware/facelet/alarm/list.faces</to-view-id>
    </navigation-case>
    <navigation-case>
        <from-outcome>contact</from-outcome>
        <to-view-id>/groupware/facelet/contact/list.faces</to-view-id>
    </navigation-case>
    <navigation-case>
        <from-outcome>favorite</from-outcome>
        <to-view-id>/groupware/facelet/favorite/list.faces</to-view-id>
    </navigation-case>
    <navigation-case>
        <from-outcome>note_form</from-outcome>
        <to-view-id>/groupware/facelet/note/form.faces</to-view-id>
    </navigation-case>
    <navigation-case>
        <from-outcome>notice_form</from-outcome>
        <to-view-id>/groupware/facelet/notice/form.faces</to-view-id>
    </navigation-case>
 	<navigation-case>
        <from-outcome>alarm_form</from-outcome>
        <to-view-id>/groupware/facelet/alarm/form.faces</to-view-id>
    </navigation-case>
    <navigation-case>
        <from-outcome>contact_form</from-outcome>
        <to-view-id>/groupware/facelet/contact/form.faces</to-view-id>
    </navigation-case>
    <navigation-case>
        <from-outcome>favorite_form</from-outcome>
        <to-view-id>/groupware/facelet/favorite/form.faces</to-view-id>
    </navigation-case>
    <navigation-case>
        <from-outcome>favorite_category</from-outcome>
        <to-view-id>/groupware/facelet/favorite/category/grid.faces</to-view-id>
    </navigation-case>
  </navigation-rule>

</faces-config>
