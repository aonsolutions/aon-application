<faces-config version="1.2"
	xmlns="http://java.sun.com/xml/ns/javaee"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://java.sun.com/xml/ns/javaee http://java.sun.com/xml/ns/javaee/web-facesconfig_1_2.xsd">

	<application>
		<resource-bundle>
			<base-name>com.code.aon.ui.sign.i18n.messages</base-name>
			<var>signBundle</var>
		</resource-bundle>
	</application>
	
	<managed-bean>
		<managed-bean-name>certificate</managed-bean-name>
		<managed-bean-class>
			com.code.aon.ui.sign.controller.CertificateController
		</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
	</managed-bean>
	
</faces-config>
