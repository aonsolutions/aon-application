	<report id="offerPdf" description="Offers's Report">
		<template path="/com/code/aon/ui/commercial/report/offer.jasper"/>
		<bean key="com.code.aon.commercial.Offer" />
		<criteria provider="#{offer}"/>

		<params>
			<param id="REPORT_RESOURCE_BUNDLE" value="com.code.aon.ui.commercial.i18n.report" />
			<param id="TotalPrice" value="#{offer.getTotalPrice}" />
			<param id="PriceStrategy" value="#{offerDetail.getPriceStrategy}" />
			<param id="logoImageFile" value="#{company.getAttachAsInputStream}" />
			<param id="recordData" value="#{company.getCompanyRecordData}" />
			<param id="company" value="#{company.obtainCompany}" />
			<param id="phone" value="#{company.obtainPhone}" />
			<param id="fax" value="#{company.obtainFax}" />
			<param id="email" value="#{company.obtainEmail}" />
			<param id="web" value="#{company.obtainWeb}" />
			<param id="address" value="#{company.obtainAddress}" />
			<param id="targetPhone" value="#{offer.getTargetPhone}" />
			<param id="targetCellular" value="#{offer.getTargetCellularPhone}" />
			<param id="targetEmail" value="#{offer.getTargetEmail}" />
			<param id="targetFax" value="#{offer.getTargetFax}" />
			<param id="targetPayMethod" value="#{offer.getTargetPayMethod}" />
			<param id="defaultPayMethod" value="#{offer.getDefaultPayMethod}" />			
			<param id="printRecordData" value="#{company.isPrintRecordData}" />
			<param id="printHeader" value="#{company.isPrintHeader}" />
		</params>
		
		<nested-report report="offerDetail"/>
		<nested-report report="offerVatBreakDown"/>
		<nested-report report="offerGeneralTerms"/>
		<nested-report report="offerParticularTerms"/>
	</report>
	
	<report id="deliveryPdf" description="Delivery report ">
		<template path="/com/code/aon/ui/warehouse/report/delivery.jasper" />
		<collection provider="#{delivery}" forceRefresh="true"/>
		<params>
			<param id="REPORT_RESOURCE_BUNDLE" value="com.code.aon.ui.warehouse.i18n.report" />
			<param id="logoImageFile" value="#{company.getAttachAsInputStream}" />
			<param id="company" value="#{company.obtainCompany}" />
			<param id="logoImageFile" value="#{company.getAttachAsInputStream}" />
			<param id="recordData" value="#{company.getCompanyRecordData}" />
			<param id="company" value="#{company.obtainCompany}" />
			<param id="phone" value="#{company.obtainPhone}" />
			<param id="fax" value="#{company.obtainFax}" />
			<param id="email" value="#{company.obtainEmail}" />
			<param id="web" value="#{company.obtainWeb}" />
			<param id="address" value="#{company.obtainAddress}" />
			<param id="printRecordData" value="#{company.isPrintRecordData}"/>
			<param id="printHeader" value="#{company.isPrintHeader}" />
			<param id="PriceStrategy" value="#{deliveryDetail.getPriceStrategy}" />
			<param id="TotalPrice" value="#{delivery.getTotalPrice}" />
			<param id="warehouse" value="#{delivery.getWarehouse}" />
			<param id="defaultPayMethod" value="#{delivery.getDefaultPayMethod}" />
		</params>
		
		<nested-report report="deliveryDetail"/>
	 	<nested-report report="deliveryVatBreakDown"/>	
	</report>
		
	
