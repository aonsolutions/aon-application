<faces-config version="1.2" xmlns="http://java.sun.com/xml/ns/javaee"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://java.sun.com/xml/ns/javaee http://java.sun.com/xml/ns/javaee/web-facesconfig_1_2.xsd">

	<application>
		<resource-bundle>
			<base-name>com.code.aon.ui.stat.i18n.messages</base-name>
			<var>statBundle</var>
		</resource-bundle>
	</application>

	<!-- *************STAT***************** -->
	<managed-bean>
		<managed-bean-name>stat</managed-bean-name>
		<managed-bean-class>
			com.code.aon.ui.stat.controller.StatEngineController</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
	</managed-bean>

	<!-- *************Sales Accumulate Stats***************** -->
	<navigation-rule>

		<navigation-case>
			<from-outcome>sales_stats_year</from-outcome>
			<to-view-id>
				/com/code/aon/ui/stat/facelet/salesAccumulate/yearStats.xhtml</to-view-id>
		</navigation-case>

		<navigation-case>
			<from-outcome>sales_stats_month</from-outcome>
			<to-view-id>
				/com/code/aon/ui/stat/facelet/salesAccumulate/monthStats.xhtml</to-view-id>
		</navigation-case>

		<navigation-case>
			<from-outcome>sales_stats_day</from-outcome>
			<to-view-id>
				/com/code/aon/ui/stat/facelet/salesAccumulate/dayStats.xhtml</to-view-id>
		</navigation-case>

		<navigation-case>
			<from-outcome>customer_stat_list_year</from-outcome>
			<to-view-id>
				/com/code/aon/ui/stat/facelet/salesAccumulate/customerStatsYear.xhtml</to-view-id>
		</navigation-case>
		<navigation-case>
			<from-outcome>customer_stat_list_month</from-outcome>
			<to-view-id>
				/com/code/aon/ui/stat/facelet/salesAccumulate/customerStatsMonth.xhtml</to-view-id>
		</navigation-case>
		<navigation-case>
			<from-outcome>customer_stat_list_day</from-outcome>
			<to-view-id>
				/com/code/aon/ui/stat/facelet/salesAccumulate/customerStatsDay.xhtml</to-view-id>
		</navigation-case>

		<navigation-case>
			<from-outcome>sales_accumulate_search</from-outcome>
			<to-view-id>
				/com/code/aon/ui/stat/facelet/salesAccumulate/search.xhtml</to-view-id>
		</navigation-case>

	</navigation-rule>

	<!-- *************Client Segment Stats***************** -->
	<navigation-rule>

	    <navigation-case>
			<from-outcome>segment_stats_day</from-outcome>
			<to-view-id>
				/com/code/aon/ui/stat/facelet/customerSegmentSales/dayStats.xhtml</to-view-id>
		</navigation-case>

		<navigation-case>
			<from-outcome>segment_stats_month</from-outcome>
			<to-view-id>
				/com/code/aon/ui/stat/facelet/customerSegmentSales/monthStats.xhtml</to-view-id>
		</navigation-case>

		<navigation-case>
			<from-outcome>segment_stats_year</from-outcome>
			<to-view-id>
				/com/code/aon/ui/stat/facelet/customerSegmentSales/yearStats.xhtml</to-view-id>
		</navigation-case>

		<navigation-case>
			<from-outcome>segment_stats_search</from-outcome>
			<to-view-id>
				/com/code/aon/ui/stat/facelet/customerSegmentSales/search.xhtml</to-view-id>
		</navigation-case>
		
		<navigation-case>
			<from-outcome>segmentcustomer_stat_list</from-outcome>
			<to-view-id>
				/com/code/aon/ui/stat/facelet/customerSegmentSales/customerStats.xhtml</to-view-id>
		</navigation-case>

	</navigation-rule>


	<!-- *************Category Sales Stats***************** -->
	<navigation-rule>

		<navigation-case>
			<from-outcome>category_product_stats</from-outcome>
			<to-view-id>
				/com/code/aon/ui/stat/facelet/categoryProductSales/productStats.xhtml</to-view-id>
		</navigation-case>


		<navigation-case>
			<from-outcome>category_stats_year</from-outcome>
			<to-view-id>
				/com/code/aon/ui/stat/facelet/categoryProductSales/yearStats.xhtml</to-view-id>
		</navigation-case>

		<navigation-case>
			<from-outcome>category_stats_search</from-outcome>
			<to-view-id>
				/com/code/aon/ui/stat/facelet/categoryProductSales/search.xhtml</to-view-id>
		</navigation-case>

	</navigation-rule>

	
	<navigation-rule>
		
    <!-- *************ABC Category***************** -->
    
    
        <navigation-case>
			<from-outcome>abc_stats_searchCategory</from-outcome>
			<to-view-id>/com/code/aon/ui/stat/facelet/abcCategory/searchCategory.xhtml</to-view-id>
		</navigation-case>
    
    	<navigation-case>
			<from-outcome>abc_category_stats</from-outcome>
			<to-view-id>
				/com/code/aon/ui/stat/facelet/abcCategory/abcCategoryStats.xhtml</to-view-id>
		</navigation-case>
		
		<navigation-case>
			<from-outcome>product_stats</from-outcome>
			<to-view-id>
				/com/code/aon/ui/stat/facelet/abcCategory/productStats.xhtml</to-view-id>
		</navigation-case>
		
		<navigation-case>
			<from-outcome>month_stats</from-outcome>
			<to-view-id>
				/com/code/aon/ui/stat/facelet/abcCategory/monthStats.xhtml</to-view-id>
		</navigation-case>
		
		
    
    
    <!-- *************ABC Product***************** -->
    
    	<navigation-case>
			<from-outcome>abc_stats_searchProduct</from-outcome>
			<to-view-id>/com/code/aon/ui/stat/facelet/abcProduct/searchProduct.xhtml</to-view-id>
		</navigation-case>
		   
        <navigation-case>
			<from-outcome>abc_product_stats</from-outcome>
			<to-view-id>
				/com/code/aon/ui/stat/facelet/abcProduct/abcProductStats.xhtml</to-view-id>
		</navigation-case>
    
    	<navigation-case>
			<from-outcome>abc_product_month_stats</from-outcome>
			<to-view-id>
				/com/code/aon/ui/stat/facelet/abcProduct/monthStats.xhtml</to-view-id>
		</navigation-case>
    
    
    <!-- *************ABC Customer***************** -->
    
		
	    <navigation-case>
			<from-outcome>abc_stats_search</from-outcome>
			<to-view-id>
			    /com/code/aon/ui/stat/facelet/abcCustomer/search.xhtml</to-view-id>
		</navigation-case>
		
	
		<navigation-case>
			<from-outcome>abc_customer_stats</from-outcome>
			<to-view-id>
				/com/code/aon/ui/stat/facelet/abcCustomer/abcCustomerStats.xhtml</to-view-id>
		</navigation-case>

	    <navigation-case>
			<from-outcome>customer_month_stats</from-outcome>
			<to-view-id>
				/com/code/aon/ui/stat/facelet/abcCustomer/monthStats.xhtml</to-view-id>
		</navigation-case>
		


	</navigation-rule>
	
	
	<!-- *************Summary 12 + 1 Stats***************** -->
	<navigation-rule>
	
		<navigation-case>
			<from-outcome>summary_stats_year</from-outcome>
			<to-view-id>
				/com/code/aon/ui/stat/facelet/summarySales/yearStats.xhtml</to-view-id>
		</navigation-case>

		<navigation-case>
			<from-outcome>summary_stats_search</from-outcome>
			<to-view-id>
				/com/code/aon/ui/stat/facelet/summarySales/search.xhtml</to-view-id>
		</navigation-case>

	</navigation-rule>
	
		<!-- *************Summary 12 + 1 Stats***************** -->
	<navigation-rule>
	
		<navigation-case>
			<from-outcome>invoice_list</from-outcome>
			<to-view-id>
				/com/code/aon/ui/stat/facelet/generic/invoiceList.xhtml</to-view-id>
		</navigation-case>
		
	</navigation-rule>


</faces-config>