<faces-config version="1.2" xmlns="http://java.sun.com/xml/ns/javaee"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://java.sun.com/xml/ns/javaee http://java.sun.com/xml/ns/javaee/web-facesconfig_1_2.xsd">

	<application>
		<resource-bundle>
			<base-name>com.code.aon.ui.stat.i18n.messages</base-name>
			<var>statBundle</var>
		</resource-bundle>
	</application>

	<!-- *************STAT***************** -->
	<managed-bean>
		<managed-bean-name>stat</managed-bean-name>
		<managed-bean-class>
			com.code.aon.ui.stat.controller.StatEngineController</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
	</managed-bean>

	<managed-bean>
		<managed-bean-name>registryStat</managed-bean-name>
		<managed-bean-class>
			com.code.aon.ui.stat.controller.RegistryStatEngineController</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
	</managed-bean>

	<managed-bean>
		<managed-bean-name>productStat</managed-bean-name>
		<managed-bean-class>
			com.code.aon.ui.stat.controller.ProductStatEngineController</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
	</managed-bean>

	<managed-bean>
		<managed-bean-name>commercialStat</managed-bean-name>
		<managed-bean-class>
			com.code.aon.ui.stat.controller.CommercialStatEngineController</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
	</managed-bean>

	<!-- *************Invoice Accumulate Stats***************** -->
	<navigation-rule>

		<navigation-case>
			<from-outcome>sales_stats_year</from-outcome>
			<to-view-id>
				/com/code/aon/ui/stat/facelet/invoiceAccumulate/yearStats.xhtml</to-view-id>
		</navigation-case>

		<navigation-case>
			<from-outcome>sales_stats_month</from-outcome>
			<to-view-id>
				/com/code/aon/ui/stat/facelet/invoiceAccumulate/monthStats.xhtml</to-view-id>
		</navigation-case>

		<navigation-case>
			<from-outcome>sales_stats_day</from-outcome>
			<to-view-id>
				/com/code/aon/ui/stat/facelet/invoiceAccumulate/dayStats.xhtml</to-view-id>
		</navigation-case>

		<navigation-case>
			<from-outcome>customer_stat_list_year</from-outcome>
			<to-view-id>
				/com/code/aon/ui/stat/facelet/invoiceAccumulate/customerStatsYear.xhtml</to-view-id>
		</navigation-case>
		<navigation-case>
			<from-outcome>customer_stat_list_month</from-outcome>
			<to-view-id>
				/com/code/aon/ui/stat/facelet/invoiceAccumulate/customerStatsMonth.xhtml</to-view-id>
		</navigation-case>
		<navigation-case>
			<from-outcome>customer_stat_list_day</from-outcome>
			<to-view-id>
				/com/code/aon/ui/stat/facelet/invoiceAccumulate/customerStatsDay.xhtml</to-view-id>
		</navigation-case>

		<navigation-case>
			<from-outcome>sales_accumulate_search</from-outcome>
			<to-view-id>
				/com/code/aon/ui/stat/facelet/invoiceAccumulate/search.xhtml</to-view-id>
		</navigation-case>

	</navigation-rule>

