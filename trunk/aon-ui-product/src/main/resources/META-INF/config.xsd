<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
	<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
		xmlns="http://www.esferalia.com/product" targetNamespace="http://www.esferalia.com/product"
		elementFormDefault="qualified">
	<xs:element name="config">	
		<xs:complexType>
		    <xs:sequence>
		      <xs:element ref="product" />
		    </xs:sequence>		
			<xs:attribute name="version" type="xs:string" use="required" fixed="1.0"/>		    
		</xs:complexType>
	</xs:element>
	<xs:element name="product">
		<xs:complexType>
			<xs:attribute name="showStock" type="xs:boolean" use="required"/>
			<xs:attribute name="showAccount" type="xs:boolean" use="required"/>
			<xs:attribute name="showAttachment" type="xs:boolean" use="required"/>
			<xs:attribute name="showEcommerceDataTab" type="xs:boolean" use="required"/>
		</xs:complexType>
	</xs:element>
</xs:schema>
