		<managed-property>
			<property-name>defaultExpressions</property-name>
			<map-entries>
				<map-entry>
					<key>Item_product_type</key>
					<value>! 4</value>
				</map-entry>
			</map-entries>
		</managed-property>		
		<managed-property>
			<property-name>defaultOrder</property-name>
			<value>Item_product_name</value>
