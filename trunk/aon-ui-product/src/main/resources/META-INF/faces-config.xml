<faces-config version="1.2" xmlns="http://java.sun.com/xml/ns/javaee" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://java.sun.com/xml/ns/javaee http://java.sun.com/xml/ns/javaee/web-facesconfig_1_2.xsd">

	<!--  **** PRODUCT COLLECTIONS ****	-->
	<managed-bean>
		<managed-bean-name>productCollections</managed-bean-name>
		<managed-bean-class>
			com.code.aon.ui.product.controller.ProductCollectionsController
		</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
	</managed-bean>

	<!-- ****** ITEM ****** -->
	<managed-bean>
		<managed-bean-name>item</managed-bean-name>
		<managed-bean-class>com.code.aon.ui.product.controller.ItemController</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
		<managed-property>
			<property-name>queryOnStartUP</property-name>
			<value>false</value>
		</managed-property>
		<managed-property>
			<property-name>pojo</property-name>
			<value>com.code.aon.product.Item</value>
		</managed-property>
		<managed-property>
			<property-name>beanName</property-name>
			<value>item</value>
		</managed-property>
		<managed-property>
			<property-name>defaultOrder</property-name>
			<value>Item_product_name</value>
		</managed-property>
		<managed-property>
			<property-name>listenerClasses</property-name>
			<list-entries>
				<value-class>com.code.aon.ui.form.event.IControllerListener</value-class>
<!-- 				<value>#{productAccountListener}</value>  -->
				<value>#{itemControllerListener}</value>
			</list-entries>
		</managed-property>
	</managed-bean>
	<managed-bean>
		<managed-bean-name>itemControllerListener</managed-bean-name>
		<managed-bean-class>
			com.code.aon.ui.product.event.ItemControllerListener
		</managed-bean-class>
		<managed-bean-scope>none</managed-bean-scope>
	</managed-bean>

	<!-- ****** PRODUCT CATEGORY ****** -->
	<managed-bean>
		<managed-bean-name>productCategory</managed-bean-name>
		<managed-bean-class>com.code.aon.ui.form.BasicController</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
		<managed-property>
			<property-name>queryOnStartUP</property-name>
			<value>true</value>
		</managed-property>
		<managed-property>
			<property-name>pojo</property-name>
			<value>com.code.aon.product.ProductCategory</value>
		</managed-property>
		<managed-property>
			<property-name>beanName</property-name>
			<value>productCategory</value>
		</managed-property>
		<managed-property>
			<property-name>defaultOrder</property-name>
			<value>ProductCategory_name</value>
		</managed-property>
	</managed-bean>
	
   	<!-- ************* NAVIGATION RULES ***************** -->
	<navigation-rule>
		<navigation-case>
		  <from-outcome>item_form</from-outcome>
		  <to-view-id>/com/code/aon/ui/product/facelet/item/form.xhtml</to-view-id>
      	</navigation-case>
		<navigation-case>
		  <from-outcome>item_list</from-outcome>
		  <to-view-id>/com/code/aon/ui/product/facelet/item/list.xhtml</to-view-id>
      	</navigation-case>
      	<navigation-case>
		  <from-outcome>item_search</from-outcome>
		  <to-view-id>/com/code/aon/ui/product/facelet/item/search.xhtml</to-view-id>
		</navigation-case>
	    <navigation-case>
	      <from-outcome>productCategory</from-outcome>
	      <to-view-id>/com/code/aon/ui/product/facelet/category/grid.xhtml</to-view-id>
	    </navigation-case>
   </navigation-rule>
</faces-config>