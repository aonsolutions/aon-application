<?xml version="1.0" encoding="UTF-8" ?>
<config
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.esferalia.com/finance finance.xsd"
	xmlns="http://www.esferalia.com/config" >
	
	<company:config version="1.0" xmlns:company="http://www.esferalia.com/company">
		<company:company 
			showRegistryBank="true" 
			showCompanyOtherData="true"
			showPanelTabSet="true" 
			showDigitalCertificate="true"
		/>
	</company:config>
	
	<ecommerce:config version="1.0" xmlns:ecommerce="http://www.esferalia.com/ecommerce">
		<ecommerce:ecommerce
			showStocks="false"
			showEbackoffice="false"
		/>
	</ecommerce:config>
	
	<product:config version="1.0" xmlns:product="http://www.esferalia.com/product">
		<product:product
			showStock="false"
			showAccount="true"
			showAttachment="true"
		/>
	</product:config>
	
</config>
