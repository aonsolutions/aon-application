<?xml version="1.0" encoding="ISO-8859-1"?>
<dao>
	<bean class="com.code.aon.finance.Creditor">
		<alias names="id,registry_id,status,registry_name,registry_alias,registry_document,withholding,transaction,scope_id"/>
		<hibernate names="id,registry.id,status,registry.name,registry.alias,registry.document,withholding,transaction,scope.id"/>
	</bean>
	
	<bean class="com.code.aon.finance.CustomerFee" sqlName="customer_fee">
		<alias names="id,customer_id,customer_registry_name,customer_status,customer_scope_id,line,item_id,item_product_category_id,description,quantity,price,discountExpression,initialDate,finalDate,billingDate,period,securityLevel,workPlace_id"/>
		<hibernate names="id,customer.id,customer.registry.name,customer.status,customer.scope.id,line,item.id,item.product.category.id,description,quantity,price,discountExpression,initialDate,finalDate,billingDate,period,securityLevel,workPlace.id"/>
	</bean>

	<bean class="com.code.aon.finance.Invoice" sqlName="invoice">
		<alias names="id,series,number,referenceCode,project,project_id,registry_id,registryAddress_id,issueDate,taxDate,securityLevel,status,registryName,registryDocument,registryDocumentType,registryDocumentCountry,type,taxFree,surcharge,withholding,comments,investment,transaction,signed,scope_id,service,rectificationType,rectificationInvoice,rectificationInvoice_id,taxableBase,vatQuota,retentionQuota,total" />
		<hibernate names="id,series,number,referenceCode,project,project.id,registry.id,registryAddress.id,issueDate,taxDate,securityLevel,status,registryName,registryDocument,registryDocumentType,registryDocumentCountry,type,taxFree,surcharge,withholding,comments,investment,transaction,signed,scope.id,service,rectificationType,rectificationInvoice,rectificationInvoice.id,taxableBase,vatQuota,retentionQuota,total" />
	</bean>
	
	<bean class="com.code.aon.finance.InvoiceDetail" sqlName="invoice_detail">
		<alias names="description,discountExpression,id,invoice_id,invoice_type,item_id,line,price,project,project_id,quantity,source,sourceId,item_product_type,item_product_code,taxableBase,taxes,workPlace_id" />
		<hibernate names="description,discountExpression,id,invoice.id,invoice.type,item.id,line,price,project,project.id,quantity,source,sourceId,item.product.type,item.product.code,taxableBase,taxes,workPlace.id" />
	</bean>
	
	<bean class="com.code.aon.finance.InvoiceTax" sqlName="invoice_tax">
		<alias names="id,invoiceDetail_id,invoiceDetail_invoice_id,taxType,percentage,surcharge,quota,surchargeQuota,vatDeductionType,withholdingType,deductibleQuota" />
		<hibernate names="id,invoiceDetail.id,invoiceDetail.invoice.id,taxType,percentage,surcharge,quota,surchargeQuota,vatDeductionType,withholdingType,deductibleQuota" />
	</bean>
	
	<bean class="com.code.aon.finance.InvoicingGroup" sqlName="invoicing_group">
		<alias names="id,parent_id,parent_name" />
		<hibernate names="id,parent.id,parent.name" />
	</bean>
	
	<bean class="com.code.aon.finance.InvoicingGroupDetail" sqlName="invoicing_group_detail">
		<alias names="id,invoicingGroup_id,child_id,child_name,grouped" />
		<hibernate names="id,invoicingGroup.id,child.id,child.name,grouped" />
	</bean>
	
	<bean class="com.code.aon.finance.Finance" sqlName="finance">
		<alias names="amount,bankAccount,bank_id,bank_code,concept,dueDate,expenses,financeStatus,id,invoice_id,payMethod_id,payMethod_type,payment,registry_id,registryName,registryDocument,registryDocumentType,registryDocumentCountry,securityLevel,scope_id,invoice_series,invoice_number,invoice_referenceCode,invoice_issueDate" />
		<hibernate names="amount,bankAccount,bank.id,bank.code,concept,dueDate,expenses,financeStatus,id,invoice&lt;id,payMethod.id,payMethod.type,payment,registry.id,registryName,registryDocument,registryDocumentType,registryDocumentCountry,securityLevel,scope.id,invoice&lt;series,invoice&lt;number,invoice&lt;referenceCode,invoice&lt;issueDate" />
	</bean>
	
	<bean class="com.code.aon.finance.FinanceTracking" sqlName="finance_tracking">
		<alias names="amount,bankStatementLink,bankStatementLink_id,bankStatementLink_bankStatement_id,description,id,payMethodTypeDetail_id,recorded,registryBank_id,trackingDate,type,finance_amount,finance_bankAccount,finance_bank_id,finance_bank_code,finance_concept,finance_dueDate,finance_expenses,finance_financeStatus,finance_id,finance_invoice_id,finance_payMethod_id,finance_payMethod_type,finance_payment,finance_registryName,finance_registry_id,securityLevel,finance_invoice_referenceCode,finance_scope_id" />
		<hibernate names="amount,bankStatementLink,bankStatementLink.id,bankStatementLink.bankStatement.id,description,id,payMethodTypeDetail.id,recorded,registryBank.id,trackingDate,type,finance.amount,finance.bankAccount,finance.bank.id,finance.bank.code,finance.concept,finance.dueDate,finance.expenses,finance.financeStatus,finance.id,finance.invoice&lt;id,finance.payMethod.id,finance.payMethod.type,finance.payment,finance.registryName,finance.registry.id,finance.securityLevel,finance.invoice&lt;referenceCode,finance.scope.id" />
	</bean>

	<bean class="com.code.aon.finance.FinanceBatch" sqlName="fbatch">
		<alias names="bankStatementLink,bankStatementLink_id,bankStatementLink_bankStatement_id,description,financeBatchStatus,financeBatchType,id,issueDate,payment,registryBank_id,securityLevel" />
		<hibernate names="bankStatementLink,bankStatementLink.id,bankStatementLink.bankStatement.id,description,financeBatchStatus,financeBatchType,id,issueDate,payment,registryBank.id,securityLevel" />
	</bean>

	<bean class="com.code.aon.finance.FinanceBatchDetail" sqlName="fbatch_detail">
		<alias names="amount,financeBatch_id,finance_id,id,status,financeBatch_issueDate,financeBatch_securityLevel,finance_invoice_referenceCode,finance_concept,finance_dueDate" />
		<hibernate names="amount,financeBatch.id,finance.id,id,status,financeBatch.issueDate,financeBatch.securityLevel,finance.invoice&lt;referenceCode,finance.concept,finance.dueDate" />
	</bean>

	<bean class="com.code.aon.finance.BankStatementLink" sqlName="bank_statement_link">
		<alias names="amount,bankStatement_id,bankStatement_operationDate,bankStatement_payment,bankStatement_securityLevel,bankStatement_status,id,linkedBankStatementLink,linkedBankStatementLink_id,source,sourceDate,sourceId,status" />
		<hibernate names="amount,bankStatement.id,bankStatement.operationDate,bankStatement.payment,bankStatement.securityLevel,bankStatement.status,id,linkedBankStatementLink,linkedBankStatementLink.id,source,sourceDate,sourceId,status" />
	</bean>
</dao>
