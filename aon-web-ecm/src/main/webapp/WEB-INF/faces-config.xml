<?xml version="1.0"?>
<!DOCTYPE faces-config PUBLIC
  "-//Sun Microsystems, Inc.//DTD JavaServer Faces Config 1.1//EN"
  "http://java.sun.com/dtd/web-facesconfig_1_1.dtd">

<faces-config>
	<application>
		<message-bundle>
			es.code.ecm.ui.i18n.messages
		</message-bundle>
		<locale-config>
			<default-locale>es</default-locale>
		</locale-config>
	</application>

	<lifecycle>
		<phase-listener>
			com.code.aon.faces.component.sandbox.ValueChangePhaseListener
		</phase-listener>
	</lifecycle>

	<!-- *************** RESOURCE RESOLVER ***************** --> 
	<managed-bean>
		<managed-bean-name>aonResource</managed-bean-name>
		<managed-bean-class>
			com.code.aon.ui.resources.bean.ResourceResolver
		</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
		<managed-property>
			<property-name>resourceContextPath</property-name>
			<value>aon-desktop</value>
		</managed-property>		
		<managed-property>
			<property-name>resourceURIPreffix</property-name>
			<value>/aonResource/1.4.0</value>
		</managed-property>		
	</managed-bean>

	<!--  *************** 
		AON CONFIGURATION
		***************** -->
	<managed-bean>
		<managed-bean-name>aonConfiguration</managed-bean-name>
		<managed-bean-class>
			com.code.aon.ui.common.controller.ConfigurationController
		</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
		<managed-property>
			<property-name>styleSheets</property-name>
			<list-entries>
				<value>/#{aonResource.resolve['/aon-richCss.css']}</value>
				<value>#{aonResource.resolveLocal['/css/ecm.css']}</value>
			</list-entries>
		</managed-property>
		<managed-property>
			<property-name>applicationBundles</property-name>
			<map-entries>
				<map-entry>
					<key>bundle</key>
					<value>com.code.aon.ui.common.i18n.messages</value>
				</map-entry>
				<map-entry>
					<key>appBundle</key>
					<value>es.code.ecm.ui.i18n.messages</value>
				</map-entry>
				<map-entry>
					<key>menuBundle</key>
					<value>es.code.ecm.ui.i18n.menu</value>
				</map-entry>
				<map-entry>
					<key>securityBundle</key>
					<value>com.code.aon.bridge.i18n.messages</value>
				</map-entry>
			</map-entries>
		</managed-property>
	</managed-bean>

	<!-- ************** EXCEPTION HANDLER ****************** -->
	<managed-bean>
		<managed-bean-name>exceptionBean</managed-bean-name>
		<managed-bean-class>com.code.aon.ui.common.controller.ExceptionBean</managed-bean-class>
		<managed-bean-scope>request</managed-bean-scope>
	</managed-bean>

	<!-- **************** TIMEZONE CONTROLLER ************* -->
	<managed-bean>
		<managed-bean-name>timeZoneController</managed-bean-name>
		<managed-bean-class>com.code.aon.ui.common.controller.TimeZoneController</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
	</managed-bean>

	<!-- ***************** LOGGED USER ******************** --> 
	<managed-bean>
		<managed-bean-name>loggedUser</managed-bean-name>
		<managed-bean-class>com.code.aon.bridge.session.LoggedUser</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
	</managed-bean>

	<!-- ***************** FAILED LOGIN ******************** -->
	<managed-bean>
		<managed-bean-name>failedLogin</managed-bean-name>
		<managed-bean-class>com.code.aon.bridge.session.FailedLogin</managed-bean-class>
		<managed-bean-scope>request</managed-bean-scope>
	</managed-bean>

	<!-- Managed Bean for dynamic style examples -->
	<managed-bean>
		<managed-bean-name>manager</managed-bean-name>
		<managed-bean-class>es.code.cdr.ui.controller.CDRMediator</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
	</managed-bean>
	<managed-bean>
		<managed-bean-name>search</managed-bean-name>
		<managed-bean-class>es.code.cdr.ui.controller.query.QueryMediator</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
	</managed-bean>
	<managed-bean>
		<managed-bean-name>errorMessages</managed-bean-name>
		<managed-bean-class>es.code.cdr.ui.controller.ErrorMessageController</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
	</managed-bean>

  <!-- ======================================================================= -->	
  <!-- =========================== Navigation Rules ========================== -->	
  <!-- ======================================================================= -->

  <!-- =================== Application Menu Navigation Rules ================= -->	
  <navigation-rule>
	<navigation-case>
		<from-outcome>admin_repository</from-outcome>
		<to-view-id>/facelet/repository/content.xhtml</to-view-id>
	</navigation-case>
	<navigation-case>
		<from-outcome>admin_category</from-outcome>
		<to-view-id>/facelet/category/grid.xhtml</to-view-id>
	</navigation-case>
	<navigation-case>
		<from-outcome>search_by_content</from-outcome>
		<to-view-id>/facelet/search/bycontent.xhtml</to-view-id>
	</navigation-case>
	<navigation-case>
		<from-outcome>advanced_search</from-outcome>
		<to-view-id>/facelet/search/advanced.xhtml</to-view-id>
	</navigation-case>
	<navigation-case>
		<from-outcome>user_list</from-outcome>
		<to-view-id>/facelet/permissions/user/grid.xhtml</to-view-id>
	</navigation-case>
  </navigation-rule>

</faces-config>
