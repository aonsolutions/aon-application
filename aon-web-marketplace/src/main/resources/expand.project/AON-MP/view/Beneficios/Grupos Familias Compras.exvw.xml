<?xml version="1.0" encoding="UTF-8"?>
<view description="Beneficios por grupo de familia"
    label="Beneficios por grupo de familia" sqlSentence="SELECT pcategory_group.id as id, pcategory_group.name as familia,&#xd;&#xa;       @ini:=inventarioGrupoCategoriaFecha(?, pcategory_group.id ) as inicial,&#xd;&#xa;       @com:=facturasGrupoCategoriaFecha(?, ?, pcategory_group.id, 0 ) as compras,&#xd;&#xa;       @ven:=facturasGrupoCategoriaFecha(?, ?, pcategory_group.id, 1 ) as ventas,&#xd;&#xa;       @fin:=inventarioGrupoCategoriaFecha(?, pcategory_group.id) as final,&#xd;&#xa;       @ben:=(@ini + @ven - @fin - @com) AS beneficio,&#xd;&#xa;       ((@ben / @com) * 100) AS sobre_compras,&#xd;&#xa;       ((@ben / @ven) * 100) AS sobre_ventas&#xd;&#xa;&#xd;&#xa;  FROM pcategory_group;&#xd;&#xa;&#xd;&#xa;&#xd;&#xa;">
    <parameters>
        <parameter name="inidate" type="DATE"/>
        <parameter name="inidate" type="DATE"/>
        <parameter name="enddate" type="DATE"/>
        <parameter name="inidate" type="DATE"/>
        <parameter name="enddate" type="DATE"/>
        <parameter name="enddate" type="DATE"/>
    </parameters>
    <results>
        <result accessName="CATEGORY_GROUP_ID" columnId="id"
            export="true" label="Código" tableId="pcategory_group" type="INTEGER"/>
        <result accessName="familia" columnId="familia" label="familia"
            tableId="pcategory_group" type="STRING"/>
        <result accessName="inicial" columnId="inicial" label="inicial" type="DOUBLE"/>
        <result accessName="compras" columnId="compras" label="compras" type="DOUBLE"/>
        <result accessName="ventas" columnId="ventas" label="ventas" type="DOUBLE"/>
        <result accessName="final" columnId="final" label="final" type="DOUBLE"/>
        <result accessName="beneficio" columnId="beneficio"
            label="beneficio" type="DOUBLE"/>
        <result accessName="sobre_compras" columnId="sobre_compras"
            label="sobre_compras" type="DOUBLE"/>
        <result accessName="sobre_ventas" columnId="sobre_ventas"
            label="sobre_ventas" type="DOUBLE"/>
    </results>
