<?xml version="1.0" encoding="UTF-8"?>
<table tableName="employee_workgroup">
    <columns>
        <column
            label="Identificador unico de Relacion entre Empleados y Grupos de Trabajo"
            name="id" sqlType="integer" type="integer"/>
        <column label="Identificado del Empleado" name="employee"
            sqlType="integer" type="integer"/>
        <column label="Identificador del Grupo de Trabajo"
            name="workgroup" sqlType="integer" type="integer"/>
    </columns>
    <virtualColumns/>
    <primaryKey>
        <column name="id"/>
    </primaryKey>
    <joins>
        <join description="employee_workgroup_fk_1" foreignPath="data/employee.exdm.xml">
            <sourceColumns>
                <column name="employee"/>
            </sourceColumns>
        </join>
        <join description="employee_workgroup_fk_2" foreignPath="data/workgroup.exdm.xml">
            <sourceColumns>
                <column name="workgroup"/>
            </sourceColumns>
        </join>
    </joins>
    <descriptionColumns/>
</table>
