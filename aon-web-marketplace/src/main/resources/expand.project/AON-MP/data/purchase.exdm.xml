<?xml version="1.0" encoding="UTF-8"?>
<table tableName="purchase">
    <columns>
        <column label="Identificador unico del Pedido de Compra"
            name="id" sqlType="integer" type="integer"/>
        <column label="Tipo de Pedido" length="2" name="document_type"
            sqlType="tinyint" type="string"/>
        <column label="Serie del Pedido" length="3" name="series"
            sqlType="char" type="string"/>
        <column label="Numero del Pedido" name="number"
            sqlType="integer" type="integer"/>
        <column label="Identificador del Proveedor" name="supplier"
            sqlType="integer" type="integer"/>
        <column label="Descuentos del Pedido" length="32"
            name="discount_expression" sqlType="varchar" type="string"/>
        <column label="Fecha de emision del Pedido" name="issue_date"
            sqlType="date" type="date"/>
        <column label="Identificador de la Forma de Pago"
            name="pay_method" sqlType="integer" type="integer"/>
        <column label="Nivel de seguridad del Pedido" length="2"
            name="security_level" sqlType="tinyint" type="string"/>
        <column label="Estado del Pedido" length="2" name="status"
            sqlType="tinyint" type="string"/>
    </columns>
    <virtualColumns/>
    <primaryKey>
        <column name="id"/>
    </primaryKey>
    <joins>
        <join description="purchase_ibfk_1" foreignPath="data/supplier.exdm.xml">
            <sourceColumns>
                <column name="supplier"/>
            </sourceColumns>
        </join>
        <join description="purchase_ibfk_2" foreignPath="data/pay_method.exdm.xml">
            <sourceColumns>
                <column name="pay_method"/>
            </sourceColumns>
        </join>
    </joins>
    <descriptionColumns/>
</table>
