<?xml version="1.0" encoding="UTF-8"?>
<table tableName="customer">
    <columns>
        <column label="Registro del Cliente" name="registry"
            sqlType="integer" type="integer"/>
        <column label="Tarifa asociada al Cliente" name="tariff"
            sqlType="integer" type="integer"/>
        <column label="Indica si el Cliente esta exento de Impuestos"
            length="1" name="taxfree" sqlType="bit" type="string"/>
        <column
            label="Indica si el Cliente tiene recargo de equivalencia"
            length="1" name="surcharge" sqlType="bit" type="string"/>
        <column label="Estado del Cliente" length="2" name="status"
            sqlType="tinyint" type="string"/>
    </columns>
    <virtualColumns/>
    <primaryKey>
        <column name="registry"/>
    </primaryKey>
    <joins>
        <join description="customer_ibfk_1" foreignPath="data/registry.exdm.xml">
            <sourceColumns>
                <column name="registry"/>
            </sourceColumns>
        </join>
        <join description="customer_ibfk_2" foreignPath="data/tariff.exdm.xml">
            <sourceColumns>
                <column name="tariff"/>
            </sourceColumns>
        </join>
    </joins>
    <descriptionColumns/>
</table>
