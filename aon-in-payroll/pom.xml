  <profiles>
    <profile>
    <id>aws-pdf2aon</id>
    <activation>
      <property>
        <name>aws.lambda</name>
        <value>true</value>
      </property>
    </activation>
    <build>
      <plugins>
        <plugin>
          <groupId>org.codehaus.mojo</groupId>
          <artifactId>gwt-maven-plugin</artifactId>
          <configuration>
            <draftCompile>true</draftCompile>
	    	<module>com.esferalia.aon.gwt.payroll.DevelopmentPayroll</module>
          </configuration>
        </plugin>
			<plugin>
			    <groupId>org.apache.maven.plugins</groupId>
			    <artifactId>maven-assembly-plugin</artifactId>
			    <executions>
			        <execution>
			            <phase>package</phase>
			            <goals>
			                <goal>single</goal>
			            </goals>
			            <configuration>
			                <archive>
			                <manifest>
			                    <mainClass>
			                        com.esferalia.aon.in.payroll.PDF2Aon
			                    </mainClass>
			                </manifest>
			                </archive>
			                <descriptorRefs>
			                    <descriptorRef>jar-with-dependencies</descriptorRef>
			                </descriptorRefs>
			            </configuration>
			        </execution>
			    </executions>
			</plugin>
			<plugin>
			  <groupId>org.apache.maven.plugins</groupId>
			  <artifactId>maven-compiler-plugin</artifactId>
			  <configuration combine.self="override" >
			    <excludes/>
			    <testExcludes>
			      <testExclude>com/esferalia/aon/in/payroll/aws/**</testExclude>
			    </testExcludes>
			    <source>11</source>
			    <target>11</target>
				<encoding>ISO-8859-1</encoding>
              </configuration>
			</plugin>
      </plugins>
    </build>
