<!DOCTYPE hibernate-configuration PUBLIC
	"-//Hibernate/Hibernate Configuration DTD 3.0//EN"
	"http://hibernate.sourceforge.net/hibernate-configuration-3.0.dtd">

<hibernate-configuration> 

	<session-factory>
	
		<property name="connection.provider_class">com.code.aon.common.dao.hibernate.C3P0ConnectionProvider</property>
		<property name="connection.service">jboss.admin:service=AonMainDeployer</property>
		<property name="connection.datasource">java:comp/env/jdbc/AonAsset</property>
		<property name="dialect">org.hibernate.dialect.MySQLDialect</property>
		<property name="show_sql">true</property>

		<!-- C3P0 Stuff -->
		<property name="hibernate.c3p0.acquire_increment">1</property>
		<property name="hibernate.c3p0.idle_test_period">1900</property>
		<property name="hibernate.c3p0.timeout">3600</property>
		<property name="hibernate.c3p0.max_size">30</property>
		<property name="hibernate.c3p0.min_size">1</property>
		<property name="hibernate.c3p0.max_statements">0</property>
		<property name="hibernate.c3p0.preferredTestQuery">select 1;</property>

		<mapping package="com.code.aon.common.dao.hibernate.type" />
 
		<!-- AON-ASSET Mapping files --> 
		<mapping class="com.code.aon.asset.Asset"/>
		<mapping class="com.code.aon.asset.AssetFeature"/>
		<mapping class="com.code.aon.asset.AssetActivity"/>
		<mapping class="com.code.aon.asset.AssetType"/>
		<mapping class="com.code.aon.asset.AssetInterval"/>
		<mapping class="com.code.aon.asset.Feature"/>
		
		<!-- AON-AUDIT Mapping files -->
		<mapping class="com.code.aon.audit.Action"/>
		<mapping class="com.code.aon.audit.ActionDenied"/>
		<mapping class="com.code.aon.audit.ActionEntry"/>
		<mapping class="com.code.aon.audit.ActionFavorite"/>
		<mapping class="com.code.aon.audit.Application"/>
		<mapping class="com.code.aon.audit.Session"/>		

		<!-- AON-CALENDAR Mapping files -->		
		<mapping class="com.esferalia.aon.calendar.Calendar"/>
		<mapping class="com.esferalia.aon.calendar.CalendarHoliday"/>	
		<mapping class="com.esferalia.aon.calendar.CalendarPeriod"/>
		<mapping class="com.esferalia.aon.calendar.Holiday"/>	
		<mapping class="com.esferalia.aon.calendar.HolidayDetail"/>			

		<!-- AON-COMPANY Mapping files -->
		<mapping class="com.code.aon.company.Company"/>
		<mapping class="com.code.aon.company.Department"/>
		<mapping class="com.code.aon.company.Enterprise"/>
		<mapping class="com.code.aon.company.EnterpriseData"/>				
		<mapping class="com.code.aon.company.WorkPlace"/>
		<mapping class="com.code.aon.company.WorkplaceDepartment"/>
				
		<!-- AON-CONFIG Mapping files -->
		<mapping class="com.code.aon.config.ApplicationParameter"/>
		<mapping class="com.code.aon.config.Bank"/>
		<mapping class="com.code.aon.config.CNAE"/>
		<mapping class="com.code.aon.config.CNAE2009"/>
		<mapping class="com.code.aon.config.CNAE2009Rate"/>
		<mapping class="com.code.aon.config.CommissionType"/>
		<mapping class="com.code.aon.config.Domain"/>
		<mapping class="com.code.aon.config.PayMethod"/>
		<mapping class="com.code.aon.config.PayMethodTypeDetail"/>
		<mapping class="com.code.aon.config.Series"/>
		<mapping class="com.code.aon.config.Scope"/>
		<mapping class="com.code.aon.config.Tariff"/>
		<mapping class="com.code.aon.config.Tax"/>
		<mapping class="com.code.aon.config.TaxDetail"/>
		<mapping class="com.code.aon.config.User"/>
		<mapping class="com.code.aon.config.UserScope"/>
		<mapping class="com.code.aon.config.WorkGroup"/>
				
		<!-- AON-REGISTRY Mapping files -->	
		<mapping class="com.code.aon.registry.Category"/>
		<mapping class="com.code.aon.registry.RegistryBank"/>
		<mapping class="com.code.aon.registry.RecordData"/>
		<mapping class="com.code.aon.registry.Registry"/>
		<mapping class="com.code.aon.registry.RegistryAddInfo"/>
		<mapping class="com.code.aon.registry.RegistryAddress"/>
		<mapping class="com.code.aon.registry.RegistryAttachment"/>
		<mapping class="com.code.aon.registry.RegistryDirStaff"/>
		<mapping class="com.code.aon.registry.RegistryMedia"/>
		<mapping class="com.code.aon.registry.RegistryNote"/>
		<mapping class="com.code.aon.registry.RegistryPayMethod"/>
		<mapping class="com.code.aon.registry.RegistryRelationship"/>
		<mapping class="com.code.aon.registry.RegistrySegment"/>
		<mapping class="com.code.aon.registry.Relationship"/>
		<mapping class="com.code.aon.registry.Segment"/>

		<!-- AON-GEOZONE Mapping files -->		
		<mapping class="com.code.aon.geozone.GeoTree"/>
		<mapping class="com.code.aon.geozone.GeoZone"/>		
	</session-factory>

</hibernate-configuration>