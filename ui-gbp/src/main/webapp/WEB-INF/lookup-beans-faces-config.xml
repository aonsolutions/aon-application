		<managed-property>
			<property-name>searchPagePath</property-name>
			<value>/facelet/campaign/lookup/search.xhtml</value>
		</managed-property>
	</managed-bean>
	<!-- ************ OFFICE LOOKUP ************** -->
	<managed-bean>
