<?xml version="1.0"?>
<!DOCTYPE faces-config PUBLIC
  "-//Sun Microsystems, Inc.//DTD JavaServer Faces Config 1.1//EN"
  "http://java.sun.com/dtd/web-facesconfig_1_1.dtd">

<faces-config>
	<!-- =================== login ================= -->
	<navigation-rule>
		<navigation-case>
			<from-outcome>valid</from-outcome>
			<to-view-id>/supplier_homepage.xhtml</to-view-id>
		</navigation-case>
	</navigation-rule>

	<!-- =================== Front Offer ================= -->
	<navigation-rule>
		<navigation-case>
			<from-outcome>front_offer_list</from-outcome>
			<to-view-id>/front/offer/list.xhtml</to-view-id>
		</navigation-case>
		<navigation-case>
			<from-outcome>front_offer_form</from-outcome>
			<to-view-id>/front/offer/form.xhtml</to-view-id>
		</navigation-case>
		<navigation-case>
			<from-outcome>front_offer_search</from-outcome>
			<to-view-id>/front/offer/search.xhtml</to-view-id>
		</navigation-case>
	</navigation-rule>

	<!-- =================== Front Pro Forma ================= -->
	<navigation-rule>
		<navigation-case>
			<from-outcome>front_pro_forma_list</from-outcome>
			<to-view-id>/front/pro_forma/list.xhtml</to-view-id>
		</navigation-case>
		<navigation-case>
			<from-outcome>front_pro_forma_form</from-outcome>
			<to-view-id>/front/pro_forma/form.xhtml</to-view-id>
		</navigation-case>
		<navigation-case>
			<from-outcome>front_pro_forma_search</from-outcome>
			<to-view-id>/front/pro_forma/search.xhtml</to-view-id>
		</navigation-case>
	</navigation-rule>
	
	<!-- =================== Front Proof ================= -->
	<navigation-rule>
		<navigation-case>
			<from-outcome>front_proof_list</from-outcome>
			<to-view-id>/front/proof/list.xhtml</to-view-id>
		</navigation-case>
		<navigation-case>
			<from-outcome>front_proof_form</from-outcome>
			<to-view-id>/front/proof/form.xhtml</to-view-id>
		</navigation-case>
		<navigation-case>
			<from-outcome>front_proof_search</from-outcome>
			<to-view-id>/front/proof/search.xhtml</to-view-id>
		</navigation-case>
	</navigation-rule>
</faces-config>
