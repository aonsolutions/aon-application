	<name>AON GWT PAYROLL</name>
	<build>
		<plugins>
			<plugin>
				<groupId>net.ltgt.gwt.maven</groupId>
				<artifactId>gwt-maven-plugin</artifactId>
				<version>HEAD-SNAPSHOT</version>
				<extensions>true</extensions>
				<configuration>
					<skipModule>true</skipModule>
					<webappDirectory>${project.build.outputDirectory}</webappDirectory>
					<moduleName>com.esferalia.aon.gwt.payroll.Payroll</moduleName>
				</configuration>
                                <executions>
                                        <execution>
                                                <phase>prepare-package</phase>
                                                <goals>
                                                        <goal>compile</goal>
                                                </goals>
                                        </execution>
                                </executions>
			</plugin>			
			<plugin>
				<groupId>com.google.code.maven-replacer-plugin</groupId>
				<artifactId>replacer</artifactId>
				<version>1.5.3</version>
				<executions>
					<execution>
						<phase>prepare-package</phase>
						<goals>
							<goal>replace</goal>
						</goals>                   
					</execution>
				</executions>
				<configuration>
					<basedir>${project.basedir}/target/classes</basedir>
					<includes>
						<include>**/gwt/clean/clean.css</include>
					</includes>
					<regexFlags>
					    <regexFlag>MULTILINE</regexFlag>
					    <regexFlag>CASE_INSENSITIVE</regexFlag>
					</regexFlags>
					<replacements>
						<replacement>
							<token>^([a-z: \t,]*)\{$</token>
							<value>/** $1 */
.disabled-by-aon {</value>
						</replacement>         
					</replacements>
				</configuration>
			</plugin>
			<plugin>
			  <groupId>org.apache.maven.plugins</groupId>
			  <artifactId>maven-surefire-plugin</artifactId>
			  <configuration>
			    <systemProperties>
			      <property>
			        <name>javax.xml.validation.SchemaFactory:http://www.w3.org/2001/XMLSchema</name>
			        <value>com.sun.org.apache.xerces.internal.jaxp.validation.XMLSchemaFactory</value>
			      </property>
			    </systemProperties>
			  </configuration>
			</plugin>
			
		</plugins>
	</build>


