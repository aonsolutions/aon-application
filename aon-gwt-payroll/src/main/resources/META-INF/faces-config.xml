<faces-config version="1.2"
	xmlns="http://java.sun.com/xml/ns/javaee"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://java.sun.com/xml/ns/javaee http://java.sun.com/xml/ns/javaee/web-facesconfig_1_2.xsd">

	<managed-bean>
		<managed-bean-name>gwt</managed-bean-name>
		<managed-bean-class>
			com.esferalia.aon.gwt.common.bean.GWT
		</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
	</managed-bean>
			

	<managed-bean>
		<managed-bean-name>employeeTree</managed-bean-name>
		<managed-bean-class>
			com.esferalia.aon.gwt.payroll.bean.EmployeeTree
		</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
	</managed-bean>
			

	<!-- =================== Enterprise Tree  ========================== -->
	<!-- navigation-rule>
		<navigation-case>
			<from-outcome>gwt_enterprise_formTree</from-outcome>
			<to-view-id>/com/esferalia/aon/gwt/payroll/facelet/employee/tree.xhtml</to-view-id>
		</navigation-case>
	</navigation-rule-->
	
	<!-- =================== Employee Tree  ========================== -->
	<navigation-rule>
		<navigation-case>
			<from-outcome>gwt_employee_tree</from-outcome>
			<to-view-id>/com/esferalia/aon/gwt/payroll/facelet/employee/tree.xhtml</to-view-id>
		</navigation-case>
	</navigation-rule>

	<!-- =================== Enterprise Site  ========================== -->
	<navigation-rule>
		<navigation-case>
			<from-outcome>gwt_enterprise_site</from-outcome>
			<to-view-id>/com/esferalia/aon/gwt/payroll/facelet/enterprise/site.xhtml</to-view-id>
		</navigation-case>
	</navigation-rule>
	
	<!-- =================== Main System  ========================== -->
	<navigation-rule>
		<navigation-case>
			<from-outcome>gwt_main_system</from-outcome>
			<to-view-id>/com/esferalia/aon/gwt/payroll/facelet/main/system.xhtml</to-view-id>
		</navigation-case>
	</navigation-rule>

	<!-- =================== Main Calculator  ========================== -->
	<navigation-rule>
		<navigation-case>
			<from-outcome>gwt_main_calculator</from-outcome>
			<to-view-id>/com/esferalia/aon/gwt/payroll/facelet/main/calculator.xhtml</to-view-id>
		</navigation-case>
	</navigation-rule>
			
	<!-- =================== Main Agreement  ========================== -->
	<navigation-rule>
		<navigation-case>
			<from-outcome>gwt_main_agreement</from-outcome>
			<to-view-id>/com/esferalia/aon/gwt/payroll/facelet/main/agreement.xhtml</to-view-id>
		</navigation-case>
	</navigation-rule>

	<!-- ===================== Main Trash  ============================ -->
	<navigation-rule>
		<navigation-case>
			<from-outcome>gwt_main_trash</from-outcome>
			<to-view-id>/com/esferalia/aon/gwt/payroll/facelet/main/trash.xhtml</to-view-id>
		</navigation-case>
	</navigation-rule>

	<!-- =================== Main Agreement  ========================== -->
	<navigation-rule>
		<navigation-case>
			<from-outcome>gwt_main_creta</from-outcome>
			<to-view-id>/com/esferalia/aon/gwt/payroll/facelet/main/creta.xhtml</to-view-id>
		</navigation-case>
	</navigation-rule>

	<!-- =================== Main Agreement  ========================== -->
	<navigation-rule>
		<navigation-case>
			<from-outcome>gwt_activity_summary</from-outcome>
			<to-view-id>/com/esferalia/aon/gwt/payroll/facelet/main/activitySummary.xhtml</to-view-id>
		</navigation-case>
	</navigation-rule>

</faces-config>
		
