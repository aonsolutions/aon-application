									</td>
									<td colspan="2">
										<g:TextBox ui:field="addressCity" styleName='{style.maxWidthTextBox}'></g:TextBox>
									</td>
									<td>
										<g:Label styleName='{style.alignTextCenter}'>Provincia</g:Label>
