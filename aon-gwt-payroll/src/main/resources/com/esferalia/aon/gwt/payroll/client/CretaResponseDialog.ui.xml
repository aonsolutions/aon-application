<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<ui:UiBinder xmlns:ui='urn:ui:com.google.gwt.uibinder'
	xmlns:g='urn:import:com.google.gwt.user.client.ui' 
	xmlns:aon='urn:import:com.esferalia.aon.gwt.common.client.widget'
	xmlns:cell="urn:import:com.google.gwt.user.cellview.client">

	<ui:Style>
	.form {
		padding: 10px;
	}
	
	.label {
		margin-top: 10x;
		font-weight: bold;
		padding: 1px 0.5em;
		white-space: nowrap;
		background-color: #F2F2F2;
	}
	.nowrap {
		white-space: nowrap;
	}
	
	.labeltop {
		margin-top: 10x;
		font-weight: bold;
		padding: 1px 0.5em;
		vertical-align: top;
		white-space: nowrap;
		background-color: #F2F2F2;
	}
	
	.field {
		padding: 1px 0.5em;
	}
	
	.buttons {
		padding-top: 10px;
		text-align: right;
	}
	
	.info {
		
	}
	
	.warn {
		
	}
	
	.error {
		
	}
	
	.messages {
		padding-left: 0.5em;
		padding-bottom: 10px;
	}
	
	.form textarea {
		resize: none;
	}
	
	.monthListBox-item {
		padding-left: 16px;
	}
	
	.options-scroll-panel>div {
		height: 99%;
	}
	
	</ui:Style>

	<ui:import field="com.google.gwt.user.client.ui.FormPanel.*" />
	<ui:import field="com.esferalia.aon.gwt.payroll.shared.CretaService.*" />
	<ui:import field="com.esferalia.aon.gwt.payroll.shared.CretaService.File.*" />
	<ui:import field="com.esferalia.aon.gwt.payroll.shared.CretaService.Parameter.*" />

	<g:FormPanel ui:field="formPanel" method="{METHOD_POST}" action="{CRETA_URL}"  encoding="{ENCODING_MULTIPART}">
	<g:HTMLPanel styleName="aon-width-all aon-height-all">
			<table class="aon-width-all {style.form} ">
				<tr>
					<td class="{style.label}">
						<g:Label text="Aceptar Bases Anteriores" />
					</td>
					<td class="{style.field}" >
						<g:CheckBox  name="{ACEPTAR_BASES_ANTERIORES.name}" ui:field="basesCheck" checked="false"/>
					</td>
				</tr>
				<tr>
					<td class="{style.label}">
						<g:Label text="SDL-Fichero Trabajadores y Tramos" />
					</td>
					<td class="{style.field}">
						<g:HorizontalPanel verticalAlignment="ALIGN_MIDDLE">
							<g:Button ui:field="fileButton" enabled="true" >Seleccionar</g:Button>
							<g:InlineLabel styleName="{style.nowrap}" >&nbsp;&nbsp;</g:InlineLabel> 
							<g:InlineLabel styleName="{style.nowrap}"  ui:field="fileLabel" text="Trabajadores y Tramos" />
						</g:HorizontalPanel>
					</td>
				</tr>
				<tr style="display:none" >
					<td class="{style.label}" colspan="2" >
						<g:Label text="Selecciona los Trabajadores : " ui:field="selectLabel" />
					</td>
				</tr>
				<tr  style="display:none" >
					<td class="{style.field} aon-width-all" colspan="2">
						<cell:DataGrid ui:field="selectDataGrid" />
					</td>
				</tr>
				<tr>
					<td class="{style.field}" colspan="2">&nbsp;</td>
				</tr>
			</table>
	
			<div class="{style.buttons} {style.form} ">
				<g:Button ui:field="cancelButton">Cancelar</g:Button>
				<g:Button ui:field="acceptButton" enabled="false" >Aceptar</g:Button>
			</div>
	
			<g:FileUpload visible="false"  name="{TRABAJADORES_TRAMOS.name}" ui:field="fileUpload" />
	
	</g:HTMLPanel>
	</g:FormPanel>


</ui:UiBinder>