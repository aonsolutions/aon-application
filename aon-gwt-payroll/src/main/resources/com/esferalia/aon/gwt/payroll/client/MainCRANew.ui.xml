<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
	xmlns:g='urn:import:com.google.gwt.user.client.ui'
	xmlns:a='urn:import:com.esferalia.aon.gwt.common.client.widget'
	xmlns:c='urn:import:com.google.gwt.user.cellview.client'>

	<ui:with field='res'
		type='com.esferalia.aon.gwt.common.client.css.AonResources' />

	<ui:style type="com.esferalia.aon.gwt.payroll.client.MainCRANew.MyStyle">
		/*UI Style*/
		
		.panelGridSearch{
			margin-top: 40px !important;
		}
		
		.suggestBox{
			width: 100%;
			margin: 3px;
			margin-left: 11px;
		}
		
		/*XML Style*/
	    
	    .tableStylePanel{
			height: 100%;
		    width: 100%;
		}
		
		.widthAll{
			width: 100%
		}
		
		
		.ml8{
			margin-left: 8px;
		}
		
		.pt4{
			padding-top: 4px;
		}
		
		.ml9{
			margin-left: 9px;
		}
		
		.mt15{
			margin-top: 15px;
		}
		
		.p5{
			padding: 5px;
		}
		
		.mr10{
			margin-right: 10px;	
		}
		
		.ml20{
			margin-left: 20px;	
		}
		
		.ml4{
			margin-left: 4px;	
		}
		
		.w300{
			width: 300px;
		}
		
		.mb0{
			margin-top: 15px !important;
			margin-bottom: 0 !important;
		}
		
		.mt10{
			margin-top: 15px;
		}
		
		.pt2{
			padding-top: 2px;
		}
		
		.mr16{
			margin-right: 16px;
		}
		
		.p10{
			padding: 10px;
		}
		
		.subTitleSearch{
			padding-top: 4px;
			width: 80px;
			text-align: left;
			margin-left: 20px;
		}
	</ui:style>

	<g:DockLayoutPanel ui:field="dockLayoutPanel" unit="PX">
		<g:center>
			<g:DeckPanel ui:field="deckPanel">
				<g:HTMLPanel ui:field="mainContainer" styleName="{style.widthAll}">
					<g:ScrollPanel height="100%" styleName="{style.p5}">
						<g:VerticalPanel styleName="{style.tableStylePanel} {style.p10}">
						
							<g:HTMLPanel styleName="aon-panelGrid-search {style.panelGridSearch}">
								<g:HTMLPanel styleName="aon-panelGrid-search-info">
									<g:Label styleName="aon-panelGrid-search-info-internal">LIQUIDACIÓN</g:Label>
								</g:HTMLPanel>
								<g:HorizontalPanel styleName="{style.ml20}">
									<g:Label styleName="aon-outputLabel {style.pt4} {style.mr16}">Periodo</g:Label>
									<g:ListBox ui:field="month" styleName="{style.mr10}"></g:ListBox>
									<g:ListBox ui:field="year" styleName="{style.mr10}"></g:ListBox>
									<g:CheckBox ui:field="allCCCsCB"></g:CheckBox>
									<g:Label styleName="{style.pt2}">Todos</g:Label>
									<g:CheckBox ui:field="emitCCCsCB"></g:CheckBox>
									<g:Label styleName="{style.pt2}">Emitidos</g:Label>
									<g:CheckBox ui:field="peddingCCCsCB"></g:CheckBox>
									<g:Label styleName="{style.pt2}">Pendientes</g:Label>
								</g:HorizontalPanel>
								<g:HorizontalPanel ui:field="enterprisePanel" styleName="{style.ml20} {style.mt10}">
									<g:Label styleName="aon-outputLabel {style.pt4}">Empresa</g:Label>
									<g:SuggestBox styleName="aon-selectOneMenu {style.ml9} {style.w300}" ui:field="enterpriseSB"></g:SuggestBox>
									<g:Label styleName="aon-outputLabel {style.pt4} {style.ml4}">Selcs.: </g:Label>
									<g:Label ui:field="enterprisesSelected" styleName="aon-outputLabel {style.pt4} {style.ml4}"></g:Label>
								</g:HorizontalPanel>
							</g:HTMLPanel>
						
						 	<g:HTMLPanel ui:field="mainTablePanel" styleName="{style.mt10}">
						 		<c:DataGrid ui:field="cccDataGrid"></c:DataGrid>
						 	</g:HTMLPanel>
					 		
						</g:VerticalPanel>
					</g:ScrollPanel>
				</g:HTMLPanel>
				
				<g:HTMLPanel ui:field="crasContainer" styleName="{style.widthAll}">
					<g:ScrollPanel height="100%" styleName="{style.p5}">
						<g:VerticalPanel styleName="{style.tableStylePanel} {style.p10}">
							<g:HTMLPanel styleName="aon-panelGrid-search  {style.panelGridSearch}">
								<g:HTMLPanel styleName="aon-panelGrid-search-info">
									<g:Label styleName="aon-panelGrid-search-info-internal">FILTRAR LISTADO</g:Label>
								</g:HTMLPanel>
								<g:DisclosurePanel ui:field="collapsePanel" styleName="{style.widthAll}">
									<g:header>OPCIONES DE BUSQUEDA</g:header>
									<g:HTMLPanel>
										<table ui:field="filterTable" class="aon-panelGrid">
											<tr>
												<td class="aon-panelGrid-odd">
													<g:Label styleName="aon-outputLabel  {style.subTitleSearch}">Tipo CCC</g:Label>
												</td>
												<td class="aon-panelGrid-even" colspan="2">
													<g:ListBox styleName="aon-selectOneMenu {style.ml9}" ui:field="typeList"></g:ListBox>
												</td>
											</tr>
											<tr>
												<td class="aon-panelGrid-odd">
													<g:Label styleName="aon-outputLabel  {style.subTitleSearch}">Provincia</g:Label>
												</td>
												<td class="aon-panelGrid-even" colspan="2">
													<g:ListBox styleName="aon-selectOneMenu {style.ml9}" ui:field="geozoneList"></g:ListBox>
												</td>
											</tr>
											<tr>
												<td class="aon-panelGrid-odd">
													<g:Label styleName="aon-outputLabel {style.subTitleSearch}">P. Liquidación</g:Label>
												</td>
												<td class="aon-panelGrid-even" colspan="2">
													<table>
														<tr>
															<td>
																<g:ListBox styleName="aon-selectOneMenu {style.ml8}" ui:field="monthTillT"></g:ListBox>
															</td>
															<td>
																<g:ListBox styleName="aon-selectOneMenu" ui:field="yearTillT"></g:ListBox>
															</td>
														</tr>
													</table>
												</td>
											</tr>
										</table>
									</g:HTMLPanel>
								</g:DisclosurePanel>
							</g:HTMLPanel>
							
							<g:HTMLPanel styleName="aon-panelGrid-search-info {style.mb0}">
								<g:Label styleName="aon-panelGrid-search-info-internal">HISTORIAL CRA</g:Label>
							</g:HTMLPanel>
							<g:HTMLPanel ui:field="crasPanel" styleName="{style.mt15}">
						 		<c:DataGrid ui:field="crasDataGrid"></c:DataGrid>
						 	</g:HTMLPanel>
						</g:VerticalPanel>
					</g:ScrollPanel>
				</g:HTMLPanel>
			</g:DeckPanel>
		</g:center>
	</g:DockLayoutPanel>
</ui:UiBinder> 

