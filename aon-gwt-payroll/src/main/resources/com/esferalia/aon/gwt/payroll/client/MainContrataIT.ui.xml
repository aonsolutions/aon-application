
<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
	xmlns:g='urn:import:com.google.gwt.user.client.ui'
	xmlns:a='urn:import:com.esferalia.aon.gwt.common.client.widget'
	xmlns:c='urn:import:com.google.gwt.user.cellview.client'
	xmlns:d='urn:import:com.esferalia.aon.gwt.payroll.client'>

	<ui:with field='res'
		type='com.esferalia.aon.gwt.common.client.css.AonResources' />

	<ui:style type="com.esferalia.aon.gwt.payroll.client.MainContrataIT.MyStyle">
		/*UI Style*/
		
		.panelGridSearch{
			margin-top: 0px !important;
		}
		
		.suggestBox{
			width: 100%;
			margin: 3px;
			margin-left: 11px;
		}
		
		/*XML Style*/
	    
	    .tableStylePanel{
			/*margin: auto;*/
			height: 100%;
		    width: 100%;
		}
		
		.widthAll{
			width: 100%
		}
		
		.pl20{
			padding-left: 20px;
		}
		
		.ml12{
			margin-left: 12px;
		}

		.ml8{
			margin-left: 8px;
		}
		
		.hide{
			display: none;
		}
		
		/*New Styles*/
		.pt9{
			padding-top: 9px;
		}
		
		.pt4{
			padding-top: 4px;
		}
		
		.ml9{
			margin-left: 9px;
		}
		
		.mt10{
			margin-top: 5px;
		}
		
		.p5{
			padding: 5px;
		}
		
		.styleBorder{
			border-style: solid;
			border-width: 1px; 
			margin: 15px 2px 15px 0px;
			width: 99%;
		}
		
		.headerStyle{
			top: -0.5em;
			font-size: 12px;
			margin-left: 10px;
		}
		
		.paddingTable{
			padding: 0px 0px 0px 10px;
		}
		
		.mr10{
			margin-right: 10px;	
		}
		
		.ml20{
			margin-left: 20px;	
		}
		
		.ml4{
			margin-left: 4px;	
		}
		
		.w600{
			width: 600px;
		}
		
		.mb0{
			margin-top: 5px !important;
			margin-bottom: 0 !important;
		}
		
		.mt10{
			margin-top: 10px;
		}
		
		.pt2{
			padding-top: 2px;
		}
		
		.mr16{
			margin-right: 16px;
		}
		
		.sb{
			background-color: white; /* #f6f5e3; */
			border: 1px solid #868686;
			padding: 3px;
			cursor: pointer;
		}
		
		.pointer{
			cursor: pointer;
		}
		
		.ml5{
			margin-left: 5px;
		}
		
		.filterPanel{
			display: flex;
			justify-content: space-between;
			margin: auto 15px;
		}
		
		.flexPanel{
			display: flex;
		}
		
		.bold{
			font-weight: bold;
		}
		
		.contractaEmployeeScPanel{
			margin: 0 0 10px;
		}
		
	</ui:style>

	<g:DockLayoutPanel unit="PX">
		<!-- INIT HEADER MENU -->
		<g:north size="25">
			<g:FlowPanel styleName="aon-finding-title-toolbar">
				<g:HorizontalPanel >
					<g:HTMLPanel styleName="aon-finding-title">
						<g:HTMLPanel styleName="aon-finding-title-internal" >
							<g:Label styleName="aon-outputText">Contrat@ - Partes IT</g:Label>
						</g:HTMLPanel>
					</g:HTMLPanel>
					<g:HTMLPanel styleName="aon-finding-subtitle">
						<g:HTMLPanel styleName="aon-finding-aubtitle-internal" >
							<g:Label styleName="aon-outputText" text=" "/> 
						</g:HTMLPanel>
					</g:HTMLPanel>
					<g:HorizontalPanel styleName="aon-finding-toolbar">
						<g:HTMLPanel styleName="aon-finding-toolbar-item-group" >
							<g:Button ui:field='backContractButton' styleName='aon-finding-toolbar-item aon-icon-cancel {style.pl20}' text=" VOLVER"/>
							<g:Button debugId='listITsButton' ui:field='listITsButton' styleName='aon-finding-toolbar-item aon-icon-cancel {style.pl20}' text=" LISTA ITs" />
						</g:HTMLPanel>
					</g:HorizontalPanel>
				</g:HorizontalPanel>
			</g:FlowPanel>
		</g:north>
		<!-- END HEADER MENU -->
		<g:center>
			<g:DeckPanel ui:field="deckPanel">
				<g:HTMLPanel ui:field="mainContainer" styleName="{style.widthAll}">
					<g:ScrollPanel height="100%" styleName="{style.p5}">
						<g:VerticalPanel styleName="{style.tableStylePanel}">
						
							<g:HTMLPanel styleName="aon-panelGrid-search {style.panelGridSearch}">
								<g:HTMLPanel styleName="aon-panelGrid-search-info">
									<g:Label styleName="aon-panelGrid-search-info-internal">LISTADO DE CONTRATOS</g:Label>
								</g:HTMLPanel>
								<g:HTMLPanel ui:field="employeePanel" styleName="{style.ml20} {style.mt10} {style.filterPanel}">
									<g:HTMLPanel styleName="{style.flexPanel}">
										<g:Label styleName="aon-outputLabel {style.pt4} {style.bold}">Persona</g:Label>
										<g:SuggestBox styleName="aon-selectOneMenu {style.ml9} {style.w600} {style.sb}" ui:field="employeeSB"></g:SuggestBox>
									</g:HTMLPanel>
									<g:HTMLPanel styleName="{style.flexPanel}">
										<g:Label styleName="{style.pt4} {style.bold}">Mostrar Empleados :</g:Label>
										<g:CheckBox ui:field="inactiveContractsCB" styleName="{style.ml5} {style.pt2}"></g:CheckBox>
										<g:Label styleName="{style.pt4}">Inactivos</g:Label>
									</g:HTMLPanel>
								</g:HTMLPanel>
							</g:HTMLPanel>
						
						 	<g:HTMLPanel ui:field="mainTablePanel" styleName="{style.mt10}">
						 		<c:DataGrid ui:field="employeeDataGrid" styleName="{style.pointer}"></c:DataGrid>
						 	</g:HTMLPanel>
					 		
						</g:VerticalPanel>
					</g:ScrollPanel>
				</g:HTMLPanel>
				<g:HTMLPanel ui:field="mainITContainer" styleName="{style.widthAll}">
					<g:ScrollPanel height="100%" styleName="{style.p5}">
						<g:VerticalPanel styleName="{style.tableStylePanel}">
						
							<g:HTMLPanel styleName="aon-panelGrid-search {style.panelGridSearch}">
								<g:HTMLPanel styleName="aon-panelGrid-search-info">
									<g:Label styleName="aon-panelGrid-search-info-internal">LISTADO DE ITs</g:Label>
								</g:HTMLPanel>
								<g:HTMLPanel ui:field="employeeITPanel" styleName="{style.ml20} {style.mt10} {style.filterPanel}">
									<g:HTMLPanel styleName="{style.flexPanel}">
										<g:Label styleName="aon-outputLabel {style.pt4} {style.bold}">IT</g:Label>
										<g:SuggestBox styleName="aon-selectOneMenu {style.ml9} {style.w600} {style.sb}" ui:field="itSB"></g:SuggestBox>
									</g:HTMLPanel>
									<g:HTMLPanel styleName="{style.flexPanel}">
										<g:Label styleName="{style.pt4} {style.bold}">Mostrar Its :</g:Label>
										<g:CheckBox ui:field="inactiveITsCB" styleName="{style.ml5} {style.pt2}"></g:CheckBox>
										<g:Label styleName="{style.pt4}">En vigor</g:Label>
									</g:HTMLPanel>
								</g:HTMLPanel>
							</g:HTMLPanel>
						
						 	<g:HTMLPanel ui:field="mainITTablePanel" styleName="{style.mt10}">
						 		<c:DataGrid ui:field="itDataGrid" styleName="{style.pointer}"></c:DataGrid>
						 	</g:HTMLPanel>
					 		
						</g:VerticalPanel>
					</g:ScrollPanel>
				</g:HTMLPanel>
			</g:DeckPanel>
		</g:center>
	</g:DockLayoutPanel>
</ui:UiBinder> 

