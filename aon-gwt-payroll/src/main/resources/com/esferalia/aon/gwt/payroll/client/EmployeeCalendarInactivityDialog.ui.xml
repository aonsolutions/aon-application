<ui:UiBinder
    xmlns:ui='urn:ui:com.google.gwt.uibinder'
	xmlns:g='urn:import:com.google.gwt.user.client.ui'
	xmlns:a='urn:import:com.esferalia.aon.gwt.common.client.widget'>

	<ui:with field='msgs' type='com.esferalia.aon.gwt.payroll.client.i18n.PayrollMessages'/>

    <ui:style>

		.form {
			padding: 10px;
		}

		.datesPanel{
			display: flex;
			flex-direction: column;
			padding: 5px;
			border: 1px solid #e1e1e1;
			margin-bottom: 10px;
		}

		.rowPanel{
			display: flex;
			justify-content: space-between;
			margin: 3px 0;
		}

		.buttonsPanel{
			display: flex;
			justify-content: flex-end;
			gap: .5rem;
		}

		.labelStyle{
			width: 130px;
			display: flex;
			align-items: center;
		}

		.dateBox{
			width: 200px !important;
			text-align: center;
			border: solid #808080 1px;
		}

		.w200{
			width: 200px;
		}

		.errorPanel{
			font-weight: bold;
			color: red;
			padding: 0 5px;
		}

		.percentLabel{
			display: flex;
			align-items: center;
			margin-right: 5px;
		}

		.percentTBx{
			width: 80px;
		}

		.percent{
			text-align: center;
			font-weight: bold;
			display: flex;
			align-items: center;
			margin-left: 5px;
		}

	</ui:style>

	<g:HTMLPanel styleName="{style.form}">

		<g:HTMLPanel styleName="aon-width-all aon-height-all">

			<g:HTMLPanel styleName="{style.datesPanel}">

				<g:HTMLPanel styleName="{style.rowPanel}">
					<g:Label text="{msgs.startDateColon}"/>
					<a:DateBoxEx ui:field="startDateDB" styleName="{style.dateBox}"></a:DateBoxEx>
				</g:HTMLPanel>

				<g:HTMLPanel styleName="{style.rowPanel}">
					<g:Label text="{msgs.endDateColon}"/>
					<a:DateBoxEx ui:field="endDateDB" styleName="{style.dateBox}"></a:DateBoxEx>
				</g:HTMLPanel>

			</g:HTMLPanel>

			<g:HTMLPanel styleName="{style.datesPanel}">
				<g:HTMLPanel styleName="{style.rowPanel}">
					<g:Label styleName="{style.labelStyle}" text="{msgs.inactivityCause}"/>
					<g:ListBox ui:field="typeInactivity" styleName="{style.w200}"></g:ListBox>
				</g:HTMLPanel>

				<g:HTMLPanel ui:field="percentPanel" styleName="{style.rowPanel}">
					<g:Label styleName="{style.percentLabel}" text="{msgs.percentReduction}"/>
					<g:TextBox ui:field="percentBox" styleName="{style.percentTBx}"></g:TextBox>
					<g:Label styleName="{style.percent}" >%</g:Label>
				</g:HTMLPanel>

				<g:HTMLPanel ui:field="endERTEPanel" styleName="{style.rowPanel}">
					<g:CheckBox ui:field="endERTECB" text="{msgs.erteEnd}"/>
				</g:HTMLPanel>
			</g:HTMLPanel>

			<g:HTMLPanel  ui:field="errorMessage" styleName="{style.errorPanel}">
				<g:Label text="{msgs.errorFormatMsg}"/>
				<g:Label text="{msgs.decimalsInfo}"/>
			</g:HTMLPanel>

			<g:HTMLPanel styleName="{style.buttonsPanel}">
				<g:Button ui:field="cancelButton" text="{msgs.cancel}"/>
			    <g:Button ui:field="acceptButton" text="{msgs.ok}"/>
			</g:HTMLPanel>

		</g:HTMLPanel>

	</g:HTMLPanel>

</ui:UiBinder>
