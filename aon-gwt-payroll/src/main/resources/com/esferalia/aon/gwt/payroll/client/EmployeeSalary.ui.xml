<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
	xmlns:g='urn:import:com.google.gwt.user.client.ui'
	xmlns:a='urn:import:com.esferalia.aon.gwt.common.client.widget'
	xmlns:c='urn:import:com.google.gwt.user.cellview.client'>

	<ui:with field='res'
		type='com.esferalia.aon.gwt.common.client.css.AonResources' />

	<ui:style type="com.esferalia.aon.gwt.payroll.client.EmployeeSalary.MyStyle">
		.tree {
      		width: 500px;
	      	border: 1px solid #ccc;
	    }
	    
	    .selectedLabel {
	      	padding-left: 15px;
	    }
	    
	    .tableStyle{
			margin: auto;
			padding-top: 1em;
		}
		
		.mAuto{
			margin: auto;
		}
		
		.widthAll{
			width: 100%
		}
		
		.rightAlign{
    		text-align: right;
		}
		
		.title{
			width: 100%;
			background-color: #e8e4e4;
			padding: 5px;
			margin-bottom: 5px;
			padding-right: 0px;
		}
		
		.filterLabel{
			color: #4b4b4b;
			font: 12px/ 1.333 "arial", "lucida Grande", "Trebuchet MS", sans-serif;
		}
		
		.filterBorder{
			border: 1px solid #e8e4e4;
		}
		
		.m3 {
			margin: 3px;
		}
		
		.tillTo{
			margin-left: 43px !important;
		}
		
		.monthYear{
			margin-left: 67px !important;
		}
		
		.filterButton{
			border: 2px solid #e8e4e4;
			background: none;
			background-color: #e8e4e4 !important;
			border-radius: 6%;
			font-weight: bold;
			padding-top: 2px;
			padding-bottom: 2px;
		}
		
		.hide{
			display: none;
		}
	</ui:style>

	<g:DockLayoutPanel unit="PX">
		<!-- INIT HEADER MENU -->
		<g:north size="25">
			<g:FlowPanel styleName="aon-finding-title-toolbar">
				<g:HorizontalPanel >
					<g:HTMLPanel styleName="aon-finding-title">
						<g:HTMLPanel styleName="aon-finding-title-internal" >
							<g:Label styleName="aon-outputText">Nóminas</g:Label>
						</g:HTMLPanel>
					</g:HTMLPanel>
					<g:HTMLPanel styleName="aon-finding-subtitle">
						<g:HTMLPanel styleName="aon-finding-aubtitle-internal" >
							<g:Label styleName="aon-outputText" text=" "/> 
						</g:HTMLPanel>
					</g:HTMLPanel>
					<g:HorizontalPanel styleName="aon-finding-toolbar">
						<g:HTMLPanel styleName="aon-finding-toolbar-item-group" >
							<g:Button ui:field='deleteButton' styleName='aon-finding-toolbar-item aon-icon-delete' text="BORRAR"/>
							<!--  g:Button ui:field='printButton' styleName='aon-finding-toolbar-item aon-icon-pdf' text="IMPRIMIR" /-->
							<g:Button debugId='saveButton' ui:field='saveButton' styleName='aon-finding-toolbar-item aon-icon-pdf' text="PDF" />
							<g:Button ui:field='publishButton' styleName='aon-finding-toolbar-item aon-icon-google-drive' text="PUBLICAR" />
						</g:HTMLPanel>
					</g:HorizontalPanel>
				</g:HorizontalPanel>
			</g:FlowPanel>
		</g:north>
		<!-- END HEADER MENU -->
		<g:center>
			<g:HTMLPanel ui:field="mainContainer" styleName="{style.widthAll}">
				<g:ScrollPanel height="100%">
					<g:VerticalPanel styleName="{style.tableStyle}">
						<g:Label ui:field="employeeNameLabel" styleName="{style.title}"></g:Label>
						<g:DisclosurePanel ui:field="collapsePanel">
						   <g:header>FILTRAR BUSQUEDA</g:header>
						   <g:HTMLPanel>
							   	<table>
							   		<tbody>
				  						<tr>
				    						<td>
					      						<div>Periodo</div>
					    					</td>
					    					<td>
					      						<g:VerticalPanel>
					      							<g:HorizontalPanel>
					      								<g:RadioButton name="dateFilter" ui:field="noDateRB">Cualquier fecha</g:RadioButton>
					      							</g:HorizontalPanel>
					      							<g:HorizontalPanel>
					      								<g:RadioButton name="dateFilter" ui:field="dateMYRB">Mes/Año</g:RadioButton>
					      								<g:ListBox styleName="{style.m3} {style.monthYear}" ui:field="monthMY"></g:ListBox>
					      								<g:ListBox styleName="{style.m3}" ui:field="yearMY"></g:ListBox>
					      							</g:HorizontalPanel>
					      							<g:HorizontalPanel>
					      								<g:RadioButton name="dateFilter" ui:field="dateTTRB">Desde/Hasta</g:RadioButton>
					      								<g:VerticalPanel>
					      									<g:HorizontalPanel>
					      										<g:ListBox styleName="{style.m3} {style.tillTo}" ui:field="monthTillT"></g:ListBox>
					      										<g:ListBox styleName="{style.m3}" ui:field="yearTillT"></g:ListBox>
					      									</g:HorizontalPanel>
					      									<g:HorizontalPanel>
					      										<g:ListBox styleName="{style.m3} {style.tillTo}" ui:field="monthTTo"></g:ListBox>
					      										<g:ListBox styleName="{style.m3}" ui:field="yearTTo"></g:ListBox>
					      									</g:HorizontalPanel>
					      								</g:VerticalPanel>
					      							</g:HorizontalPanel>
					      						</g:VerticalPanel>
					    					</td>
				  						</tr>
				  						<tr>
				  							<td colspan="2" align="right">
				  								<g:Button ui:field="filterButton" styleName="{style.filterButton}">Filtrar</g:Button>
				  							</td>
				  						</tr>
			  						</tbody>
							   </table>
						   </g:HTMLPanel>
					 	</g:DisclosurePanel>
					 	<g:HTMLPanel ui:field="mainTablePanel"></g:HTMLPanel>
					</g:VerticalPanel> 
				</g:ScrollPanel>
			</g:HTMLPanel>
		</g:center>
	</g:DockLayoutPanel>
</ui:UiBinder> 

