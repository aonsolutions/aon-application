<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
	xmlns:g='urn:import:com.google.gwt.user.client.ui'
	xmlns:c='urn:import:com.google.gwt.user.cellview.client'
	xmlns:p="urn:import:net.aonsolutions.gwt.pdfjs.client"	
	xmlns:w='urn:import:com.esferalia.aon.gwt.common.client.widget'
	xmlns:aon='urn:import:com.esferalia.aon.gwt.common.client.widget.solutions'>

	<ui:with field='msgs' type='com.esferalia.aon.gwt.payroll.client.i18n.PayrollMessages'/>
	<ui:with field='res' type='com.esferalia.aon.gwt.common.client.css.AonResources'/>

	<ui:style type="com.esferalia.aon.gwt.payroll.client.AgreementLevelTab.MyStyle">
		
		.flexColumn{
			display: flex;
			flex-direction: column;
			gap: 1rem;
		}
		
		.flexCenter {
			display: flex;
			justify-content: center;
		}
		
		.borderCollapse {
			border-collapse: collapse;
		}
		
		.hideScroll{}
		
		.hideScroll::-webkit-scrollbar {
			width: 1px;
			height: 4px;
			background-color: gray;
		}
		
		/* To hide the vertical scroll. */
		.hideScroll::-webkit-scrollbar:vertical {
			display: none;
		}
		
		.hideScroll::-webkit-scrollbar-thumb:horizontal {
			background: black;
		}
		
		.message {
			font-weight: bold;
			margin-top: 2rem;
		}
		
		.heigthAll {
			height: 100%;
		}
		
		.scrollPanel {
			margin: 0 1rem;
		}
		
		/* Class of AgreementLevelTab.Style */
		
		.dialogGlass {
			z-index: 7;
			background-color: #000;
			opacity: 0.2;
			filter: opacity(45%);
		}
		
		.dialogZIndex {
			z-index: 8;
		}
		
		.gridCell{
			text-transform: uppercase;
			text-align: center;
			min-width: 120px;
		}
		
		.gridTitle{
			text-transform: uppercase;
			font-weight: bold;
		}
		
		.headerColor {
			background-color: #eee;
		}
		
		.headerFSize{
			font-size: .8em;
			text-align: left;
			padding-left: 0.5rem;
		}
		
		.headerFixed {
			position: sticky;
  			top: 0;
  			height: 1.5rem;
			font-size: .7rem;
			background-color: #eee;
			
			z-index: 5;
		}
		
		.levelCell {
			text-align: left;
			padding-left: 0.5rem !important;
		}
		
		.modify {
			background-color: lightyellow !important;
    		border: 0.5px solid yellow !important;
		}
		
		.textBox {
			border-style: none;
			width: 95%;
			font-size: 0.8em !important;
			cursor: pointer;
		}
		
		.oddRow {
			background-color: #f8f7f7;
		}
		
		.overflowEllipsis {
			white-space: nowrap;
  			overflow: hidden;
  			text-overflow: ellipsis;
  			width: 300px;
		}
		
	</ui:style>
	
	<g:HTMLPanel styleName="{style.flexColumn} {style.heigthAll}">
		<g:HTMLPanel ui:field="messagePanel" />
		<aon:AonToolbar ui:field="toolbar" />
		<g:ScrollPanel ui:field="levelScrollPanel" styleName="{style.scrollPanel} {style.hideScroll}">
			<g:Grid ui:field="levelGrid" styleName="{style.borderCollapse}" />
		</g:ScrollPanel>
		<g:HTMLPanel ui:field="agreementLevelMessage" styleName="{style.flexCenter}">
			<g:Label text="{msgs.mustCreateLevelMsg}" styleName="{style.message}" />
		</g:HTMLPanel>
	</g:HTMLPanel>
</ui:UiBinder> 

