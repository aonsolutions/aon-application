<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
	xmlns:g='urn:import:com.google.gwt.user.client.ui' 
	xmlns:a='urn:import:com.esferalia.aon.gwt.common.client.widget'
	xmlns:e='urn:import:com.esferalia.aon.gwt.payroll.client'>

	<ui:style type="com.esferalia.aon.gwt.payroll.client.EnterpriseDraft.MyStyle">
		.container {
			margin: 0 10px;
		}
		
		.flexCenter	{
			width: 100%;
			margin-top: 60px;
		}
		
		.cmd_btn{
			background-position: center left;
			background-repeat: no-repeat;
			padding-left: 25px !important;
			background-size: contain;
		}
	</ui:style>

	<g:DockLayoutPanel ui:field="dockLayoutPanel" unit="PX">
		<g:center>
			<g:HTMLPanel ui:field="centerContainer" styleName="{style.flexCenter}"></g:HTMLPanel>
		</g:center>
	</g:DockLayoutPanel>
	
</ui:UiBinder> 

