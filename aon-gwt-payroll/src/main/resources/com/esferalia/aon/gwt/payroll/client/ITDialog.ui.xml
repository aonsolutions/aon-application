<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<ui:UiBinder xmlns:ui='urn:ui:com.google.gwt.uibinder'
	xmlns:g='urn:import:com.google.gwt.user.client.ui'
	xmlns:a='urn:import:com.esferalia.aon.gwt.payroll.client'
	xmlns:c='urn:import:com.esferalia.aon.gwt.common.client.widget'
	xmlns:d='urn:import:com.google.gwt.user.cellview.client' >

	<ui:Style type="com.esferalia.aon.gwt.payroll.client.ITDialog.MyStyle">
		
		.noselect {
			-webkit-touch-callout: none; /* iOS Safari */
			-webkit-user-select: none; /* Safari */
			-khtml-user-select: none; /* Konqueror HTML */
			-moz-user-select: none; /* Firefox */
			-ms-user-select: none; /* Internet Explorer/Edge */
			user-select: none; /* Non-prefixed version, currently
				                                  supported by Chrome and Opera */
		}
		
		.fontSaveStyle{
			font-weight: bold;
    		color: #000;
    		white-space: nowrap;
    		font-size: smaller;
    		padding-left: 30px;
    		width: 80px;	
		}
		
		.styleBorder{
			border-style: solid; 
			width: 735px; 
			border-width: 1px; 
			margin-top: 20px; 
			margin-left: 10px;
		}
		
		.tittle{
			top: -0.5em;
			font-size: 12px;
			margin-left: 10px;
		}
		
		.firstColumnTextStyle{
			padding:5px !important;
		}
		
		.requiredColor{
			color: #2152A5;
			font-weight: bold !important;
		}
		
		.maxWidth{
			width: 100%;
		}
		
		.textBoxWidth{
			width: 99.5%;
		}
		
		.scrollStyle {
			margin-left: 10px;
			width: 710px;
			margin-bottom: 10px;
		}
		
		.gridStyle{
			margin-left: 10px;
			width: 710px;
		}
		
		.columnWidth{
			width: 180px;
		}
		
		.headerStyle{
			font-weight: bold;
			padding-left: 5px;
		}
		
		.elementWidth80{
			width: 80%;
		}
		
		.elementWidth95{
			width: 95%;
		}
		
		.footerStyle{
			background-color: #eaeaea;
			padding-top: 5px;
		}
		
		.footerElement{
			margin-left: 10px;
			width: 700px;
			border: none;
		}
		
		.hide{
			display: none;
		}
		
		.widthO{
			width: 0px;
		}
		
		.paddingTop{
			padding-top: 2px;
		}
		
		.dateBoxStyle{
			width: 200px !important;
			text-align: center !important;
		}
		
		.warningColor{
			font-weight: bold;
			color: #be0000;
		}
		
		.w340{
			width: 340px !important;
		}
		
		.w240{
			width: 240px !important;
		}
		
		.w100{
			width: 100px !important;
		}
		
		.w105{
			width: 105px !important;
		}
		
		.textCenter{
			text-align: center;
		}
		
		.pointer{
			cursor: pointer;
		}
		
		.pl20{
			padding-left: 20px;
		}
		
		.mt10{
			margin-top: 10px;
		}
	
		.paddingContainer{
			padding: 0 10px;
		}
		
		.w140{
			width: 140px;
		}
		
		.w222{
			width: 222px;
		}	
		
	</ui:Style>


	<g:HTMLPanel styleName="aon-width-all aon-height-all" debugId="paymetDialogHTMLPanel"> 
		<g:DeckPanel ui:field="deckPanel">
			<g:VerticalPanel>
				<g:FlowPanel styleName="aon-finding-title-toolbar">
					<g:HorizontalPanel>
						<g:HTMLPanel styleName="aon-finding-title">
							<g:HTMLPanel styleName="aon-finding-title-internal" >
								<g:Label styleName="aon-outputText">Contrat@ - Bajas IT</g:Label>
							</g:HTMLPanel>
						</g:HTMLPanel>
						<g:HTMLPanel styleName="aon-finding-subtitle">
							<g:HTMLPanel styleName="aon-finding-aubtitle-internal" >
								<g:Label styleName="aon-outputText" text=" "/> 
							</g:HTMLPanel>
						</g:HTMLPanel>
						<g:HorizontalPanel styleName="aon-finding-toolbar">
							<g:HTMLPanel styleName="aon-finding-toolbar-item-group" >
								<g:Button ui:field='deleteITButton' styleName='aon-finding-toolbar-item aon-icon-delete {style.pl20}' text=" BORRAR"/>
								<g:Button debugId='listButton' ui:field='listButton' styleName='aon-finding-toolbar-item aon-icon-cancel {style.pl20}' text=" LISTA" />
							</g:HTMLPanel>
						</g:HorizontalPanel>
					</g:HorizontalPanel>
				</g:FlowPanel>
				<g:HTMLPanel styleName="{style.paddingContainer}">
					<table class="aon-width-all aon-height-all" >
						<tr>
							<td>
								<g:HTMLPanel>
									<g:VerticalPanel>
									    <g:VerticalPanel ui:field="itDataTable" styleName="{style.styleBorder}">
									    	<g:Label width="105px" styleName='aon-group-title {style.tittle}'>Parte IT</g:Label>
									    	<g:HTMLPanel styleName="aon-width-all aon-height-all" debugId="paymetDialogHTMLPanel">
									    		<table style="margin-left: 10px; margin-bottom: 10px; width: 710px;">
													<tbody>
													    <tr>
													        <td></td>
													        <td></td>
													        <td></td>
													        <td></td>
													        <td></td>
													    </tr>
													    <tr>
													    	<td  style="background-color: #eaeaea; width: 100px;">
													    		<g:Label styleName='{style.requiredColor} {style.firstColumnTextStyle}'>Fecha Baja</g:Label>
													    	</td>
													    	<td>
													    		<c:DateBoxEx ui:field="itStartDate" styleName='aon-inputText {style.textCenter}'></c:DateBoxEx>
													    	</td>
													    	<td  style="">
													    		<g:Label styleName="{style.w140}" ui:field="realStartDate"></g:Label>
													    	</td>
													    	<td  style="background-color: #eaeaea; width: 120px;">
													    		<g:Label styleName='{style.requiredColor} {style.firstColumnTextStyle}'>Causa de baja</g:Label>
													    	</td>
													    	<td>
													    		<g:ListBox ui:field="causeLowPart" styleName='aon-selectOneMenu  {style.w240}'></g:ListBox>
													    	</td>
													    </tr>
													     <tr>
													    	<td  style="background-color: #eaeaea; width: 100px;">
													    		<g:Label styleName='{style.requiredColor} {style.firstColumnTextStyle}'>Fecha Alta</g:Label>
													    	</td>
													    	<td colspan="2">
													    		<c:DateBoxEx ui:field="itEndDate" styleName='aon-inputText {style.textCenter}'></c:DateBoxEx>
													    	</td>
													    	<td  style="background-color: #eaeaea; width: 120px;">
													    		<g:Label styleName='{style.requiredColor} {style.firstColumnTextStyle}'>Causa de alta</g:Label>
													    	</td>
													    	<td>
													    		<g:ListBox ui:field="causeHighPart" styleName='aon-selectOneMenu {style.w240}'></g:ListBox>
													    	</td>
													    </tr>
													</tbody>
												</table>
									    	</g:HTMLPanel>
									    </g:VerticalPanel>
									    <g:VerticalPanel ui:field="informationDataTable" styleName="{style.styleBorder}">
									    	<g:Label width="105px" styleName='aon-group-title {style.tittle}'>Información parte</g:Label>
									    	<g:HTMLPanel styleName="aon-width-all aon-height-all" debugId="paymetDialogHTMLPanel">
									    		<table style="margin-left: 10px; margin-bottom: 10px; width: 710px;">
													<tbody>
													    <tr>
													        <td></td>
													        <td></td>
													        <td></td>
													        <td></td>
													    </tr>
													    <tr>
													    	<td  style="background-color: #eaeaea; width: 100px;">
													    		<g:Label  styleName='{style.firstColumnTextStyle}'>Nº colegiado</g:Label>
													    	</td>
													    	<td style="width: 210px;">
													    		<g:TextBox ui:field="collegiateNumberITPart" styleName='aon-inputText {style.elementWidth95}'></g:TextBox>
													    	</td>
													    	<td  style="background-color: #eaeaea; width: 100px;">
													    		<g:Label  styleName='{style.firstColumnTextStyle}'>Recaída</g:Label>
													    	</td>
													    	<td>
													    		<g:ListBox ui:field="raggedList" styleName='aon-selectOneMenu  {style.w240}'></g:ListBox>
													    	</td>
													    </tr>
													    <tr>
													    	<td  style="background-color: #eaeaea; width: 120px;">
													    		<g:Label  styleName='{style.firstColumnTextStyle}'>CIAS</g:Label>
													    	</td>
													    	<td style="width: 210px;">
													    		<g:TextBox ui:field="ciasITPart" styleName='aon-inputText {style.elementWidth95}'></g:TextBox>
													    	</td>
													    	<td  style="background-color: #eaeaea; width: 120px;">
													    		<g:Label  styleName='{style.firstColumnTextStyle}'>Inicio pago directo</g:Label>
													    	</td>
													    	<td>
													    		<c:DateBoxEx ui:field="directPayDate" styleName='aon-inputText {style.textCenter}'></c:DateBoxEx>
													    	</td>
													    </tr>
													</tbody>
												</table>
									    	</g:HTMLPanel>
									    </g:VerticalPanel>
									    <g:VerticalPanel ui:field="confirmationsDataTable" styleName="{style.styleBorder}">
									    	<g:Label width="105px" styleName='aon-group-title {style.tittle}'>Partes de confirmación</g:Label>
									    	<g:HTMLPanel styleName="aon-width-all aon-height-all" debugId="paymetDialogHTMLPanel">
									    		<g:VerticalPanel>
									    			<g:Grid ui:field="confirmationPartDataTableHeader" styleName="{style.gridStyle}"></g:Grid>
									    			<g:HTMLPanel>
									    				<hr align="left" noshade="noshade" style="margin-bottom: 10px;border-width: 0.5px;margin-left: 10px;"/>
									    			</g:HTMLPanel>
										    		<g:ScrollPanel ui:field="scrollPanel" styleName="{style.scrollStyle}">
										    			<g:Grid ui:field="confirmationPartDataTable"></g:Grid>
										    		</g:ScrollPanel>
										    		<g:HTMLPanel styleName="{style.footerStyle}">
									    				<g:Label ui:field="newConfirmationPart" styleName="aon-finding-toolbar-item aon-icon-reset {style.footerElement}">NUEVO</g:Label>
									    			</g:HTMLPanel>
									    		</g:VerticalPanel>
									    	</g:HTMLPanel>
									    </g:VerticalPanel>
									</g:VerticalPanel>
								</g:HTMLPanel>
							</td>
						</tr>
						<tr>
						    
						</tr>
						<tr>
							<td colspan="2" align="right">
								<g:Button ui:field="cancelButton" debugId="activityDialogCancelButton">Cancelar</g:Button>
								<g:Button ui:field="acceptButton" debugId="activityDialogAcceptButton" >Aceptar</g:Button>
							</td>
						</tr>
					</table>
				</g:HTMLPanel>
			</g:VerticalPanel>
			<g:VerticalPanel>
				<g:FlowPanel styleName="aon-finding-title-toolbar">
					<g:HorizontalPanel>
						<g:HTMLPanel styleName="aon-finding-title">
							<g:HTMLPanel styleName="aon-finding-title-internal" >
								<g:Label styleName="aon-outputText">Contrat@ - Bajas IT</g:Label>
							</g:HTMLPanel>
						</g:HTMLPanel>
						<g:HTMLPanel styleName="aon-finding-subtitle">
							<g:HTMLPanel styleName="aon-finding-aubtitle-internal" >
								<g:Label styleName="aon-outputText" text=" "/> 
							</g:HTMLPanel>
						</g:HTMLPanel>
						<g:HorizontalPanel styleName="aon-finding-toolbar">
							<g:HTMLPanel styleName="aon-finding-toolbar-item-group" >
								<g:Button ui:field='newITButton' styleName='aon-finding-toolbar-item aon-icon-reset {style.pl20}' text=" NUEVO"/>
							</g:HTMLPanel>
							<g:HTMLPanel styleName="aon-finding-toolbar-item-group" >
								<g:Button ui:field='backButton' styleName='aon-finding-toolbar-item aon-icon-cancel {style.pl20}' text=" VOLVER"/>
							</g:HTMLPanel>
						</g:HorizontalPanel>
					</g:HorizontalPanel>
				</g:FlowPanel>
				<g:HTMLPanel ui:field="mainTablePanel" styleName="aon-width-all {style.mt10}">
			 		<d:DataGrid ui:field="itDataGrid" styleName="{style.pointer}"></d:DataGrid>
			 	</g:HTMLPanel>
			</g:VerticalPanel>
		</g:DeckPanel>
		
	</g:HTMLPanel>

</ui:UiBinder>