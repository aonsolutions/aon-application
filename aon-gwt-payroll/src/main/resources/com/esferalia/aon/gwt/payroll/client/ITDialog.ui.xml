<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<ui:UiBinder xmlns:ui='urn:ui:com.google.gwt.uibinder' xmlns:g='urn:import:com.google.gwt.user.client.ui' xmlns:c='urn:import:com.esferalia.aon.gwt.common.client.widget' xmlns:d='urn:import:com.google.gwt.user.cellview.client'>

	<ui:Style type="com.esferalia.aon.gwt.payroll.client.ITDialog.MyStyle">
	
		.paddingContainer{
			padding: 0 15px;
		}
		
		.styleBorder{
			border-style: solid; 
			width: 590px; 
			border-width: 1px; 
			margin-top: 20px;
		}
		
		.tittle{
			top: -0.5em;
			font-size: 12px;
			margin-left: 10px;
		}
		
		.flexColumn{
			padding: 0 1.5em 1.5em 1.5em;
			display: flex;
			flex-direction: column;
			gap: 5px;
		}
		
		.flex{
			display: flex;
			margin-bottom: 5px;
            gap: 10px;
		}
		
		.flexCustom{
			display: flex;
			align-items: center;
			gap: 1rem;
		}
		
		.requiredColor{
			color: #2152A5;
			font-weight: bold !important;
		}
		
		.columnXL{
			min-width: 100px;
		}
		
		.columnL{
			min-width: 90px;
		}
		
		.columnS{
			min-width: 70px;
		}
		
		.columnWidth{
			width: 130px;
		}
		
		.headerStyle{
			font-weight: bold;
		}
		
		.maxWidth{
			width: 100%;
		}
		
		.scrollStyle {
			margin-left: 10px;
			margin-bottom: 10px;
		}
		
		.textCenter{
			text-align: center;
		}
		
		.pointer{
			cursor: pointer;
		}
		
		.mt10{
			margin-top: 10px;
		}

		.ml18{
			margin:0 0 0 18px;
		}
	
		.buttonsPanel{
			display: flex;
			justify-content: flex-end;
			margin: 10px 0px;
		}
		
		.footerToolbar{
			margin: 10px;
			display: flex;
			align-items: center;
			justify-content: space-between;
			border-top: 1px solid #8c8c8c;
			padding-top: 10px;
		}
		
		.footerOptionsToolbar{
			display: flex;
		    align-items: center;
		}
		
		.bold {
			font-weight: bold;
		}
		
		.title {
			font-size: 13px;
		}
		
		.subTitle {
			font-style: italic;
			color: gray;
		}
	</ui:Style>

	<g:HTMLPanel styleName="aon-width-all aon-height-all" debugId="paymetDialogHTMLPanel">

		<g:VerticalPanel>
			<g:HTMLPanel ui:field="north" styleName="aon-width-all aon-height-all"></g:HTMLPanel>
			<g:DeckPanel ui:field="deckPanel">
				<g:VerticalPanel styleName="{style.paddingContainer}">
					<g:HTMLPanel ui:field="enterpriseData" styleName="{style.flex} {style.ml18}"></g:HTMLPanel>
					<g:VerticalPanel ui:field="itDataTable" styleName="{style.styleBorder}">
						<g:Label width="105px" styleName='aon-group-title {style.tittle}'>Parte IT</g:Label>
						<g:HTMLPanel ui:field="itData" styleName="{style.flexColumn}">
							<g:HTMLPanel styleName="{style.flex}">
								<g:Label styleName='{style.subTitle}'>Trabajador:</g:Label>
								<g:HTMLPanel ui:field="employeePanel"></g:HTMLPanel>
								<g:Label styleName='{style.subTitle}'>Documento:</g:Label>
								<g:HTMLPanel ui:field="employeePanelDoc"></g:HTMLPanel>
								<g:Label styleName='{style.subTitle}'>NAF:</g:Label>
								<g:HTMLPanel ui:field="employeePanelNaf"></g:HTMLPanel>
							</g:HTMLPanel>
							<g:HTMLPanel ui:field="itBaja" styleName="{style.flex}">
								<g:Label styleName='{style.requiredColor} {style.columnS}'>Fecha Baja</g:Label>
								<c:DateBoxEx ui:field="itStartDate" styleName='aon-inputText {style.textCenter}'></c:DateBoxEx>
								<g:Label styleName='{style.requiredColor} {style.columnL}'>Causa de baja</g:Label>
								<g:ListBox ui:field="causeLowPart" styleName='aon-selectOneMenu {style.maxWidth}'></g:ListBox>
							</g:HTMLPanel>
							<g:HTMLPanel ui:field="itAlta" styleName="{style.flex}">
								<g:Label styleName='{style.columnS}'>Fecha Alta</g:Label>
								<c:DateBoxEx ui:field="itEndDate" styleName='aon-inputText {style.textCenter}'></c:DateBoxEx>
								<g:Label styleName='{style.columnL}'>Causa de alta</g:Label>
								<g:ListBox ui:field="causeHighPart" styleName='aon-selectOneMenu {style.maxWidth}'></g:ListBox>
							</g:HTMLPanel>
						</g:HTMLPanel>
					</g:VerticalPanel>

					<g:VerticalPanel ui:field="informationDataTable" styleName="{style.styleBorder}">
						<g:Label width="105px" styleName='aon-group-title {style.tittle}'>Información parte</g:Label>
						<g:HTMLPanel ui:field="itInfo" styleName="{style.flexColumn}">
							<g:HTMLPanel styleName="{style.flex}">
								<g:Label styleName='{style.columnS}'>F. Inicio</g:Label>
								<g:Label ui:field="realStartDate"></g:Label>
								<g:Label styleName='{style.columnS}'>Recaída</g:Label>
								<g:ListBox ui:field="raggedList" styleName='aon-selectOneMenu {style.maxWidth}'></g:ListBox>
								<g:Label ui:field="baseRDBxNL" styleName='{style.columnXL}'>Base reguladora</g:Label>
								<c:DoubleBox ui:field="baseRDBxN" styleName='aon-inputText {style.maxWidth}'></c:DoubleBox>
							</g:HTMLPanel>
							<g:HTMLPanel styleName="{style.flex}">
								<g:Label styleName='{style.columnS}'>Nº colegiado</g:Label>
								<g:HTMLPanel styleName="{style.flex} {style.maxWidth}">
									<g:TextBox ui:field="collegiateNumberITPart" styleName='aon-inputText {style.maxWidth}'></g:TextBox>
									<g:Label ui:field="collegiateNumberError"></g:Label>
								</g:HTMLPanel>
								<g:Label styleName='{style.columnL}'>Observaciones</g:Label>
								<g:TextBox ui:field="observationTB" styleName='aon-inputText {style.maxWidth}'></g:TextBox>
							</g:HTMLPanel>
							<g:HTMLPanel styleName="{style.flex}">
								<g:Label styleName='{style.columnS}'>CIAS</g:Label>
								<g:HTMLPanel styleName="{style.flex} {style.maxWidth}">
									<g:TextBox ui:field="ciasITPart" styleName='aon-inputText {style.maxWidth}'></g:TextBox>
									<g:Label ui:field="ciasError"></g:Label>
								</g:HTMLPanel>
								<g:Label styleName='{style.columnL}'>Ini. pago directo</g:Label>
								<c:DateBoxEx ui:field="directPayDate" styleName='aon-inputText {style.textCenter}'></c:DateBoxEx>
							</g:HTMLPanel>
						</g:HTMLPanel>
					</g:VerticalPanel>

					<g:VerticalPanel ui:field="confirmationsDataTable" styleName="{style.styleBorder}">
						<g:Label width="105px" styleName='aon-group-title {style.tittle}'>Partes de confirmación</g:Label>
						<g:HTMLPanel ui:field="confirmationParts" styleName="{style.flexColumn}">
							<g:Grid ui:field="confirmationPartDataTableHeader"></g:Grid>
							<g:ScrollPanel ui:field="scrollPanel" styleName="{style.scrollStyle}">
								<g:Grid ui:field="confirmationPartDataTable"></g:Grid>
							</g:ScrollPanel>
							<g:HTMLPanel styleName="{style.footerToolbar}">
								<g:HTMLPanel styleName="{style.footerOptionsToolbar}" ui:field="footerOptionsToolbar"></g:HTMLPanel>
							</g:HTMLPanel>
						</g:HTMLPanel>
					</g:VerticalPanel>

					<g:VerticalPanel ui:field="maternityDataTable" styleName="{style.styleBorder}">
						<g:Label width="105px" styleName='aon-group-title {style.tittle}'>Maternidad</g:Label>
						<g:HTMLPanel ui:field="maternity" styleName="{style.flexColumn}">
							<g:HTMLPanel styleName="{style.flex}">
								<g:Label styleName='{style.columnXL}'>Tipo de solicitante</g:Label>
								<g:ListBox ui:field="applicantTypeList" styleName='aon-selectOneMenu {style.maxWidth}'></g:ListBox>
								<g:Label styleName='{style.columnL}'>Motivo</g:Label>
								<g:ListBox ui:field="applicantReasonList" styleName='aon-selectOneMenu {style.maxWidth}'></g:ListBox>
							</g:HTMLPanel>
							<g:HTMLPanel styleName="{style.flex}">
								<g:Label styleName='{style.columnXL}'>Base reguladora</g:Label>
								<c:DoubleBox ui:field="baseRDBx" styleName='aon-inputText {style.maxWidth}'></c:DoubleBox>
								<g:Label styleName='{style.columnL}'>C. Parcialidad</g:Label>
								<c:DoubleBox ui:field="partialityCoefDBx" styleName='aon-inputText {style.maxWidth}'></c:DoubleBox>
							</g:HTMLPanel>
						</g:HTMLPanel>
					</g:VerticalPanel>

					<g:HTMLPanel ui:field="buttonsPanel" styleName="{style.buttonsPanel}"></g:HTMLPanel>

				</g:VerticalPanel>

				<g:VerticalPanel>
					<g:HTMLPanel ui:field="mainTablePanel" styleName="aon-width-all {style.mt10}">
						<d:DataGrid ui:field="itDataGrid" styleName="{style.pointer}"></d:DataGrid>
					</g:HTMLPanel>
				</g:VerticalPanel>
				
				<g:VerticalPanel ui:field="mainCommunicate" styleName="{style.paddingContainer}" />
			</g:DeckPanel>
		</g:VerticalPanel>

	</g:HTMLPanel>

</ui:UiBinder>