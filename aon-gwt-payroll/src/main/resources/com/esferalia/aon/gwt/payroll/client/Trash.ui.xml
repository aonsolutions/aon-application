<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
	xmlns:g="urn:import:com.google.gwt.user.client.ui">
	<ui:style>
	
	.newButton {
		float: right;
	}
	
	.legend-icon {
		margin-top: 3px;
	}
		
	</ui:style>

	<g:DockLayoutPanel unit='PX'>
		<g:north size='26'>
			<g:FlowPanel styleName="gwt-MenuBar-horizontal"
				ui:field="buttonBar">
				<g:HTMLPanel styleName="{style.legend-icon}">

					<g:Button ui:field='clearTrashButton'
						styleName='aon-editDataTable-button aon-icon-cleartrash {style.newButton}'
						title="Vaciar papelera" />
						
					<g:Button ui:field='restoreSelectedButton'
						styleName='aon-editDataTable-button aon-icon-cancel {style.newButton}'
						title="Restaurar convenio" />
						
					<g:Button ui:field='deleteSelectedButton'
						styleName='aon-editDataTable-button aon-icon-cancel {style.newButton}'
						title="Eliminar definitavemente" />

				</g:HTMLPanel>
			</g:FlowPanel>
		</g:north>

		<g:center>
			<g:ScrollPanel ui:field="scrollPanel">
				<g:Tree ui:field="tree">
				</g:Tree>
			</g:ScrollPanel>
		</g:center>
	</g:DockLayoutPanel>




</ui:UiBinder> 