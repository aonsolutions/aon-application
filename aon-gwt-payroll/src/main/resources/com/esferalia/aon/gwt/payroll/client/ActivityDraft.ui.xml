<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
	xmlns:g='urn:import:com.google.gwt.user.client.ui'
	xmlns:e='urn:import:com.esferalia.aon.gwt.payroll.client'
	xmlns:p="urn:import:net.aonsolutions.gwt.pdfjs.client"
	xmlns:aon='urn:import:com.esferalia.aon.gwt.common.client.widget.solutions'>

	<ui:with field='res'
		type='com.esferalia.aon.gwt.common.client.css.AonResources' />

	<ui:style type="com.esferalia.aon.gwt.payroll.client.ActivityDraft.MyStyle">
		.container { margin: 0 10px; }
		
		.widthAll { width: 100%; }
	</ui:style>

	<g:DockLayoutPanel ui:field="dockLayoutPanel" unit="PX">
		<g:north size="50">
			<g:DeckPanel ui:field="toolbarDeckPanel">
				<aon:AonToolbar ui:field="toolbar" />
				<aon:AonToolbar ui:field="toolbarPDFViewer" />
			</g:DeckPanel>
		</g:north>
		<g:center>
			<g:HTMLPanel ui:field="centerContainer" styleName="{style.widthAll}">
				<g:DeckPanel ui:field="mainDeckPanel">
					<g:HTMLPanel ui:field="mainPanel"/>
					<g:SimpleLayoutPanel ui:field="scrolledPDFPanel">
						<p:FullViewer styleName="reset" ui:field='pdfViewer' debugId="printPreviewViewer" />
					</g:SimpleLayoutPanel> 
				</g:DeckPanel>
			</g:HTMLPanel>
		</g:center>
	</g:DockLayoutPanel>
		
</ui:UiBinder> 

