<ui:UiBinder xmlns:ui='urn:ui:com.google.gwt.uibinder'
	xmlns:g='urn:import:com.google.gwt.user.client.ui'
	xmlns:employee='urn:import:com.esferalia.aon.gwt.payroll.client'
	xmlns:aon='urn:import:com.esferalia.aon.gwt.common.client.widget'>
	<ui:with field='msgs' type='com.esferalia.aon.gwt.payroll.client.i18n.PayrollMessages'/>


	<ui:style>
	
	.stackHeader {
	  padding: .7em .5em .7em .6em;
	  
	}

	@sprite .employeesIcon {
	     gwt-image: 'employeesgroup';
	     float: left;
	   }
	
	@sprite .salariesIcon {
	     gwt-image: 'salariesgroup';
	     float: left;
	   }
	 
	</ui:style>

	<ui:image field='salariesgroup' src='salariesgroup.png' />
	<ui:image field='employeesgroup' src='employeesgroup.png' />


	<g:SplitLayoutPanel ui:field="splitLayoutPanel">
		<g:west size='275'>

			<g:StackLayoutPanel unit='EM' ui:field="explorer">

				<g:stack ui:field="employeesStack" >
					<g:header size='3'>									
						<div class='{style.stackHeader}'>
							<div class='{style.employeesIcon}' />
							<ui:text from="{msgs.employeesLabel}"/>
						</div>
					</g:header>
					<employee:Employees ui:field='employees' />
				</g:stack>
			</g:StackLayoutPanel>


		</g:west>
		<g:center>
			<aon:DetailPanel ui:field='detailPanel' />
		</g:center>
	</g:SplitLayoutPanel>

</ui:UiBinder>
