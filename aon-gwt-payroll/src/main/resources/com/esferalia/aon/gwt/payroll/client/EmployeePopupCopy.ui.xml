<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
	xmlns:g="urn:import:com.google.gwt.user.client.ui" xmlns:datepicker='urn:import:com.google.gwt.user.datepicker.client'>

	<ui:style>

		.buttons {
		padding-top: 10px;
		text-align: right;
		}


	</ui:style>

	<g:HTMLPanel>
		<g:InlineLabel ui:field="nameEmployee"></g:InlineLabel>
		<hr />
		<table>
			<tr>
				<td>
					<g:InlineLabel>Inicio de contrato:</g:InlineLabel>
				</td>
				<td>
					<datepicker:DateBox ui:field="startDate" width="6em" />
				</td>
			</tr>
			<tr>
				<td>
					<g:Label>Fin de contrato:</g:Label>
				</td>
				<td>
					<datepicker:DateBox ui:field="endDate" width="6em" />
				</td>
			</tr>
			<tr>
			    <td colspan="3">
			        <g:CheckBox ui:field="especifico" 
			            text="Añadir datos específicos de contrato" />
			    </td>
			</tr>
		</table>
		<table>
			<tr>
				<td>
					<div styleName="{style.buttons}">
						<g:Button ui:field="acceptButton">Aceptar</g:Button>
					</div>

				</td>
				<td>
					<div styleName="{style.buttons}">
						<g:Button ui:field="cancelButton">Cancelar</g:Button>
					</div>

				</td>
			</tr>
		</table>
	</g:HTMLPanel>
</ui:UiBinder> 