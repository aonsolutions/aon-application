<ui:UiBinder 
    xmlns:ui='urn:ui:com.google.gwt.uibinder'
	xmlns:g='urn:import:com.google.gwt.user.client.ui'
	xmlns:es3='urn:import:com.google.gwt.user.client.ui'
	xmlns:datepicker='urn:import:com.google.gwt.user.datepicker.client'
	xmlns:a='urn:import:com.esferalia.aon.gwt.common.client.widget'>

    <ui:with field='res'
		type='com.esferalia.aon.gwt.common.client.css.AonResources' />
    
    
	<ui:style type="com.esferalia.aon.gwt.payroll.client.EmployeeAFIDialog.MyStyle">
	
		@external .gwt-ToggleButton-down;
		@external .gwt-ToggleButton-up;
		@external .gwt-ToggleButton-down-hovering;
		@external .gwt-ToggleButton-up-hovering;

		.form {
			padding: 10px;
		}
		
		.tabSelected{
			border: 1px solid #e2e2e2;
			border-bottom: none;
		}
		
		.tabIconSelected{
			background-color: white !important;
		}
		
		.gwt-ToggleButton-down{
			border: none !important;
			color: black !important;
			font-weight: bold !important;
			padding-bottom: 3px !important;
			background: white !important;
		}

		.gwt-ToggleButton-up{
			border: none !important;
			border-bottom: none !important;
			color: #ababab !important;
			background: #e2e2e2 !important;
		}

		.gwt-ToggleButton-down-hovering{
			border: none !important;
			color: black !important;
			font-weight: bold !important;
			padding-bottom: 3px !important;
			background: white !important;
		}

		.gwt-ToggleButton-up-hovering{
			border: none !important;
			border-bottom: none !important;
			color: #ababab !important;
			background: #e2e2e2 !important;
		}

		.selectButtonSalaryToggleButton{
			border-top: 1px solid #ababab !important;
			border-left: 1px solid #ababab !important;
			border-right: 1px solid #ababab !important;
	
		}
		
		.deleteButtonUp{
			border: none !important;
    		width: 18px !important;
    		height: 22px !important;
    		background-color: #e2e2e2;
		}

		.deleteButtonDown{
			border: none !important;
 		   	border-bottom: none !important;
 		   	color: black !important;
 		   	font-weight: bold !important;
    		width: 25px !important;
    		height: 22px !important;
    		background: white !important;
			padding-top: 2px !important;
		}
		
		.marginTab{
			margin-right: 5px;
		}
		

		.label {
			margin-top:10x;
			font-weight: bold;
			padding: 1px 0.5em;
			white-space: nowrap;
			background-color: #F2F2F2;
		}

		.labeltop {
			margin-top:10x;
			font-weight: bold;
			padding: 1px 0.5em;
			vertical-align: top;
			white-space: nowrap;
			background-color: #F2F2F2;
		}

		.field {
			padding: 1px 0.5em;
		}

		.buttons {
			padding-top: 20px;
			text-align: right;
		}

		.info {
		}

		.warn {
		}

		.error {
		}

		.messages {
			padding-left: 0.5em;
			padding-bottom: 10px;
		}

		.form textarea {
			resize: none;
		}

		.paddingLabelStyle{
			padding-left: 10px;
   			padding-top: 2px;
		}
		
		.width100{
			width: 100%;
		}
		
		.dateStyle{
			width: 140px !important;
			text-align: center !important;
			border: #808080 1px solid !important;
		}
		
		.bold{
			font-weight: bold;
		}
		
		.marginLft5{
			margin-left: 5px;
		}
		
		.paddingText{
			padding: 5px 10px 0px 0px;
		}
		
		.alignRight{
			margin-left: auto;
		}

		.hidden{
			display: none;
		}
		
		.tabsPanel{
			margin-left: 10px;
		}
		
		.tabSelectedStyle{
			background: url("data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAQMAAAAZCAYAAAA160uCAAAAkklEQVR42u3USXKCABQFwH//A8YxxBEJFJQRI+5eFrlGL/oKXavVRwBqvVkHQAbAfwbbzTYAtdvtAlD7/WcAqmmaANTh8BWAOh2PAajT+RyAulwvAai2bQNQt1sXgPruugBU3/cBqGEYAlDjOAagpmkKQN3v9wDUz+MRgJrnOQD1+3wGoF6vVwBqWZYA1PJ+B+APWHe3SG7bckEAAAAASUVORK5CYII=") -0px -0px no-repeat;
			width: auto;
			height: auto;
			padding: 5px;
			border-radius: 4%;
			cursor: pointer;
		}
		
		.tabStyle{
			border: 1px solid #c5c5c5;
			border-radius: 4%;
			padding: 5px;
			border-bottom: none;
			padding-bottom: 0px;
			cursor: pointer;
		}
		
		.pb-15{
			padding-bottom: 15px;
		}
		
	</ui:style>

	<g:HTMLPanel styleName="{style.form}">

	    <table ui:field="datesTable">
	        <tbody>
	            <tr>
	            	<td style="width: 30px;">
	                    <g:CheckBox ui:field="startContractCkBox"></g:CheckBox>
	                </td>
	                <td>
	                    <g:Label styleName="{style.bold}" ui:field="startContractLabel">Notificar Alta Contrato</g:Label>
	                </td>
	            </tr>
	            <tr>
	            	<td style="width: 30px;">
	                    <g:CheckBox ui:field="endContractCkBox"></g:CheckBox>
	                </td>
	                <td>
	                    <g:Label styleName="{style.bold}" ui:field="endContractLabel">Notificar Baja Contrato</g:Label>
	                </td>
	            </tr>
	        </tbody>
	    </table>
	    
	    <table style="margin-top: 5px;">
	        <tbody>
	            <tr>
	            	<td style="width: 230px;">
	                    <g:Label styleName="{style.bold} {style.marginLft5}">Modificar datos de afiliación con fecha: </g:Label>
	                </td>
	                <td>
	                    <a:DateBoxEx ui:field="newDate" styleName="{style.dateStyle} {style.marginLft5}"></a:DateBoxEx>
	                </td>
	            </tr>
	            <tr>
	            	<td colspan="2" style="border: none;">
	                    <g:Label styleName="{style.marginLft5} {style.pb-15}">*Debera rellanar los tres campos para cada tramo. </g:Label>
	                </td>
	            </tr>
	            <tr>
	            	<td colspan="2"  style="border-bottom: 1px solid #e2e2e2;">
	            		<g:HorizontalPanel ui:field="tabsPanel" styleName="{style.tabsPanel}"></g:HorizontalPanel>
	            	</td>
	            </tr>
	            <tr>
	                <td colspan="2">
	                    <g:Label styleName="{style.bold} {style.marginLft5}">Tipo contrato</g:Label>
	                </td>
	            </tr>
	            <tr>
	                <td colspan="2">
	                    <g:ListBox ui:field="tc2" styleName="{style.width100} {style.marginLft5}"></g:ListBox>
	                </td>
	            </tr>
	            <tr>
	                <td colspan="2">
	                    <g:Label styleName="{style.bold} {style.marginLft5}">Grupo cotización</g:Label>
	                </td>
	            </tr>
	            <tr>
	                <td colspan="2">
	                    <g:ListBox ui:field="quoteGroup" styleName="{style.width100} {style.marginLft5}"></g:ListBox>
	                </td>
	            </tr>
	            <tr>
	                <td colspan="2">
	                    <g:Label styleName="{style.bold} {style.marginLft5}">Ocupación</g:Label>
	                </td>
	            </tr>
	            <tr>
	                <td colspan="2">
	                    <g:ListBox ui:field="ocupation" styleName="{style.width100} {style.marginLft5}"></g:ListBox>
	                </td>
	            </tr>
	        </tbody>
	    </table>
	    
	    <div class="{style.buttons}">
	    	<g:HorizontalPanel styleName="{style.alignRight}">
	    		<g:Label styleName="{style.bold} {style.paddingText}">Generar fichero AFI</g:Label>
	    		<g:CheckBox ui:field="generationAFICkBox"></g:CheckBox>	
	    	</g:HorizontalPanel>
		</div>
		
		<div class="{style.buttons}">
			<g:Button ui:field="cancelButton">Cancelar</g:Button>
			<g:Button ui:field="acceptButton">Aceptar</g:Button>
		</div>

	</g:HTMLPanel>

</ui:UiBinder>