<ui:UiBinder 
    xmlns:ui='urn:ui:com.google.gwt.uibinder'
	xmlns:g='urn:import:com.google.gwt.user.client.ui'
	xmlns:es3='urn:import:com.google.gwt.user.client.ui'
	xmlns:datepicker='urn:import:com.google.gwt.user.datepicker.client'
	xmlns:a='urn:import:com.esferalia.aon.gwt.common.client.widget'>

    <ui:with field='res'
		type='com.esferalia.aon.gwt.common.client.css.AonResources' />
    
    
	<ui:style type="com.esferalia.aon.gwt.payroll.client.EmployeeAFIDialog.MyStyle">

		.form {
			padding: 10px;
		}

		.label {
			margin-top:10x;
			font-weight: bold;
			padding: 1px 0.5em;
			white-space: nowrap;
			background-color: #F2F2F2;
		}

		.labeltop {
			margin-top:10x;
			font-weight: bold;
			padding: 1px 0.5em;
			vertical-align: top;
			white-space: nowrap;
			background-color: #F2F2F2;
		}

		.field {
			padding: 1px 0.5em;
		}

		.buttons {
			padding-top: 20px;
			text-align: right;
		}

		.info {
		}

		.warn {
		}

		.error {
		}

		.messages {
			padding-left: 0.5em;
			padding-bottom: 10px;
		}

		.form textarea {
			resize: none;
		}

		.paddingLabelStyle{
			padding-left: 10px;
   			padding-top: 2px;
		}
		
		.width100{
			width: 100%;
		}
		
		.dateStyle{
			width: 140px !important;
			text-align: center !important;
			border: #808080 1px solid !important;
		}
		
		.bold{
			font-weight: bold;
		}
		
		.marginLft5{
			margin-left: 5px;
		}

	</ui:style>

	<g:HTMLPanel styleName="{style.form}">

	    <table>
	        <tbody>
	            <tr>
	            	<td style="width: 30px;">
	                    <g:CheckBox ui:field="startContractCkBox"></g:CheckBox>
	                </td>
	                <td>
	                    <g:Label styleName="{style.bold}">Alta contrato</g:Label>
	                </td>
	            </tr>
	            <tr>
	                <td colspan="2">
	                    <a:DateBoxEx ui:field="startDate" styleName="{style.dateStyle} {style.marginLft5}"></a:DateBoxEx>
	                </td>
	            </tr>
	            <tr>
	            	<td style="width: 30px;">
	                    <g:CheckBox ui:field="endContractCkBox"></g:CheckBox>
	                </td>
	                <td>
	                    <g:Label styleName="{style.bold}">Baja contrato</g:Label>
	                </td>
	            </tr>
	            <tr>
	                <td colspan="2">
	                    <a:DateBoxEx ui:field="endDate" styleName="{style.dateStyle} {style.marginLft5}"></a:DateBoxEx>
	                </td>
	            </tr>
	        </tbody>
	    </table>
	    
	    <table style="margin-top: 20px;">
	        <tbody>
	            <tr>
	            	<td colspan="2">
	                    <g:Label styleName="{style.bold} {style.marginLft5}">A partir de: (Tipo contrato, grupo cotazación, ocupación)</g:Label>
	                </td>
	            </tr>
	            <tr>
	            	<td colspan="2">
	                    <a:DateBoxEx ui:field="newDate" styleName="{style.dateStyle} {style.marginLft5}"></a:DateBoxEx>
	                </td>
	            </tr>
	            <tr>
	            	<td style="width: 30px;">
	                    <g:CheckBox ui:field="changeContractCkBox"></g:CheckBox>
	                </td>
	                <td>
	                    <g:Label styleName="{style.bold}">Tipo contrato</g:Label>
	                </td>
	            </tr>
	            <tr>
	                <td colspan="2">
	                    <g:ListBox ui:field="tc2" styleName="{style.width100} {style.marginLft5}"></g:ListBox>
	                </td>
	            </tr>
	            <tr>
	           	 	<td style="width: 30px;">
	                    <g:CheckBox ui:field="quoteContractCkBox"></g:CheckBox>
	                </td>
	                <td>
	                    <g:Label styleName="{style.bold}">Grupo cotización</g:Label>
	                </td>
	            </tr>
	            <tr>
	                <td colspan="2">
	                    <g:ListBox ui:field="quoteGroup" styleName="{style.width100} {style.marginLft5}"></g:ListBox>
	                </td>
	            </tr>
	            <tr>
	             	<td style="width: 30px;">
	                    <g:CheckBox ui:field="ocupationContractCkBox"></g:CheckBox>
	                </td>
	                <td>
	                    <g:Label styleName="{style.bold}">Ocupación</g:Label>
	                </td>
	            </tr>
	            <tr>
	                <td colspan="2">
	                    <g:ListBox ui:field="ocupation" styleName="{style.width100} {style.marginLft5}"></g:ListBox>
	                </td>
	            </tr>
	        </tbody>
	    </table>
	    
	    <table style="margin-top: 20px;">
	        <tbody>
	            <tr>
	             	<td style="width: 30px;">
	                    <g:CheckBox ui:field="generationAFICkBox"></g:CheckBox>
	                </td>
	                <td>
	                    <g:Label styleName="{style.bold}">Generar fichero AFi para los cambios</g:Label>
	                </td>
	            </tr>
	        </tbody>
	    </table>
		
		<div class="{style.buttons}">
			<g:Button ui:field="cancelButton">Cancelar</g:Button>
			<g:Button ui:field="acceptButton">Aceptar</g:Button>
		</div>

	</g:HTMLPanel>

</ui:UiBinder>