<ui:UiBinder 
    xmlns:ui='urn:ui:com.google.gwt.uibinder'
	xmlns:g='urn:import:com.google.gwt.user.client.ui'
	xmlns:datepicker='urn:import:com.google.gwt.user.datepicker.client'
	xmlns:a='urn:import:com.esferalia.aon.gwt.common.client.widget'>

    <ui:with field='res' type='com.esferalia.aon.gwt.common.client.css.AonResources' />
    
	<ui:style type="com.esferalia.aon.gwt.payroll.client.EmployeeAFIDialog.MyStyle">
	
		@external .gwt-ToggleButton-down;
		@external .gwt-ToggleButton-up;
		@external .gwt-ToggleButton-down-hovering;
		@external .gwt-ToggleButton-up-hovering;

		.form {
			padding: 15px 20px;
			display: flex;
			flex-direction: column;
			gap: 1rem;
			max-width: 500px;
		}
		
		.tabSelected{
			border: 1px solid #e2e2e2;
			border-bottom: none;
			cursor: pointer;
		}
		
		.tabUnSelected{
			background-color: #eee;
			cursor: pointer;
		}
		
		.tabIconSelected{
			background-color: white !important;
		}
		
		.gwt-ToggleButton-down{
			border: none !important;
			color: black !important;
			font-weight: bold !important;
			padding-bottom: 3px !important;
			background: white !important;
		}

		.gwt-ToggleButton-up{
			border: none !important;
			border-bottom: none !important;
			color: #ababab !important;
			background: #e2e2e2 !important;
		}

		.gwt-ToggleButton-down-hovering{
			border: none !important;
			color: black !important;
			font-weight: bold !important;
			padding-bottom: 3px !important;
			background: white !important;
		}

		.gwt-ToggleButton-up-hovering{
			border: none !important;
			border-bottom: none !important;
			color: #ababab !important;
			background: #e2e2e2 !important;
		}

		.selectButtonSalaryToggleButton{
			border-top: 1px solid #ababab !important;
			border-left: 1px solid #ababab !important;
			border-right: 1px solid #ababab !important;
	
		}
		
		.deleteButtonUp{
			border: none !important;
    		width: 18px !important;
    		height: 22px !important;
    		background-color: #e2e2e2;
		}

		.deleteButtonDown{
			border: none !important;
 		   	border-bottom: none !important;
 		   	color: black !important;
 		   	font-weight: bold !important;
    		width: 25px !important;
    		height: 22px !important;
    		background: white !important;
			padding-top: 2px !important;
		}
		

		.label {
			margin-top:10x;
			font-weight: bold;
			padding: 1px 0.5em;
			white-space: nowrap;
			background-color: #F2F2F2;
		}

		.labeltop {
			margin-top:10x;
			font-weight: bold;
			padding: 1px 0.5em;
			vertical-align: top;
			white-space: nowrap;
			background-color: #F2F2F2;
		}

		.field {
			padding: 1px 0.5em;
		}

		.buttons {
			padding-top: 20px;
			text-align: right;
		}

		.info {
		}

		.warn {
		}

		.error {
		}

		.messages {
			padding-left: 0.5em;
			padding-bottom: 10px;
		}

		.form textarea {
			resize: none;
		}

		.paddingLabelStyle{
			padding-left: 10px;
   			padding-top: 2px;
		}
		
		.width100{
			width: 100%;
		}
		
		.width99{
			width: 99%;
		}
		
		.dateStyle{
			width: 140px !important;
			text-align: center !important;
			border: #808080 1px solid !important;
		}
		
		.bold{
			font-weight: bold;
		}
		
		.marginLft5{
			margin-left: 5px;
		}
		
		.paddingText{
			padding: 5px 10px 0px 0px;
		}
		
		.alignRight{
			margin-left: auto;
		}

		.hidden{
			display: none;
		}
		
		.tabsPanel{
			margin-left: 10px;
			display: flex;
			gap: 5px;
		}
		
		.tabSelectedStyle{
			background: url("data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAQMAAAAZCAYAAAA160uCAAAAkklEQVR42u3USXKCABQFwH//A8YxxBEJFJQRI+5eFrlGL/oKXavVRwBqvVkHQAbAfwbbzTYAtdvtAlD7/WcAqmmaANTh8BWAOh2PAajT+RyAulwvAai2bQNQt1sXgPruugBU3/cBqGEYAlDjOAagpmkKQN3v9wDUz+MRgJrnOQD1+3wGoF6vVwBqWZYA1PJ+B+APWHe3SG7bckEAAAAASUVORK5CYII=") -0px -0px no-repeat;
			width: auto;
			height: auto;
			padding: 5px;
			border-radius: 4%;
			cursor: pointer;
		}
		
		.tabStyle{
			border: 1px solid #c5c5c5;
			border-radius: 4%;
			padding: 5px;
			border-bottom: none;
			padding-bottom: 0px;
			cursor: pointer;
		}
		
		.pb-15{
			padding-bottom: 15px;
		}
		
		
		.buttonsPanel{
			display: flex;
			justify-content: flex-end;
			margin-top: 20px;
		}
		
		.flexToggle{
			display: flex;
			align-items: center;
			gap: 5px;
		}
		
		.mt10{
			margin-top: 10px;
		}
		
		.flexColumn{
			display: flex;
			flex-direction: column;
			gap: 5px;
		}
		
		.flex{
			display: flex;
			gap: 5px;
		}
		
		.datePickerPanel{
			border: none !important;
    		box-shadow: none !important;
    		z-index: 8;
		}
		
		.moreButton{
			border: 1px solid #e2e2e2 !important;
			color: black !important;
			font-weight: bold !important;
			background: white !important;
			border-bottom: none !important;
			border-radius: 0;
			min-width: 25px;
			max-width: 25px;
		}
		
		.input {
			display: flex;
			flex-direction: column;
			gap: .2rem;
		}
		
		.title {
			font-weight: bold;
			font-size: .9rem;
		}
		
		.sendBtn{
			background-attachment: scroll;
			background-clip: border-box;
			background-color: inherit;
			background-position: 1px -2px;
			background-repeat: no-repeat;
			background-size: auto auto;
			border: 1px solid #aaa;
			cursor: pointer;
			height: 24px;
			overflow: visible;
			padding-left: 25px;
			text-align: left;
			text-transform: uppercase;
			width: auto;
		}
		
		.flex {
			display: flex;
			gap: 0.1rem;
		}

	</ui:style>

	<g:HTMLPanel styleName="{style.form}">
	
		<g:HTMLPanel styleName="{style.input}">
			<g:Label text="Tipo de movimiento" styleName="{style.title}" />
			<g:ListBox ui:field="afiTypeLB" />
		</g:HTMLPanel>
	
		<g:DeckPanel ui:field="deckPanel">
		
			<g:HTMLPanel styleName="{style.input}">
				<g:Label text="Código de baja" styleName="{style.title}" />
				<g:ListBox ui:field="settleReasonLB" styleName="{style.width100}" />
			</g:HTMLPanel>
			
			<g:HTMLPanel styleName="{style.flexColumn}">
				<g:HTMLPanel ui:field="tabsPanel" styleName="{style.tabsPanel}" />
				<g:Label styleName="{style.bold}">Tipo contrato</g:Label>
				<g:ListBox ui:field="tc2" styleName="{style.width100}" />
				<g:Label styleName="{style.bold}">Grupo cotización</g:Label>
				<g:ListBox ui:field="quoteGroup" styleName="{style.width100}" />
				<g:Label styleName="{style.bold}">Ocupación</g:Label>
				<g:ListBox ui:field="ocupation" styleName="{style.width100}" />
				<g:Label ui:field="partialityCoefL" styleName="{style.bold}">Coeficiente Parcialidad</g:Label>
				<a:DoubleBox ui:field="partialityCoef" styleName="{style.width99}" />
			</g:HTMLPanel>
		
		</g:DeckPanel>
	    
	   	<g:HTMLPanel ui:field="afiFilePanel" styleName="{style.flexToggle}  {style.mt10}">
	   		<g:Button ui:field="generationAFITB" />
    		<g:Label styleName="{style.bold}">Generar fichero AFI</g:Label>	
    	</g:HTMLPanel>
		
		<g:HTMLPanel ui:field="buttonsPanel" styleName="{style.buttonsPanel}"></g:HTMLPanel>

	</g:HTMLPanel>

</ui:UiBinder>