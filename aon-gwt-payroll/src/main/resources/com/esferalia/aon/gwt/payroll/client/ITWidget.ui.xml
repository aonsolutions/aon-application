<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
	xmlns:g='urn:import:com.google.gwt.user.client.ui'
	xmlns:c='urn:import:com.google.gwt.user.cellview.client'>

	<ui:style type="com.esferalia.aon.gwt.payroll.client.ITWidget.MyStyle">

		/* UI XML Styles */
		
		.widthAll{
			width: 100%
		}
		
		.mt-50{
			margin-top: 50px;
		}
		
		.mt10{
			margin-top: 10px;
		}
		
		.deckPanel{
			padding: 0 10px; 
			height: 100%;
		}
		
		.messagePanel{
			display: flex;
			justify-content: center;
		}
		
		.message{
			text-transform: uppercase;
			font-weight: bold;
		}
		
		/* MainContrataIT Styles */
	    
	    .filterPanel{
			display: flex;
			justify-content: space-between;
			margin: auto 15px;
		}
		
		.flexPanel{
			display: flex;
			align-items: center;
		}

		.cmdBtn{
			background-position: center left;
			background-repeat: no-repeat;
			padding-left: 25px !important;
			background-size: contain;
		}
		
	</ui:style>

	<g:DockLayoutPanel ui:field="dockLayoutPanel" unit="PX">
		<g:center>
			<g:VerticalPanel styleName="{style.mt-50} {style.widthAll}">
			
				<g:HTMLPanel ui:field="messagePanel" />
				<g:HTMLPanel ui:field="filterITListPanel" />
				
				<g:DeckPanel ui:field='deckPanel' styleName="{style.deckPanel}">
					<g:HTMLPanel ui:field='timelinePanel'/>
					<g:HTMLPanel styleName="{style.messagePanel}">
						<g:Label styleName="{style.message}">No existen partes IT para para este periodo</g:Label>
					</g:HTMLPanel>
				</g:DeckPanel>
			
			</g:VerticalPanel>
		</g:center>
	</g:DockLayoutPanel>
			
</ui:UiBinder> 

