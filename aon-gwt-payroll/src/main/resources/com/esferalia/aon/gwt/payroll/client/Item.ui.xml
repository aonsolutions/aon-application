<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<ui:UiBinder xmlns:ui='urn:ui:com.google.gwt.uibinder'
	xmlns:g='urn:import:com.google.gwt.user.client.ui' xmlns:datepicker='urn:import:com.google.gwt.user.datepicker.client'>
	<ui:with field='msgs' type='com.esferalia.aon.gwt.payroll.client.i18n.PayrollMessages'/>

	<ui:Style>
	.form {
		padding: 10px;
	}
	
	.label {
		margin-top: 10x;
		font-weight: bold;
		padding: 1px 0.5em;
		white-space: nowrap;
		background-color: #F2F2F2;
	}
	
	.labeltop {
		margin-top: 10x;
		font-weight: bold;
		padding: 1px 0.5em;
		vertical-align: top;
		white-space: nowrap;
		background-color: #F2F2F2;
	}
	
	.field {
		padding: 1px 0.5em;
	}
	
	.buttons {
		padding-top: 10px;
		text-align: right;
	}
	
	.messages {
		padding-left: 0.5em;
		padding-bottom: 10px;
	}
	
	.form textarea {
		resize: none;
	}
	
	</ui:Style>


	<ui:import field="com.esferalia.aon.gwt.payroll.client.Constants.*" />

	<g:HTMLPanel styleName="{style.form}">


		<g:Grid width="100%" ui:field="mainGrid">
			<g:row>
				<g:customCell styleName="{style.label}">
					<g:Label text="{msgs.concept}"/>
				</g:customCell>
				<g:customCell styleName="{style.field}">
					<g:HorizontalPanel verticalAlignment="ALIGN_MIDDLE"
						styleName="aon-width-all">
						<g:cell >
							<g:SuggestBox ui:field="conceptSuggestBox"
								styleName="aon-width-all aon-inputText" />
						</g:cell>
						<g:cell >
							<g:Label styleName="aon-margin-left" ui:field="conceptDescriptionLabel"/>
						</g:cell>
					</g:HorizontalPanel>
				</g:customCell>
			</g:row>
			<g:row>
				<g:customCell styleName="{style.label}">
					<g:Label text="{msgs.type}"/>
				</g:customCell>
				<g:customCell styleName="{style.field}">
					<g:HorizontalPanel styleName="aon-width">
						<g:HorizontalPanel verticalAlignment="ALIGN_MIDDLE"
							styleName="aon-width-all">
							<g:ListBox ui:field="typeListBox" />
							<g:cell horizontalAlignment="ALIGN_RIGHT" width="24px">
								<g:Button ui:field="resetTypeButton" styleName="aon-lookupButton-clear "
									visible="false" />
							</g:cell>
						</g:HorizontalPanel>
					</g:HorizontalPanel>
				</g:customCell>
			</g:row>
			<g:row>
				<g:customCell styleName="{style.label}">
					<g:Label text="{msgs.description}"/>
				</g:customCell>
				<g:customCell styleName="{style.field}">
					<g:HorizontalPanel verticalAlignment="ALIGN_MIDDLE"
						styleName="aon-width-all">
						<g:SuggestBox ui:field="descriptionSuggestBox"
							styleName="aon-width-all aon-inputText" />
						<g:cell horizontalAlignment="ALIGN_RIGHT" width="24px">
							<g:Button ui:field="resetDescriptionButton" styleName="aon-lookupButton-clear"
								visible="false" />
						</g:cell>
					</g:HorizontalPanel>
				</g:customCell>
			</g:row>
			<g:row>
				<g:customCell styleName="{style.label}">
					<g:Label text="{msgs.amount}"/>
				</g:customCell>
				<g:customCell styleName="{style.field}">
					<g:HorizontalPanel verticalAlignment="ALIGN_MIDDLE"
						styleName="aon-width-all">
						<g:TextBox ui:field="expressionTextBox" styleName="aon-width-all aon-inputText" maxLength="{DESCRIPTION_MAX_LENGTH}"/>
						<g:cell horizontalAlignment="ALIGN_CENTER" width="24px">
							<g:Button ui:field="fxExpressionButton" styleName="aon-margin-left aon-editDataTable-button aon-icon-fx" />
						</g:cell>
						<g:cell horizontalAlignment="ALIGN_RIGHT" width="24px">
							<g:Button ui:field="resetExpressionButton" styleName="aon-lookupButton-clear"
								visible="false" />
						</g:cell>
					</g:HorizontalPanel>
				</g:customCell>
			</g:row>
		</g:Grid>

	</g:HTMLPanel>


</ui:UiBinder>