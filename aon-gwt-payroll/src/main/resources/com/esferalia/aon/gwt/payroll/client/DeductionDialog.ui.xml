<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<ui:UiBinder xmlns:ui='urn:ui:com.google.gwt.uibinder'
	xmlns:g='urn:import:com.google.gwt.user.client.ui'
	xmlns:aon='urn:import:com.esferalia.aon.gwt.payroll.client' >

	<ui:with field='msgs' type='com.esferalia.aon.gwt.payroll.client.i18n.PayrollMessages'/>

	<ui:Style  >

	</ui:Style>


	<g:HTMLPanel styleName="aon-width-all aon-height-all">

		<table class="aon-width-all aon-height-all" >
			<tr>
				<td>
					<aon:Deduction ui:field="deduction"/>
				</td>
			</tr>

			<tr>
				<td colspan="2" align="right">
					<g:Button ui:field="cancelButton" text="{msgs.cancel}"/>
					<g:Button ui:field="acceptButton" text="{msgs.accept}"/>
				</td>
			</tr>
		</table>


	</g:HTMLPanel>

</ui:UiBinder>
