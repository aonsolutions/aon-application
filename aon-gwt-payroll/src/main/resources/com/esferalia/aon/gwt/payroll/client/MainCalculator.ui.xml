<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<ui:UiBinder xmlns:ui='urn:ui:com.google.gwt.uibinder'
	xmlns:g='urn:import:com.google.gwt.user.client.ui' 
	xmlns:aon='urn:import:com.esferalia.aon.gwt.common.client.widget'
	xmlns:cell='urn:import:com.google.gwt.user.cellview.client'>

	<ui:with type="com.esferalia.aon.gwt.common.client.css.AonResources" field="aonResources"></ui:with>
	
	<ui:style>
		.monthListBox-item {
			padding-left: 16px;
		}
		
		.options-scroll-panel>div {
			height: 99%;
		}
	</ui:style>


	<g:SplitLayoutPanel ui:field="splitLayoutPanel">


		<g:center>
			<g:ScrollPanel styleName="aon-scroll-area {style.options-scroll-panel}">

				<g:HTMLPanel styleName="aon-panelGrid-search">
					<div class="aon-panelGrid-search-info ">
						<span class="aon-panelGrid-search-info-internal">Introduzca los parámetros de cálculo:</span>
						<a style="font-size:1em;font-weight:bold;float:right;" onclick=""
							href="#">
							<span class="aon-outputText">[?]</span>
						</a>
					</div>

					<table class="aon-panelGrid aon-width-all" style="height:90%">
						<tr>
							<td class="aon-panelGrid-odd">
								<g:Label styleName="aon-outputLabel">Tipo</g:Label>
							</td>
							<td class="aon-panelGrid-even aon-width-half-plus">
								<g:ListBox>
									<g:item>N&oacute;mina</g:item>
								</g:ListBox>
							</td>
						</tr>
						<tr>
							<td class="aon-panelGrid-odd">
								<g:Label styleName="aon-outputLabel">Mes</g:Label>
							</td>
							<td class="aon-panelGrid-even">
								<aon:MonthListBox
									debugId="monthListBox"
									ui:field="monthListBox" 
									styleName="aon-selectOneMenu"
									monthStyles="{style.monthListBox-item}"
									highLightStyles="aon-bold aon-black aon-icon-accept {style.monthListBox-item}" />
							</td>
						</tr>
						<tr>
							<td class="aon-panelGrid-odd">
								<g:Label styleName="aon-outputLabel">Comparar con</g:Label>
							</td>
							<td class="aon-panelGrid-even ">
								<g:ListBox styleName="aon-selectOneMenu"
									debugId="dbMonthListBox"
									ui:field="dbMonthListBox" 
									/>
							</td>
						</tr>
						<tr>
							<td class="aon-panelGrid-odd" >
								<span class="aon-outputText">&nbsp;</span>
							</td>
							<td class="aon-panelGrid-even" >
								<div class="aon-group aon-width-half">
									<div class="aon-group-title" style="background-color: transparent;">
										<g:CheckBox 
										checked="false"
										debugId="saveCheckBox"  
										ui:field="saveCheckBox" 
										>
										Guardar
										</g:CheckBox>
									</div>
									<div>
										<g:RadioButton 
											checked="true" 
											enabled="false"
											name="saveRadioButton" 
											debugId="keepRadioButton" 
											ui:field="keepRadioButton"
											>Conservar n&oacute;minas calculadas</g:RadioButton>
									</div>
									<div>
										<g:RadioButton
											enabled="false" 
											name="saveRadioButton" 
											debugId="overwriteRadioButton" 
											ui:field="overwriteRadioButton"
											>Eliminar n&oacute;minas calculadas</g:RadioButton>
									</div>
									<!-- div>
										<g:RadioButton name="saveRadioButton" ui:field="duplicateRadioButton"
											enabled="false"> Duplicar n&oacute;minas calculadas</g:RadioButton>
									</div-->
								</div>
							</td>
						</tr>
						<tr>
							<td class="aon-panelGrid-odd" >
								<span class="aon-outputText">&nbsp;</span>
							</td>
							<td class="aon-panelGrid-even" >
								<span class="aon-outputText">&nbsp;</span>
							</td>
						</tr>
						<tr>
							<td class="aon-panelGrid-odd">
								<span class="aon-outputText"></span>
							</td>
							<td class="aon-panelGrid-even">
								<g:Button debugId="calcButton" ui:field="calcButton" enabled="false">Calcular</g:Button>
							</td>
						</tr>
						<tr>
							<td colspan="2" class="aon-panelGrid-even aon-width-all aon-height-all">
								<aon:CustomDataGrid 
									debugId="enterprisesDataGrid" 
									ui:field="enterprisesDataGrid" 
									styleName="aon-width-all aon-height-all aon-text-left" />
							</td>
						</tr>
					</table>


				</g:HTMLPanel>

			</g:ScrollPanel>

		</g:center>

		<g:south size="0">
			<aon:MinimizePanel ui:field="footPanel" styleName="{aonResources.css.aonSelector}" >
				<g:TabLayoutPanel barHeight="26" barUnit="PX" >
					<g:tab>
						<g:header>
							<span class="aon-icon-time aon-icon-commandButton">Resultados</span>
						</g:header>
						<aon:ResultsPanel debugId="resultsPanel" ui:field="resultsPanel" />
					</g:tab>
				</g:TabLayoutPanel>
			</aon:MinimizePanel>
		</g:south>

	</g:SplitLayoutPanel>

</ui:UiBinder>
