<ui:UiBinder 
    xmlns:ui='urn:ui:com.google.gwt.uibinder'
	xmlns:g='urn:import:com.google.gwt.user.client.ui'
	xmlns:es3='urn:import:com.google.gwt.user.client.ui'
	xmlns:datepicker='urn:import:com.google.gwt.user.datepicker.client'
	xmlns:a='urn:import:com.esferalia.aon.gwt.common.client.widget'>

    <ui:with field='res' type='com.esferalia.aon.gwt.common.client.css.AonResources' />
    
	<ui:style type="com.esferalia.aon.gwt.payroll.client.EmployeeCalendarPercentDialog.MyStyle">

		.form {
			padding: 10px;
		}

		.typesPanel{
			display: flex;
			justify-content: space-between;
			padding: 5px;
		}
		
		.typesLabel{
			display: flex;
			align-items: center;
			margin-right: 5px;
		}
		
		.percentPanel{
			display: flex;
			justify-content: space-between;
			padding: 5px;
		}
		
		.percentLabel{
			display: flex;
			align-items: center;
			margin-right: 5px;
		}
		
		.percentTBx{
			width: 80px;
		}
		
		.percent{
			text-align: center;
			font-weight: bold;
			display: flex;
			align-items: center;
			margin-left: 5px;
		}
		
		.errorPanel{
			font-weight: bold;
			color: red;
			padding: 0 5px;
		}
		
		.buttonPanel{
			display: flex;
			justify-content: flex-end;
			padding: 5px;
			margin-top: 5px;
		}
		
	</ui:style>

	<g:HTMLPanel styleName="{style.form}">
	
		<g:HTMLPanel styleName="aon-width-all aon-height-all">
		
			<g:HTMLPanel styleName="{style.typesPanel}">
				<g:Label styleName="{style.typesLabel}">Tipos de ausencia:</g:Label>
				<g:ListBox ui:field="typeDrop"></g:ListBox>
			</g:HTMLPanel>
			
			<g:HTMLPanel styleName="{style.percentPanel}">
				<g:Label styleName="{style.percentLabel}">Porcentaje de reducción sobre las horas totales:</g:Label>
				<g:TextBox ui:field="percentBox" styleName="{style.percentTBx}"></g:TextBox>
				<g:Label styleName="{style.percent}" >%</g:Label>
			</g:HTMLPanel>
			
			<g:HTMLPanel  ui:field="errorMessage" styleName="{style.errorPanel}">
				<g:Label>El valor introducido no tiene formato de número.</g:Label>
				<g:Label>Decimales separados por '.'</g:Label>
			</g:HTMLPanel>
			
			<g:HTMLPanel styleName="{style.buttonPanel}">
				<g:Button ui:field="cancelButton">Cerrar</g:Button>
	    		<g:Button ui:field="acceptButton">OK</g:Button>
			</g:HTMLPanel>
		
		</g:HTMLPanel>
			
	</g:HTMLPanel>

</ui:UiBinder>