<ui:UiBinder 
    xmlns:ui='urn:ui:com.google.gwt.uibinder'
	xmlns:g='urn:import:com.google.gwt.user.client.ui'
	xmlns:es3='urn:import:com.google.gwt.user.client.ui'
	xmlns:datepicker='urn:import:com.google.gwt.user.datepicker.client'
	xmlns:a='urn:import:com.esferalia.aon.gwt.common.client.widget'>

    <ui:with field='res'
		type='com.esferalia.aon.gwt.common.client.css.AonResources' />
    
    
	<ui:style type="com.esferalia.aon.gwt.payroll.client.EmployeeCalendarPercentDialog.MyStyle">

		.paddingTypePercentStyle{
			padding-right: 7px;
    		padding-top: 4px;
		}

		.paddingPercentStyle{
			padding-left: 7px;
    		padding-top: 4px;
		}
		
		.widthDoubleBox{
			width: 55px;
		}

		.messageStyle{
			padding-right: 70px;
			font: 13px/ 1.333 "arial", "lucida Grande", "Trebuchet MS", sans-serif;
		}

		.paddingBlocks{
			padding-bottom: 15px;
			padding-top: 10px;
		}

		.form {
			padding: 10px;
		}

		.closeButton {
			position: relative;
    		left: 90px;
			border: 1px solid #bbb;
			border-radius: 3px;
			cursor: pointer;
		}
		
		.w200{
			width: 143px;
			text-align: center;
		}
		
		.hourLabel{
			color: #0000a1;
		}

	</ui:style>

	<g:HTMLPanel styleName="{style.form}">
	
		<g:HTMLPanel styleName="aon-width-all aon-height-all">
	
		<table class="aon-width-all aon-height-all" style="padding: 5px;">
			<tr>
				<td>
					<g:Label>Tipos de ausencia:</g:Label>
				</td>
				<td>
					<g:ListBox ui:field="typeDrop"></g:ListBox>
				</td>
			</tr>
			<tr>
				<td>
					<g:Label ui:field="typePercent"></g:Label>
				</td>
				<td>
					<g:TextBox ui:field="percentBox" styleName="{style.w200}"></g:TextBox>
				</td>
			</tr>
			<tr>
				<td colspan="2">
					<g:Label ui:field="messageLabel" styleName="{style.hourLabel}"></g:Label>
				</td>
			</tr>
			<tr>
				<td colspan="2" align="right" style="padding-top: 15px;">
					<g:Button ui:field="cancelButton">Cerrar</g:Button>
		    		<g:Button ui:field="acceptButton">OK</g:Button>
				</td>
			</tr>
		</table>
			
	</g:HTMLPanel>

		<!-- g:VerticalPanel>
		    <g:HorizontalPanel styleName="{style.paddingBlocks}">
		    	<g:Label ui:field="typePercent" styleName="{style.paddingTypePercentStyle}"></g:Label>
		    	<g:TextBox ui:field="percentBox" styleName="{style.widthDoubleBox}"></g:TextBox>
		    </g:HorizontalPanel>
		    <g:HorizontalPanel styleName="{style.paddingBlocks}"> 
		    	<g:Label ui:field="messageLabel" styleName="{style.messageStyle}"></g:Label>
		    </g:HorizontalPanel>
		   	<g:HorizontalPanel styleName="{style.paddingBlocks}">
		    	<g:Button styleName="{style.closeButton}" ui:field="cancelButton">Cerrar</g:Button>
		    	<g:Button styleName="{style.closeButton}" ui:field="acceptButton">OK</g:Button>
		    </g:HorizontalPanel>
		</g:VerticalPanel -->
			
	</g:HTMLPanel>

</ui:UiBinder>