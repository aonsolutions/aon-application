<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<ui:UiBinder xmlns:ui='urn:ui:com.google.gwt.uibinder'
	xmlns:g='urn:import:com.google.gwt.user.client.ui' 
	xmlns:aon='urn:import:com.esferalia.aon.gwt.common.client.widget'
	xmlns:cell="urn:import:com.google.gwt.user.cellview.client">

	<ui:Style>
	.form {
		padding: 10px;
	}
	
	.label {
		margin-top: 10x;
		font-weight: bold;
		padding: 1px 0.5em;
		white-space: nowrap;
		background-color: #F2F2F2;
	}
	
	.labeltop {
		margin-top: 10x;
		font-weight: bold;
		padding: 1px 0.5em;
		vertical-align: top;
		white-space: nowrap;
		background-color: #F2F2F2;
	}
	
	.field {
		padding: 1px 0.5em;
	}
	
	.buttons {
		padding-top: 10px;
		text-align: right;
	}
	
	.info {
		
	}
	
	.warn {
		
	}
	
	.error {
		
	}
	
	.messages {
		padding-left: 20px;
	}
	
	.form textarea {
		resize: none;
	}
	
	.monthListBox-item {
		padding-left: 16px;
	}
	
	.options-scroll-panel>div {
		height: 99%;
	}
	</ui:Style>

	<ui:import field="com.esferalia.aon.gwt.payroll.shared.CretaService.Parameter.*" />

	<g:HTMLPanel styleName="aon-width-all aon-height-all">

		<table class="aon-width-all {style.form} ">
			<tr >
				<td  colspan="2">
					<g:Label styleName="gwt-Label {style.messages} aon-icon-exception"  ui:field="messagesLabel"  />
				</td>
			</tr>
			<tr>
				<td class="{style.label}">
					<g:Label text="Autorizado" />
				</td>
				<td class="{style.field}">
					<g:LongBox  styleName="gwt-TextBox aon-width-all" ui:field="authLongBox"/>
				</td>
			</tr>

			<tr>
				<td class="{style.label}">
					<g:Label text="Tipo Movimiento" />
				</td>
				<td class="{style.field}">
					<g:ListBox styleName="aon-selectOneMenu"
						ui:field="movementTypeListBox" >
						<g:item value="C" >C: Liquidaciones deudoras</g:item>
						<g:item value="S" >S: Liquidaciones acreedoras</g:item>
						<g:item value="A" >A: Liquidaciones deudoras y acreedoras</g:item>
					</g:ListBox>
				</td>
			</tr>

			<tr>
				<td class="{style.label}">
					<g:Label text="Tipo Acci&oacute;n" />
				</td>
				<td class="{style.field}">
					<g:ListBox styleName="aon-selectOneMenu"
						ui:field="actionTypeListBox" >
						<g:item value="1" >1: Alta o modificaci&oacute; de los datos bancarios </g:item>
						<g:item value="2" >2: Eliminaci&oacute;n de los datos bancarios</g:item>
					</g:ListBox>
				</td>
			</tr>

			<tr>
				<td class="{style.label}">
					<g:Label text="IBAN" />
				</td>
				<td class="{style.field}">
					<g:SuggestBox styleName="gwt-TextBox aon-width-all"
						ui:field="ibanSuggestBox" />
				</td>
			</tr>

			<tr>
				<td class="{style.label}">
					<g:Label text="Titular" />
				</td>
				<td class="{style.field}">
					<g:TextBox styleName="gwt-TextBox aon-width-all"
						ui:field="holderTextBox" />
				</td>
			</tr>

			<tr>
				<td class="{style.label}">
					<g:Label text="Documento" />
				</td>
				<td class="{style.field}">
					<g:TextBox styleName="gwt-TextBox aon-width-all"
						ui:field="documentTextBox" />
				</td>
			</tr>

			<tr>
				<td class="{style.label}">
					<g:Label text="Tipo Documento" />
				</td>
				<td class="{style.field}">
					<g:ListBox styleName="aon-selectOneMenu"
						ui:field="documentTypeListBox" >
						<g:item value="1" >1: NIF </g:item>
						<g:item value="6" >6: NIE</g:item>
						<g:item value="9" >9: CIF</g:item>
					</g:ListBox>
				</td>
			</tr>

			<tr>
				<td class="{style.field}" colspan="2">&nbsp;</td>
			</tr>
			<tr>
				<td class="{style.label}" colspan="2">
					<g:Label text="Selecciona los C&oacute;digo de Cuenta de Cotizaci&oacute;n : " ui:field="selectLabel" />
				</td>
			</tr>
			<tr>
				<td class="{style.field} aon-width-all" colspan="2">
					<cell:DataGrid ui:field="selectDataGrid" />
				</td>
			</tr>
			<tr>
				<td class="{style.field}" colspan="2">&nbsp;</td>
			</tr>

			<tr>
				<td class="{style.field}" colspan="2">&nbsp;</td>
			</tr>
		</table>

		<div class="{style.buttons} {style.form} ">
			<g:Button ui:field="cancelButton">Cancelar</g:Button>
			<g:Button ui:field="acceptButton" enabled="false" >Aceptar</g:Button>
			<g:Anchor ui:field="downloadAnchor" visible="false" />
		</div>

	</g:HTMLPanel>


</ui:UiBinder>