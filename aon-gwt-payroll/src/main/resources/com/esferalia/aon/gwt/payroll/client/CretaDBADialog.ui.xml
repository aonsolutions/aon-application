<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<ui:UiBinder xmlns:ui='urn:ui:com.google.gwt.uibinder'
	xmlns:g='urn:import:com.google.gwt.user.client.ui'
	xmlns:aon='urn:import:com.esferalia.aon.gwt.common.client.widget'
	xmlns:cell="urn:import:com.google.gwt.user.cellview.client">

	<ui:with field='msgs' type='com.esferalia.aon.gwt.payroll.client.i18n.PayrollMessages'/>

	<ui:Style>
	.form {
		padding: 10px;
	}

	.label {
		margin-top: 10x;
		font-weight: bold;
		padding: 1px 0.5em;
		white-space: nowrap;
		background-color: #F2F2F2;
	}

	.labeltop {
		margin-top: 10x;
		font-weight: bold;
		padding: 1px 0.5em;
		vertical-align: top;
		white-space: nowrap;
		background-color: #F2F2F2;
	}

	.field {
		padding: 1px 0.5em;
	}

	.buttons {
		padding-top: 10px;
		text-align: right;
	}

	.info {

	}

	.warn {

	}

	.error {

	}

	.messages {
		padding-left: 20px;
	}

	.form textarea {
		resize: none;
	}

	.monthListBox-item {
		padding-left: 16px;
	}

	.options-scroll-panel>div {
		height: 99%;
	}
	</ui:Style>

	<ui:import field="com.esferalia.aon.gwt.payroll.shared.CretaService.Parameter.*" />

	<g:HTMLPanel styleName="aon-width-all aon-height-all">

		<table class="aon-width-all {style.form} ">
			<tr >
				<td  colspan="2">
					<g:Label styleName="gwt-Label {style.messages} aon-icon-exception"  ui:field="messagesLabel"  />
				</td>
			</tr>
			<tr>
				<td class="{style.label}">
					<g:Label text="{msgs.authorized}" />
				</td>
				<td class="{style.field}">
					<g:LongBox  styleName="gwt-TextBox aon-width-all" ui:field="authLongBox"/>
				</td>
			</tr>

			<tr>
				<td class="{style.label}">
					<g:Label text="{msgs.movementType}" />
				</td>
				<td class="{style.field}">
					<g:ListBox styleName="aon-selectOneMenu"
						ui:field="movementTypeListBox" >
						<g:item value="C" >{msgs.liquidationTypeC}</g:item>
						<g:item value="S" >{msgs.liquidationTypeS}</g:item>
						<g:item value="A" >{msgs.liquidationTypeA}</g:item>
					</g:ListBox>
				</td>
			</tr>

			<tr>
				<td class="{style.label}">
					<g:Label text="{msgs.actionType}" />
				</td>
				<td class="{style.field}">
					<g:ListBox styleName="aon-selectOneMenu"
						ui:field="actionTypeListBox" >
						<g:item value="1" >{msgs.actionType1}</g:item>
						<g:item value="2" >{msgs.actionType2}</g:item>
					</g:ListBox>
				</td>
			</tr>

			<tr>
				<td class="{style.label}">
					<g:Label text="{msgs.iban}" />
				</td>
				<td class="{style.field}">
					<g:SuggestBox styleName="gwt-TextBox aon-width-all"
						ui:field="ibanSuggestBox" />
				</td>
			</tr>

			<tr>
				<td class="{style.label}">
					<g:Label text="{msgs.holder}" />
				</td>
				<td class="{style.field}">
					<g:TextBox styleName="gwt-TextBox aon-width-all"
						ui:field="holderTextBox" />
				</td>
			</tr>

			<tr>
				<td class="{style.label}">
					<g:Label text="{msgs.document}" />
				</td>
				<td class="{style.field}">
					<g:TextBox styleName="gwt-TextBox aon-width-all"
						ui:field="documentTextBox" />
				</td>
			</tr>

			<tr>
				<td class="{style.label}">
					<g:Label text="{msgs.documentType}" />
				</td>
				<td class="{style.field}">
					<g:ListBox styleName="aon-selectOneMenu"
						ui:field="documentTypeListBox" >
						<g:item value="1" >{msgs.documentTypeNif}</g:item>
						<g:item value="6" >{msgs.documentTypeNie}</g:item>
						<g:item value="9" >{msgs.documentTypeCif}</g:item>
					</g:ListBox>
				</td>
			</tr>

			<tr>
				<td class="{style.field}" colspan="2">&nbsp;</td>
			</tr>
			<tr>
				<td class="{style.label}" colspan="2">
					<g:Label text="{msgs.selectCccCode}" ui:field="selectLabel" />
				</td>
			</tr>
			<tr>
				<td class="{style.field} aon-width-all" colspan="2">
					<cell:DataGrid ui:field="selectDataGrid" />
				</td>
			</tr>
			<tr>
				<td class="{style.field}" colspan="2">&nbsp;</td>
			</tr>

			<tr>
				<td class="{style.field}" colspan="2">&nbsp;</td>
			</tr>
		</table>

		<div class="{style.buttons} {style.form} ">
			<g:Button ui:field="cancelButton" text="{msgs.cancel}"/>
			<g:Button ui:field="acceptButton" enabled="false" text="{msgs.accept}"/>
			<g:Anchor ui:field="downloadAnchor" visible="false" />
		</div>

	</g:HTMLPanel>


</ui:UiBinder>
