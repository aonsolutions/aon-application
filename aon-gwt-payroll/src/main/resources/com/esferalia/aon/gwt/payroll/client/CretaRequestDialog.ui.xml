<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<ui:UiBinder xmlns:ui='urn:ui:com.google.gwt.uibinder'
	xmlns:g='urn:import:com.google.gwt.user.client.ui' 
	xmlns:aon='urn:import:com.esferalia.aon.gwt.common.client.widget'
	xmlns:cell="urn:import:com.google.gwt.user.cellview.client">

	<ui:Style>
	.form {
		padding: 10px;
	}
	
	.label {
		margin-top: 10x;
		font-weight: bold;
		padding: 1px 0.5em;
		white-space: nowrap;
		background-color: #F2F2F2;
	}
	
	.labeltop {
		margin-top: 10x;
		font-weight: bold;
		padding: 1px 0.5em;
		vertical-align: top;
		white-space: nowrap;
		background-color: #F2F2F2;
	}
	
	.field {
		padding: 1px 0.5em;
	}
	
	.buttons {
		padding-top: 10px;
		text-align: right;
	}
	
	.info {
		
	}
	
	.warn {
		
	}
	
	.error {
	}
	
	.messages {
		padding-left: 20px;
	}

	.nodisplay {
		display: none;
	}
	
	.form textarea {
		resize: none;
	}
	
	.monthListBox-item {
		padding-left: 16px;
	}
	
	.options-scroll-panel>div {
		height: 99%;
	}
	</ui:Style>

	<ui:import field="com.esferalia.aon.gwt.payroll.shared.CretaService.Parameter.*" />

	<g:HTMLPanel styleName="aon-width-all aon-height-all">

		<table class="aon-width-all {style.form} ">
			<tr >
				<td  colspan="2">
					<g:Label styleName="gwt-Label {style.messages} aon-icon-exception"  ui:field="messagesLabel"  />
				</td>
			</tr>
			<tr>
				<td class="{style.label}">
					<g:Label text="Autorizado" />
				</td>
				<td class="{style.field}">
					<g:LongBox  styleName="gwt-TextBox" ui:field="authLongBox"/>
				</td>
			</tr>
			<tr ui:field="monthTR" >
				<td class="{style.label}">
					<g:Label text="Mes" />
				</td>
				<td class="{style.field}">
					<aon:MonthListBox styleName="aon-selectOneMenu"
						ui:field="monthListBox" monthStyles="{style.monthListBox-item}"
						highLightStyles="aon-bold aon-black aon-icon-accept {style.monthListBox-item}"/>
				</td>
			</tr>
			<tr ui:field="fromMonthTR" >
				<td class="{style.label}">
					<g:Label text="Desde" />
				</td>
				<td class="{style.field}">
					<aon:MonthListBox styleName="aon-selectOneMenu"
						ui:field="fromMonthListBox" monthStyles="{style.monthListBox-item}"
						highLightStyles="aon-bold aon-black aon-icon-accept {style.monthListBox-item}"/>
				</td>
			</tr>
			<tr ui:field="toMonthTR" >
				<td class="{style.label}">
					<g:Label text="Hasta" />
				</td>
				<td class="{style.field}">
					<aon:MonthListBox styleName="aon-selectOneMenu"
						ui:field="toMonthListBox" monthStyles="{style.monthListBox-item}"
						highLightStyles="aon-bold aon-black aon-icon-accept {style.monthListBox-item}"/>
				</td>
			</tr>
			<tr ui:field="ctrlMonthTR" >
				<td class="{style.label}">
					<g:Label text="Control" />
				</td>
				<td class="{style.field}">
					<aon:MonthListBox styleName="aon-selectOneMenu"
						ui:field="ctrlMonthListBox" monthStyles="{style.monthListBox-item}"
						highLightStyles="aon-bold aon-black aon-icon-accept {style.monthListBox-item}"/>
					<g:InlineLabel text="Fecha de abono de los salarios para liquidaciones L03 y C03." />
				</td>
			</tr>
			<tr>
				<td class="{style.label}">
					<g:Label text="Tipo de Liquidaci&oacute;n" />
				</td>
				<td class="{style.field}">
					<g:ListBox styleName="aon-selectOneMenu" ui:field="typeListBox" >
						<g:item value="L00">L00 Liquidaci&oacute;n normal en per&iacute;odo reglamentario de ingreso</g:item>	
						<g:item value="L03">L03 Liquidaciones por incremento de salarios con car&aacute;cter retroactivo</g:item>	
						<g:item value="L13">L13 Liquidaciones complementarias por vacaciones retribuidas y no disfrutadas</g:item>	
						<g:item value="L90">L90 Liquidaciones complementarias por incremento de bases</g:item>	
						<g:item value="L91">L91 Liquidaciones complementarias por nuevos tramos y/o trabajadores</g:item>	
					</g:ListBox>
				</td>
			</tr>
			<tr ui:field="i54TR"   >
				<td class="{style.label}">
					<g:Label text="Causa, indicador I 54" />
				</td>
				<td class="{style.field}">
					<g:ListBox styleName="aon-selectOneMenu" ui:field="i54ListBox" >
						<g:item value="1">1- Atrasos de convenio</g:item>	
						<g:item value="2">2- Normativa (disposici&oacute;n legal)</g:item>	
						<g:item value="3">3- Acta de conciliaci&oacute;n</g:item>	
						<g:item value="4">4- Sentencia judicial</g:item>	
						<g:item value="5">5- Cualquier otro t&iacute;tulo leg&iacute;timo</g:item>	
					</g:ListBox>
				</td>
			</tr>
			<tr ui:field="previousBasesTR"  >
				<td class="{style.label}">
					<g:Label text="Aceptar Bases Anteriores" />
				</td>
				<td class="{style.field}" >
					<g:CheckBox  name="{ACEPTAR_BASES_ANTERIORES.name}" ui:field="previousBasesCheckBox" checked="false"/>
				</td>
			</tr>
			<tr ui:field="calcsDetailedTR"  >
				<td class="{style.label}">
					<g:Label text="Calculos Desglosados" />
				</td>
				<td class="{style.field}" >
					<g:CheckBox  name="{CALCULOS_DESGLOSADOS.name}" ui:field="calcsDetailedCheckBox" checked="false"/>
				</td>
			</tr>
			<tr ui:field="reftificationMarkTR"  >
				<td class="{style.label}">
					<g:Label text="Indicador Reftificaci&oacute;n" />
				</td>
				<td class="{style.field}" >
					<g:CheckBox  name="{INDICADOR_RECTIFICACION.name}" ui:field="reftificationMarkCheckBox" checked="false"/>
				</td>
			</tr>
			<tr ui:field="solicitudRecepcionRNTTR"  >
				<td class="{style.label}">
					<g:Label text="Solictud recepci&oacute;n RNT" />
				</td>
				<td class="{style.field}" >
					<g:CheckBox  name="{SOLICITUD_RECEPCION_RNT.name}" ui:field="solicitudRecepcionRNTCheckBox" checked="false"/>
				</td>
			</tr>
			<tr>
				<td class="{style.field}" colspan="2">&nbsp;</td>
			</tr>
			<tr>
				<td class="{style.label}" colspan="2">
					<g:Label text="Selecciona los C&oacute;digo de Cuenta de Cotizaci&oacute;n : " ui:field="selectLabel" />
				</td>
			</tr>
			<tr>
				<td class="{style.field} aon-width-all" colspan="2">
					<cell:DataGrid ui:field="selectDataGrid" />
				</td>
			</tr>
			<tr>
				<td class="{style.field}" colspan="2">&nbsp;</td>
			</tr>

			<!--  tr>
				<td class="{style.field} " colspan="2">
					<div class="aon-group">
						<div>
							<g:RadioButton name="saveRadioButton" ui:field="keepRadioButton"
								checked="true" enabled="false">Conservar n&oacute;minas calculadas</g:RadioButton>
						</div>
						<div>
							<g:RadioButton name="saveRadioButton" ui:field="overwriteRadioButton"
								enabled="false">Eliminar n&oacute;minas calculadas</g:RadioButton>
						</div>
					</div>
				</td>
			</tr-->
			<tr>
				<td class="{style.field}" colspan="2">&nbsp;</td>
			</tr>
		</table>

		<div class="{style.buttons} {style.form} ">
			<g:Button ui:field="cancelButton">Cancelar</g:Button>
			<g:Button ui:field="acceptButton" enabled="false" >Aceptar</g:Button>
			<g:Anchor ui:field="downloadAnchor" visible="false" />
		</div>

	</g:HTMLPanel>


</ui:UiBinder>