<ui:UiBinder
    xmlns:ui='urn:ui:com.google.gwt.uibinder'
	xmlns:g='urn:import:com.google.gwt.user.client.ui'
	xmlns:a='urn:import:com.esferalia.aon.gwt.common.client.widget'>

	<ui:with field='msgs' type='com.esferalia.aon.gwt.payroll.client.i18n.PayrollMessages'/>

    <ui:style type="com.esferalia.aon.gwt.payroll.client.ContractJourneyDialog.MyStyle">

		.width{
			width : 30px;
		}

		.headerLabelStyle{
			font-weight: bold;
		}

		.widthBlank{
			width: 247px;
		}

		.widthTB{
			width: 30px;
		}

		.paddingLabelDays{
			padding-top: 4px;
    		padding-right: 4px;
    		padding-left: 4px;
		}

		.bold{
			font-weight: bolder;
			font-size: 11px;
			padding: 4px;
			text-align: center;
		}

		.margin{
			margin: 10px;
		}

		.hide{
			display: none;
		}

		.backgroudGrey{
			background-color: #e4e4e4;
		}

		.borderTable{
			border-width: 1px;
			border-color: black;
			border-style: groove;
			margin: 10px 10px 5px 10px;
		}

		.margingLeft{
			margin-left: 10px;
		}

		.marginBottom{
			margin-bottom: 10px;
		}

		.headerStyle{
			top: -0.5em;
			font-size: 12px;
			margin-left: 10px;
		}

		.dateWidth{
			width: 100px;
		}

		.buttonsPanel{
			display: flex;
			justify-content: flex-end;
			margin: 5px 10px;
		}

		.styleBorder{
			border-style: solid;
			width: 600px;
			border-width: 1px;
			margin: 10px 10px 5px 10px;
		}

		.gridStyle{
			margin-left: 10px;
		}

		.scrollStyle {
			margin-left: 10px;
			margin-bottom: 10px;
		}

		.clauseTD{}

		.noBonusLB{
			width: 100%;
			text-align: center;
		}

		.minWindth100{
			min-width: 100px;
		}

		.widthAuto{
			width: auto !important;
		}

	</ui:style>

	<g:HTMLPanel styleName="aon-width-all aon-height-all">
		<g:VerticalPanel>
			<g:HTMLPanel ui:field="north" styleName="aon-width-all aon-height-all"></g:HTMLPanel>
			<g:DeckPanel ui:field="mainDeckPanel">
			    <g:VerticalPanel ui:field="newJourneyTable" styleName="{style.widthAuto} {style.borderTable} {style.margingLeft} {style.marginBottom}">
					<g:Label width="105px" styleName="aon-group-title {style.headerStyle}" text="{msgs.newAction}"/>
			    	<g:Grid styleName="{style.margin}">
			    		<g:row class="rich-table-subheader aon-dataTable-header">
				    		<g:customCell>
					    		<g:HorizontalPanel>
					    			<g:Label styleName="{style.bold}" text="{msgs.fromHeader}"/>
					    			<a:DateBoxEx ui:field="startDatePeriod" styleName="rich-calendar-input aon-selectInputDate-inputClass {style.dateWidth}"></a:DateBoxEx>
					    		</g:HorizontalPanel>
				    		</g:customCell>
			    		</g:row>
			    		<g:row>
			    			<g:customCell>
					    		<g:HorizontalPanel>
					    			<g:Label styleName="{style.bold}" text="{msgs.mondayAbbr}"/>
					    			<g:TextBox styleName="aon-inputText {style.widthTB}" ui:field="newMonday"></g:TextBox>
					    			<g:Label styleName="{style.bold}" text="{msgs.tuesdayAbbr}"/>
					    			<g:TextBox styleName="aon-inputText {style.widthTB}" ui:field="newTuesday"></g:TextBox>
					    			<g:Label styleName="{style.bold}" text="{msgs.wednesdayAbbr}"/>
					    			<g:TextBox styleName="aon-inputText {style.widthTB}" ui:field="newWednesday"></g:TextBox>
					    			<g:Label styleName="{style.bold}" text="{msgs.thursdayAbbr}"/>
					    			<g:TextBox styleName="aon-inputText {style.widthTB}" ui:field="newThursday"></g:TextBox>
					    			<g:Label styleName="{style.bold}" text="{msgs.fridayAbbr}"/>
					    			<g:TextBox styleName="aon-inputText {style.widthTB}" ui:field="newFriday"></g:TextBox>
					    			<g:Label styleName="{style.bold}" text="{msgs.saturdayAbbr}"/>
					    			<g:TextBox styleName="aon-inputText {style.widthTB}" ui:field="newSaturday"></g:TextBox>
					    			<g:Label styleName="{style.bold}" text="{msgs.sundayAbbr}"/>
					    			<g:TextBox styleName="aon-inputText {style.widthTB}" ui:field="newSunday"></g:TextBox>
									<g:Button styleName="aon-editDataTable-button aon-icon-accept {style.margingLeft}" ui:field="acceptJourney"></g:Button>
					    		</g:HorizontalPanel>
				    		</g:customCell>
			    		</g:row>
			    	</g:Grid>
			    </g:VerticalPanel>
			    <g:HTMLPanel>
		       	   <g:VerticalPanel ui:field="contractJourneyTable" styleName="{style.styleBorder}">
				    	<g:Label width="105px" styleName='aon-group-title {style.headerStyle}' text="{msgs.journeys}"/>
				    	<g:HTMLPanel>
				    		<g:VerticalPanel>
				    			<g:Grid ui:field="contractJourneyDataTableHeader" styleName="{style.gridStyle}"></g:Grid>
				    			<g:HTMLPanel>
				    				<hr align="left" noshade="noshade" style="margin-bottom: 10px;border-width: 0.5px;margin-left: 10px;"/>
				    			</g:HTMLPanel>
					    		<g:ScrollPanel ui:field="contractJourneyScrollPanel" styleName="{style.scrollStyle}">
					    			<g:DeckPanel ui:field="deckPanel">
					    				<g:Label styleName="{style.noBonusLB}" text="{msgs.noJourneys}"/>
					    				<g:Grid ui:field="contractJourneyDataTable"></g:Grid>
					    			</g:DeckPanel>
					    		</g:ScrollPanel>
				    		</g:VerticalPanel>
				    	</g:HTMLPanel>
					</g:VerticalPanel>
				</g:HTMLPanel>
			</g:DeckPanel>
			<g:HTMLPanel ui:field="buttonsPanel" styleName="{style.buttonsPanel}"></g:HTMLPanel>
		</g:VerticalPanel>
	</g:HTMLPanel>
</ui:UiBinder>
