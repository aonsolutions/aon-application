<ui:UiBinder
    xmlns:ui='urn:ui:com.google.gwt.uibinder'
	xmlns:g='urn:import:com.google.gwt.user.client.ui'
	xmlns:es3='urn:import:com.google.gwt.user.client.ui'
	xmlns:datepicker='urn:import:com.google.gwt.user.datepicker.client'
	xmlns:a='urn:import:com.esferalia.aon.gwt.common.client.widget'>

	<ui:with field='msgs' type='com.esferalia.aon.gwt.payroll.client.i18n.PayrollMessages'/>

    <ui:with field='res'
		type='com.esferalia.aon.gwt.common.client.css.AonResources' />


	<ui:style type="com.esferalia.aon.gwt.payroll.client.EmployeeCalendarUntillDialog.MyStyle">

		.form {
			padding: 10px;
		}

		.dateBox{
			width: 100% !important;
			text-align: center;
			border: solid #808080 1px;
		}

	</ui:style>

	<g:HTMLPanel styleName="{style.form}">

		<g:HTMLPanel styleName="aon-width-all aon-height-all">

			<table class="aon-width-all aon-height-all" style="padding: 5px;">
				<tr>
					<td>
						<g:Label>{msgs.endDateFin}</g:Label>
					</td>
					<td>
						<a:DateBoxEx ui:field="endDateBox" styleName="{style.dateBox}"></a:DateBoxEx>
					</td>
				</tr>
				<tr>
					<td colspan="2" align="right" style="padding-top: 15px;">
						<g:Button ui:field="cancelButton">{msgs.close}</g:Button>
			    		<g:Button ui:field="acceptButton">{msgs.ok}</g:Button>
					</td>
				</tr>
			</table>

		</g:HTMLPanel>

	</g:HTMLPanel>

</ui:UiBinder>
