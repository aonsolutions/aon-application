<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<ui:UiBinder xmlns:ui='urn:ui:com.google.gwt.uibinder'
	xmlns:g='urn:import:com.google.gwt.user.client.ui'
	xmlns:c='urn:import:com.google.gwt.user.cellview.client'
	xmlns:aon='urn:import:com.esferalia.aon.gwt.common.client.widget.solutions'>

	<ui:style type="com.esferalia.aon.gwt.payroll.client.EmployeeContractPayments.MyStyle">

		.cmdBtn{
			background-position: center left;
			background-repeat: no-repeat;
			padding-left: 25px !important;
			background-size: contain;
		}
		
		.container{
			width: 100%;
			min-width: 600px;
		}

	</ui:style>

	<g:DockLayoutPanel unit="PX" ui:field="dockLayoutPanel">
		<g:north size="50">
			<aon:AonToolbar ui:field="toolbar" />
		</g:north>
		<g:center>
			<g:VerticalPanel ui:field="mainContainer" styleName="{style.container}">
				<g:HTMLPanel ui:field="messagePanel" />
				<c:DataGrid ui:field="contractConceptCalcDG" />
			</g:VerticalPanel>
		</g:center>
	</g:DockLayoutPanel>
	
</ui:UiBinder>
