<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<ui:UiBinder xmlns:ui='urn:ui:com.google.gwt.uibinder'
	xmlns:g='urn:import:com.google.gwt.user.client.ui'
	xmlns:c='urn:import:com.google.gwt.user.cellview.client'>

	<ui:style type="com.esferalia.aon.gwt.payroll.client.EmployeeContractPayments.MyStyle">

		.flexColumn{
			display: flex;
			flex-direction: column;
			align-items: center;
			gap: 10px;
		}
		
		.heightAll{
			height: 100%;
		}
		
		.widthAll{
			width: 100%;
		}
		
		.widthAll input{
			width: 100%;
		}
		
		.dateCell {
			width: 100%;
			text-align: center;
		}
		
		.dateCell input {
			width: 100%;
			text-align: center;
		}
		
		.dateCell input::-webkit-input-placeholder {
		    color:#666;
		    content:"dd/mm/yyyy";
		}
		
		.dateCell::-webkit-input-placeholder {
		    color:#666;
		    content:"dd/mm/yyyy";
		}
		
		.cellTypeList{
			width: 180px;
		}
		
		.cellTypeList select{
			width: 180px;
		}
		
	</ui:style>

	<g:DockLayoutPanel unit="PX" ui:field="dockLayoutPanel">
		<g:center>
			<g:HTMLPanel ui:field="mainPanel" styleName="{style.flexColumn} {style.heightAll} {style.widthAll}">
				<c:DataGrid ui:field="contractConceptCalcDG" styleName="{style.heightAll} {style.widthAll}"></c:DataGrid>
			</g:HTMLPanel>
		</g:center>
	</g:DockLayoutPanel>
	
</ui:UiBinder>
