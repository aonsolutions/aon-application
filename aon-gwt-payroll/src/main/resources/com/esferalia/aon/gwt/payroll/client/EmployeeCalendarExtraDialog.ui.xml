<ui:UiBinder 
    xmlns:ui='urn:ui:com.google.gwt.uibinder'
	xmlns:g='urn:import:com.google.gwt.user.client.ui'
	xmlns:es3='urn:import:com.google.gwt.user.client.ui'
	xmlns:datepicker='urn:import:com.google.gwt.user.datepicker.client'
	xmlns:a='urn:import:com.esferalia.aon.gwt.common.client.widget'>

    <ui:with field='res'
		type='com.esferalia.aon.gwt.common.client.css.AonResources' />
    
    
	<ui:style type="com.esferalia.aon.gwt.payroll.client.EmployeeCalendarExtraDialog.MyStyle">

		.paddingLabelStyle{
			padding-left: 7px;
    		padding-top: 2px;
		}

		.paddingLabel2Style{
			padding-left: 7px;
			padding-right: 7px;
    		padding-top: 2px;
		}

		.suggestMonthBoxStyle {
			margin-left: 52px;
			margin-top: 0px;
			font-size: 1em;
		}

		.bottonExpandStyle{
			height: 10px;
    		border: none;
    		padding-top: 15px;
    		margin-left: 5px;
		}

		.paddingBlocks{
			padding-bottom: 15px;
			padding-top: 10px;
		}

		.form {
			padding: 10px;
		}

		.closeButton {
			position: relative;
    		left: 140px;
			border: 1px solid #bbb;
			border-radius: 3px;
			cursor: pointer;
		}

	</ui:style>

	<g:HTMLPanel styleName="{style.form}">

		<g:VerticalPanel>
		    <g:HorizontalPanel styleName="{style.paddingBlocks}">
		    	<g:Label styleName="{style.paddingLabelStyle}">Mes:</g:Label>
		    	<g:SuggestBox ui:field="monthOpt" styleName="{style.suggestMonthBoxStyle}"/>
		    	<g:Button ui:field="expandMonths"/>
		    </g:HorizontalPanel>
		    <g:HorizontalPanel styleName="{style.paddingBlocks}">
		    	<g:Label styleName="{style.paddingLabel2Style}">Horas extras:</g:Label>
		    	<g:DoubleBox ui:field="extraHoursBox"/>
		    </g:HorizontalPanel>
		    <g:HorizontalPanel styleName="{style.paddingBlocks}">
		    	<g:Button styleName="{style.closeButton}" ui:field="cancelButton">Cerrar</g:Button>
		    	<g:Button styleName="{style.closeButton}" ui:field="acceptButton">OK</g:Button>
		    </g:HorizontalPanel>
		</g:VerticalPanel>
			
	</g:HTMLPanel>

</ui:UiBinder>