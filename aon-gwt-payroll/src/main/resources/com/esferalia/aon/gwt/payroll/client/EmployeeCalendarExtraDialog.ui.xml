<ui:UiBinder 
    xmlns:ui='urn:ui:com.google.gwt.uibinder'
	xmlns:g='urn:import:com.google.gwt.user.client.ui'
	xmlns:es3='urn:import:com.google.gwt.user.client.ui'
	xmlns:datepicker='urn:import:com.google.gwt.user.datepicker.client'
	xmlns:a='urn:import:com.esferalia.aon.gwt.common.client.widget'>

    <ui:with field='res'
		type='com.esferalia.aon.gwt.common.client.css.AonResources' />
    
    
	<ui:style type="com.esferalia.aon.gwt.payroll.client.EmployeeCalendarExtraDialog.MyStyle">

		.form {
			padding: 10px;
		}
		
		.bottonExpandStyle{
			height: 10px;
    		border: none;
    		padding-top: 15px;
    		margin-left: 5px;
    		width: 20px;
		}
		
		.borderBx{
			border: solid #808080 1px;
		}

	</ui:style>

	<g:HTMLPanel styleName="{style.form}">
	
		<g:HTMLPanel styleName="aon-width-all aon-height-all">
	
			<table class="aon-width-all aon-height-all" style="padding: 5px;">
				<tr>
					<td>
						<g:Label>Mes:</g:Label>
					</td>
					<td>
						<g:HorizontalPanel>
							<g:SuggestBox ui:field="monthOpt" styleName="{style.borderBx}"/>
		    				<g:Button ui:field="expandMonths" styleName="{style.bottonExpandStyle}"/>
						</g:HorizontalPanel>
					</td>
				</tr>
				<tr>
					<td>
						<g:Label>Horas extras:</g:Label>
					</td>
					<td>
						<g:DoubleBox ui:field="extraHoursBox" styleName="{style.borderBx}"/>
					</td>
				</tr>
				<tr>
					<td colspan="2" align="right" style="padding-top: 15px;">
						<g:Button ui:field="cancelButton">Cerrar</g:Button>
			    		<g:Button ui:field="acceptButton">OK</g:Button>
					</td>
				</tr>
			</table>
				
		</g:HTMLPanel>
		
	</g:HTMLPanel>

</ui:UiBinder>