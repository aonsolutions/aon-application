<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
	xmlns:g='urn:import:com.google.gwt.user.client.ui'
	xmlns:c='urn:import:com.google.gwt.user.cellview.client'
	xmlns:p="urn:import:net.aonsolutions.gwt.pdfjs.client"	
	xmlns:w='urn:import:com.esferalia.aon.gwt.common.client.widget'
	xmlns:aon='urn:import:com.esferalia.aon.gwt.common.client.widget.solutions'>

	<ui:with field='res' type='com.esferalia.aon.gwt.common.client.css.AonResources'/>

	<ui:style type="com.esferalia.aon.gwt.payroll.client.AgreementSalaryTableTab.MyStyle">
		
		.flexColumn{
			display: flex;
			flex-direction: column;
			gap: 1rem;
		}
		
		.container {
			padding: .5rem 2rem;
		}
		
		.flex {
			display: flex;
			gap: 1rem;
			align-items: center;
		}
		
		.inputTitle {
			min-width: 7rem; 
			font-weight: bold;
			text-transform: uppercase;
			font-size: 1.1em;
		}
		
		.gridTitle{
			text-transform: uppercase;
			font-weight: bold;
		}
		
		.textCenter {
			text-align: center;
		}
		
		.gridCell{
			text-transform: uppercase;
			text-align: center;
			width: 120px;
		}
		
		.cellWidth {
			width: 120px;
		}
		
		.headerSticky {
			background-color: #eee;
			position: sticky;
			top: 0;
			height: 1.5rem;
		}
		
		.headerFSize{
			font-size: .8em;
		}
		
		.levelHeaderSticky {
			position: sticky;
			left: 0;
			background-color: #eee;
		}
		
		.levelSticky {
			background-color: white;
			position: sticky;
			left: 0;
		}
		
		.deleteHeaderSticky {
			position: sticky;
			right: 0;
			background-color: #eee;
		}
		
		.deleteSticky {
			background-color: white;
			position: sticky;
			right: 0;
		}
		
		.flexCenter {
			display: flex;
			justify-content: center;
		}
		
		.headerColor {
			background-color: #eee;
		}
		
		.borderCollapse {
			border-collapse: collapse;
		}
		
		.message {
			font-weight: bold;
			margin-top: 2rem;
		}
		
		.columnBorder {
			border: 1px solid #eee;
			border-bottom: none;
		}
		
		.datePickerPanel{
			border: none !important;
    		box-shadow: none !important;
		}
		
		.heigthAll {height: 100%;}
		.widthAll {width: 100%;}
		.scrollPanel {margin: 0 1rem;}
		
	</ui:style>
	
	<g:HTMLPanel styleName="{style.flexColumn} {style.heigthAll}">
		<g:HTMLPanel ui:field="messagePanel" />
		<aon:AonToolbar ui:field="toolbar" />
		<g:ScrollPanel ui:field="salaryScrollPanel" styleName="{style.scrollPanel}">
			<g:Grid ui:field="salaryGrid" styleName="{style.borderCollapse}" />
		</g:ScrollPanel>
		<g:HTMLPanel ui:field="agreementSalaryTableMessage" styleName="{style.flexCenter}">
			<g:Label text="DEBE CREAR UN TRAMO PARA VISUALIZAR LA TABLA SALARIAL (+)" styleName="{style.message}" />
		</g:HTMLPanel>
		<g:HTMLPanel ui:field="agreementLevelMessage" styleName="{style.flexCenter}">
			<g:Label text="DEBE CREAR UN NIVEL PARA VISUALIZAR LA TABLA (+)" styleName="{style.message}" />
		</g:HTMLPanel>
	</g:HTMLPanel>
</ui:UiBinder> 

