<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
	xmlns:g='urn:import:com.google.gwt.user.client.ui'
	xmlns:c='urn:import:com.google.gwt.user.cellview.client'
	xmlns:p="urn:import:net.aonsolutions.gwt.pdfjs.client"	
	xmlns:w='urn:import:com.esferalia.aon.gwt.common.client.widget'
	xmlns:aon='urn:import:com.esferalia.aon.gwt.common.client.widget.solutions'>

	<ui:with field='res' type='com.esferalia.aon.gwt.common.client.css.AonResources'/>

	<ui:style type="com.esferalia.aon.gwt.payroll.client.AgreementSalaryTableTab.MyStyle">
		
		.borderCollapse {
			border-collapse: collapse;
		}
		
		.flexCenter {
			display: flex;
			justify-content: center;
		}
		
		.flexColumn{
			display: flex;
			flex-direction: column;
			gap: 1rem;
		}
		
		.heigthAll {
			height: 100%;
		}
		
		.message {
			font-weight: bold;
			margin-top: 2rem;
		}
		
		.scrollPanel {
			margin: 0 1rem;
		}
		
		/* Class AgreementSalaryTableTab.Style */
		
		.cellWidth {
			width: 120px;
		}
		
		.columnBorder {
			border: 1px solid #eee;
			border-bottom: none;
		}
		
		.datePickerPanel{
			border: none !important;
    		box-shadow: none !important;
    		z-index: 6;
		}
		
		.deleteFixed {
			position: sticky;
			right: 0;
			z-index: 2;
			font-size: .7rem;
			background-color: white;
		}
		
		.gridCell{
			text-transform: uppercase;
			text-align: center;
			width: 120px;
		}
		
		.gridTitle{
			text-transform: uppercase;
			font-weight: bold;
		}
		
		.headerDeleteFixed {
			z-index: 5;
			position: sticky;
			top: 0;
			right: 0;
			height: 1.5rem;
			font-size: .7rem;
			background-color: #eee;
		}
		
		.headerFixed {
			position: sticky;
  			top: 0;
  			height: 1.5rem;
			font-size: .7rem;
			background-color: #eee;
			max-width: 120px;
		}
		
		.headerFSize{
			font-size: .8em;
		}
		
		.headerLevelFixed {
			z-index: 5;
			position: sticky;
			top: 0;
			left: 0;
			height: 1.5rem;
			font-size: .7rem;
			background-color: #eee;
		}

		.levelFixed {
			position: sticky;
			left: 0;
			z-index: 2;
			font-size: .7rem;
			background-color: white;
		}
		
		.oddRow {
			background-color: #f8f7f7;
		}
		
		.textCenter {
			text-align: center;
		}
		
		.widthAll {
			width: 100%;
		}
		
	</ui:style>
	
	<g:HTMLPanel styleName="{style.flexColumn} {style.heigthAll}">
		<g:HTMLPanel ui:field="messagePanel" />
		<aon:AonToolbar ui:field="toolbar" />
		<g:ScrollPanel ui:field="salaryScrollPanel" styleName="{style.scrollPanel}">
			<g:Grid ui:field="salaryGrid" styleName="{style.borderCollapse}" />
		</g:ScrollPanel>
		<g:HTMLPanel ui:field="agreementSalaryTableMessage" styleName="{style.flexCenter}">
			<g:Label text="DEBE CREAR UN TRAMO PARA VISUALIZAR LA TABLA SALARIAL (+)" styleName="{style.message}" />
		</g:HTMLPanel>
	</g:HTMLPanel>
</ui:UiBinder> 

