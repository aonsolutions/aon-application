<ui:UiBinder
    xmlns:ui='urn:ui:com.google.gwt.uibinder'
	xmlns:g='urn:import:com.google.gwt.user.client.ui'
	xmlns:a='urn:import:com.esferalia.aon.gwt.common.client.widget'
	xmlns:p='urn:import:com.esferalia.aon.gwt.payroll.client'>

    <ui:with field='msgs' type='com.esferalia.aon.gwt.payroll.client.i18n.PayrollMessages'/>

	<ui:style type="com.esferalia.aon.gwt.payroll.client.AgreementSuggestPaymentDialog.MyStyle">
	
		.button {
			background-size: 24px !important;
			background-attachment: scroll;
			background-clip: border-box;
			background-color: inherit;
			background-position: 1px -2px;
			background-repeat: no-repeat;
			background-size: auto auto;
			border: 1px solid #aaa;
			cursor: pointer;
			height: 24px;
			overflow: visible;
			padding-left: 25px;
			text-align: left;
			text-transform: uppercase;
			width: auto;
		}
	
		.form {
			padding: 10px;
			display: flex;
			flex-direction: column;
			min-width: 400px;
			gap: .5rem;
		}
		
		.center {
			text-align: center;
		}
		
		.buttonsPanel{
			display: flex;
			justify-content: flex-end;
			margin-top: 10px;
			gap: .5rem;
		}
		
		.element{
			display: flex;
			flex-direction: column;
			gap: .2em;
		}
		
		.title{
			font-weight: bold;
		}
		
		.inputHeight { height: 1.5rem; }
		
		.widthAll { width: 100%; }
		
		.dialogGlass {
			z-index: 7;
			background-color: #000;
			opacity: 0.2;
			filter: opacity(45%);
		}
		
		.dialogZIndex {
			z-index: 8;
		}
		
	</ui:style>

	<g:HTMLPanel styleName="{style.form}">

		<g:HTMLPanel ui:field="messagePanel" />
		
		<g:HTMLPanel styleName="{style.element}">
			<g:Label styleName="{style.title}">{msgs.concept}</g:Label>
			<g:Label text="{msgs.selectSuggestedAccrual}" />
			<g:HTMLPanel ui:field="suggestPanel" styleName="{style.center}" />
		</g:HTMLPanel>
		
		<g:HTMLPanel styleName="{style.element}">
			<g:Label styleName="{style.title}">{msgs.code}</g:Label>
			<g:TextBox ui:field="paymentCodeTB" styleName="{style.inputHeight}"/>
		</g:HTMLPanel>
		
		<g:HTMLPanel styleName="{style.element}">
			<g:Label styleName="{style.title}">{msgs.type}</g:Label>
			<g:HTMLPanel ui:field="paymentTypePanel" styleName="{style.widthAll}"/>
		</g:HTMLPanel>
		<g:HTMLPanel styleName="{style.element}">
			<g:Label styleName="{style.title}">{msgs.description}</g:Label>
			<g:TextBox ui:field="paymentDescriptionTB" styleName="{style.inputHeight}"/>
		</g:HTMLPanel>
		<g:HTMLPanel styleName="{style.element}">
			<g:Label styleName="{style.title}">{msgs.expression}</g:Label>
			<p:ExpressionCodeArea visibleLines="3" ui:field="paymentExpressionTB"/>
		</g:HTMLPanel>
		<g:HTMLPanel styleName="{style.element}">
			<g:Label styleName="{style.title}">{msgs.salaryReceiptType}</g:Label>
			<g:ListBox ui:field="paymentSalaryTypeLB"/>
		</g:HTMLPanel>

	   	<g:HTMLPanel ui:field="buttonsPanel" styleName="{style.buttonsPanel}" />

	</g:HTMLPanel>

</ui:UiBinder>