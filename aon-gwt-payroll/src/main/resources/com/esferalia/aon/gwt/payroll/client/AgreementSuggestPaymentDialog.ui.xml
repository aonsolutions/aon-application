<ui:UiBinder 
    xmlns:ui='urn:ui:com.google.gwt.uibinder'
	xmlns:g='urn:import:com.google.gwt.user.client.ui'
	xmlns:a='urn:import:com.esferalia.aon.gwt.common.client.widget'>
    
    
	<ui:style type="com.esferalia.aon.gwt.payroll.client.AgreementSuggestPaymentDialog.MyStyle">
	
		.button {
			background-size: 24px !important;
			background-attachment: scroll;
			background-clip: border-box;
			background-color: inherit;
			background-position: 1px -2px;
			background-repeat: no-repeat;
			background-size: auto auto;
			border: 1px solid #aaa;
			cursor: pointer;
			height: 24px;
			overflow: visible;
			padding-left: 25px;
			text-align: left;
			text-transform: uppercase;
			width: auto;
		}
	
		.form {
			padding: 10px;
			display: flex;
			flex-direction: column;
			min-width: 400px;
		}
		
		.center {
			text-align: center;
		}
		
		.buttonsPanel{
			display: flex;
			justify-content: flex-end;
			margin-top: 10px;
			gap: .5rem;
		}
		
	</ui:style>

	<g:HTMLPanel styleName="{style.form}">

		<g:HTMLPanel ui:field="messagePanel" />

		<g:Label text="Seleccione un devengo sugerido para importarlo. O use el modo manual." />
		<g:HTMLPanel ui:field="suggestPanel" styleName="{style.center}" />
	    
	   	<g:HTMLPanel ui:field="buttonsPanel" styleName="{style.buttonsPanel}" />

	</g:HTMLPanel>

</ui:UiBinder>