<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
	xmlns:g='urn:import:com.google.gwt.user.client.ui' xmlns:a='urn:import:com.esferalia.aon.gwt.common.client.widget'>

	<ui:style type='com.esferalia.aon.gwt.payroll.client.CalendarDraft.Style'>
	.disclosure-panel {
		border-left: hidden;
		margin-left: 0px;
		padding: 4px 0 4px 8px;
	}
	
	.year {
		font-size: 55px;
		color: #FF704D;
		padding-left: 35px;
		padding-top: 2px;
	}
	
	.legend {
		margin-top: 5px;
		margin-left: auto;
		margin-right: auto;
		margin-bottom: 15px;
	}
	
	.legend-icon {
		height: 15px;
		width: 15px;
		border-radius: 20px;
	}
	
	.legend-caption {
		margin-top: 10px;
		margin-left: 6px;
		margin-right: 16px;
		margin-bottom: 10px;
	}
	
	.typeHoliday {
		font: bold 90% Verdana;
	}
	
	.month {
		font: bold 90% Tahoma;
		margin-left: 5px;
		padding-top: 10px;
	}
	
	.holiday {
		font: italic 90% Georgia Arial Tahoma;
		margin-left: 5px;
		margin-top: 5px;
	}
	
	.statal {
		background-color: #FFB2B2;
	}
	
	.autonomic {
		background-color: #99C2FF;
	}
	
	.local {
		background-color: #B2FFB2;
	}
	
	.other {
		background-color: #E6CCFF;
	}
	</ui:style>

	<g:HTMLPanel>

		<g:DockLayoutPanel unit="PX" ui:field="mainPanel">
			<g:north size="55">

				<g:FlowPanel>

					<!--g:MenuBar>
						<g:MenuItem text="Archivo">
							<g:MenuBar vertical="true">
								<g:MenuItem styleName="gwt-MenuItem aon-icon-new"
									ui:field="newCalendarMenuItem" text="Nuevo" />
								<g:MenuItem styleName="gwt-MenuItemSeparator">
									<div class="menuSeparatorInner"></div>
								</g:MenuItem>
								<g:MenuItem styleName="gwt-MenuItem aon-icon-save"
									ui:field="saveMenuItem" text="Guardar" />
								<g:MenuItem styleName="gwt-MenuItem aon-icon-google-drive"
									ui:field="publishMenuItem" text="Publicar..." />
								<g:MenuItem styleName="gwt-MenuItem aon-icon-pdf"
									ui:field="printMenuItem" text="Imprimir..." />
							</g:MenuBar>
						</g:MenuItem>
						<g:MenuItem text="Edici&oacute;n">
							<g:MenuBar vertical="true">
								<g:MenuItem styleName="gwt-MenuItem aon-icon-undo"
									ui:field="undoMenuItem" text="Deshacer" />
								<g:MenuItem styleName="gwt-MenuItem aon-icon-redo"
									ui:field="redoMenuItem" text="Rehacer" />
							</g:MenuBar>
						</g:MenuItem>
						<g:MenuItem text="Gesti&oacute;n">
							<g:MenuBar vertical="true">
								<g:MenuItem styleName="gwt-MenuItem aon-icon-task"
									ui:field="addEventMenuItem" text="Añadir..." />
							</g:MenuBar>
						</g:MenuItem>
					</g:MenuBar -->
					<!--g:FlowPanel styleName="aon-finding-title-toolbar" -->
					<g:FlowPanel styleName="gwt-MenuBar-horizontal">
						<g:HorizontalPanel>
							<g:HTMLPanel styleName="aon-finding-title">
								<g:HTMLPanel styleName="aon-finding-title-internal">
									<g:Label styleName="aon-outputText">Calendario Laboral</g:Label>
								</g:HTMLPanel>
							</g:HTMLPanel>

							<g:HTMLPanel styleName="aon-finding-subtitle">
								<g:HTMLPanel styleName="aon-finding-subtitle-internal">
									<g:ListBox ui:field="yearList" />
								</g:HTMLPanel>
							</g:HTMLPanel>

							<g:HTMLPanel styleName="aon-finding-subtitle">
								<g:HTMLPanel styleName="aon-finding-subtitle-internal">
									<g:ListBox ui:field="holidayList" enabled="false" />
								</g:HTMLPanel>
							</g:HTMLPanel>

							<g:HorizontalPanel styleName="aon-finding-toolbar">
								<g:HTMLPanel styleName="aon-finding-toolbar-item-group">
									<g:Button ui:field='addEvent'
										styleName='aon-finding-toolbar-item aon-icon-task' text="Añadir Festivo" enabled="false" />
									<g:Button ui:field='addCalendar'
										styleName='aon-finding-toolbar-item aon-icon-save' text="Guardar" enabled="false" />
										
								</g:HTMLPanel>
							</g:HorizontalPanel>
						</g:HorizontalPanel>
					</g:FlowPanel>
				</g:FlowPanel>
			</g:north>
			<g:north size="72">
				<g:FlowPanel>
					<g:Label styleName="{style.year}"> 2015 </g:Label>
				</g:FlowPanel>
			</g:north>
			<g:center>
				<g:ScrollPanel ui:field="scrollPanel">
					<g:SimplePanel ui:field="calendarPanel" />
				</g:ScrollPanel>
			</g:center>
			<g:east size="172">
				<g:ScrollPanel>
					<g:VerticalPanel ui:field="legendVerticalPanel"
						styleName="{style.legend}" />
				</g:ScrollPanel>
			</g:east>
		</g:DockLayoutPanel>
	</g:HTMLPanel>
</ui:UiBinder> 