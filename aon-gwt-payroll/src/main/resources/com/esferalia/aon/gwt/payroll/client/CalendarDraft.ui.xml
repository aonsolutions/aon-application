<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
	xmlns:g='urn:import:com.google.gwt.user.client.ui' xmlns:a='urn:import:com.esferalia.aon.gwt.common.client.widget'>

	<ui:style type='com.esferalia.aon.gwt.payroll.client.CalendarDraft.Style'>
	.disclosure-panel {
		border-left: hidden;
		margin-left: 0px;
		padding: 4px 0 4px 8px;
	}
	
	.optionButtons {
		cursor: pointer;
		background-color: transparent;
		font-size: 1rem;
		color: #757575;
		border: .01rem solid #757575;
		border-radius: 10%;
		margin: .7rem 0;
	}
	
	.year {
		font-size: 30px;
		color: #FF704D;
		padding-left: 28px;
		padding-top: 2px;
	}
	
	.legend {
		margin-top: 5px;
		margin-left: auto;
		margin-right: auto;
		margin-bottom: 15px;
	}
	
	.legend-icon {
		height: 15px;
		width: 15px;
		border-radius: 20px;
	}
	
	.legend-caption {
		margin-top: 10px;
		margin-right: 16px;
		margin-bottom: 10px;
		margin-left: 5px;
	}
	
	.typeHoliday {
		font: bold 90% Verdana;
		color: black;
	}
	
	.month {
		font: bold 90% Tahoma;
		margin-left: 5px;
		padding-top: 10px;
	}
	
	.holiday {
		font: 90% Verdana;
		margin-left: 5px;
		margin-top: 5px;
	}
	
	.statal {
		background-color: #FFB2B2;
	}
	
	.autonomic {
		background-color: #99C2FF;
	}
	
	.local {
		background-color: #B2FFB2;
	}
	
	.other {
		background-color: #E6CCFF;
	}

	.not-work {
		background-color: #FF7800;
	}
	
	.container{
		margin-top: 50px;
		display: flex;
		justify-content: center;
		width: 100%;
	}
	
	.mt-50{
		margin-top: 50px;
		background-color: transparent !important;
	}
	
	.cmd_btn{
		background-position: center left;
		background-repeat: no-repeat;
		padding-left: 25px !important;
		background-size: contain;
	}

	</ui:style>

	<g:DockLayoutPanel unit="PX" ui:field="mainPanel">
		<g:center>
			<g:DockLayoutPanel unit="PX" ui:field="centerPanel">
				<g:center>
					<g:ScrollPanel ui:field="scrollPanel" styleName="{style.container}">
						<g:SimplePanel ui:field="calendarPanel" />
					</g:ScrollPanel>	
				</g:center>
				<g:east size="190">
					<g:VerticalPanel ui:field="leyend" styleName="{style.mt-50}">
						<g:Grid>
							<g:row>
								<g:customCell>
									<g:Label styleName="{style.year}" ui:field="yearLabel" />
								</g:customCell>
								<g:customCell>
									<g:Button styleName="{style.optionButtons}" ui:field="lastYearButton"> &#60; </g:Button>
								</g:customCell>
								<g:customCell>
									<g:Button styleName="{style.optionButtons}" ui:field="nextYearButton"> &#62; </g:Button>
								</g:customCell>
							</g:row>
						</g:Grid>
		
						<g:ScrollPanel>
							<g:VerticalPanel ui:field="legendVerticalPanel" styleName="{style.legend}" />
						</g:ScrollPanel>
		
					</g:VerticalPanel>
				</g:east>
			</g:DockLayoutPanel>
			
		</g:center>
	</g:DockLayoutPanel>

</ui:UiBinder> 