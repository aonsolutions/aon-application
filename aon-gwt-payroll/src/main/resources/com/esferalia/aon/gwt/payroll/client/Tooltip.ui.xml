<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
	xmlns:g="urn:import:com.google.gwt.user.client.ui"
	xmlns:es3='urn:import:com.google.gwt.user.client.ui'
	xmlns:datepicker='urn:import:com.google.gwt.user.datepicker.client'>

	<ui:with field='msgs' type='com.esferalia.aon.gwt.payroll.client.i18n.PayrollMessages'/>

	<ui:style type='com.esferalia.aon.gwt.payroll.client.Tooltip.Style'>

		.legend-icon {
			width: 13px;
			height: 13px;
		}

		.buttons {
			padding-top: 10px;
			text-align: right;
		}
		
		.padding-left{
			padding-left: 16px;
		}

	</ui:style>

	<g:HTMLPanel ui:field="principal">

		<g:InlineLabel styleName="aon-bold aon-icon-employee aon-icon-commandButton"
			ui:field="fullNameLabel"></g:InlineLabel>
		<br></br>
		<g:InlineLabel ui:field="dniLabel" styleName="aon-icon-card"
			title="Número Documento Nacional de Identidad"></g:InlineLabel>
		<g:InlineLabel> - </g:InlineLabel>
		<g:InlineLabel styleName="{style.padding-left} aon-icon-segsocial-small"
			ui:field="socialSecurityNum" title="Número de Afiliación a la Seguridad Social"></g:InlineLabel>
		<br></br>
		<table>
			<tbody>
				<tr>
					<td>
						<g:HTML ui:field="iconStatusLabel" />
					</td>
					<td>
						<g:InlineLabel ui:field="statusLabel"></g:InlineLabel>
					</td>
					<td>
						<g:InlineLabel>-</g:InlineLabel>
						<g:InlineLabel styleName="aon-bold" ui:field="numDaysLabel"></g:InlineLabel>
						<g:InlineLabel ui:field="daysLabel"></g:InlineLabel>
					</td>
				</tr>
			</tbody>
		</table>
		<g:InlineLabel styleName="aon-bold" ui:field="workPeriodLabel"></g:InlineLabel>

		<table>
			<tr>
				<td>
					<g:Label styleName="aon-bold" ui:field="baja" text="{msgs.bajaColon}"/>
				</td>
				<td>
					<g:InlineLabel ui:field="startDateLabel"></g:InlineLabel>
				</td>
				<td>
					<datepicker:DateBox ui:field="startLeaveDateBox" />
					<g:Label ui:field="startDate"></g:Label>
				</td>
				<td>
					<g:InlineLabel ui:field="causeStartLabel" text="{msgs.reason}"/>
				</td>
				<td>
					<g:ListBox width="10em" ui:field='typeLeaveListBox' />
					<g:Label ui:field="typeLeave"></g:Label>
				</td>
			</tr>
			<tr>
				<td>
					<g:Label styleName="aon-bold" ui:field="alta" text="{msgs.altaColon}"/>
				</td>
				<td>
					<g:InlineLabel ui:field="endDateLabel"></g:InlineLabel>
				</td>
				<td>
					<datepicker:DateBox ui:field="endDateBox" />
					<g:Label ui:field="endDate"></g:Label>
					
				</td>
				<td>
					<g:InlineLabel ui:field="causeEndLabel" text="{msgs.reason}"/>
				</td>
				<td>
					<g:ListBox width="10em" ui:field='typeDischargeListBox' />
					<g:Label ui:field="typeDischarge"></g:Label>				
				</td>
			</tr>
			<tr>
				<td colspan="6" align="right">
				    <br></br>
					<div styleName="{style.buttons}">
						<g:Button ui:field="acceptButton" text="{msgs.accept}"/>
					</div>
				</td>
			</tr>
		</table>

	</g:HTMLPanel>
</ui:UiBinder> 