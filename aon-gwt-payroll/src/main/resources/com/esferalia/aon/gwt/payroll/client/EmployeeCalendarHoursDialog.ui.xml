<ui:UiBinder 
    xmlns:ui='urn:ui:com.google.gwt.uibinder'
	xmlns:g='urn:import:com.google.gwt.user.client.ui'
	xmlns:es3='urn:import:com.google.gwt.user.client.ui'
	xmlns:datepicker='urn:import:com.google.gwt.user.datepicker.client'
	xmlns:a='urn:import:com.esferalia.aon.gwt.common.client.widget'>

    <ui:with field='res'
		type='com.esferalia.aon.gwt.common.client.css.AonResources' />
    
    
	<ui:style type="com.esferalia.aon.gwt.payroll.client.EmployeeCalendarHoursDialog.MyStyle">
	
		.form {
			padding: 10px;
		}
		
		.bottonExpandStyle{
			height: 10px;
    		border: none;
    		padding-top: 15px;
    		margin-left: 5px;
    		width: 20px;
		}
		
		.borderBx{
			border: solid #808080 1px;
			text-align: center;
			width: 100px;
		}
		
		.bottonExpandStyle{
			height: 10px;
    		border: none;
    		padding-top: 15px;
    		margin-left: 5px;
		}

	</ui:style>

	<g:HTMLPanel styleName="{style.form}">

		<g:HTMLPanel styleName="aon-width-all aon-height-all">
	
			<table class="aon-width-all aon-height-all" style="padding: 5px;">
				<tr ui:field="mondayBlock">
					<td>
						<g:Label>Lunes:</g:Label>
					</td>
					<td>
						<g:HorizontalPanel>
							<g:SuggestBox ui:field="mondayHoursOpt" styleName="{style.borderBx}"/>
		    				<g:Button ui:field="expandMondayHours" styleName="{style.bottonExpandStyle}"/>
						</g:HorizontalPanel>
					</td>
				</tr>
				<tr ui:field="tuesdayBlock">
					<td>
						<g:Label>Martes:</g:Label>
					</td>
					<td>
						<g:HorizontalPanel>
							<g:SuggestBox ui:field="tuesdayHoursOpt" styleName="{style.borderBx}"/>
		    				<g:Button ui:field="expandTuesdayHours" styleName="{style.bottonExpandStyle}"/>
						</g:HorizontalPanel>
					</td>
				</tr>
				<tr ui:field="wednesdayBlock">
					<td>
						<g:Label>Miércoles:</g:Label>
					</td>
					<td>
						<g:HorizontalPanel>
							<g:SuggestBox ui:field="wednesdayHoursOpt" styleName="{style.borderBx}"/>
		    				<g:Button ui:field="expandWednesdayHours" styleName="{style.bottonExpandStyle}"/>
						</g:HorizontalPanel>
					</td>
				</tr>
				<tr ui:field="thursdayBlock">
					<td>
						<g:Label>Jueves:</g:Label>
					</td>
					<td>
						<g:HorizontalPanel>
							<g:SuggestBox ui:field="thursdayHoursOpt" styleName="{style.borderBx}"/>
		    				<g:Button ui:field="expandThursdayHours" styleName="{style.bottonExpandStyle}"/>
						</g:HorizontalPanel>
					</td>
				</tr>
				<tr ui:field="fridayBlock">
					<td>
						<g:Label>Viernes:</g:Label>
					</td>
					<td>
						<g:HorizontalPanel>
							<g:SuggestBox ui:field="fridayHoursOpt" styleName="{style.borderBx}"/>
		    				<g:Button ui:field="expandFridayHours" styleName="{style.bottonExpandStyle}"/>
						</g:HorizontalPanel>
					</td>
				</tr>
				<tr ui:field="saturdayBlock">
					<td>
						<g:Label>Sábado:</g:Label>
					</td>
					<td>
						<g:HorizontalPanel>
							<g:SuggestBox ui:field="saturdayHoursOpt" styleName="{style.borderBx}"/>
		    				<g:Button ui:field="expandSaturdayHours" styleName="{style.bottonExpandStyle}"/>
						</g:HorizontalPanel>
					</td>
				</tr>
				<tr ui:field="sundayBlock">
					<td>
						<g:Label>Domingo:</g:Label>
					</td>
					<td>
						<g:HorizontalPanel>
							<g:SuggestBox ui:field="sundayHoursOpt" styleName="{style.borderBx}"/>
		    				<g:Button ui:field="expandSundayHours" styleName="{style.bottonExpandStyle}"/>
						</g:HorizontalPanel>
					</td>
				</tr>
				<tr>
					<td colspan="2" align="right" style="padding-top: 15px;">
						<g:Button ui:field="cancelButton">Cerrar</g:Button>
			    		<g:Button ui:field="acceptButton">OK</g:Button>
					</td>
				</tr>
			</table>
				
		</g:HTMLPanel>
		
	</g:HTMLPanel>

</ui:UiBinder>