<ui:UiBinder
    xmlns:ui='urn:ui:com.google.gwt.uibinder'
	xmlns:g='urn:import:com.google.gwt.user.client.ui'
	xmlns:a='urn:import:com.esferalia.aon.gwt.common.client.widget'>

	<ui:with field='msgs' type='com.esferalia.aon.gwt.payroll.client.i18n.PayrollMessages'/>

    <ui:style>

		.form {
			padding: 10px;
		}

		.datesPanel{
			display: flex;
			flex-direction: column;
			padding: 5px;
			border: 1px solid #e1e1e1;
			margin-bottom: 10px;
		}

		.dateBox{
			text-align: center;
		}

		.rowPanel{
			display: flex;
			justify-content: space-between;
			margin: 3px 0;
		}

		.hoursPanel{
			display: flex;
			flex-direction: column;
			border: 1px solid #e1e1e1;
			padding: 5px;
			margin: 10px 0;
		}

		.buttonsPanel{
			display: flex;
			justify-content: flex-end;
			gap: .5rem;
		}

		.labelStyle{
			width: 60px;
			display: flex;
			align-items: center;
		}

		.borderBx{
			border: solid #808080 1px;
			text-align: center;
			width: 50px;
		}

		.infoPanel{
			color: blue;
			padding: 0px 5px 8px 5px;
		}

	</ui:style>

	<g:HTMLPanel styleName="{style.form}">

		<g:HTMLPanel styleName="aon-width-all aon-height-all">

			<g:HTMLPanel styleName="{style.datesPanel}">

				<g:HTMLPanel styleName="{style.rowPanel}">
					<g:Label text="{msgs.startDateColon}"/>
					<a:DateBoxEx ui:field="startDateDB" styleName="{style.dateBox}"></a:DateBoxEx>
				</g:HTMLPanel>

				<g:HTMLPanel styleName="{style.rowPanel}">
					<g:Label text="{msgs.endDateColon}"/>
					<a:DateBoxEx ui:field="endDateDB" styleName="{style.dateBox}"></a:DateBoxEx>
				</g:HTMLPanel>

			</g:HTMLPanel>

			<g:HTMLPanel styleName="{style.hoursPanel}">
				<g:HTMLPanel ui:field="mondayBlock" styleName="{style.rowPanel}">
					<g:Label styleName="{style.labelStyle}" text="{msgs.mondayColon}"/>
					<g:TextBox ui:field="mondayHoursOpt" styleName="{style.borderBx}"/>
				</g:HTMLPanel>

				<g:HTMLPanel ui:field="tuesdayBlock" styleName="{style.rowPanel}">
					<g:Label styleName="{style.labelStyle}" text="{msgs.tuesdayColon}"/>
					<g:TextBox ui:field="tuesdayHoursOpt" styleName="{style.borderBx}"/>
				</g:HTMLPanel>

				<g:HTMLPanel ui:field="wednesdayBlock" styleName="{style.rowPanel}">
					<g:Label styleName="{style.labelStyle}" text="{msgs.wednesdayColon}"/>
					<g:TextBox ui:field="wednesdayHoursOpt" styleName="{style.borderBx}"/>
				</g:HTMLPanel>

				<g:HTMLPanel ui:field="thursdayBlock" styleName="{style.rowPanel}">
					<g:Label styleName="{style.labelStyle}" text="{msgs.thursdayColon}"/>
					<g:TextBox ui:field="thursdayHoursOpt" styleName="{style.borderBx}"/>
				</g:HTMLPanel>

				<g:HTMLPanel ui:field="fridayBlock" styleName="{style.rowPanel}">
					<g:Label styleName="{style.labelStyle}" text="{msgs.fridayColon}"/>
					<g:TextBox ui:field="fridayHoursOpt" styleName="{style.borderBx}"/>
				</g:HTMLPanel>

				<g:HTMLPanel ui:field="saturdayBlock" styleName="{style.rowPanel}">
					<g:Label styleName="{style.labelStyle}" text="{msgs.saturdayColon}"/>
					<g:TextBox ui:field="saturdayHoursOpt" styleName="{style.borderBx}"/>
				</g:HTMLPanel>

				<g:HTMLPanel ui:field="sundayBlock" styleName="{style.rowPanel}">
					<g:Label styleName="{style.labelStyle}" text="{msgs.sundayColon}"/>
					<g:TextBox ui:field="sundayHoursOpt" styleName="{style.borderBx}"/>
				</g:HTMLPanel>
			</g:HTMLPanel>

			<g:HTMLPanel  ui:field="errorMessage" styleName="{style.infoPanel}">
				<g:Label text="{msgs.blankDaysInfo}"/>
				<g:Label text="{msgs.zeroDaysInfo}"/>
			</g:HTMLPanel>

			<g:HTMLPanel styleName="{style.buttonsPanel}">
				<g:Button ui:field="cancelButton" text="{msgs.cancel}"/>
			    <g:Button ui:field="acceptButton" text="{msgs.ok}"/>
			</g:HTMLPanel>

		</g:HTMLPanel>

	</g:HTMLPanel>

</ui:UiBinder>
