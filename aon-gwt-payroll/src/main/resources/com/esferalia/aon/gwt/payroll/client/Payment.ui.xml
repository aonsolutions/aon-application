<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<ui:UiBinder xmlns:ui='urn:ui:com.google.gwt.uibinder'
	xmlns:g='urn:import:com.google.gwt.user.client.ui' xmlns:datepicker='urn:import:com.google.gwt.user.datepicker.client'>

	<ui:Style>
	.form {
		padding: 10px;
	}
	
	.label {
		margin-top: 10x;
		font-weight: bold;
		padding: 1px 0.5em;
		white-space: nowrap;
		background-color: #F2F2F2;
	}
	
	.labeltop {
		margin-top: 10x;
		font-weight: bold;
		padding: 1px 0.5em;
		vertical-align: top;
		white-space: nowrap;
		background-color: #F2F2F2;
	}
	
	.field {
		padding: 1px 0.5em;
	}
	
	.buttons {
		padding-top: 10px;
		text-align: right;
	}
	
	.info {
		
	}
	
	.warn {
		
	}
	
	.error {
		
	}
	
	.messages {
		padding-left: 0.5em;
		padding-bottom: 10px;
	}
	
	.form textarea {
		resize: none;
	}
	
	</ui:Style>

	<ui:import field="com.esferalia.aon.gwt.payroll.client.Payment.*" />
	<ui:import field="com.esferalia.aon.gwt.payroll.client.Constants.*" />

	<g:HTMLPanel styleName="{style.form}">


		<g:Grid width="100%" ui:field="mainGrid">
			<g:row>
				<g:customCell styleName="{style.label}">
					<g:Label>Concepto</g:Label>
				</g:customCell>
				<g:customCell styleName="{style.field}">
					<g:HorizontalPanel verticalAlignment="ALIGN_MIDDLE"
						styleName="aon-width-all">
						<g:cell >
							<g:SuggestBox ui:field="conceptSuggestBox"
								styleName="aon-width-all aon-inputText" />
						</g:cell>
						<g:cell >
							<g:Label styleName="aon-margin-left" ui:field="conceptDescriptionLabel"
								/>
						</g:cell>
					</g:HorizontalPanel>
				</g:customCell>
			</g:row>
			<g:row>
				<g:customCell styleName="{style.label}">
					<g:Label>Recibo</g:Label>
				</g:customCell>
				<g:customCell styleName="{style.field}">
					<g:ListBox ui:field="receiptListBox" />
				</g:customCell>
			</g:row>
			<g:row>
				<g:customCell styleName="{style.label}">
					<g:Label>Tipo</g:Label>
				</g:customCell>
				<g:customCell styleName="{style.field}">
					<g:HorizontalPanel styleName="aon-width">
						<g:HorizontalPanel verticalAlignment="ALIGN_MIDDLE"
							styleName="aon-width-all">
							<g:ListBox ui:field="typeListBox" />
							<g:cell horizontalAlignment="ALIGN_RIGHT" width="24px">
								<g:Button ui:field="resetTypeButton" styleName="aon-lookupButton-clear "
									visible="false" />
							</g:cell>
						</g:HorizontalPanel>
					</g:HorizontalPanel>
				</g:customCell>
			</g:row>
			<g:row>
				<g:customCell styleName="{style.label}">
					<g:Label>Descripci&oacute;n
					</g:Label>
				</g:customCell>
				<g:customCell styleName="{style.field}">
					<g:HorizontalPanel verticalAlignment="ALIGN_MIDDLE"
						styleName="aon-width-all">
						<g:SuggestBox ui:field="descriptionSuggestBox"
							styleName="aon-width-all aon-inputText" />
						<g:cell horizontalAlignment="ALIGN_RIGHT" width="24px">
							<g:Button ui:field="resetDescriptionButton" styleName="aon-lookupButton-clear"
								visible="false" />
						</g:cell>
					</g:HorizontalPanel>
				</g:customCell>
			</g:row>
			<g:row>
				<g:customCell styleName="{style.label}">
					<g:Label>Devengo</g:Label>
				</g:customCell>
				<g:customCell styleName="{style.field}">
					<g:HorizontalPanel verticalAlignment="ALIGN_MIDDLE"
						styleName="aon-width-all">
						<g:TextBox ui:field="paymentTextBox" styleName="aon-width-all aon-inputText" maxLength="{EXPRESSION_MAX_LENGTH}" />
						<g:cell horizontalAlignment="ALIGN_CENTER" width="24px">
							<g:Button ui:field="fxPaymentButton" styleName="aon-margin-left aon-editDataTable-button aon-icon-fx" />
						</g:cell>
						<g:cell horizontalAlignment="ALIGN_RIGHT" width="24px">
							<g:Button ui:field="resetPaymentButton" styleName="aon-lookupButton-clear"
								visible="false" />
						</g:cell>
					</g:HorizontalPanel>
				</g:customCell>
			</g:row>
			<g:row>
				<g:customCell styleName="{style.label}">
					<g:Label>Tributa</g:Label>
				</g:customCell>
				<g:customCell styleName="{style.field}">
					<g:DeckPanel ui:field="taxDeckPanel" >
						<g:HorizontalPanel verticalAlignment="ALIGN_MIDDLE"
							styleName="aon-width-all" ui:field="taxFullPanel">
								<g:Label>Importe &Iacute;ntegro</g:Label>
						</g:HorizontalPanel>
						<g:HorizontalPanel verticalAlignment="ALIGN_MIDDLE"
							styleName="aon-width-all" ui:field="taxEditPanel">
							<g:ListBox ui:field="taxListBox" styleName="gwt-ListBox aon-width-all" >
								<g:item value="{ALL}">Importe &Iacute;ntegro</g:item>
								<g:item value="{NONE}">Exento</g:item>
								<g:item value="{CUSTOM}">Personalizado...</g:item>
							</g:ListBox>
							<g:Label>&nbsp;</g:Label>
							<g:TextBox ui:field="taxTextBox" styleName="aon-width-all aon-inputText" maxLength="{EXPRESSION_MAX_LENGTH}" />
							<g:cell horizontalAlignment="ALIGN_CENTER" width="24px">
								<g:Button ui:field="fxTaxButton" styleName="aon-margin-left aon-editDataTable-button  aon-icon-fx" />
							</g:cell>
							<g:cell horizontalAlignment="ALIGN_RIGHT" width="24px">
								<g:Button ui:field="resetTaxButton" styleName="aon-lookupButton-clear"
									visible="false" />
							</g:cell>
						</g:HorizontalPanel>
						<g:HorizontalPanel verticalAlignment="ALIGN_MIDDLE"
							styleName="aon-width-all" ui:field="taxNonePanel">
								<g:Label>Exento</g:Label>
						</g:HorizontalPanel>
					</g:DeckPanel>
				</g:customCell>
			</g:row>
			<g:row>
				<g:customCell styleName="{style.label}">
					<g:Label>Cotiza</g:Label>
				</g:customCell>
				<g:customCell styleName="{style.field}">
					<g:DeckPanel ui:field="quoteDeckPanel" >
						<g:HorizontalPanel verticalAlignment="ALIGN_MIDDLE"
							styleName="aon-width-all" ui:field="quoteFullPanel">
								<g:Label>Importe &Iacute;ntegro</g:Label>
						</g:HorizontalPanel>
						<g:HorizontalPanel verticalAlignment="ALIGN_MIDDLE"
							styleName="aon-width-all" ui:field="quoteEditPanel">
							<g:ListBox ui:field="quoteListBox" styleName="gwt-ListBox aon-width-all">
								<g:item value="{ALL}">Importe &Iacute;ntegro</g:item>
								<g:item value="{NONE}">Exento</g:item>
								<g:item value="{PRORATED}">Prorrateado</g:item>
								<g:item value="{CUSTOM}">Personalizado...</g:item>
							</g:ListBox>
							<g:Label>&nbsp;</g:Label>
							<g:TextBox ui:field="quoteTextBox" styleName="aon-width-all aon-inputText" maxLength="{EXPRESSION_MAX_LENGTH}"/>
							<g:cell horizontalAlignment="ALIGN_CENTER" width="24px">
								<g:Button ui:field="fxQuoteButton"
									styleName="aon-margin-left aon-editDataTable-button aon-icon-fx" />
							</g:cell>
							<g:cell horizontalAlignment="ALIGN_RIGHT" width="24px">
								<g:Button ui:field="resetQuoteButton" styleName="aon-lookupButton-clear"
									visible="false" />
							</g:cell>
						</g:HorizontalPanel>
						<g:HorizontalPanel verticalAlignment="ALIGN_MIDDLE"
							styleName="aon-width-all" ui:field="quoteNonePanel">
								<g:Label>Exento</g:Label>
						</g:HorizontalPanel>
					</g:DeckPanel>
				</g:customCell>
			</g:row>
			<g:row ui:Field="monthRow">
				<g:customCell styleName="{style.label}">
					<g:Label>Mes</g:Label>
				</g:customCell>
				<g:customCell styleName="{style.field}">
					<g:ListBox ui:field="monthListBox" />
				</g:customCell>
			</g:row>
		</g:Grid>

	</g:HTMLPanel>


</ui:UiBinder>