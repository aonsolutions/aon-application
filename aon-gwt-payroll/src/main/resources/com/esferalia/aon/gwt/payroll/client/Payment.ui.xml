<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<ui:UiBinder xmlns:ui='urn:ui:com.google.gwt.uibinder'
	xmlns:g='urn:import:com.google.gwt.user.client.ui'
	xmlns:cell="urn:import:com.google.gwt.user.cellview.client"
	xmlns:datepicker='urn:import:com.google.gwt.user.datepicker.client'>

	<ui:with field='msgs' type='com.esferalia.aon.gwt.payroll.client.i18n.PayrollMessages'/>

	<ui:Style>
	.form {
		padding: 10px;
	}

	.label {
		margin-top: 10x;
		font-weight: bold;
		padding: 1px 0.5em;
		white-space: nowrap;
		background-color: #F2F2F2;
	}

	.labeltop {
		margin-top: 10x;
		font-weight: bold;
		padding: 1px 0.5em;
		vertical-align: top;
		white-space: nowrap;
		background-color: #F2F2F2;
	}

	.field {
		padding: 1px 0.5em;
	}

	.buttons {
		padding-top: 10px;
		text-align: right;
	}

	.info {

	}

	.warn {

	}

	.error {

	}

	.messages {
		padding-left: 0.5em;
		padding-bottom: 10px;
	}

	.form textarea {
		resize: none;
	}

	</ui:Style>

	<ui:import field="com.esferalia.aon.gwt.payroll.client.Payment.*" />
	<ui:import field="com.esferalia.aon.gwt.payroll.client.Constants.*" />

	<g:HTMLPanel styleName="{style.form}">


		<g:Grid width="100%" debugId="mainGrid" ui:field="mainGrid">
			<g:row>
				<g:customCell styleName="{style.label}">
					<g:Label text="{msgs.concept}"/>
				</g:customCell>
				<g:customCell styleName="{style.field}">
					<g:HorizontalPanel verticalAlignment="ALIGN_MIDDLE"
						styleName="aon-width-all">
						<g:cell >
							<g:SuggestBox debugId="conceptSuggestBox" ui:field="conceptSuggestBox"
								styleName="aon-width-all aon-inputText" />
						</g:cell>
						<!-- g:cell >
							<g:Label styleName="aon-margin-left" debugId="conceptDescriptionLabel" ui:field="conceptDescriptionLabel" visible="false"
								/>
						</g:cell -->
					</g:HorizontalPanel>
				</g:customCell>
			</g:row>
			<g:row>
				<g:customCell styleName="{style.label}">
					<g:Label text="{msgs.receipt}"/>
				</g:customCell>
				<g:customCell styleName="{style.field}">
					<g:ListBox debugId="receiptListBox" ui:field="receiptListBox" />
				</g:customCell>
			</g:row>
			<g:row>
				<g:customCell styleName="{style.label}">
					<g:Label text="{msgs.type}"/>
				</g:customCell>
				<g:customCell styleName="{style.field}">
					<g:DeckPanel styleName="aon-width" ui:field="typeDeckPanel">
						<g:HorizontalPanel styleName="aon-width">
							<g:HorizontalPanel verticalAlignment="ALIGN_MIDDLE"
								styleName="aon-width-all">
								<g:ListBox debugId="typeListBox" ui:field="typeListBox" />
								<g:cell horizontalAlignment="ALIGN_RIGHT" width="24px">
									<g:Button debugId="resetTypeButton" ui:field="resetTypeButton" styleName="aon-lookupButton-clear "
										visible="false" />
								</g:cell>
							</g:HorizontalPanel>
						</g:HorizontalPanel>
						<g:Label ui:field="typeLabel"></g:Label>
					</g:DeckPanel>
				</g:customCell>
			</g:row>
			<g:row>
				<g:customCell styleName="{style.label}">
					<g:Label text="{msgs.description}"/>
				</g:customCell>
				<g:customCell styleName="{style.field}">
					<g:HorizontalPanel verticalAlignment="ALIGN_MIDDLE"
						styleName="aon-width-all">
						<g:SuggestBox debugId="descriptionSuggestBox" ui:field="descriptionSuggestBox"
							styleName="aon-width-all aon-inputText" />
						<g:cell horizontalAlignment="ALIGN_RIGHT" width="24px">
							<g:Button debugId="resetDescriptionButton" ui:field="resetDescriptionButton" styleName="aon-lookupButton-clear"
								visible="false" />
						</g:cell>
					</g:HorizontalPanel>
				</g:customCell>
			</g:row>
			<g:row>
				<g:customCell styleName="{style.label}">
					<g:Label text="{msgs.accrual}"/>
				</g:customCell>
				<g:customCell styleName="{style.field}">
					<g:HorizontalPanel verticalAlignment="ALIGN_MIDDLE"
						styleName="aon-width-all">
						<g:TextBox debugId="paymentTextBox" ui:field="paymentTextBox" styleName="aon-width-all aon-inputText" maxLength="{EXPRESSION_MAX_LENGTH}" />
						<g:cell horizontalAlignment="ALIGN_CENTER" width="24px">
							<g:Button debugId="fxPaymentButton" ui:field="fxPaymentButton" styleName="aon-margin-left aon-editDataTable-button aon-icon-fx" />
						</g:cell>
						<g:cell horizontalAlignment="ALIGN_RIGHT" width="24px">
							<g:Button debugId="resetPaymentButton" ui:field="resetPaymentButton" styleName="aon-lookupButton-clear"
								visible="false" />
						</g:cell>
					</g:HorizontalPanel>
				</g:customCell>
			</g:row>
			<g:row>
				<g:customCell styleName="{style.label}">
					<g:Label text="{msgs.taxable}"/>
				</g:customCell>
				<g:customCell styleName="{style.field}">
					<g:DeckPanel debugId="taxDeckPanel" ui:field="taxDeckPanel" >
						<g:HorizontalPanel verticalAlignment="ALIGN_MIDDLE"
							styleName="aon-width-all" debugId="taxFullPanel" ui:field="taxFullPanel">
								<g:Label text="{msgs.grossAmount}"/>
						</g:HorizontalPanel>
						<g:HorizontalPanel verticalAlignment="ALIGN_MIDDLE"
							styleName="aon-width-all" debugId="taxEditPanel" ui:field="taxEditPanel">
							<g:DeckPanel ui:field="taxTypeDeckPanel">
								<g:ListBox debugId="taxListBox" ui:field="taxListBox" styleName="gwt-ListBox aon-width-all" >
									<g:item value="{ALL}">{msgs.grossAmount}</g:item>
									<g:item value="{NONE}">{msgs.exempt}</g:item>
									<g:item value="{CUSTOM}">{msgs.customized}</g:item>
									<g:item value="{IRPF_CTA_ESP}">{msgs.accountIncome}</g:item>
								</g:ListBox>
								<g:Label ui:field="taxLabel"></g:Label>
							</g:DeckPanel>
							<g:Label>&nbsp;</g:Label>
							<g:TextBox debugId="taxTextBox" ui:field="taxTextBox" styleName="aon-width-all aon-inputText" maxLength="{EXPRESSION_MAX_LENGTH}" />
							<g:cell horizontalAlignment="ALIGN_CENTER" width="24px">
								<g:Button debugId="fxTaxButton" ui:field="fxTaxButton" styleName="aon-margin-left aon-editDataTable-button  aon-icon-fx" />
							</g:cell>
							<g:cell horizontalAlignment="ALIGN_RIGHT" width="24px">
								<g:Button debugId="resetTaxButton" ui:field="resetTaxButton" styleName="aon-lookupButton-clear"
									visible="false" />
							</g:cell>
						</g:HorizontalPanel>
						<g:HorizontalPanel verticalAlignment="ALIGN_MIDDLE"
							styleName="aon-width-all" debugId="taxNonePanel" ui:field="taxNonePanel">
								<g:Label text="{msgs.exempt}"/>
						</g:HorizontalPanel>
					</g:DeckPanel>
				</g:customCell>
			</g:row>
			<g:row>
				<g:customCell styleName="{style.label}">
					<g:Label text="{msgs.contributory}"/>
				</g:customCell>
				<g:customCell styleName="{style.field}">
					<g:DeckPanel debugId="quoteDeckPanel" ui:field="quoteDeckPanel" >
						<g:HorizontalPanel verticalAlignment="ALIGN_MIDDLE"
							styleName="aon-width-all" debugId="quoteFullPanel" ui:field="quoteFullPanel">
								<g:Label text="{msgs.grossAmount}"/>
						</g:HorizontalPanel>
						<g:HorizontalPanel verticalAlignment="ALIGN_MIDDLE"
							styleName="aon-width-all" debugId="quoteEditPanel" ui:field="quoteEditPanel">
							<g:DeckPanel ui:field="quoteTypeDeckPanel">
								<g:ListBox debugId="quoteListBox" ui:field="quoteListBox" styleName="gwt-ListBox aon-width-all">
									<g:item value="{ALL}">{msgs.grossAmount}</g:item>
									<g:item value="{NONE}">{msgs.exempt}</g:item>
									<g:item value="{PRORATED}">{msgs.prorated}</g:item>
									<g:item value="{CUSTOM}">{msgs.customized}</g:item>
								</g:ListBox>
								<g:Label ui:field="quoteLabel"></g:Label>
							</g:DeckPanel>
							<g:Label>&nbsp;</g:Label>
							<g:TextBox debugId="quoteTextBox" ui:field="quoteTextBox" styleName="aon-width-all aon-inputText" maxLength="{EXPRESSION_MAX_LENGTH}"/>
							<g:cell horizontalAlignment="ALIGN_CENTER" width="24px">
								<g:Button debugId="fxQuoteButton" ui:field="fxQuoteButton"
									styleName="aon-margin-left aon-editDataTable-button aon-icon-fx" />
							</g:cell>
							<g:cell horizontalAlignment="ALIGN_RIGHT" width="24px">
								<g:Button debugId="resetQuoteButton" ui:field="resetQuoteButton" styleName="aon-lookupButton-clear"
									visible="false" />
							</g:cell>
						</g:HorizontalPanel>
						<g:HorizontalPanel verticalAlignment="ALIGN_MIDDLE"
							styleName="aon-width-all" debugId="quoteNonePanel" ui:field="quoteNonePanel">
								<g:Label text="{msgs.exempt}"/>
						</g:HorizontalPanel>
					</g:DeckPanel>
				</g:customCell>
			</g:row>
			<g:row debugId="monthRow" ui:field="monthRow">
				<g:customCell styleName="{style.label}">
					<g:Label text="{msgs.month}"/>
				</g:customCell>
				<g:customCell styleName="{style.field}">
					<g:ListBox debugId="monthListBox" ui:field="monthListBox" />
				</g:customCell>
			</g:row>


		</g:Grid>

		<g:Grid width="100%" debugId="paymentsGrid" ui:field="paymentsGrid">
			<g:row>
				<g:customCell styleName="{style.label}">
					<g:Label text="{msgs.selectConceptsColon}"/>
				</g:customCell>
			</g:row>
			<g:row>
				<g:customCell styleName="{style.field}">
					<cell:DataGrid debugId="paymentsDataGrid" ui:field="paymentsDataGrid" title="Conceptos" />
				</g:customCell>
			</g:row>
		</g:Grid>


	</g:HTMLPanel>


</ui:UiBinder>
