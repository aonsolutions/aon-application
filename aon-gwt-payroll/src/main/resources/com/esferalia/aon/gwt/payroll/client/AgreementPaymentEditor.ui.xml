<ui:UiBinder
    xmlns:ui='urn:ui:com.google.gwt.uibinder'
	xmlns:g='urn:import:com.google.gwt.user.client.ui'
	xmlns:c='urn:import:com.esferalia.aon.gwt.common.client.widget'
	xmlns:a='urn:import:com.esferalia.aon.gwt.payroll.client'
	xmlns:aon='urn:import:com.esferalia.aon.gwt.common.client.widget.solutions'>

    <ui:with field='msgs' type='com.esferalia.aon.gwt.payroll.client.i18n.PayrollMessages'/>

    <ui:style>
    
    	.inputHeight { height: 1.5rem; }
    	
    	.quoteTaxedWidth { min-width: 140px; }

		.form{
			width: 40rem;
			height: 100%;
			padding: .7rem;
		}
		
		.flexColumn{
			display: flex;
			flex-direction: column;
			gap: .5rem;
		}
		
		.buttonsPanel{
			display: flex;
			justify-content: flex-end;
			gap: 1em;
		}
		
		.element{
			display: flex;
			flex-direction: column;
			gap: .2em;
		}
		
		.title{
			font-weight: bold;
		}
		
		.widthAll{
			width: 100%;
		}
		
		.flex{
			width: 100%;
			display: flex;
			gap: .5rem;
			align-items: center;
		}
		
		.flexBetween {
			justify-content: space-between;
		}
		
		.date{
			width: auto !important;
			text-align: center;
			height: 1.2rem;
		}
		
		.iconSmall {
			background-size: 20px;
		}
		
		.aon-toolbar-button {
		    height: 24px;
		    padding-left: 25px;
		    background-position: .2rem;
		    background-repeat: no-repeat;
		    background-color: transparent;
		    background-size: 20px;
		    border: none;
			cursor: pointer;
		}
		
		.dateBox {
			width: 97% !important;
			text-align: center;
			height: 1.5rem;
		}
		
		.issueBox {
			width: 80px;
			text-align: center;
			height: 1.5rem;
		}
		
		.listBox {
			width: 105px;
		}
		
		.between {
			display: flex;
			justify-content: space-between;
			gap: 1rem;
			align-items: center;
		}
		
		.mt1 {
			margin-top: 1rem;
		}
		
		.enterpriseTaxedPanel{
			min-width: 150px;
		}
		
		.expression-TextArea {
			height: 75px !important;
		}
		
	</ui:style>

	<g:HTMLPanel styleName="{style.form} {style.flexColumn}">
	
		<!-- PAYMENT -->
		
		<g:HTMLPanel ui:field="messagePanel" />
		
		<g:HTMLPanel ui:field="paymentTable" styleName="{style.flexColumn}">
			<g:HTMLPanel styleName="{style.element}">
				<g:Label styleName="{style.title}" text="{msgs.type}"/>
				<g:HTMLPanel ui:field="paymentTypePanel" styleName="{style.widthAll}"/>
			</g:HTMLPanel>
			<g:HTMLPanel styleName="{style.element}">
				<g:Label styleName="{style.title}" text="{msgs.concept}"/>
				<g:TextBox ui:field="paymentConceptCodeTB" styleName="{style.inputHeight}"/>
			</g:HTMLPanel>
			<g:HTMLPanel styleName="{style.element}">
				<g:Label styleName="{style.title}" text="{msgs.description}"/>
				<g:TextBox ui:field="paymentDescriptionTB" styleName="{style.inputHeight}"/>
			</g:HTMLPanel>
			<g:HTMLPanel styleName="{style.element}">
				<g:HTMLPanel styleName="{style.flex}">
					<g:Label styleName="{style.title}" text="{msgs.expression}"/>
					<aon:AonToolbarSmallButton ui:field="expresssionVisibilityBtn" />
				</g:HTMLPanel>
				<a:ExpressionCodeArea ui:field="paymentExpressionCA" debugId="fxExpressionCodeArea"
									styleName="aon-width-a11 gwt-TextArea {style.expression-TextArea}" />
			</g:HTMLPanel>
			
			<g:DisclosurePanel ui:field="advancePanel">
			   <g:header><g:Label text="{msgs.advanced}"/></g:header>
			   <g:HTMLPanel styleName="{style.flexColumn}">
					<g:HTMLPanel styleName="{style.element}">
						<g:Label styleName="{style.title}" text="{msgs.salaryReceiptType}"/>
						<g:ListBox ui:field="paymentSalaryTypeLB"/>
					</g:HTMLPanel>
			   		<g:HTMLPanel styleName="{style.flex}">
			   			<g:HTMLPanel styleName="{style.element} {style.widthAll}" ui:field="paymentTaxedPanel">
							<g:Label styleName="{style.title}" text="{msgs.taxable}"/>
							<g:HTMLPanel styleName="{style.flex}">
								<g:ListBox ui:field="paymentTaxedTypeLB" styleName="{style.inputHeight} {style.quoteTaxedWidth}"/>
								<g:TextBox ui:field="paymentTaxedExpression" styleName="{style.widthAll} {style.inputHeight}"/>
							</g:HTMLPanel>
						</g:HTMLPanel>
						<g:HTMLPanel styleName="{style.element} {style.enterpriseTaxedPanel}" ui:field="enterpriseTaxedPanel">
							<g:Label styleName="{style.title}" text="{msgs.companyAccountIncome}"/>
							 <g:Button ui:field="enterpriseTaxed" />
						</g:HTMLPanel>
			   		</g:HTMLPanel>
					<g:HTMLPanel styleName="{style.element}" ui:field="paymentQuotePanel">
						<g:Label styleName="{style.title}" text="{msgs.contributory}"/>
						<g:HTMLPanel styleName="{style.flex}">
							<g:ListBox ui:field="paymentQuoteTypeLB" styleName="{style.inputHeight} {style.quoteTaxedWidth}"/>
							<g:TextBox ui:field="paymentQuoteExpression" styleName="{style.widthAll} {style.inputHeight}"/>
						</g:HTMLPanel>
					</g:HTMLPanel>
					<g:HTMLPanel styleName="{style.element}" ui:field="seniorityPanel">
						<g:Label styleName="{style.title}" text="{msgs.seniorityCalculation}"/>
						<g:HTMLPanel styleName="{style.flex}">
							<g:ListBox ui:field="seniorityType" styleName="{style.quoteTaxedWidth} {style.inputHeight}"/>
							<g:Label styleName="{style.widthAll}" text="{msgs.seniorityCalculationAffectsAll}"/>
						</g:HTMLPanel>
					</g:HTMLPanel>
					
					<g:HTMLPanel styleName="{style.between}" ui:field="periodPaymentPanel">
						<g:HTMLPanel styleName="{style.element} {style.widthAll}">
							<g:Label text="{msgs.paymentMonth}" styleName="{style.title}" />
							<g:ListBox ui:field="monthPaymentLB" styleName="{style.quoteTaxedWidth} {style.inputHeight}"/>
						</g:HTMLPanel>
						<g:HTMLPanel styleName="{style.element} {style.widthAll}">
							<g:Label text="{msgs.startDate}" styleName="{style.title}" />
							<c:DateBoxEx ui:field="startDateBx" styleName="{style.dateBox}" />
						</g:HTMLPanel>
						<g:HTMLPanel styleName="{style.element} {style.widthAll}">
							<g:Label text="{msgs.endDate}" styleName="{style.title}" />
							<c:DateBoxEx ui:field="endDateBx" styleName="{style.dateBox}" />
						</g:HTMLPanel>
					</g:HTMLPanel>
			   </g:HTMLPanel>
			 </g:DisclosurePanel>
			
			
			<g:HTMLPanel styleName="{style.flexColumn}" ui:field="extraPanel">
				<g:HTMLPanel styleName="{style.flex} {style.flexBetween}">
					<g:HTMLPanel styleName="{style.flex}">
						<g:HTMLPanel styleName="{style.element}">
							<g:Label styleName="{style.title}" text="{msgs.paymentDate}"/>
							<g:TextBox ui:field="extraIssueDate" styleName="{style.issueBox} {style.inputHeight}"/>
						</g:HTMLPanel>
					</g:HTMLPanel>
					<g:HTMLPanel styleName="{style.flex}" ui:field="extraPeriodPanel">
						<g:HTMLPanel styleName="{style.element}">
							<g:Label styleName="{style.title}" text="{msgs.quotationStartDate}"/>
							<g:HTMLPanel styleName="{style.flex}">
								<g:ListBox ui:field="extraStartDateMonth" styleName="{style.inputHeight}"/>
								<g:ListBox ui:field="extraStartDateYear" styleName="{style.listBox} {style.inputHeight}"/>
							</g:HTMLPanel>
						</g:HTMLPanel>
						<g:HTMLPanel styleName="{style.element}">
							<g:Label styleName="{style.title}" text="{msgs.quotationEndDate}"/>
							<g:HTMLPanel styleName="{style.flex}">
								<g:ListBox ui:field="extraEndDateMonth" styleName="{style.inputHeight}"/>
								<g:ListBox ui:field="extraEndDateYear" styleName="{style.listBox} {style.inputHeight}"/>
							</g:HTMLPanel>
						</g:HTMLPanel>
					</g:HTMLPanel>
				</g:HTMLPanel>
				
			</g:HTMLPanel>
			
		</g:HTMLPanel>
		
		<g:HTMLPanel ui:field="buttonsPanel" styleName="{style.buttonsPanel} {style.mt1}" />
		
	</g:HTMLPanel>

</ui:UiBinder>