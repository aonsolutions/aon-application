<ui:UiBinder 
    xmlns:ui='urn:ui:com.google.gwt.uibinder'
	xmlns:g='urn:import:com.google.gwt.user.client.ui'
	xmlns:c='urn:import:com.esferalia.aon.gwt.common.client.widget'
	xmlns:a='urn:import:com.esferalia.aon.gwt.payroll.client'
	xmlns:aon='urn:import:com.esferalia.aon.gwt.common.client.widget.solutions'>

    <ui:style>
    
    	.inputHeight { height: 1.5rem; }
    	
    	.quoteTaxedWidth { min-width: 140px; }

		.form{
			width: 40rem;
			height: 100%;
			padding: .7rem;
		}
		
		.flexColumn{
			display: flex;
			flex-direction: column;
			gap: .5rem;
		}
		
		.buttonsPanel{
			width: 100%;
			display: flex;
			justify-content: flex-end;
			gap: 1em;
			margin-top: 1rem;
		}
		
		.element{
			display: flex;
			flex-direction: column;
			gap: .2em;
		}
		
		.title{
			font-weight: bold;
		}
		
		.widthAll{
			width: 100%;
		}
		
		.flex{
			width: 100%;
			display: flex;
			gap: .5rem;
			align-items: center;
		}
		
		.flexBetween {
			justify-content: space-between;
		}
		
		.date{
			width: auto !important;
			text-align: center;
			height: 1.2rem;
		}
		
		.aon-toolbar-button {
		    height: 24px;
		    padding-left: 25px;
		    background-position: .2rem;
		    background-repeat: no-repeat;
		    background-color: transparent;
		    background-size: 20px;
		    border: none;
			cursor: pointer;
		}
		
		.dateBox {
			width: 98% !important;
			text-align: center;
			height: 1.5rem;
		}
		
		.issueBox {
			width: 80px;
			text-align: center;
			height: 1.5rem;
		}
		
		.listBox {
			width: 105px;
		}
		
		.between {
			display: flex;
			justify-content: space-between;
			gap: 1rem;
		}
		
	</ui:style>

	<g:HTMLPanel styleName="{style.form} {style.flexColumn}">
	
		<aon:AonToolbarSmall ui:field="toolbar" />
	
		<!-- PAYMENT -->
		
		<g:HTMLPanel ui:field="paymentTable" styleName="{style.flexColumn}">
			<g:HTMLPanel styleName="{style.element}">
				<g:Label styleName="{style.title}">Tipo</g:Label>
				<g:HTMLPanel ui:field="paymentTypePanel" styleName="{style.widthAll}"/>
			</g:HTMLPanel>
			<g:HTMLPanel styleName="{style.element}">
				<g:Label styleName="{style.title}">Concepto</g:Label>
				<g:SuggestBox ui:field="paymentConceptSB" styleName="{style.inputHeight}"/>
			</g:HTMLPanel>
			<g:HTMLPanel styleName="{style.element}">
				<g:Label styleName="{style.title}">Descripción</g:Label>
				<g:TextBox ui:field="paymentDescriptionTB" styleName="{style.inputHeight}"/>
			</g:HTMLPanel>
			<g:HTMLPanel styleName="{style.element}">
				<g:HTMLPanel styleName="{style.flex}">
					<g:Label styleName="{style.title}">Expresión</g:Label>
					<aon:AonToolbarSmallButton ui:field="expresssionVisibilityBtn" />
				</g:HTMLPanel>
				<g:TextArea ui:field="paymentExpressionTB"/>
			</g:HTMLPanel>
			<g:HTMLPanel styleName="{style.element}" ui:field="paymentTaxedPanel">
				<g:Label styleName="{style.title}">Tributa</g:Label>
				<g:HTMLPanel styleName="{style.flex}">
					<g:ListBox ui:field="paymentTaxedTypeLB" styleName="{style.inputHeight} {style.quoteTaxedWidth}"/>
					<g:TextBox ui:field="paymentTaxedExpression" styleName="{style.widthAll} {style.inputHeight}"/>
				</g:HTMLPanel>
			</g:HTMLPanel>
			<g:HTMLPanel styleName="{style.element}" ui:field="paymentQuotePanel">
				<g:Label styleName="{style.title}">Cotiza</g:Label>
				<g:HTMLPanel styleName="{style.flex}">
					<g:ListBox ui:field="paymentQuoteTypeLB" styleName="{style.inputHeight} {style.quoteTaxedWidth}"/>
					<g:TextBox ui:field="paymentQuoteExpression" styleName="{style.widthAll} {style.inputHeight}"/>
				</g:HTMLPanel>
			</g:HTMLPanel>
			<g:HTMLPanel styleName="{style.element}" ui:field="seniorityPanel">
				<g:Label styleName="{style.title}">Cálculo Antigüedad</g:Label>
				<g:HTMLPanel styleName="{style.flex}">
					<g:ListBox ui:field="seniorityType" styleName="{style.quoteTaxedWidth} {style.inputHeight}"/>
					<g:Label styleName="{style.widthAll}">El valor seleccionado afectará a todos los cálculos de antigüedad del convenio</g:Label>
				</g:HTMLPanel>
			</g:HTMLPanel>
			
			<g:HTMLPanel styleName="{style.between}" ui:field="periodPaymentPanel">
				<g:HTMLPanel styleName="{style.element} {style.widthAll}">
					<g:Label text="Fecha inicio" styleName="{style.title}" />
					<c:DateBoxEx ui:field="startDateBx" styleName="{style.dateBox}" />
				</g:HTMLPanel>
				<g:HTMLPanel styleName="{style.element} {style.widthAll}">
					<g:Label text="Fecha fin" styleName="{style.title}" />
					<c:DateBoxEx ui:field="endDateBx" styleName="{style.dateBox}" />
				</g:HTMLPanel>
			</g:HTMLPanel>
			
			<g:HTMLPanel styleName="{style.flexColumn}" ui:field="extraPanel">
				<g:HTMLPanel styleName="{style.flex} {style.flexBetween}">
					<g:HTMLPanel styleName="{style.flex}">
						<g:HTMLPanel styleName="{style.element}">
							<g:Label styleName="{style.title}">Fecha Cobro</g:Label>
							<g:TextBox ui:field="extraIssueDate" styleName="{style.issueBox} {style.inputHeight}"/>
						</g:HTMLPanel>
						<g:HTMLPanel styleName="{style.element}">
							<g:Label styleName="{style.title}">Cotización</g:Label>
							<g:ListBox ui:field="extraType" styleName="{style.inputHeight}"/>
						</g:HTMLPanel>
					</g:HTMLPanel>
					<g:HTMLPanel styleName="{style.flex}">
						<g:HTMLPanel styleName="{style.element}">
							<g:Label styleName="{style.title}">Fecha Incio Cotización</g:Label>
							<g:HTMLPanel styleName="{style.flex}">
								<g:ListBox ui:field="extraStartDateMonth" styleName="{style.inputHeight}"/>
								<g:ListBox ui:field="extraStartDateYear" styleName="{style.listBox} {style.inputHeight}"/>
							</g:HTMLPanel>
						</g:HTMLPanel>
						<g:HTMLPanel styleName="{style.element}">
							<g:Label styleName="{style.title}">Fecha Fin Cotización</g:Label>
							<g:HTMLPanel styleName="{style.flex}">
								<g:ListBox ui:field="extraEndDateMonth" styleName="{style.inputHeight}"/>
								<g:ListBox ui:field="extraEndDateYear" styleName="{style.listBox} {style.inputHeight}"/>
							</g:HTMLPanel>
						</g:HTMLPanel>
					</g:HTMLPanel>
				</g:HTMLPanel>
				
				<g:HTMLPanel styleName="{style.element}">
					<g:Label styleName="{style.title}">Extra asociada</g:Label>
					<g:ListBox ui:field="extraAssociated" styleName="{style.widthAll} {style.inputHeight}"/>
				</g:HTMLPanel>
				
				<g:HTMLPanel styleName="{style.flex} {style.flexBetween}" ui:field="extraAssociatedPanel">
					<g:HTMLPanel styleName="{style.flex}">
						<g:HTMLPanel styleName="{style.element}">
							<g:Label styleName="{style.title}">Fecha Cobro</g:Label>
							<g:TextBox ui:field="extraIssueDateAssociated" styleName="{style.issueBox} {style.inputHeight}"/>
						</g:HTMLPanel>
					</g:HTMLPanel>
					<g:HTMLPanel styleName="{style.flex}">
						<g:HTMLPanel styleName="{style.element}">
							<g:Label styleName="{style.title}">Fecha Incio Cotización</g:Label>
							<g:HTMLPanel styleName="{style.flex}">
								<g:ListBox ui:field="extraStartDateMonthAssociated" styleName="{style.inputHeight}"/>
								<g:ListBox ui:field="extraStartDateYearAssociated" styleName="{style.listBox} {style.inputHeight}"/>
							</g:HTMLPanel>
						</g:HTMLPanel>
						<g:HTMLPanel styleName="{style.element}">
							<g:Label styleName="{style.title}">Fecha Fin Cotización</g:Label>
							<g:HTMLPanel styleName="{style.flex}">
								<g:ListBox ui:field="extraEndDateMonthAssociated" styleName="{style.inputHeight}"/>
								<g:ListBox ui:field="extraEndDateYearAssociated" styleName="{style.listBox} {style.inputHeight}"/>
							</g:HTMLPanel>
						</g:HTMLPanel>
					</g:HTMLPanel>
				</g:HTMLPanel>
				
			</g:HTMLPanel>
			
		</g:HTMLPanel>
			
		<g:HTMLPanel ui:field="buttonsPanel" styleName="{style.buttonsPanel}"/>
		
	</g:HTMLPanel>

</ui:UiBinder>