<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
	xmlns:g='urn:import:com.google.gwt.user.client.ui'
	xmlns:e='urn:import:com.esferalia.aon.gwt.payroll.client'>

	<ui:with field='res'
		type='com.esferalia.aon.gwt.common.client.css.AonResources' />

	<ui:style type="com.esferalia.aon.gwt.payroll.client.MainCCC.MyStyle">
		
		.warningColor{
			font-weight: bold;
			color: #be0000;
		}
		
		.styleBorder{
			border-style: solid; 
			width: 975px; 
			border-width: 1px; 
			margin-top: 20px; 
			margin-left: 10px;
		}
		
		.tittle{
			top: -0.5em;
			font-size: 12px;
			margin-left: 10px;
		}
		
		.footerStyle{
			background-color: #eaeaea;
			padding-top: 5px;
		}
		
		.footerElement{
			margin-left: 10px;
			width: 940px;
			border: none;
		}
		
		.scrollStyle {
			margin-left: 10px;
			width: 950px;
			margin-bottom: 10px;
		}
		
		.gridStyle{
			margin-left: 10px;
			width: 950px;
		}
		
		.center{
			display: flex;
			justify-content: center;
		}
		
	</ui:style>

	<g:DockLayoutPanel unit="PX">
		<g:north size="35">
			<g:FlowPanel>
				<g:FlowPanel styleName="aon-finding-title-toolbar">
					<g:HorizontalPanel>
						<g:HTMLPanel styleName="aon-finding-title">
							<g:HTMLPanel styleName="aon-finding-title-internal">
								<g:Label styleName="aon-outputText">Mantenimiento CCC</g:Label>
							</g:HTMLPanel>
						</g:HTMLPanel>
						<g:HTMLPanel styleName="aon-finding-subtitle">
							<g:HTMLPanel styleName="aon-finding-subtitle-internal">
								<g:Label styleName="aon-outputText"></g:Label>
							</g:HTMLPanel>
						</g:HTMLPanel>
						<g:HorizontalPanel styleName="aon-finding-toolbar">
							<g:HTMLPanel styleName="aon-finding-toolbar-item-group">
								<g:Button ui:field='saveButton'
									styleName='aon-finding-toolbar-item aon-icon-accept' text="GUARDAR"
									enabled="true" />
							</g:HTMLPanel>
						</g:HorizontalPanel>
					</g:HorizontalPanel>
				</g:FlowPanel>
			</g:FlowPanel>
		</g:north>
		<g:center>
			<g:HTMLPanel styleName="aon-width-all aon-height-all {style.center}" debugId="activityHTMLPanel">
	    		<g:VerticalPanel styleName="{style.styleBorder}">
		    	<g:Label width="105px" styleName='aon-group-title {style.tittle}'>Cuentas de cotización</g:Label>
			    	<g:HTMLPanel styleName="aon-width-all aon-height-all" debugId="paymetDialogHTMLPanel">
			    		<g:VerticalPanel>
			    			<g:Grid ui:field="cccDataTableHeader" styleName="{style.gridStyle}"></g:Grid>
			    			<g:HTMLPanel>
			    				<hr align="left" noshade="noshade" style="margin-bottom: 10px;border-width: 0.5px;margin-left: 10px;"/>
			    			</g:HTMLPanel>
				    		<g:ScrollPanel ui:field="scrollPanel" styleName="{style.scrollStyle}">
				    			<g:Grid ui:field="cccDataTable"></g:Grid>
				    		</g:ScrollPanel>
				    		<g:HTMLPanel styleName="{style.footerStyle}">
			    				<g:Label ui:field="newAccount" styleName="aon-finding-toolbar-item aon-icon-reset {style.footerElement}">NUEVA</g:Label>
			    			</g:HTMLPanel>
			    		</g:VerticalPanel>
			    	</g:HTMLPanel>
			    </g:VerticalPanel>
	    	</g:HTMLPanel>
		</g:center>
	</g:DockLayoutPanel>
</ui:UiBinder> 

