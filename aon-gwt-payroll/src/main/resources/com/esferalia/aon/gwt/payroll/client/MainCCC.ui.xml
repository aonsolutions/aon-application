<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
	xmlns:g='urn:import:com.google.gwt.user.client.ui'
	xmlns:e='urn:import:com.esferalia.aon.gwt.payroll.client'>

	<ui:with field='res'
		type='com.esferalia.aon.gwt.common.client.css.AonResources' />

	<ui:style type="com.esferalia.aon.gwt.payroll.client.MainCCC.MyStyle">
		
		.warningColor{
			font-weight: bold;
			color: #be0000;
		}
		
		.styleBorder{
			border-style: solid; 
			width: 975px; 
			border-width: 1px; 
			margin-top: 60px; 
			margin-left: 10px;
		}
		
		.tittle{
			top: -1.2em;
			font-size: 12px;
			margin-left: 10px;
			position: relative;
			width: 120px;
			background-color: white;
			padding: 5px;
		}
		
		.footerStyle{
			background-color: #eaeaea;
			padding-top: 5px;
		}
		
		.footerElement{
			margin-left: 10px;
			width: 940px;
			border: none;
		}
		
		.scrollStyle {
			margin-left: 10px;
			width: 950px;
			margin-bottom: 10px;
		}
		
		.gridStyle{
			margin-left: 10px;
			width: 950px;
		}
		
		.center{
			display: flex;
			justify-content: center;
		}
		
		.headerStyle{
			font-weight: bold;
			padding-left: 5px;
		}
		
		.widthAll{
			width: 100%;
		}
		
		.heightAll{
			height: 100%;
		}
		
	</ui:style>

	<g:DockLayoutPanel ui:field="dockLayoutPanel" unit="PX">
		<g:center>
			<g:HTMLPanel styleName="{style.widthAll} {style.heightAll} {style.center}" debugId="activityHTMLPanel">
	    		<g:VerticalPanel styleName="{style.styleBorder}">
		    	<g:Label styleName='{style.tittle}'>Cuentas de cotización</g:Label>
			    	<g:HTMLPanel styleName="{style.widthAll} {style.heightAll}" debugId="paymetDialogHTMLPanel">
			    		<g:VerticalPanel>
			    			<g:Grid ui:field="cccDataTableHeader" styleName="{style.gridStyle}"></g:Grid>
			    			<g:HTMLPanel>
			    				<hr align="left" noshade="noshade" style="margin-bottom: 10px;border-width: 0.5px;margin-left: 10px;"/>
			    			</g:HTMLPanel>
				    		<g:ScrollPanel ui:field="scrollPanel" styleName="{style.scrollStyle}">
				    			<g:Grid ui:field="cccDataTable"></g:Grid>
				    		</g:ScrollPanel>
				    		<g:HTMLPanel styleName="{style.footerStyle}">
			    				<g:Label ui:field="newCCC" styleName="aon-finding-toolbar-item aon-icon-reset {style.footerElement}">NUEVA</g:Label>
			    			</g:HTMLPanel>
			    		</g:VerticalPanel>
			    	</g:HTMLPanel>
			    </g:VerticalPanel>
	    	</g:HTMLPanel>
		</g:center>
	</g:DockLayoutPanel>
</ui:UiBinder> 

