<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<ui:UiBinder xmlns:ui='urn:ui:com.google.gwt.uibinder'
	xmlns:g='urn:import:com.google.gwt.user.client.ui'
	xmlns:a='urn:import:com.esferalia.aon.gwt.payroll.client'
	xmlns:s='urn:import:com.google.gwt.dom.builder.shared'>
	<ui:with field='msgs' type='com.esferalia.aon.gwt.payroll.client.i18n.PayrollMessages'/>


	<ui:style type='com.esferalia.aon.gwt.payroll.client.ITEditor.Style'>

		.pos {
			align: center;
			text-align: center;
		}

		.document {
			margin-top: 5px;
			margin-left: auto;
			margin-right: auto;
			margin-bottom: 15px;
		}


		.legend-icon {
			width: 13px;
			height: 13px;
		}
		
		.legend-caption {
			margin-top : 10px;
			margin-left : 6px;
			margin-right : 16px;
			margin-bottom : 10px;
		}

		@eval activeBackground com.esferalia.aon.gwt.payroll.client.ITEditor.getColor(null);
		.active {
			background-color: activeBackground ;
		}

		@eval commonBackground com.esferalia.aon.gwt.payroll.client.ITEditor.getColor(com.esferalia.aon.gwt.payroll.shared.ITDataPerson.Type.COMMON_DISEASE);
		.common {
			background-color: commonBackground;
		}

		@eval maternityBackground com.esferalia.aon.gwt.payroll.client.ITEditor.getColor(com.esferalia.aon.gwt.payroll.shared.ITDataPerson.Type.MATERNITY);
		.maternity {
			background-color: maternityBackground;
		}
		
		@eval paternityBackground com.esferalia.aon.gwt.payroll.client.ITEditor.getColor(com.esferalia.aon.gwt.payroll.shared.ITDataPerson.Type.PATERNITY);
		.paternity {
			background-color: paternityBackground;
		}

		@eval professionalBackground com.esferalia.aon.gwt.payroll.client.ITEditor.getColor(com.esferalia.aon.gwt.payroll.shared.ITDataPerson.Type.OCCUPATIONAL_DISEASE);
		.professional {
			background-color: professionalBackground;
		}
		
		@eval commonProfessionalBackground com.esferalia.aon.gwt.payroll.client.ITEditor.getColor(com.esferalia.aon.gwt.payroll.shared.ITDataPerson.Type.COMMON_OCCUPATIONAL_DISEASE);
		.commonProfessional {
			background-color: commonProfessionalBackground;
		}		

	</ui:style>
	
	<g:DockLayoutPanel unit="PX">
		<g:north size="72">

			<g:FlowPanel>	
			    
			    <g:FlowPanel styleName="aon-finding-title-toolbar">
					<g:HorizontalPanel>
						<g:HTMLPanel styleName="aon-finding-title">
							<g:HTMLPanel styleName="aon-finding-title-internal">
								<g:Label styleName="aon-outputText" ui:field="titleLabel" text="{msgs.partesIT}"/>
							</g:HTMLPanel>
						</g:HTMLPanel>
						<g:HTMLPanel styleName="aon-finding-subtitle">
							<g:HTMLPanel styleName="aon-finding-subtitle-internal">
								<g:Label styleName="aon-outputText"></g:Label>
							</g:HTMLPanel>
						</g:HTMLPanel>
						<g:HorizontalPanel styleName="aon-finding-toolbar">
							<g:HTMLPanel styleName="aon-finding-toolbar-item-group">								
								<g:ListBox ui:field='dateListBox' styleName='' />
							</g:HTMLPanel>
							<g:HTMLPanel styleName="aon-finding-toolbar-item-group">
								<g:InlineLabel styleName="aon-finding-toolbar-item aon-finding-toolbar-item-no-border" text="{msgs.filterColon}"/>
							    <g:SuggestBox ui:field='nameEmployee' styleName="aon-inputText" width="300px"  />													
							</g:HTMLPanel>
						</g:HorizontalPanel>
					</g:HorizontalPanel>
				</g:FlowPanel>		    
								
				<g:FlowPanel styleName="aon-finding-title-toolbar">
					<g:HorizontalPanel>
						<g:HTMLPanel styleName="aon-finding-title">
							<g:HTMLPanel styleName="aon-finding-title-internal">
								<g:Label styleName="aon-outputText">Edici&oacute;n</g:Label>
							</g:HTMLPanel>
						</g:HTMLPanel>
						<g:HTMLPanel styleName="aon-finding-subtitle">
							<g:HTMLPanel styleName="aon-finding-subtitle-internal">
								<g:Label styleName="aon-outputText"></g:Label>
							</g:HTMLPanel>
						</g:HTMLPanel>
						<g:HorizontalPanel styleName="aon-finding-toolbar">
							<g:HTMLPanel styleName="aon-finding-toolbar-item-group">								
								<g:Button ui:field="undoButton"
									styleName='aon-finding-toolbar-item aon-icon-undo' enabled="false" />
								<g:Button ui:field='redoButton'
									styleName="aon-finding-toolbar-item aon-icon-redo" enabled="false" />
							</g:HTMLPanel>
						</g:HorizontalPanel>
						<g:HTMLPanel styleName="aon-finding-toolbar-item-group">
								<g:Button ui:field='saveButton'
									styleName='aon-finding-toolbar-item aon-icon-accept' text="{msgs.saveAction}"
									enabled="false" />
							</g:HTMLPanel>
					</g:HorizontalPanel>
				</g:FlowPanel>


			</g:FlowPanel>

		</g:north>
		<g:center>
			<g:ScrollPanel ui:field="scrollPanelTimeline">
				<g:VerticalPanel styleName="{style.document}"  >
					
					<g:HorizontalPanel ui:field="legendPanel" >

						<g:HTML  styleName="{style.legend-icon} {style.active}"
						    title="{msgs.activeEmployeePeriod}"/>
						<g:InlineLabel styleName="{style.legend-caption}" text="{msgs.active}"/>		

						<g:HTML  styleName="{style.legend-icon} {style.common}"
						    title="{msgs.commonDiseaseNonLaboral}"/>
						<g:InlineLabel styleName="{style.legend-caption}" text="{msgs.commonDisease}"/>		

						<g:HTML  styleName="{style.legend-icon} {style.professional}"
						    title="{msgs.professionalDiseaseLaboral}"/>
						<g:InlineLabel styleName="{style.legend-caption}" text="{msgs.professionalDisease}"/>		

						<g:HTML  styleName="{style.legend-icon} {style.maternity}"
						    title="{msgs.maternityLactancy}"/>
						<g:InlineLabel styleName="{style.legend-caption}" text="{msgs.maternity}"/>		

						<g:HTML  styleName="{style.legend-icon} {style.paternity}"
						    title="{msgs.paternityLeave}"/>
						<g:InlineLabel styleName="{style.legend-caption}" text="{msgs.paternity}"/>		

						<g:HTML  styleName="{style.legend-icon} {style.common}"
						    title="{msgs.commonDiseaseCarencia}"/>
						<g:InlineLabel styleName="{style.legend-caption}" text="{msgs.commonDiseaseCarencia}"/>		
					
						<g:HTML  styleName="{style.legend-icon} {style.commonProfessional}"
						    title="{msgs.commonDiseaseCovid}"/>
						<g:InlineLabel styleName="{style.legend-caption}" text="{msgs.commonDiseaseCovid}"/>		

					</g:HorizontalPanel>				
					
					<g:SimplePanel ui:field='timelinePanel'>
					    
					</g:SimplePanel>
				
				</g:VerticalPanel>				
			</g:ScrollPanel>
		</g:center>
	</g:DockLayoutPanel>

</ui:UiBinder>
