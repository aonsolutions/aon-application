<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<ui:UiBinder xmlns:ui='urn:ui:com.google.gwt.uibinder'
	xmlns:g='urn:import:com.google.gwt.user.client.ui'
	xmlns:a='urn:import:com.esferalia.aon.gwt.payroll.client' >

	<ui:Style>
	
		.form {
			display: flex;
			flex-direction: column;
			gap: .5rem;
		}
	
		.buttonsPanel{
			display: flex;
			justify-content: flex-end;
			margin: .5rem 1rem;
		}
	
	</ui:Style>

	<g:HTMLPanel styleName="{style.form}">
		<g:HTMLPanel ui:field="messageContainer" />
		<a:Employee ui:field="employee"/>
		<g:HTMLPanel ui:field="buttonsPanel" styleName="{style.buttonsPanel}" />
	</g:HTMLPanel>

</ui:UiBinder>