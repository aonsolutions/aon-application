<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<ui:UiBinder xmlns:ui='urn:ui:com.google.gwt.uibinder'
	xmlns:g='urn:import:com.google.gwt.user.client.ui'
	xmlns:a='urn:import:com.esferalia.aon.gwt.payroll.client' >

	<ui:Style>
	
		.mr-10{
			margin-right: 10px !important;
		}
		
		.buttonsPanel{
			display: flex;
			justify-content: flex-end;
			margin: 5px 10px;
		}
		
		.messagePanel {
			width: 1000px;
		    padding: 0.5rem 0;
		}
	
	</ui:Style>


	<g:HTMLPanel styleName="aon-width-all aon-height-all" debugId="paymetDialogHTMLPanel"> 
		<g:VerticalPanel>
			<g:HTMLPanel ui:field="messageContainer" styleName="{style.messagePanel}"/>
			<a:Employee ui:field="employee"/>
			<g:HTMLPanel ui:field="buttonsPanel" styleName="{style.buttonsPanel}"></g:HTMLPanel>
		</g:VerticalPanel>
	</g:HTMLPanel>

</ui:UiBinder>