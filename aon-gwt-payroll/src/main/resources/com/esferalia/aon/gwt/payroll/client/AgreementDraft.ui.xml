<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<ui:UiBinder xmlns:ui='urn:ui:com.google.gwt.uibinder'
	xmlns:g='urn:import:com.google.gwt.user.client.ui'
	xmlns:s="urn:import:com.google.gwt.dom.builder.shared" 
	xmlns:aon='urn:import:com.esferalia.aon.gwt.common.client.widget'>

	<ui:with field='res' type='com.esferalia.aon.gwt.common.client.css.AonResources'/>

	<ui:style type='com.esferalia.aon.gwt.payroll.client.AgreementDraft.MyStyle'>
	
		.editor {
			
		}
		
		.label {
			margin-top:10x;
			font-weight: bold;
			padding: 1px 0.5em;
			white-space: nowrap;
			background-color: #F2F2F2;
		}

		.field {
			width: 100%;
			padding: 1px 0.5em;
		}

		.highlight,
		.highlight td  {
    		border-color: #D3C061;
    		background-color: #FBEDB6;
    	}
    	
		.vertical-space {
			height: 20px;
		}

		.horizontal-space {
			width: 5px;
		}

		.document {
			margin-top: 5px;
			margin-left: auto;
			margin-right: auto;
			margin-bottom: 15px;
		}
		
		.edit-rows .edit-cells {
		}
		
		.edit-rows td, 
		 .edit-cells td {
			color: #000000 !important;			
		}
		
		.edit-rows tr:hover,
		.edit-cells td:hover{
			cursor: pointer;
			background-color: #E2F1F5 !important;
	
		}

		.span-cell {
			padding: 0px !important;
		}
		
		@if !user.agent safari {
			.cell-label {
				font-size: 9px;
				font-weight: bold;
				font-family: sans-serif;
			}
		}
		@else {
			.cell-label {
				font-size: 11px;
				font-weight: bold;
				font-family: sans-serif;
			}
		}
		
		.text-ok,
		.text-ok * {
			color: green !important;
		}

		.text-warn *{
			font-weight: bold;
			color: orange !important;
		}

		.text-error,
		.text-error *{
			font-weight: bold;
			color: red !important;
		}

		.icon-warn {
			color: orange;
		}

		.span-cell-table {
			width: 100%;
			border-collapse: collapse !important;
		}

		.span-cell-cell {
			border-top: 0px !important;
			border-left: 0px !important;
			border-bottom: 0px !important;
		}
		
		.span-cell-cell-last {
			border: 0px !important;
		}
		
		.toolBar-checkBox input {
			vertical-align: middle;
		}
		
		
		.toolBar-checkBox input {
			vertical-align: middle;
		}
		
		.monthListBox-item {
			padding-left : 16px;
		}

		.monthListBox-old {
			
		}

	</ui:style>


	<ui:import field="com.esferalia.aon.gwt.payroll.client.Constants.*" />
	<ui:import field="com.esferalia.aon.gwt.payroll.client.AgreementDraft.*" />

	<g:DeckLayoutPanel ui:field="deckPanel">
		<g:DockLayoutPanel unit="PX" ui:field="draftPanel">
			<g:north size="72">

				<g:FlowPanel>

					<g:FlowPanel styleName="aon-finding-title-toolbar">
						<g:HorizontalPanel>
							<g:HTMLPanel styleName="aon-finding-title">
								<g:HTMLPanel styleName="aon-finding-title-internal">
									<g:Label styleName="aon-outputText">Convenio</g:Label>
								</g:HTMLPanel>
							</g:HTMLPanel>
							<g:HTMLPanel styleName="aon-finding-subtitle">
								<g:HTMLPanel styleName="aon-finding-subtitle-internal">
									<g:Label styleName="aon-outputText"></g:Label>
								</g:HTMLPanel>
							</g:HTMLPanel>
							<g:HorizontalPanel styleName="aon-finding-toolbar">
								<g:HTMLPanel styleName="aon-finding-toolbar-item-group">
									<g:Button ui:field='acceptButton'
										styleName='aon-finding-toolbar-item aon-icon-accept' text="GUARDAR" />
									<g:Button ui:field='deleteButton'
										styleName='aon-finding-toolbar-item aon-icon-delete' text="BORRAR"
										enabled="false" />
									<g:ListBox ui:field='datesListBox'>
										<g:item value="{ALWAYS}">Para todo</g:item>
										<g:item value="{FROM_THIS_MONTH}">A partir de este mes</g:item>
										<g:item value="{ONLY_THIS_YEAR}">S&oacute;lo este a&ntilde;o</g:item>
									</g:ListBox>
									<g:CheckBox ui:field='changesCheck'
										styleName='aon-finding-toolbar-item {style.toolBar-checkBox}'
										text="Cambios" checked="true" visible="false" />
									<aon:MonthListBox ui:field="draftMonthListBox"
										oldStyles="{style.monthListBox-old}" monthStyles="{style.monthListBox-item}"
										highLightStyles="aon-bold aon-black aon-icon-month-changed {style.monthListBox-item}" />

									<g:Button ui:field='printPreviewButton'
										styleName='aon-finding-toolbar-item {res.css.aonIconPdfPreview}'
										text="Vista Preliminar" />

								</g:HTMLPanel>
							</g:HorizontalPanel>
						</g:HorizontalPanel>
					</g:FlowPanel>
					<g:FlowPanel styleName="aon-finding-title-toolbar">
						<g:HorizontalPanel>
							<g:HTMLPanel styleName="aon-finding-title">
								<g:HTMLPanel styleName="aon-finding-title-internal">
									<g:Label styleName="aon-outputText">Edici&oacute;n</g:Label>
								</g:HTMLPanel>
							</g:HTMLPanel>
							<g:HTMLPanel styleName="aon-finding-subtitle">
								<g:HTMLPanel styleName="aon-finding-subtitle-internal">
									<g:Label styleName="aon-outputText"></g:Label>
								</g:HTMLPanel>
							</g:HTMLPanel>
							<g:HorizontalPanel styleName="aon-finding-toolbar">
								<g:HTMLPanel styleName="aon-finding-toolbar-item-group">
									<g:Button ui:field="fxButton"
										styleName='aon-finding-toolbar-item {res.css.aonIconFx}' enabled="false" />
									<g:Button ui:field="undoAllButton"
										styleName='aon-finding-toolbar-item {res.css.aonIconUndoAll}' />
									<g:Button ui:field="undoButton"
										styleName='aon-finding-toolbar-item {res.css.aonIconUndo}' enabled="false" visible="false"/>
									<g:Button ui:field='redoButton'
										styleName="aon-finding-toolbar-item {res.css.aonIconRedo}" enabled="false" visible="false"/>
								</g:HTMLPanel>
							</g:HorizontalPanel>
						</g:HorizontalPanel>
					</g:FlowPanel>
				</g:FlowPanel>


			</g:north>
			<g:center>
				<g:ScrollPanel styleName="{style.editor}" ui:field="draftScrollPane">
					<g:VerticalPanel styleName="{style.document}">
						<g:VerticalPanel width="auto">

							<g:Grid width="100%">
								<g:row>
									<g:customCell styleName="{style.label}">
										<g:Label>Descripci&oacute;n
										</g:Label>
									</g:customCell>
									<g:customCell styleName="{style.field}">
										<g:TextBox width="100%" ui:field="descriptionTextBox" maxLength="{DESCRIPTION_MAX_LENGTH}"/>
									</g:customCell>
								</g:row>
							</g:Grid>

							<g:HTML styleName="{style.vertical-space}" />

							<g:ScrollPanel ui:field="salaryTableScrollPane">
								<g:FlexTable ui:field="salaryTable"
									styleName="aon-dataTable {style.edit-cells}" />
							</g:ScrollPanel>

							<g:HTML styleName="{style.vertical-space}" />

							<g:FlexTable ui:field="eventsTable" styleName="aon-dataTable" />
							<g:HTML ui:field="eventsTableSpace" styleName="{style.vertical-space}"
								visible="false" />
							<g:FlexTable ui:field="paymentsTable"
								styleName="aon-dataTable {style.edit-rows}" />
							<g:HTML styleName="{style.vertical-space}" />

							<g:FlexTable ui:field="extrasTable"
								styleName="aon-dataTable {style.edit-rows}" />
							<g:HTML styleName="{style.vertical-space}" />

						</g:VerticalPanel>
					</g:VerticalPanel>
				</g:ScrollPanel>
			</g:center>
		</g:DockLayoutPanel>
		<g:DockLayoutPanel unit="PX" ui:field="printPreviewPanel">
			<g:north size="72">

				<g:FlowPanel>

					<g:FlowPanel styleName="aon-finding-title-toolbar">
						<g:HorizontalPanel>
							<g:HTMLPanel styleName="aon-finding-title">
								<g:HTMLPanel styleName="aon-finding-title-internal">
									<g:Label styleName="aon-outputText">Convenio</g:Label>
								</g:HTMLPanel>
							</g:HTMLPanel>
							<g:HTMLPanel styleName="aon-finding-subtitle">
								<g:HTMLPanel styleName="aon-finding-subtitle-internal">
									<g:Label styleName="aon-outputText"></g:Label>
								</g:HTMLPanel>
							</g:HTMLPanel>
							<g:HorizontalPanel styleName="aon-finding-toolbar">
								<g:HTMLPanel styleName="aon-finding-toolbar-item-group">

									<g:ListBox ui:field="typeListBox" />
									<aon:MonthListBox ui:field="previewMonthListBox"
										oldStyles="{style.monthListBox-old}" monthStyles="{style.monthListBox-item}"
										highLightStyles="aon-bold aon-black aon-icon-month-changed {style.monthListBox-item}" />
										
									<g:ListBox ui:field="levelListBox" />

									<g:ListBox ui:field="zoomListBox" />
									<g:Button ui:field='closePreviewButton'
										styleName='aon-finding-toolbar-item aon-icon-cancel' text="CERRAR PRELIMINAR" />

								</g:HTMLPanel>
							</g:HorizontalPanel>
						</g:HorizontalPanel>
					</g:FlowPanel>
				</g:FlowPanel>

			</g:north>
			<g:center>
				<g:ScrollPanel styleName="{style.editor}">
					<g:VerticalPanel styleName="{style.document}">
						<g:HTML styleName="reset" ui:field='printPreviewHTML'
							wordWrap='true' />
					</g:VerticalPanel>
				</g:ScrollPanel>
			</g:center>
		</g:DockLayoutPanel>
	</g:DeckLayoutPanel>

</ui:UiBinder>
