		 @external gwt-TextBox;
		 @external gwt-ListBox;
		 @external aon-Disabled;
		 @external gwt-SuggestBox;
		 
		 
		.issueLabel{
			font-weight: bold;
			width: 40px;
			text-align: center;
			font-size: 10px;
			padding: 2px;
		}
		
		.issueTextBox{
			text-align: center;
			width: 50px;
		}
		
		.p2{
			padding: 2px;
			width: 40px;
			text-align: center;
		}
		
		.payPeriodLabel{
			font-weight: bold;
			padding: 2px;
			margin-right: 5px;
		}
		
		.textCenter{
			text-align: center;
		}
		
		.flex{
			display: flex;
			align-items: center;
			gap: 5px;
		}
		
		.cmd_btn{
			background-position: center left;
