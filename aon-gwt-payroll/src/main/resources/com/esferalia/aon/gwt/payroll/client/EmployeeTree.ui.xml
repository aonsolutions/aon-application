<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<ui:UiBinder xmlns:ui='urn:ui:com.google.gwt.uibinder'
	xmlns:g='urn:import:com.google.gwt.user.client.ui' 
	xmlns:aon='urn:import:com.esferalia.aon.gwt.common.client.widget'
	xmlns:payroll='urn:import:com.esferalia.aon.gwt.payroll.client'
	xmlns:commonsolutions='urn:import:com.esferalia.aon.gwt.common.client.widget.solutions'
	>
	
	<ui:with type="com.esferalia.aon.gwt.common.client.css.AonResources" field="aonResources"></ui:with>

	<ui:style>
	
	@sprite .configIcon {
	     gwt-image: 'configgroup';
	     float: left;
	   }
	   
	.gwt-SplitLayoutPanel .gwt-SplitLayoutPanel-HDragger {
		display: none;
	}
	
	.messageMT {
		margin-top: 5px;
	}
	
	.felxColumn {
		display: flex;
		flex-direction: column;
		gap: .5rem;
	}
	
	.toolbar{
		width: 100%;
		display: flex;
		justify-content: space-between;
		align-items: center;
		height: 40px;
		border-top: 0px none;
		border-bottom: 1px solid rgb(221, 221, 221);
		font-size: 16px;
	}
	
	.heightAll { height: 100%; }

	</ui:style>

	<ui:image field='configgroup' src='configgroup.png' />
	<ui:image field='employeesgroup' src='employeesgroup.png' />


	<g:DockLayoutPanel ui:field="dockLayoutPanel"  styleName="aon-EmployeeTree" >
		<g:north size="35" >
			<commonsolutions:AonEmployeesToolbar ui:field="toolbar" styleName="{style.toolbar} aon-MainAgreement-ToolBar"/>
		</g:north>

		<g:west size='275' >
				<payroll:Employees ui:field='employees' extended="true" formers="false" styleName="aon-EmployeeTree-Employees" />
		</g:west>
		
		<g:center>
			<g:HTMLPanel styleName="{style.felxColumn}">
				<g:HTMLPanel ui:field="messagePanel" debugId="messagePanel" styleName="{style.messageMT} aon-EmployeeTree-Messages" />
				<aon:DetailPanel ui:field='employeeDetail' styleName="aon-EmployeeTree-EmployeeDetail" />
			</g:HTMLPanel>
		</g:center>

		<g:south size="0">
			<aon:solutions.AonMinimizePanel ui:field="footPanel" styleName="{aonResources.css.aonSelector} aon-EmployeeTree-Events">
				<g:TabLayoutPanel barHeight="26" barUnit="PX" ui:field="footTabPanel" addStyleNames="aon-pointer-events-auto"/>
			</aon:solutions.AonMinimizePanel>
		</g:south>

	</g:DockLayoutPanel>

</ui:UiBinder>
