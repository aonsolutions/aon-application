<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<ui:UiBinder xmlns:ui='urn:ui:com.google.gwt.uibinder'
	xmlns:g='urn:import:com.google.gwt.user.client.ui' 
	xmlns:aon='urn:import:com.esferalia.aon.gwt.common.client.widget'
	xmlns:payroll='urn:import:com.esferalia.aon.gwt.payroll.client'
	>
	
	<ui:with type="com.esferalia.aon.gwt.common.client.css.AonResources" field="aonResources"></ui:with>

	<ui:style>
	
	.stackHeader {
	  padding: .7em .5em .7em .6em;
	  
	}

	@sprite .configIcon {
	     gwt-image: 'configgroup';
	     float: left;
	   }

	@sprite .employeesIcon {
	     gwt-image: 'employeesgroup';
	     float: left;
	   }
	 
	</ui:style>

	<ui:image field='configgroup' src='configgroup.png' />
	<ui:image field='employeesgroup' src='employeesgroup.png' />


	<g:SplitLayoutPanel ui:field="splitLayoutPanel">
		<g:west size='275'>

			<g:StackLayoutPanel unit='EM'>

				<g:stack ui:field="employeesStack" >
					<g:header size='3'>									
						<div class='{style.stackHeader}'>
							<div class='{style.employeesIcon}' />
							EMPLEADOS
						</div>
					</g:header>
					<payroll:Employees ui:field='employees' extended="true" formers="false"/>
				</g:stack>

			</g:StackLayoutPanel>


		</g:west>
		<g:center>
			<aon:DetailPanel ui:field='employeeDetail' />
		</g:center>

		<g:south size="0">
			<aon:MinimizePanel ui:field="footPanel" styleName="{aonResources.css.aonSelector}" >
				<g:TabLayoutPanel barHeight="26" barUnit="PX" ui:field="footTabPanel" addStyleNames="aon-pointer-events-auto"/>
			</aon:MinimizePanel>
		</g:south>

	</g:SplitLayoutPanel>

</ui:UiBinder>
