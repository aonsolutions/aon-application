<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<ui:UiBinder xmlns:ui='urn:ui:com.google.gwt.uibinder'
	xmlns:g='urn:import:com.google.gwt.user.client.ui' 
	xmlns:aon='urn:import:com.esferalia.aon.gwt.common.client.widget'
	xmlns:payroll='urn:import:com.esferalia.aon.gwt.payroll.client'
	>
	
	<ui:with type="com.esferalia.aon.gwt.common.client.css.AonResources" field="aonResources"></ui:with>

	<ui:style>
	
	@sprite .configIcon {
	     gwt-image: 'configgroup';
	     float: left;
	   }
	   
	.gwt-SplitLayoutPanel .gwt-SplitLayoutPanel-HDragger {
		display: none;
	}
	
	.messageMT {
		margin-top: 5px;
	}

	</ui:style>

	<ui:image field='configgroup' src='configgroup.png' />
	<ui:image field='employeesgroup' src='employeesgroup.png' />


	<g:SplitLayoutPanel ui:field="splitLayoutPanel" debugId="messagePanel"  styleName="aon-EmployeeTree" >
		<g:north size="42" >
			<g:SimpleLayoutPanel ui:field="messagePanel" styleName="{style.messageMT} aon-EmployeeTree-Messages" />
		</g:north>

		<g:west size='275' >
				<payroll:Employees ui:field='employees' extended="true" formers="false" styleName="aon-EmployeeTree-Employees" />
		</g:west>
		
		<g:center>
			<aon:DetailPanel ui:field='employeeDetail' styleName="aon-EmployeeTree-EmployeeDetail" />
		</g:center>

		<g:south size="0">
			<aon:solutions.AonMinimizePanel ui:field="footPanel" styleName="{aonResources.css.aonSelector} aon-EmployeeTree-Events">
				<g:TabLayoutPanel barHeight="26" barUnit="PX" ui:field="footTabPanel" addStyleNames="aon-pointer-events-auto"/>
			</aon:solutions.AonMinimizePanel>
		</g:south>

	</g:SplitLayoutPanel>

</ui:UiBinder>
