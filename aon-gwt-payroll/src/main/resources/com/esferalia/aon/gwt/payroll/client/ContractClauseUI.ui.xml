<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
	xmlns:g='urn:import:com.google.gwt.user.client.ui'
	xmlns:a='urn:import:com.esferalia.aon.gwt.common.client.widget'>

	<ui:with field='res' type='com.esferalia.aon.gwt.common.client.css.AonResources' />

	<ui:style type="com.esferalia.aon.gwt.payroll.client.ContractClauseUI.MyStyle">

		.headerStyle{
			top: -0.5em;
			font-size: 12px;
			margin-left: 10px;
		}
		
		.headerLabelStyle{
			font-weight: bold;
		}

		.maxWidthTB{
			width: 97%;
		}
		
		.maxWidthLB{
			width: 100%;
		}

		.firstColumnTextStyle{
			padding:5px !important;
		}
		
		.styleBorder{
			border-style: solid; 
			width: 975px; 
			border-width: 1px; 
			margin: 20px 10px;
		}
		
		.gridStyle{
			margin-left: 10px;
		}
		
		.footerStyle{
			background-color: #eaeaea;
			padding-top: 5px;
		}
		
		.footerElement{
			margin-left: 10px;
			border: none;
		}
		
		.scrollStyle {
			margin-left: 10px;
			margin-bottom: 10px;
		}
		
		.columnWidth{
			width: 80px;
		}
		
		.columnWidth2{
			width: 150px;
		}
		
		.columnWidth3{
			width: 200px;
		}
		
		.columnWidth4{
			width: 515px;
		}
		
		.columnWidth5{
			width: 515px;
		}
		
		.clauseTD{
			vertical-align: top;
			text-align: center;
		}
		
		.clauseTD2{
			vertical-align: top;
		}
		
	</ui:style>

   	<g:HTMLPanel> 
        <g:VerticalPanel ui:field="clausesTable" styleName="{style.styleBorder}"> 
	    	<g:Label width="105px" styleName='aon-group-title {style.headerStyle}'>Cláusulas</g:Label>
	    	<g:HTMLPanel styleName="aon-width-all aon-height-all" debugId="paymetDialogHTMLPanel">
	    		<g:VerticalPanel>
	    			<g:Grid ui:field="clausesDataTableHeader" styleName="{style.gridStyle}"></g:Grid>
	    			<g:HTMLPanel>
	    				<hr align="left" noshade="noshade" style="margin-bottom: 10px;border-width: 0.5px;margin-left: 10px;"/>
	    			</g:HTMLPanel>
		    		<g:ScrollPanel ui:field="clausesScrollPanel" styleName="{style.scrollStyle}">
		    			<g:Grid ui:field="clausesDataTable"></g:Grid>
		    		</g:ScrollPanel>
		    		<g:HTMLPanel styleName="{style.footerStyle}">
	    				<g:Label ui:field="newClause" styleName="aon-finding-toolbar-item aon-icon-reset {style.footerElement}">NUEVO</g:Label>
	    			</g:HTMLPanel>
	    		</g:VerticalPanel>
	    	</g:HTMLPanel>
		</g:VerticalPanel>
	</g:HTMLPanel> 
</ui:UiBinder> 

