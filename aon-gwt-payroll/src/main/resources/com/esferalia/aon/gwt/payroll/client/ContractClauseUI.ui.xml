<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
	xmlns:g='urn:import:com.google.gwt.user.client.ui'
	xmlns:a='urn:import:com.esferalia.aon.gwt.common.client.widget'>

	<ui:with field='res' type='com.esferalia.aon.gwt.common.client.css.AonResources' />

	<ui:style type="com.esferalia.aon.gwt.payroll.client.ContractClauseUI.MyStyle">

		.headerLabelStyle{
			font-weight: bold;
		}

		.maxWidthTB{
			width: 97%;
		}
		
		.maxWidthLB{
			width: 100%;
		}
		
		.styleBorder{
			border-style: solid; 
			width: 930px; 
			border-width: 1px; 
			margin: 20px 10px;
		}
		
		.gridStyle{
			margin-left: 10px;
			width: 905px;
		}
		
		.scrollStyle {
			margin-left: 10px;
			width: 905px;
			margin-bottom: 10px;
		}
		
		.clauseTD{
			vertical-align: top;
			text-align: center;
		}
		
		.footerToolbar{
			padding: 10px;
			display: flex;
		    align-items: center;
		    justify-content: space-between;
		}
		
		.footerOptionsToolbar{
			display: flex;
		    align-items: center;
		}
		
		.tittle{
			top: -1.2em;
			font-size: 12px;
			margin-left: 10px;
			position: relative;
			width: 150px;
			background-color: white;
			padding: 5px;
			text-align: center;
		}
		
		.flexColumn{
			display: flex;
			flex-direction: column;
		}
		
		.loadingPanel{
			display: flex;
			justify-content: center;
			gap: .5rem;
		}
		
		.flex{
			display: flex;
			align-items: center;
			gap: .5rem;
			justify-content: flex-end;
		}
		
		.loading{
			display: flex;
			align-items: center;
			animation-name: spin;
			animation-duration: 2500ms;
			animation-iteration-count: infinite;
			animation-timing-function: linear;
		}
		
		@keyframes spin {
		    from {
		        transform:rotate(0deg);
		    }
		    to {
		        transform:rotate(360deg);
		    }
		}
		
		.minHeight {
			min-height: 390px;
		}
		
	</ui:style>

	<g:HTMLPanel styleName="{style.flexColumn}">
   		<g:VerticalPanel ui:field="clausesTable" styleName="{style.styleBorder}"> 
	    	<g:Label styleName='{style.tittle}'>Cláusulas</g:Label>
	    	<g:HTMLPanel styleName="aon-width-all aon-height-all">
	    		<g:VerticalPanel>
	    			<g:Grid ui:field="clausesDataTableHeader" styleName="{style.gridStyle}"></g:Grid>
	    			<g:HTMLPanel>
	    				<hr align="left" noshade="noshade" style="margin-bottom: 10px;border-width: 0.5px;margin-left: 10px;"/>
	    			</g:HTMLPanel>
	    			<g:DeckPanel ui:field="deckPanel">
		    			<g:ScrollPanel ui:field="clausesScrollPanel" styleName="{style.scrollStyle}">
			    			<g:Grid ui:field="clausesDataTable"></g:Grid>
			    		</g:ScrollPanel>
			    		<g:HTMLPanel ui:field="loadingClausesPanel" styleName="{style.loadingPanel} {style.minHeight}" />
			    		<g:HTMLPanel styleName="{style.loadingPanel} {style.minHeight}">
			    			<g:Label>NO HAY CLAUSULAS DISPONIBLES</g:Label>
			    		</g:HTMLPanel>
	    			</g:DeckPanel>
		    		
	    		</g:VerticalPanel>
	    	</g:HTMLPanel>
		</g:VerticalPanel>
	</g:HTMLPanel> 
	
</ui:UiBinder> 

