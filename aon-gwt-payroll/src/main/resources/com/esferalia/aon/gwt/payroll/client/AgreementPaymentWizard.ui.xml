<ui:UiBinder 
    xmlns:ui='urn:ui:com.google.gwt.uibinder'
	xmlns:g='urn:import:com.google.gwt.user.client.ui'
	xmlns:a='urn:import:com.esferalia.aon.gwt.common.client.widget'>
    
    
	<ui:style type="com.esferalia.aon.gwt.payroll.client.AgreementPaymentWizard.MyStyle">
	
		.body {
			margin-top: 5px;
			padding: 20px 10px;
			display: flex;
			flex-direction: column;
			height: 375px;
			min-width: 500px;
		}
		
		.deckPanel{
			height: 200px;
			min-width: 400px;
		}
		
		.title{
			font-weight: bold;
		}
		
		.pagePanel{
			display: flex;
			flex-direction: column;
			width: auto !important;
		}
		
		.flexColumnPanel{
			display: flex;
			flex-direction: column;
			padding: 5px 20px;
		}
		
		.flexColumn{
			display: flex;
			flex-direction: column;
		}
		
		.flexColumn2{
			display: flex;
			flex-direction: column;
		}
		
		.flexCenter{
			display: flex;
			justify-content: center;
		}
		
		.flex{
			display: flex;
			gap: 5px;
			align-items: center;
		}
		
		.buttonsPanel{
			display: flex;
			padding: 0px 30px;
			align-items: center;
			margin-bottom: 45px;
		}
		
		.buttonPage{
			border: 1px solid #eee;
			border-radius: 50%;
			background-color: transparent;
			font-weight: bold;
			width: 60px;
			height: 50px;
			cursor: pointer;
		}
		
		.buttonFillPage{
			background-color: #eee;
		}
		
		.line{
			width: 100%;
			height: 5px;
			border: 1px solid #eee;
		}
		
		.lineFill{
			background-color: #eee;
		}
		
		.buttonsAcceptCancelPanel{
			display: flex;
			justify-content: flex-end;
			margin: 5px 20px;
		}
		
		.uppercase{
			text-transform: uppercase;
		}
		
		.visibilityDisabled{
			display: block !important;
			visibility: visible !important;
		}
		
		.flexPanel{
			display: flex;
			gap: 15px;
			padding: 5px 20px;
			align-items: flex-end;
		}
		
		.w180{
			width: 180px !important;
		}
		
		.maxWidth{
			width: 100%;
		}
		
	</ui:style>
	
	<g:DockLayoutPanel ui:field="dockLayoutPanel" styleName="{style.body}">
		<g:center>
			<g:DockLayoutPanel styleName="{style.body}">
				<g:center>
					
					<g:HTMLPanel styleName="{style.flexColumn}">
				
						<g:DeckLayoutPanel ui:field="deckPanel" styleName="{style.deckPanel}">
							
							<g:HTMLPanel ui:field="firstPage" styleName="{style.pagePanel}">
								
								<g:HTMLPanel styleName="{style.flexPanel}">
									<g:HTMLPanel ui:field="paymentTypePanel" styleName="{style.flexColumn}">
										<g:Label styleName="{style.title}">Tipo de devengo</g:Label>
										<g:ListBox ui:field="paymentType" styleName="aon-selectOneMenu {style.w180}" />
									</g:HTMLPanel>
									<g:HTMLPanel ui:field="extraPanel" styleName="{style.flexColumn} {style.maxWidth}">
										<g:Label ui:field="extraLabel" styleName="{style.title}"/>
										<g:TextBox ui:field="extraName" styleName="aon-inputText {style.uppercase} {style.maxWidth}" />
									</g:HTMLPanel>
								</g:HTMLPanel>
								
								<g:HTMLPanel styleName="{style.flexPanel}">
									<g:HTMLPanel ui:field="periodicityPanel" styleName="{style.flexColumn}">
										<g:Label styleName="{style.title}">Periocidad devengo</g:Label>
										<g:ListBox ui:field="periodicityType" styleName="aon-selectOneMenu {style.w180}" />
									</g:HTMLPanel>
									<g:HTMLPanel ui:field="partialityPanel" styleName="{style.flex}">
										<g:Label styleName="{style.title}">¿Aplicar parcialidad?</g:Label>
										<g:Button ui:field="partialityButton" />
									</g:HTMLPanel>
								</g:HTMLPanel>
								
							</g:HTMLPanel>
							
							<!-- g:HTMLPanel ui:field="secondPage" styleName="{style.pagePanel}">
								<g:HTMLPanel ui:field="partialityPanel" styleName="{style.flex}">
									<g:Label styleName="{style.title}">¿Aplicar parcialidad?</g:Label>
									<g:Button ui:field="partialityButton" />
								</g:HTMLPanel>
							</g:HTMLPanel -->
							
						</g:DeckLayoutPanel>
					
						<!-- g:HTMLPanel ui:field="prevNextButtons" styleName="{style.flexCenter}"/ -->
						
						<!-- g:HTMLPanel ui:field="buttonsPanel" styleName="{style.buttonsPanel}">
							<g:Button ui:field="firstButton" styleName="{style.buttonPage}">1</g:Button>
							<g:HTMLPanel ui:field="firstLine" styleName="{style.line}"/>
							<g:Button ui:field="secondButton" styleName="{style.buttonPage}">2</g:Button>
						</g:HTMLPanel -->
						
						<g:HTMLPanel styleName="{style.flexColumnPanel}">
							<g:HTMLPanel ui:field="paymentConceptPanel" styleName="{style.flexColumn2}">
								<g:Label styleName="{style.title}">Concepto</g:Label>
								<g:TextBox ui:field="paymentConcept" />
							</g:HTMLPanel>
							<g:HTMLPanel ui:field="paymentCRATypePanel" styleName="{style.flexColumn2}">
								<g:Label styleName="{style.title}">Tipo CRA</g:Label>
								<g:HTMLPanel ui:field="paymentCRAPanel" />
							</g:HTMLPanel>
							<g:HTMLPanel ui:field="paymentDescriptionPanel" styleName="{style.flexColumn2}">
								<g:Label styleName="{style.title}">Devengo</g:Label>
								<g:TextBox ui:field="paymentDescription" />
							</g:HTMLPanel>
							<g:HTMLPanel ui:field="paymentExpressionPanel" styleName="{style.flexColumn2}">
								<g:Label styleName="{style.title}">Expresión</g:Label>
								<g:TextBox ui:field="paymentExpression" enabled="false"/>
							</g:HTMLPanel>
						</g:HTMLPanel>
						
					</g:HTMLPanel>
					
				</g:center>
			</g:DockLayoutPanel>
		</g:center>
		<g:south size="40">
			<g:HTMLPanel ui:field="buttonsAcceptCancelPanel" styleName="{style.buttonsAcceptCancelPanel}"></g:HTMLPanel>
		</g:south>
	</g:DockLayoutPanel>

</ui:UiBinder>