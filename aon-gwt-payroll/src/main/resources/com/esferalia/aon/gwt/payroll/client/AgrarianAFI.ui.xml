<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<ui:UiBinder xmlns:ui='urn:ui:com.google.gwt.uibinder'
	xmlns:g='urn:import:com.google.gwt.user.client.ui'>

	<ui:Style type="com.esferalia.aon.gwt.payroll.client.AgrarianAFI.MyStyle">
	
		.styleBorder{
			border-style: solid;
			border-width: 1px; 
			margin: 15px 2px 15px 0px;
			width: 99%;
		}
		
		.headerStyle{
			top: -0.5em;
			font-size: 12px;
			margin-left: 10px;
		}
		
		.bold{
			font-weight: bold;
		}
		
		.hide{
			display: none;
		}
		
		.paddingText2{
			padding: 3px 5px;
		}
		
		.widthName{
			width: intrinsic;           /* Safari/WebKit uses a non-standard name */
  			width: -moz-max-content;    /* Firefox/Gecko */
  			width: -webkit-max-content; /* Chrome */	
		}
		
		.paddingDays{
			padding: 2px;
		}
		
		.widthDays{
			width: 18px;
		}
		
		.textCenter{
			text-align: center;
		}
		
		.paddingTable{
			padding: 0px 0px 0px 10px;
		}
		
		.paddingText{
			padding: 0px 0px 0px 5px;
		}
		
		.margingListBox{
			margin: 0px 0px 0px 5px;
		}
		
		.widthFirstColumn{
			width: 200px;
		}
	
	</ui:Style>

	<g:DockLayoutPanel unit="EM" styleName="aondockLayoutPanel-template">
		<g:north size="2">
			<g:FlowPanel styleName="aon-finding-title-toolbar">
				<g:HorizontalPanel  visible="true">
					<g:HTMLPanel styleName="aon-finding-title">
						<g:HTMLPanel styleName="aon-finding-title-internal">
							<g:Label styleName="aon-outputText" text="AFI - Régimen Especial Agrario Jornadas" />
						</g:HTMLPanel>
					</g:HTMLPanel>
					<g:HorizontalPanel  styleName="aon-finding-toolbar">
						<g:HTMLPanel styleName="aon-finding-toolbar-item-group">
							<g:Label styleName="aon-outputText" text="" />
							<g:Button ui:field="exportButton" visible="true" styleName='aon-finding-toolbar-item aon-icon-accept'>GENERAR AFI</g:Button>
						</g:HTMLPanel>
					</g:HorizontalPanel>
				</g:HorizontalPanel>
			</g:FlowPanel>
		</g:north>
		<g:center>
			<g:DockLayoutPanel unit="EM" styleName="aondockLayoutPanel-template">
				<g:north size="12">
					<g:HTMLPanel styleName="aon-width-all aon-height-all {style.paddingTable}"> 
						<table class="aon-width-all aon-height-all">
							<tr>
								<td>
									<g:HTMLPanel>
										<g:VerticalPanel styleName="{style.styleBorder}">
											<g:Label styleName="aon-group-title {style.headerStyle}">Datos Jonada</g:Label>
											<g:HTMLPanel>
												<table class="aon-width-all aon-height-all" ui:field="dataTable">
													<tr>
														<td style="background-color: #eaeaea; width: 100px; height: 22px;">
															<g:Label>Empresa:</g:Label>
														</td>
														<td>
															<g:Label ui:field="enterprise"></g:Label>
														</td>
													</tr>
													<tr>
														<td style="background-color: #eaeaea; width: 100px; height: 22px;">
															<g:Label>CCC:</g:Label>
														</td>
														<td>
															<g:ListBox ui:field="cccs" styleName="{style.margingListBox}"></g:ListBox>
														</td>
													</tr>
													<tr>
														<td style="background-color: #eaeaea; width: 100px;  height: 22px;">
															<g:Label>Mes documento</g:Label>
														</td>
														<td>
															<g:HorizontalPanel>
																<g:Label styleName="{style.paddingText2}">Mes:</g:Label>
																<g:ListBox ui:field="monthList" styleName="aon-selectOneMenu"></g:ListBox>
																<g:Label styleName="{style.paddingText2}">Año:</g:Label>
																<g:ListBox ui:field="yearList" styleName="aon-selectOneMenu"></g:ListBox>
																<g:Button ui:field="searchAgrarian" styleName="aon-lookupButton"></g:Button>
															</g:HorizontalPanel>
														</td>
													</tr>
												</table>
											</g:HTMLPanel>
										</g:VerticalPanel>
									</g:HTMLPanel>
								</td>
							</tr>
						</table>
					</g:HTMLPanel>
				</g:north>
				<g:center>
					<g:HTMLPanel styleName="aon-width-all {style.paddingTable}"> 
						<table class="aon-width-all">
							<tr>
								<td>
									<g:VerticalPanel ui:field="employeePanel" styleName="{style.styleBorder}">
										<g:Label styleName="aon-group-title {style.headerStyle}">Empleados</g:Label>
										<g:Grid ui:field="employeeTable"></g:Grid>
									</g:VerticalPanel>
								</td>
							</tr>
						</table>
					</g:HTMLPanel>
				</g:center>
			</g:DockLayoutPanel>
		</g:center>
	</g:DockLayoutPanel>
</ui:UiBinder>