<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<ui:UiBinder xmlns:ui='urn:ui:com.google.gwt.uibinder'
	xmlns:g='urn:import:com.google.gwt.user.client.ui' 
	xmlns:cell="urn:import:com.google.gwt.user.cellview.client">

	<ui:style type="com.esferalia.aon.gwt.payroll.client.CretaDetail.MyStyle">
		
		.flexColumn{
			display: flex;
			flex-direction: column;
			width: 100%;
			height: 100%;
		}
		
		.container{
			margin-top: 50px;
			padding: 10px 15px;
		}
		
		.grid {
			margin-left: 18px;
			margin-rigth: 18px;
			width: 100%;
			height: 100%;
		}
	
		@external .aon-finding-title;
		
		.aon-finding-title{
			height: auto !important;		
		}

		@external .aon-finding-title-toolbar;
		
		.aon-finding-title-toolbar {
			height: auto !important;		
		}
		
		.cmd_btn{
			background-position: center left;
			background-repeat: no-repeat;
			padding-left: 25px !important;
			background-size: contain;
		}
					
	</ui:style>

	<ui:import field="com.google.gwt.user.client.ui.FormPanel.*" />
	<ui:import field="com.esferalia.aon.gwt.payroll.shared.CretaService.*" />
	<ui:import field="com.esferalia.aon.gwt.payroll.shared.CretaService.File.*" />

	<g:DockLayoutPanel unit="PX" ui:field="dockLayoutPanel">
		<g:center>
			<g:HTMLPanel styleName="{style.flexColumn} {style.container}">
				<cell:DataGrid ui:field="dataGrid" />
				<g:FormPanel visible="false" ui:field="formPanel" method="{METHOD_POST}" action="{CRETA_URL}/{TRABAJADORES_TRAMOS.name}"  encoding="{ENCODING_MULTIPART}">
					<g:FileUpload visible="false"  name="{TRABAJADORES_TRAMOS.name}" ui:field="fileUpload" />
				</g:FormPanel>
			</g:HTMLPanel>
		</g:center>
	</g:DockLayoutPanel>

</ui:UiBinder>
