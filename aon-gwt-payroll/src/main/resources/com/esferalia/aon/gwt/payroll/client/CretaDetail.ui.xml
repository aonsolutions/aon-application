<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<ui:UiBinder xmlns:ui='urn:ui:com.google.gwt.uibinder'
	xmlns:g='urn:import:com.google.gwt.user.client.ui' 
	xmlns:cell="urn:import:com.google.gwt.user.cellview.client"
>

	<ui:style>
			
	</ui:style>

	<ui:import field="com.google.gwt.user.client.ui.FormPanel.*" />
	<ui:import field="com.esferalia.aon.gwt.payroll.shared.CretaService.*" />
	<ui:import field="com.esferalia.aon.gwt.payroll.shared.CretaService.File.*" />

	<g:DockLayoutPanel unit="PX" >
		<g:north size="72"  >

			<g:FlowPanel >

				<g:MenuBar >
					<g:MenuItem text="SILTRA">
						<g:MenuBar vertical="true">
							<g:MenuItem styleName="aon-icon-segsocial-small aon-icon-commandButton" ui:field="msjRecMenuItem"  text="Mensajes Recibidos" />
							<g:MenuItem styleName="aon-icon-segsocial-small aon-icon-commandButton" ui:field="basesMenuItem"  text="{BASES.getFilename}" enabled="false"/>
						</g:MenuBar>
					</g:MenuItem>
				</g:MenuBar>
				
				<g:FlowPanel styleName="aon-finding-title-toolbar" >
					<g:HorizontalPanel >
						<g:HTMLPanel styleName="aon-finding-title">
							<g:HTMLPanel styleName="aon-finding-title-internal" >
								<g:Label styleName="aon-outputText" >Sistema de Liquidaci&oacute; Directa (Proyecto Cret@)</g:Label>
							</g:HTMLPanel>
						</g:HTMLPanel>
						<!--  g:HTMLPanel styleName="aon-finding-subtitle">
							<g:HTMLPanel styleName="aon-finding-aubtitle-internal" >
								<g:Label styleName="aon-outputText" text="Seguimiento de Liquidaciones"/> 
							</g:HTMLPanel>
						</g:HTMLPanel-->
						<g:HorizontalPanel styleName="aon-finding-toolbar">
							<g:HTMLPanel styleName="aon-finding-toolbar-item-group" >
								<g:Button ui:field='msjRecButton' styleName='aon-finding-toolbar-item aon-icon-segsocial-small aon-uppercase' text="Mensajes Recibidos" /> 
								<g:Button ui:field='basesButton' styleName='aon-finding-toolbar-item aon-icon-segsocial-small aon-uppercase' text="{BASES.getFilename}" enabled="false"/> 
							</g:HTMLPanel>
						</g:HorizontalPanel>
					</g:HorizontalPanel>
				</g:FlowPanel>				

				<g:FormPanel visible="false" ui:field="formPanel" method="{METHOD_POST}" action="{CRETA_URL}/{TRABAJADORES_TRAMOS.name}"  encoding="{ENCODING_MULTIPART}">
					<g:FileUpload visible="false"  name="{TRABAJADORES_TRAMOS.name}" ui:field="fileUpload" />
				</g:FormPanel>
				

			</g:FlowPanel>

		</g:north>

		<g:center>
			<cell:DataGrid ui:field="dataGrid" />
		</g:center>

	</g:DockLayoutPanel>

</ui:UiBinder>
