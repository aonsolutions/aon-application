<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
	xmlns:g='urn:import:com.google.gwt.user.client.ui'>

	<ui:style type="com.esferalia.aon.gwt.payroll.client.Workplace.MyStyle">

		.container {
			margin: 1rem 1rem 0;
			display: flex;
			flex-direction: column;
		}
		
		.firstColumn{
			min-width: 200px;
			padding: 5px;
			background-color: #f6f6f6; 
		}
		
		.flex{
			display: flex;
			align-items: center;
			width: 100%;
			margin: 2px 0;
			gap: 5px;
		}
		
		.flexColumn{
			display: flex;
			justify-content: center;
			align-items: center;
			flex-direction: column;
		}
		
		.heightAll { height: 100%; }
		
		.inputPadding { padding: 0 0 0 .5rem; }

		.inputLBHeight { 
			height: 1.4rem !important; 
			border-radius: 0;
			text-transform: uppercase;
		}
		
		.inputTextHeight { 
			height: 1.2rem !important; 
			text-transform: uppercase;	
		}
		
		.mt20 { margin-top: 20px; }
		
		.requiredColor{
			color: #2152A5;
			font-weight: bold !important;
		}
		
		.styleBorder{
			border: 1px solid black;
			border-radius: 5px;
			padding: 0 1rem .5rem;
		}
		
		.tittle{
			position: relative;
			top: -10px;
			left: 20px;
			width: 130px;
			padding: 0 5px;
			background-color: white;
			font-size: 12px;
			font-weight: bold;
			text-align: center;
		}
		
		.warningTB { border: 1px solid red; }
		
		.widthAll { width: 100%; }
		
		@external warningTB;
		
	</ui:style>
	
	<g:HTMLPanel styleName="{style.container}">
		<g:HTMLPanel styleName="{style.widthAll} {style.heightAll}">
	   		<g:HTMLPanel styleName="{style.styleBorder}">
	    		<g:Label styleName='{style.tittle}'>Datos Generales</g:Label>
		    	<g:HTMLPanel styleName="{style.widthAll} {style.heightAll} {style.flexColumn}">
		    		<g:HTMLPanel ui:field="workplaceDescriptionPanel" styleName="{style.flex}">
		    			<g:Label  styleName='{style.requiredColor} {style.firstColumn}'>Descripción</g:Label>
		    			<g:TextBox ui:field="workplaceDescription" debugId="workplaceDescriptionTB" styleName='aon-inputText {style.inputTextHeight}  {style.inputPadding} {style.widthAll}' />
					</g:HTMLPanel>
					<g:HTMLPanel ui:field="workplaceAddressParentPanel" styleName="{style.flex}">
		    			<g:Label  styleName='{style.requiredColor} {style.firstColumn}'>Dirección</g:Label>
		    			<g:HTMLPanel ui:field="workplaceAddressPanel" styleName='{style.widthAll}' />
					</g:HTMLPanel>
					<g:HTMLPanel styleName="{style.flex}">
		    			<g:Label styleName='{style.firstColumn}'>Concierto económico</g:Label>
		    			<g:ListBox ui:field="workplaceEconomicConcert" styleName='aon-selectOneMenu {style.inputLBHeight} {style.inputPadding} {style.widthAll}' />
					</g:HTMLPanel>
		    	</g:HTMLPanel>
		    </g:HTMLPanel>
	   	</g:HTMLPanel>
	   	
	   	<g:HTMLPanel styleName="{style.widthAll} {style.heightAll} {style.mt20}" debugId="activityHTMLPanel">
	   		<g:HTMLPanel styleName="{style.styleBorder} ">
	    		<g:Label styleName='{style.tittle}'>Datos Laborables</g:Label>
		    	<g:HTMLPanel styleName="{style.widthAll} {style.heightAll} {style.flexColumn}">
		    		<g:HTMLPanel ui:field="workplaceCalendarHTMLPanel" styleName="{style.flex}">
		    			<g:Label  styleName='{style.firstColumn}'>Calendario</g:Label>
		    			<g:HTMLPanel ui:field="workplaceCalendarPanel" styleName='{style.widthAll}' />
					</g:HTMLPanel>
					<g:HTMLPanel styleName="{style.flex}">
		    			<g:Label  styleName='{style.firstColumn}'>Convenio</g:Label>
		    			<g:HTMLPanel ui:field="workplaceAgreementPanel" styleName='{style.widthAll}' />
					</g:HTMLPanel>
					<g:HTMLPanel styleName="{style.flex}">
		    			<g:Label styleName='{style.firstColumn}'>Actividad</g:Label>
		    			<g:HTMLPanel ui:field="workplaceActivityPanel" styleName='{style.widthAll}' />
					</g:HTMLPanel>
		    	</g:HTMLPanel>
		    </g:HTMLPanel>
	   	</g:HTMLPanel>
	</g:HTMLPanel>
			
</ui:UiBinder> 

