<ui:UiBinder xmlns:ui='urn:ui:com.google.gwt.uibinder'
	xmlns:g='urn:import:com.google.gwt.user.client.ui' xmlns:aon='urn:import:com.esferalia.aon.gwt.common.client.widget'
	xmlns:c="urn:import:com.google.gwt.user.cellview.client" xmlns:b="http://java.sun.com/jstl/core"
	xmlns:common='urn:import:com.esferalia.aon.gwt.common.client.widget'>
	
	
	<g:DockLayoutPanel unit="EM" styleName="aondockLayoutPanel-template">
	
		<g:north size="2">
			<g:FlowPanel styleName="aon-finding-title-toolbar">
				<g:HorizontalPanel  visible="true">
					<g:HTMLPanel styleName="aon-finding-title">
						<g:HTMLPanel styleName="aon-finding-title-internal">
							<g:Label styleName="aon-outputText" text="Resumen de actividad" />
						</g:HTMLPanel>
					</g:HTMLPanel>
					<g:HTMLPanel styleName="aon-finding-subtitle">
						<g:HTMLPanel styleName="aon-finding-subtitle-internal">
							<g:Label styleName="aon-outputText" text="Listado" />
						</g:HTMLPanel>
					</g:HTMLPanel>
					<g:HorizontalPanel  styleName="aon-finding-toolbar">
						<g:HTMLPanel styleName="aon-finding-toolbar-item-group">
							<g:Label styleName="aon-outputText" text="" />
							<g:Button ui:field="exportButton" visible="true" styleName='aon-finding-toolbar-item aon-icon-export-excel-trans'
								/>
						</g:HTMLPanel>
					</g:HorizontalPanel>
				</g:HorizontalPanel>
			</g:FlowPanel>
		</g:north>
	
		<g:center>
					
			<g:DockLayoutPanel unit="EM" styleName="aondockLayoutPanel-template">
				<g:north size="16">
					<g:HTMLPanel styleName="aon-panelGrid-search searchPanel-template">
						
						<div class="aon-panelGrid-search-info">
							<span class="aon-panelGrid-search-info-internal">Filtrar:</span>
						</div>
						
						<g:Grid>
							<g:row>
								<g:customCell>
									<g:HTMLPanel>
										<span class="aon-panelGrid-search-info-internal2-template">Desde:</span>
										<common:DateBoxEx ui:field="startDate" />
									</g:HTMLPanel>
								</g:customCell>
								<g:customCell>
									<g:HTMLPanel>
										<span class="aon-panelGrid-search-info-internal2-template">Hasta:</span>
										<common:DateBoxEx ui:field="endDate" />
									</g:HTMLPanel>
								</g:customCell>
							</g:row>
						</g:Grid>
						
						<g:Grid>
							<g:row>
								<g:customCell>
									<g:HTMLPanel>
										<span class="aon-panelGrid-search-info-internal2-template">Contratos</span>
									</g:HTMLPanel>
								</g:customCell>
								<g:customCell>
									<g:HTMLPanel>
										<g:CheckBox text="Altas" ui:field="startChk" />
									</g:HTMLPanel>
								</g:customCell>
								<g:customCell>
									<g:HTMLPanel>
										<g:CheckBox text="Bajas" ui:field="endChk" />
									</g:HTMLPanel>
								</g:customCell>
							</g:row>
							<g:row>
								<g:customCell>
									<g:HTMLPanel>
										<span class="aon-panelGrid-search-info-internal2-template">Recibos</span>
									</g:HTMLPanel>
								</g:customCell>
								<g:customCell>
									<g:HTMLPanel>
										<g:CheckBox text="Nomina" ui:field="salaryChk" />
									</g:HTMLPanel>
								</g:customCell>
								<g:customCell>
									<g:HTMLPanel>
										<g:CheckBox text="Extra" ui:field="salaryExtraChk" />
									</g:HTMLPanel>
								</g:customCell>
								<g:customCell>
									<g:HTMLPanel>
										<g:CheckBox text="Finquito" ui:field="salarySettleChk" />
									</g:HTMLPanel>
								</g:customCell>
								<g:customCell>
									<g:HTMLPanel>
										<g:CheckBox text="Otros" ui:field="salaryOtherChk" />
									</g:HTMLPanel>
								</g:customCell>
							</g:row>								
							<g:row>
								<g:customCell>
									<g:HTMLPanel>
										<span class="aon-panelGrid-search-info-internal2-template">IT</span>
									</g:HTMLPanel>
								</g:customCell>
								<g:customCell>
									<g:HTMLPanel>
										<g:CheckBox text="IT EC/AN" ui:field="itCommonDiseaseChk" />
									</g:HTMLPanel>
								</g:customCell>
								<g:customCell>
									<g:HTMLPanel>
										<g:CheckBox text="IT AT/EP" ui:field="itOccupationalDiseaseChk" />
									</g:HTMLPanel>
								</g:customCell>
								<g:customCell>
									<g:HTMLPanel>
										<g:CheckBox text="IT M/P" ui:field="itMaternityChk" />
									</g:HTMLPanel>
								</g:customCell>
								<g:customCell>
									<g:HTMLPanel>
										<g:CheckBox text="IT Otros" ui:field="itOtherChk" />
									</g:HTMLPanel>
								</g:customCell>
							</g:row>
							
							<g:row>
								<g:customCell>
									<g:Button ui:field="searchButton" />
								</g:customCell>
							</g:row>
						</g:Grid>	
						
					</g:HTMLPanel>
					
				</g:north>
				
				<g:center>
					<c:DataGrid ui:field='dataGrid' visible="true" styleName="aon_dataGrid-template" />
				</g:center>
				
				<g:south size="2">
					<g:Label styleName="aon-outputText" text="" />
				</g:south>
				
				
			</g:DockLayoutPanel>
			
		</g:center>
		
	</g:DockLayoutPanel>
	

</ui:UiBinder>
