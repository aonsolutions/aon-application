<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<ui:UiBinder xmlns:ui='urn:ui:com.google.gwt.uibinder'
	xmlns:g='urn:import:com.google.gwt.user.client.ui'
	xmlns:c='urn:import:com.esferalia.aon.gwt.common.client.widget'
	xmlns:d='urn:import:com.google.gwt.user.cellview.client'>

	<ui:Style type="com.esferalia.aon.gwt.payroll.client.AgreementVariablesDialog.MyStyle">
	
		.form {
			padding: 15px 15px 5px 15px;
		}
	
		.container {
			display: flex;
			flex-direction: column;
			gap: 5px;
			margin-bottom: 20px;
		}
		
		.flex {
			display: flex;
			align-items: center;
			gap: 5px;
		}
		
		.flexColumn {
			display: flex;
			flex-direction: column;
			gap: 5px;
		}
		
		.buttonsPanel {
			display: flex;
			justify-content: flex-end;
			margin: 10px 0px;
			gap: 5px;
		}
		
	</ui:Style>

	<g:HTMLPanel styleName="{style.flexColumn}">
		<g:HTMLPanel ui:field="messagePanel" />
		<g:HTMLPanel styleName="{style.form}">
			<g:HTMLPanel ui:field="container" styleName="aon-width-all aon-height-all" />
			<g:HTMLPanel ui:field="buttonsPanel" styleName="{style.buttonsPanel}" />
		</g:HTMLPanel>
	</g:HTMLPanel>

</ui:UiBinder>