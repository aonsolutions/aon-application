<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<ui:UiBinder xmlns:ui='urn:ui:com.google.gwt.uibinder'
	xmlns:g='urn:import:com.google.gwt.user.client.ui'
	xmlns:a='urn:import:com.esferalia.aon.gwt.payroll.client'
	xmlns:p='urn:import:net.aonsolutions.gwt.pdfjs.client'
>

	<ui:style type="com.esferalia.aon.gwt.payroll.client.Cost.MyStyle">
		
		.editor {
			margin-top: 50px;
		}
		
		.document {
			margin-top: 5px;
			margin-left: auto;
			margin-right: auto;
			margin-bottom: 15px;
		}
		
		.cmd_btn{
			background-position: center left;
			background-repeat: no-repeat;
			padding-left: 25px !important;
			background-size: contain;
		}
		
	</ui:style>
	
	<g:DockLayoutPanel unit="PX" ui:field="dockLayoutPanel">
		<g:center>
			<g:SplitLayoutPanel ui:field="containerSplitLayoutPanel">
				<g:center>
					<g:ScrollPanel styleName="{style.editor}" ui:field="scrollPanel">
						<g:VerticalPanel styleName="{style.document}">
							<g:FlowPanel ui:field="mainPanel"/>
							<p:Viewer styleName="reset" ui:field='pdfViewer' />
						</g:VerticalPanel>
					</g:ScrollPanel>
				</g:center>
			</g:SplitLayoutPanel>
		</g:center>
	</g:DockLayoutPanel>

</ui:UiBinder>
