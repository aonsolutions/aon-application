<ui:UiBinder xmlns:ui='urn:ui:com.google.gwt.uibinder'
	xmlns:g='urn:import:com.google.gwt.user.client.ui' 
	xmlns:aon='urn:import:com.esferalia.aon.gwt.payroll.client'
	xmlns:common='urn:import:com.esferalia.aon.gwt.common.client.widget'
	xmlns:commonsolutions='urn:import:com.esferalia.aon.gwt.common.client.widget.solutions'>
	
	<ui:with type="com.esferalia.aon.gwt.common.client.css.AonResources" field="aonResources" />


	<ui:style type="com.esferalia.aon.gwt.payroll.client.MainTrashAgreement.MyStyle">
	
	.stackHeader {
	  padding: .7em .5em .7em .6em;
	  
	}

	@sprite .agreementIcon {
	     gwt-image: 'agreementgroup';
	     float: left;
	     padding-left: 5px;
	}
	
	.borderR{
		border-right: 1px solid #ddd;
	}
	
	.cmdBtn{
		background-position: center left;
		background-repeat: no-repeat;
		padding-left: 25px !important;
		background-size: contain;
	}
		
	.flexCenter {
		display: flex;
		justify-content: center;
		margin-bottom: 2rem;
	}
	
	.heigthAll {height: 100%;}
			
	.flexColumn {
		display: flex;
		flex-direction: column;
	}
	 
	.message {
		font-weight: bold;
		text-transform: uppercase;
		margin-top: 1rem;
	}
		
	.dialogGlass {
		z-index: 7;
		background-color: #000;
		opacity: 0.2;
		filter: opacity(45%);
	}
	
	.dialogZIndex {
		z-index: 8;
	}
	</ui:style>

	<ui:image field='agreementgroup' src='agreementgroup.png' />
	
	<g:DockLayoutPanel ui:field="splitLayoutPanel" unit="PX">
		<g:north size="45">
			<commonsolutions:AonTrashAgreementsToolbar ui:field="toolbar" />
		</g:north>
		<g:west size='350'>
			<aon:TrashAgreements debugId="agreements" ui:field='agreements' />
		</g:west>
		<g:center>
			<g:HTMLPanel styleName="{style.flexColumn}">
				<g:HTMLPanel ui:field="messagePanel" />
				<g:HTMLPanel ui:field="agreementContainer" styleName="{style.flexColumn} {style.heigthAll}"> 
					<aon:AgreementPreview debugId="agreementPreview" ui:field="agreementPreview" />
				</g:HTMLPanel>
				<!-- AGREEMENT SELECT LABEL -->
				<g:HTMLPanel ui:field="agreementMessage" styleName="{style.flexCenter}">
					<g:Label text="SELECCIONE UN CONVENIO PARA SER VISUALIZADO" styleName="{style.message}" />
				</g:HTMLPanel>
			</g:HTMLPanel>
		</g:center>
	</g:DockLayoutPanel>

	

</ui:UiBinder>
