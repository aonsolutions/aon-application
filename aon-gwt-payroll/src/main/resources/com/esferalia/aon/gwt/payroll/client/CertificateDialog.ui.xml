<ui:UiBinder 
    xmlns:ui='urn:ui:com.google.gwt.uibinder'
	xmlns:g='urn:import:com.google.gwt.user.client.ui'
	xmlns:a='urn:import:com.esferalia.aon.gwt.common.client.widget'
	xmlns:c='urn:import:com.esferalia.aon.gwt.common.client.widget.solutions'>
    
    
	<ui:style type="com.esferalia.aon.gwt.payroll.client.CertificateDialog.MyStyle">
	
		.form {
			display: flex;
			flex-direction: column;
			min-width: 350px;
			gap: 10px;
			padding-top: .5rem;
		}
		
		.padding {
			padding: 10px;
			padding-top: 0px;
		}
		
		.flexColumn{
			display: flex;
			flex-direction: column;
			gap: 10px;
		}
		
		.input{
			display: flex;
			flex-direction: column;
			gap: 5px;
		}
		
		.title{
			font-size: 11px;
			font-weight: bold;
		}
		
		.flex{
			display: flex;
			align-items: center;
			gap: 10px;
		}
		
		.flexBetween{
			display: flex;
			justify-content: space-between;
			width: 100%;
		}
		
		.buttonsPanel{
			display: flex;
			justify-content: flex-end;
			gap: 10px;
			margin-top: 10px;
		}
		
		.widthAll{
			width: 100%;
		}
		
		.checkBox input {
			width: 1rem;
			height: 1rem;
		}
		
		.noGap {
			gap: 0;
		}
		
		.security {
			width: 1.2rem;
			height: 1.2rem;
			background-size: cover;
		}
		
	</ui:style>

	<g:HTMLPanel ui:field="mainPanel" styleName="{style.form}">
	
		<g:HTMLPanel ui:field="messagePanel" />
	
		<g:HTMLPanel ui:field="formPanel" styleName="{style.flexColumn} {style.padding}">
		
			<g:DeckPanel ui:field="deckPanel">
				
				<g:HTMLPanel styleName="{style.flexColumn}">
					<g:HTMLPanel styleName="{style.input}">
						<g:Label text="Certificado adjunto" styleName="{style.title}" />
						<g:HTMLPanel ui:field="filePanel" styleName="{style.flex}">
							<g:TextBox ui:field="fileNameTB" styleName="{style.widthAll}" />
						</g:HTMLPanel>
					</g:HTMLPanel>
					<g:HTMLPanel styleName="{style.input}">
						<g:Label text="Contraseña certificado" styleName="{style.title}" />
						<g:HTMLPanel styleName="{style.flex}">
							<g:PasswordTextBox ui:field="passwordTB" styleName="{style.widthAll}" />
							<c:AonToolbarSmallButton ui:field="visibilityBtn" />
						</g:HTMLPanel>
					</g:HTMLPanel>
				</g:HTMLPanel>
				
				<g:HTMLPanel styleName="{style.flexColumn}">
					<g:HTMLPanel ui:field="certificateInfoPanel" styleName="{style.widthAll}" />
					<g:HTMLPanel styleName="{style.input}">
						<g:Label text="Tipo de almacén" styleName="{style.title}" />
						<g:ListBox ui:field="storeLB" styleName="{style.widthAll}" />
					</g:HTMLPanel>
					<g:HTMLPanel ui:field="securityPanel" styleName="{style.input}">
						<g:Label text="Seguridad certificado" styleName="{style.title}" />
						<g:HTMLPanel styleName="{style.flex} {style.noGap}">
							<c:AonToolbarSmallButton ui:field="securityBtn" />
							<g:CheckBox ui:field="securityCB" styleName="{style.checkBox}" />
						</g:HTMLPanel>
					</g:HTMLPanel>
					<g:HTMLPanel styleName="{style.input}">
						<g:Label text="Tipo certificado" styleName="{style.title}" />
						<g:CheckBox ui:field="tgssCB" text="TGSS" styleName="{style.checkBox}" />
						<g:CheckBox ui:field="sepeCB" text="SEPE" styleName="{style.checkBox}" />
						<g:CheckBox ui:field="aeatCB" text="AEAT" styleName="{style.checkBox}" />
					</g:HTMLPanel>
				</g:HTMLPanel>
			    
			</g:DeckPanel>
		    
		   	<g:HTMLPanel ui:field="buttonsPanel" styleName="{style.buttonsPanel}" />
		   	
		</g:HTMLPanel>

	</g:HTMLPanel>

</ui:UiBinder>