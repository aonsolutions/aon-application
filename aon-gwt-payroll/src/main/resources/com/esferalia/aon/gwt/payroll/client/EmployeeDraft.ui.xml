<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
	xmlns:g='urn:import:com.google.gwt.user.client.ui'
	xmlns:a='urn:import:com.esferalia.aon.gwt.common.client.widget'
	xmlns:e='urn:import:com.esferalia.aon.gwt.payroll.client'
	xmlns:p="urn:import:net.aonsolutions.gwt.pdfjs.client" >

	<ui:with field='res' type='com.esferalia.aon.gwt.common.client.css.AonResources' />

	<ui:style>
		
		.fontSaveStyle{
			font-weight: bold;
    		color: #000;
    		white-space: nowrap;
    		font-size: smaller;
    		padding-left: 30px;
    		width: 200px;	
		}

		.document {
			margin-top: 5px;
			margin-left: auto;
			margin-right: auto;
			margin-bottom: 15px;
		}
		
			
	</ui:style>

	<g:DockLayoutPanel unit="PX">
		<g:north size="72">
			<g:FlowPanel>
				<g:FlowPanel styleName="aon-finding-title-toolbar">
					<g:HorizontalPanel>
						<g:HTMLPanel styleName="aon-finding-title">
							<g:HTMLPanel styleName="aon-finding-title-internal">
								<g:Label styleName="aon-outputText">Contrato</g:Label>
							</g:HTMLPanel>
						</g:HTMLPanel>
						<g:HTMLPanel styleName="aon-finding-subtitle">
							<g:HTMLPanel styleName="aon-finding-subtitle-internal">
								<g:Label styleName="aon-outputText"></g:Label>
							</g:HTMLPanel>
						</g:HTMLPanel>
						<g:HorizontalPanel styleName="aon-finding-toolbar">
						    <g:HTMLPanel styleName="aon-finding-toolbar-item-group">
								<g:Button ui:field='afiButton'
									styleName='aon-finding-toolbar-item aon-icon-segsocial-small' text="Cambios AFI"
									enabled="true" />
							</g:HTMLPanel>
							<g:HTMLPanel styleName="aon-finding-toolbar-item-group">
								<g:Button ui:field='peculiaritiesButton'
									styleName='aon-finding-toolbar-item aon-icon-segsocial-small' text="Peculiaridades de Cotización"
									enabled="true" />
							</g:HTMLPanel>
							<g:HTMLPanel styleName="aon-finding-toolbar-item-group">
								<g:Button ui:field='bonificationsButton'
									styleName='aon-finding-toolbar-item aon-icon-segsocial-small' text="Bonificaciones"
									enabled="true" />
							</g:HTMLPanel>
							<g:HTMLPanel styleName="aon-finding-toolbar-item-group">
								<g:Button ui:field='idcButton'
									styleName='aon-finding-toolbar-item aon-icon-segsocial-small' text="Informe de Cotizaci&oacute;n IDC"
									enabled="true" />
								<g:Button ui:field='taButton'
									styleName='aon-finding-toolbar-item aon-icon-segsocial-small' text="Duplicados de Documentos TA"
									enabled="true" />
							</g:HTMLPanel>
							<g:HTMLPanel styleName="aon-finding-toolbar-item-group">
								<g:Button debugId='closePdfButton' ui:field='closePdfButton'
									styleName='aon-finding-toolbar-item aon-icon-cancel' text="Cerrar" />
							</g:HTMLPanel>
							<g:HTMLPanel styleName="aon-finding-toolbar-item-group">
								<g:ListBox debugId='zoomListBox' ui:field="zoomListBox" />
							</g:HTMLPanel>
							<g:HTMLPanel styleName="aon-finding-toolbar-item-group">
								<g:Button debugId='downloadButton' ui:field='downloadButton'
									styleName='aon-finding-toolbar-item aon-icon-mail-save' text="Descargar" />	
							</g:HTMLPanel>
						<g:HTMLPanel styleName="aon-finding-toolbar-item-group">
							    <g:Label ui:field='saveStatus' styleName="{style.fontSaveStyle}"></g:Label>
						    </g:HTMLPanel>
						    
						</g:HorizontalPanel>
					</g:HorizontalPanel>
				</g:FlowPanel>
				<g:FlowPanel styleName="aon-finding-title-toolbar">
					<g:HorizontalPanel>
						<g:HTMLPanel styleName="aon-finding-title">
							<g:HTMLPanel styleName="aon-finding-title-internal">
								<g:Label styleName="aon-outputText">Edici&oacute;n</g:Label>
							</g:HTMLPanel>
						</g:HTMLPanel>
						<g:HTMLPanel styleName="aon-finding-subtitle">
							<g:HTMLPanel styleName="aon-finding-subtitle-internal">
								<g:Label styleName="aon-outputText"></g:Label>
							</g:HTMLPanel>
						</g:HTMLPanel>
						<g:HorizontalPanel styleName="aon-finding-toolbar">
							<g:HTMLPanel styleName="aon-finding-toolbar-item-group" visible="true">
								<g:Button debugId='undoAllButton' ui:field='undoAllButton'
									styleName='aon-finding-toolbar-item {res.css.aonIconUndoAll}' />
								<g:Button debugId='undoButton' ui:field='undoButton'
									styleName='aon-finding-toolbar-item {res.css.aonIconUndo}' />
								<g:Button debugId='redoButton' ui:field='redoButton'
									styleName="aon-finding-toolbar-item {res.css.aonIconRedo}" />
							</g:HTMLPanel>
						</g:HorizontalPanel>
					</g:HorizontalPanel>
				</g:FlowPanel>

			</g:FlowPanel>
		</g:north>
		<g:center> 
		    <g:ScrollPanel>
		    	<g:VerticalPanel ui:field="scrolledPanel" >
		    	<!-- g:HTMLPanel styleName="aon-height-all" debugId="paymetDialogHTMLPanel" -->
		    		<g:DeckPanel ui:field="deckPanel">
		    			<e:Employee ui:field="employee"/>
		    			<p:Viewer styleName="reset" ui:field='pdfViewer' /> 
		    		</g:DeckPanel>
		    	<!-- /g:HTMLPanel-->
		    	</g:VerticalPanel>
		    </g:ScrollPanel>
		</g:center>
	</g:DockLayoutPanel>
</ui:UiBinder> 

