<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
	xmlns:g='urn:import:com.google.gwt.user.client.ui'
	xmlns:a='urn:import:com.esferalia.aon.gwt.common.client.widget'>

	<ui:with field='res'
		type='com.esferalia.aon.gwt.common.client.css.AonResources' />

	<ui:style
		type="com.esferalia.aon.gwt.payroll.client.EmployeeDraft.MyStyle">
		
		.noselect {
			-webkit-touch-callout: none; /* iOS Safari */
			-webkit-user-select: none; /* Safari */
			-khtml-user-select: none; /* Konqueror HTML */
			-moz-user-select: none; /* Firefox */
			-ms-user-select: none; /* Internet Explorer/Edge */
			user-select: none; /* Non-prefixed version, currently
				                                  supported by Chrome and Opera */
		}
		
		@external gwt-Selector;
		@external gwt-SuggestBoxPopup;
		.gwt-SuggestBoxPopup {
			z-index: 105;
		}
		
		.gwt-Selector .gwt-SuggestBoxPopup {
			z-index: 105;
			height: inherit;
		}

		.backgroundColorFirstColumn {
			background-color: #eaeaea;
			width: 200px;
		}

		hr {
			width: 97%;
		}

		.paddingTable {
			border-style: solid;
    		padding: 10px 10px 10px 10px;
    		border-width: 1px;
    		margin-left: 10px;
    		margin-bottom: 40px;
		}

		.paddingTable td{
			font-family: Arial;
    		font-size: small;
			padding-left: 10px;
		}

		.headerStyle{
			font-family: Arial;
    		font-size: 17px;
    		font-weight: normal;
   		 	padding-left: 12px;
    		padding-bottom: 5px;
		}

		.headerStyle2{
			font-family: Arial;
    		font-size: 17px;
    		font-weight: normal;
   		 	padding-left: 12px;
    		padding-bottom: 5px;
			padding-top: 10px;
		}

		.secondColumnWidth{
			width: auto;
		}

		.secondColumnWidth2{
			width: auto;
			padding-left: 0px !important;
		}

		.hide{
			display: none;
		}

		.moreAddress{
			background: white;
    		width: 20px;
			background-color: white;
    		color: black;
    		font-weight: bold;
    		border-color: white;
    		font-size: large;
		}

		.paddingLabel{
			padding: 3px;
		}

		.paddingConfidecial{
			padding-left: 0px;
			padding-top: 3px;
		}

		.paddingCheckBox{
			padding-top: 6px;
		}

		.dateBox{
			width: 100px;
    		text-align: center;
    		padding: 2px;
    		border: 1px solid #ccc;
    		border-top: 1px solid #999;
    		font-size: small;
    		font-family: Arial Unicode MS, Arial, sans-serif;
		}

		.dateBox2{
			width: 134px !important;
    		text-align: center;
    		padding: 2px;
    		border: 1px solid #ccc;
    		border-top: 1px solid #999;
    		font-size: small;
    		font-family: Arial Unicode MS, Arial, sans-serif;
		}

		.horizontalPanel{
			padding-left: 0px;
			padding-bottom: 3px;
		}

		.horizontalPanel2{
			padding-left: 0px !important;
		}

	</ui:style>

	<g:DockLayoutPanel unit="PX">
		<g:north size="50">
			<g:FlowPanel>
				<g:FlowPanel styleName="aon-finding-title-toolbar">
					<g:HorizontalPanel>
						<g:HTMLPanel styleName="aon-finding-title">
							<g:HTMLPanel styleName="aon-finding-title-internal">
								<g:Label styleName="aon-outputText">Contratos : Edici&oacute;n</g:Label>
							</g:HTMLPanel>
						</g:HTMLPanel>
						<g:HTMLPanel styleName="aon-finding-subtitle">
							<g:HTMLPanel styleName="aon-finding-subtitle-internal">
								<g:Label styleName="aon-outputText"></g:Label>
							</g:HTMLPanel>
						</g:HTMLPanel>
						<g:HTMLPanel styleName="aon-finding-toolbar-item-group">
							<g:Button ui:field='saveButton'
								styleName='aon-finding-toolbar-item aon-icon-accept' text="ACEPTAR"
								enabled="true" />
						</g:HTMLPanel>
					</g:HorizontalPanel>
					<g:HorizontalPanel>
						<g:HTMLPanel styleName="aon-finding-title">
							<g:HTMLPanel styleName="aon-finding-title-internal">
								<g:Label styleName="aon-outputText">Laboral : N&oacute;minas</g:Label>
							</g:HTMLPanel>
						</g:HTMLPanel>
						<g:HTMLPanel styleName="aon-finding-subtitle">
							<g:HTMLPanel styleName="aon-finding-subtitle-internal">
								<g:Label styleName="aon-outputText"></g:Label>
							</g:HTMLPanel>
						</g:HTMLPanel>
						<g:HTMLPanel styleName="aon-finding-toolbar-item-group">
							<g:Button ui:field='calculatePayrollButton'
								styleName='aon-finding-toolbar-item aon-icon-task-start' text="CÁLCULO DE NÓMINAS"
								enabled="false" />
						</g:HTMLPanel>
						<g:HTMLPanel styleName="aon-finding-subtitle">
							<g:HTMLPanel styleName="aon-finding-subtitle-internal">
								<g:Label styleName="aon-outputText"></g:Label>
							</g:HTMLPanel>
						</g:HTMLPanel>
						<g:HTMLPanel styleName="aon-finding-toolbar-item-group">
							<g:Button ui:field='resultsButton'
								styleName='aon-finding-toolbar-item aon-icon-time' text="RESULTADOS"
								enabled="false" />
						</g:HTMLPanel>
					</g:HorizontalPanel>
				</g:FlowPanel>

			</g:FlowPanel>
		</g:north>
		<g:center> 
		    <g:ScrollPanel>
		        <g:HTMLPanel> 
			    	<g:Label styleName='{style.headerStyle2}'>Datos de contrato</g:Label>
					<g:HorizontalPanel>
						<g:Grid ui:field="contractDataTable" styleName='{style.paddingTable}'>
							<g:row>
								<g:customCell>
									<g:Label>Centro de trabajo</g:Label>
								</g:customCell>
								<g:customCell styleName='{style.secondColumnWidth}'>
									<g:HorizontalPanel>
									    <g:Label styleName='{style.paddingLabel}'>Actividad</g:Label>
										<g:TextBox ui:field="activity" width="240px"></g:TextBox>
										<g:Label styleName='{style.paddingLabel}'>Cuenta de cotización</g:Label>
										<g:TextBox ui:field="quotationAccount" width="245px"></g:TextBox>
									</g:HorizontalPanel>
								</g:customCell>
							</g:row>
							<g:row>
								<g:customCell>
									<g:Label>Tipo de contrato</g:Label>
								</g:customCell>
								<g:customCell styleName='{style.secondColumnWidth}'>
									<g:HorizontalPanel>
									    <g:ListBox ui:field="contractType" width="715px"></g:ListBox>
									</g:HorizontalPanel>
								</g:customCell>
							</g:row>
							<g:row>
								<g:customCell>
									<g:Label>Modalidad</g:Label>
								</g:customCell>
								<g:customCell styleName='{style.secondColumnWidth}'>
									<g:HorizontalPanel>
									    <g:ListBox ui:field="modality" width="715px"></g:ListBox>
									</g:HorizontalPanel>
								</g:customCell>
							</g:row>
							<g:row>
								<g:customCell>
									<g:Label>Periodo contratación</g:Label>
								</g:customCell>
								<g:customCell styleName='{style.secondColumnWidth}'>
									<g:HorizontalPanel>
									    <g:Label styleName='{style.paddingLabel}'>Fecha inicio</g:Label>
									    <a:DateBoxEx ui:field="strat_date" styleName='{style.dateBox2}'></a:DateBoxEx>
									    <g:Label styleName='{style.paddingLabel}'>Fecha fin</g:Label>
									    <a:DateBoxEx ui:field="end_date" styleName='{style.dateBox2}'></a:DateBoxEx>
									    <g:Label styleName='{style.paddingLabel}'>Fecha antigüedad</g:Label>
									    <a:DateBoxEx ui:field="seniority_date" styleName='{style.dateBox2}' width="130px !important"></a:DateBoxEx>
									</g:HorizontalPanel>
								</g:customCell>
							</g:row>
							<g:row>
								<g:customCell>
									<g:Label>Categoría/Nivel retributario</g:Label>
								</g:customCell>
								<g:customCell styleName='{style.secondColumnWidth2}'>
									<g:VerticalPanel>
									    <g:HorizontalPanel styleName='{style.horizontalPanel}'>
									    	<g:Label styleName='{style.paddingLabel}'>Convenio</g:Label>
									    	<g:ListBox ui:field="agreement" width="645px"></g:ListBox>
									    </g:HorizontalPanel>
									    <g:HorizontalPanel>
									    	<g:Label styleName='{style.paddingLabel}'>Nivel/Categoría</g:Label>
									    	<g:ListBox ui:field="level" width="295px"></g:ListBox>
									    	<g:Label styleName='{style.paddingLabel}'>Mostrar como</g:Label>
									    	<g:TextBox ui:field="category" width="200px"></g:TextBox>
									    </g:HorizontalPanel>
									</g:VerticalPanel>
								</g:customCell>
							</g:row>
							<g:row>
								<g:customCell>
									<g:Label>Grupo de cotización</g:Label>
								</g:customCell>
								<g:customCell styleName='{style.secondColumnWidth}'>
									<g:HorizontalPanel>
									    <g:ListBox ui:field="quote_group" width="715px"></g:ListBox>
									</g:HorizontalPanel>
								</g:customCell>
							</g:row>
							<g:row>
								<g:customCell>
									<g:Label>Ocupación</g:Label>
								</g:customCell>
								<g:customCell styleName='{style.secondColumnWidth}'>
									<g:HorizontalPanel>
									    <g:ListBox ui:field="occupation" width="715px"></g:ListBox>
									</g:HorizontalPanel>
								</g:customCell>
							</g:row>  
						</g:Grid>
					</g:HorizontalPanel>
					
				 
					<g:Label styleName='{style.headerStyle}'>Datos personales</g:Label>
					<g:HorizontalPanel>
					    <g:HTMLPanel>
							<g:Grid ui:field="employeeDataTable" styleName='{style.paddingTable}'>
							    <g:row>
									<g:customCell>
										<g:Label>Documento</g:Label>
									</g:customCell>
									<g:customCell styleName='{style.secondColumnWidth}'>
										<g:HorizontalPanel>
										    <!--g:ListBox ui:field="document_type"></g:ListBox>
										    <g:Label>País de emisión</g:Label>
										    <g:ListBox ui:field="document_country"></g:ListBox -->
										    <g:TextBox ui:field="document" width="165px"></g:TextBox>
										    <g:Label ui:field="document_type" styleName='{style.paddingLabel}'></g:Label>
										    <g:HorizontalPanel ui:field="nationalityPanel">
										        <g:Label styleName='{style.paddingLabel}'>Nacionalidad</g:Label>
										    	<g:SuggestBox ui:field="nationality" width="348px"></g:SuggestBox>
										    </g:HorizontalPanel> 
										</g:HorizontalPanel>
									</g:customCell>
								</g:row>    
								<g:row>
									<g:customCell>
										<g:Label>Nombre Completo</g:Label>
									</g:customCell>
									<g:customCell styleName='{style.secondColumnWidth}'>
										<g:HorizontalPanel>
										    <g:TextBox ui:field="name" width="165px"></g:TextBox>
										    <g:Label ui:field="firstSurnameLabel" styleName='{style.paddingLabel}'>1er Apellido</g:Label>
										     <g:TextBox ui:field="first_surname" width="175px"></g:TextBox>
										    <g:Label styleName='{style.paddingLabel}'>2º Apellido</g:Label>
										    <g:TextBox ui:field="second_surname" width="172px"></g:TextBox>
										</g:HorizontalPanel>
									</g:customCell>
								</g:row>   
								<g:row>
									<g:customCell>
										<g:Label>Fecha de nacimiento</g:Label>
									</g:customCell>
									<g:customCell styleName='{style.secondColumnWidth}'>
										<g:HorizontalPanel>
										    <a:DateBoxEx ui:field="birth_date" styleName='{style.dateBox}' width="165px"></a:DateBoxEx>
										    <g:Label ui:field="age" styleName='{style.paddingLabel}'></g:Label>
										    <g:Label styleName='{style.paddingLabel}'>Sexo</g:Label>
										    <g:ListBox ui:field="gender"></g:ListBox>
										</g:HorizontalPanel>
									</g:customCell>
								</g:row>
								<g:row>
									<g:customCell>
										<g:Label>Nº S.S.</g:Label>
									</g:customCell>
									<g:customCell styleName='{style.secondColumnWidth}'>
										<g:HorizontalPanel>
										    <g:TextBox ui:field="security_social_num" width="708px"></g:TextBox>
										</g:HorizontalPanel>
									</g:customCell>
								</g:row>
								<g:row>
									<g:customCell>
										<g:Label>Dirección</g:Label>
									</g:customCell>
									<g:customCell styleName='{style.secondColumnWidth}'>
										<g:HorizontalPanel>
										    <g:TextBox ui:field="address" width="708px"></g:TextBox>
										</g:HorizontalPanel>
									</g:customCell>
								</g:row>      
								<g:row>
									<g:customCell>
										<g:Label>Contacto</g:Label>
									</g:customCell>
									<g:customCell styleName='{style.secondColumnWidth}'>
										<g:HorizontalPanel>
										    <g:Label styleName='{style.paddingLabel}'>Teléfono</g:Label>
										    <g:TextBox ui:field="phone" width="160px"></g:TextBox>
										    <g:Label styleName='{style.paddingLabel}'>Móvil</g:Label>
										    <g:TextBox ui:field="mobile" width="160px"></g:TextBox>
										    <g:Label styleName='{style.paddingLabel}'>eMail</g:Label>
										    <g:TextBox ui:field="email" width="195px"></g:TextBox>
										</g:HorizontalPanel>
									</g:customCell>
								</g:row> 
							</g:Grid>
						</g:HTMLPanel>
					</g:HorizontalPanel>
		        </g:HTMLPanel> 
		    </g:ScrollPanel>
		</g:center>
	</g:DockLayoutPanel>
</ui:UiBinder> 

