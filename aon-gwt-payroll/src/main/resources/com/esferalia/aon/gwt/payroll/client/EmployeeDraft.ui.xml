<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
	xmlns:g='urn:import:com.google.gwt.user.client.ui'
	xmlns:a='urn:import:com.esferalia.aon.gwt.common.client.widget'
	xmlns:e='urn:import:com.esferalia.aon.gwt.payroll.client'>

	<ui:with field='res'
		type='com.esferalia.aon.gwt.common.client.css.AonResources' />

	<ui:style type="com.esferalia.aon.gwt.payroll.client.EmployeeDraft.MyStyle">
		
		.noselect {
			-webkit-touch-callout: none; /* iOS Safari */
			-webkit-user-select: none; /* Safari */
			-khtml-user-select: none; /* Konqueror HTML */
			-moz-user-select: none; /* Firefox */
			-ms-user-select: none; /* Internet Explorer/Edge */
			user-select: none; /* Non-prefixed version, currently
				                                  supported by Chrome and Opera */
		}
		
		@external gwt-Selector;
		@external gwt-SuggestBoxPopup;
		.gwt-SuggestBoxPopup {
			z-index: 105;
		}
		
		.gwt-Selector .gwt-SuggestBoxPopup {
			z-index: 105;
			height: inherit;
		}

		.headerStyle{
			top: -0.5em;
			font-size: 12px;
			margin-left: 10px;
		}

		.requiredColor{
			color: #2152A5;
			font-weight: bold !important;
		}

		.hide{
			display: none;
		}

		.maxWidth{
		width: 100%;
		}

		.maxWidthTextBox{
		width: 99%;
		}

		.maxWidthTextBox2{
		width: 98%;
		}

		.maxWidthTextBox3{
		width: 97%;
		}

		.maxWidthTextBox4{
			width: 96%;
		}

		.dateBoxStyle{
		width: 98% !important;
		text-align: center !important;
		}

		.dateBoxStyle2{
		width: 96% !important;
		text-align: center !important;
		}

		.alignTextCenter{
		text-align: center;
		}

		.firstColumnTextStyle{
		padding:
		5px !important;
		}

		.nssWidht{
			width: 96%;
		}

		.paddingLeft{
			padding-left: 2px;
		}

		.retaTopLabel{
			top: 330px;
		}

		.warning{
			border-color: red;
		}
		
		.styleBorder{
			border-style: solid; 
			width: 975px; 
			border-width: 1px; 
			margin-top: 20px; 
			margin-left: 10px;
		}
		
		.styleBorder2{
			border-style: solid; 
			width: 975px; 
			border-width: 1px; 
			margin-top: 40px; 
			margin-left: 10px;
		}
		
		.fontSaveStyle{
			font-weight: bold;
    		color: #000;
    		white-space: nowrap;
    		font-size: smaller;
    		padding-left: 30px;
    		width: 200px;	
		}
		
	</ui:style>

	<g:DockLayoutPanel unit="PX">
		<g:north size="72">
			<g:FlowPanel>
				<g:FlowPanel styleName="aon-finding-title-toolbar">
					<g:HorizontalPanel>
						<g:HTMLPanel styleName="aon-finding-title">
							<g:HTMLPanel styleName="aon-finding-title-internal">
								<g:Label styleName="aon-outputText">Contrato</g:Label>
							</g:HTMLPanel>
						</g:HTMLPanel>
						<g:HTMLPanel styleName="aon-finding-subtitle">
							<g:HTMLPanel styleName="aon-finding-subtitle-internal">
								<g:Label styleName="aon-outputText"></g:Label>
							</g:HTMLPanel>
						</g:HTMLPanel>
						<g:HorizontalPanel styleName="aon-finding-toolbar">
						    <g:HTMLPanel styleName="aon-finding-toolbar-item-group">
								<g:Button ui:field='afiButton'
									styleName='aon-finding-toolbar-item aon-icon-segsocial-small' text="Cambios AFI"
									enabled="true" />
							</g:HTMLPanel>
							<g:HTMLPanel styleName="aon-finding-toolbar-item-group">
								<g:Button ui:field='peculiaritiesButton'
									styleName='aon-finding-toolbar-item aon-icon-segsocial-small' text="Peculiaridades de cotización"
									enabled="true" />
							</g:HTMLPanel>
							<g:HTMLPanel styleName="aon-finding-toolbar-item-group">
								<g:Button ui:field='bonificationsButton'
									styleName='aon-finding-toolbar-item aon-icon-segsocial-small' text="Bonificaciones"
									enabled="true" />
							</g:HTMLPanel>
							<g:HTMLPanel styleName="aon-finding-toolbar-item-group">
							    <g:Label ui:field='saveStatus' styleName="{style.fontSaveStyle}"></g:Label>
						    </g:HTMLPanel>
						</g:HorizontalPanel>
					</g:HorizontalPanel>
				</g:FlowPanel>
				<g:FlowPanel styleName="aon-finding-title-toolbar">
					<g:HorizontalPanel>
						<g:HTMLPanel styleName="aon-finding-title">
							<g:HTMLPanel styleName="aon-finding-title-internal">
								<g:Label styleName="aon-outputText">Edici&oacute;n</g:Label>
							</g:HTMLPanel>
						</g:HTMLPanel>
						<g:HTMLPanel styleName="aon-finding-subtitle">
							<g:HTMLPanel styleName="aon-finding-subtitle-internal">
								<g:Label styleName="aon-outputText"></g:Label>
							</g:HTMLPanel>
						</g:HTMLPanel>
						<g:HorizontalPanel styleName="aon-finding-toolbar">
							<g:HTMLPanel styleName="aon-finding-toolbar-item-group" visible="true">
								<g:Button debugId='undoAllButton' ui:field='undoAllButton'
									styleName='aon-finding-toolbar-item {res.css.aonIconUndoAll}' />
								<g:Button debugId='undoButton' ui:field='undoButton'
									styleName='aon-finding-toolbar-item {res.css.aonIconUndo}' />
								<g:Button debugId='redoButton' ui:field='redoButton'
									styleName="aon-finding-toolbar-item {res.css.aonIconRedo}" />
							</g:HTMLPanel>
						</g:HorizontalPanel>
					</g:HorizontalPanel>
				</g:FlowPanel>

			</g:FlowPanel>
		</g:north>
		<g:center> 
		    <g:ScrollPanel>
		    	<g:HTMLPanel styleName="aon-width-all aon-height-all" debugId="paymetDialogHTMLPanel">
		    		<e:Employee ui:field="employee"/> 
		    	</g:HTMLPanel>
		    </g:ScrollPanel>
		</g:center>
	</g:DockLayoutPanel>
</ui:UiBinder> 

