<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
	xmlns:g='urn:import:com.google.gwt.user.client.ui'
	xmlns:e='urn:import:com.esferalia.aon.gwt.payroll.client'
	xmlns:s='urn:import:com.esferalia.aon.gwt.common.client.widget.solutions'
	xmlns:p="urn:import:net.aonsolutions.gwt.pdfjs.client" >

	<ui:style type="com.esferalia.aon.gwt.payroll.client.EmployeeDraft.MyStyle">
		
		.flexColumn  {
			display: flex;
			flex-direction: column;
			gap: .5rem;
		}
		
		.cmdBtn{
			background-position: center left;
			background-repeat: no-repeat;
			padding-left: 25px !important;
			background-size: contain;
		}
		
		.displayNone{
			display: none !important;
		}
		
			
	</ui:style>

	<g:DockLayoutPanel ui:field="dockLayoutPanel" unit="PX">
		<g:north size="50">
			<s:AonToolbar ui:field="toolbar" /> 
		</g:north> 
		<g:center> 
    		<g:DeckLayoutPanel   ui:field="deckPanel" >
    			<g:HTMLPanel styleName="{style.flexColumn}">
    				<g:HTMLPanel ui:field="messageContainer"/>
		    		<g:ScrollPanel ui:field="scrolledPanel"  >
	    				<e:Employee ui:field="employee" />
			    	</g:ScrollPanel>
    			</g:HTMLPanel>
     			<p:FullViewer styleName="reset" ui:field='pdfViewer' /> 
    		</g:DeckLayoutPanel>
		</g:center>
	</g:DockLayoutPanel>
	
</ui:UiBinder> 

