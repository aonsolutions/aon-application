<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
	xmlns:g='urn:import:com.google.gwt.user.client.ui'
	xmlns:a='urn:import:com.esferalia.aon.gwt.common.client.widget'
	xmlns:c='urn:import:com.esferalia.aon.gwt.common.client.widget.solutions'>

	<ui:with field='msgs' type='com.esferalia.aon.gwt.payroll.client.i18n.PayrollMessages'/>
	<ui:with field='res' type='com.esferalia.aon.gwt.common.client.css.AonResources' />

	<ui:style type="com.esferalia.aon.gwt.payroll.client.ContractBonusUI.MyStyle">

		.headerStyle{
			top: -0.5em;
			font-size: 12px;
			margin-left: 10px;
		}

		.headerLabelStyle{
			font-weight: bold;
		}

		.maxWidthTB{
			width: 97%;
		}

		.widthAll{
			width: 100%;
		}

		.maxWidthLB{
			width: 100%;
		}

		.styleBorder{
			border-style: solid;
			width: 975px;
			border-width: 1px;
			margin: 20px 10px;
		}

		.gridStyle{
			margin-left: 10px;
		}

		.scrollStyle {
			margin-left: 10px;
			margin-bottom: 10px;
		}

		.noBonusLB{
			width: 100%;
			text-align: center;
		}

		.flexColumn{
			width: 100%;
			display: flex;
			flex-direction: column;
			align-items: center;
		}

	</ui:style>

	<g:DockLayoutPanel unit="PX" ui:field="dockLayoutPanel">
		<g:north size="50">
			<c:AonToolbar ui:field="toolbar" />
		</g:north>
		<g:center>
			<g:HTMLPanel styleName="{style.flexColumn}">
				<g:HTMLPanel ui:field="messagePanel" styleName="{style.widthAll}" />
				<g:VerticalPanel ui:field="contractBonusTable" styleName="{style.styleBorder}">
			    	<g:Label width="105px" styleName='aon-group-title {style.headerStyle}' text="{msgs.bonuses}"/>
			    	<g:HTMLPanel styleName="aon-width-all aon-height-all" debugId="paymetDialogHTMLPanel">
			    		<g:VerticalPanel>
			    			<g:Grid ui:field="contractBonusDataTableHeader" styleName="{style.gridStyle}"></g:Grid>
			    			<g:HTMLPanel>
			    				<hr align="left" noshade="noshade" style="margin-bottom: 10px;border-width: 0.5px;margin-left: 10px;"/>
			    			</g:HTMLPanel>
				    		<g:ScrollPanel ui:field="contractBonusScrollPanel" styleName="{style.scrollStyle}">
				    			<g:DeckPanel ui:field="deckPanel">
				    				<g:Label styleName="{style.noBonusLB}" text="{msgs.noBonuses}"/>
				    				<g:Grid ui:field="contractBonusDataTable"></g:Grid>
				    			</g:DeckPanel>
				    		</g:ScrollPanel>
			    		</g:VerticalPanel>
			    	</g:HTMLPanel>
				</g:VerticalPanel>
			</g:HTMLPanel>
		</g:center>
	</g:DockLayoutPanel>

</ui:UiBinder>

