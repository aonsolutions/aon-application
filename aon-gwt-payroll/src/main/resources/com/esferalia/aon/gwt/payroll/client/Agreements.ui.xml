<ui:UiBinder xmlns:ui='urn:ui:com.google.gwt.uibinder'
	xmlns:g='urn:import:com.google.gwt.user.client.ui' xmlns:employee='urn:import:com.esferalia.aon.gwt.payroll.client'>


	<ui:style>
	.newButton {
		float: right;
	}
	
	.legend-icon {
		margin-top: 3px;
	}
	</ui:style>


	<ui:image field='view' src='view.png' />

	<ui:with type="com.esferalia.aon.gwt.payroll.client.MetaData.Resources"
		field="res" />

	<g:DockLayoutPanel unit='PX'>
		<g:north size='26'>
			<g:FlowPanel styleName="gwt-MenuBar-horizontal"
				ui:field="buttonBar">
				<g:HTMLPanel styleName="{style.legend-icon}">
					<g:Button styleName="gwt-MenuItem aon-icon-view" ui:field="viewButton" />
					<g:Button ui:field='redoButton'
						styleName='aon-editDataTable-button aon-icon-redo {style.newButton}'
						title="Rehacer" />
					<g:Button styleName="gwt-MenuItem aon-icon-collpaseAll"
						ui:field="collapseAllButton" />
					<g:Button ui:field='undoButton'
						styleName='aon-editDataTable-button aon-icon-undo {style.newButton}'
						title="Deshacer" />
					<g:Button ui:field='pasteButton'
						styleName='aon-editDataTable-button aon-icon-paste {style.newButton}'
						title="Pegar" />
					<g:Button ui:field='copyButton'
						styleName='aon-editDataTable-button aon-icon-copy {style.newButton}'
						title="Copiar" />
					<g:Button ui:field='deleteButton'
						styleName='aon-editDataTable-button aon-icon-draft {style.newButton}'
						title="Enviar convenio a la papelera" />
					<g:Button ui:field='newButton'
						styleName='aon-editDataTable-button aon-icon-reset {style.newButton}'
						title="Nuevo convenio" />
				</g:HTMLPanel>
			</g:FlowPanel>
		</g:north>

		<g:center>
			<g:ScrollPanel ui:field="scrollPanel">
				<g:Tree ui:field="tree">
				</g:Tree>
			</g:ScrollPanel>
		</g:center>
	</g:DockLayoutPanel>

</ui:UiBinder>
