<ui:UiBinder xmlns:ui='urn:ui:com.google.gwt.uibinder'
	xmlns:g='urn:import:com.google.gwt.user.client.ui' xmlns:employee='urn:import:com.esferalia.aon.gwt.payroll.client'>


	<ui:style>
		@sprite .viewButton {
			float: right;
			gwt-image: 'view';
		}
		
		@sprite .collpaseAllButton {
			float: right;
			gwt-image: 'collapseall';
		}
	</ui:style>


	<ui:image field='view' src='view.png' />
	<ui:image field='collapseall' src='collapseall.png' />
	
	<ui:with type="com.esferalia.aon.gwt.payroll.client.MetaData.Resources" field="res"/>
	
	<g:DockLayoutPanel unit='PX'>
		<g:north size='26'>
			<g:FlowPanel styleName="gwt-MenuBar-horizontal" ui:field="buttonBar">
				<g:Button styleName="gwt-MenuItem {style.viewButton}"
					ui:field="viewButton"></g:Button>
				<g:Button styleName="gwt-MenuItem {style.collpaseAllButton}"
					ui:field="collapseAllButton"></g:Button>
			</g:FlowPanel>
		</g:north>

		<g:center>
			<g:ScrollPanel ui:field="scrollPanel">
				<g:Tree ui:field="tree">
				</g:Tree>
			</g:ScrollPanel>
		</g:center>
	</g:DockLayoutPanel>

</ui:UiBinder>
