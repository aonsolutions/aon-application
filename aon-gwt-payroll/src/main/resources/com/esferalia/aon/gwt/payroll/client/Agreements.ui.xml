<ui:UiBinder xmlns:ui='urn:ui:com.google.gwt.uibinder'
	xmlns:g='urn:import:com.google.gwt.user.client.ui'
	xmlns:employee='urn:import:com.esferalia.aon.gwt.payroll.client'
	xmlns:common='urn:import:com.esferalia.aon.gwt.common.client.widget'
	xmlns:commonsolutions='urn:import:com.esferalia.aon.gwt.common.client.widget.solutions'>

	<ui:style type="com.esferalia.aon.gwt.payroll.client.Agreements.MyStyle">
		.treeItem{
			display: flex;
			align-items: center;
		}
		
		.rotate{
			transform: rotate(180deg);
		}
		
		.paddingLeft{
			padding-left: 10px !important;
		}
	</ui:style>

	<ui:image field='view' src='view.png' />

	<ui:with type="com.esferalia.aon.gwt.payroll.client.MetaData.Resources" field="res" />

	<g:DockLayoutPanel unit='PX'>
		<g:north size="50">
			<commonsolutions:AonAgreementsTreeToolbar ui:field="toolbar" />
		</g:north>
		<g:center>
			<employee:AgreementsTree ui:field="agreementsTree" />
		</g:center>
		
	</g:DockLayoutPanel>
</ui:UiBinder>
