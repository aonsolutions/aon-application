<ui:UiBinder xmlns:ui='urn:ui:com.google.gwt.uibinder'
	xmlns:g='urn:import:com.google.gwt.user.client.ui' xmlns:employee='urn:import:com.esferalia.aon.gwt.payroll.client'>


	<ui:style>
		.newButton {
			float: right;
		}
	</ui:style>


	<ui:image field='view' src='view.png' />

	<ui:with type="com.esferalia.aon.gwt.payroll.client.MetaData.Resources"
		field="res" />

	<g:DockLayoutPanel unit='PX'>
		<g:north size='26'>
			<g:FlowPanel styleName="gwt-MenuBar-horizontal" ui:field="buttonBar">
				<g:Button styleName="gwt-MenuItem aon-icon-view"
					ui:field="viewButton"></g:Button>
				<g:Button styleName="gwt-MenuItem aon-icon-collpaseAll"
					ui:field="collapseAllButton"></g:Button>
				<g:Button ui:field='newButton'
					styleName='aon-editDataTable-button aon-icon-reset {style.newButton}' />
			</g:FlowPanel>
		</g:north>

		<g:center>
			<g:ScrollPanel ui:field="scrollPanel">
				<g:Tree ui:field="tree">
				</g:Tree>
			</g:ScrollPanel>
		</g:center>
	</g:DockLayoutPanel>

</ui:UiBinder>
