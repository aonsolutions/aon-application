<ui:UiBinder 
    xmlns:ui='urn:ui:com.google.gwt.uibinder'
	xmlns:g='urn:import:com.google.gwt.user.client.ui'
	xmlns:es3='urn:import:com.google.gwt.user.client.ui'
	xmlns:datepicker='urn:import:com.google.gwt.user.datepicker.client'>

    <ui:with field='res'
		type='com.esferalia.aon.gwt.common.client.css.AonResources' />
    
    
	<ui:style type="com.esferalia.aon.gwt.payroll.client.EmployeeCheckBoxDialog.MyStyle">

		.form {
			padding: 10px;
		}
		
		.datesPanel{
			display: flex;
			flex-direction: column;
			padding: 5px;
			border: 1px solid #e1e1e1;
			margin-bottom: 10px;
		}
		
		.rowPanel{
			display: flex;
			justify-content: space-between;
			margin: 3px 0;
		}
		
		.buttonsPanel{
			display: flex;
			justify-content: flex-end;
		}
		
		.labelStyle{
			width: 60px;
			display: flex;
			align-items: center;
		}
		
		.dateBox{
			width: 120px !important;
			text-align: center;
		}
		
		.paddingLabelStyle{
			padding-left: 10px;
   			padding-top: 2px;
		}

	</ui:style>
	
	<g:HTMLPanel styleName="{style.form}">

		<g:HTMLPanel styleName="aon-width-all aon-height-all">
		
			<g:HTMLPanel styleName="{style.datesPanel}">
			
				<g:FlexTable width="100%" ui:field="checkBoxTable"/>
			
			</g:HTMLPanel>
			
			<g:HTMLPanel styleName="{style.buttonsPanel}">
				<g:Button ui:field="cancelButton">Cancelar</g:Button>
			    <g:Button ui:field="acceptButton">OK</g:Button>
			</g:HTMLPanel>
				
		</g:HTMLPanel>
		
	</g:HTMLPanel>

</ui:UiBinder>