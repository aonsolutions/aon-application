<ui:UiBinder 
    xmlns:ui='urn:ui:com.google.gwt.uibinder'
	xmlns:g='urn:import:com.google.gwt.user.client.ui'
	xmlns:c='urn:import:com.esferalia.aon.gwt.common.client.widget.solutions'>
    
	<ui:style type="com.esferalia.aon.gwt.payroll.client.ModificationPDFDialog.MyStyle">
	
		.form {
			display: flex;
			flex-direction: column;
			min-width: 650px;
			gap: 10px;
		}
		
		.padding {
			padding: 1rem 1rem 0 1rem;
		}
		
		.flexColumn{
			display: flex;
			flex-direction: column;
			gap: 10px;
		}
		
		.input{
			display: flex;
			flex-direction: column;
			gap: 5px;
		}
		
		.title{
			font-size: 12px;
			font-weight: bold;
		}
		
		.dateBox {
			text-align: center;
		}
		
		.buttonsPanel{
			display: flex;
			justify-content: flex-end;
			gap: 10px;
			margin-top: 10px;
		}
		
		.widthAll{
			width: 100%;
		}
		
		.footerButton{
			background-attachment: scroll;
			background-clip: border-box;
			background-color: inherit;
			background-position: 1px -2px;
			background-repeat: no-repeat;
			background-size: auto auto;
			border: 1px solid #aaa;
			cursor: pointer;
			height: 24px;
			overflow: visible;
			padding-left: 25px;
			text-align: left;
			text-transform: uppercase;
			width: auto;
		}
		
	</ui:style>

	<g:HTMLPanel styleName="{style.form}">
	
		<g:HTMLPanel ui:field="messagePanel" />
	
		<g:HTMLPanel ui:field="formPanel" styleName="{style.flexColumn} {style.padding}">
		
			<g:HTMLPanel styleName="{style.input}">
				<g:Label text="Título" styleName="{style.title}" />
				<g:TextBox ui:field="titleTB" styleName="{style.widthAll}" />
			</g:HTMLPanel>
			
			<g:HTMLPanel styleName="{style.input}">
				<g:Label text="Información" styleName="{style.title}" />
				<g:TextArea ui:field="informationTA" visibleLines="6" styleName="{style.widthAll}" />
			</g:HTMLPanel>
			
			<g:HTMLPanel styleName="{style.input}">
				<g:Label text="Fecha" styleName="{style.title}" />
				<c:AonDateBox ui:field="dateBox" styleName="{style.dateBox}" />
			</g:HTMLPanel>
		    
		   	<g:HTMLPanel ui:field="buttonsPanel" styleName="{style.buttonsPanel}" />
		   	
		</g:HTMLPanel>

	</g:HTMLPanel>

</ui:UiBinder>