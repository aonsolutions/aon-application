<ui:UiBinder xmlns:ui='urn:ui:com.google.gwt.uibinder'
	xmlns:g='urn:import:com.google.gwt.user.client.ui'>


	<ui:style>
		.minimizeBar {
			top: 0;
			right: 0;
			z-index:2;
			position: absolute;
			border: none !important;
			background: none !important;
		}
		
		.contentPanel {
			width:100%;
			height:100%;
		}
		
		@sprite .minimizeButton {
			float: right;
			gwt-image: 'minimize';
		}
		
		@sprite .maximizeButton {
			float: right;
			gwt-image: 'maximize';
		}
	</ui:style>


	<ui:image field='minimize' src='minimize.png' />
	<ui:image field='maximize' src='maximize.png' />


	<g:AbsolutePanel >
		<g:FlowPanel styleName="{style.minimizeBar} gwt-MenuBar-horizontal">
			<g:Button styleName="gwt-MenuItem {style.maximizeButton}"
				ui:field="maximizeButton"></g:Button>
			<g:Button styleName="gwt-MenuItem {style.minimizeButton}"
				ui:field="minimizeButton"></g:Button>
		</g:FlowPanel>
		<g:at top='0' left='0'>
			<g:SimpleLayoutPanel styleName="{style.contentPanel}"
				ui:field="contentPanel">
			</g:SimpleLayoutPanel>
		</g:at>
	</g:AbsolutePanel>


</ui:UiBinder>
