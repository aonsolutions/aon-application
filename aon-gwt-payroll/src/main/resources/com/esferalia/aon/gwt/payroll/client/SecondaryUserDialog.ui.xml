<ui:UiBinder
    xmlns:ui='urn:ui:com.google.gwt.uibinder'
	xmlns:g='urn:import:com.google.gwt.user.client.ui'
	xmlns:datepicker='urn:import:com.google.gwt.user.datepicker.client'
	xmlns:a='urn:import:com.esferalia.aon.gwt.common.client.widget'>

	<ui:with field='msgs' type='com.esferalia.aon.gwt.payroll.client.i18n.PayrollMessages'/>
    <ui:with field='res' type='com.esferalia.aon.gwt.common.client.css.AonResources' />
    
	<ui:style type="com.esferalia.aon.gwt.payroll.client.SecondaryUserDialog.MyStyle">
	
		.form {
			padding: 10px;
		}
		
		.flexColumn {
			display: flex;
			flex-direction: column;
		}
		
		.toolbar{
			padding: 0 10px;
		}
		
		.flex{
			display: flex;
			justify-content: space-between;
		}
		
		.tb100{
			width: 100px;
		}
		
		.tb187{
			width: 187px;
		}
		
		.tb49{
			width: 49%;
		}
		
		.tb98{
			width: 98%;
		}
		
		.mainButtonsPanel{
			display: flex;
			justify-content: space-between;
			margin-top: 15px;
			align-items: center;
		}
		
		.buttonsPanel{
			display: flex;
			justify-content: flex-end;
			align-items: center;
			width: 99%;
		}
		
		.loadingPanel{
			display: flex;
			align-items: center;
			animation-name: spin;
			animation-duration: 2500ms;
			animation-iteration-count: infinite;
			animation-timing-function: linear;
		}
		
		@keyframes spin {
		    from {
		        transform:rotate(0deg);
		    }
		    to {
		        transform:rotate(360deg);
		    }
		}
		
		.pr20{
			padding-right: 20px;
		}
		
	</ui:style>

	<g:HTMLPanel styleName="{style.flexColumn}">
	
			<g:HTMLPanel ui:field="messagePanel" />
			<g:HTMLPanel styleName="{style.form}">
	
				<table ui:field="secondaryUserTable">
			        <tbody>
			            <tr>
			            	<td>
			                    <g:Label>{msgs.searchByDni}</g:Label>
			                </td>
			                <td>
			                    <g:Button ui:field="dniBtn"></g:Button>
			                </td>
			                <td>
			                    <g:TextBox ui:field="nss"></g:TextBox>
			                </td>
			                <td>
			                    <g:TextBox ui:field="nie"></g:TextBox>
			                </td>
			            </tr>
			            <tr>
			                <td colspan="4">
			                	<g:HTMLPanel styleName="{style.flex}">
			                		<g:TextBox ui:field="surname" styleName="{style.tb49}"></g:TextBox>
			                		<g:TextBox ui:field="secondSurname" styleName="{style.tb49}"></g:TextBox>
			                	</g:HTMLPanel>  
			                </td>
			            </tr>
			            <tr>
			            	<td colspan="4">
			                    <g:TextBox ui:field="name" enabled="false" styleName="{style.tb98}"></g:TextBox>
			                </td>
			                
			            </tr>
			        </tbody>
			    </table>
				
				<g:HTMLPanel ui:field="mainButtonsPanel" styleName="{style.mainButtonsPanel}">
					<g:HTMLPanel ui:field="loadingPanel" styleName="{style.loadingPanel}"></g:HTMLPanel>
					<g:HTMLPanel ui:field="buttonsPanel" styleName="{style.buttonsPanel}"></g:HTMLPanel>
				</g:HTMLPanel>
		
			</g:HTMLPanel>

	</g:HTMLPanel>

</ui:UiBinder>