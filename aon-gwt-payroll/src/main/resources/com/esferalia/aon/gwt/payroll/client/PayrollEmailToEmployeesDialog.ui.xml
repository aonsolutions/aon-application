<ui:UiBinder 
    xmlns:ui='urn:ui:com.google.gwt.uibinder'
	xmlns:g='urn:import:com.google.gwt.user.client.ui'
	xmlns:es3='urn:import:com.google.gwt.user.client.ui'
	xmlns:datepicker='urn:import:com.google.gwt.user.datepicker.client'>

    <ui:with field='res'
		type='com.esferalia.aon.gwt.common.client.css.AonResources' />
    
    
	<ui:style type="com.esferalia.aon.gwt.payroll.client.PayrollEmailToEmployeesDialog.MyStyle">

		.w96{
			width: 99%;
		}
		
		.label{
			padding: 2px;
			font-weight: bold;
		}

	</ui:style>

	<g:HTMLPanel styleName="aon-width-all aon-height-all" debugId="payrollEmailHTMLPanel"> 

		<table class="aon-width-all aon-height-all" >
			<tr>
				<td style="background-color: #d7d7d7;">
					De:
				</td>
				<td>
					<g:ListBox ui:field="mailAccountsListBox" styleName="aon-width-all"></g:ListBox>
				</td>
			</tr>
			<tr>
				<td style="background-color: #d7d7d7;">
					Para:
				</td>
				<td>
					<g:Label styleName="aon-width-all {style.label}">Cuenta definida en el perfil del empleado</g:Label>
				</td>
			</tr>
			<tr>
				<td style="background-color: #d7d7d7;">
					CC:
				</td>
				<td>
					<g:TextBox ui:field="cc"></g:TextBox>
				</td>
			</tr>
			<tr>
				<td style="background-color: #d7d7d7;">
					CCO:
				</td>
				<td>
					<g:TextBox ui:field="cco"></g:TextBox>
				</td>
			</tr>
			<tr> </tr>
			<tr>
				<td colspan="2">
					<g:HTMLPanel ui:field="textAreaPanel"></g:HTMLPanel>
				</td>
			</tr>
			<tr style="background-color: #d7d7d7;">
				<td colspan="2">
					<g:Label styleName="aon-width-all {style.label}">* Los valores NOMBRE_EMPLEADO y PERIODOS_NOMINA serán sustituidos por la información correspondiente en cada caso.</g:Label> 
				</td>
			</tr>
			<tr>
				<td colspan="2" align="right" style="padding-top: 10px;">
					<g:Button ui:field="cancelButton" debugId="activityDialogCancelButton">Cancelar</g:Button>
					<g:Button ui:field="acceptButton" debugId="activityDialogAcceptButton" >Enviar</g:Button>
				</td>
			</tr>
		</table>


	</g:HTMLPanel>

</ui:UiBinder>