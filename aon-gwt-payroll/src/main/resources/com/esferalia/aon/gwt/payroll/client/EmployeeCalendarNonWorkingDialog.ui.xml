<ui:UiBinder 
    xmlns:ui='urn:ui:com.google.gwt.uibinder'
	xmlns:g='urn:import:com.google.gwt.user.client.ui'>
    
	<ui:style>
	
		.form {
			padding: 10px;
		}
		
		.rowPanel{
			display: flex;
			justify-content: space-between;
			margin: 3px 0;
		}
		
		.hoursPanel{
			display: flex;
			flex-direction: column;
			border: 1px solid #e1e1e1;
			padding: 5px;
			margin-bottom: 10px;
		}
		
		.buttonsPanel{
			display: flex;
			justify-content: flex-end;
		}
		
		.labelStyle{
			display: flex;
			align-items: center;
		}

	</ui:style>

	<g:HTMLPanel styleName="{style.form}">

		<g:HTMLPanel styleName="aon-width-all aon-height-all">
		
			<g:HTMLPanel styleName="{style.hoursPanel}">
				<g:HTMLPanel styleName="{style.rowPanel}">
					<g:CheckBox ui:field="mondayCB"></g:CheckBox>
					<g:Label styleName="{style.labelStyle}">Lunes</g:Label>
				</g:HTMLPanel>
				
				<g:HTMLPanel styleName="{style.rowPanel}">
					<g:CheckBox ui:field="tuesdayCB"></g:CheckBox>
					<g:Label styleName="{style.labelStyle}">Martes</g:Label>
				</g:HTMLPanel>
				
				<g:HTMLPanel styleName="{style.rowPanel}">
					<g:CheckBox ui:field="wednesdayCB"></g:CheckBox>
					<g:Label styleName="{style.labelStyle}">Miércoles</g:Label>
				</g:HTMLPanel>
				
				<g:HTMLPanel styleName="{style.rowPanel}">
					<g:CheckBox ui:field="thursdayCB"></g:CheckBox>
					<g:Label styleName="{style.labelStyle}">Jueves</g:Label>
				</g:HTMLPanel>
				
				<g:HTMLPanel styleName="{style.rowPanel}">
					<g:CheckBox ui:field="fridayCB"></g:CheckBox>
					<g:Label styleName="{style.labelStyle}">Viernes</g:Label>
				</g:HTMLPanel>
				
				<g:HTMLPanel styleName="{style.rowPanel}">
					<g:CheckBox ui:field="saturdayCB"></g:CheckBox>
					<g:Label styleName="{style.labelStyle}">Sábado</g:Label>
				</g:HTMLPanel>
				
				<g:HTMLPanel styleName="{style.rowPanel}">
					<g:CheckBox ui:field="sundayCB"></g:CheckBox>
					<g:Label styleName="{style.labelStyle}">Domingo</g:Label>
				</g:HTMLPanel>
			</g:HTMLPanel>
			
			<g:HTMLPanel styleName="{style.buttonsPanel}">
				<g:Button ui:field="cancelButton">Cerrar</g:Button>
			    <g:Button ui:field="acceptButton">OK</g:Button>
			</g:HTMLPanel>
				
		</g:HTMLPanel>
		
	</g:HTMLPanel>

</ui:UiBinder>