<ui:UiBinder
    xmlns:ui='urn:ui:com.google.gwt.uibinder'
	xmlns:g='urn:import:com.google.gwt.user.client.ui'>

	<ui:with field='msgs' type='com.esferalia.aon.gwt.payroll.client.i18n.PayrollMessages'/>

    <ui:style>

		.form {
			padding: 10px;
		}

		.rowPanel{
			display: flex;
			justify-content: space-between;
			margin: 3px 0;
		}

		.hoursPanel{
			display: flex;
			flex-direction: column;
			border: 1px solid #e1e1e1;
			padding: 5px;
			margin-bottom: 10px;
		}

		.buttonsPanel{
			display: flex;
			justify-content: flex-end;
			gap: .5rem;
		}

		.labelStyle{
			display: flex;
			align-items: center;
		}

	</ui:style>

	<g:HTMLPanel styleName="{style.form}">

		<g:HTMLPanel styleName="aon-width-all aon-height-all">

			<g:HTMLPanel styleName="{style.hoursPanel}">
				<g:HTMLPanel styleName="{style.rowPanel}">
					<g:CheckBox ui:field="mondayCB"></g:CheckBox>
					<g:Label styleName="{style.labelStyle}">{msgs.mondayColon}</g:Label>
				</g:HTMLPanel>

				<g:HTMLPanel styleName="{style.rowPanel}">
					<g:CheckBox ui:field="tuesdayCB"></g:CheckBox>
					<g:Label styleName="{style.labelStyle}">{msgs.tuesdayColon}</g:Label>
				</g:HTMLPanel>

				<g:HTMLPanel styleName="{style.rowPanel}">
					<g:CheckBox ui:field="wednesdayCB"></g:CheckBox>
					<g:Label styleName="{style.labelStyle}">{msgs.wednesdayColon}</g:Label>
				</g:HTMLPanel>

				<g:HTMLPanel styleName="{style.rowPanel}">
					<g:CheckBox ui:field="thursdayCB"></g:CheckBox>
					<g:Label styleName="{style.labelStyle}">{msgs.thursdayColon}</g:Label>
				</g:HTMLPanel>

				<g:HTMLPanel styleName="{style.rowPanel}">
					<g:CheckBox ui:field="fridayCB"></g:CheckBox>
					<g:Label styleName="{style.labelStyle}">{msgs.fridayColon}</g:Label>
				</g:HTMLPanel>

				<g:HTMLPanel styleName="{style.rowPanel}">
					<g:CheckBox ui:field="saturdayCB"></g:CheckBox>
					<g:Label styleName="{style.labelStyle}">{msgs.saturdayColon}</g:Label>
				</g:HTMLPanel>

				<g:HTMLPanel styleName="{style.rowPanel}">
					<g:CheckBox ui:field="sundayCB"></g:CheckBox>
					<g:Label styleName="{style.labelStyle}">{msgs.sundayColon}</g:Label>
				</g:HTMLPanel>
			</g:HTMLPanel>

			<g:HTMLPanel styleName="{style.buttonsPanel}">
				<g:Button ui:field="cancelButton">{msgs.cancel}</g:Button>
			    <g:Button ui:field="acceptButton">{msgs.ok}</g:Button>
			</g:HTMLPanel>

		</g:HTMLPanel>

	</g:HTMLPanel>

</ui:UiBinder>
