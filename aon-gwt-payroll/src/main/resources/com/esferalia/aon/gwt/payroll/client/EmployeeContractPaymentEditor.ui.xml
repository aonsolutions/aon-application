<ui:UiBinder
    xmlns:ui='urn:ui:com.google.gwt.uibinder'
	xmlns:g='urn:import:com.google.gwt.user.client.ui'
	xmlns:c='urn:import:com.esferalia.aon.gwt.common.client.widget'
	xmlns:a='urn:import:com.esferalia.aon.gwt.payroll.client'>

	<ui:with field='msgs' type='com.esferalia.aon.gwt.payroll.client.i18n.PayrollMessages'/>

    <ui:style>

		.form{
			width: 40rem;
			height: 100%;
			padding: .7rem;
		}

		.flexColumn{
			display: flex;
			flex-direction: column;
			gap: .5rem;
		}

		.buttonsPanel{
			width: 100%;
			display: flex;
			justify-content: flex-end;
			gap: 3em;
		}

		.element{
			display: flex;
			flex-direction: column;
			gap: .2em;
		}

		.title{
			font-weight: bold;
		}

		.widthAll{
			width: 100%;
		}

		.flex{
			width: 100%;
			display: flex;
			justify-content: space-between;
			gap: .5rem;
		}

		.date{
			width: auto !important;
			text-align: center;
			height: 1.2rem;
		}

		.aon-toolbar-button {
		    height: 24px;
		    padding-left: 25px;
		    background-position: .2rem;
		    background-repeat: no-repeat;
		    background-color: transparent;
		    background-size: 20px;
		    border: none;
			cursor: pointer;
		}

		.mt-1 {
			margin: 1rem 0;
		}

	</ui:style>

	<g:HTMLPanel styleName="{style.flexColumn} {style.mt-1}">
		<g:HTMLPanel ui:field="messagePanel" />

		<g:HTMLPanel styleName="{style.form} {style.flexColumn}">

			<g:DeckPanel ui:field="deckPanel">

				<!-- PAYMENT -->

				<g:HTMLPanel ui:field="paymentTable" styleName="{style.flexColumn}">
					<g:HTMLPanel styleName="{style.element}">
						<g:Label styleName="{style.title}" text="{msgs.type}"/>
						<g:HTMLPanel ui:field="paymentTypePanel" styleName="{style.widthAll}"/>
					</g:HTMLPanel>
					<g:HTMLPanel styleName="{style.element}">
						<g:Label styleName="{style.title}" text="{msgs.concept}"/>
						<g:SuggestBox ui:field="paymentConceptSB"/>
					</g:HTMLPanel>
					<g:HTMLPanel styleName="{style.element}">
						<g:Label styleName="{style.title}" text="{msgs.description}"/>
						<g:TextBox ui:field="paymentDescriptionTB"/>
					</g:HTMLPanel>
					<g:HTMLPanel styleName="{style.element}">
						<g:Label styleName="{style.title}" text="{msgs.expression}"/>
						<g:TextArea ui:field="paymentExpressionTB"/>
					</g:HTMLPanel>
					<g:HTMLPanel styleName="{style.element}">
						<g:Label styleName="{style.title}" text="{msgs.salaryReceiptType}"/>
						<g:ListBox ui:field="paymentSalaryTypeLB"/>
					</g:HTMLPanel>
					<g:HTMLPanel styleName="{style.element}">
						<g:Label styleName="{style.title}" text="{msgs.taxable}"/>
						<g:HTMLPanel styleName="{style.flex}">
							<g:ListBox ui:field="paymentTaxedTypeLB"/>
							<g:TextBox ui:field="paymentTaxedExpression" styleName="{style.widthAll}"/>
						</g:HTMLPanel>
					</g:HTMLPanel>
					<g:HTMLPanel styleName="{style.element}">
						<g:Label styleName="{style.title}" text="{msgs.contributory}"/>
						<g:HTMLPanel styleName="{style.flex}">
							<g:ListBox ui:field="paymentQuoteTypeLB"/>
							<g:TextBox ui:field="paymentQuoteExpression" styleName="{style.widthAll}"/>
						</g:HTMLPanel>
					</g:HTMLPanel>
					<g:HTMLPanel styleName="{style.flex}">
						<g:HTMLPanel styleName="{style.element} {style.widthAll}" ui:field="paymentMonthPanel">
							<g:Label styleName="{style.title}" text="{msgs.paymentMonth}"/>
							<g:ListBox ui:field="paymentMonthLB"/>
						</g:HTMLPanel>
						<g:HTMLPanel styleName="{style.element} {style.widthAll}">
							<g:Label styleName="{style.title}" text="{msgs.startDate}"/>
							<c:DateBoxEx ui:field="paymentStartDateBx" styleName="{style.date}"/>
						</g:HTMLPanel>
						<g:HTMLPanel styleName="{style.element} {style.widthAll}">
							<g:Label styleName="{style.title}" text="{msgs.endDate}"/>
							<c:DateBoxEx ui:field="paymentEndDateBx" styleName="{style.date}"/>
						</g:HTMLPanel>
					</g:HTMLPanel>
				</g:HTMLPanel>

				<!-- DEDUCTION -->

				<g:HTMLPanel ui:field="deductionTable" styleName="{style.flexColumn}">
					<g:HTMLPanel styleName="{style.element}">
						<g:Label styleName="{style.title}" text="{msgs.type}"/>
						<g:ListBox ui:field="deductionTypeLB" styleName="{style.widthAll}"/>
					</g:HTMLPanel>
					<g:HTMLPanel styleName="{style.element}">
						<g:Label styleName="{style.title}" text="{msgs.concept}"/>
						<g:SuggestBox ui:field="deductionConceptSB"/>
					</g:HTMLPanel>
					<g:HTMLPanel styleName="{style.element}">
						<g:Label styleName="{style.title}" text="{msgs.description}"/>
						<g:TextBox ui:field="deductionDescriptionTB"/>
					</g:HTMLPanel>
					<g:HTMLPanel styleName="{style.element}">
						<g:Label styleName="{style.title}" text="{msgs.expression}"/>
						<g:TextArea ui:field="deductionExpressionTB"/>
					</g:HTMLPanel>
					<g:HTMLPanel styleName="{style.flex}">
						<g:HTMLPanel styleName="{style.element} {style.widthAll}">
							<g:Label styleName="{style.title}" text="{msgs.startDate}"/>
							<c:DateBoxEx ui:field="deductionStartDateBx" styleName="{style.date}"/>
						</g:HTMLPanel>
						<g:HTMLPanel styleName="{style.element} {style.widthAll}">
							<g:Label styleName="{style.title}" text="{msgs.endDate}"/>
							<c:DateBoxEx ui:field="deductionEndDateBx" styleName="{style.date}"/>
						</g:HTMLPanel>
					</g:HTMLPanel>
				</g:HTMLPanel>

				<!-- COST -->

				<g:HTMLPanel ui:field="costTable" styleName="{style.flexColumn}">
					<g:HTMLPanel styleName="{style.element}">
						<g:Label styleName="{style.title}" text="{msgs.type}"/>
						<g:ListBox ui:field="costTypeLB" styleName="{style.widthAll}"/>
					</g:HTMLPanel>
					<g:HTMLPanel styleName="{style.element}">
						<g:Label styleName="{style.title}" text="{msgs.code}"/>
						<g:SuggestBox ui:field="costCodeSB"/>
					</g:HTMLPanel>
					<g:HTMLPanel styleName="{style.element}">
						<g:Label styleName="{style.title}" text="{msgs.description}"/>
						<g:TextBox ui:field="costDescriptionTB"/>
					</g:HTMLPanel>
					<g:HTMLPanel styleName="{style.element}">
						<g:Label styleName="{style.title}" text="{msgs.expression}"/>
						<g:TextArea ui:field="costExpressionTB"/>
					</g:HTMLPanel>
					<g:HTMLPanel styleName="{style.flex}">
						<g:HTMLPanel styleName="{style.element} {style.widthAll}">
							<g:Label styleName="{style.title}" text="{msgs.startDate}"/>
							<c:DateBoxEx ui:field="costStartDateBx" styleName="{style.date}"/>
						</g:HTMLPanel>
						<g:HTMLPanel styleName="{style.element} {style.widthAll}">
							<g:Label styleName="{style.title}" text="{msgs.endDate}"/>
							<c:DateBoxEx ui:field="costEndDateBx" styleName="{style.date}"/>
						</g:HTMLPanel>
					</g:HTMLPanel>
				</g:HTMLPanel>

				<!-- BONUS -->

				<g:HTMLPanel ui:field="bonusTable" styleName="{style.flexColumn}">
					<g:HTMLPanel styleName="{style.element}">
						<g:Label styleName="{style.title}" text="{msgs.type}"/>
						<g:HTMLPanel ui:field="bonusTypePanel" styleName="{style.widthAll}"/>
					</g:HTMLPanel>
					<g:HTMLPanel styleName="{style.element}">
						<g:Label styleName="{style.title}" text="{msgs.description}"/>
						<g:SuggestBox ui:field="bonusDescriptionSB"/>
					</g:HTMLPanel>
					<g:HTMLPanel styleName="{style.element}">
						<g:Label styleName="{style.title}" text="{msgs.expression}"/>
						<g:TextArea ui:field="bonusExpressionTB"/>
					</g:HTMLPanel>
					<g:HTMLPanel styleName="{style.flex}">
						<g:HTMLPanel styleName="{style.element} {style.widthAll}">
							<g:Label styleName="{style.title}" text="{msgs.startDate}"/>
							<c:DateBoxEx ui:field="bonusStartDateBx" styleName="{style.date}"/>
						</g:HTMLPanel>
						<g:HTMLPanel styleName="{style.element} {style.widthAll}">
							<g:Label styleName="{style.title}" text="{msgs.endDate}"/>
							<c:DateBoxEx ui:field="bonusEndDateBx" styleName="{style.date}"/>
						</g:HTMLPanel>
					</g:HTMLPanel>
				</g:HTMLPanel>

				<!-- EMBARGO -->

				<g:HTMLPanel ui:field="embargoTable" styleName="{style.flexColumn}">
					<g:HTMLPanel styleName="{style.element}">
						<g:Label styleName="{style.title}" text="{msgs.description}"/>
						<g:TextBox ui:field="embargoDescriptionTB"/>
					</g:HTMLPanel>
					<g:HTMLPanel styleName="{style.element}">
						<g:Label styleName="{style.title}" text="{msgs.expression}"/>
						<g:TextArea ui:field="embargoExpressionTB"/>
					</g:HTMLPanel>
					<g:HTMLPanel styleName="{style.element}">
						<g:Label styleName="{style.title}" text="{msgs.amount}"/>
						<c:DoubleBox ui:field="embargoAmountDB" styleName="{style.widthAll}" />
					</g:HTMLPanel>
					<g:HTMLPanel styleName="{style.flex}">
						<g:HTMLPanel styleName="{style.element} {style.widthAll}">
							<g:Label styleName="{style.title}" text="{msgs.startDate}"/>
							<c:DateBoxEx ui:field="embargoStartDateBx" styleName="{style.date}"/>
						</g:HTMLPanel>
						<g:HTMLPanel styleName="{style.element} {style.widthAll}">
							<g:Label styleName="{style.title}" text="{msgs.endDate}"/>
							<c:DateBoxEx ui:field="embargoEndDateBx" styleName="{style.date}"/>
						</g:HTMLPanel>
					</g:HTMLPanel>
				</g:HTMLPanel>

			</g:DeckPanel>

			<g:HTMLPanel ui:field="buttonsPanel" styleName="{style.buttonsPanel}"/>

		</g:HTMLPanel>
	</g:HTMLPanel>


</ui:UiBinder>
