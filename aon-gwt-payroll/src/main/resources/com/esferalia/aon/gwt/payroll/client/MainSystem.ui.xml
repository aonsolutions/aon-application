<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<ui:UiBinder xmlns:ui='urn:ui:com.google.gwt.uibinder'
	xmlns:g='urn:import:com.google.gwt.user.client.ui' xmlns:aon='urn:import:com.esferalia.aon.gwt.payroll.client'>


	<ui:style>
	
	.stackHeader {
	  padding: .7em .5em .7em .6em;
	  
	}

	@sprite .configIcon {
	     gwt-image: 'configgroup';
	     float: left;
	   }

	</ui:style>

	<ui:image field='configgroup' src='configgroup.png' />

	<g:SplitLayoutPanel ui:field="splitLayoutPanel">
		<g:west size='275'>

			<g:StackLayoutPanel unit='EM'>

				<g:stack ui:field="configStack">
					<g:header size='3'>
						<div class='{style.stackHeader}'>
							<div class='{style.configIcon}' />
							CONFIGURACI&Oacute;N
						</div>
					</g:header>
					<aon:MetaData ui:field='metaData' />
				</g:stack>

			</g:StackLayoutPanel>


		</g:west>
		<g:center>
			<aon:DetailPanel ui:field='detailPanel' />
		</g:center>


	</g:SplitLayoutPanel>

</ui:UiBinder>
