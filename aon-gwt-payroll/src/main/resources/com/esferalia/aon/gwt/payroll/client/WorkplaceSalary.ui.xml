<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
	xmlns:g='urn:import:com.google.gwt.user.client.ui'
	xmlns:a='urn:import:com.esferalia.aon.gwt.common.client.widget'
	xmlns:c='urn:import:com.google.gwt.user.cellview.client'>

	<ui:with field='res'
		type='com.esferalia.aon.gwt.common.client.css.AonResources' />

	<ui:style type="com.esferalia.aon.gwt.payroll.client.WorkplaceSalary.MyStyle">
		.tree {
      		width: 500px;
	      	border: 1px solid #ccc;
	    }
	    
	    .selectedLabel {
	      	padding-left: 15px;
	    }
	    
	    .tableStyle{
			margin: auto;
			padding-top: 1em;
		}
		
		.mAuto{
			margin: auto;
		}
		
		.widthAll{
			width: 100%
		}
	</ui:style>

	<g:DockLayoutPanel unit="PX">
		<!-- INIT HEADER MENU -->
		<g:north size="25">
			<g:FlowPanel styleName="aon-finding-title-toolbar">
				<g:HorizontalPanel >
					<g:HTMLPanel styleName="aon-finding-title">
						<g:HTMLPanel styleName="aon-finding-title-internal" >
							<g:Label styleName="aon-outputText">Nóminas</g:Label>
						</g:HTMLPanel>
					</g:HTMLPanel>
					<g:HTMLPanel styleName="aon-finding-subtitle">
						<g:HTMLPanel styleName="aon-finding-aubtitle-internal" >
							<g:Label styleName="aon-outputText" text=" "/> 
						</g:HTMLPanel>
					</g:HTMLPanel>
					<g:HorizontalPanel styleName="aon-finding-toolbar">
						<g:HTMLPanel styleName="aon-finding-toolbar-item-group" >
							<g:Button ui:field='deleteButton' styleName='aon-finding-toolbar-item aon-icon-delete' text="BORRAR"/>
							<!--  g:Button ui:field='printButton' styleName='aon-finding-toolbar-item aon-icon-pdf' text="IMPRIMIR" /-->
							<g:Button debugId='saveButton' ui:field='saveButton' styleName='aon-finding-toolbar-item aon-icon-mail-save' text="DESCARGAR" />
							<g:Button ui:field='publishButton' styleName='aon-finding-toolbar-item aon-icon-google-drive' text="PUBLICAR" />
						</g:HTMLPanel>
					</g:HorizontalPanel>
				</g:HorizontalPanel>
			</g:FlowPanel>
		</g:north>
		<!-- END HEADER MENU -->
		<g:center>
			<g:HTMLPanel ui:field="mainContainer" styleName="{style.widthAll}">
			    
			</g:HTMLPanel>
		</g:center>
	</g:DockLayoutPanel>
</ui:UiBinder> 

