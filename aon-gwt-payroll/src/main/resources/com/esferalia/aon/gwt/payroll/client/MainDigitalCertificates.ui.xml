<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
	xmlns:g='urn:import:com.google.gwt.user.client.ui'
	xmlns:e='urn:import:com.esferalia.aon.gwt.payroll.client'>

	<ui:with field='res'
		type='com.esferalia.aon.gwt.common.client.css.AonResources' />

	<ui:style type="com.esferalia.aon.gwt.payroll.client.MainDigitalCertificates.MyStyle">
		
		.warningColor{
			font-weight: bold;
			color: #be0000;
		}
		
		.styleBorder{
			border-style: solid; 
			width: 975px; 
			border-width: 1px; 
			margin: 60px 10px 0 10px;
		}
		
		.tittle{
			top: -1.2em;
			font-size: 12px;
			margin-left: 10px;
			position: relative;
			width: 150px;
			background-color: white;
			padding: 5px;
			text-align: center;
		}
		
		.footerStyle{
			background-color: #eaeaea;
			padding-top: 5px;
		}
		
		.footerElement{
			margin-left: 10px;
			width: 940px;
			border: none;
		}
		
		.scrollStyle {
			margin-left: 10px;
			width: 950px;
			margin-bottom: 10px;
		}
		
		.gridStyle{
			margin-left: 10px;
			width: 950px;
		}
		
		.center{
			display: flex;
			justify-content: center;
		}
		
		.headerStyle{
			font-weight: bold;
			padding-left: 5px;
		}
		
		.widthAll{
			width: 100%;
		}
		
		.heightAll{
			height: 100%;
		}
		
		.message{
			display: flex;
			width: 100%;
			justify-content: center;
			align-items: center;
		}
		
		.secondaryUserToolbar{
			padding: 10px;
			display: flex;
		    align-items: center;
		    justify-content: space-between;
		}
		
		.addSecondaryUserToolbar{
			display: flex;
		    align-items: center;
		}
		
		.showSecondaryUserToolbar{
			display: flex;
		    align-items: center;
		    justify-content: flex-end;
		}
		
		.loadingPanel{
			display: flex;
			align-items: center;
			animation-name: spin;
			animation-duration: 2500ms;
			animation-iteration-count: infinite;
			animation-timing-function: linear;
		}
		
		@keyframes spin {
		    from {
		        transform:rotate(0deg);
		    }
		    to {
		        transform:rotate(360deg);
		    }
		}
		
	</ui:style>

	<g:DockLayoutPanel ui:field="dockLayoutPanel" unit="PX">
		<g:center>
			<g:HTMLPanel styleName="{style.widthAll} {style.heightAll} {style.center}" debugId="activityHTMLPanel">
	    		
	    		<g:VerticalPanel>
	    			<g:VerticalPanel styleName="{style.styleBorder}">
			    		<g:Label styleName='{style.tittle}'>Cert. del Usuario</g:Label>
				    	<g:HTMLPanel styleName="{style.widthAll} {style.heightAll} " debugId="paymetDialogHTMLPanel">
				    		<g:VerticalPanel>
				    			<g:Grid ui:field="digitalCertificatesDataTableHeader" styleName="{style.gridStyle}"></g:Grid>
				    			<g:HTMLPanel>
				    				<hr align="left" noshade="noshade" style="margin-bottom: 10px;border-width: 0.5px;margin-left: 10px;"/>
				    			</g:HTMLPanel>
					    		<g:ScrollPanel ui:field="scrollPanel" styleName="{style.scrollStyle}">
					    			<g:Grid ui:field="digitalCertificatesDataTable"></g:Grid>
					    		</g:ScrollPanel>
				    		</g:VerticalPanel>
				    	</g:HTMLPanel>
				    </g:VerticalPanel>
				    
				    <g:VerticalPanel ui:field="secondayUsersPanel" styleName="{style.styleBorder}">
			    		<g:Label styleName='{style.tittle}'>Usr. Secundarios</g:Label>
				    	<g:HTMLPanel styleName="{style.widthAll} {style.heightAll} " debugId="paymetDialogHTMLPanel">
				    		<g:VerticalPanel>
				    			<g:Grid ui:field="secondaryUserDataTableHeader" styleName="{style.gridStyle}"></g:Grid>
				    			<g:HTMLPanel>
				    				<hr align="left" noshade="noshade" style="margin-bottom: 10px;border-width: 0.5px;margin-left: 10px;"/>
				    			</g:HTMLPanel>
					    		<g:ScrollPanel ui:field="secondaryUserScrollPanel" styleName="{style.scrollStyle}">
					    			<g:DeckPanel ui:field="secondaryUserDeckPanel">
					    				<g:HTMLPanel ui:field="loadingPanel" styleName="{style.message}"></g:HTMLPanel>
					    				<g:Label styleName="{style.message}">No eisten usuarios secundarios</g:Label>
					    				<g:Grid ui:field="secondaryUserDataTable"></g:Grid>
					    			</g:DeckPanel>
					    		</g:ScrollPanel>
					    		<g:HTMLPanel styleName="{style.secondaryUserToolbar}" ui:field="secondaryUserToolbar">
					    			<g:HTMLPanel styleName="{style.addSecondaryUserToolbar}" ui:field="addSecondaryUserToolbar"></g:HTMLPanel>
					    			<g:HTMLPanel styleName="{style.showSecondaryUserToolbar}" ui:field="showSecondaryUserToolbar"></g:HTMLPanel>
					    		</g:HTMLPanel>
				    		</g:VerticalPanel>
				    	</g:HTMLPanel>
				    </g:VerticalPanel>
	    		</g:VerticalPanel>
	    		
	    	</g:HTMLPanel>
		</g:center>
	</g:DockLayoutPanel>
</ui:UiBinder> 

