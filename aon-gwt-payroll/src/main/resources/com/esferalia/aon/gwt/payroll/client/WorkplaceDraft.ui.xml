<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
	xmlns:g='urn:import:com.google.gwt.user.client.ui' 
	xmlns:a='urn:import:com.esferalia.aon.gwt.common.client.widget'
	xmlns:e='urn:import:com.esferalia.aon.gwt.payroll.client'>

	<ui:with field='res' type='com.esferalia.aon.gwt.common.client.css.AonResources' />

	<ui:style>

		.paddingTop{
			padding-top: 5px !important;
		}

		.fontEnableStyle{
			font-weight: bold;
    		color: #000;
    		white-space: nowrap;
    		font-size: smaller;
    		padding-left: 30px;
    		width: 80px;
			cursor: pointer;
		}

		.estiloBorrarCuandoSeActiveBoton{
			background: none !important;
		}

	</ui:style>

	<g:DockLayoutPanel unit="PX">
		<g:north size="72">
			<g:FlowPanel>
				<g:FlowPanel styleName="aon-finding-title-toolbar">
					<g:HorizontalPanel>
						<g:HTMLPanel styleName="aon-finding-title">
							<g:HTMLPanel styleName="aon-finding-title-internal {style.estiloBorrarCuandoSeActiveBoton}">
								<g:Label styleName="aon-outputText">Centro de Trabajo :</g:Label>
							</g:HTMLPanel>
						</g:HTMLPanel>
						<g:HTMLPanel styleName="aon-finding-subtitle">
							<g:HTMLPanel styleName="aon-finding-subtitle-internal">
								<g:Label styleName="aon-outputText"></g:Label>
							</g:HTMLPanel>
						</g:HTMLPanel>
						<g:HorizontalPanel styleName="aon-finding-toolbar">
							<g:HTMLPanel styleName="aon-finding-toolbar-item-group">
								<g:Button ui:field='newContractButton'
									styleName='aon-finding-toolbar-item aon-icon-reset' text="NUEVO CONTRATO"
									enabled="true" />
							</g:HTMLPanel>
							<g:HTMLPanel styleName="aon-finding-toolbar-item-group {style.paddingTop}">
							    <g:HorizontalPanel ui:field='saveStatusPanel'>
							        <g:Label ui:field='saveStatus' styleName="{style.fontEnableStyle}" visible="true"></g:Label>
							    </g:HorizontalPanel>
							</g:HTMLPanel>
						</g:HorizontalPanel>
					</g:HorizontalPanel>
				</g:FlowPanel>
				<g:FlowPanel styleName="aon-finding-title-toolbar">
					<g:HorizontalPanel>
						<g:HTMLPanel styleName="aon-finding-title">
							<g:HTMLPanel styleName="aon-finding-title-internal">
								<g:Label styleName="aon-outputText">Edici&oacute;n</g:Label>
							</g:HTMLPanel>
						</g:HTMLPanel>
						<g:HTMLPanel styleName="aon-finding-subtitle">
							<g:HTMLPanel styleName="aon-finding-subtitle-internal">
								<g:Label styleName="aon-outputText"></g:Label>
							</g:HTMLPanel>
						</g:HTMLPanel>
						<g:HorizontalPanel styleName="aon-finding-toolbar">
							<g:HTMLPanel styleName="aon-finding-toolbar-item-group">
								<g:Button debugId='undoAllButton' ui:field='undoAllButton'
									styleName='aon-finding-toolbar-item {res.css.aonIconUndoAll}' />
								<g:Button debugId='undoButton' ui:field='undoButton'
									styleName='aon-finding-toolbar-item {res.css.aonIconUndo}' />
								<g:Button debugId='redoButton' ui:field='redoButton'
									styleName="aon-finding-toolbar-item {res.css.aonIconRedo}" />
							</g:HTMLPanel>
						</g:HorizontalPanel>
					</g:HorizontalPanel>
				</g:FlowPanel>
			</g:FlowPanel>
		</g:north>
		<g:center>
			<e:Workplace ui:field="workplace"/>
		</g:center>
	</g:DockLayoutPanel>
</ui:UiBinder> 

