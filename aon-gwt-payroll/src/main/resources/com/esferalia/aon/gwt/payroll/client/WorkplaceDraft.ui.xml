<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
	xmlns:g='urn:import:com.google.gwt.user.client.ui' 
	xmlns:a='urn:import:com.esferalia.aon.gwt.common.client.widget'
	xmlns:e='urn:import:com.esferalia.aon.gwt.payroll.client'>

	<ui:with field='res'
		type='com.esferalia.aon.gwt.common.client.css.AonResources' />

	<ui:style
		type="com.esferalia.aon.gwt.payroll.client.WorkplaceDraft.MyStyle">

		.noselect {
			-webkit-touch-callout: none; /* iOS Safari */
			-webkit-user-select: none; /* Safari */
			-khtml-user-select: none; /*Konqueror HTML */
			-moz-user-select: none; /* Firefox */
			-ms-user-select: none; /* Internet Explorer/Edge */
			user-select: none; /* Non-prefixed version, currently supported by Chrome and Opera */
		}

		@external gwt-Selector;
		@external gwt-SuggestBoxPopup;
		.gwt-SuggestBoxPopup {
			z-index: 105;
		}

		.gwt-Selector .gwt-SuggestBoxPopup{
			z-index: 105;
			height: inherit;
		}

		.headerStyle{
			top: -0.5em;
			font-size: 12px;
			margin-left: 10px;
		}

		.requiredColor{
			color: #2152A5;
			font-weight: bold !important;
		}

		.warningColor{
			color: #f90303;
    		font-weight: bold;
		}

		.hide{
			display: none;
		}

		.maxWidth{
			width: 100%;
		}

		.maxWidthTextBox{
			width: 99.7%;
		}
		
		.maxWidthTextBox2{
			width: 99.4%;
		}

		.alignTextCenter{
			text-align: center;
		}

		.firstColumnTextStyle{
			padding: 5px !important;
		}

		.lookupStyle{
			height: 20px;
    		border: none !important;
   		 	margin-left: 15px;
    		width: 100%;
		}

		.paddingTop{
			padding-top: 5px !important;
		}

		.paddingEnableDisable{
			position: fixed;
    		padding-top: 0px;
    		border: none;
    		top: 99px;
    		width: 32px;
		}

		.fontEnableStyle{
			font-weight: bold;
    		color: #000;
    		white-space: nowrap;
    		font-size: smaller;
    		padding-left: 30px;
    		width: 80px;
			cursor: pointer;
		}

		.fontDisableStyle{
			font-weight: bold;
    		color: #000;
    		white-space: nowrap;
    		font-size: smaller;
    		padding-left: 30px;
    		width: 100px;
			cursor: pointer;
		}

		.estiloBorrarCuandoSeActiveBoton{
			background: none !important;
		}
		
		.borderNone{
			border: none;
		}
		
		.styleBorder{
			border-style: solid; 
			width: 975px; 
			border-width: 1px; 
			margin-top: 20px; 
			margin-left: 10px;
		}
		
		.styleBorder2{
			border-style: solid; 
			width: 975px; 
			border-width: 1px; 
			margin-top: 40px; 
			margin-left: 10px;
		}

	</ui:style>

	<g:DockLayoutPanel unit="PX">
		<g:north size="25">
			<g:FlowPanel styleName="aon-finding-title-toolbar">
				<g:HorizontalPanel>
					<g:HTMLPanel styleName="aon-finding-title">
						<g:HTMLPanel styleName="aon-finding-title-internal {style.estiloBorrarCuandoSeActiveBoton}">
							<g:Label styleName="aon-outputText">Laboral : Centro de trabajo :</g:Label>
						</g:HTMLPanel>
					</g:HTMLPanel>
					<g:HTMLPanel styleName="aon-finding-subtitle">
						<g:HTMLPanel styleName="aon-finding-subtitle-internal">
							<g:Label styleName="aon-outputText"></g:Label>
						</g:HTMLPanel>
					</g:HTMLPanel>
					<g:HTMLPanel styleName="aon-finding-toolbar-item-group">
						<g:Button ui:field='newContractButton'
							styleName='aon-finding-toolbar-item aon-icon-reset' text="NUEVO CONTRATO"
							enabled="true" />
					</g:HTMLPanel>
					<g:HTMLPanel styleName="aon-finding-toolbar-item-group {style.paddingTop}">
					    <g:HorizontalPanel ui:field='saveStatusPanel'>
					        <g:Label ui:field='saveStatus' styleName="{style.fontEnableStyle}" visible="true"></g:Label>
					    </g:HorizontalPanel>
					</g:HTMLPanel>
					<g:HTMLPanel styleName="aon-finding-toolbar-item-group {style.paddingTop}">
					    <g:HorizontalPanel ui:field='enableWorkplacePanel'>
					        <g:Button ui:field='enableWorkplaceButton' styleName="{style.fontEnableStyle}" visible="false" enabled="false">ACTIVAR</g:Button>
					    </g:HorizontalPanel>
					     <g:HorizontalPanel ui:field='disableWorkplacePanel'>
					        <g:Button ui:field='disableWorkplaceButton' styleName="{style.fontDisableStyle}" visible="false" enabled="false">DESACTIVAR</g:Button>
					    </g:HorizontalPanel>
					</g:HTMLPanel>
				</g:HorizontalPanel>
			</g:FlowPanel>
		</g:north>
		<g:center>
			<e:Workplace ui:field="workplace"/>
		</g:center>
	</g:DockLayoutPanel>
</ui:UiBinder> 

