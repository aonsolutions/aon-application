<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
	xmlns:g='urn:import:com.google.gwt.user.client.ui' >

	<ui:with field='res' type='com.esferalia.aon.gwt.common.client.css.AonResources' />

	<ui:style type="com.esferalia.aon.gwt.payroll.client.WorkplaceDraft.MyStyle">

		.container {
			margin: 0 10px;
		}
		
		.flexCenter	{
			width: 100%;
			margin-top: 50px;
		}
		
		.messagePanel {
			margin: 10px 0;
		}

	</ui:style>

	<g:DockLayoutPanel ui:field="dockLayoutPanel" unit="PX">
		<g:center>
			<g:HTMLPanel ui:field="centerContainer" styleName="{style.flexCenter}" />
		</g:center>
	</g:DockLayoutPanel>
	
</ui:UiBinder> 

