<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<ui:UiBinder xmlns:ui='urn:ui:com.google.gwt.uibinder'
	xmlns:g='urn:import:com.google.gwt.user.client.ui' xmlns:e='urn:import:com.esferalia.aon.gwt.payroll.client'
	xmlns:s="urn:import:com.google.gwt.dom.builder.shared">

	<ui:style type='com.esferalia.aon.gwt.payroll.client.SalaryDraft.MyStyle'>
		.editor {
			
		}
		
		.vertical-space {
			height: 20px;
		}

		.horizontal-space {
			width: 5px;
		}

		.document {
			margin-top: 5px;
			margin-left: auto;
			margin-right: auto;
			margin-bottom: 15px;
		}
		
		.value-changed {
			color: #897820;
			font-weight: bold;
			text-shadow: 0.1em 0.1em 0.2em #9E945E;
		}

		.edit-rows .edit-cells {
		}
		
		.edit-rows td, 
		 .edit-cells td {
			color: #000000 !important;			
		}
		
		.edit-rows tr:hover,
		.edit-cells td:hover{
			cursor: pointer;
			background-color: #E2F1F5 !important;
	
		}

		.span-cell {
			padding: 0px !important;
		}
		
		@if !user.agent safari {
			.cell-label {
				font-size: 9px;
				font-weight: bold;
				font-family: sans-serif;
			}
		}
		@else {
			.cell-label {
				font-size: 11px;
				font-weight: bold;
				font-family: sans-serif;
			}
		}
		
		.text-ok,
		.text-ok * {
			color: green !important;
		}

		.text-warn *{
			font-weight: bold;
			color: orange !important;
		}

		.text-error,
		.text-error *{
			font-weight: bold;
			color: red !important;
		}

		@sprite .cell-warn {
			width: auto; 
			height: auto;
			color: orange;
			gwt-image: 'warn';
			padding-left: 14px;
		}

		.span-cell-table {
			width: 100%;
			border-collapse: collapse !important;
		}

		.span-cell-cell {
			border-top: 0px !important;
			border-left: 0px !important;
			border-bottom: 0px !important;
		}
		
		.span-cell-cell-last {
			border: 0px !important;
		}
		
		.toolBar-checkBox input {
			vertical-align: middle;
		}
		
		@sprite .irpfPreviewButton {
			width: auto; 
			height: auto;
			gwt-image: 'aet';
			background-position: left center;
		}

		@sprite .collapseAllButton {
			float: right;
			gwt-image: 'collapseall';
		}

		@sprite .expandAllButton {
			float: right;
			gwt-image: 'expandall';
		}
		@sprite .pdfPreviewButton {
			width: auto; 
			height: auto;
			gwt-image: 'pdfPreview';
			background-position: left center;
		}
		
		@sprite .fxButton {
			gwt-image: 'fx';
			background-position: left center;
		}

		@sprite .redoButton {
			gwt-image: 'redo';
			background-position: left center;
		}

		@sprite .undoButton {
			gwt-image: 'undo';
			background-position: left center;
		}
		
	</ui:style>

	<ui:image field='fx' src='fx.png' />
	<ui:image field='aet' src='aet.png' />
	<ui:image field='redo' src='redo.png' />
	<ui:image field='undo' src='undo.png' />
	<ui:image field='warn' src='warn.png' />
	<ui:image field='expandall' src='expandall.png' />
	<ui:image field='collapseall' src='collapseall.png' />
	<ui:image field='pdfPreview' src='pdfPreview.png' />

	<ui:import field="com.esferalia.aon.gwt.payroll.client.SalaryDraft.*" />

	<g:DockLayoutPanel unit="PX">
		<g:north size="72">

			<g:FlowPanel>

				<g:FlowPanel styleName="aon-finding-title-toolbar">
					<g:HorizontalPanel>
						<g:HTMLPanel styleName="aon-finding-title">
							<g:HTMLPanel styleName="aon-finding-title-internal">
								<g:Label styleName="aon-outputText">Borrador</g:Label>
							</g:HTMLPanel>
						</g:HTMLPanel>
						<g:HTMLPanel styleName="aon-finding-subtitle">
							<g:HTMLPanel styleName="aon-finding-subtitle-internal">
								<g:Label styleName="aon-outputText"></g:Label>
							</g:HTMLPanel>
						</g:HTMLPanel>
						<g:HorizontalPanel styleName="aon-finding-toolbar">
							<g:HTMLPanel styleName="aon-finding-toolbar-item-group">
								<g:Button ui:field='acceptButton'
									styleName='aon-finding-toolbar-item aon-icon-accept' text="GUARDAR"
									enabled="false" />
								<g:Button ui:field='salaryButton'
									styleName='aon-finding-toolbar-item aon-icon-accept' text="EMITIR NOMINA" />
								<g:Button ui:field='printButton'
									styleName='aon-finding-toolbar-item aon-icon-pdf' text="IMPRIMIR" />
								<g:Button ui:field='printPreviewButton'
									styleName='aon-finding-toolbar-item {style.pdfPreviewButton}'
									text="Vista Preliminar" />
								<g:Button ui:field='irpfPreviewButton'
									styleName='aon-finding-toolbar-item {style.irpfPreviewButton}'
									text="IRPF" />
								<e:SalarySelect ui:field="salarySelect" />
								<g:ListBox ui:field="zoomListBox" />
								<g:Button ui:field='closePreviewButton'
									styleName='aon-finding-toolbar-item aon-icon-cancel' text="CERRAR PRELIMINAR" />
							</g:HTMLPanel>
						</g:HorizontalPanel>
					</g:HorizontalPanel>
				</g:FlowPanel>

				<g:FlowPanel styleName="aon-finding-title-toolbar">
					<g:HorizontalPanel>
						<g:HTMLPanel styleName="aon-finding-title">
							<g:HTMLPanel styleName="aon-finding-title-internal">
								<g:Label styleName="aon-outputText">Edici&oacute;n</g:Label>
							</g:HTMLPanel>
						</g:HTMLPanel>
						<g:HTMLPanel styleName="aon-finding-subtitle">
							<g:HTMLPanel styleName="aon-finding-subtitle-internal">
								<g:Label styleName="aon-outputText"></g:Label>
							</g:HTMLPanel>
						</g:HTMLPanel>
						<g:HorizontalPanel styleName="aon-finding-toolbar">
							<g:HTMLPanel styleName="aon-finding-toolbar-item-group">
								<g:Button ui:field="fxButton"
									styleName='aon-finding-toolbar-item {style.fxButton}' enabled="false" />
								<g:Button ui:field="undoButton"
									styleName='aon-finding-toolbar-item {style.undoButton}' />
								<g:Button ui:field='redoButton'
									styleName="aon-finding-toolbar-item {style.redoButton}" />
								<g:ListBox ui:field='datesListBox'>
									<g:item value="{ONLY_THIS_MONTH}">S&oacute;lo este mes</g:item>
									<g:item value="{FROM_THIS_MONTH}">A partir de este mes</g:item>
									<g:item value="{CUSTOM}">GridPersonalizado...</g:item>
								</g:ListBox>
								<g:CheckBox ui:field='dbSalaryCheck'
									styleName='aon-finding-toolbar-item {style.toolBar-checkBox}'
									text="DIFERENCIAS" checked="false" />
							</g:HTMLPanel>
						</g:HorizontalPanel>
					</g:HorizontalPanel>
				</g:FlowPanel>

			</g:FlowPanel>

		</g:north>
		<g:center>
			<g:ScrollPanel styleName="{style.editor}">
				<g:VerticalPanel styleName="{style.document}">
					<g:DeckPanel ui:field="deckPanel">
						<g:VerticalPanel ui:field="draftPanel" width="auto">
							<g:Grid styleName="aon-dataTable">
								<g:row styleName="aon-dataTable-row-odd">
									<g:customCell style="width:50%">
										<g:HTMLPanel>
											<g:Label styleName="{style.cell-label}">EMPRESA</g:Label>
											<g:Label ui:field="enterpriseNameLabel" styleName="aon-text-center">&nbsp; </g:Label>
										</g:HTMLPanel>
									</g:customCell>
									<g:customCell>
										<g:HTMLPanel>
											<g:Label styleName="{style.cell-label}">TRABAJADOR/A</g:Label>
											<g:Label ui:field="employeeNameLabel" styleName="aon-text-center">&nbsp; </g:Label>
										</g:HTMLPanel>
									</g:customCell>
								</g:row>
								<g:row styleName="aon-dataTable-row-even">
									<g:customCell>
										<g:HTMLPanel>
											<g:Label styleName="{style.cell-label}">DOMICILIO</g:Label>
											<g:Label ui:field="enterpriseAddressLabel" styleName="aon-text-center">&nbsp; </g:Label>
										</g:HTMLPanel>
									</g:customCell>
									<g:customCell styleName="{style.span-cell}">
										<g:Grid styleName="{style.span-cell-table}">
											<g:row>
												<g:customCell styleName="{style.span-cell-cell}">
													<g:HTMLPanel>
														<g:Label styleName="{style.cell-label}">CATEGORÍA
															PROFESIONAL</g:Label>
														<g:Label ui:field="employeeAgreementCategoryLabel"
															styleName="aon-text-center">&nbsp; </g:Label>
													</g:HTMLPanel>
												</g:customCell>
												<g:customCell styleName="{style.span-cell-cell}">
													<g:HTMLPanel>
														<g:Label styleName="{style.cell-label}">PUESTO DE
															TRABAJO</g:Label>
														<g:Label ui:field="employeeJobLabel" styleName="aon-text-center">&nbsp; </g:Label>
													</g:HTMLPanel>
												</g:customCell>
												<g:customCell styleName="{style.span-cell-cell-last}">
													<g:HTMLPanel>
														<g:Label styleName="{style.cell-label}">ANTIGUEDAD</g:Label>
														<g:Label ui:field="employeeSeniorityLabel"
															styleName="aon-text-center">&nbsp; </g:Label>
													</g:HTMLPanel>
												</g:customCell>
											</g:row>
										</g:Grid>
									</g:customCell>
								</g:row>
								<g:row styleName="aon-dataTable-row-odd">
									<g:customCell styleName="{style.span-cell}">
										<g:Grid styleName="{style.span-cell-table}">
											<g:row>
												<g:customCell styleName="{style.span-cell-cell}">
													<g:HTMLPanel>
														<g:Label styleName="{style.cell-label}">POBLACION</g:Label>
														<g:Label ui:field="enterpriseCityLabel" styleName="aon-text-center">&nbsp; </g:Label>
													</g:HTMLPanel>
												</g:customCell>
												<g:customCell styleName="{style.span-cell-cell-last}">
													<g:HTMLPanel>
														<g:Label styleName="{style.cell-label}">N. INSCRIPCION
															SS</g:Label>
														<g:Label ui:field="enterpriseCCCLabel" styleName="aon-text-center">&nbsp; </g:Label>
													</g:HTMLPanel>
												</g:customCell>
											</g:row>
										</g:Grid>
									</g:customCell>
									<g:customCell styleName="{style.span-cell}">
										<g:Grid styleName="{style.span-cell-table}">
											<g:row>
												<g:customCell styleName="{style.span-cell-cell}">
													<g:HTMLPanel>
														<g:Label styleName="{style.cell-label}">N. AFILIACION
															SS</g:Label>
														<g:Label ui:field="employeeSSLabel" styleName="aon-text-center">&nbsp; </g:Label>
													</g:HTMLPanel>
												</g:customCell>
												<g:customCell styleName="{style.span-cell-cell-last}">
													<g:HTMLPanel>
														<g:Label styleName="{style.cell-label}">DNI</g:Label>
														<g:Label ui:field="employeeDocumentLabel"
															styleName="aon-text-center">&nbsp; </g:Label>
													</g:HTMLPanel>
												</g:customCell>
											</g:row>
										</g:Grid>
									</g:customCell>
								</g:row>
								<g:row styleName="aon-dataTable-row-even">
									<g:customCell styleName="{style.span-cell}">
										<g:Grid styleName="{style.span-cell-table}">
											<g:row>
												<g:customCell styleName="{style.span-cell-cell}">
													<g:HTMLPanel>
														<g:Label styleName="{style.cell-label}">PERIODO DE
															LIQUIDACION</g:Label>
														<g:Label ui:field="periodLabel" styleName="aon-text-center">&nbsp; </g:Label>
													</g:HTMLPanel>
												</g:customCell>
												<g:customCell styleName="{style.span-cell-cell-last}">
													<g:HTMLPanel>
														<g:Label styleName="{style.cell-label}">TOTAL DIAS</g:Label>
														<g:Label ui:field="daysLabel" styleName="aon-text-center">&nbsp; </g:Label>
													</g:HTMLPanel>
												</g:customCell>
											</g:row>
										</g:Grid>
									</g:customCell>

									<g:customCell>
										<g:HTMLPanel>
											<g:Label styleName="{style.cell-label}">IMPORTE TOTAL
												DEVENGOS</g:Label>
											<g:HTMLPanel tag="div" styleName="aon-text-center">
												<e:ValueInlineHTML changeDisplayStyleName="{style.value-changed}"
													ui:field="totalPaymentsLabel">&nbsp; </e:ValueInlineHTML>
												<g:InlineHTML ui:field="dbTotalPaymentsLabel"
													visible="false" />
											</g:HTMLPanel>
										</g:HTMLPanel>
									</g:customCell>
								</g:row>
							</g:Grid>

							<g:HTML styleName="{style.vertical-space}" />
							<g:FlexTable ui:field="contextTable"
								styleName="aon-dataTable {style.edit-cells}" />
							<g:HTML styleName="{style.vertical-space}" />

							<g:FlexTable ui:field="eventsTable" styleName="aon-dataTable" />
							<g:HTML ui:field="eventsTableSpace" styleName="{style.vertical-space}"
								visible="false" />

							<g:FlexTable ui:field="paymentsTable"
								styleName="aon-dataTable {style.edit-rows}" />

							<g:HTML styleName="{style.vertical-space}" />

							<g:HorizontalPanel styleName="aon-width-all">

								<g:Grid ui:field="basesTable" styleName="aon-dataTable">
									<g:row styleName="aon-dataTable-row-odd">
										<g:customCell>
											<g:HTMLPanel>
												<g:Label styleName="{style.cell-label}">RENUMERACION
													TOTAL</g:Label>
												<g:HTMLPanel tag="div" styleName="aon-text-center">
													<e:ValueInlineHTML
														changeDisplayStyleName="{style.value-changed}" ui:field="remunerationLabel">&nbsp; </e:ValueInlineHTML>
													<g:InlineHTML ui:field="dbRemunerationLabel"
														visible="false" />
												</g:HTMLPanel>
											</g:HTMLPanel>
										</g:customCell>
										<g:customCell>
											<g:HTMLPanel>
												<g:Label styleName="{style.cell-label}">PRORRATA PAGAS</g:Label>
												<g:HTMLPanel tag="div" styleName="aon-text-center">
													<e:ValueInlineHTML
														changeDisplayStyleName="{style.value-changed}" ui:field="prorationBaseLabel">&nbsp; </e:ValueInlineHTML>
													<g:InlineHTML ui:field="dbProrationBaseLabel"
														visible="false" />
												</g:HTMLPanel>
											</g:HTMLPanel>
										</g:customCell>
										<g:customCell>
											<g:HTMLPanel>
												<g:Label styleName="{style.cell-label}">BASE TOTAL
													COTIZ.</g:Label>
												<g:HTMLPanel tag="div" styleName="aon-text-center">
													<e:ValueInlineHTML
														changeDisplayStyleName="{style.value-changed}" ui:field="cgcBaseLabel">&nbsp; </e:ValueInlineHTML>
													<g:InlineHTML ui:field="dbCgcBaseLabel"
														visible="false" />
												</g:HTMLPanel>
											</g:HTMLPanel>
										</g:customCell>
									</g:row>
									<g:row styleName="aon-dataTable-row-even">
										<g:customCell>
											<g:HTMLPanel>
												<g:Label></g:Label>
												<g:Label></g:Label>
											</g:HTMLPanel>
										</g:customCell>
										<g:customCell>
											<g:HTMLPanel>
												<g:Label styleName="{style.cell-label}">BASE H.E.</g:Label>
												<g:HTMLPanel tag="div" styleName="aon-text-center">
													<e:ValueInlineHTML
														changeDisplayStyleName="{style.value-changed}" ui:field="hExtraBaseLabel">&nbsp; </e:ValueInlineHTML>
													<g:InlineHTML ui:field="dbHExtraBaseLabel"
														visible="false" />
												</g:HTMLPanel>
											</g:HTMLPanel>
										</g:customCell>
										<g:customCell>
											<g:HTMLPanel>
												<g:Label styleName="{style.cell-label}">BASE AT Y EP.</g:Label>
												<g:HTMLPanel tag="div" styleName="aon-text-center">
													<e:ValueInlineHTML
														changeDisplayStyleName="{style.value-changed}" ui:field="cgpBaseLabel">&nbsp; </e:ValueInlineHTML>
													<g:InlineHTML ui:field="dbCgpBaseLabel"
														visible="false" />
												</g:HTMLPanel>
											</g:HTMLPanel>
										</g:customCell>
									</g:row>
									<g:row styleName="aon-dataTable-row-odd">
										<g:customCell>
											<g:HTMLPanel>
												<g:Label styleName="{style.cell-label}">BASE IRPF</g:Label>
												<g:HTMLPanel tag="div" styleName="aon-text-center">
													<e:ValueInlineHTML
														changeDisplayStyleName="{style.value-changed}" ui:field="irpfBaseLabel">&nbsp; </e:ValueInlineHTML>
													<g:InlineHTML ui:field="dbIrpfBaseLabel"
														visible="false" />
												</g:HTMLPanel>
											</g:HTMLPanel>
										</g:customCell>
										<g:customCell>
											<g:HTMLPanel>
												<g:Label styleName="{style.cell-label}">BASE H.E. NO
													AUTORIZ.</g:Label>
												<g:HTMLPanel tag="div" styleName="aon-text-center">
													<e:ValueInlineHTML
														changeDisplayStyleName="{style.value-changed}" ui:field="nonHExtraBaseLabel">&nbsp; </e:ValueInlineHTML>
													<g:InlineHTML ui:field="dbNonHExtraBaseLabel"
														visible="false" />
												</g:HTMLPanel>
											</g:HTMLPanel>
										</g:customCell>
										<g:customCell>
											<g:HTMLPanel>
												<g:Label></g:Label>
												<g:Label></g:Label>
											</g:HTMLPanel>
										</g:customCell>
									</g:row>
								</g:Grid>

								<g:HTML styleName="{style.horizontal-space}" />

								<g:Grid ui:field="totalsTable" styleName="aon-dataTable">
									<g:row styleName="aon-dataTable-row-odd">
										<g:customCell>
											<g:HTMLPanel>
												<g:Label styleName="{style.cell-label}">A. TOTAL
													DEVENGO</g:Label>
												<g:HTMLPanel tag="div" styleName="aon-text-center">
													<e:ValueInlineHTML
														changeDisplayStyleName="{style.value-changed}" ui:field="totalPaymentLabel">&nbsp; </e:ValueInlineHTML>
													<g:InlineHTML ui:field="dbTotalPaymentLabel"
														visible="false" />
												</g:HTMLPanel>
											</g:HTMLPanel>
										</g:customCell>
										<g:customCell>
											<g:HTMLPanel>
												<g:Label styleName="{style.cell-label}">B. TOTAL
													DEDUCIR</g:Label>
												<g:HTMLPanel tag="div" styleName="aon-text-center">
													<e:ValueInlineHTML
														changeDisplayStyleName="{style.value-changed}" ui:field="totalDeductionLabel">&nbsp; </e:ValueInlineHTML>
													<g:InlineHTML ui:field="dbTotalDeductionLabel"
														visible="false" />
												</g:HTMLPanel>
											</g:HTMLPanel>
										</g:customCell>
										<g:customCell>
											<g:HTMLPanel>
												<g:Label styleName="{style.cell-label}">LIQUIDO A
													PERCIBIR (A-B)</g:Label>
												<g:HTMLPanel tag="div" styleName="aon-text-center">
													<!--  e:ValueInlineHTML
														changeDisplayStyleName="{style.value-changed}" ui:field="totalLiquidLabel">&nbsp; </e:ValueInlineHTML-->
													<e:ValueTextBox changeDisplayStyleName="{style.value-changed}" ui:field="totalLiquidLabel" />	
													<g:InlineHTML ui:field="dbTotalLiquidLabel"
														visible="false" />
												</g:HTMLPanel>
											</g:HTMLPanel>
										</g:customCell>
									</g:row>
								</g:Grid>
							</g:HorizontalPanel>
						</g:VerticalPanel>
						<g:HTML styleName="reset" ui:field='printPreviewHTML'
							wordWrap='true' />
						<g:HTML styleName="reset" ui:field='irpfPreviewHTML'
							wordWrap='true' />

					</g:DeckPanel>
				</g:VerticalPanel>
			</g:ScrollPanel>
		</g:center>
	</g:DockLayoutPanel>

</ui:UiBinder>
