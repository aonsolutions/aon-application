<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<ui:UiBinder xmlns:ui='urn:ui:com.google.gwt.uibinder'
	xmlns:g='urn:import:com.google.gwt.user.client.ui' 
	xmlns:e='urn:import:com.esferalia.aon.gwt.payroll.client'
	xmlns:p="urn:import:net.aonsolutions.gwt.pdfjs.client" 
	xmlns:s="urn:import:com.google.gwt.dom.builder.shared" 
	>

	<ui:with field='res' type='com.esferalia.aon.gwt.common.client.css.AonResources'/>

	<ui:style type='com.esferalia.aon.gwt.payroll.client.SalaryDraft.MyStyle'>
		.editor {
			
		}

		.disabled {
			opacity: 0.5;		
		}
		
		.page-shadow {
    		box-shadow: 5px 5px 10px 5px #d4d0c8;
		}
		
		.vertical-space {
			height: 20px;
		}

		.vertical-margin {
			margin-bottom: 10px;
		}

		.horizontal-space {
			width: 5px;
		}

		.document {
			margin-top: 5px;
			margin-left: auto;
			margin-right: auto;
			margin-bottom: 15px;
		}
		
		.value-changed {
			color: #897820;
			font-weight: bold;
			text-shadow: 0.1em 0.1em 0.2em #9E945E;
		}

		.edit-rows .edit-cells {
		}
		
		.edit-rows td, 
		.edit-cells td {
			color: #000000 !important;			
		}
		
		.edit-rows tr:hover,
		.edit-cells td:hover{
			cursor: pointer;
			background-color: #E2F1F5 !important;
	
		}

		.span-cell {
			padding: 0px !important;
		}
		
		@if !user.agent safari {
			.cell-label {
				font-size: 9px;
				font-weight: bold;
				font-family: sans-serif;
			}
		}
		@else {
			.cell-label {
				font-size: 11px;
				font-weight: bold;
				font-family: sans-serif;
			}
		}
		
		.text-ok,
		.text-ok * {
			color: green !important;
		}

		.text-warn *{
			font-weight: bold;
			color: orange !important;
		}

		.text-error,
		.text-error *{
			font-weight: bold;
			color: red !important;
		}

		.cell-warn {
			color: orange;
		}

		.cell-changed {
		}

		.span-cell-table {
			width: 100%;
			border-collapse: collapse !important;
		}

		.span-cell-cell {
			border-top: 0px !important;
			border-left: 0px !important;
			border-bottom: 0px !important;
		}
		
		.span-cell-cell-last {
			border: 0px !important;
		}
		
		.toolBar-checkBox input {
			vertical-align: middle;
		}
		
		
		.context-tab-voffset{
			top: -24px;
			position: relative;
		}
		
		.context-tab-button {	
			top: 22px;
			right: -28px;
			float: right;
			opacity: 0.6;
			padding-top: 20px;
			position: relative;
		}
		.context-tab-button:hover,
		.context-tab-button-selected {
			opacity: 1.0;
			box-shadow: 4px 4px 4px rgb(204, 204, 204);
		}
		
		.aon-button-view {
			width: auto !important;
			padding-left: 16px !important ;
			padding-right: 16px !important ;
			background-position-x : right !important;
		}
		
		.textbox-readonly {
    		border: none !important;
    		color: #4b4b4b !important;		
			background: transparent !important;
		}
		
		.aon-ReadOnly .aon-icon-reset,
		.aon-ReadOnly .aon-icon-delete,
		.aon-ReadOnly .aon-icon-rowSelector,
		.aon-ReadOnly .aon-icon-rowSelector-C,
		.aon-ReadOnly .aon-icon-rowSelector-S,
		.aon-ReadOnly .aon-icon-rowSelector-Parent,
		.aon-ReadOnly .aon-icon-rowSelector-Changed
		{
			display:none;
			visibility:hidden;
		}
		
		.gwt-TextBox[readonly],
		.gwt-SuggestBox[readonly],
		.aon-ReadOnly .gwt-TextBox,
		.aon-ReadOnly .gwt-SuggestBox
		{
    		pointer-events: none;
			border-color:transparent;
    		color: inherit !important;
    		background-color: transparent;
		}

		.aon-ReadOnly .gwt-ListBox {
    		pointer-events: none;
    		color: inherit !important;
    		background-color: transparent;
		}
		
		.gwt-TextBox[readonly]:focus,
		.aon-ReadOnly .gwt-TextBox:focus
		{
			background-color: inherit;
		}
		
		.section-even {
			background-color: #e2e2e2; 

		}

		.section-odd {
			background-color: #f2f2f2; 
		}

		.db-section-odd-er {
			background-color: #ff9999; 
		}
		
		.db-section-odd-ok {
			background-color: #b3e6b3; 
		}
		
		.db-section-even-er {
			background-color: red; 
		}

		.db-section-even-ok {
			background-color: green; 
		}

		

		@external gwt-ListBox;
		@external gwt-TextBox;
		@external aon-ReadOnly;
		@external gwt-SuggestBox;
		@external aon-icon-reset;
		@external aon-icon-delete;
		@external aon-icon-rowSelector;
		@external aon-icon-rowSelector-C;
		@external aon-icon-rowSelector-S;
		@external aon-icon-rowSelector-Parent;
		@external aon-icon-rowSelector-Changed;
		
	</ui:style>


	<ui:import field="com.esferalia.aon.gwt.payroll.client.SalaryDraft.*" />

	<g:DockLayoutPanel unit="PX" ui:field="dockLayoutPanel">
		<g:north size="72">

			<g:FlowPanel>

				<g:FlowPanel styleName="aon-finding-title-toolbar">
					<g:HorizontalPanel>
			
						<g:HTMLPanel styleName="aon-finding-title">
							<g:HTMLPanel styleName="aon-finding-title-internal">
								<g:Label styleName="aon-outputText">Borrador</g:Label>
							</g:HTMLPanel>
						</g:HTMLPanel>
						<g:HTMLPanel styleName="aon-finding-subtitle">
							<g:HTMLPanel styleName="aon-finding-subtitle-internal">
								<g:Label styleName="aon-outputText"></g:Label>
							</g:HTMLPanel>
						</g:HTMLPanel>
						<g:HorizontalPanel styleName="aon-finding-toolbar">
							<g:HTMLPanel styleName="aon-finding-toolbar-item-group">
								<g:Button debugId='acceptButton' ui:field='acceptButton'
									styleName='aon-finding-toolbar-item aon-icon-accept' text="GUARDAR"
									enabled="false" />
								<g:Button debugId='salaryButton' ui:field='salaryButton'
									styleName='aon-finding-toolbar-item aon-icon-accept' text="EMITIR NOMINA" />
								<g:Button debugId='printPreviewButton' ui:field='printPreviewButton'
									styleName='aon-finding-toolbar-item {res.css.aonIconPdfPreview}'
									text="Vista Preliminar" />
								<g:Button debugId='irpfPreviewButton' ui:field='irpfPreviewButton'
									styleName='aon-finding-toolbar-item {res.css.aonIconIrpfPreview}'
									text="IRPF" />
								<e:SalarySelect ui:field="salarySelect" />

								<g:ListBox ui:field="zoomListBox" />
								<!--  g:Button debugId='printButton' ui:field='printButton'
									styleName='aon-finding-toolbar-item aon-icon-printer' text="IMPRIMIR" /-->
								<g:Button debugId='saveButton' ui:field='saveButton'
									styleName='aon-finding-toolbar-item aon-icon-mail-save' text="DESCARGAR" />
								<g:Button debugId='closePreviewButton' ui:field='closePreviewButton'
									styleName='aon-finding-toolbar-item aon-icon-cancel' text="CERRAR PRELIMINAR" />

							</g:HTMLPanel>
						</g:HorizontalPanel>
					</g:HorizontalPanel>
				</g:FlowPanel>

				<g:FlowPanel styleName="aon-finding-title-toolbar">
					<g:HorizontalPanel>
						<g:HTMLPanel styleName="aon-finding-title">
							<g:HTMLPanel styleName="aon-finding-title-internal">
								<g:Label styleName="aon-outputText">Edici&oacute;n</g:Label>
							</g:HTMLPanel>
						</g:HTMLPanel>
						<g:HTMLPanel styleName="aon-finding-subtitle">
							<g:HTMLPanel styleName="aon-finding-subtitle-internal">
								<g:Label styleName="aon-outputText"></g:Label>
							</g:HTMLPanel>
						</g:HTMLPanel>
						<g:HorizontalPanel styleName="aon-finding-toolbar">
							<g:HTMLPanel styleName="aon-finding-toolbar-item-group">
								<g:Button debugId='fxButton' ui:field='fxButton'
									styleName='aon-finding-toolbar-item {res.css.aonIconFx}' enabled="false" />
								<g:Button debugId='undoAllButton' ui:field='undoAllButton'
									styleName='aon-finding-toolbar-item {res.css.aonIconUndoAll}' />
								<g:Button debugId='undoButton' ui:field='undoButton'
									styleName='aon-finding-toolbar-item {res.css.aonIconUndo}' />
								<g:Button debugId='redoButton' ui:field='redoButton'
									styleName="aon-finding-toolbar-item {res.css.aonIconRedo}" />
								<g:CheckBox debugId='tgssCheck' ui:field='tgssCheck'
									styleName='aon-finding-toolbar-item aon-icon-segsocial-small {style.toolBar-checkBox} '
									text="SILTRA" checked="false" />
								<g:CheckBox debugId='costsCheck' ui:field='costsCheck'
									styleName='aon-finding-toolbar-item {style.toolBar-checkBox}'
									text="COSTES Y BONIFICACIONES" checked="false" />
								<g:CheckBox debugId='dbSalaryCheck' ui:field='dbSalaryCheck'
									styleName='aon-finding-toolbar-item {style.toolBar-checkBox}'
									text="DIFERENCIAS" checked="false" />
								<g:CheckBox debugId='eventsCheck' ui:field='eventsCheck'
									styleName='aon-finding-toolbar-item aon-icon-warn {style.toolBar-checkBox}'
									text="AVISOS Y NOTIFICACIONES" checked="false" />
							</g:HTMLPanel>
						</g:HorizontalPanel>
					</g:HorizontalPanel>
				</g:FlowPanel>

			</g:FlowPanel>

		</g:north>
		<g:center>
			<g:ScrollPanel ui:field="scrollPanel" styleName="{style.editor}">
				<g:VerticalPanel styleName="{style.document}" ui:field="scrolledPanel" >
					<g:DeckPanel ui:field="deckPanel">
						<g:VerticalPanel ui:field="draftPanel" width="auto">
							
							<g:HorizontalPanel ui:field='timeRulePanel'  debugId='timeRulePanel' visible="false" styleName="aon-width-all {style.vertical-margin}" />
							<!--  g:HorizontalPanel ui:field='dbTimeRulePanel'  debugId='dbTimeRulePanel' visible="false" styleName="aon-width-all {style.vertical-margin} {style.disabled}" /-->
							
							<g:Grid styleName="aon-dataTable">
								<g:row styleName="aon-dataTable-row-odd">
									<g:customCell style="width:50%">
										<g:HTMLPanel>
											<g:Label styleName="{style.cell-label}">EMPRESA</g:Label>
											<g:Label ui:field="enterpriseNameLabel" styleName="aon-text-center">&nbsp; </g:Label>
										</g:HTMLPanel>
									</g:customCell>
									<g:customCell>
										<g:HTMLPanel>
											<g:Label styleName="{style.cell-label}">TRABAJADOR/A</g:Label>
											<g:Label debugId="employeeNameLabel" ui:field="employeeNameLabel" styleName="aon-text-center">&nbsp; </g:Label>
										</g:HTMLPanel>
									</g:customCell>
								</g:row>
								<g:row styleName="aon-dataTable-row-even">
									<g:customCell>
										<g:HTMLPanel>
											<g:Label styleName="{style.cell-label}">DOMICILIO</g:Label>
											<g:Label ui:field="enterpriseAddressLabel" styleName="aon-text-center">&nbsp; </g:Label>
										</g:HTMLPanel>
									</g:customCell>
									<g:customCell styleName="{style.span-cell}">
										<g:Grid styleName="{style.span-cell-table}">
											<g:row>
												<g:customCell styleName="{style.span-cell-cell}">
													<g:HTMLPanel>
														<g:Label styleName="{style.cell-label}">CATEGORÍA
															PROFESIONAL</g:Label>
														<g:Label ui:field="employeeAgreementCategoryLabel"
															styleName="aon-text-center">&nbsp; </g:Label>
													</g:HTMLPanel>
												</g:customCell>
												<g:customCell styleName="{style.span-cell-cell}">
													<g:HTMLPanel>
														<g:Label styleName="{style.cell-label}">PUESTO DE
															TRABAJO</g:Label>
														<g:Label ui:field="employeeJobLabel" styleName="aon-text-center">&nbsp; </g:Label>
													</g:HTMLPanel>
												</g:customCell>
												<g:customCell styleName="{style.span-cell-cell-last}">
													<g:HTMLPanel>
														<g:Label styleName="{style.cell-label}">ANTIGUEDAD</g:Label>
														<g:Label ui:field="employeeSeniorityLabel"
															styleName="aon-text-center">&nbsp; </g:Label>
													</g:HTMLPanel>
												</g:customCell>
											</g:row>
										</g:Grid>
									</g:customCell>
								</g:row>
								<g:row styleName="aon-dataTable-row-odd">
									<g:customCell styleName="{style.span-cell}">
										<g:Grid styleName="{style.span-cell-table}">
											<g:row>
												<g:customCell styleName="{style.span-cell-cell}">
													<g:HTMLPanel>
														<g:Label styleName="{style.cell-label}">POBLACION</g:Label>
														<g:Label ui:field="enterpriseCityLabel" styleName="aon-text-center">&nbsp; </g:Label>
													</g:HTMLPanel>
												</g:customCell>
												<g:customCell styleName="{style.span-cell-cell-last}">
													<g:HTMLPanel>
														<g:Label styleName="{style.cell-label}">N. INSCRIPCION
															SS</g:Label>
														<g:Label ui:field="enterpriseCCCLabel" styleName="aon-text-center">&nbsp; </g:Label>
													</g:HTMLPanel>
												</g:customCell>
											</g:row>
										</g:Grid>
									</g:customCell>
									<g:customCell styleName="{style.span-cell}">
										<g:Grid styleName="{style.span-cell-table}">
											<g:row>
												<g:customCell styleName="{style.span-cell-cell}">
													<g:HTMLPanel>
														<g:Label styleName="{style.cell-label}">N. AFILIACION
															SS</g:Label>
														<g:Label ui:field="employeeSSLabel" styleName="aon-text-center">&nbsp; </g:Label>
													</g:HTMLPanel>
												</g:customCell>
												<g:customCell styleName="{style.span-cell-cell-last}">
													<g:HTMLPanel>
														<g:Label styleName="{style.cell-label}">DNI</g:Label>
														<g:Label ui:field="employeeDocumentLabel"
															styleName="aon-text-center">&nbsp; </g:Label>
													</g:HTMLPanel>
												</g:customCell>
											</g:row>
										</g:Grid>
									</g:customCell>
								</g:row>
								<g:row styleName="aon-dataTable-row-even">
									<g:customCell styleName="{style.span-cell}">
										<g:Grid styleName="{style.span-cell-table}">
											<g:row>
												<g:customCell styleName="{style.span-cell-cell}">
													<g:HTMLPanel>
														<g:Label styleName="{style.cell-label}">PERIODO DE
															LIQUIDACION</g:Label>
														<g:Label debugId="periodLabel" ui:field="periodLabel" styleName="aon-text-center">&nbsp; </g:Label>
													</g:HTMLPanel>
												</g:customCell>
												<g:customCell styleName="{style.span-cell-cell-last}">
													<g:HTMLPanel>
														<g:Label styleName="{style.cell-label}">TOTAL DIAS</g:Label>
														<g:Label ui:field="daysLabel" styleName="aon-text-center">&nbsp; </g:Label>
													</g:HTMLPanel>
												</g:customCell>
											</g:row>
										</g:Grid>
									</g:customCell>

									<g:customCell>
										<g:HTMLPanel>
											<g:Label styleName="{style.cell-label}">IMPORTE TOTAL
												DEVENGOS</g:Label>
											<g:HTMLPanel tag="div" styleName="aon-text-center">
												<!-- e:ValueInlineHTML changeDisplayStyleName="{style.value-changed}"
													ui:field="totalPaymentsLabel">&nbsp; </e:ValueInlineHTML-->
												<e:ExpressionValueBox styleName="gwt-TextBox aon-nopadding aon-nomargin aon-text-center" visibleLength="9"
														changeDisplayStyleName="{style.value-changed}" debugId="totalPaymentsLabel" ui:field="totalPaymentsLabel">&nbsp; </e:ExpressionValueBox>												
												<g:InlineHTML debugId="dbTotalPaymentsLabel" ui:field="dbTotalPaymentsLabel"
													visible="false" />
											</g:HTMLPanel>
										</g:HTMLPanel>
									</g:customCell>
								</g:row>
							</g:Grid>

							<!--  g:HTML styleName="{style.vertical-space}" /-->
							<g:Button ui:field='contextTableButton'
									styleName="aon-icon-offer aon-no-margin aon-editDataTable-button {style.context-tab-button} {style.context-tab-button-selected}" />
							<g:Button ui:field='contextTimeLineButton'
									styleName="aon-icon-statistics aon-no-margin aon-editDataTable-button {style.context-tab-button}" />
							<g:DeckPanel ui:field="contextDeckPanel" styleName="{style.context-tab-voffset}">
								<g:FlexTable ui:field="contextTable"
									styleName="aon-dataTable {style.edit-cells}" />
								<g:SimplePanel ui:field="contextTimeLinePanel" />
							</g:DeckPanel>
							
							<g:HTML styleName="{style.vertical-space} {style.context-tab-voffset}" />

							<g:FlexTable debugId="eventsTable" ui:field="eventsTable" styleName="aon-dataTable {style.context-tab-voffset}" />
							<g:HTML ui:field="eventsTableSpace" styleName="{style.vertical-space} {style.context-tab-voffset}"
								visible="false" />

							<g:FlexTable debugId="paymentsTable" ui:field="paymentsTable"
								styleName="aon-dataTable {style.edit-rows} {style.context-tab-voffset}" />

							<g:HTML styleName="{style.vertical-space} {style.context-tab-voffset}" />

							<g:HorizontalPanel styleName="aon-width-all {style.context-tab-voffset}">

								<g:Grid ui:field="basesTable" styleName="aon-dataTable">
									<g:row styleName="aon-dataTable-row-odd">
										<g:customCell>
											<g:HTMLPanel>
												<g:Label styleName="{style.cell-label}">RENUMERACION
													TOTAL</g:Label>
												<g:HTMLPanel tag="div" styleName="aon-text-center">
													<e:ValueInlineHTML
														changeDisplayStyleName="{style.value-changed}" debugId="remunerationLabel" ui:field="remunerationLabel" htmlNull="&nbsp;" >&nbsp; </e:ValueInlineHTML>
													<g:InlineHTML ui:field="dbRemunerationLabel"
														visible="false" />
												</g:HTMLPanel>
											</g:HTMLPanel>
										</g:customCell>
										<g:customCell>
											<g:HTMLPanel>
												<g:Label styleName="{style.cell-label}">PRORRATA PAGAS</g:Label>
												<g:HTMLPanel tag="div" styleName="aon-text-center">
													<e:ValueInlineHTML
														changeDisplayStyleName="{style.value-changed}" debugId="prorationBaseLabel" ui:field="prorationBaseLabel" htmlNull="&nbsp;" >&nbsp; </e:ValueInlineHTML>
													<g:InlineHTML ui:field="dbProrationBaseLabel"
														visible="false" />
												</g:HTMLPanel>
											</g:HTMLPanel>
										</g:customCell>
										<g:customCell>
											<g:HTMLPanel>
												<g:Label styleName="{style.cell-label}">BASE TOTAL
													COTIZ.</g:Label>
												<g:HTMLPanel tag="div" styleName="aon-text-center">
													<e:ValueExpressionBox styleName="gwt-TextBox aon-nopadding aon-nomargin aon-text-center {style.textbox-readonly}" visibleLength="9"
														changeDisplayStyleName="{style.value-changed}" debugId="cgcBaseLabel" ui:field="cgcBaseLabel" enabled="false" >&nbsp; </e:ValueExpressionBox>
													<g:InlineHTML ui:field="dbCgcBaseLabel"
														visible="false" />
												</g:HTMLPanel>
											</g:HTMLPanel>
										</g:customCell>
									</g:row>
									<g:row styleName="aon-dataTable-row-even">
										<g:customCell>
											<g:HTMLPanel>
												<g:Label></g:Label>
												<g:Label></g:Label>
											</g:HTMLPanel>
										</g:customCell>
										<g:customCell>
											<g:HTMLPanel>
												<g:Label styleName="{style.cell-label}">BASE H.E.</g:Label>
												<g:HTMLPanel tag="div" styleName="aon-text-center">
													<e:ValueInlineHTML
														changeDisplayStyleName="{style.value-changed}" debugId="hExtraBaseLabel" ui:field="hExtraBaseLabel" htmlNull="&nbsp;" >&nbsp; </e:ValueInlineHTML>
													<g:InlineHTML ui:field="dbHExtraBaseLabel"
														visible="false" />
												</g:HTMLPanel>
											</g:HTMLPanel>
										</g:customCell>
										<g:customCell>
											<g:HTMLPanel>
												<g:Label styleName="{style.cell-label}">BASE AT Y EP.</g:Label>
												<g:HTMLPanel tag="div" styleName="aon-text-center">
													<e:ValueExpressionBox styleName="gwt-TextBox aon-nopadding aon-nomargin aon-text-center {style.textbox-readonly}" visibleLength="9"
														changeDisplayStyleName="{style.value-changed}" debugId="cgpBaseLabel" ui:field="cgpBaseLabel" enabled="false" >&nbsp; </e:ValueExpressionBox>
													<g:InlineHTML debugId="dbCgpBaseLabel" ui:field="dbCgpBaseLabel"
														visible="false" />
												</g:HTMLPanel>
											</g:HTMLPanel>
										</g:customCell>
									</g:row>
									<g:row styleName="aon-dataTable-row-odd">
										<g:customCell>
											<g:HTMLPanel>
												<g:Label styleName="{style.cell-label}">BASE IRPF</g:Label>
												<g:HTMLPanel tag="div" styleName="aon-text-center">
													<e:ValueInlineHTML
														changeDisplayStyleName="{style.value-changed}" ui:field="irpfBaseLabel" htmlNull="&nbsp;" >&nbsp; </e:ValueInlineHTML>
													<g:InlineHTML ui:field="dbIrpfBaseLabel"
														visible="false" />
												</g:HTMLPanel>
											</g:HTMLPanel>
										</g:customCell>
										<g:customCell>
											<g:HTMLPanel>
												<g:Label styleName="{style.cell-label}">BASE H.E. NO
													AUTORIZ.</g:Label>
												<g:HTMLPanel tag="div" styleName="aon-text-center">
													<e:ValueInlineHTML
