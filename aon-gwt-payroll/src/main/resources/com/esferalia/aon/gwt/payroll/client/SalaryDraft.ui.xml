<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<ui:UiBinder xmlns:ui='urn:ui:com.google.gwt.uibinder'
	xmlns:g='urn:import:com.google.gwt.user.client.ui' 
	xmlns:e='urn:import:com.esferalia.aon.gwt.payroll.client'
	xmlns:p="urn:import:net.aonsolutions.gwt.pdfjs.client"
	xmlns:s="urn:import:com.google.gwt.dom.builder.shared" 
	>

	<ui:with field='res' type='com.esferalia.aon.gwt.common.client.css.AonResources'/>

	<ui:style type='com.esferalia.aon.gwt.payroll.client.SalaryDraft.MyStyle'>
	
		.table-label,
		.table-label tr,
		.table-label td  {
			margin:0 !important;
			padding:0 !important;
			border:none !important;
			vertical-align: middle !important;
		}
		
		
		
		.editor {
			
		}
		
		.no-display {
			display:none;
		}	

		.disabled {
			opacity: 0.5;		
		}
		
		.page-shadow {
    		box-shadow: 5px 5px 10px 5px #d4d0c8;
		}
		
		.vertical-space {
			height: 20px;
		}

		.vertical-margin {
			margin-bottom: 10px;
		}

		.horizontal-space {
			width: 5px;
		}

		.margin-top30{
			margin-top: 30px;
		}
		
		.draft {
			min-width: 1080px;
		}

		.document {
			margin-top: 5px;
			margin-left: auto;
			margin-right: auto;
			margin-bottom: 15px;
		}
		
		.eventsTable tr{
			margin-top: 15px;
		}
		
		.value-changed {
			color: #897820;
			font-weight: bold;
			text-shadow: 0.1em 0.1em 0.2em #9E945E;
		}

		.edit-rows .edit-cells {
		}
		
		.edit-rows td, 
		.edit-cells td {
			color: #000000 !important;			
		}
		
		.edit-rows tr:hover{
			cursor: pointer;
			background-color: #F6F6F6 !important;
	
		}

		/*.edit-cells td:hover{
			cursor: pointer;
			background-color: #F6F6F6 !important;
	
		}*/

		.span-cell {
			padding: 0px !important;
		}
		
		.cell-value {
			text-align: left;
			padding-top: 0.2em;
			padding-left: 0.2em;
		}

		@if !user.agent safari {
			.cell-label,
			.aon-SalarySelect-Label {
				color:black;
				font-size: 9px;
				font-weight: bold;
				font-family: sans-serif;
			}
		}
		@else {
			.cell-label,
			.aon-SalarySelect-Label {
				color:black;
				font-size: 11px;
				font-weight: bold;
				font-family: sans-serif;
			}
		}
		
		.text-ok,
		.text-ok * {
			color: green !important;
		}

		.text-warn *{
			font-weight: bold;
			color: orange !important;
		}

		.text-error,
		.text-error *{
			font-weight: bold;
			color: red !important;
		}

		.cell-warn {
			color: orange;
		}

		.cell-changed {
		}

		.span-cell-table {
			width: 100%;
			border-collapse: collapse !important;
		}

		.span-cell-cell {
			border-top: 0px !important;
			border-left: 0px !important;
			border-bottom: 0px !important;
		}
		
		.span-cell-cell-last {
			border: 0px !important;
		}
		
		
		.toolBar-checkBox input {
			vertical-align: middle;
		}
		
		
		.context-tab-button {	
			top: 22px;
			right: -28px;
			float: right;
			opacity: 0.6;
			padding-top: 20px;
			position: relative;
		}
		.context-tab-button:hover,
		.context-tab-button-selected {
			opacity: 1.0;
			box-shadow: 4px 4px 4px rgb(204, 204, 204);
		}
		
		.aon-button-view {
			width: auto !important;
			padding-left: 16px !important ;
			padding-right: 16px !important ;
			background-position-x : right !important;
		}
		
		.textbox-readonly {
    		border: none !important;
    		color: #4b4b4b !important;		
			background: transparent !important;
		}
		
		.aon-Disabled .gwt-TextBox,
		.aon-Disabled .gwt-SuggestBox,
		.aon-Disabled .gwt-ListBox
		{
    		color: grey !important;
		}

		.aon-Disabled .aon-icon-reset,
		.aon-Disabled .aon-icon-delete,
		.aon-Disabled .aon-icon-rowSelector,
		.aon-Disabled .aon-icon-rowSelector-Parent,
		.aon-Disabled .aon-icon-rowSelector-Changed
		{
			display:none;
			visibility:hidden;
		}

		.aon-WriteOnly {
    		pointer-events: initial !important;
		}
		
		.section-even {
			background-color: #e2e2e2; 

		}

		.section-odd {
			background-color: #f2f2f2; 
		}

		.db-section-odd-er {
			background-color: #ff9999; 
		}
		
		.db-section-odd-ok {
			background-color: #b3e6b3; 
		}
		
		.db-section-even-er {
			background-color: red; 
		}

		.db-section-even-ok {
			background-color: green; 
		}
		
		.issueLabel{
			font-weight: bold;
			width: 40px;
			text-align: center;
			font-size: 10px;
			padding: 2px;
		}

		.issueTextBox{
			text-align: center;
			width: 50px;
		}
		
		.aon-icon-rowSelector-S[disabled],
		.aon-icon-rowSelector-C[disabled] {
			display:inherit  !important;
			visibility:inherit !important;
		}
		
		.aon-dataTable-row-even {
    		background-color: none; 
		}
		
		.aon-toolbar-button {
		    height: 24px;
		    padding-left: 24px;
		    background-position: left;
		    background-repeat: no-repeat;
		    background-color: transparent;
		}

		.aon-toolbar-button:hover {
		    background-color: #f6f6f6;
		}
		
		.aon_icon_redo {
			background-size:32px;
		}
		
		button[disabled], .gwt-ListBox[disabled] {
		  display: initial !important;
		  visibility: initial !important;
		  background-color: transparent !important; 
		}		
		
		.aon-content-scroll-panel{
			padding-right: 30px
		}

		@external gwt-ListBox;
		@external gwt-TextBox;
		@external aon-Disabled;
		@external aon-WriteOnly;
		@external gwt-SuggestBox;
		@external aon_icon_redo;
		@external aon-icon-reset;
		@external aon-icon-delete;
		@external aon-icon-rowSelector;
		@external aon-icon-rowSelector-C;
		@external aon-icon-rowSelector-S;
		@external aon-SalarySelect-Label;
		@external aon-icon-rowSelector-Parent;
		@external aon-icon-rowSelector-Changed;
		
		.container{
			width: 100%;
			min-width: 600px;
			height: 100%;
		}
		
		.white {
			color: white;
			
		}
		
		.stackHeader {
			padding: .7em .5em .7em .6em;
		}
		
		.flexBtwn {
			display: flex;
			justify-content: space-between;
			padding: 0 .5rem 0 0;
		}
		
		.flex{
			display: flex;
			align-items: center;
			gap: .5rem;
		}
		
		.wAuto {
			width: auto;
		}

	</ui:style>
	
	<ui:import field="com.esferalia.aon.gwt.payroll.client.SalaryDraft.*" />

	<g:DockLayoutPanel unit="PX" ui:field="dockLayoutPanel">
		<g:north size="68">

			<g:FlowPanel ui:field="toolbar">
    			
				<g:FlowPanel styleName="aon-finding-title-toolbar aon-width-all">
					<g:HorizontalPanel styleName="aon-width-all">
			
						<g:HorizontalPanel styleName="aon-finding-toolbar aon-width-all">
							<g:HTMLPanel styleName="aon-finding-toolbar-item-group">
								<g:Button debugId='acceptButton' ui:field='acceptButton'
									styleName='aon-finding-toolbar-item aon_icon_save {style.aon-toolbar-button}' text="GUARDAR"
									enabled="false" />
								<g:Button debugId='salaryButton' ui:field='salaryButton'
									styleName='aon-finding-toolbar-item aon_icon_emit {style.aon-toolbar-button}' text="EMITIR NOMINA" />
								<g:Button debugId='extraButton' ui:field='extraButton'
									styleName='aon-finding-toolbar-item aon_icon_emit {style.aon-toolbar-button}' text="EMITIR EXTRA" visible="false"/>
								<g:Button debugId='settleButton' ui:field='settleButton'
									styleName='aon-finding-toolbar-item aon_icon_emit {style.aon-toolbar-button}' text="EMITIR FINIQUITO" visible="false"/>
								<g:Button debugId='delayButton' ui:field='delayButton'
									styleName='aon-finding-toolbar-item aon_icon_emit {style.aon-toolbar-button}' text="EMITIR ATRASOS" visible="false"/>
								<g:Button debugId='fiscalModelsButton' ui:field='fiscalModelsButton'
									styleName='aon-finding-toolbar-item aon-icon-aeat' text="MODELOS FISCALES" visible="false"/>
								<g:Button debugId='printPreviewButton' ui:field='printPreviewButton'
									styleName='aon-finding-toolbar-item aon_icon_pdf {style.aon-toolbar-button}'
									text="Vista Previa" />
								<g:Button debugId='irpfPreviewButton' ui:field='irpfPreviewButton'
									styleName='aon-finding-toolbar-item {res.css.aonIconIrpfPreview}'
									text="IRPF" />

								<g:Button debugId='fxButton' ui:field='fxButton'
									styleName='aon-finding-toolbar-item aon_icon_fx {style.aon-toolbar-button} {style.white}' enabled="false" text="."/>
								<g:Button debugId='undoAllButton' ui:field='undoAllButton'
									styleName='aon-finding-toolbar-item aon_icon_undo_all {style.aon-toolbar-button} {style.white}' text="."/>
								<g:Button debugId='undoButton' ui:field='undoButton'
									styleName='aon-finding-toolbar-item aon_icon_undo {style.aon-toolbar-button} {style.white}' text="." />
								<g:Button debugId='redoButton' ui:field='redoButton'
									styleName="aon-finding-toolbar-item aon_icon_redo {style.aon-toolbar-button} {style.white}" text="." />

								<!--  g:Button debugId='printButton' ui:field='printButton'
									styleName='aon-finding-toolbar-item aon-icon-printer' text="IMPRIMIR" /-->
								<g:Button debugId='closePreviewButton' ui:field='closePreviewButton'
									styleName='aon-finding-toolbar-item aon-icon-cancel' text="CERRAR PRELIMINAR" />
									
								<g:InlineLabel debugId="toolBarTitleLabel" ui:field="toolbarTitleLabel" styleName="aon_toolbar_title aon-float-right" />

							</g:HTMLPanel>
						</g:HorizontalPanel>
					</g:HorizontalPanel>
				</g:FlowPanel>
				
				<g:FlowPanel styleName="aon-finding-title-toolbar aon-width-all">
					<g:HorizontalPanel styleName="aon-width-all">
						<g:HTMLPanel styleName="{style.flexBtwn}">
						
							<g:HorizontalPanel styleName="aon-finding-toolbar {style.wAuto}">
								<g:HTMLPanel styleName="aon-finding-toolbar-item-group">
									<g:CheckBox debugId='eventsCheck' ui:field='eventsCheck'
										styleName='aon-finding-toolbar-item aon-icon-warn {style.toolBar-checkBox}'
										text="AVISOS" checked="false" />
									<g:CheckBox debugId='costsCheck' ui:field='costsCheck'
										styleName='aon-finding-toolbar-item {style.toolBar-checkBox}'
										text="COSTES" checked="false" />
									<g:CheckBox debugId='notDefinedVarsCheck' ui:field='notDefinedVarsCheck'
										styleName='aon-finding-toolbar-item {style.toolBar-checkBox}'
										text="VARIABLES NO DEFINIDAS" checked="false" />
									<g:CheckBox debugId='disabledPaymentsCheck' ui:field='disabledPaymentsCheck'
										styleName='aon-finding-toolbar-item {style.toolBar-checkBox}'
										text="CONCEPTOS NO ACTIVOS" checked="false" />
									<g:CheckBox debugId='dbSalaryCheck' ui:field='dbSalaryCheck'
										styleName='aon-finding-toolbar-item {style.toolBar-checkBox}'
										text="DIFERENCIAS" checked="false" />
									<g:CheckBox debugId='tgssCheck' ui:field='tgssCheck'
										styleName='aon-finding-toolbar-item {style.aon-toolbar-button} {style.toolBar-checkBox} '
										text="SILTRA" checked="false" />
									
									<g:ListBox debugId="settlePreviewListBox" ui:field="settlePreviewListBox" visible="false" >
										<g:item value="{JASPER}">EST&Aacute;NDAR</g:item>
										<g:item value="{LETTER}">CARTA (&Beta;)</g:item>
									</g:ListBox>
	
								</g:HTMLPanel>
							</g:HorizontalPanel>
							
							<g:HTMLPanel ui:field="collapContextPanel" styleName="{style.flex}" />
						
						</g:HTMLPanel>
					</g:HorizontalPanel>
				</g:FlowPanel>

				<g:HTMLPanel ui:field="messageContainer"/>

			</g:FlowPanel>

		</g:north>
		<g:center>
			<g:DeckLayoutPanel ui:field="deckPanel" debugId="deckPanel" >
				<g:SplitLayoutPanel styleName="{style.editor} {style.container}" ui:field="drafSplitLayoutPanel" debugId="drafSplitLayoutPanel" >
					<g:center>
						<g:VerticalPanel styleName="{style.document}" ui:field="scrolledPanel" >
	    					
							<g:VerticalPanel ui:field="draftPanel" width="auto" styleName="{style.draft}">
								
								<g:HorizontalPanel ui:field='timeRulePanel'  debugId='timeRulePanel' visible="false" styleName="aon-width-all {style.vertical-margin}" />
								<!--  g:HorizontalPanel ui:field='dbTimeRulePanel'  debugId='dbTimeRulePanel' visible="false" styleName="aon-width-all {style.vertical-margin} {style.disabled}" /-->
								
								<g:Grid styleName="aon-dataTable" ui:field="headerGrid" >
									<g:row styleName="aon-dataTable-row-even">
										<g:customCell  styleName="{style.span-cell}" >
											<g:Grid styleName="{style.span-cell-table}">
												<g:row>
													<g:customCell styleName="{style.span-cell-cell}">
														<g:HTMLPanel>
															<g:Label styleName="{style.cell-label}">C.C.C</g:Label>
															<g:Label ui:field="enterpriseCCCLabel" styleName="{style.cell-value}">&nbsp; </g:Label>
														</g:HTMLPanel>
													</g:customCell>
													<g:customCell styleName="{style.span-cell-cell}">
														<g:HTMLPanel >
															<g:Label styleName="{style.cell-label}">GRUPO</g:Label>
															<g:HTMLPanel tag="div" styleName="{style.cell-value}">
																<e:ValueInlineHTML changeDisplayStyleName="{style.value-changed}" debugId="employeeGroupLabel" ui:field="employeeGroupLabel" htmlNull="&nbsp;" >&nbsp; </e:ValueInlineHTML>
																<g:InlineHTML debugId="dbEmployeeGroupLabel" ui:field="dbEmployeeGroupLabel" visible="false"></g:InlineHTML>														
															</g:HTMLPanel>
														</g:HTMLPanel>
													</g:customCell>
													<g:customCell styleName="{style.span-cell-cell}">
														<g:HTMLPanel>
															<g:Label styleName="{style.cell-label}">CONTRATO</g:Label>
															<g:HTMLPanel tag="div" styleName="{style.cell-value}">
																<e:ValueInlineHTML changeDisplayStyleName="{style.value-changed}" debugId="employeeContractLabel" ui:field="employeeContractLabel" htmlNull="&nbsp;" >&nbsp; </e:ValueInlineHTML>
																<g:InlineHTML debugId="dbEmployeeContractLabel" ui:field="dbEmployeeContractLabel" visible="false"></g:InlineHTML>														
															</g:HTMLPanel>
														</g:HTMLPanel>
													</g:customCell>
													<g:customCell styleName="{style.span-cell-cell}">
														<g:HTMLPanel>
															<g:Label styleName="{style.cell-label}">OCUPACIÓN</g:Label>
															<g:HTMLPanel tag="div" styleName="{style.cell-value}">
																<e:ValueInlineHTML changeDisplayStyleName="{style.value-changed}" debugId="employeeOcupationLabel" ui:field="employeeOcupationLabel" htmlNull="&nbsp;" >&nbsp; </e:ValueInlineHTML>
																<g:InlineHTML debugId="dbEmployeeOcupationLabel" ui:field="dbEmployeeOcupationLabel" visible="false"></g:InlineHTML>														
															</g:HTMLPanel>
														</g:HTMLPanel>
													</g:customCell>
												</g:row>
											</g:Grid>
										</g:customCell>
										<g:customCell styleName="{style.span-cell}">
											<g:Grid styleName="{style.span-cell-table}">
												<g:row>
													<g:customCell styleName="{style.span-cell-cell}">
														<g:HTMLPanel>
															<g:Label styleName="{style.cell-label}">CATEGORÍA
																PROFESIONAL</g:Label>
															<g:Label ui:field="employeeAgreementCategoryLabel"
																styleName="{style.cell-value}">&nbsp; </g:Label>
														</g:HTMLPanel>
													</g:customCell>
													<g:customCell styleName="{style.span-cell-cell}">
														<g:HTMLPanel>
															<g:Label styleName="{style.cell-label}">N. AFILIACIÓN</g:Label>
															<g:Label ui:field="employeeSSLabel" styleName="{style.cell-value}">&nbsp; </g:Label>
															<g:Label debugId="employeeNameLabel" ui:field="employeeNameLabel" styleName="aon-text-center" visible="false" />
														</g:HTMLPanel>
													</g:customCell>
													<g:customCell styleName="{style.span-cell-cell-last}">
														<g:HTMLPanel>
															<g:Label styleName="{style.cell-label}">N. DOCUMENTO</g:Label>
															<g:Label ui:field="employeeDocumentLabel"
																styleName="{style.cell-value}">&nbsp; </g:Label>
														</g:HTMLPanel>
													</g:customCell>
												</g:row>
											</g:Grid>
										</g:customCell>
									</g:row>
									<g:row styleName="aon-dataTable-row-even">
										<g:customCell styleName="{style.span-cell}">
											<g:Grid styleName="{style.span-cell-table}">
												<g:row>
													<g:customCell styleName="{style.span-cell-cell}">
														<g:HTMLPanel>
															<g:Label ui:field="salarySelectLabel"  styleName="{style.cell-label}" visible="false">RECIBO&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;FECHA DE CÁLCULO</g:Label>
															<e:SalarySelect ui:field="salarySelect"/>
														</g:HTMLPanel>
													</g:customCell>
													<g:customCell styleName="{style.span-cell-cell}">
														<g:HTMLPanel>
															<g:Label styleName="{style.cell-label}">PERIODO
																LIQUIDACIÓN</g:Label>
															<g:Label debugId="periodLabel" ui:field="periodLabel" styleName="{style.cell-value}">&nbsp; </g:Label>
														</g:HTMLPanel>
													</g:customCell>
													<g:customCell styleName="{style.span-cell-cell-last}">
														<g:HTMLPanel>
															<g:Label styleName="{style.cell-label}">DÍAS</g:Label>
															<g:Label ui:field="daysLabel" debugId="daysLabel" styleName="{style.cell-value}">&nbsp; </g:Label>
														</g:HTMLPanel>
													</g:customCell>
												</g:row>
											</g:Grid>
										</g:customCell>
	
										<g:customCell>
											<g:Grid styleName="{style.span-cell-table}">
												<g:row>
													<g:customCell styleName="{style.span-cell-cell}">
														<g:HTMLPanel>
															<g:Label styleName="{style.cell-label}">ANTIGUEDAD</g:Label>
															<g:Label ui:field="employeeSeniorityLabel"
																styleName="{style.cell-value}">&nbsp; </g:Label>
														</g:HTMLPanel>
													</g:customCell>
													<g:customCell styleName="{style.span-cell-cell-last}">
														<g:HorizontalPanel styleName="{style.table-label}" ui:field="employeeHoursFactorDaysPanel">
															<g:HTMLPanel>
																<g:Label ui:field="employeeWorkedHoursTitle" styleName="{style.cell-label}" visible="false">HORAS TRABAJADAS</g:Label>
																<g:Label ui:field="employeeWorkedDaysTitle" styleName="{style.cell-label}" visible="false">DIAS TRABAJADOS</g:Label>
																<g:Label ui:field="employeePartialFactorTitle" styleName="{style.cell-label}" visible="false">COEFICIENTE PARCIALIDAD</g:Label>
																<g:HTMLPanel tag="div" styleName="{style.cell-value}">
																	<e:ValueInlineHTML changeDisplayStyleName="{style.value-changed}" debugId="employeeWorkedHoursLabel" ui:field="employeeWorkedHoursLabel" htmlNull="&nbsp;" visible="false" >&nbsp; </e:ValueInlineHTML>
																	<g:InlineHTML debugId="dbEmployeeWorkedHoursLabel" ui:field="dbEmployeeWorkedHoursLabel" visible="false"></g:InlineHTML>														
																	<e:ValueInlineHTML changeDisplayStyleName="{style.value-changed}" debugId="employeeWorkedDaysLabel" ui:field="employeeWorkedDaysLabel" htmlNull="&nbsp;" visible="false" >&nbsp; </e:ValueInlineHTML>
																	<g:InlineHTML debugId="dbEmployeeWorkedDaysLabel" ui:field="dbEmployeeWorkedDaysLabel" visible="false"></g:InlineHTML>														
																	<e:ValueInlineHTML changeDisplayStyleName="{style.value-changed}" debugId="employeePartialFactorLabel" ui:field="employeePartialFactorLabel" htmlNull="&nbsp;" visible="false" >&nbsp; </e:ValueInlineHTML>
																	<g:InlineHTML debugId="dbEmployeePartialFactorLabel" ui:field="dbEmployeePartialFactorLabel" visible="false"></g:InlineHTML>														
																</g:HTMLPanel>
															</g:HTMLPanel>
															<g:HTMLPanel>
																<g:Button  ui:field="employeeWorkedDaysButton" styleName="aon-editDataTable-button aon-icon-calendar" visible="false"></g:Button>
																<g:Button  ui:field="employeeWorkedHoursButton" styleName="aon-editDataTable-button aon-icon-calendar" visible="false"></g:Button>
																<g:Button  ui:field="employeePartialFactorButton" styleName="aon-editDataTable-button aon-icon-calendar" visible="false"></g:Button>
																<g:Label styleName="{style.cell-value}" >&nbsp;</g:Label>
															</g:HTMLPanel>
														</g:HorizontalPanel>
													</g:customCell>
												</g:row>
											</g:Grid>
										</g:customCell>
									</g:row>
								</g:Grid>
								<g:ScrollPanel ui:field="contentScrollPanel" styleName="aon-width-all {style.aon-content-scroll-panel}" >
									<g:VerticalPanel styleName="aon-width-all" >
										<g:HTML styleName="{style.vertical-space}" />
										<g:FlexTable ui:field="contextTable"
											styleName="aon-dataTable {style.edit-cells}" />
										
										<g:HTML styleName="{style.vertical-space}" />
			
										<g:FlexTable debugId="eventsTable" ui:field="eventsTable" styleName="aon-dataTable {style.eventsTable}" />
										<g:HTML ui:field="eventsTableSpace" styleName="{style.vertical-space}"
											visible="false" />
			
