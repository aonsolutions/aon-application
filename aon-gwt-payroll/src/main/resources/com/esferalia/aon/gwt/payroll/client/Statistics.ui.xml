<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<ui:UiBinder xmlns:ui='urn:ui:com.google.gwt.uibinder'
	xmlns:g='urn:import:com.google.gwt.user.client.ui' 
	xmlns:a='urn:import:com.esferalia.aon.gwt.payroll.client'>

	<ui:style>
	
		.editor {
			margin-top: 50px;
		}
		
		.pos {
			align: center;
			text-align: center;
		}

		.document {
			margin-top: 5px;
			margin-left: auto;
			margin-right: auto;
			margin-bottom: 15px;
		}
		
		.toolBar-checkBox input {
			vertical-align: middle;
		}

	</ui:style>
	
	<g:DockLayoutPanel unit="PX" ui:field="dockLayoutPanel">
		<g:center>
			<g:ScrollPanel styleName="{style.editor}">
				<g:VerticalPanel styleName="{style.document}">

					<g:Grid ui:field='gridColumnChart' styleName="{style.pos}">
						<g:row>
							<g:cell>
							</g:cell>
						</g:row>
					</g:Grid >
					<g:Grid ui:field='gridLinePieChart' styleName="{style.pos}">
						<g:row>
							<g:cell>
							</g:cell>
							<g:cell>
							</g:cell>
						</g:row>

					</g:Grid>

				</g:VerticalPanel>
			</g:ScrollPanel>
		</g:center>
	</g:DockLayoutPanel>

</ui:UiBinder>
