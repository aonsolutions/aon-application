<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
	xmlns:g='urn:import:com.google.gwt.user.client.ui'
	xmlns:a='urn:import:com.esferalia.aon.gwt.common.client.widget'
	xmlns:aon='urn:import:com.esferalia.aon.gwt.common.client.widget.solutions'>

	<ui:style type="com.esferalia.aon.gwt.payroll.client.Enterprise.MyStyle">

		.inputHeight { height: 1.5rem !important; }

		.container{
			min-width: 600px;
			padding: 20px 10px;
		}
		
		.widthAll{
			width: 100%;
		}
		
		.heightAll{
			height: 100%;
		}
		
		.flex{
			display: flex;
			align-items: center;
			width: 100%;
			margin: 2px 0;
			gap: 5px;
		}
		
		.flexCenter{
			display: flex;
			justify-content: center;
			align-items: center;
			margin-bottom: 20px;
			flex-direction: column;
		}
		
		.flexColumn{
			display: flex;
			justify-content: center;
			align-items: center;
			flex-direction: column;
		}
		
		.styleBorder{
			width: 100%;
			border: 1px solid black;
			padding: 10px;
		}
		
		.tittle{
			position: relative;
			top: -1.5em;
			left: 20px;
			width: 130px;
			padding: 0 5px;
			background-color: white;
			font-size: 12px;
			font-weight: bold;
			text-align: center;
		}
		
		.firstColumn{
			min-width: 175px;
			padding: 5px;
			background-color: #f6f6f6; 
		}
		
		.requiredColor{
			color: #2152A5;
			font-weight: bold !important;
		}
		
		.warningColor{
			font-weight: bold;
			color: #be0000;
		}
		
		.emptyLabel{
			height: 12px;
		}
		
		.mw-75{
			min-width: 75px;
			text-align: center;
		}
		
		.mt20{
			margin-top: 20px;
		}
		
		.warningTB{
			border: 1px solid red;
		}
		
		.heightTB{
			height: 1.1rem;
		}
		
		.w-50{
			width: 50px;
			text-align: center;
		}
		
		.w390 {
			width: 390px;
		}
		
	</ui:style>

	<g:VerticalPanel styleName="{style.container}">
		<g:HTMLPanel styleName="{style.widthAll} {style.heightAll} {style.flexCenter}" debugId="enterpriseHTMLPanel">
	   		<g:VerticalPanel styleName="{style.styleBorder}">
	    		<g:Label styleName='{style.tittle}'>Datos empresa</g:Label>
		    	<g:HTMLPanel ui:field="activityDataTable" styleName="{style.widthAll} {style.heightAll} {style.flexColumn}">
		    		<g:HTMLPanel styleName="{style.flex}">
		    			<g:Label  styleName='{style.requiredColor} {style.firstColumn}'>Nombre</g:Label>
		    			<g:TextBox ui:field="enterpriseName" styleName='aon-inputText {style.inputHeight} {style.widthAll}'></g:TextBox>
					</g:HTMLPanel>
					<g:HTMLPanel styleName="{style.flex}">
		    			<g:Label  styleName='{style.firstColumn}'>Nombre Comercial / Alias</g:Label>
		    			<g:TextBox ui:field="enterpriseAlias" styleName='aon-inputText {style.inputHeight} {style.widthAll}'></g:TextBox>
					</g:HTMLPanel>
					<g:HTMLPanel styleName="{style.flex}">
		    			<g:Label styleName='{style.firstColumn}'>Documento</g:Label>
		    			<g:Label ui:field="documentType"></g:Label>
		    			<g:TextBox ui:field="document" styleName='aon-inputText {style.inputHeight} {style.widthAll}'></g:TextBox>
						<aon:AonToolbarSmallButton ui:field="documentStatus"/>	
		    			<g:Label ui:field="nationalityLabel" styleName="{style.mw-75}">País Emisión</g:Label>
		    			<g:SuggestBox ui:field="nationality" styleName='aon-inputText {style.inputHeight} {style.widthAll}'></g:SuggestBox>
		    		</g:HTMLPanel>
					<g:HTMLPanel styleName="{style.flex}">
		    			<g:Label styleName='{style.requiredColor} {style.firstColumn}'>Dirección</g:Label>
		    			<g:ListBox ui:field="streetType" styleName='aon-selectOneMenu {style.inputHeight}'></g:ListBox>
		    			<g:TextBox ui:field="address" styleName='aon-inputText {style.inputHeight} {style.widthAll}'></g:TextBox>
		    			<g:Label>Número</g:Label>
		    			<g:TextBox ui:field="addressNum" styleName='aon-inputText {style.w-50} {style.inputHeight} {style.widthAll}'></g:TextBox>
		    			<g:Label>C.P.</g:Label>
		    			<g:TextBox ui:field="addressZip" styleName='aon-inputText {style.w-50} {style.inputHeight} {style.widthAll}'></g:TextBox>
					</g:HTMLPanel>
					<g:HTMLPanel styleName="{style.flex}">
						<g:Label styleName='{style.firstColumn} {style.emptyLabel} {style.inputHeight}'></g:Label>
		    			<g:Label>Provincia</g:Label>
		    			<g:ListBox ui:field="addressProvince" styleName='aon-inputText {style.inputHeight}'></g:ListBox>
		    			<g:Label>Municipio</g:Label>
		    			<g:ListBox ui:field="addressCity" styleName='aon-inputText {style.inputHeight}'></g:ListBox>
					</g:HTMLPanel>
					<g:HTMLPanel styleName="{style.flex}">
		    			<g:Label styleName='{style.firstColumn}'>Contacto</g:Label>
		    			<g:Label>Móvil</g:Label>
		    			<g:TextBox ui:field="mobile" styleName='aon-inputText {style.inputHeight} {style.widthAll}'></g:TextBox>
		    			<g:Label>Teléfono</g:Label>
		    			<g:TextBox ui:field="phone" styleName='aon-inputText {style.inputHeight} {style.widthAll}'></g:TextBox>
		    			<g:Label>eMail</g:Label>
		    			<g:TextBox ui:field="email" styleName='aon-inputText {style.inputHeight} {style.widthAll}'></g:TextBox>
					</g:HTMLPanel>
					<g:HTMLPanel styleName="{style.flex}">
		    			<g:Label styleName='{style.firstColumn}'>Web</g:Label>
		    			<g:TextBox ui:field="enterpriseWeb" styleName='aon-inputText {style.inputHeight} {style.widthAll}'></g:TextBox>
					</g:HTMLPanel>
					<g:HTMLPanel styleName="{style.flex}">
		    			<g:Label styleName='{style.firstColumn}'>Ámbito</g:Label>
		    			<g:HTMLPanel ui:field="enterpriseScopePanel" styleName="{style.widthAll}"></g:HTMLPanel>
					</g:HTMLPanel>	
		    	</g:HTMLPanel>
		    </g:VerticalPanel>
	   	</g:HTMLPanel>
	   	
	   	<g:HTMLPanel styleName="{style.widthAll} {style.heightAll} {style.mt20} {style.flexCenter}" debugId="otherDataHTMLPanel">
	   		<g:VerticalPanel styleName="{style.styleBorder}">
	    		<g:Label styleName='{style.tittle}'>Otros datos</g:Label>
		    	<g:HTMLPanel ui:field="otherDataDataTable" styleName="{style.widthAll} {style.heightAll} {style.flexColumn}">
		    		<g:HTMLPanel styleName="{style.flex}">
		    			<g:Label  styleName='{style.firstColumn}'>Modelo Recibo Salarial</g:Label>
		    			<g:ListBox ui:field="enterprisePaysheetModel" styleName='aon-selectOneMenu {style.inputHeight}'></g:ListBox>
		    			<g:Label styleName='{style.firstColumn} {style.w390}'>Modelo Recibo Costes Empresa</g:Label>
		    			<g:ListBox ui:field="enterpriseCostModel" styleName='aon-selectOneMenu {style.inputHeight} {style.widthAll}'></g:ListBox>
					</g:HTMLPanel>
					<g:HTMLPanel styleName="{style.flex}">
		    			<g:Label  styleName='{style.firstColumn}'>Envío Nóminas</g:Label>
		    			<g:ListBox ui:field="enterprisePaysheetSendType" styleName='aon-selectOneMenu {style.inputHeight}'></g:ListBox>
		    			<g:HTMLPanel ui:field="enterprisePaysheetSendPanel" styleName='{style.flex} {style.widthAll}'>
		    				<g:Label styleName='{style.firstColumn}'>A la dirección : </g:Label>
							<g:TextBox ui:field="enterprisePaysheetSendEmail" styleName='aon-inputText {style.inputHeight} {style.widthAll}'></g:TextBox>
		    			</g:HTMLPanel>
					</g:HTMLPanel>
					<g:HTMLPanel styleName="{style.flex}">
		    			<g:Label  styleName='{style.firstColumn}'>Convenio</g:Label>
		    			<g:SuggestBox ui:field="enterpriseAgreement" styleName='aon-inputText {style.inputHeight} {style.widthAll}' />
					</g:HTMLPanel>
		    	</g:HTMLPanel>
		    </g:VerticalPanel>
	   	</g:HTMLPanel>	
	</g:VerticalPanel>
			
</ui:UiBinder> 

