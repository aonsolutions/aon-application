<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
	xmlns:g='urn:import:com.google.gwt.user.client.ui'
	xmlns:aon='urn:import:com.esferalia.aon.gwt.common.client.widget.solutions'>

	<ui:style
		type="com.esferalia.aon.gwt.payroll.client.Enterprise.MyStyle">
		.container {
			min-width: 600px;
			padding: 0 1rem;
			margin-top: 15px;
			display: flex;
			flex-direction: column;
		}
		
		.documentError {
			border: 1.5px solid #ad0000;
		}
		
		.emptyLabel {
			height: 12px;
		}
		
		.aonEnterpriseCardLabel {
			min-width: 170px;
			padding: 5px;
			background-color: #f6f6f6;
		}
		
		.flex {
			display: flex;
			align-items: center;
			width: 100%;
			margin: 2px 0;
			gap: 5px;
		}
		
		.flexColumn {
			display: flex;
			justify-content: center;
			align-items: center;
			flex-direction: column;
		}
		
		.heightAll {
			height: 100%;
		}
		
		.inputPadding {
			padding: 0 0 0 .5rem;
		}
		
		.inputLBHeight {
			height: 1.4rem !important;
			border-radius: 0;
			text-transform: uppercase;
		}
		
		.inputTextHeight {
			height: 1.2rem !important;
			text-transform: uppercase;
		}
		
		.mt20 {
			margin-top: 20px;
		}
		
		.mw30 {
			min-width: 30px;
		}
		
		.mw50 {
			max-width: 50px;
			text-align: center;
		}
		
		.mw75 {
			min-width: 75px;
			text-align: center;
		}
		
		.mw100 {
			min-width: 100px !important;
		}
		
		.mw150 {
			min-width: 150px;
			width: 100%;
		}
		
		.mw180 {
			width: 180px;
		}
		
		.aonEnterpriseCardRequired {
			color: #2152A5;
			font-weight: bold !important;
		}
		
		.aonEnterpriseCard {
			border: 1px solid black;
			border-radius: 5px;
			padding: 0 1rem .5rem;
		}
		
		.aonEnterpriseCardTitle {
			position: relative;
			top: -10px;
			left: 20px;
			width: 130px;
			padding: 0 5px;
			background-color: white;
			font-size: 12px;
			font-weight: bold;
			text-align: center;
		}
		
		.warningColor {
			font-weight: bold;
			color: #be0000;
		}
		
		.warningTB {
			border: 1.5px solid #ad0000;
		}
		
		.widthAll {
			width: 100%;
		}
		@external documentError;
		
		@external aonEnterpriseCard;
		@external aonEnterpriseCardTitle;
		@external aonEnterpriseCardLabel;
		@external aonEnterpriseCardRequired;
		
		</ui:style>

	<g:HTMLPanel styleName="{style.container}">
		<g:HTMLPanel
			styleName="{style.widthAll} {style.heightAll}"
			debugId="enterpriseHTMLPanel">
			<g:HTMLPanel styleName="{style.aonEnterpriseCard}">
				<g:Label styleName='{style.aonEnterpriseCardTitle}'>Datos empresa</g:Label>
				<g:HTMLPanel ui:field="activityDataTable"
					styleName="{style.widthAll} {style.heightAll} {style.flexColumn}">
					<g:HTMLPanel styleName="{style.flex}">
						<g:Label
							styleName='{style.aonEnterpriseCardRequired} {style.aonEnterpriseCardLabel}'>Nombre</g:Label>
						<g:TextBox ui:field="enterpriseName"
							debugId="enterpriseNameTB"
							styleName='aon-inputText {style.inputTextHeight}  {style.inputPadding} {style.widthAll}'></g:TextBox>
					</g:HTMLPanel>
					<g:HTMLPanel styleName="{style.flex}">
						<g:Label styleName='{style.aonEnterpriseCardLabel}'>Nombre Comercial / Alias</g:Label>
						<g:TextBox ui:field="enterpriseAlias"
							styleName='aon-inputText {style.inputTextHeight}  {style.inputPadding} {style.widthAll}'></g:TextBox>
					</g:HTMLPanel>
					<g:HTMLPanel styleName="{style.flex}">
						<g:Label styleName='{style.aonEnterpriseCardLabel}'>Documento</g:Label>
						<g:Label ui:field="documentType"
							debugId="enterpriseDocumentType"></g:Label>
						<g:TextBox ui:field="document"
							debugId="enterpriseDocumentTB"
							styleName='aon-inputText {style.inputTextHeight} {style.inputPadding} {style.widthAll}'></g:TextBox>
						<aon:AonToolbarSmallButton
							ui:field="documentStatus" />
						<g:Label ui:field="nationalityLabel"
							styleName="{style.mw75}">País Emisión</g:Label>
						<g:SuggestBox ui:field="nationality"
							styleName='aon-inputText {style.inputTextHeight} {style.inputPadding} {style.widthAll}'></g:SuggestBox>
					</g:HTMLPanel>
					<g:HTMLPanel styleName="{style.flex}">
						<g:Label
							styleName='{style.aonEnterpriseCardRequired} {style.aonEnterpriseCardLabel}'>Dirección</g:Label>
						<g:ListBox ui:field="streetType"
							styleName='aon-selectOneMenu {style.inputLBHeight} {style.inputPadding} {style.mw180}'></g:ListBox>
						<g:TextBox ui:field="address"
							styleName='aon-inputText {style.inputTextHeight} {style.widthAll}'></g:TextBox>
						<g:Label>Nº</g:Label>
						<g:TextBox ui:field="addressNum"
							styleName='aon-inputText {style.mw50} {style.inputTextHeight} {style.widthAll} {style.mw30}'></g:TextBox>
						<g:Label>C.P.</g:Label>
						<g:TextBox ui:field="addressZip"
							debugId="enterpriseZipAddressTB"
							styleName='aon-inputText {style.mw50} {style.inputTextHeight} {style.widthAll}'></g:TextBox>
					</g:HTMLPanel>
					<g:HTMLPanel styleName="{style.flex}">
						<g:Label
							styleName='{style.aonEnterpriseCardLabel} {style.emptyLabel} {style.inputTextHeight}'></g:Label>
						<g:Label>Provincia</g:Label>
						<g:ListBox ui:field="addressProvince"
							debugId="enterpriseProvinceAddressTB"
							styleName='aon-inputText {style.inputLBHeight} {style.inputPadding} {style.mw150}'></g:ListBox>
						<g:Label>Municipio</g:Label>
						<g:ListBox ui:field="addressCity"
							styleName='aon-inputText {style.inputLBHeight} {style.inputPadding} {style.mw150}'></g:ListBox>
					</g:HTMLPanel>
					<g:HTMLPanel styleName="{style.flex}">
						<g:Label styleName='{style.aonEnterpriseCardLabel}'>Contacto</g:Label>
						<g:Label>Móvil</g:Label>
						<g:TextBox ui:field="mobile"
							styleName='aon-inputText {style.inputTextHeight} {style.inputPadding} {style.widthAll}'></g:TextBox>
						<g:Label>Teléfono</g:Label>
						<g:TextBox ui:field="phone"
							styleName='aon-inputText {style.inputTextHeight} {style.inputPadding} {style.widthAll}'></g:TextBox>
						<g:Label>eMail</g:Label>
						<g:TextBox ui:field="email"
							styleName='aon-inputText {style.inputTextHeight} {style.inputPadding} {style.widthAll}'></g:TextBox>
					</g:HTMLPanel>
					<g:HTMLPanel styleName="{style.flex}">
						<g:Label styleName='{style.aonEnterpriseCardLabel}'>Web</g:Label>
						<g:TextBox ui:field="enterpriseWeb"
							styleName='aon-inputText {style.inputTextHeight} {style.inputPadding} {style.widthAll}'></g:TextBox>
					</g:HTMLPanel>
					<g:HTMLPanel styleName="{style.flex}">
						<g:Label styleName='{style.aonEnterpriseCardLabel}'>Ámbito</g:Label>
						<g:HTMLPanel ui:field="enterpriseScopePanel"
							styleName="{style.widthAll}"></g:HTMLPanel>
					</g:HTMLPanel>
				</g:HTMLPanel>
			</g:HTMLPanel>
		</g:HTMLPanel>

		<g:HTMLPanel
			styleName="{style.widthAll} {style.heightAll} {style.mt20}"
			debugId="otherDataHTMLPanel">
			<g:HTMLPanel styleName="{style.aonEnterpriseCard}">
				<g:Label styleName='{style.aonEnterpriseCardTitle}'>Otros datos</g:Label>
				<g:HTMLPanel ui:field="otherDataDataTable"
					styleName="{style.widthAll} {style.heightAll} {style.flexColumn}">
					<g:HTMLPanel styleName="{style.flex}">
						<g:Label styleName='{style.aonEnterpriseCardLabel}'>Modelo Recibo Salarial</g:Label>
						<g:ListBox ui:field="enterprisePaysheetModel"
							styleName='aon-selectOneMenu {style.inputLBHeight} {style.inputPadding} {style.widthAll} '></g:ListBox>
					</g:HTMLPanel>
					<g:HTMLPanel styleName="{style.flex}">
						<g:Label styleName='{style.aonEnterpriseCardLabel}'>Envío Nóminas</g:Label>
						<g:ListBox ui:field="enterprisePaysheetSendType"
							styleName='aon-selectOneMenu {style.inputLBHeight} {style.inputPadding} {style.widthAll} '></g:ListBox>
						<g:HTMLPanel ui:field="enterprisePaysheetSendPanel"
							styleName='{style.flex} {style.widthAll}'>
							<g:Label styleName='{style.mw100} {style.aonEnterpriseCardLabel}'>A la dirección : </g:Label>
							<g:TextBox ui:field="enterprisePaysheetSendEmail"
								styleName='aon-inputText {style.inputTextHeight} {style.inputPadding} {style.widthAll}'></g:TextBox>
						</g:HTMLPanel>
					</g:HTMLPanel>
					<g:HTMLPanel styleName="{style.flex}">
						<g:Label styleName='{style.aonEnterpriseCardLabel}'>Convenio</g:Label>
						<g:SuggestBox ui:field="enterpriseAgreement"
							styleName='aon-inputText {style.inputTextHeight} {style.inputPadding} {style.widthAll}' />
					</g:HTMLPanel>
				</g:HTMLPanel>
			</g:HTMLPanel>
		</g:HTMLPanel>
		
		<g:HTMLPanel
			styleName="{style.widthAll} {style.heightAll} {style.mt20}"
			debugId="otherDataHTMLPanel">
			<g:HTMLPanel styleName="{style.aonEnterpriseCard}">
				<g:Label styleName='{style.aonEnterpriseCardTitle}'>Sistema RED</g:Label>
				<g:HTMLPanel ui:field="tgssDataTable"
					styleName="{style.widthAll} {style.heightAll} {style.flexColumn}">
					<g:HTMLPanel styleName="{style.flex}">
						<g:Label styleName='{style.aonEnterpriseCardLabel}'>Clave autorización</g:Label>
						<g:TextBox ui:field="enterprisePayAuthorizationKey"
								styleName='aon-inputText {style.inputTextHeight} {style.inputPadding} {style.widthAll}' maxLength="8"></g:TextBox>
					</g:HTMLPanel>
					<g:HTMLPanel styleName="{style.flex}">
						<g:Label styleName='{style.aonEnterpriseCardLabel}'>Entidad gestora del plan de pensiones</g:Label>
						<g:ListBox ui:field="enterprisePaySsMutual"
							styleName='aon-selectOneMenu {style.inputLBHeight} {style.inputPadding} {style.widthAll} ' />
					</g:HTMLPanel>
				</g:HTMLPanel>
			</g:HTMLPanel>
		</g:HTMLPanel>
	</g:HTMLPanel>






</ui:UiBinder> 

