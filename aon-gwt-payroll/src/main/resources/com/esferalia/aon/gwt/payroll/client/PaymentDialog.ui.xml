<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<ui:UiBinder xmlns:ui='urn:ui:com.google.gwt.uibinder'
	xmlns:g='urn:import:com.google.gwt.user.client.ui'
	xmlns:a='urn:import:com.esferalia.aon.gwt.payroll.client' >

	<ui:Style  >
	
	</ui:Style>


	<g:HTMLPanel styleName="aon-width-all aon-height-all" debugId="paymetDialogHTMLPanel"> 

		<table class="aon-width-all aon-height-all" >
			<tr>
				<td>
					<a:Payment ui:field="payment"/>
				</td>
			</tr>

			<tr ui:field="buttonsRow">
				<td colspan="2" align="right">
					<g:Button ui:field="cancelButton" debugId="paymetDialogCancelButton">Cancelar</g:Button>
					<g:Button ui:field="acceptButton" debugId="paymetDialogAcceptButton" >Aceptar</g:Button>
				</td>
			</tr>
		</table>


	</g:HTMLPanel>

</ui:UiBinder>