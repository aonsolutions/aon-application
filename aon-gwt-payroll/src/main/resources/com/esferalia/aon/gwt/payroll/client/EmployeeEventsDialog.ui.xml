<ui:UiBinder
    xmlns:ui='urn:ui:com.google.gwt.uibinder'
	xmlns:g='urn:import:com.google.gwt.user.client.ui'
	xmlns:a='urn:import:com.esferalia.aon.gwt.common.client.widget'>

	<ui:with field='msgs' type='com.esferalia.aon.gwt.payroll.client.i18n.PayrollMessages'/>

	<ui:Style  type="com.esferalia.aon.gwt.payroll.client.EmployeeEventsDialog.MyStyle">

		.form {
			padding: 10px;
		}

		.columnPanel{
			display: flex;
			flex-direction: column;
			padding: 5px;
		}

		.rowPanel{
			display: flex;
			justify-content: space-between;
			margin: 3px 0;
			column-gap: 10px;
		}

		.buttonsPanel{
			display: flex;
			justify-content: flex-end;
			margin-top: 20px;
		}

		.labelStyle{
			display: flex;
			align-items: center;
		}

		.dateBox{
			width: 200px !important;
			text-align: center;
			border: solid #808080 1px;
		}

		.w200{
			width: 200px;
		}

		.errorPanel{
			font-weight: bold;
			color: red;
			padding: 0 5px;
			margin-bottom: 10px;
		}

		.percentLabel{
			display: flex;
			align-items: center;
			margin-right: 5px;
		}

		.percentTBx{
			width: auto;
			text-align: center;
		}

		.percent{
			text-align: center;
			font-weight: bold;
			display: flex;
			align-items: center;
			margin-left: 5px;
		}

		.scrollPanel{
			width: 100%;
			height: 100%;
			max-height: 215px;
		}

	</ui:Style>

	<g:HTMLPanel styleName="{style.form}">

		<g:HTMLPanel styleName="aon-width-all aon-height-all">

			<g:HTMLPanel styleName="{style.columnPanel}" ui:field="containerHeader"/>
			<g:HTMLPanel styleName="{style.columnPanel}" ui:field="containerNewPeriod"/>
			<g:ScrollPanel ui:field="containerScrollPanel" styleName="{style.scrollPanel}">
				<g:HTMLPanel styleName="{style.columnPanel}" ui:field="container"/>
			</g:ScrollPanel>

			<g:HTMLPanel  ui:field="errorMessage" styleName="{style.errorPanel}">
				<g:DeckPanel ui:field="errorDeckPanel">
					<g:HTMLPanel>
						<g:Label>{msgs.dateInterferenceError}</g:Label>
						<g:Label ui:field="contractErrorDateL" />
					</g:HTMLPanel>
					<g:HTMLPanel>
						<g:Label>{msgs.errorFormatMsg}</g:Label>
						<g:Label>{msgs.decimalsInfo}</g:Label>
					</g:HTMLPanel>
				</g:DeckPanel>
			</g:HTMLPanel>

			<g:HTMLPanel ui:field="buttonsPanel" styleName="{style.buttonsPanel}"></g:HTMLPanel>

		</g:HTMLPanel>

	</g:HTMLPanel>

</ui:UiBinder>
