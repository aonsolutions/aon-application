<ui:UiBinder 
    xmlns:ui='urn:ui:com.google.gwt.uibinder'
	xmlns:g='urn:import:com.google.gwt.user.client.ui'
	xmlns:a='urn:import:com.esferalia.aon.gwt.common.client.widget'>

	<ui:Style  type="com.esferalia.aon.gwt.payroll.client.EmployeeEventsDialog.MyStyle">

		.form {
			padding: 10px;
		}
		
		.columnPanel{
			display: flex;
			flex-direction: column;
			padding: 5px;
			/*border: 1px solid #e1e1e1;*/
			margin-bottom: 10px;
		}
		
		.rowPanel{
			display: flex;
			justify-content: space-between;
			margin: 3px 0;
			column-gap: 10px;
		}
		
		.buttonsPanel{
			display: flex;
			justify-content: flex-end;
			margin-top: 20px;
		}
		
		.labelStyle{
			display: flex;
			align-items: center;
		}
		
		.dateBox{
			width: 200px !important;
			text-align: center;
			border: solid #808080 1px;
		}
		
		.w200{
			width: 200px;
		}
		
		.errorPanel{
			font-weight: bold;
			color: red;
			padding: 0 5px;
			margin-bottom: 10px;
		}
		
		.percentLabel{
			display: flex;
			align-items: center;
			margin-right: 5px;
		}
		
		.percentTBx{
			width: auto;
			text-align: center;
		}
		
		.percent{
			text-align: center;
			font-weight: bold;
			display: flex;
			align-items: center;
			margin-left: 5px;
		}

	</ui:Style>
	
	<g:HTMLPanel styleName="{style.form}">
	
		<g:HTMLPanel styleName="aon-width-all aon-height-all">
		
			<g:HTMLPanel styleName="{style.columnPanel}" ui:field="containerHeader"/>
			<g:HTMLPanel styleName="{style.columnPanel}" ui:field="containerNewPeriod"/>
			<g:HTMLPanel styleName="{style.columnPanel}" ui:field="container"/>
			
			<g:HTMLPanel  ui:field="errorMessage" styleName="{style.errorPanel}">
				<g:DeckPanel ui:field="errorDeckPanel">
					<g:HTMLPanel>
						<g:Label>La fecha introducida interfiere con uno de los tramos existentes.</g:Label>
						<g:Label ui:field="contractErrorDateL" />
					</g:HTMLPanel>
					<g:HTMLPanel>
						<g:Label>El valor introducido no tiene formato de número.</g:Label>
						<g:Label>Decimales separados por '.'</g:Label>
					</g:HTMLPanel>
				</g:DeckPanel>
			</g:HTMLPanel>
	
			<g:HTMLPanel ui:field="buttonsPanel" styleName="{style.buttonsPanel}"></g:HTMLPanel>
		
		</g:HTMLPanel>
			
	</g:HTMLPanel>

</ui:UiBinder>