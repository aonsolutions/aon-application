<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
	xmlns:g='urn:import:com.google.gwt.user.client.ui'
	xmlns:e='urn:import:com.esferalia.aon.gwt.payroll.client'>

	<ui:with field='res'
		type='com.esferalia.aon.gwt.common.client.css.AonResources' />

	<ui:style type="com.esferalia.aon.gwt.payroll.client.CCC.MyStyle">
	
		.cmdBtn{
			background-position: center left;
			background-repeat: no-repeat;
			padding-left: 25px !important;
			background-size: contain;
		}	
	
		.container{
			width: 100%;
			padding: 5px;
		}
		
		.emptyMessage{
			text-align: center;
			text-transform: uppercase;
			font-weight: bold;
			padding-top: .5rem;
		}
	
		.flexCenter{
			display: flex;
			justify-content: center;
			margin-top: 1rem;
		}
		
		.flexEvenly{
			display: flex;
			justify-content: space-evenly;
			align-items: center;
		}
		
		.footerToolbar{
			display: flex;
		    align-items: center;
		    justify-content: space-between;
		    padding: 5px;
		    border-top: 1px solid;
			padding-bottom: 0;
			margin-top: 10px;
		}
		
		.footerOptionsToolbar{
			display: flex;
		    align-items: center;
		}
		
		.gridStyle{
			width: 100%;
			max-width: 875px;
		}
		
		.headerStyle{
			font-weight: bold;
			padding-left: 5px;
		}
		
		.heigthAuto { height: auto !important; }
		
		.inputLBHeight { 
			height: 1.4rem !important; 
			text-transform: uppercase;	
		}
		
		.inputTextHeight { 
			height: 1.2rem !important; 
			text-transform: uppercase;	
			padding-left: .5rem !important;
		}
		
		.scrollStyle {
			width: 100%;
			max-width: 875px;
		}
		
		.styleBorder{
			width: 100%;
			max-width: 900px;
			border: 1px solid black;
			border-radius: 5px;
			padding: 0 1rem .5rem;
		}
		
		.tittle{
			position: relative;
			top: -10px;
			left: 20px;
			width: 160px;
			padding: 0 5px;
			background-color: white;
			font-size: 12px;
			font-weight: bold;
			text-align: center;
		}
		
		.warningColor{
			font-weight: bold;
			color: #be0000;
		}
		
		.warningTB { border: 1.5px solid #ad0000; }
		
		.widthAll { width: 100%; }
		
		@external warningTB;
	
	</ui:style>

	<g:HTMLPanel styleName="{style.widthAll} {style.flexCenter}" ui:field="centerContainer" debugId="activityHTMLPanel">
   		<g:VerticalPanel styleName="{style.styleBorder}">
    		<g:Label styleName='{style.tittle}'>Cuentas de cotización</g:Label>
	    	<g:HTMLPanel styleName="{style.widthAll}" debugId="paymetDialogHTMLPanel">
	    		<g:VerticalPanel styleName="{style.container}">
	    			<g:Grid ui:field="cccDataTableHeader" styleName="{style.gridStyle}"></g:Grid>
	    			<g:HTMLPanel>
	    				<hr align="left" noshade="noshade" style="margin-bottom: 10px;border-width: 0.5px;"/>
	    			</g:HTMLPanel>
		    		<g:ScrollPanel ui:field="scrollPanel" styleName="{style.scrollStyle}">
		    			<g:DeckPanel styleName="{style.widthAll}" ui:field="deckPanel">
		    				<g:Grid ui:field="cccDataTable" styleName="{style.heigthAuto}"/>
		    				<g:Label text="No existe cuentas de cotización" styleName="{style.emptyMessage}" />
		    			</g:DeckPanel>
		    		</g:ScrollPanel>
	    		</g:VerticalPanel>
	    	</g:HTMLPanel>
	    </g:VerticalPanel>
   	</g:HTMLPanel>
</ui:UiBinder> 

