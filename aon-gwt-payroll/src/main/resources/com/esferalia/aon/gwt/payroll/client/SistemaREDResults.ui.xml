<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<ui:UiBinder xmlns:ui='urn:ui:com.google.gwt.uibinder'
	xmlns:g='urn:import:com.google.gwt.user.client.ui' xmlns:datepicker='urn:import:com.google.gwt.user.datepicker.client'>

	<ui:with field='msgs' type='com.esferalia.aon.gwt.payroll.client.i18n.PayrollMessages'/>

	<ui:Style>
	.button-bar {
		border: none !important;
		background: none !important;
	}
	
	.button-bar button {
		float: right;
		width: 16px;
		height: 16px;
		margin-left: 5px;
		margin-right: 5px;
	}
	
	.button-bar button:first-of-type {
		margin-right: 15px;
	}
	.gwt-MenuItemCustom > span{
	    font-size: 18px;
	    margin-top: -5px;
	    margin-left: -9px;
	    font-size: 18px;
	}
	</ui:Style>

	<ui:import field="com.google.gwt.user.client.ui.FormPanel.*" />
	<ui:import field="com.esferalia.aon.gwt.payroll.shared.SistemaREDService.*" />
	<ui:import field="com.esferalia.aon.gwt.payroll.shared.SistemaREDService.Parameter.*" />
	
	<g:DockLayoutPanel styleName="aon-width-all" ui:field="dockLayoutPanel">
		<g:north size="26">
			<g:FlowPanel styleName="{style.button-bar} gwt-MenuBar-horizontal"
				ui:field="menuBarFlowPanel">
<!-- 
				<g:Button styleName="gwt-MenuItem {style.gwt-MenuItemCustom}" ui:field="expandAllButton" >
					<span class="material-icons-outlined">expand_less</span>
				</g:Button>

				<g:Button styleName="gwt-MenuItem {style.gwt-MenuItemCustom}" ui:field="collapseAllButton" >
					<span class="material-icons-outlined">expand_more</span>
				</g:Button> -->

				<g:Button styleName="gwt-MenuItem {style.gwt-MenuItemCustom}" ui:field="clearButton" title="{msgs.clear}">
					<span class="material-icons-outlined">clear_all</span>
				</g:Button>


				<g:Button styleName="gwt-MenuItem {style.gwt-MenuItemCustom}" ui:field="runButton" title="{msgs.refresh}">
					<span class="material-icons-outlined">sync</span>
				</g:Button>
				
				<g:FormPanel visible="false" ui:field="certificateFormPanel" method="{METHOD_POST}" action="{SISTEMA_RED_URL}/{CERTIFICATE}"  encoding="{ENCODING_MULTIPART}">
					<g:VerticalPanel visible="false" >
						<g:FileUpload visible="false"  title="Archivo de certificado para importar" ui:field="certificateFileUpload" name="{FILE.name}" />
						<g:Hidden ui:field="userNameHidden" name="{USER.name}" />
						<g:Hidden ui:field="domainNameHidden" name="{DOMAIN.name}" />
						<g:Hidden visible="false" ui:field="certificatePasswordHidden" name="{PASSWORD.name}" />
					</g:VerticalPanel>
				</g:FormPanel>
				<g:FormPanel visible="false" ui:field="employeeFormPanel" method="{METHOD_POST}" action="{SISTEMA_RED_URL}/{EMPLOYEE}"  >
					<g:VerticalPanel visible="false" >
 						<g:Hidden ui:field="idHidden" name="{ID.name}" />
 						<g:Hidden ui:field="regimeHidden" name="{REGIME.name}" />
						<g:Hidden ui:field="cccHidden" name="{CCC.name}" />
						<g:Hidden ui:field="nafHidden" name="{NAF.name}" />
						<g:Hidden ui:field="dateHidden" name="{DATE.name}" />
						<g:Hidden ui:field="userHidden" name="{USER.name}" />
						<g:Hidden ui:field="domainHidden" name="{DOMAIN.name}" />
					</g:VerticalPanel>
				</g:FormPanel>

			</g:FlowPanel>
		</g:north>
		<g:center>
			<g:ScrollPanel styleName="aon-width-all">
				<g:Tree ui:field="eventsTree">
				</g:Tree>
			</g:ScrollPanel>
		</g:center>
	</g:DockLayoutPanel>


</ui:UiBinder>