<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<ui:UiBinder xmlns:ui='urn:ui:com.google.gwt.uibinder'
	xmlns:g='urn:import:com.google.gwt.user.client.ui'
	xmlns:a='urn:import:com.esferalia.aon.gwt.payroll.client' 
	xmlns:aon='urn:import:com.esferalia.aon.gwt.common.client.widget.solutions'>

	<ui:Style>
	
		.container{
			min-width: 800px;
		}
	
		.flexColumn {
			display: flex;
			flex-direction: column;
			gap: .5rem;
		}
		
		.flexEnd{
			display: flex;
			justify-content: flex-end;
			gap: .5rem;
			margin: 0.5rem 1rem 0.8rem 1rem;
		}
		
	</ui:Style>
	
	<g:HTMLPanel styleName="{style.flexColumn}">
		<aon:AonToolbar ui:field="toolbar" />
		<g:HTMLPanel ui:field="messagePanel"/>
		<g:HTMLPanel styleName="{style.container} {style.flexColumn}">
			<a:Activity ui:field="activity"/>
			<g:HTMLPanel ui:field="buttonsPanel" styleName="{style.flexEnd}" />
		</g:HTMLPanel>
	</g:HTMLPanel>

</ui:UiBinder>