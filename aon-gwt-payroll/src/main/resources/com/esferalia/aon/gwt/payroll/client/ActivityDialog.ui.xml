<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<ui:UiBinder xmlns:ui='urn:ui:com.google.gwt.uibinder'
	xmlns:g='urn:import:com.google.gwt.user.client.ui'
	xmlns:a='urn:import:com.esferalia.aon.gwt.payroll.client' >

	<ui:Style type="com.esferalia.aon.gwt.payroll.client.ActivityDialog.MyStyle">
		
		.widthAll{
			width: 100%;
		}
		
		.heightAll{
			height: 100%;
		}
		
		.container{
			min-width: 600px;
		}
		
		.buttonsPanel{
			display: flex;
			justify-content: flex-end;
			margin: 5px 10px;
		}
	</ui:Style>

	<g:VerticalPanel styleName="{style.widthAll} {style.heightAll} {style.container}"> 
		<a:Activity ui:field="activity"/>
		<g:HTMLPanel ui:field="buttonsPanel" styleName="{style.buttonsPanel}"></g:HTMLPanel>
	</g:VerticalPanel>

</ui:UiBinder>