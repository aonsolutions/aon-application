<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<ui:UiBinder xmlns:ui='urn:ui:com.google.gwt.uibinder'
	xmlns:g='urn:import:com.google.gwt.user.client.ui'>

	<ui:Style>
		
	</ui:Style>

	<g:HTMLPanel>

		<table width="100%">
			<tr>

				<td >
					<g:VerticalPanel>
						<g:Label>Categor&iacute;a
						</g:Label>
						<g:ListBox ui:field="categoryListBox" />
						<g:Label>Funci&oacute;n
						</g:Label>
						<g:ListBox ui:field="functionListBox" visibleItemCount="20" />
					</g:VerticalPanel>
				</td>

				<td>
					<table width="100%" height="100%">
						<tr>
							<td colspan="3">
								<g:Label ui:field="nameLabel" styleName="aon-bold">SI</g:Label>
							</td>
						</tr>
						<tr>
							<td colspan="3" >
								<g:Label >&nbsp;</g:Label>
							</td>
						</tr>
						<tr>
							<td colspan="3" >
								<g:Label ui:field="syntaxLabel" wordWrap="false">SI(
									Prueba_l&oacute;gica, Valor_si_verdadero, Valor_si_falso )
								</g:Label>
							</td>
						</tr>
						<tr>
							<td colspan="3">
								<g:Label >&nbsp;</g:Label>
							</td>
						</tr>
						<tr>
							<td colspan="3">
								<!-- Allow multiple lines fopr description -->
								<g:Label ui:field="descriptionLabel" wordWrap="true">Espeficica
									una prueba l&oacutegica;
									que se desea efectuar.
								</g:Label>
							</td>
						</tr>
						<tr>
							<td colspan="3">
								<g:Label >&nbsp;</g:Label>
							</td>
						</tr>
						<tr>
							<td colspan="3">
								<g:Label >&nbsp;</g:Label>
							</td>
						</tr>

						<tr>
							<td width="50%">
								<g:InlineLabel >Expresi&oacute;n
								</g:InlineLabel>
							</td>
							<td>
								<g:InlineLabel >Resultado
								</g:InlineLabel >
							</td>
							<td>
								<g:TextBox ui:field="resultTextBox"  />
							</td>
						</tr>

						<tr>
							<td colspan="3">
								<g:TextArea ui:field="expressionTextArea"
									visibleLines="5"  characterWidth="50" />
							</td>
						</tr>
					</table>
				</td>
			</tr>

			<tr>
				<td colspan="2" align="right">
					<g:Button ui:field="cancelButton">Cancelar</g:Button>
					<g:Button ui:field="acceptButton">Aceptar</g:Button>
				</td>
			</tr>
		</table>


	</g:HTMLPanel>

</ui:UiBinder>