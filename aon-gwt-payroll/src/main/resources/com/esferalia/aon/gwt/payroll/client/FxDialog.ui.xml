<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<ui:UiBinder xmlns:ui='urn:ui:com.google.gwt.uibinder'
	xmlns:g='urn:import:com.google.gwt.user.client.ui'
	xmlns:aon='urn:import:com.esferalia.aon.gwt.payroll.client'>

	<ui:Style type='com.esferalia.aon.gwt.payroll.client.FxDialog.Style'>
	.expression-TextArea {
		padding: 0px;
		min-height: 75px;
	}
	
	.function-ListBox option {
		padding-left: 18px;
	}
	
	@if !user.agent safari {
		.variable-label {
			font-weight: bold;
			font-family: sans-serif;
		}
	}
	@else {
		.variable-label {
			font-weight: bold;
			font-family: sans-serif;
		}
	}

	@sprite .variable-warn {
		width: auto; 
		height: auto;
		color: orange;
		gwt-image: 'warn';
		padding-left: 14px;
	}

	@sprite .variable-changed {
		width: auto; 
		height: auto;
		gwt-image: 'changed';
		padding-left: 14px;
	}


	@sprite .function-ListBox option[value="VariableDescriptor"] {
		width: auto;
		gwt-image: 'x';
		background-position: left center;
	}
	
	@sprite .function-ListBox option[value="FunctionDescriptor"] {
		width: auto;
		gwt-image: 'fx';
		font-weight: bold;
		background-position: left center;
	}
	</ui:Style>

	<ui:image field='x' src='x.png' />
	<ui:image field='fx' src='fx.png' />
	<ui:image field='warn' src='warn.png' />
	<ui:image field='changed' src='changed.png' />


	<g:HTMLPanel styleName="aon-width-all aon-height-all">

		<table class="aon-width-all aon-height-all">
			<tr>

				<td width="25%">
					<table class="aon-width-all aon-height-all">
						<tr>
							<td>
								<g:Label>Categor&iacute;a</g:Label>
							</td>
						</tr>
						<tr>
							<td>
								<g:ListBox ui:field="categoryListBox" styleName="aon-width-all" />
							</td>
						</tr>
						<tr>
							<td>
								<g:Label>&nbsp; </g:Label>
							</td>
						</tr>
						<tr>
							<td>
								<g:Label>Funci&oacute;n</g:Label>
							</td>
						</tr>
						<tr class="aon-width-all aon-height-all" >
							<td class="aon-width-all aon-height-all">
								<g:ListBox ui:field="functionListBox" visibleItemCount="20"
							styleName="aon-width-all aon-height-all {style.function-ListBox}" />
							</td>
						</tr>
					</table>

				</td>

				<td>
					<table class="aon-width-all aon-height-all">
						<tr>
							<td colspan="3">
								<g:Label ui:field="nameLabel" styleName="aon-bold"></g:Label>
							</td>
						</tr>
						<tr>
							<td colspan="3">
								<g:Label>&nbsp; </g:Label>
							</td>
						</tr>
						<tr>
							<td colspan="3">
								<g:Label ui:field="syntaxLabel" wordWrap="false"></g:Label>
							</td>
						</tr>
						<tr>
							<td colspan="3">
								<g:Label>&nbsp; </g:Label>
							</td>
						</tr>
						<tr>
							<td colspan="3">
								<!-- Allow multiple lines fopr description -->
								<g:InlineHTML ui:field="descriptionLabel" wordWrap="true" />
							</td>
						</tr>
						<tr>
							<td colspan="3">
								<g:Label>&nbsp; </g:Label>
							</td>
						</tr>
						<tr>
							<td colspan="3">
								<g:InlineHTML ui:field="valueLabel" styleName="aon-bold"></g:InlineHTML>
							</td>
						</tr>
						<tr>
							<td colspan="3">
								<g:Label>&nbsp; </g:Label>
							</td>
						</tr>
						<tr>
							<td colspan="3">
								<g:FlexTable ui:field="contextTable" />
							</td>
						</tr>

						<tr>
							<td colspan="3">
								<g:InlineHTML ui:field="errorLabel">&nbsp;</g:InlineHTML>
							</td>
						</tr>
						<tr>
							<td colspan="3">
								<g:Label>&nbsp; </g:Label>
							</td>
						</tr>

						<tr>
							<td width="25%">
								<g:InlineLabel>Expresi&oacute;n
								</g:InlineLabel>
							</td>
							<td width="25%">
								<g:InlineLabel>Resultado
								</g:InlineLabel>
							</td>
							<td width="25%">
								<g:HTML ui:field="resultLabel" stylePrimaryName="gwt-TextBox">&nbsp; </g:HTML>
							</td>
						</tr>

						<tr class="aon-width-all aon-height-all">
							<td colspan="3" class="aon-width-all aon-height-all">
								<aon:ExpressionArea ui:field="expressionTextArea"
									styleName="aon-width-all aon-height-all gwt-TextArea {style.expression-TextArea}" />
							</td>
						</tr>
					</table>
				</td>
			</tr>

			<tr>
				<td colspan="2" align="right">
					<g:Button ui:field="cancelButton">Cancelar</g:Button>
					<g:Button ui:field="acceptButton">Aceptar</g:Button>
				</td>
			</tr>
		</table>


	</g:HTMLPanel>

</ui:UiBinder>