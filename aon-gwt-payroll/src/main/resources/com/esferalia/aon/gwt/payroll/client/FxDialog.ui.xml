<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<ui:UiBinder xmlns:ui='urn:ui:com.google.gwt.uibinder'
	xmlns:g='urn:import:com.google.gwt.user.client.ui' xmlns:aon='urn:import:com.esferalia.aon.gwt.payroll.client'
	xmlns:code='urn:import:com.esferalia.aon.gwt.codemirror.client.ui'>
	<ui:with field='msgs' type='com.esferalia.aon.gwt.payroll.client.i18n.PayrollMessages'/>


	<ui:Style type='com.esferalia.aon.gwt.payroll.client.FxDialog.Style'>
	
	.hide {
		display: none;
	}

	.align-left {
		text-align: left;
	}
	
	.align-right {
		text-align: right;
	}
	
	.width-quarter{
	}

	.height-all{
		height: 100% !important;
	}

	.expression-TextArea {
		padding: 0px;
		min-height: 75px;
		min-width: 450px;
		max-width: 450px;
		margin-left: 1px;
		margin-bottom: 1px;
	}
	
	.function-ListBox option {
		padding-left: 18px;
	}
	
	@if !user.agent safari {
		.variable-label {
			font-weight: bold;
			font-family: sans-serif;
		}
	}
	@else {
		.variable-label {
			font-weight: bold;
			font-family: sans-serif;
		}
	}

	.variable-warn {
		color: orange;
	}

	.variable-changed {
	}


	.function-ListBox option[value="VariableDescriptor"] {
		width: auto;
		background-position: left center;
	}
	
	.function-ListBox option[value="FunctionDescriptor"] {
		width: auto;
		font-weight: bold;
		background-position: left center;
	}
	
	@external .CodeMirror-scroll;
	
	.CodeMirror-scroll {
	    overflow: hidden !important;
	}	
	</ui:Style>



	<g:HTMLPanel styleName="aon-width-a11 aon-height-all">



		<g:Grid styleName="aon-width-a11 aon-height-all">
			<g:row>
				<g:customCell >
					<g:Grid styleName="aon-width-a11 aon-height-all">
						<g:row>
							<g:customCell>
								<g:Label text="{msgs.category}"/>
							</g:customCell>
						</g:row>
						<g:row>
							<g:customCell>
								<g:ListBox ui:field="categoryListBox" styleName="aon-width-all" />
							</g:customCell>
						</g:row>
						<g:row>
							<g:customCell>
								<g:Label>&nbsp; </g:Label>
							</g:customCell>
						</g:row>
						<g:row>
							<g:customCell>
								<g:Label text="{msgs.function}"/>
							</g:customCell>
						</g:row>
						<g:row styleName="aon-width-a11 aon-height-all">
							<g:customCell class="aon-width-a11 aon-height-all">
								<g:ListBox ui:field="functionListBox"
									visibleItemCount="20"
									styleName="aon-width-all aon-height-all {style.function-ListBox}" />
							</g:customCell>
						</g:row>
					</g:Grid>
				</g:customCell>
				<g:customCell styleName="">
					<g:Grid styleName="aon-width-a11 aon-height-all">
						<g:row>
							<g:customCell>
								<g:Label ui:field="nameLabel" styleName="aon-bold"></g:Label>
							</g:customCell>
						</g:row>
						<g:row>
							<g:customCell>
								<g:Label>&nbsp; </g:Label>
							</g:customCell>
						</g:row>
						<g:row>
							<g:customCell>
								<g:Label ui:field="syntaxLabel" wordWrap="false"></g:Label>
							</g:customCell>
						</g:row>
						<g:row>
							<g:customCell>
								<g:Label>&nbsp; </g:Label>
							</g:customCell>
						</g:row>
						<g:row>
							<g:customCell>
								<!-- Allow multiple lines fopr description -->
								<g:InlineHTML ui:field="descriptionLabel" wordWrap="true" />
							</g:customCell>
						</g:row>
						<g:row>
							<g:customCell>
								<g:Label>&nbsp; </g:Label>
							</g:customCell>
						</g:row>
						<g:row>
							<g:customCell>
								<g:InlineHTML ui:field="valueLabel" styleName="aon-bold"></g:InlineHTML>
							</g:customCell>
						</g:row>
						<g:row>
							<g:customCell>
								<g:Label>&nbsp; </g:Label>
							</g:customCell>
						</g:row>
						<g:row>
							<g:customCell>
								<g:FlexTable ui:field="contextTable" />
							</g:customCell>
						</g:row>

						<g:row>
							<g:customCell>
								<g:InlineHTML ui:field="errorLabel">&nbsp;</g:InlineHTML>
							</g:customCell>
						</g:row>
						<g:row>
							<g:customCell>
								<g:Label>&nbsp; </g:Label>
							</g:customCell>
						</g:row>
						<g:row>
							<g:customCell>
								<g:HorizontalPanel styleName="aon-width-all"
									spacing="5">
									<g:cell width='25%' horizontalAlignment='ALIGN_LEFT'>
										<g:InlineLabel styleName="aon-width-half">Expresi&oacute;n
										</g:InlineLabel>
									</g:cell>
									<g:cell width='25%' horizontalAlignment='ALIGN_RIGHT'>
										<g:InlineLabel text="{msgs.result}"/>
									</g:cell>
									<g:cell width='50%' horizontalAlignment='ALIGN_RIGHT'>
										<g:HTML ui:field="resultLabel" stylePrimaryName="gwt-TextBox">&nbsp; </g:HTML>
									</g:cell>
								</g:HorizontalPanel>
							</g:customCell>
						</g:row>
						<g:row styleName="aon-width-al1 aon-height-al1">
							<g:customCell colspan="3" class="aon-width-al1 aon-height-al1">
								<aon:ExpressionCodeArea ui:field="expressionCodeArea" debugId="fxExpressionCodeArea"
									styleName="aon-width-a11 {style.height-all} gwt-TextArea {style.expression-TextArea}" />
							</g:customCell>
						</g:row>
					</g:Grid>
				</g:customCell>
			</g:row>
			<g:row>
				<g:customCell styleName="aon-width-a11 {style.align-left}">
					<g:Button ui:field="editButton" debugId="fxEditButton"
						styleName="aon-editDataTable-button aon-icon-edit-add" />
				</g:customCell>
				<g:customCell horizontalAlignment='ALIGN_RIGHT' >
					<g:HorizontalPanel spacing="5" styleName="aon-width-all">
						<g:cell horizontalAlignment='ALIGN_RIGHT' width="100%">
							<g:InlineLabel>&nbsp;</g:InlineLabel>
						</g:cell>
						<g:cell horizontalAlignment='ALIGN_RIGHT'>
							<g:Button ui:field="cancelButton" debugId="fxCancelButton" text="{msgs.cancel}"/>
						</g:cell>
						<g:cell horizontalAlignment='ALIGN_RIGHT'>
							<g:Button ui:field="acceptButton" debugId="fxAcceptButton" text="{msgs.accept}"/>
						</g:cell>
					</g:HorizontalPanel>
				</g:customCell>
			</g:row>
		</g:Grid>

	</g:HTMLPanel>

</ui:UiBinder>