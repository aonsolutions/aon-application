<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<ui:UiBinder xmlns:ui='urn:ui:com.google.gwt.uibinder'
	xmlns:g='urn:import:com.google.gwt.user.client.ui' 
	xmlns:employee='urn:import:com.esferalia.aon.gwt.payroll.client'
	xmlns:s="urn:import:com.google.gwt.dom.builder.shared">

	<ui:with field='res' type='com.esferalia.aon.gwt.common.client.css.AonResources' />
    
	<ui:style type="com.esferalia.aon.gwt.payroll.client.EventsDraft.MyStyle">

		/* ESTILOS CABECERA */

		.eventsStyle{
			padding-top: 5px;
		}

		.labelStyle{
			padding-top: 5px;
    		padding-left: 5px;
    		padding-right: 5px;
    		font-weight: bold;
		}

		.listBoxStyle{
			font-size: smaller;
    		margin-top: 3px;
		}

		.hideElement{
			visibility: hidden;
		}

		/* ESTILOS CAMBIO DE AÑO */

		.paddingHorizontalPanel{
			padding-bottom: 30px;
		}

		.date {
			font-size: 20px;
			color: #FF704D;
			padding-left: 8px;
			padding-right: 8px;
			padding-top: 7px;
		}

		.optionButtons{
			width: 30px;
			height: 25px;
			cursor: pointer;
			border: none;
		}

		.optionButtonsLeft {
			margin-top: 8px;
			margin-left: 18px;
		}

		.optionButtonsRight {
			margin-top: 8px;
		}

		/* ESTILOS TABLA */

		.scrollStyle {
			position: absolute !important;
			right: 5px !important;
		}

		.tableStyle {
			border-collapse: collapse;
			cursor: pointer;
			margin-left: 0.8em;
			width: 99%;
		}

		.tableStyle td{
			padding: 3px;
		}

		.tableStyle tr {
			text-align: center;
			border-bottom: 1px solid #ddd;
			font-family: Arial, Helvetica, sans-serif !important;
			font-size: 11px !important;
		}

		.noSelectStyle {
			-webkit-touch-callout: none; /* iOS Safari */
			-webkit-user-select: none; /* Safari */
			-khtml-user-select: none; /* Konqueror HTML */
			-moz-user-select: none; /* Firefox */
			-ms-user-select: none; /* Internet Explorer/Edge */
			user-select: none; /* Non-prefixed version, currently supported by Chrome and Opera */
		}

		.widthEventTable{
			width: 100%;
		}
		
		.blankHeaderCell{
			width: 100px;
		}

		.headerCell{
			font-weight: bold;
    		font-size: 0.9em;
		}

		.oddRowColor{
			background-color: #eee;
		}

		.onChange {
			background-color: rgba(255, 255, 0, 0.38) !important;
		}

		.eventCell{
			text-align: center;
    		width: 40px;
    		border: none;
			font-family: Arial, Helvetica, sans-serif;
			font-size: 11px;
		}

		.setBlockCellStyle{
			color: #aaa;
		}
		
	</ui:style>

	<ui:import field="com.esferalia.aon.gwt.payroll.client.EventsDraft.*" />

	<g:DockLayoutPanel unit="PX" ui:field="mainPanel">
		<g:north size="72">
			<g:FlowPanel>
				<g:MenuBar>
				</g:MenuBar>
				<g:FlowPanel styleName="aon-finding-title-toolbar">
					<g:HorizontalPanel>
						<g:HTMLPanel styleName="aon-finding-title">
							<g:HTMLPanel styleName="aon-finding-title-internal {style.eventsStyle}">
								<g:Label styleName="aon-outputText">Incidencias</g:Label>
							</g:HTMLPanel>
						</g:HTMLPanel>
						<g:HorizontalPanel styleName="aon-finding-toolbar">
							<g:HTMLPanel styleName="aon-finding-toolbar-item-group">
								<g:Button ui:field='saveButton'
									styleName='aon-finding-toolbar-item aon-icon-accept' text="GUARDAR" 
									enabled="false"/>
								<g:Button ui:field='undoAllButton'
								    styleName='aon-finding-toolbar-item {res.css.aonIconUndoAll}'
									enabled="false" />
							</g:HTMLPanel>
						</g:HorizontalPanel>
						<g:HorizontalPanel styleName="aon-finding-toolbar">
						    <g:Label styleName="aon-outputText {style.labelStyle}">Tipo de vista :</g:Label>
						    <g:ListBox styleName="{style.listBoxStyle}" ui:field="typeView" />
						</g:HorizontalPanel>
						<g:HorizontalPanel ui:field="varListViewPanel" styleName="aon-finding-toolbar {style.hideElement}">
						    <g:Label styleName="aon-outputText {style.labelStyle}">Variable :</g:Label>
						    <g:ListBox styleName="{style.listBoxStyle}" ui:field="varListView" />
						</g:HorizontalPanel>
					</g:HorizontalPanel>
				</g:FlowPanel>
			</g:FlowPanel>	
		</g:north>
		
		<g:center>
		    <g:HTMLPanel>
				<!-- PANEL CAMBIO DE AÑO -->
				<g:HorizontalPanel>
				    <g:HorizontalPanel ui:field="datePanel" styleName="{style.paddingHorizontalPanel}">
						<g:Button
							styleName="{style.optionButtons} {style.optionButtonsLeft} aon-icon-previous"
							ui:field="previusDateButton" />
						<g:Label styleName="{style.date}" ui:field="dateLabel">01/2018</g:Label>
						<g:Button
							styleName="{style.optionButtons} {style.optionButtonsRight} aon-icon-next"
							ui:field="nextDateButton" />
					</g:HorizontalPanel>
				</g:HorizontalPanel>
				
				<!-- TABLA -->
				<g:DockLayoutPanel unit="PX" height="90%">
					<g:center>
						<g:ScrollPanel styleName="{style.scrollStyle}">
							<g:FlexTable ui:field="eventsTable" styleName="{style.tableStyle} {style.noSelectStyle} {style.widthEventTable}">
								<!-- AQUI SE CONSTRUYE LA TABLA VACIA. -->
							</g:FlexTable>
						</g:ScrollPanel>
					</g:center>
				</g:DockLayoutPanel>
			</g:HTMLPanel>
		</g:center>
	</g:DockLayoutPanel>

</ui:UiBinder>
