<ui:UiBinder
    xmlns:ui='urn:ui:com.google.gwt.uibinder'
	xmlns:g='urn:import:com.google.gwt.user.client.ui'
	xmlns:a='urn:import:com.esferalia.aon.gwt.common.client.widget'>

    <ui:with field='msgs' type='com.esferalia.aon.gwt.payroll.client.i18n.PayrollMessages'/>

	<ui:style type="com.esferalia.aon.gwt.payroll.client.AgreementPaymentDialog.MyStyle">
	
		.form {
			padding: 10px;
			display: flex;
			flex-direction: column;
			min-width: 400px;
		}
		
		.flexColumn{
			display: flex;
			flex-direction: column;
		}
		
		.flex{
			display: flex;
			align-items: center;
			gap: 10px;
		}
		
		.flexBetween{
			display: flex;
			justify-content: space-between;
			width: 100%;
		}
		
		.buttonsPanel{
			display: flex;
			justify-content: flex-end;
			margin-top: 10px;
		}
		
	</ui:style>

	<g:HTMLPanel styleName="{style.form}">

		<g:DeckPanel ui:field="deckPanel">
			<g:HTMLPanel ui:field="salaryBasePanel" styleName="{style.flexColumn}">
		    	<g:HTMLPanel styleName="{style.flex}">
		    		<g:CheckBox ui:field="salaryBaseAnualCB"/>
		    		<g:Label>{msgs.salaryBaseAnnual}</g:Label>
		    	</g:HTMLPanel>
		    	<g:HTMLPanel styleName="{style.flex}">
		    		<g:CheckBox ui:field="salaryBaseMensualCB"/>
		    		<g:Label>{msgs.salaryBaseMonthly}</g:Label>
		    	</g:HTMLPanel>
		    	<g:HTMLPanel styleName="{style.flex}">
		    		<g:CheckBox ui:field="salaryBaseDailyCB"/>
		    		<g:Label>{msgs.salaryBaseDaily}</g:Label>
		    	</g:HTMLPanel>
		    	<g:HTMLPanel styleName="{style.flex}">
		    		<g:CheckBox ui:field="salaryBaseHoursCB"/>
		    		<g:Label>{msgs.salaryBaseHours}</g:Label>
		    	</g:HTMLPanel>
		    </g:HTMLPanel>
		    
		    <g:HTMLPanel ui:field="salaryPlusesPanel" styleName="{style.flexColumn}">
		    	<g:HTMLPanel styleName="{style.flex}">
		    		<g:CheckBox ui:field="salaryPlusMensualCB"/>
		    		<g:Label>{msgs.salarialBonusMonthly}</g:Label>
		    	</g:HTMLPanel>
		    	<g:HTMLPanel styleName="{style.flex}">
		    		<g:CheckBox ui:field="salaryPlusDailyCB"/>
		    		<g:Label>{msgs.salarialBonusDaily}</g:Label>
		    	</g:HTMLPanel>
		    	<g:HTMLPanel styleName="{style.flex}">
		    		<g:CheckBox ui:field="salaryPlusWorkDailyCB"/>
		    		<g:Label>{msgs.salarialBonusDailyWorkable}</g:Label>
		    	</g:HTMLPanel>
		    	<g:HTMLPanel styleName="{style.flex}">
		    		<g:CheckBox ui:field="salaryBasePermanentCB"/>
		    		<g:Label>{msgs.salarialBonusFixed}</g:Label>
		    	</g:HTMLPanel>
		    </g:HTMLPanel>
		    
		    <g:HTMLPanel ui:field="extraSalaryPlusesPanel" styleName="{style.flexColumn}">
		    	<g:HTMLPanel styleName="{style.flex}">
		    		<g:CheckBox ui:field="extraSalaryPlusMensualCB"/>
		    		<g:Label>{msgs.extraSalarialBonusMonthly}</g:Label>
		    	</g:HTMLPanel>
		    	<g:HTMLPanel styleName="{style.flex}">
		    		<g:CheckBox ui:field="extraSalaryPlusDailyCB"/>
		    		<g:Label>{msgs.extraSalarialBonusDaily}</g:Label>
		    	</g:HTMLPanel>
		    	<g:HTMLPanel styleName="{style.flex}">
		    		<g:CheckBox ui:field="extraSalaryPlusWorkDailyCB"/>
		    		<g:Label>{msgs.extraSalarialBonusDailyWorkable}</g:Label>
		    	</g:HTMLPanel>
		    	<g:HTMLPanel styleName="{style.flex}">
		    		<g:CheckBox ui:field="extraSalaryBasePermanentCB"/>
		    		<g:Label>{msgs.extraSalarialBonusFixed}</g:Label>
		    	</g:HTMLPanel>
		    </g:HTMLPanel>
		    
		    <g:HTMLPanel ui:field="salaryComplementsPanel" styleName="{style.flexColumn}">
		    	<g:HTMLPanel styleName="{style.flex}">
		    		<g:CheckBox ui:field="spiceComplementCB"/>
		    		<g:Label>{msgs.remunrationInKind}</g:Label>
		    	</g:HTMLPanel>
		    	<g:HTMLPanel styleName="{style.flex}">
		    		<g:CheckBox ui:field="antiquityComplementCB"/>
		    		<g:Label>{msgs.seniorityPersonalComplement}</g:Label>
		    	</g:HTMLPanel>
		    	<g:HTMLPanel styleName="{style.flex}">
		    		<g:CheckBox ui:field="overnightComplementCB"/>
		    		<g:Label>{msgs.overnightExpensesDaily}</g:Label>
		    	</g:HTMLPanel>
		    	<g:HTMLPanel styleName="{style.flex}">
		    		<g:CheckBox ui:field="maintenanceComplementCB"/>
		    		<g:Label>{msgs.maintenanceExpensesDaily}</g:Label>
		    	</g:HTMLPanel>
		    	<g:HTMLPanel styleName="{style.flex}">
		    		<g:CheckBox ui:field="maintenanceForeingComplementCB"/>
		    		<g:Label>{msgs.maintenanceExpensesForeignDaily}</g:Label>
		    	</g:HTMLPanel>
		    	<g:HTMLPanel styleName="{style.flex}">
		    		<g:CheckBox ui:field="locomotionComplementCB"/>
		    		<g:Label>{msgs.locomotionExpensesWithoutProof}</g:Label>
		    	</g:HTMLPanel>
		    </g:HTMLPanel>
		    
		    <g:HTMLPanel ui:field="salaryExtrasPanel" styleName="{style.flexColumn}">
		    	<g:HTMLPanel styleName="{style.flexBetween}">
		    		<g:HTMLPanel styleName="{style.flex}">
		    			<g:CheckBox ui:field="salaryExtraCB" />
			    		<g:Label>{msgs.extraPaySummerChristmas}</g:Label>
			    	</g:HTMLPanel>
			    	<g:HTMLPanel styleName="{style.flex}">
			    		<g:Button ui:field="apportionExtraB" />
			    		<g:Label>{msgs.apportionment}</g:Label>
			    	</g:HTMLPanel>
		    	</g:HTMLPanel>
		    	<g:HTMLPanel styleName="{style.flexBetween}">
		    		<g:HTMLPanel styleName="{style.flex}">
			    		<g:CheckBox ui:field="salaryBenefitsCB" />
			    		<g:Label>{msgs.extraPayBenefits}</g:Label>
		    		</g:HTMLPanel>
		    		<g:HTMLPanel styleName="{style.flex}">
			    		<g:Button ui:field="apportionBenefitsB" />
			    		<g:Label>{msgs.apportionment}</g:Label>
			    	</g:HTMLPanel>
		    	</g:HTMLPanel>
		    </g:HTMLPanel>
		    
		</g:DeckPanel>
	    
	   	<g:HTMLPanel ui:field="buttonsPanel" styleName="{style.buttonsPanel}"></g:HTMLPanel>

	</g:HTMLPanel>

</ui:UiBinder>