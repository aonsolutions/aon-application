<ui:UiBinder 
    xmlns:ui='urn:ui:com.google.gwt.uibinder'
	xmlns:g='urn:import:com.google.gwt.user.client.ui'
	xmlns:a='urn:import:com.esferalia.aon.gwt.common.client.widget'>
    
    
	<ui:style type="com.esferalia.aon.gwt.payroll.client.AgreementPaymentDialog.MyStyle">
	
		.form {
			padding: 10px;
			display: flex;
			flex-direction: column;
			min-width: 400px;
		}
		
		.flexColumn{
			display: flex;
			flex-direction: column;
		}
		
		.flex{
			display: flex;
			align-items: center;
			gap: 10px;
		}
		
		.buttonsPanel{
			display: flex;
			justify-content: flex-end;
			margin-top: 10px;
		}
		
	</ui:style>

	<g:HTMLPanel styleName="{style.form}">

		<g:DeckPanel ui:field="deckPanel">
			<g:HTMLPanel ui:field="salaryBasePanel" styleName="{style.flexColumn}">
		    	<g:HTMLPanel styleName="{style.flex}">
		    		<g:CheckBox ui:field="salaryBaseAnualCB" value="true" />
		    		<g:Label>[01] SALARIO BASE ANUAL</g:Label>
		    	</g:HTMLPanel>
		    	<g:HTMLPanel styleName="{style.flex}">
		    		<g:CheckBox ui:field="salaryBaseMensualCB" value="true" />
		    		<g:Label>[02] SALARIO BASE MENSUAL</g:Label>
		    	</g:HTMLPanel>
		    	<g:HTMLPanel styleName="{style.flex}">
		    		<g:CheckBox ui:field="salaryBaseDailyCB" value="true" />
		    		<g:Label>[03] SALARIO BASE DIARIO</g:Label>
		    	</g:HTMLPanel>
		    	<g:HTMLPanel styleName="{style.flex}">
		    		<g:CheckBox ui:field="salaryBaseHoursCB" value="true" />
		    		<g:Label>[04] SALARIO BASE HORAS</g:Label>
		    	</g:HTMLPanel>
		    </g:HTMLPanel>
		    
		    <g:HTMLPanel ui:field="salaryPlusesPanel" styleName="{style.flexColumn}">
		    	<g:HTMLPanel styleName="{style.flex}">
		    		<g:CheckBox ui:field="salaryPlusMensualCB" value="true" />
		    		<g:Label>[10] PLUS SALARIAL MENSUAL</g:Label>
		    	</g:HTMLPanel>
		    	<g:HTMLPanel styleName="{style.flex}">
		    		<g:CheckBox ui:field="salaryPlusDailyCB" value="true" />
		    		<g:Label>[11] PLUS SALARIAL DIARIO</g:Label>
		    	</g:HTMLPanel>
		    	<g:HTMLPanel styleName="{style.flex}">
		    		<g:CheckBox ui:field="salaryPlusWorkDailyCB" value="true" />
		    		<g:Label>[12] PLUS SALARIAL DIARIO LABORABLES</g:Label>
		    	</g:HTMLPanel>
		    	<g:HTMLPanel styleName="{style.flex}">
		    		<g:CheckBox ui:field="salaryBasePermanentCB" value="true" />
		    		<g:Label>[13] PLUS SALARIAL FIJO</g:Label>
		    	</g:HTMLPanel>
		    </g:HTMLPanel>
		    
		    <g:HTMLPanel ui:field="extraSalaryPlusesPanel" styleName="{style.flexColumn}">
		    	<g:HTMLPanel styleName="{style.flex}">
		    		<g:CheckBox ui:field="extraSalaryPlusMensualCB" value="true" />
		    		<g:Label>[20] PLUS EXTRA SALARIAL MENSUAL</g:Label>
		    	</g:HTMLPanel>
		    	<g:HTMLPanel styleName="{style.flex}">
		    		<g:CheckBox ui:field="extraSalaryPlusDailyCB" value="true" />
		    		<g:Label>[21] PLUS EXTRA SALARIAL DIARIO</g:Label>
		    	</g:HTMLPanel>
		    	<g:HTMLPanel styleName="{style.flex}">
		    		<g:CheckBox ui:field="extraSalaryPlusWorkDailyCB" value="true" />
		    		<g:Label>[22] PLUS EXTRA SALARIAL DIARIO LABORABLES</g:Label>
		    	</g:HTMLPanel>
		    	<g:HTMLPanel styleName="{style.flex}">
		    		<g:CheckBox ui:field="extraSalaryBasePermanentCB" value="true" />
		    		<g:Label>[23] PLUS EXTRA SALARIAL FIJO</g:Label>
		    	</g:HTMLPanel>
		    </g:HTMLPanel>
		    
		    <g:HTMLPanel ui:field="salaryComplementsPanel" styleName="{style.flexColumn}">
		    	<g:HTMLPanel styleName="{style.flex}">
		    		<g:CheckBox ui:field="spiceComplementCB" value="true" />
		    		<g:Label>[30] RETRIBUCION EN ESPECIE</g:Label>
		    	</g:HTMLPanel>
		    	<g:HTMLPanel styleName="{style.flex}">
		    		<g:CheckBox ui:field="antiquityComplementCB" value="true" />
		    		<g:Label>[40] COMPLEMENTO PERSONAL DE ANTIGÜEDAD</g:Label>
		    	</g:HTMLPanel>
		    	<g:HTMLPanel styleName="{style.flex}">
		    		<g:CheckBox ui:field="overnightComplementCB" value="true" />
		    		<g:Label>[43] GASTOS PERNOCTA DIARIO</g:Label>
		    	</g:HTMLPanel>
		    	<g:HTMLPanel styleName="{style.flex}">
		    		<g:CheckBox ui:field="maintenanceComplementCB" value="true" />
		    		<g:Label>[45] GASTOS MANUTENCION DIARIO</g:Label>
		    	</g:HTMLPanel>
		    	<g:HTMLPanel styleName="{style.flex}">
		    		<g:CheckBox ui:field="locomotionComplementCB" value="true" />
		    		<g:Label>[50] GASTOS LOCOMOCIÓN SIN JUSTIFICANTE</g:Label>
		    	</g:HTMLPanel>
		    </g:HTMLPanel>
		    
		    <g:HTMLPanel ui:field="salaryExtrasPanel" styleName="{style.flexColumn}">
		    	<g:HTMLPanel styleName="{style.flex}">
		    		<g:CheckBox ui:field="salaryExtraCB" value="true" />
		    		<g:Label>[90-91] PAGA EXTRA VERANO NAVIDAD</g:Label>
		    	</g:HTMLPanel>
		    </g:HTMLPanel>
		</g:DeckPanel>
	    
	   	<g:HTMLPanel ui:field="buttonsPanel" styleName="{style.buttonsPanel}"></g:HTMLPanel>

	</g:HTMLPanel>

</ui:UiBinder>