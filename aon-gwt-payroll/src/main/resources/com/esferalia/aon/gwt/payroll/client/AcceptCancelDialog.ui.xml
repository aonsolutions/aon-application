<ui:UiBinder 
    xmlns:ui='urn:ui:com.google.gwt.uibinder'
	xmlns:g='urn:import:com.google.gwt.user.client.ui'
	xmlns:es3='urn:import:com.google.gwt.user.client.ui'>

    <ui:style type="com.esferalia.aon.gwt.payroll.client.AcceptCancelDialog.MyStyle">

		.form {
			padding: 10px;
		}
		
		.datesPanel{
			display: flex;
			flex-direction: column;
			padding: 5px;
			border: 1px solid #e1e1e1;
			margin-bottom: 10px;
		}
		
		.rowPanel{
			display: flex;
			justify-content: space-between;
			margin: 3px 0;
		}
		
		.buttonsPanel{
			display: flex;
			justify-content: flex-end;
		}
		
		.message{
			color:red;
			max-width: 450px;
		}
		
		.dateBox{
			width: 120px !important;
			text-align: center;
		}

	</ui:style>

	<g:HTMLPanel styleName="{style.form}">

		<g:HTMLPanel styleName="aon-width-all aon-height-all">
		
			<g:HTMLPanel styleName="{style.datesPanel}">
			
				<g:HTMLPanel styleName="{style.rowPanel} {style.message}">
					<g:Label ui:field="message"></g:Label>
				</g:HTMLPanel>
			
			</g:HTMLPanel>
			
			<g:HTMLPanel styleName="{style.buttonsPanel}">
				<g:Button ui:field="cancelButton">Cancelar</g:Button>
			    <g:Button ui:field="acceptButton">OK</g:Button>
			</g:HTMLPanel>
				
		</g:HTMLPanel>
		
	</g:HTMLPanel>

</ui:UiBinder>