<ui:UiBinder 
    xmlns:ui='urn:ui:com.google.gwt.uibinder'
	xmlns:g='urn:import:com.google.gwt.user.client.ui'
	xmlns:es3='urn:import:com.google.gwt.user.client.ui'>

    <ui:style type="com.esferalia.aon.gwt.payroll.client.AcceptCancelDialog.MyStyle">

		.paddingLabels{
			padding-left: 5px;
    		padding-right: 5px;
		}

		.width{
			width: 350px;
		}

		.paddingBlocks{
			padding-bottom: 5px;
		}

		.form {
			padding: 10px;
		}

		.closeButton {
			position: relative;
    		left: 200px;
			border: 1px solid #bbb;
			border-radius: 3px;
			cursor: pointer;
		}
		
		.marginTop{
			margin-top: 20px;
		}

	</ui:style>

	<g:HTMLPanel styleName="aon-width-all aon-height-all">
		<table class="aon-width-all aon-height-all" >
			<tr>
				<td>
					<g:Label ui:field="label1" styleName="{style.paddingLabels} {style.width}"></g:Label> 
				</td>
			</tr>
			<tr>
				<td>
					<g:Label ui:field="label2" styleName="{style.paddingLabels} {style.width}"></g:Label> 
				</td>
			</tr>
			<tr>
				<td>
					<g:Label ui:field="label3" styleName="{style.paddingLabels} {style.width}"></g:Label> 
				</td>
			</tr>
			<tr>
			</tr>
			<tr>
				<td colspan="2" align="right">
					<g:Button ui:field="cancelButton" styleName="{style.marginTop}" debugId="paymetDialogCancelButton">Cancelar</g:Button>
					<g:Button ui:field="acceptButton" styleName="{style.marginTop}" debugId="paymetDialogAcceptButton" >Aceptar</g:Button>
				</td>
			</tr>
		</table>		
	</g:HTMLPanel>

</ui:UiBinder>