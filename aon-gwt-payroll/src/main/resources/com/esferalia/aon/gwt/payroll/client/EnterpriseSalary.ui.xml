<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
	xmlns:g='urn:import:com.google.gwt.user.client.ui'
	xmlns:a='urn:import:com.esferalia.aon.gwt.common.client.widget'
	xmlns:c='urn:import:com.google.gwt.user.cellview.client'>

	<ui:with field='res'
		type='com.esferalia.aon.gwt.common.client.css.AonResources' />

	<ui:style type="com.esferalia.aon.gwt.payroll.client.EnterpriseSalary.MyStyle">
		/*UI Style*/
		
		.tableStyle{
			/*margin: auto;*/
			width: 100%;
			padding-top: 1em;
		}
		
		.mAuto{
			margin: auto;
		}
		
		.hide{
			display: none;
		}
		
		.suggestBox{
			width: 100%;
			margin: 3px;
			margin-left: 11px;
		}
		
		/*XML Style*/
	    
	    .tableStylePanel{
			/*margin: auto;*/
			width: 100%;
			padding: 1em;
		}
		
		.widthAll{
			width: 100%
		}
		
		.pl20{
			padding-left: 20px;
		}
		
		.ml12{
			margin-left: 12px;
		}
		
		.ml6{
			margin-left: 6px;
		}
		
		.ml30{
			margin-left: 30px;
		}

		.ml8{
			margin-left: 8px;
		}
		
	</ui:style>

	<g:DockLayoutPanel unit="PX">
		<!-- INIT HEADER MENU -->
		<g:north size="25">
			<g:FlowPanel styleName="aon-finding-title-toolbar">
				<g:HorizontalPanel >
					<g:HTMLPanel styleName="aon-finding-title">
						<g:HTMLPanel styleName="aon-finding-title-internal" >
							<g:Label styleName="aon-outputText">Nóminas</g:Label>
						</g:HTMLPanel>
					</g:HTMLPanel>
					<g:HTMLPanel styleName="aon-finding-subtitle">
						<g:HTMLPanel styleName="aon-finding-aubtitle-internal" >
							<g:Label styleName="aon-outputText" text=" "/> 
						</g:HTMLPanel>
					</g:HTMLPanel>
					<g:HorizontalPanel styleName="aon-finding-toolbar">
						<g:HTMLPanel styleName="aon-finding-toolbar-item-group" >
							<g:Button ui:field='deleteButton' styleName='aon-finding-toolbar-item aon-icon-delete {style.pl20}' text=" BORRAR"/>
							<g:Button debugId='saveButton' ui:field='saveButton' styleName='aon-finding-toolbar-item aon-icon-pdf {style.pl20}' text=" PDF" />
							<g:Button ui:field='publishButton' styleName='aon-finding-toolbar-item aon-icon-google-drive {style.pl20}' text=" PUBLICAR" />
							<g:Button ui:field='emailEnterpriseButton' styleName='aon-finding-toolbar-item aon-icon-mail {style.pl20}' text=" EMAIL EMPRESA" />
							<g:Button ui:field='emailEmployeesButton' styleName='aon-finding-toolbar-item aon-icon-mail {style.pl20}' text=" EMAIL EMPLEADOS" />
						</g:HTMLPanel>
					</g:HorizontalPanel>
				</g:HorizontalPanel>
			</g:FlowPanel>
		</g:north>
		<!-- END HEADER MENU -->
		<g:center>
			<g:HTMLPanel ui:field="mainContainer" styleName="{style.widthAll}">
				<g:ScrollPanel height="100%">
					<g:VerticalPanel styleName="{style.tableStylePanel}">
					
						<g:HTMLPanel styleName="aon-panelGrid-search">
							<g:HTMLPanel styleName="aon-panelGrid-search-info">
								<g:Label ui:field="workplaceNameLabel" styleName="aon-panelGrid-search-info-internal"></g:Label>
							</g:HTMLPanel>
							<g:DisclosurePanel ui:field="collapsePanel" styleName="{style.widthAll}">
								<g:header>FILTRAR BUSQUEDA</g:header>
								<g:HTMLPanel>
									<table class="aon-panelGrid">
										<tr>
											<td class="aon-panelGrid-odd">
												<g:Label styleName="aon-outputLabel">Para</g:Label>
											</td>
											<td class="aon-panelGrid-even">
												<g:VerticalPanel>
					    							<g:HorizontalPanel>
								  						<g:RadioButton name="employeeWorkplaceFilter" ui:field="allRB">Todo</g:RadioButton>
								  					</g:HorizontalPanel>
								  					<g:HorizontalPanel>
								  						<g:RadioButton name="employeeWorkplaceFilter" ui:field="workplaceRB">C. Trabajo</g:RadioButton>
								  						<g:SuggestBox ui:field="workplaceSB" styleName="aon-lookupSuggestText"></g:SuggestBox>
								  					</g:HorizontalPanel>
								  					<g:HorizontalPanel>
								  						<g:RadioButton name="employeeWorkplaceFilter" ui:field="employeeRB">Empleado</g:RadioButton>
								  						<g:SuggestBox ui:field="employeeSB" styleName="aon-lookupSuggestText {style.ml12}"></g:SuggestBox>
								  					</g:HorizontalPanel>
					    						</g:VerticalPanel>
											</td>
										</tr>
										<tr>
											<td class="aon-panelGrid-odd">
												<g:Label styleName="aon-outputLabel">Tipo nómina</g:Label>
											</td>
											<td class="aon-panelGrid-even">
												<g:ListBox styleName="aon-selectOneMenu {style.ml6}" ui:field="typeList"></g:ListBox>
											</td>
										</tr>
										<tr>
											<td class="aon-panelGrid-odd">
												<g:Label styleName="aon-outputLabel">Periodo</g:Label>
											</td>
											<td class="aon-panelGrid-even">
												<g:VerticalPanel>
					      							<g:HorizontalPanel>
					      								<g:RadioButton name="dateFilter" ui:field="noDateRB">Cualquier fecha</g:RadioButton>
					      							</g:HorizontalPanel>
					      							<g:HorizontalPanel>
					      								<g:RadioButton name="dateFilter" ui:field="dateMYRB">Mes/Año</g:RadioButton>
					      								<g:ListBox styleName="aon-selectOneMenu {style.ml30}" ui:field="monthMY"></g:ListBox>
					      								<g:ListBox styleName="aon-selectOneMenu" ui:field="yearMY"></g:ListBox>
					      							</g:HorizontalPanel>
					      							<g:HorizontalPanel>
					      								<g:RadioButton name="dateFilter" ui:field="dateTTRB">Desde/Hasta</g:RadioButton>
					      								<g:VerticalPanel>
					      									<g:HorizontalPanel>
					      										<g:ListBox styleName="aon-selectOneMenu {style.ml8}" ui:field="monthTillT"></g:ListBox>
					      										<g:ListBox styleName="aon-selectOneMenu" ui:field="yearTillT"></g:ListBox>
					      									</g:HorizontalPanel>
					      									<g:HorizontalPanel>
					      										<g:ListBox styleName="aon-selectOneMenu {style.ml8}" ui:field="monthTTo"></g:ListBox>
					      										<g:ListBox styleName="aon-selectOneMenu" ui:field="yearTTo"></g:ListBox>
					      									</g:HorizontalPanel>
					      								</g:VerticalPanel>
					      							</g:HorizontalPanel>
					      						</g:VerticalPanel>
											</td>
										</tr>
										<tr>
											<td class="aon-panelGrid-odd">
												<g:Label styleName="aon-outputLabel"></g:Label>
											</td>
											<td class="aon-panelGrid-even">
												<g:Button ui:field="filterButton" styleName="aon-search-lookup-button">Filtrar</g:Button>
											</td>
										</tr>
									</table>
								</g:HTMLPanel>
							</g:DisclosurePanel>
						</g:HTMLPanel>
					
					 	<g:HTMLPanel ui:field="mainTablePanel"></g:HTMLPanel>
					</g:VerticalPanel> 
				</g:ScrollPanel>
			</g:HTMLPanel>
		</g:center>
	</g:DockLayoutPanel>
</ui:UiBinder> 

