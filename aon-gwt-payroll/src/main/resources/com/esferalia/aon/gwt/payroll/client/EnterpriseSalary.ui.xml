<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
	xmlns:g='urn:import:com.google.gwt.user.client.ui'>

	<ui:style type="com.esferalia.aon.gwt.payroll.client.EnterpriseSalary.MyStyle">
		
		.container{
			width: 100%;
			min-width: 600px;
		}
		
		.flexColumn{
			display: flex;
			flex-direction: column;
			margin-top: 50px;
		}
		
		.flex{
			display: flex;
			gap: 10px;
			align-items: center;
			margin: 5px 0;
		}
		
		.label{
			min-width: 70px;
			font-weight: bold;
		}
		
		.warning {
			color: red;
		}
		
		.sb{
			width: 200px;
		}
		
		.cmd_btn{
			background-position: center left;
			background-repeat: no-repeat;
			padding-left: 25px !important;
			background-size: contain;
		}
		
	</ui:style>
	
	<g:DockLayoutPanel ui:field="dockLayoutPanel" unit="PX">
		<g:center>
			<g:VerticalPanel ui:field="mainContainer" styleName="{style.container}">
				<g:HTMLPanel ui:field="filterSalaryPanel" styleName="{style.flexColumn}">
					<g:HTMLPanel styleName="{style.flex}">
						<g:Label styleName="{style.label}">C. Trabajo</g:Label>
						<g:SuggestBox styleName="aon-inputText {style.sb}" ui:field="workplaceSB"/>
						<g:Label styleName="{style.label}">Empleado</g:Label>
						<g:SuggestBox styleName="aon-inputText {style.sb}" ui:field="employeeSB"/>
						<g:Label styleName="{style.label}">Tipo nómina</g:Label>
						<g:ListBox ui:field="typeList" styleName="aon-selectOneMenu"/>
					</g:HTMLPanel>
					<g:HTMLPanel styleName="{style.flex}">
						<g:Label styleName="{style.label}">Periodo</g:Label>
						<g:ListBox ui:field="dateFilterList" styleName="aon-selectOneMenu"/>
						<g:Label styleName="{style.label}">Desde/Hasta</g:Label>
						<g:ListBox ui:field="monthTillT" styleName="aon-selectOneMenu"/>
						<g:ListBox ui:field="yearTillT" styleName="aon-selectOneMenu"/>
						<g:ListBox ui:field="monthTTo" styleName="aon-selectOneMenu"/>
						<g:ListBox ui:field="yearTTo" styleName="aon-selectOneMenu"/>
						<g:Label ui:field="datesMessage" styleName="{style.label} {style.warning}">Periodo incorrecto</g:Label>
					</g:HTMLPanel>
				</g:HTMLPanel>
			</g:VerticalPanel>
		</g:center>
	</g:DockLayoutPanel>

</ui:UiBinder> 

