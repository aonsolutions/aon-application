<ui:UiBinder xmlns:ui='urn:ui:com.google.gwt.uibinder'
	xmlns:g='urn:import:com.google.gwt.user.client.ui' xmlns:employee='urn:import:com.esferalia.aon.gwt.payroll.client'
	xmlns:common='urn:import:com.esferalia.aon.gwt.common.client.widget'>


	<ui:style>
	
	.aon-EnterprisesTree  {
		text-transform: uppercase;
	}
	
	@external aon-EnterprisesTree;

	</ui:style>


	<g:DockLayoutPanel unit='PX'>
		<g:north size='26'>
			<g:FlowPanel styleName="gwt-MenuBar-horizontal" ui:field="buttonBar">
				<common:OptionsToolbar ui:field="toolbar" />
			</g:FlowPanel>
		</g:north>

		<g:center>
			<g:ScrollPanel ui:field="scrollPanel" >
				<g:Tree ui:field="tree"  styleName="{style.aon-EnterprisesTree} gwt-Tree" />
			</g:ScrollPanel>
		</g:center>
	</g:DockLayoutPanel>

</ui:UiBinder>
