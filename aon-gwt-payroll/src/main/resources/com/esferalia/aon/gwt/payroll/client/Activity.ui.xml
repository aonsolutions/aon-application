<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
	xmlns:g='urn:import:com.google.gwt.user.client.ui'
	xmlns:a='urn:import:com.esferalia.aon.gwt.common.client.widget'
	xmlns:aon='urn:import:com.esferalia.aon.gwt.payroll.client'>

	<ui:with field='res' type='com.esferalia.aon.gwt.common.client.css.AonResources' />

	<ui:style type="com.esferalia.aon.gwt.payroll.client.Activity.MyStyle">
		
		.checkBox { transform: scale(1.4); }
		
		.container {
			margin: 0 1rem;
			display: flex;
			flex-direction: column;
			gap: .5rem;
		}
		
		.dateBoxStyle{
			width: 200px !important;
			text-align: center !important;
		}
		
		.firstColumn{
			min-width: 200px;
			padding: 5px;
			background-color: #f6f6f6; 
		}
		
		.flex{
			display: flex;
			align-items: center;
			width: 100%;
			margin: 2px 0;
			gap: 5px;
		}
		
		.flexCenter{
			display: flex;
			justify-content: center;
			align-items: center;
			margin: 1rem 0;
		}
		
		.flexColumn{
			display: flex;
			justify-content: center;
			align-items: center;
			flex-direction: column;
		}
		
		.heightAll { height: 100%; }
		
		.inputTextHeight { 
			height: 1.2rem !important; 
			text-transform: uppercase;
			padding-left: .5rem !important;
		}
		
		.requiredColor{
			color: #2152A5;
			font-weight: bold !important;
		}
		
		.styleBorder{
			width: 100%;
			border: 1px solid black;
			border-radius: 5px;
			padding: 0 1rem .5rem;
		}
		
		.tittle{
			position: relative;
			top: -1.2em;
			left: 20px;
			width: 130px;
			padding: 0 5px;
			background-color: white;
			font-size: 12px;
			font-weight: bold;
			text-align: center;
		}
		
		.warningTB { border: 1.5px solid #ad0000; }
		
		.widthAll { width: 100%; }
		
		@external warningTB;
		
	</ui:style>

	<g:HTMLPanel styleName="{style.container}">
		<g:HTMLPanel styleName="{style.widthAll} {style.heightAll} {style.flexCenter}" debugId="activityHTMLPanel">
	   		<g:HTMLPanel styleName="{style.styleBorder}">
	    		<g:Label styleName='{style.tittle}'>Datos de actividad</g:Label>
		    	<g:HTMLPanel ui:field="activityDataTable" styleName="{style.widthAll} {style.heightAll} {style.flexColumn}">
		    		<g:HTMLPanel ui:field="activityDescriptionPanel" styleName="{style.flex}">
		    			<g:Label  styleName='{style.requiredColor} {style.firstColumn}'>Descripción</g:Label>
		    			<g:TextBox ui:field="activityDescription" debugId="activityNameTB" styleName='aon-inputText {style.inputTextHeight} {style.widthAll}'></g:TextBox>
					</g:HTMLPanel>
					<g:HTMLPanel ui:field="activityCNAE2009Panel" styleName="{style.flex}">
		    			<g:Label  styleName='{style.firstColumn}'>CNAE2009</g:Label>
		    			<g:SuggestBox ui:field="activityCNAE2009" debugId="activityCnaeTB" styleName='aon-inputText {style.inputTextHeight} {style.widthAll}'></g:SuggestBox>
					</g:HTMLPanel>
					<g:HTMLPanel styleName="{style.flex}">
		    			<g:Label styleName='{style.firstColumn}'>Fecha inicio</g:Label>
		    			<a:DateBoxEx ui:field="startDate" styleName='rich-calendar-input aon-selectInputDate-inputClass {style.inputTextHeight} {style.dateBoxStyle}'></a:DateBoxEx>
					</g:HTMLPanel>
					<g:HTMLPanel styleName="{style.flex}">
		    			<g:Label styleName='{style.firstColumn}'>Fecha fin</g:Label>
		    			<a:DateBoxEx ui:field="endDate" styleName='rich-calendar-input aon-selectInputDate-inputClass {style.inputTextHeight} {style.dateBoxStyle}'></a:DateBoxEx>
					</g:HTMLPanel>
					<g:HTMLPanel styleName="{style.flex}">
		    			<g:Label styleName='{style.firstColumn}'>Actividad principal</g:Label>
		    			<g:CheckBox ui:field="activityActive" styleName="{style.checkBox}"></g:CheckBox>
					</g:HTMLPanel>	
		    	</g:HTMLPanel>
		    </g:HTMLPanel>
	   	</g:HTMLPanel>
		
	    <aon:CCC ui:field="cccWidget"></aon:CCC>    
	</g:HTMLPanel>
			
</ui:UiBinder> 

