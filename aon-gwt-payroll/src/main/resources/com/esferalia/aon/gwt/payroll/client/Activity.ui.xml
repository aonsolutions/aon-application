<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
	xmlns:g='urn:import:com.google.gwt.user.client.ui'
	xmlns:a='urn:import:com.esferalia.aon.gwt.common.client.widget'>

	<ui:with field='res'
		type='com.esferalia.aon.gwt.common.client.css.AonResources' />

	<ui:style 
		type="com.esferalia.aon.gwt.payroll.client.Activity.MyStyle">
		
		.noselect {
			-webkit-touch-callout: none; /* iOS Safari */
			-webkit-user-select: none; /* Safari */
			-khtml-user-select: none; /* Konqueror HTML */
			-moz-user-select: none; /* Firefox */
			-ms-user-select: none; /* Internet Explorer/Edge */
			user-select: none; /* Non-prefixed version, currently
				                                  supported by Chrome and Opera */
		}
		
		.fontSaveStyle{
			font-weight: bold;
    		color: #000;
    		white-space: nowrap;
    		font-size: smaller;
    		padding-left: 30px;
    		width: 80px;	
		}
		
		.styleBorder{
			border-style: solid; 
			width: 975px; 
			border-width: 1px; 
			margin-top: 20px; 
			margin-left: 10px;
		}
		
		.tittle{
			top: -0.5em;
			font-size: 12px;
			margin-left: 10px;
		}
		
		.firstColumnTextStyle{
			padding:5px !important;
		}
		
		.requiredColor{
			color: #2152A5;
			font-weight: bold !important;
		}
		
		.maxWidth{
			width: 100%;
		}
		
		.textBoxWidth{
			width: 99.5%;
		}
		
		.scrollStyle {
			margin-left: 10px;
			width: 950px;
			margin-bottom: 10px;
		}
		
		.gridStyle{
			margin-left: 10px;
			width: 950px;
		}
		
		.columnWidth{
			width: 300px;
		}
		
		.columnWidth2{
			width: 300px;
		}
		
		.headerStyle{
			font-weight: bold;
			padding-left: 5px;
		}
		
		.elementWidth80{
			width: 80%;
		}
		
		.elementWidth95{
			width: 95%;
		}
		
		.footerStyle{
			background-color: #eaeaea;
			padding-top: 5px;
		}
		
		.footerElement{
			margin-left: 10px;
			width: 940px;
			border: none;
		}
		
		.hide{
			display: none;
		}
		
		.widthO{
			width: 0px;
		}
		
		.paddingTop{
			padding-top: 2px;
		}
		
		.dateBoxStyle{
			width: 200px !important;
			text-align: center !important;
		}
		
	</ui:style>

	<g:HTMLPanel>
		<g:VerticalPanel>
			<g:VerticalPanel styleName="{style.styleBorder}">
		    	<g:Label width="105px" styleName='aon-group-title {style.tittle}'>Datos de actividad</g:Label>
		    	<g:HTMLPanel styleName="aon-width-all aon-height-all" debugId="paymetDialogHTMLPanel">
		    		<table ui:field="activityDataTable" style="margin-left: 10px; margin-bottom: 10px; width: 950px;">
						<tbody>
						    <tr>
						        <td></td>
						        <td></td>
						    </tr>
						    <tr>
						    	<td  style="background-color: #eaeaea; width: 200px;">
						    		<g:Label  styleName='{style.requiredColor} {style.firstColumnTextStyle}'>Descripción</g:Label>
						    	</td>
						    	<td>
						    		<g:TextBox ui:field="activityDescription" styleName='aon-inputText {style.maxWidth}'></g:TextBox>
						    	</td>
						    </tr>
						    <tr>
						    	<td  style="background-color: #eaeaea; width: 200px;">
						    		<g:Label  styleName='{style.requiredColor} {style.firstColumnTextStyle}'>CNAE2009</g:Label>
						    	</td>
						    	<td>
						    		<g:SuggestBox ui:field="activityCNAE2009" styleName='aon-inputText {style.maxWidth}'></g:SuggestBox>
						    	</td>
						    </tr>
						    <tr>
						    	<td style="background-color: #eaeaea; width: 200px;">
						    		<g:Label styleName='{style.firstColumnTextStyle}'>Fecha inicio</g:Label>
						    	</td>
						    	<td>
						    		<a:DateBoxEx ui:field="startDate" styleName='rich-calendar-input aon-selectInputDate-inputClass {style.dateBoxStyle}'></a:DateBoxEx>
						    	</td>
						    </tr>
						    <tr>
						    	<td style="background-color: #eaeaea; width: 200px;">
						    		<g:Label styleName='{style.firstColumnTextStyle}'>Fecha fin</g:Label>
						    	</td>
						    	<td>
						    		<a:DateBoxEx ui:field="endDate" styleName='rich-calendar-input aon-selectInputDate-inputClass {style.dateBoxStyle}'></a:DateBoxEx>
						    	</td>
						    </tr>
						    <tr>
						    	<td  style="background-color: #eaeaea; width: 200px;">
						    		<g:Label styleName='{style.firstColumnTextStyle}'>Régimen de cotización</g:Label>
						    	</td>
						    	<td>
						    		<g:Label ui:field="activityRegime"></g:Label>
						    	</td>
						    </tr>
						    <tr>
						    	<td  style="background-color: #eaeaea; width: 200px;">
						    		<g:Label styleName='{style.firstColumnTextStyle}'>Actividad principal</g:Label>
						    	</td>
						    	<td>
						    		<g:CheckBox ui:field="activityActive"></g:CheckBox>
						    	</td>
						    </tr>
						</tbody>
					</table>
		    	</g:HTMLPanel>
		    </g:VerticalPanel>
		    <g:VerticalPanel styleName="{style.styleBorder}">
		    	<g:Label width="105px" styleName='aon-group-title {style.tittle}'>Cuentas de cotización</g:Label>
		    	<g:HTMLPanel styleName="aon-width-all aon-height-all" debugId="paymetDialogHTMLPanel">
		    		<g:VerticalPanel>
		    			<g:Grid ui:field="cccDataTableHeader" styleName="{style.gridStyle}"></g:Grid>
		    			<g:HTMLPanel>
		    				<hr align="left" noshade="noshade" style="margin-bottom: 10px;border-width: 0.5px;margin-left: 10px;"/>
		    			</g:HTMLPanel>
			    		<g:ScrollPanel ui:field="scrollPanel" styleName="{style.scrollStyle}">
			    			<g:Grid ui:field="cccDataTable"></g:Grid>
			    		</g:ScrollPanel>
			    		<g:HTMLPanel styleName="{style.footerStyle}">
		    				<g:Label ui:field="newAccount" styleName="aon-finding-toolbar-item aon-icon-reset {style.footerElement}">NUEVA</g:Label>
		    			</g:HTMLPanel>
		    		</g:VerticalPanel>
		    	</g:HTMLPanel>
		    </g:VerticalPanel>
		</g:VerticalPanel>
	</g:HTMLPanel>
			
</ui:UiBinder> 

