<ui:UiBinder
    xmlns:ui='urn:ui:com.google.gwt.uibinder'
	xmlns:g='urn:import:com.google.gwt.user.client.ui'>

	<ui:with field='msgs' type='com.esferalia.aon.gwt.payroll.client.i18n.PayrollMessages'/>

    <ui:style>

		.noWorkingColor{
			background-color: salmon;
		}

		.holidayColor{
			background-color: #52ab3c;
		}

		.effectiveColor{
			background-color: #77e1d2;
		}

		.inactivityColor{
			background-color: #71b1e8;
		}

		.dropColor{
			background-color: #733969;
		}

		.strikeColor{
			background-color: #a09c13;
    	}

		.ereColor{
			background-color: #b91257;
		}

		.ereFzaColor{
			background-color: rgba(185, 18, 87, 0.7);
		}

		.ereFzaExonColor{
			background-color: rgba(185, 18, 87, 0.4);
		}

		.peonadasColor{
			background-color: #d692f9;
		}

		.sundayColor{
			background-color: rgb(68, 90, 105);
		}

		.itColor{
			background-color: rgba(255, 0, 0, 0.72);
		}

		.partialityColor{
			background-color: #9c85ee;
		}

		.paidLeaveColor{
			color: black;
			border: 1.5px solid #80bc70 !important;
			background-color: #f6f6f6;
			border-radius: 3px;
		}

		.colorButton{
			border-radius: 8%;
			border: none;
			margin-right: 3px;
			margin-left: 10px;
			padding: 3px;
			height: 10px;
			width: 10px;
		}

	</ui:style>

	<g:HTMLPanel styleName="aon-width-all aon-height-all">

		<table class="aon-width-all aon-height-all" style="padding: 5px;">
			<tr>
				<td>
					<g:Label styleName="{style.colorButton} {style.noWorkingColor}"/>
				</td>
				<td>
					<g:Label text="{msgs.nonWorking}"/>
				</td>
				<td>
					<g:Label ui:field="nonWorkingDays"/>
				</td>
			</tr>
			<tr>
				<td>
					<g:Label styleName="{style.colorButton} {style.effectiveColor}"/>
				</td>
				<td>
					<g:Label text="{msgs.effective}"/>
				</td>
				<td>
					<g:Label ui:field="effectiveDays"/>
				</td>
			</tr>
			<tr>
				<td>
					<g:Label styleName="{style.colorButton} {style.inactivityColor}"/>
				</td>
				<td>
					<g:Label text="{msgs.inactivity}"/>
				</td>
				<td>
					<g:Label ui:field="inactivityDays"/>
				</td>
			</tr>
			<tr>
				<td>
					<g:Label styleName="{style.colorButton} {style.strikeColor}"/>
				</td>
				<td>
					<g:Label text="{msgs.strike}"/>
				</td>
				<td>
					<g:Label ui:field="strikeDays"/>
				</td>
			</tr>
			<tr>
				<td>
					<g:Label styleName="{style.colorButton} {style.ereColor}"/>
				</td>
				<td>
					<g:Label text="{msgs.ere}"/>
				</td>
				<td>
					<g:Label ui:field="ereDays"/>
				</td>
			</tr>
			<tr>
				<td>
					<g:Label styleName="{style.colorButton} {style.ereFzaColor}"/>
				</td>
				<td>
					<g:Label text="{msgs.ereFza}"/>
				</td>
				<td>
					<g:Label ui:field="ereFZADays"/>
				</td>
			</tr>
			<tr>
				<td>
					<g:Label styleName="{style.colorButton} {style.ereFzaExonColor}"/>
				</td>
				<td>
					<g:Label text="{msgs.ereFzaExon}"/>
				</td>
				<td>
					<g:Label ui:field="ereFZAExonDays"/>
				</td>
			</tr>
			<tr>
				<td>
					<g:Label styleName="{style.colorButton} {style.dropColor}"/>
				</td>
				<td>
					<g:Label text="{msgs.absence}"/>
				</td>
				<td>
					<g:Label ui:field="dropDays"/>
				</td>
			</tr>
			<tr>
				<td>
					<g:Label styleName="{style.colorButton} {style.holidayColor}"/>
				</td>
				<td>
					<g:Label text="{msgs.vacations}"/>
				</td>
				<td>
					<g:Label ui:field="holidayDays"/>
				</td>
			</tr>
			<tr>
				<td>
					<g:Label styleName="{style.colorButton} {style.sundayColor}"/>
				</td>
				<td>
					<g:Label text="{msgs.festiveDays}"/>
				</td>
				<td>
					<g:Label ui:field="festiveDays"/>
				</td>
			</tr>
			<tr>
				<td>
					<g:Label styleName="{style.colorButton} {style.itColor}"/>
				</td>
				<td>
					<g:Label text="{msgs.sickLeave}"/>
				</td>
				<td>
					<g:Label ui:field="leaveDays"/>
				</td>
			</tr>
			<tr>
				<td>
					<g:Label styleName="{style.colorButton} {style.partialityColor}"/>
				</td>
				<td>
					<g:Label text="{msgs.partiality}"/>
				</td>
				<td>
					<g:Label ui:field="partialityDays"/>
				</td>
			</tr>
			<tr>
				<td>
					<g:Label styleName="{style.colorButton} {style.peonadasColor}"/>
				</td>
				<td>
					<g:Label text="{msgs.peonadas}"/>
				</td>
				<td>
					<g:Label ui:field="peonadasDays"/>
				</td>
			</tr>
			<tr>
				<td>
					<g:Label styleName="{style.paidLeaveColor} {style.colorButton}"/>
				</td>
				<td>
					<g:Label text="{msgs.paidLeave}"/>
				</td>
				<td>
					<g:Label ui:field="paidLeaveDays"/>
				</td>
			</tr>
		</table>

	</g:HTMLPanel>

</ui:UiBinder>
