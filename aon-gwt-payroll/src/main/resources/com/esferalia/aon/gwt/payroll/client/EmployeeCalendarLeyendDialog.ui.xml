<ui:UiBinder 
    xmlns:ui='urn:ui:com.google.gwt.uibinder'
	xmlns:g='urn:import:com.google.gwt.user.client.ui'
	xmlns:es3='urn:import:com.google.gwt.user.client.ui'
	xmlns:datepicker='urn:import:com.google.gwt.user.datepicker.client'>

    <ui:with field='res'
		type='com.esferalia.aon.gwt.common.client.css.AonResources' />
    
    
	<ui:style type="com.esferalia.aon.gwt.payroll.client.EmployeeCalendarLeyendDialog.MyStyle">

		.noWorkingColor{
			background-color: salmon;
		}

		.inactivityColor{
			background-color: #71b1e8;
		}
		
		.dropColor{
			background-color: #733969;
		}
		
		.strikeColor{
			background-color: #a09c13;
    	}

		.ereColor{
			background-color: #b91257;
		}

		.holidayColor{
			background-color: green;
		}

		.sundayColor{
			background-color: rgb(68, 90, 105);
		}

		.suspensionColor{
			background-color: #b74b17;
		}

		.itColor{
			background-color: rgba(255, 0, 0, 0.72);
		}

		.reductionColor{
			background-color: #065b69;
		}

		.colorButton{
			border-radius: 8%;
			border: none;
			margin-right: 3px;
			padding: 3px;
			height: 10px;
			width: 10px;
		}
		
	</ui:style>

	<g:HTMLPanel styleName="aon-width-all aon-height-all">
	
		<table class="aon-width-all aon-height-all" style="padding: 5px;">
			<tr>
				<td>
					<g:Label>No Laborables</g:Label>
				</td>
				<td>
					<g:Label styleName="{style.colorButton} {style.noWorkingColor}"/>
				</td>
			</tr>
			<tr>
				<td>
					<g:Label>Inactividad</g:Label>
				</td>
				<td>
					<g:Label styleName="{style.colorButton} {style.inactivityColor}"/>
				</td>
			</tr>
			<tr>
				<td>
					<g:Label>Huelga</g:Label>
				</td>
				<td>
					<g:Label styleName="{style.colorButton} {style.strikeColor}"/>
				</td>
			</tr>
			<tr>
				<td>
					<g:Label>ERE</g:Label>
				</td>
				<td>
					<g:Label styleName="{style.colorButton} {style.ereColor}"/>
				</td>
			</tr>
			<tr>
				<td>
					<g:Label>Ausencia</g:Label>
				</td>
				<td>
					<g:Label styleName="{style.colorButton} {style.dropColor}"/>
				</td>
			</tr>
			<tr>
				<td>
					<g:Label>Vacaciones</g:Label>
				</td>
				<td>
					<g:Label styleName="{style.colorButton} {style.holidayColor}"/>
				</td>
			</tr>
			<tr>
				<td>
					<g:Label>Festivos</g:Label>
				</td>
				<td>
					<g:Label styleName="{style.colorButton} {style.sundayColor}"/>
				</td>
			</tr>
			<tr>
				<td>
					<g:Label>Suspensión</g:Label>
				</td>
				<td>
					<g:Label styleName="{style.colorButton} {style.suspensionColor}"/>
				</td>
			</tr>
			<tr>
				<td>
					<g:Label>Baja IT</g:Label>
				</td>
				<td>
					<g:Label styleName="{style.colorButton} {style.itColor}"/>
				</td>
			</tr>
			<tr>
				<td>
					<g:Label>Reducción</g:Label>
				</td>
				<td>
					<g:Label styleName="{style.colorButton} {style.reductionColor}"/>
				</td>
			</tr>
		</table>
			
	</g:HTMLPanel>

</ui:UiBinder>