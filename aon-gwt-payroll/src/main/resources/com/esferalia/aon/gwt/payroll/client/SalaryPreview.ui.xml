<ui:UiBinder xmlns:ui='urn:ui:com.google.gwt.uibinder'
	xmlns:g='urn:import:com.google.gwt.user.client.ui'
	xmlns:employee='urn:import:com.esferalia.aon.gwt.payroll.client'>

	<ui:with field='msgs' type='com.esferalia.aon.gwt.payroll.client.i18n.PayrollMessages'/>

	<ui:style>
		.editor {
		}

		.document {
			margin-top: 5px;
			margin-left: auto;
			margin-right: auto;
			margin-bottom: 15px;
		}
		
	</ui:style>
	<g:DockLayoutPanel unit="PX">
		<g:north size="72"  >

			<g:FlowPanel>

				<g:MenuBar >
					<g:MenuItem text="{msgs.view}">
						<g:MenuBar vertical="true">
							<g:MenuItem ui:field="reduceMenuItem" text="{msgs.reduce}" />
							<g:MenuItem ui:field="enlargeMenuItem" text="{msgs.enlarge}" />
						</g:MenuBar>
					</g:MenuItem>
				</g:MenuBar>
				
				<g:FlowPanel styleName="aon-finding-title-toolbar" >
					<g:HorizontalPanel >
						<g:HTMLPanel styleName="aon-finding-title">
							<g:HTMLPanel styleName="aon-finding-title-internal" >
								<g:Label styleName="aon-outputText" text="{msgs.preview}"/>
							</g:HTMLPanel>
						</g:HTMLPanel>
						<g:HTMLPanel styleName="aon-finding-subtitle">
							<g:HTMLPanel styleName="aon-finding-aubtitle-internal" >
								<g:Label styleName="aon-outputText" text=" "/> 
							</g:HTMLPanel>
						</g:HTMLPanel>
						<g:HorizontalPanel styleName="aon-finding-toolbar">
							<g:HTMLPanel styleName="aon-finding-toolbar-item-group" >
								<g:Button ui:field='printButton' styleName='aon-finding-toolbar-item aon-icon-pdf' text="{msgs.print}" enabled="false"/>
								<g:ListBox ui:field='salaryTypeListBox' styleName=''  />
								<g:ListBox ui:field='dateListBox' styleName=''  />
							</g:HTMLPanel>
						</g:HorizontalPanel>
					</g:HorizontalPanel>
				</g:FlowPanel>				

			</g:FlowPanel>

		</g:north>
		<g:center>
			<g:ScrollPanel styleName="{style.editor}" >
				<g:VerticalPanel styleName="{style.document}">
					<g:HTML styleName="reset" ui:field='container' wordWrap='true' />
				</g:VerticalPanel>
			</g:ScrollPanel>
		</g:center>
	</g:DockLayoutPanel>

</ui:UiBinder>
