<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<ui:UiBinder xmlns:ui='urn:ui:com.google.gwt.uibinder'
	xmlns:g='urn:import:com.google.gwt.user.client.ui'
	xmlns:aon='urn:import:com.esferalia.aon.gwt.common.client.widget'
	xmlns:a='urn:import:com.esferalia.aon.gwt.payroll.client'
	xmlns:p="urn:import:net.aonsolutions.gwt.pdfjs.client" >
	
	<ui:with type="com.esferalia.aon.gwt.common.client.css.AonResources" field="aonResources"></ui:with>

	<ui:Style>
		.center{
			display: flex;
			justify-content: center;
		}
		
		.pl20{
			padding-left: 20px;
		}
		
		.p5{
			padding: 5px;
		}
		
		.widthAll{
			width: 100%
		}
		
		.mt10{
			margin-top: 10px;
		}
		
		.titlePanel{
			padding: 5px 0 5px 15px;
			font-size: 13px;
			background-color: #f4f4f4;
			width: 100%;
			display:flex;
		}
		
		.bold{
			font-weight: bold;
		}
		
		.title{
			font-size: 12px;
			margin-left: 5px;
    		padding-top: 2px;
		}
		
		/* ------------------- Menu Bar ------------------- */
		.menuBar{
			cursor: pointer;
			display: grid;
		}
		
		.flex{
			display: flex;
			align-items: center;
		}
		
		.p5{
			padding: 5px !important;
		}
		
		.h17{
			height: 17px;
		}
		
		.nbr{
			border-right: none !important;
		}
		
	</ui:Style>

	<g:SimpleLayoutPanel>
		<g:SplitLayoutPanel ui:field="splitLayoutPanel">
				<!-- INIT HEADER MENU -->
				<g:north size="25">
					<g:FlowPanel styleName="aon-finding-title-toolbar">
						<g:HorizontalPanel >
							<g:HTMLPanel styleName="aon-finding-title">
								<g:HTMLPanel styleName="aon-finding-title-internal" >
									<g:Label styleName="aon-outputText">Edición Contrato</g:Label>
								</g:HTMLPanel>
							</g:HTMLPanel>
							<g:HTMLPanel styleName="aon-finding-subtitle">
								<g:HTMLPanel styleName="aon-finding-aubtitle-internal" >
									<g:Label styleName="aon-outputText" text=" "/> 
								</g:HTMLPanel>
							</g:HTMLPanel>
							<g:HTMLPanel styleName="aon-finding-toolbar {style.flex}">
								<g:HTMLPanel styleName="aon-finding-toolbar-item-group" >
									<g:Button ui:field='saveContract' styleName='aon-finding-toolbar-item aon-icon-save {style.pl20}' text=" GUARDAR"/>
								</g:HTMLPanel>
								<g:HTMLPanel styleName="aon-finding-toolbar-item-group" >
									<g:Button ui:field='deleteContract' styleName='aon-finding-toolbar-item aon-icon-reset {style.pl20}' text=" BORRAR"/>
								</g:HTMLPanel>
								<g:HTMLPanel styleName="aon-finding-toolbar-item-group" >
									<g:Button ui:field='listEmployees' styleName='aon-finding-toolbar-item aon-icon-cancel {style.pl20}' text=" LISTA"/>
								</g:HTMLPanel>
								<g:HTMLPanel styleName="aon-finding-toolbar-item-group" >
									<g:Button ui:field='exportContract' styleName='aon-finding-toolbar-item aon-icon-pdf {style.pl20}' text=" GENERAR CONTRATO"/>
								</g:HTMLPanel>
								<g:HTMLPanel styleName="aon-finding-toolbar-item-group">
									<g:Button ui:field='afiButton'
										styleName='aon-finding-toolbar-item aon-icon-segsocial-small' text="Cambios AFI"
										enabled="true" />
								</g:HTMLPanel>
								<g:MenuBar styleName="aon-finding-toolbar-item-group {style.h17}">
									<g:MenuItem text="TGSS" ui:field="archivoMenuItem" styleName="aon-finding-toolbar-item aon-icon-segsocial-small {style.bold}">
										<g:MenuBar vertical="true" styleName="{style.p5}">
											<g:MenuItem ui:field='idcButton' styleName='aon-finding-toolbar-item aon-icon-segsocial-small {style.nbr}' text="Informe de Cotizaci&oacute;n IDC" enabled="true" />	
											<g:MenuItem ui:field='taButton' styleName=' aon-finding-toolbar-item aon-icon-segsocial-small {style.nbr}' text="Duplicados de Documentos TA" enabled="true" />	
										</g:MenuBar>
									</g:MenuItem>
								</g:MenuBar>
								<g:HTMLPanel styleName="aon-finding-toolbar-item-group">
									<g:Button debugId='closePdfButton' ui:field='closePdfButton'
										styleName='aon-finding-toolbar-item aon-icon-cancel' text="Cerrar" />
								</g:HTMLPanel>
								<g:HTMLPanel styleName="aon-finding-toolbar-item-group">
									<g:ListBox debugId='zoomListBox' ui:field="zoomListBox" />
								</g:HTMLPanel>
								<g:HTMLPanel styleName="aon-finding-toolbar-item-group">
									<g:Button debugId='downloadButton' ui:field='downloadButton'
										styleName='aon-finding-toolbar-item aon-icon-mail-save' text="Descargar" />	
								</g:HTMLPanel>
							</g:HTMLPanel>
						</g:HorizontalPanel>
					</g:FlowPanel>
				</g:north>
				<!-- END HEADER MENU -->
				<g:center>
					<g:HTMLPanel styleName="{aonResources.css.aonSelector}">
						<g:HTMLPanel styleName="{style.titlePanel}">
							<g:Label styleName="{style.bold}">Contrato : </g:Label>
							<g:Label styleName="{style.title}" ui:field="title"></g:Label>
						</g:HTMLPanel>
						
						<g:TabLayoutPanel ui:field="tabLayOutPanel" barUnit='EM' barHeight='3'>
							<g:tab>
						    	<g:header size='7'>Datos Afiliación</g:header>
						    	<g:HTMLPanel styleName="{style.mt10}">
						    		<g:ScrollPanel ui:field="scrolledPanel" styleName="{style.p5} {style.center}">
										<a:Employee ui:field="employee"/>
									</g:ScrollPanel>
						    	</g:HTMLPanel>
						  	</g:tab>
						  	<g:tab>
						    	<g:customHeader size='7'>
						      		<g:Label>Datos SEPE</g:Label>
						    	</g:customHeader>
						    	<g:HTMLPanel styleName="{style.mt10}">
						    		<g:ScrollPanel ui:field="scrolledPanelContractSpecificData" styleName="{style.p5} {style.center}">
										<a:ContractSpecificData ui:field="contractSpecificData"/>
									</g:ScrollPanel>
						    	</g:HTMLPanel>
						  	</g:tab>
						  	<g:tab>
						    	<g:customHeader size='7'>
						      		<g:Label>Datos Contrato</g:Label>
						    	</g:customHeader>
						    	<g:HTMLPanel styleName="{style.mt10}">
						    		<g:ScrollPanel ui:field="scrolledPanelContractOtherData" styleName="{style.p5} {style.center}">
										<a:ContractOtherData ui:field="contractOtherData"/>
									</g:ScrollPanel>
						    	</g:HTMLPanel>
						  	</g:tab>
						  	<g:tab>
						    	<g:customHeader size='7'>
						      		<g:Label>Clausulas</g:Label>
						    	</g:customHeader>
						    	<g:HTMLPanel styleName="{style.mt10}">
						    		<g:ScrollPanel ui:field="scrolledPanelClauses" styleName="{style.p5} {style.center}">
										<a:ContractClauseUI ui:field="contractClauseUI"/>
									</g:ScrollPanel>
						    	</g:HTMLPanel>
						  	</g:tab>
						  	<g:tab>
						    	<g:customHeader size='7'>
						      		<g:Label>Documentos</g:Label>
						    	</g:customHeader>
						    	<g:HTMLPanel styleName="{style.mt10}">
						    		<g:ScrollPanel ui:field="scrolledPanelAttach" styleName="{style.p5} {style.center}">
										<a:ContractAttachUI ui:field="contractAttachUI"/>
									</g:ScrollPanel>
						    	</g:HTMLPanel>
						  	</g:tab>
						 </g:TabLayoutPanel>
						 <g:ScrollPanel ui:field="scrolledPDFPanel" styleName="{style.p5} {style.center}">
						 	<p:Viewer styleName="reset" ui:field='pdfViewer' />
						 </g:ScrollPanel> 
					 </g:HTMLPanel>
				</g:center>
				<g:south size="15">
					<aon:MinimizePanel ui:field="footPanel" styleName="{aonResources.css.aonSelector}" >
						<g:TabLayoutPanel barHeight="26" barUnit="PX" ui:field="footTabPanel" addStyleNames="aon-pointer-events-auto"/>
					</aon:MinimizePanel>
				</g:south>
			</g:SplitLayoutPanel>
	</g:SimpleLayoutPanel>
	
</ui:UiBinder>