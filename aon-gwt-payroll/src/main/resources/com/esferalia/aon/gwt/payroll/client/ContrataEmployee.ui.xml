
<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<ui:UiBinder xmlns:ui='urn:ui:com.google.gwt.uibinder'
	xmlns:g='urn:import:com.google.gwt.user.client.ui'
	xmlns:c='urn:import:com.esferalia.aon.gwt.common.client.widget'
	xmlns:aon='urn:import:com.esferalia.aon.gwt.common.client.widget.solutions'
	xmlns:a='urn:import:com.esferalia.aon.gwt.payroll.client'
	xmlns:p="urn:import:net.aonsolutions.gwt.pdfjs.client" >
	
	<ui:with type="com.esferalia.aon.gwt.common.client.css.AonResources" field="aonResources"></ui:with>

	<ui:Style type="com.esferalia.aon.gwt.payroll.client.ContrataEmployee.MyStyle">
		.center{
			display: flex;
			justify-content: center;
		}
		
		.pl20{
			padding-left: 20px;
		}
		
		.p5{
			padding: 5px;
		}
		
		.widthAll{
			width: 100%;
		}
		
		.heightAll{
			height: 100%;
		}
		
		.mt10{
			margin-top: 10px;
		}
		
		.titlePanel{
			padding: 5px 0 5px 15px;
			font-size: 13px;
			background-color: #f4f4f4;
			width: 100%;
			display:flex;
		}
		
		.bold{
			font-weight: bold;
		}
		
		.title{
			font-size: 12px;
			margin-left: 5px;
    		padding-top: 2px;
		}
		
		/* ------------------- Menu Bar ------------------- */
		.menuBar{
			cursor: pointer;
			display: grid;
		}
		
		.flex{
			display: flex;
			align-items: center;
		}
		
		.p5{
			padding: 5px !important;
		}
		
		.h17{
			height: 17px;
		}
		
		.nbr{
			border-right: none !important;
		}
		
		.mt50{
			margin-top: 50px !important;
		}
		
		.flex{
			display: flex;
			gap: 5px;
		}
		
		.cmdBtn{
			background-position: center left;
			background-repeat: no-repeat;
			padding-left: 25px !important;
			background-size: contain;
		}
		
		.flexColumn{
			width: 100%;
			height: 100%;
			display: flex;
			flex-direction: column;
		}
		
		.flex1{
			display: flex;
		}
		
		.flexGrow{
			flex-grow: 1;
		}
		
		.loadingPanel{
			display: flex;
			align-items: center;
			animation-name: spin;
			animation-duration: 2500ms;
			animation-iteration-count: infinite;
			animation-timing-function: linear;
		}
		
		@keyframes spin {
		    from {
		        transform:rotate(0deg);
		    }
		    to {
		        transform:rotate(360deg);
		    }
		}
		
		.message{
			display: flex;
			justify-content: center;
			text-transform: uppercase;
			margin-top: 5px 0;
			gap: 5px;
			align-items: center;
		}
		
		.container{
			margin: 0 10px;
		}
		
		.toolbar {
			display: flex;
			flex-direction: column;
			gap: 5px;
		}
		
	</ui:Style>

	<g:SimpleLayoutPanel>
		<g:DockLayoutPanel ui:field="dockLayoutPanel" unit="PX">
			<g:north size="50">
				<g:DeckPanel ui:field="toolbarDeckPanel">
					<aon:AonToolbar ui:field="toolbar" />
					<aon:AonToolbar ui:field="toolbarPDFViewer" />
				</g:DeckPanel>
			</g:north>
			<g:center>
				<g:SplitLayoutPanel ui:field="splitLayoutPanel">
					<g:center>
						<g:DeckPanel ui:field="mainDeckPanel">
							<g:HTMLPanel styleName="{aonResources.css.aonSelector}">
								<g:HTMLPanel ui:field="messageContainer" />
								<g:TabLayoutPanel ui:field="tabLayOutPanel" barUnit='EM' barHeight='3'>
									<g:tab>
								    	<g:header size='7'>Datos Afiliación</g:header>
								    	<g:HTMLPanel styleName="{style.mt10}">
								    		<g:ScrollPanel ui:field="scrolledPanel" styleName="{style.center}">
								    			<a:ContractEmployeeUI ui:field="contractEmployeeUI" />
											</g:ScrollPanel>
								    	</g:HTMLPanel>
								  	</g:tab>
								  	<g:tab>
								    	<g:customHeader size='7'>
								      		<g:Label>Datos SEPE</g:Label>
								    	</g:customHeader>
								    	<g:HTMLPanel styleName="{style.mt10}">
								    		<g:ScrollPanel ui:field="scrolledPanelContractSpecificData" styleName="{style.center} {style.widthAll}">
												<a:ContractSpecificData ui:field="contractSpecificData"/>
											</g:ScrollPanel>
								    	</g:HTMLPanel>
								  	</g:tab>
								  	<g:tab>
								    	<g:customHeader size='7'>
								      		<g:Label>Datos Contrato</g:Label>
								    	</g:customHeader>
								    	<g:HTMLPanel styleName="{style.mt10}">
								    		<g:ScrollPanel ui:field="scrolledPanelContractOtherData" styleName="{style.center}">
												<a:ContractOtherData ui:field="contractOtherData"/>
											</g:ScrollPanel>
								    	</g:HTMLPanel>
								  	</g:tab>
								  	<g:tab>
								    	<g:customHeader size='7'>
								      		<g:Label>Clausulas</g:Label>
								    	</g:customHeader>
								    	<g:HTMLPanel styleName="{style.mt10}">
								    		<g:ScrollPanel ui:field="scrolledPanelClauses" styleName="{style.center}">
												<a:ContractClauseUI ui:field="contractClauseUI"/>
											</g:ScrollPanel>
								    	</g:HTMLPanel>
								  	</g:tab>
								  	<g:tab>
								    	<g:customHeader size='7'>
								      		<g:Label>Documentos</g:Label>
								    	</g:customHeader>
								    	<g:HTMLPanel styleName="{style.mt10}">
								    		<g:ScrollPanel ui:field="scrolledPanelAttach" styleName="{style.center}">
												<a:ContractAttachUI ui:field="contractAttachUI"/>
											</g:ScrollPanel>
								    	</g:HTMLPanel>
								  	</g:tab>
								  	<g:tab>
								    	<g:customHeader size='7'>
								      		<g:Label>Nóminas</g:Label>
								    	</g:customHeader>
								    	<g:HTMLPanel styleName="{style.mt10}">
								    		<g:SimpleLayoutPanel styleName="{style.widthAll} {style.heightAll}">
								    			<a:EmployeeSalary ui:field="employeeSalary"/>
								    		</g:SimpleLayoutPanel>
								    	</g:HTMLPanel>
								  	</g:tab>
								  	<g:tab>
								    	<g:customHeader size='7'>
								      		<g:Label>Calendario</g:Label>
								    	</g:customHeader>
								    	<g:HTMLPanel styleName="{style.mt10}">
								    		<a:EmployeeCalendarDraftNew ui:field="employeeCalendar" />
								    	</g:HTMLPanel>
								  	</g:tab>
								  	<g:tab>
								    	<g:customHeader size='7'>
								      		<g:Label>IRPF</g:Label>
								    	</g:customHeader>
								    	<g:HTMLPanel styleName="{style.mt10}">
								    		<a:EmployeeContractIrpf ui:field="employeeContractIrpf" />
								    	</g:HTMLPanel>
								  	</g:tab>
								  	<g:tab>
								    	<g:customHeader size='7'>
								      		<g:Label>Mod 145</g:Label>
								    	</g:customHeader>
								    	<g:HTMLPanel styleName="{style.mt10}">
								    		<a:Mod145 ui:field="mod145" />
								    	</g:HTMLPanel>
								  	</g:tab>
								 </g:TabLayoutPanel>
							</g:HTMLPanel>
							
							<g:HTMLPanel styleName="{aonResources.css.aonSelector}">
								<g:HTMLPanel ui:field="messagePDFContainer" />
								<g:SimpleLayoutPanel ui:field="scrolledPDFPanel" styleName="{style.center}">
									<g:HTMLPanel styleName="{style.mt10} {style.center}">
								 		<p:FullViewer styleName="reset" ui:field='pdfViewer' />
							 		</g:HTMLPanel>
								</g:SimpleLayoutPanel> 
							 </g:HTMLPanel>
						</g:DeckPanel>
					</g:center>
					<g:south size="17">
						<aon:AonMinimizePanel ui:field="footPanel" styleName="{aonResources.css.aonSelector} aon-EmployeeTree-Events" >
							<g:TabLayoutPanel barHeight="26" barUnit="PX" ui:field="footTabPanel" addStyleNames="aon-pointer-events-auto"/>
						</aon:AonMinimizePanel>
					</g:south>
				</g:SplitLayoutPanel>
			</g:center>
		</g:DockLayoutPanel>
	</g:SimpleLayoutPanel>
	
</ui:UiBinder>