<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<ui:UiBinder xmlns:ui='urn:ui:com.google.gwt.uibinder'
	xmlns:g='urn:import:com.google.gwt.user.client.ui'
	xmlns:aon='urn:import:com.esferalia.aon.gwt.common.client.widget'
	xmlns:a='urn:import:com.esferalia.aon.gwt.payroll.client' >
	
	<ui:with type="com.esferalia.aon.gwt.common.client.css.AonResources" field="aonResources"></ui:with>

	<ui:Style>
		.center{
			display: flex;
			justify-content: center;
		}
		
		.pl20{
			padding-left: 20px;
		}
		
		.p5{
			padding: 5px;
		}
		
		.widthAll{
			width: 100%
		}
		
		.mt10{
			margin-top: 10px;
		}
		
	</ui:Style>

	<g:SimpleLayoutPanel>
		<g:SplitLayoutPanel ui:field="splitLayoutPanel">
				<!-- INIT HEADER MENU -->
				<g:north size="25">
					<g:FlowPanel styleName="aon-finding-title-toolbar">
						<g:HorizontalPanel >
							<g:HTMLPanel styleName="aon-finding-title">
								<g:HTMLPanel styleName="aon-finding-title-internal" >
									<g:Label styleName="aon-outputText">Contrat@ - Edición Contrato</g:Label>
								</g:HTMLPanel>
							</g:HTMLPanel>
							<g:HTMLPanel styleName="aon-finding-subtitle">
								<g:HTMLPanel styleName="aon-finding-aubtitle-internal" >
									<g:Label styleName="aon-outputText" text=" "/> 
								</g:HTMLPanel>
							</g:HTMLPanel>
							<g:HorizontalPanel styleName="aon-finding-toolbar">
								<g:HTMLPanel styleName="aon-finding-toolbar-item-group" >
									<g:Button ui:field='saveContract' styleName='aon-finding-toolbar-item aon-icon-save {style.pl20}' text=" GUARDAR"/>
								</g:HTMLPanel>
								<g:HTMLPanel styleName="aon-finding-toolbar-item-group" >
									<g:Button ui:field='listEmployees' styleName='aon-finding-toolbar-item aon-icon-cancel {style.pl20}' text=" LISTA"/>
								</g:HTMLPanel>
							</g:HorizontalPanel>
						</g:HorizontalPanel>
					</g:FlowPanel>
				</g:north>
				<!-- END HEADER MENU -->
				<g:center>
					<g:HTMLPanel styleName="{aonResources.css.aonSelector}">
						<g:TabLayoutPanel ui:field="tabLayOutPanel" barUnit='EM' barHeight='3'>
							<g:tab>
						    	<g:header size='7'>Contrato/Persona</g:header>
						    	<g:HTMLPanel styleName="{style.mt10}">
						    		<g:ScrollPanel ui:field="scrolledPanel" styleName="{style.p5} {style.center}">
										<a:Employee ui:field="employee"/>
									</g:ScrollPanel>
						    	</g:HTMLPanel>
						    	
						  	</g:tab>
						  	<g:tab>
						    	<g:customHeader size='7'>
						      		<g:Label>Otros Datos Contrato</g:Label>
						    	</g:customHeader>
						    	<g:HTMLPanel styleName="{style.mt10}">
						    		<g:ScrollPanel ui:field="scrolledPanelContractOtherData" styleName="{style.p5} {style.center}">
										<a:ContractOtherData ui:field="contractOtherData"/>
									</g:ScrollPanel>
						    	</g:HTMLPanel>
						  	</g:tab>
						  	<g:tab>
						    	<g:customHeader size='7'>
						      		<g:Label>Clausulas / Adjuntos</g:Label>
						    	</g:customHeader>
						    	<g:HTMLPanel styleName="{style.mt10}">
						    		<g:ScrollPanel ui:field="scrolledPanelClausesAndAttach" styleName="{style.p5} {style.center}">
										<a:ContractClauseAndAttach ui:field="contractClauseAndAttach"/>
									</g:ScrollPanel>
						    	</g:HTMLPanel>
						  	</g:tab>
						 </g:TabLayoutPanel>
					 </g:HTMLPanel>
				</g:center>
				<g:south size="15">
					<aon:MinimizePanel ui:field="footPanel" styleName="{aonResources.css.aonSelector}" >
						<g:TabLayoutPanel barHeight="26" barUnit="PX" ui:field="footTabPanel" addStyleNames="aon-pointer-events-auto"/>
					</aon:MinimizePanel>
				</g:south>
			</g:SplitLayoutPanel>
	</g:SimpleLayoutPanel>
	
</ui:UiBinder>