<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<ui:UiBinder xmlns:ui='urn:ui:com.google.gwt.uibinder'
	xmlns:g='urn:import:com.google.gwt.user.client.ui'
	xmlns:aon='urn:import:com.esferalia.aon.gwt.common.client.widget'
	xmlns:a='urn:import:com.esferalia.aon.gwt.payroll.client'
	xmlns:p="urn:import:net.aonsolutions.gwt.pdfjs.client" >
	
	<ui:with type="com.esferalia.aon.gwt.common.client.css.AonResources" field="aonResources"></ui:with>

	<ui:Style>
		.center{
			display: flex;
			justify-content: center;
		}
		
		.pl20{
			padding-left: 20px;
		}
		
		.p5{
			padding: 5px;
		}
		
		.widthAll{
			width: 100%
		}
		
		.mt10{
			margin-top: 10px;
		}
		
		.titlePanel{
			padding: 5px 0 5px 15px;
			font-size: 13px;
			background-color: #f4f4f4;
			width: 100%;
			display:flex;
		}
		
		.bold{
			font-weight: bold;
		}
		
		.title{
			font-size: 12px;
			margin-left: 5px;
    		padding-top: 2px;
		}
		
		/* ------------------- Menu Bar ------------------- */
		.menuBar{
			cursor: pointer;
			display: grid;
		}
		
		.flex{
			display: flex;
			align-items: center;
		}
		
		.p5{
			padding: 5px !important;
		}
		
		.h17{
			height: 17px;
		}
		
		.nbr{
			border-right: none !important;
		}
		
		.mt50{
			margin-top: 50px !important;
		}
		
	</ui:Style>

	<g:SimpleLayoutPanel>
		<g:DockLayoutPanel ui:field="dockLayoutPanel">
			<g:center>
				<g:SplitLayoutPanel ui:field="splitLayoutPanel">
					<g:center>
						<g:HTMLPanel styleName="{style.mt50} {aonResources.css.aonSelector}">
							<!-- g:HTMLPanel styleName="{style.titlePanel}">
								<g:Label styleName="{style.bold}">Contrato : </g:Label>
								<g:Label styleName="{style.title}" ui:field="title"></g:Label>
							</g:HTMLPanel -->
							
							<g:TabLayoutPanel ui:field="tabLayOutPanel" barUnit='EM' barHeight='3'>
								<g:tab>
							    	<g:header size='7'>Datos Afiliación</g:header>
							    	<g:HTMLPanel styleName="{style.mt10}">
							    		<g:ScrollPanel ui:field="scrolledPanel" styleName="{style.p5} {style.center}">
											<a:Employee ui:field="employee"/>
										</g:ScrollPanel>
							    	</g:HTMLPanel>
							  	</g:tab>
							  	<g:tab>
							    	<g:customHeader size='7'>
							      		<g:Label>Datos SEPE</g:Label>
							    	</g:customHeader>
							    	<g:HTMLPanel styleName="{style.mt10}">
							    		<g:ScrollPanel ui:field="scrolledPanelContractSpecificData" styleName="{style.p5} {style.center}">
											<a:ContractSpecificData ui:field="contractSpecificData"/>
										</g:ScrollPanel>
							    	</g:HTMLPanel>
							  	</g:tab>
							  	<g:tab>
							    	<g:customHeader size='7'>
							      		<g:Label>Datos Contrato</g:Label>
							    	</g:customHeader>
							    	<g:HTMLPanel styleName="{style.mt10}">
							    		<g:ScrollPanel ui:field="scrolledPanelContractOtherData" styleName="{style.p5} {style.center}">
											<a:ContractOtherData ui:field="contractOtherData"/>
										</g:ScrollPanel>
							    	</g:HTMLPanel>
							  	</g:tab>
							  	<g:tab>
							    	<g:customHeader size='7'>
							      		<g:Label>Clausulas</g:Label>
							    	</g:customHeader>
							    	<g:HTMLPanel styleName="{style.mt10}">
							    		<g:ScrollPanel ui:field="scrolledPanelClauses" styleName="{style.p5} {style.center}">
											<a:ContractClauseUI ui:field="contractClauseUI"/>
										</g:ScrollPanel>
							    	</g:HTMLPanel>
							  	</g:tab>
							  	<g:tab>
							    	<g:customHeader size='7'>
							      		<g:Label>Documentos</g:Label>
							    	</g:customHeader>
							    	<g:HTMLPanel styleName="{style.mt10}">
							    		<g:ScrollPanel ui:field="scrolledPanelAttach" styleName="{style.p5} {style.center}">
											<a:ContractAttachUI ui:field="contractAttachUI"/>
										</g:ScrollPanel>
							    	</g:HTMLPanel>
							  	</g:tab>
							  	<g:tab>
							    	<g:customHeader size='7'>
							      		<g:Label>Bonificaciones</g:Label>
							    	</g:customHeader>
							    	<g:HTMLPanel styleName="{style.mt10}">
							    		<g:ScrollPanel ui:field="scrolledPanelBonus" styleName="{style.p5} {style.center}">
											<a:ContractBonusUI ui:field="contractBonusUI"/>
										</g:ScrollPanel>
							    	</g:HTMLPanel>
							  	</g:tab>
							 </g:TabLayoutPanel>
							 <g:ScrollPanel ui:field="scrolledPDFPanel" styleName="{style.p5} {style.center}">
							 	<p:Viewer styleName="reset" ui:field='pdfViewer' />
							 </g:ScrollPanel> 
						 </g:HTMLPanel>
					</g:center>
					<g:south size="15">
						<aon:MinimizePanel ui:field="footPanel" styleName="{aonResources.css.aonSelector}" >
							<g:TabLayoutPanel barHeight="26" barUnit="PX" ui:field="footTabPanel" addStyleNames="aon-pointer-events-auto"/>
						</aon:MinimizePanel>
					</g:south>
				</g:SplitLayoutPanel>
			</g:center>
		</g:DockLayoutPanel>
	</g:SimpleLayoutPanel>
	
</ui:UiBinder>