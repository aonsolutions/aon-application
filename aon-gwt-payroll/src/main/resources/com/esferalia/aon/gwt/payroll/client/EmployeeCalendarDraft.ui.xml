		.blockStyle{
			background-color: transparent;
			color: #aaa;
		}

		.upperMenuStyle{
			padding-left: 15px;
    		padding-bottom: 3px;
    		padding-right: 3px;
    		padding-top: 15px;
		}

		.upperRightMenuStyle{
			right: 10px;
