		.blockStyle{
			background-color: transparent;
			color: #aaa;
		}
		
		.upperMenuStyle{
			padding-left: 15px;
    		padding-bottom: 3px;
    		padding-right: 3px;
    		padding-top: 15px;
		}

		.upperRightMenuStyle{
			right: 10px;
    		position: absolute;
		}

		.cursorPointer{
			cursor: pointer;
		}

		.paddingLabels{
			font-weight: bold;
			padding: 5px 10px 0px 0px;
		}

		.borderButtonUpperMenuStyle{
			border: none;
		}

		.imagenButtonUpperMenuStyle{
			height: 17px;
		}

		.paddingEraseButtonUpperMenuStyle{
			padding-left: 7px;
    		padding-right: 16px;
		}

		.paddingLeyendButtonUpperMenuStyle{
			padding-left: 7px;
		}

		.typeButtonUpperMenuStyle{
    		border-radius: 8%;
			border: none;
			margin-right: 3px;
			padding: 3px;
			color:white;
			font-weight: bold;
		}

		.noWorkingColor{
			background-color: salmon;
		}

		.holidayColor{
			background-color: green;
		}

		.strikeColor{
			background-color: #a09c13;
    	}

		.ereColor{
			background-color: #b91257;
		}

		.inactivityColor{
			background-color: #71b1e8;
		}
	
		.dropColor{
			background-color: #733969;
		}

		.peonadasColor{
			background-color: #d692f9;
		}

		.tableStyle {
			border-collapse: collapse;
			margin-left: 0.8em;
			width: 100%;
		}
		
		.tableStyle td {
			text-align: center;
			border-bottom: 1px solid #ddd;
			font-family: Arial, Helvetica, sans-serif;
		}
		
		.cabeceraStyle {
			font-weight: bold;
