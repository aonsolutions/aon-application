<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
	xmlns:g='urn:import:com.google.gwt.user.client.ui' xmlns:i="urn:import:com.vaadin.polymer.iron.widget"
	xmlns:p="urn:import:com.vaadin.polymer.paper.widget" xmlns:a='urn:import:com.esferalia.aon.gwt.common.client.widget'>

	<ui:with field='res'
		type='com.esferalia.aon.gwt.common.client.css.AonResources' />

	<ui:style
		type="com.esferalia.aon.gwt.payroll.client.EmployeeCalendarDraft.MyStyle">
		.tableStyle {
			border-collapse: collapse;
			margin-left: 0.8em;
			width: 100%;
		}
		
		.tableStyle td {
			text-align: center;
			border-bottom: 1px solid #ddd;
			font-family: Arial, Helvetica, sans-serif;
		}
		
		.cabeceraStyle {
			font-weight: bold;
			padding-right: 0.65em;
			padding-left: 0.65em;
			padding-top: 0.5em;
			padding-bottom: 0.5em;
			margin: 6px;
		}
		
		.labelDiasStyle {
			padding-left: 15px;
			padding-bottom: 3px;
			padding-right: 3px;
			padding-top: 15px;
		}
		
		.labelDiasStyle2 {
			padding-left: 15px;
			padding-bottom: 3px;
			padding-top: 5px;
			padding-right: 85px;
		}
		
		.doubleBoxStyle {
			width: 10px;
			text-align: center;
			color: black;
			background-color: #eee;
			font: 12px/1.333 "arial", "lucida Grande", "Trebuchet MS", sans-serif;
		}
		
		.doubleBoxDisableStyle {
			border: none;
			width: 10px;
			color: black;
			text-align: center;
			background-color: #eee;
			font: 12px/1.333 "arial", "lucida Grande", "Trebuchet MS", sans-serif;
		}
		
		.doubleBoxDisableStyle2 {
			border: none;
			width: 10px;
			color: black;
			text-align: center;
			background-color: white;
			font: 12px/1.333 "arial", "lucida Grande", "Trebuchet MS", sans-serif;
		}
		
		.doubleBoxLargeStyle {
			width: 100% !important;
			font: 11px/1.333 "arial", "lucida Grande", "Trebuchet MS", sans-serif !important;
		}

		.isSelectedStyle {
			background-color: #166ef3 !important;
			color: #ffffff !important;
			border-radius: 0px !important;
		}
		
		.sundayStyle {
			background-color: salmon;
			border-radius: 15px;
			padding: 3px;
			color: #ffffff;
		}
		
		.holidayStyle {
			background-color: #52ab3c;
			border-radius: 15px;
			padding: 3px;
			color: #ffffff;
		}
		
		.ereStyle {
			background-color: #b91257;
			border-radius: 15px;
			padding: 3px;
			color: #ffffff;
		}
		
		.strikeStyle {
			background-color: #a09c13;
			border-radius: 15px;
			padding: 3px;
			color: #ffffff;
		}
		
		.reductionStyle {
			background-color: #065b69;
			color: #ffffff;
			margin-top: 0px;
		}
		
		.dropStyle {
			background-color: #733969;
			border-radius: 15px;
			padding: 3px;
			color: #ffffff;
			
		}
		
		.suspensionStyle {
			background-color: #b74b17;
			color: #ffffff;
			margin-top: 0px;
		}
		
		.itStyle {
			background-color: rgba(255, 0, 0, 0.72);
			color: #ffffff;
			margin-top: 0px;
		}
		
		.cellStyle {
			padding: 3px;
		}
		
		.cellStyle1 {
			padding: 0.1px;
		}
		
		.year {
			font-size: 30px;
			color: #FF704D;
			padding-left: 28px;
			padding-top: 2px;
		}
		
		.optionButtons {
			width: 30px;
			height: 25px;
			cursor: pointer;
			border: none;
		}
		
		.optionButtonsLeft {
			margin-top: 8px;
			margin-left: 8px;
		}
		
		.optionButtonsRight {
			margin-top: 8px;
		}
		
		.expandButtonStyle {
			margin-top: 0px;
		}
		
		.iconLeyendStyle {
			position: absolute;
			right: 115px;
		}
		
		.iconEraseStyle {
			position: absolute;
			right: 25px;
		}
		
		.mesesImparesStyle {
			background-color: #eee;
		}
		
		.ocultarHorasStyle {
			display: none;
		}
		
		.fondoBlanco {
			background-color: white;
		}
		
		.noselect {
			-webkit-touch-callout: none; /* iOS Safari */
			-webkit-user-select: none; /* Safari */
			-khtml-user-select: none; /* Konqueror HTML */
			-moz-user-select: none; /* Firefox */
			-ms-user-select: none; /* Internet Explorer/Edge */
			user-select: none; /* Non-prefixed version, currently
				                                  supported by Chrome and Opera */
		}
		
		.scrollBody {
			overflow-y: scroll;
		}
		
		.dialogBoxStyle {
			width: 230px;
			outline: none;
			position: absolute;
			box-sizing: border-box;
			left: 283px;
			top: 80px;
			max-width: 100%;
			max-height: 100%;
			padding: 0px;
			margin-top: 0px;
		}
		
		.suggestBoxStyle {
			width: 30%;
			margin-left: 5px;
			margin-top: 0px;
			font-size: 1em;
		}
		
		.labelHourStyle {
			margin-top: 0px;
		}
		
		.labelHourStyleL {
			padding-right: 26px;
		}
		
		.labelHourStyleM {
			padding-right: 19px;
		}
		
		.labelHourStyleX {
			padding-right: 2px;
		}
		
		.labelHourStyleJ {
			padding-right: 19px;
		}
		
		.labelHourStyleV {
			padding-right: 16px;
		}
		
		.labelHourStyleS {
			padding-right: 16px;
		}
		
		.labelHourStyleD {
			padding-right: 7px;
		}
		
		.ocultarDivStyle {
			display: none;
		}
		
		.divWidthStyle {
			margin-top: 1px;
			padding-bottom: 5px;
		}
		
		.onChange {
			background-color: rgba(255, 255, 0, 0.38);
		}
		
		@external gwt-Selector;
		@external gwt-SuggestBoxPopup;
		.gwt-SuggestBoxPopup {
			z-index: 105;
		}
		
		.gwt-Selector .gwt-SuggestBoxPopup {
			z-index: 105;
			height: inherit;
		}
		
		.setOutOfContractStyle {
			color: #aaa;
		}
		
		hr {
			margin-top: 10px;
			margin-bottom: 10px;
		}
		
		.scrollStyle {
			position: absolute !important;
			left: 5px;
			right: 5px;
			top: 100px;
			bottom: 0;
			width: 100%;
		}
		
		.dialogLeyendLabel {
			padding-left: 0px;
			padding-bottom: 0px;
			padding-right: 0px;
		}
		
		.okDialogLeyendButton {
			margin-top: 0px;
			margin-bottom: 0px;
			margin-left: 0px;
			margin-right: 8px;
		}
		
		.reductionMarginDialogLeyend {
			margin-left: 33px;
		}
		
		.fechaDialogZIndex {
			z-index: 105;
		}
		
		.dateBoxMarginDialogHour{
			margin-left: 15px;
		}
		
		.marginTopCloseDialog{
			margin-top: 0px !important;
			padding-left: 0px !important;
			padding-right: 0px !important;
			padding-top: 0px !important;
			padding-bottom: 5px !important;
		}
		
		</ui:style>

	<g:DockLayoutPanel unit="PX">
		<g:north size="55">
			<g:FlowPanel>
				<g:MenuBar>
					<g:MenuItem text="Archivo">
						<g:MenuBar vertical="true">
							<g:MenuItem ui:field="diaNoLaborable" text="Añadir día(s) no laborables" />
								<g:MenuItem ui:field="diaVacaciones" text="Añadir día(s) vacaciones" />
								<g:MenuItem ui:field="diaHuelga" text="Añadir día(s) huelga" />
								<g:MenuItem ui:field="diaEre" text="Añadir día(s) ERE" />
								<g:MenuItem ui:field="diaAusencia" text="Añadir día(s) Ausencia" />			
							<g:MenuItem styleName="gwt-MenuItemSeparator">
								<div class="menuSeparatorInner"></div>
							</g:MenuItem>
							<g:MenuItem ui:field="borrarEvento" text="Borrar evento(s)" />
						</g:MenuBar>
					</g:MenuItem>
					<g:MenuItem text="Edicion">
						<g:MenuBar vertical="true">
							<g:MenuItem ui:field="selectAlldays" text="Seleccionar todo" />
							<g:MenuItem ui:field="selectUntill" text="Seleccionar hasta" />
						</g:MenuBar>
					</g:MenuItem>
					<g:MenuItem ui:field="horasButton" text="Horas">
					</g:MenuItem>
					<g:MenuItem text="Ver">
						<g:MenuBar vertical="true">
							<g:MenuItem ui:field="horasMenuItem" text="Ocultar horas" />
						</g:MenuBar>
					</g:MenuItem>
				</g:MenuBar>

				<g:FlowPanel styleName="aon-finding-title-toolbar">
					<g:HorizontalPanel>
						<g:HTMLPanel styleName="aon-finding-title">
							<g:HTMLPanel styleName="aon-finding-title-internal">
								<g:Label styleName="aon-outputText">Edici&oacute;n</g:Label>
							</g:HTMLPanel>
						</g:HTMLPanel>
						<g:HTMLPanel styleName="aon-finding-subtitle">
							<g:HTMLPanel styleName="aon-finding-subtitle-internal">
								<g:Label styleName="aon-outputText"></g:Label>
							</g:HTMLPanel>
						</g:HTMLPanel>
						<g:HorizontalPanel styleName="aon-finding-toolbar">
							<g:HTMLPanel styleName="aon-finding-toolbar-item-group">
								<g:Button debugId='undoAllButton' ui:field='undoAllButton'
									styleName='aon-finding-toolbar-item {res.css.aonIconUndoAll}'
									enabled="false" />
								<g:Button ui:field="undoButton"
									styleName='aon-finding-toolbar-item aon-icon-undo' enabled="false" />
								<g:Button ui:field='redoButton'
									styleName="aon-finding-toolbar-item aon-icon-redo" enabled="false" />
							</g:HTMLPanel>
						</g:HorizontalPanel>
						<g:HTMLPanel styleName="aon-finding-toolbar-item-group">
							<g:Button ui:field='saveButton'
								styleName='aon-finding-toolbar-item aon-icon-accept' text="GUARDAR"
								enabled="false" />
						</g:HTMLPanel>
					</g:HorizontalPanel>
				</g:FlowPanel>

			</g:FlowPanel>
		</g:north>
		<g:center>
			<g:HTMLPanel>
				
			    <!-- Dialogo para seleccionar que tipo de ausencia va a tener -->
			    <p:PaperDialog ui:field="dialogAusencia" styleName="{style.dialogBoxStyle}"
					modal="true" entryAnimation="scale-up-animation" exitAnimation="fade-out-animation"
					withBackdrop="true">
					<a:CustomDialogBar ui:field="customDialogBarDrop" styleName="{style.marginTopCloseDialog}" caption="Tipo ausencia:"/>
					<g:HTMLPanel ui:field="confirmDropContent"></g:HTMLPanel>
					<HTMLPanel>
					    <i:IronLabel>Tipo:</i:IronLabel>
				        <g:ListBox ui:field="dropMenu"/>
			        </HTMLPanel>
			        <HTMLPanel class="buttons">
						<p:PaperButton ui:field="dialogDropCancel" attributes="dialog-dismiss">Cancel</p:PaperButton>
						<p:PaperButton ui:field="dialogDropOk" attributes="dialog-confirm">OK</p:PaperButton>
					</HTMLPanel>
			    </p:PaperDialog>  
			    
				<!-- Dialogo para seleccionar fecha hasta... -->
				<p:PaperDialog ui:field="dialogUntill" styleName="{style.dialogBoxStyle}"
					modal="true" entryAnimation="scale-up-animation" exitAnimation="fade-out-animation"
					withBackdrop="true">
					<a:CustomDialogBar ui:field="customDialogBarUntill" styleName="{style.marginTopCloseDialog}" caption="Hasta:"/>
					<g:HTMLPanel ui:field="confirmUntillContent"></g:HTMLPanel>
					<g:HTMLPanel>
						<i:IronLabel>
							Fecha final:
							<a:DateBoxEx ui:field="fechaFinDialogHour" styleName="{style.dateBoxMarginDialogHour}"></a:DateBoxEx>
						</i:IronLabel>
					</g:HTMLPanel>
					<hr />
					<HTMLPanel class="buttons">
						<p:PaperButton ui:field="dialogUntillCancel"
							attributes="dialog-dismiss" styleName="{style.okDialogLeyendButton}">Cancel</p:PaperButton>
						<p:PaperButton ui:field="dialogUntillOk" attributes="dialog-confirm"
										styleName="{style.okDialogLeyendButton}">OK</p:PaperButton>
					</HTMLPanel>
				</p:PaperDialog>

				<!-- Dialogo para seleccionar las horas que se le va a asignar a cada dia de la semana -->
				<p:PaperDialog ui:field="dialogHoras" styleName="{style.dialogBoxStyle}"
					modal="true" entryAnimation="scale-up-animation" exitAnimation="fade-out-animation"
					withBackdrop="true">
					<a:CustomDialogBar ui:field="customDialogBarHour" styleName="{style.marginTopCloseDialog}" caption="Horas"/>
					<g:HTMLPanel ui:field="confirmContent"></g:HTMLPanel>
					<g:HTMLPanel ui:field="bloqueLunes" styleName="{style.divWidthStyle}">
						<i:IronLabel styleName="{style.labelHourStyle} {style.labelHourStyleL}">Lunes:</i:IronLabel>
						<g:SuggestBox ui:field="lunesOpt" styleName="{style.suggestBoxStyle}" />
						<p:PaperIconButton icon="icons:expand-more"
							styleName="{style.optionButtons} {style.expandButtonStyle}"
							ui:field="expandHourBtnL" />
					</g:HTMLPanel>
					<g:HTMLPanel ui:field="bloqueMartes" styleName="{style.divWidthStyle}">
						<i:IronLabel styleName="{style.labelHourStyle} {style.labelHourStyleM}">Martes:</i:IronLabel>
						<g:SuggestBox ui:field="martesOpt" styleName="{style.suggestBoxStyle}"></g:SuggestBox>
						<p:PaperIconButton icon="icons:expand-more"
							styleName="{style.optionButtons} {style.expandButtonStyle}"
							ui:field="expandHourBtnM" />
					</g:HTMLPanel>
					<g:HTMLPanel ui:field="bloqueMiercoles" styleName="{style.divWidthStyle}">
						<i:IronLabel styleName="{style.labelHourStyle} {style.labelHourStyleX}">Miércoles:</i:IronLabel>
						<g:SuggestBox ui:field="miercolesOpt" styleName="{style.suggestBoxStyle}"></g:SuggestBox>
						<p:PaperIconButton icon="icons:expand-more"
							styleName="{style.optionButtons} {style.expandButtonStyle}"
							ui:field="expandHourBtnX" />
					</g:HTMLPanel>
					<g:HTMLPanel ui:field="bloqueJueves" styleName="{style.divWidthStyle}">
						<i:IronLabel styleName="{style.labelHourStyle} {style.labelHourStyleJ}">Jueves:</i:IronLabel>
						<g:SuggestBox ui:field="juevesOpt" styleName="{style.suggestBoxStyle}"></g:SuggestBox>
						<p:PaperIconButton icon="icons:expand-more"
							styleName="{style.optionButtons} {style.expandButtonStyle}"
							ui:field="expandHourBtnJ" />
					</g:HTMLPanel>
					<g:HTMLPanel ui:field="bloqueViernes" styleName="{style.divWidthStyle}">
						<i:IronLabel styleName="{style.labelHourStyle} {style.labelHourStyleV}">Viernes:</i:IronLabel>
						<g:SuggestBox ui:field="viernesOpt" styleName="{style.suggestBoxStyle}"></g:SuggestBox>
						<p:PaperIconButton icon="icons:expand-more"
							styleName="{style.optionButtons} {style.expandButtonStyle}"
							ui:field="expandHourBtnV" />
					</g:HTMLPanel>
					<g:HTMLPanel ui:field="bloqueSabado" styleName="{style.divWidthStyle}">
						<i:IronLabel styleName="{style.labelHourStyle} {style.labelHourStyleS}">Sábado:</i:IronLabel>
						<g:SuggestBox ui:field="sabadoOpt" styleName="{style.suggestBoxStyle}"></g:SuggestBox>
						<p:PaperIconButton icon="icons:expand-more"
							styleName="{style.optionButtons} {style.expandButtonStyle}"
							ui:field="expandHourBtnS" />
					</g:HTMLPanel>
					<g:HTMLPanel ui:field="bloqueDomingo" styleName="{style.divWidthStyle}">
						<i:IronLabel styleName="{style.labelHourStyle} {style.labelHourStyleD}">Domingo:</i:IronLabel>
						<g:SuggestBox ui:field="domingoOpt" styleName="{style.suggestBoxStyle}"></g:SuggestBox>
						<p:PaperIconButton icon="icons:expand-more"
							styleName="{style.optionButtons} {style.expandButtonStyle}"
							ui:field="expandHourBtnD" />
					</g:HTMLPanel>
					<HTMLPanel class="buttons">
						<p:PaperButton ui:field="dialogCancel" attributes="dialog-dismiss">Cancel</p:PaperButton>
						<p:PaperButton ui:field="dialogOk" attributes="dialog-confirm">OK</p:PaperButton>
					</HTMLPanel>
				</p:PaperDialog>

				<!-- Dialogo informativo para mostrar la leyenda -->
				<p:PaperDialog ui:field="dialogInfo" modal="true"
					entryAnimation="scale-up-animation" exitAnimation="fade-out-animation"
					withBackdrop="true">
					<a:CustomDialogBar ui:field="customDialogBarInformation" styleName="{style.marginTopCloseDialog}" caption="Leyenda"/>
					<g:HTMLPanel>
						<i:IronLabel>
							<p:PaperButton
								styleName="{style.cellStyle} {style.holidayStyle} {style.dialogLeyendLabel}"></p:PaperButton>
							Vacaciones
						</i:IronLabel>
						<i:IronLabel>
							<p:PaperButton
								styleName="{style.cellStyle} {style.strikeStyle} {style.dialogLeyendLabel}"></p:PaperButton>
							Huelga
						</i:IronLabel>
						<i:IronLabel>
							<p:PaperButton
								styleName="{style.cellStyle} {style.sundayStyle} {style.dialogLeyendLabel}"></p:PaperButton>
							NL/Festivos
						</i:IronLabel>
						<i:IronLabel>
							<p:PaperButton
								styleName="{style.cellStyle} {style.ereStyle} {style.dialogLeyendLabel}"></p:PaperButton>
							ERE
						</i:IronLabel>
					</g:HTMLPanel>
					<g:HTMLPanel>
					    <i:IronLabel>
							<p:PaperButton
								styleName="{style.cellStyle} {style.dropStyle} {style.dialogLeyendLabel}"></p:PaperButton>
							Ausencia
						</i:IronLabel>
						<i:IronLabel>
							<p:PaperButton
								styleName="{style.cellStyle1} {style.suspensionStyle} {style.dialogLeyendLabel}"
								ui:field="diaSuspensionButton"></p:PaperButton>
							Suspensión
						</i:IronLabel>
						<i:IronLabel>
							<p:PaperButton
								styleName="{style.cellStyle1} {style.itStyle} {style.dialogLeyendLabel}"
								ui:field="diaBajaITButton"></p:PaperButton>
							Baja IT
						</i:IronLabel>
						<i:IronLabel>
							<p:PaperButton
								styleName="{style.cellStyle1} {style.reductionStyle} 
									{style.dialogLeyendLabel} {style.reductionMarginDialogLeyend}"
								ui:field="diaReduccionButton"></p:PaperButton>
							Reducción
						</i:IronLabel>
					</g:HTMLPanel>
					<hr />
					<HTMLPanel class="buttons">
						<p:PaperButton ui:field="dialogInfoOk" attributes="dialog-confirm"
							focused="true" styleName="{style.okDialogLeyendButton}">OK</p:PaperButton>
					</HTMLPanel>
				</p:PaperDialog>

				<g:HorizontalPanel>
					<g:Label styleName="{style.year}" ui:field="yearLabel">2017</g:Label>
					<g:Button
						styleName="{style.optionButtons} {style.optionButtonsLeft} aon-icon-previous"
						ui:field="lastYearButton" />
					<g:Button
						styleName="{style.optionButtons} {style.optionButtonsRight} aon-icon-next"
						ui:field="nextYearButton" />
				</g:HorizontalPanel>

				<style is="custom-style">
					paper-button {
					--paper-button: {
					min-width: 15px;
					min-height: 15px;
					margin-bottom: 1em;
					margin-left: 1em;
					margin-top: 1em;
					}
					}
				</style>

				<g:HorizontalPanel>
					<g:Label styleName="{style.labelDiasStyle}">
						Dias seleccionables:
					</g:Label>
					<i:IronLabel>
						<p:PaperButton styleName="{style.cellStyle} {style.sundayStyle}"
							ui:field="diaNoLaborableButton"></p:PaperButton>
						No Laborables/Festivos
					</i:IronLabel>
					<i:IronLabel>
						<p:PaperButton styleName="{style.cellStyle} {style.holidayStyle}"
							ui:field="diaVacacionesButton"></p:PaperButton>
						Vacaciones
					</i:IronLabel>
					<i:IronLabel>
						<p:PaperButton styleName="{style.cellStyle} {style.strikeStyle}"
							ui:field="diaHuelgaButton"></p:PaperButton>
						Huelga
					</i:IronLabel>
					<i:IronLabel>
						<p:PaperButton styleName="{style.cellStyle} {style.ereStyle}"
							ui:field="diaEreButton"></p:PaperButton>
						ERE
					</i:IronLabel>
					<i:IronLabel>
						<p:PaperButton styleName="{style.cellStyle} {style.dropStyle}"
							ui:field="diaAusenciaButton"></p:PaperButton>
						Ausencia
					</i:IronLabel>
					<i:IronLabel>
						<p:PaperIconButton icon="icons:alarm" ui:field="hourButton"
							disabled="true" />
						Horas
					</i:IronLabel>
					<i:IronLabel styleName="{style.iconLeyendStyle}">
						<p:PaperIconButton icon="icons:info-outline"
							ui:field="infoButton" />
						Leyenda
					</i:IronLabel>
					<i:IronLabel styleName="{style.iconEraseStyle}">
						<p:PaperIconButton icon="icons:clear" ui:field="eraseButton" />
						Limpiar
					</i:IronLabel>
				</g:HorizontalPanel>
				<g:ScrollPanel ui:field="scrollInfo" styleName="{style.scrollStyle}">
					<g:Grid ui:field="calendarGrid" width="95%"
						styleName="{style.tableStyle} {style.noselect}">
						<g:row>
							<g:customCell styleName="{style.cabeceraStyle} {style.fondoBlanco}">
								<g:Label>&nbsp;</g:Label>
							</g:customCell>
							<g:customCell styleName="{style.cabeceraStyle}">
								<g:Label>L</g:Label>
							</g:customCell>
							<g:customCell styleName="{style.cabeceraStyle}">
								<g:Label>M</g:Label>
							</g:customCell>
							<g:customCell styleName="{style.cabeceraStyle}">
								<g:Label>X</g:Label>
							</g:customCell>
							<g:customCell styleName="{style.cabeceraStyle}">
								<g:Label>J</g:Label>
							</g:customCell>
							<g:customCell styleName="{style.cabeceraStyle}">
								<g:Label>V</g:Label>
							</g:customCell>
							<g:customCell styleName="{style.cabeceraStyle}">
								<g:Label>S</g:Label>
							</g:customCell>
							<g:customCell styleName="{style.cabeceraStyle}">
