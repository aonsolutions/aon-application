		<g:north size="55">
			<g:FlowPanel>
				<g:MenuBar>
					<g:MenuItem text="{msgs.fileMenu}" ui:field="archivoMenuItem">
						<g:MenuBar vertical="true">
							<g:MenuItem ui:field="nonWorkingDayMenuItem" text="{msgs.addNonWorkingDays}" />
							<g:MenuItem ui:field="holidayDayMenuItem" text="{msgs.addHolidays}" />
							<g:MenuItem ui:field="inactivityDayMenuItem" text="{msgs.addInactivity}" />
							<g:MenuItem ui:field="dropDayMenuItem" text="{msgs.addAbsence}" />
