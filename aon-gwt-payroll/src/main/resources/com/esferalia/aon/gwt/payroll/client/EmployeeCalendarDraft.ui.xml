			padding-left: 0.65em;
			padding-top: 0.5em;
			padding-bottom: 0.5em;
			margin: 6px;
		}
		
		.doubleBoxStyle {
			width: 10px;
			text-align: center;
			color: black;
			background-color: #eee;
			font: 12px/1.333 "arial", "lucida Grande", "Trebuchet MS", sans-serif;
		}
		
		.doubleBoxDisableStyle {
			border: none;
			width: 10px;
			color: black;
			text-align: center;
			background-color: #eee;
			font: 12px/1.333 "arial", "lucida Grande", "Trebuchet MS", sans-serif;
