			margin-right: 3px;
			padding: 3px;
			color:white;
			font-weight: bold;
		}

		.noWorkingColor{
			background-color: salmon;
		}

		.holidayColor{
			background-color: green;
		}

		.partialityColor{
			background-color: #9c85ee;
		}

		.strikeColor{
			background-color: #a09c13;
    	}

		.ereColor{
			background-color: #b91257;
		}

		.inactivityColor{
			background-color: #71b1e8;
		}

		.dropColor{
			background-color: #733969;
		}

		.peonadasColor{
			background-color: #d692f9;
		}

		.tableStyle {
			border-collapse: collapse;
			margin-left: 0.8em;
			width: 100%;
		}

		.tableStyle td {
			text-align: center;
			border-bottom: 1px solid #ddd;
			font-family: Arial, Helvetica, sans-serif;
		}

		.cabeceraStyle {
			font-weight: bold;
			padding-right: 0.65em;
			padding-left: 0.65em;
			padding-top: 0.5em;
			padding-bottom: 0.5em;
			margin: 6px;
		}

		.doubleBoxStyle {
			width: 10px;
			text-align: center;
			color: black;
			background-color: #eee;
			font: 12px/1.333 "arial", "lucida Grande", "Trebuchet MS", sans-serif;
		}

		.doubleBoxDisableStyle {
			border: none;
			width: 10px;
			color: black;
			text-align: center;
			background-color: #eee;
			font: 12px/1.333 "arial", "lucida Grande", "Trebuchet MS", sans-serif;
		}

		.doubleBoxDisableStyle2 {
			border: none;
