<ui:UiBinder 
    xmlns:ui='urn:ui:com.google.gwt.uibinder'
	xmlns:g='urn:import:com.google.gwt.user.client.ui'
	xmlns:es3='urn:import:com.google.gwt.user.client.ui'
	xmlns:datepicker='urn:import:com.google.gwt.user.datepicker.client'
	xmlns:a='urn:import:com.esferalia.aon.gwt.common.client.widget'>

    <ui:with field='res' type='com.esferalia.aon.gwt.common.client.css.AonResources' />  
    
	<ui:style type="com.esferalia.aon.gwt.payroll.client.EmployeeCalendarPartialityDialog.MyStyle">

		.dateBox{
			width: 100% !important;
			text-align: center;
			border: solid #808080 1px;
		}
		
		.w102{
			width: 102%;
		}
		
		.doubleBox{
			text-align: center;
			border: solid #808080 1px;
		}
		
	</ui:style>

	<g:HTMLPanel styleName="aon-width-all aon-height-all">
	
		<table class="aon-width-all aon-height-all" style="padding: 5px;">
			<tr>
				<td>
					<g:Label>Coeficiente Parcialidad:</g:Label>
				</td>
				<td>
					<g:DoubleBox ui:field="partialityPercent" styleName="{style.doubleBox}"></g:DoubleBox>
				</td>
				<td>
					<g:Label>%</g:Label>
				</td>
			</tr>
			<tr>
				<td>
					<g:Label>Fecha inicio:</g:Label>
				</td>
				<td colspan="2">
					<a:DateBoxEx ui:field="startDateBox" styleName="{style.dateBox}"></a:DateBoxEx>
				</td>
			</tr>
			<tr>
				<td>
					<g:Label>Fecha fin:</g:Label>
				</td>
				<td colspan="2">
					<a:DateBoxEx ui:field="endDateBox"  styleName="{style.dateBox}"></a:DateBoxEx>
				</td>
			</tr>
			<tr>
				<td colspan="2" align="right" style="padding-top: 15px;">
					<g:Button ui:field="cancelButton">Cerrar</g:Button>
		    		<g:Button ui:field="acceptButton">OK</g:Button>
				</td>
			</tr>
		</table>
			
	</g:HTMLPanel>

</ui:UiBinder>