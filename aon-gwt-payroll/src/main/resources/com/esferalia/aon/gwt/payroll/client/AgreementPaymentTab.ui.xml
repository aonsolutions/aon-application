<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
	xmlns:g='urn:import:com.google.gwt.user.client.ui'
	xmlns:c='urn:import:com.google.gwt.user.cellview.client'
	xmlns:p="urn:import:net.aonsolutions.gwt.pdfjs.client"	
	xmlns:w='urn:import:com.esferalia.aon.gwt.common.client.widget'
	xmlns:aon='urn:import:com.esferalia.aon.gwt.common.client.widget.solutions'>

	<ui:with field='res' type='com.esferalia.aon.gwt.common.client.css.AonResources'/>

	<ui:style type="com.esferalia.aon.gwt.payroll.client.AgreementPaymentTab.MyStyle">
		
		.disclouruseTitle {
			color: #4b4b4b;
			vertical-align: top;
			min-width: 7rem;
			font-weight: bold;
			text-transform: uppercase;
			font-size: 1.1em;
		}
		.discContent {
			padding: 1rem 0 !important;
		}
		
		.flexColumn{
			display: flex;
			flex-direction: column;
			gap: .5rem;
			border-left: none !important;
		}
		
		.flexTitle {
			display: flex;
			gap: 1rem;
			align-items: center;
			border-bottom: 1px solid #c1bebe;
		}
		
		.flexCenter {
			display: flex;
			justify-content: center;
		}
		
		.cmdBtn{
			background-position: center left;
			background-repeat: no-repeat;
			padding-left: 25px !important;
			background-size: contain;
		}
	
		.disclosurePanel {
			padding: 0 1rem;
		}
		
		.hideScroll{}
		
		.hideScroll::-webkit-scrollbar {
			width: 1px;
			height: 6px;
			background-color: gray;
		}
		
		/* To hide the vertical scroll. */
		.hideScroll::-webkit-scrollbar:vertical {
			display: none;
		}
		
		.hideScroll::-webkit-scrollbar-thumb:horizontal {
			background: black;
		}
		
		.heigthAll {
			height: 100%;
		}
		
		.grid {
			margin: 0 1rem;
		}
		
		.modify {
			background-color: lightyellow !important;
    		border: 0.5px solid yellow !important;
		}
		
		@external modify;
		
	</ui:style>
	
	<g:HTMLPanel styleName="{style.flexColumn} {style.heigthAll}">
		<g:HTMLPanel ui:field="messagePanel" />
		<g:HTMLPanel styleName="{style.flexColumn}">
			<aon:AonToolbar ui:field="toolbar" />
			
			<g:DisclosurePanel ui:field="paymentDiscPanel" styleName="{style.disclosurePanel}">
			  <g:customHeader>
			   	 <g:HTMLPanel styleName="{style.flexTitle}">
			   	  	<aon:AonToolbarButton ui:field="paymentDiscBtn" />
			   	  	<g:Label styleName="{style.disclouruseTitle}">Devengos</g:Label>
			   	 </g:HTMLPanel>
			   </g:customHeader>
			   <g:HTMLPanel styleName="{style.flexColumn} {style.discContent}" ui:field="paymentDiscPanelContent">
			   		<c:DataGrid ui:field="agreementPaymentDG" debugId="agreementPaymentDG" styleName="{style.grid}" />
			   </g:HTMLPanel>
		   </g:DisclosurePanel>
		   
		   <g:DisclosurePanel ui:field="extraDiscPanel" styleName="{style.disclosurePanel}">
			  <g:customHeader>
			   	 <g:HTMLPanel styleName="{style.flexTitle}">
			   	  	<aon:AonToolbarButton ui:field="extraDiscBtn" debugId="extraDiscBtn" />
			   	  	<g:Label styleName="{style.disclouruseTitle}">Extras</g:Label>
			   	 </g:HTMLPanel>
			   </g:customHeader>
			   <g:HTMLPanel styleName="{style.flexColumn} {style.discContent}" ui:field="extraDiscPanelContent">
			   		<c:DataGrid ui:field="agreementExtraPaymentDG" debugId="agreementExtraPaymentDG" styleName="{style.grid}" />
			   </g:HTMLPanel>
		   </g:DisclosurePanel>
			
			
			
		</g:HTMLPanel>
	</g:HTMLPanel>
</ui:UiBinder> 

