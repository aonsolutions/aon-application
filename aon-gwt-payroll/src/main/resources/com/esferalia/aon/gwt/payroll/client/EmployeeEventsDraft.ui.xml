		/* ESTILOS TABLA */

		.tableStyle {
			border-collapse: collapse;
			cursor: pointer;
			margin-left: 0.8em;
			width: 100%;
		}

		.tableStyle tr {
			text-align: center;
			border-bottom: 1px solid #ddd;
			font-family: Arial, Helvetica, sans-serif !important;
			font-size: 11px !important;
		}

		.firstHeadStyle {
			width: 16em;
			font-weight: bold;
			font-family: Arial, Helvetica, sans-serif !important;
			font-size: 11px !important;
			padding: 3px;
		}

		.firstHeadStyleHide {
			/* width:16em; */
			padding-bottom: 15px;
			visibility: hidden;
			font-weight: bold;
			font-family: Arial, Helvetica, sans-serif !important;
			font-size: 11px !important;
		}

		.cabeceraStyle {
			width: 5.5em;
			font-weight: bold;
			font-family: Arial, Helvetica, sans-serif !important;
			font-size: 11px !important;
		}

		.cabeceraStyleHide {
			width: 5.5em;
			visibility:hidden;
			font-weight: bold;
			font-family: Arial, Helvetica, sans-serif !important;
			font-size: 11px !important;
		}

		.oddRowStyle {
			background-color: #eee;
		}

		.ocultarFila{
			display: none;
		}

		.noselect {
			-webkit-touch-callout: none; /* iOS Safari */
			-webkit-user-select: none; /* Safari */
			-khtml-user-select: none; /* Konqueror HTML */
			-moz-user-select: none; /* Firefox */
			-ms-user-select: none; /* Internet Explorer/Edge */
			user-select: none; /* Non-prefixed version, currently supported by Chrome and Opera */
		}

		/* ESTILOS CELDA TABLA */

		.cellFormat{
			/* width: 40px; */
			/* margin-left: 8px; */
			text-align: center;
			border: none;
			cursor: pointer;
			font-family: Arial, Helvetica, sans-serif !important;
			font-size: 11px !important;
		}

		.cellOddFormat{
			background-color: #eee;
			/* width: 40px; */
			/* margin-left: 8px; */
			text-align: center;
			border: none;
			cursor: pointer;
			font-family: Arial, Helvetica, sans-serif !important;
			font-size: 11px !important;
		}

		.isSelectedCell{
			background-color: #166ef3 !important;
			color: #ffffff !important;
			border-radius: 9px !important;
			/* width: 40px; */
			/* margin-left: 8px; */
			text-align: center;
			border: none;
			cursor: pointer;
			font-family: Arial, Helvetica, sans-serif !important;
			font-size: 11px !important;
		}

		.onChange {
			background-color: rgba(255, 255, 0, 0.38);
			font-family: Arial, Helvetica, sans-serif !important;
			font-size: 11px !important;
		}

		.setBlockVariableStyle{
			color: #aaa;
			font-family: Arial, Helvetica, sans-serif !important;
			font-size: 11px !important;
		}

