<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<ui:UiBinder xmlns:ui='urn:ui:com.google.gwt.uibinder'
	xmlns:g='urn:import:com.google.gwt.user.client.ui' 
	xmlns:c='urn:import:com.google.gwt.user.cellview.client'
	xmlns:employee='urn:import:com.esferalia.aon.gwt.payroll.client'
	xmlns:s="urn:import:com.google.gwt.dom.builder.shared"
	xmlns:a='urn:import:com.esferalia.aon.gwt.common.client.widget'>

	<ui:with field='res'
		type='com.esferalia.aon.gwt.common.client.css.AonResources' />

	<ui:style
		type="com.esferalia.aon.gwt.payroll.client.EmployeeEventsDraft.MyStyle">

		/* ESTILOS TABLA */

		.tableStyle {
			border-collapse: collapse;
			cursor: pointer;
			margin-left: 0.8em;
			width: 99%;
		}

		.tableStyle tr {
			text-align: center;
			border-bottom: 1px solid #ddd;
			font-family: Arial, Helvetica, sans-serif !important;
			font-size: 11px !important;
		}

		.firstHeadStyle {
			font-weight: bold;
			font-family: Arial, Helvetica, sans-serif !important;
			font-size: 11px !important;
			padding: 3px;
		}

		.firstHeadStyleHide {
			padding-bottom: 15px;
			visibility: hidden;
			font-weight: bold;
			font-family: Arial, Helvetica, sans-serif !important;
			font-size: 11px !important;
		}

		.cabeceraStyle {
			width: 5.5em;
			font-weight: bold;
			font-family: Arial, Helvetica, sans-serif !important;
			font-size: 11px !important;
		}

		.oddRowStyle {
			background-color: #eee;
		}

		.ocultarFila{
			display: none;
		}

		.noselect {
			-webkit-touch-callout: none; /* iOS Safari */
			-webkit-user-select: none; /* Safari */
			-khtml-user-select: none; /* Konqueror HTML */
			-moz-user-select: none; /* Firefox */
			-ms-user-select: none; /* Internet Explorer/Edge */
			user-select: none; /* Non-prefixed version, currently supported by Chrome and Opera */
		}

		.scrollStyle {
			position: absolute !important;
			right: 5px !important;
			bottom: 50px !important;
		}

		/* ESTILOS CELDA TABLA */

		.calendarPosition{
			margin-left: 150px;
		}

		.cellFormat{
			width: 45px;
			/* margin-left: 8px; */
			text-align: center;
			border: none;
			cursor: pointer;
			font-family: Arial, Helvetica, sans-serif !important;
			font-size: 11px !important;
		}

		.cellOddFormat{
			background-color: #eee;
			width: 45px;
			/*margin-left: 8px;*/
			text-align: center;
			border: none;
			cursor: pointer;
			font-family: Arial, Helvetica, sans-serif !important;
			font-size: 11px !important;
		}

		.isSelectedCell{
			background-color: #166ef3 !important;
			color: #ffffff !important;
			border-radius: 9px !important;
			width: 45px;
			/* margin-left: 8px; */
			text-align: center;
			border: none;
			cursor: pointer;
			font-family: Arial, Helvetica, sans-serif !important;
			font-size: 11px !important;
		}

		.onChange {
			border: none !important;
    		text-align: center !important;
			width: 45px;
			background-color: rgba(255, 255, 0, 0.38);
			font-family: Arial, Helvetica, sans-serif !important;
			font-size: 11px !important;
		}

		.setBlockVariableStyle{
			color: #aaa;
			font-family: Arial, Helvetica, sans-serif !important;
			font-size: 11px !important;
		}

		/* ESTILOS CAMBIO DE AÑO */

		.paddingHorizontalPanel{
			padding-bottom: 30px;
		}

		.year {
			font-size: 30px;
			color: #FF704D;
			padding-left: 8px;
			padding-right: 8px;
			padding-top: 2px;
		}

		.optionButtons{
			width: 30px;
			height: 25px;
			cursor: pointer;
			border: none;
		}

		.optionButtonsLeft {
			margin-top: 8px;
			margin-left: 18px;
		}

		.optionButtonsRight {
			margin-top: 8px;
		}

		/* ESTILO DAILOG */

		.showVariablesStyle{
			padding: 3px;
		}	
		
		.bgcWhite{
			background-color: white;
		}	
		
		/* ------------------- Menu Bar ------------------- */
		.flex{
			display: flex;
			align-items: center;
		}
		
		.menuBar{
			cursor: pointer;
			display: grid;
			border-right: #808080 1px solid;
		}
		
		.findingTitleCalendar{
			width: 90px !important;
		}
		
		.findingTitleEdition{
			width: 65px !important;
		}
		
		.bold{
			text-transform: uppercase;
			font-size: 0.8em;
			font-weight: bold;
			padding: 4px;
		}
		
		/* ------------------- Year Panel ------------------- */
		.yearPanel{
			display: flex;
			justify-content: center;
			margin: .5rem 0;
		}
		
		.optionButtons {
			cursor: pointer;
			background-color: transparent;
			font-size: 1rem;
			color: #757575;
			border: .01rem solid #757575;
			border-radius: 10%;
			margin: .7rem 0;
		}
		
		.year {
			font-size: 2.2rem;
			color: #ff704d;
			padding: 0 1rem;
		}

	</ui:style>

	<ui:import field="com.esferalia.aon.gwt.payroll.client.EventsDraft.*" />

	<g:DockLayoutPanel unit="PX" ui:field="mainPanel">
		<g:north size="55">
			<g:FlowPanel>
				<g:FlowPanel styleName="aon-finding-title-toolbar {style.flex}">
					<g:HTMLPanel styleName="aon-finding-title {style.findingTitleCalendar}">
						<g:HTMLPanel styleName="aon-finding-title-internal">
							<g:Label styleName="aon-outputText">Incidencias</g:Label>
						</g:HTMLPanel>
					</g:HTMLPanel>
					<g:HTMLPanel styleName="aon-finding-subtitle">
						<g:HTMLPanel styleName="aon-finding-subtitle-internal">
							<g:Label styleName="aon-outputText"></g:Label>
						</g:HTMLPanel>
					</g:HTMLPanel>
					<g:HTMLPanel styleName="aon-finding-toolbar {style.flex}">
						<g:MenuBar styleName="aon-finding-toolbar-item-group {style.menuBar}">
							<g:MenuItem text="Visualización" ui:field="showVariablesMenuItem" styleName="{style.bold}"></g:MenuItem>
						</g:MenuBar>
						<g:MenuBar styleName="aon-finding-toolbar-item-group {style.menuBar}">
							<g:MenuItem text="Utilidades" styleName="{style.bold}">
								<g:MenuBar vertical="true">
									<g:MenuItem ui:field="undoAllMenuItem" text="Restaurar últimos valores guardados"></g:MenuItem>	
								</g:MenuBar>
							</g:MenuItem>
						</g:MenuBar>
					</g:HTMLPanel>
				</g:FlowPanel>

				<g:FlowPanel styleName="aon-finding-title-toolbar {style.flex}">
					<g:HTMLPanel styleName="aon-finding-title {style.findingTitleEdition}">
						<g:HTMLPanel styleName="aon-finding-title-internal">
							<g:Label styleName="aon-outputText">Edici&oacute;n</g:Label>
						</g:HTMLPanel>
					</g:HTMLPanel>
					<g:HTMLPanel styleName="aon-finding-subtitle">
						<g:HTMLPanel styleName="aon-finding-subtitle-internal">
							<g:Label styleName="aon-outputText"></g:Label>
						</g:HTMLPanel>
					</g:HTMLPanel>
					<g:HTMLPanel styleName="aon-finding-toolbar {style.flex}">
						<g:HTMLPanel styleName="aon-finding-toolbar-item-group" visible="true">
							<g:Button debugId='undoAllButton' ui:field='undoAllButton'
									styleName='aon-finding-toolbar-item {res.css.aonIconUndoAll}' />
						</g:HTMLPanel>
						<g:HTMLPanel styleName="aon-finding-toolbar-item-group">
						<g:Button ui:field='newValueButton'
									styleName='aon-finding-toolbar-item aon-icon-reset' text="NUEVO VALOR" />
						</g:HTMLPanel>
						
						<g:HTMLPanel styleName="aon-finding-toolbar-item-group">
							<g:Button ui:field='saveButton'
								styleName='aon-finding-toolbar-item aon-icon-accept' text="GUARDAR" />
						</g:HTMLPanel>
					</g:HTMLPanel>
				</g:FlowPanel>

			</g:FlowPanel>
		</g:north>

		<g:center>
			<g:HTMLPanel>

				<g:HTMLPanel styleName="{style.yearPanel}">
					<g:Button
						styleName="{style.optionButtons}"
						ui:field="lastYearButton"> &#60; </g:Button>
					<g:Label styleName="{style.year}" ui:field="yearLabel">2020</g:Label>
					<g:Button
						styleName="{style.optionButtons}"
						ui:field="nextYearButton"> &#62; </g:Button>
				</g:HTMLPanel>

				<g:DockLayoutPanel unit="PX" height="90%">
					<!-- DataGrid. -->
					<g:center>
						<g:ScrollPanel styleName="{style.scrollStyle}">
							<g:FlexTable ui:field="eventsGrid" styleName="{style.tableStyle} {style.noselect}">
								<!-- AQUI SE CONSTRUYE LA TABLA VACIA. -->
							</g:FlexTable>
						</g:ScrollPanel>
					</g:center>
				</g:DockLayoutPanel>
			</g:HTMLPanel>
		</g:center>
	</g:DockLayoutPanel>
</ui:UiBinder>
