<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<ui:UiBinder xmlns:ui='urn:ui:com.google.gwt.uibinder'
	xmlns:g='urn:import:com.google.gwt.user.client.ui'
	xmlns:c='urn:import:com.google.gwt.user.cellview.client' 
	xmlns:employee='urn:import:com.esferalia.aon.gwt.payroll.client'
	xmlns:s="urn:import:com.google.gwt.dom.builder.shared">

	<ui:style>

		/* ESTILOS TABLA */

		.tableStyle {
			border-collapse: collapse;
			cursor: pointer;
			margin-left: 0.8em;
			width: 100%;
		}
		
		.tableStyle td {
			text-align: center;
			border-bottom: 1px solid #ddd;
			font-family: Arial, Helvetica, sans-serif;
			font-size: 11px;
		}
		
		.cabeceraFirstStyle {
			width: 16em;
			font-weight: bold;
			padding: 3px;
		}

		.cabeceraFirstStyleHide {
			width: 16em;
			visibility: hidden;
			font-weight: bold;
		}

		.cabeceraStyle {
			width: 5.5em;
			font-weight: bold;
		}

		.cabeceraStyleHide {
			width: 5.5em;
			visibility: hidden;
			font-weight: bold;
		}

		.filasImparesStyle {
			background-color: #eee;
		}

		/* ESTILOS CAMBIO DE AÑO */		
		.paddingHorizontalPanel{
			padding-bottom: 30px;
		}

		.year {
			font-size: 30px;
			color: #FF704D;
			padding-left: 28px;
			padding-top: 2px;
		}
		
		.optionButtons {
			width: 30px;
			height: 25px;
			cursor: pointer;
			border: none;
		}
		
		.optionButtonsLeft {
			margin-top: 8px;
			margin-left: 8px;
		}
		
		.optionButtonsRight {
			margin-top: 8px;
		}
		
	</ui:style>

	<ui:import field="com.esferalia.aon.gwt.payroll.client.EventsDraft.*" />

	<g:DockLayoutPanel unit="PX" ui:field="mainPanel">
		<g:north size="72">
	
		    <!-- BARRA SUPERIOR -->
			<g:FlowPanel>
			    
			    <!-- MENU BAR -->
				<g:MenuBar>
					<g:MenuItem text="Archivo">
						<g:MenuBar vertical="true">
							<!-- g:MenuItem ui:field="diaFestivo" text="Añadir día(s) festivos" />
							<g:MenuItem styleName="gwt-MenuItemSeparator">
								<div class="menuSeparatorInner"></div>
							</g:MenuItem>
							<g:MenuItem ui:field="eraseEventMenuItem" text="Borrar evento(s)" / -->
						</g:MenuBar>
					</g:MenuItem>
					<g:MenuItem text="Visualización" ui:field="viewMenuItem">
						<g:MenuBar vertical="true">
							<g:MenuItem ui:field="showMonthMenuItem" text="Mensual"/>
							<g:MenuItem ui:field="showHYearMenuItem" text="Anual"/>
						</g:MenuBar>
					</g:MenuItem>
				</g:MenuBar>
				
				<!-- EVENTOS: GUARDAR -->
				<g:FlowPanel styleName="aon-finding-title-toolbar">
					<g:HorizontalPanel>
						<g:HTMLPanel styleName="aon-finding-title">
							<g:HTMLPanel styleName="aon-finding-title-internal">
								<g:Label styleName="aon-outputText">Incidencias</g:Label>
							</g:HTMLPanel>
						</g:HTMLPanel>
						<g:HTMLPanel styleName="aon-finding-subtitle">
							<g:HTMLPanel styleName="aon-finding-subtitle-internal">
								<g:Label styleName="aon-outputText"></g:Label>
							</g:HTMLPanel>
						</g:HTMLPanel>
						<g:HorizontalPanel styleName="aon-finding-toolbar">
							<g:HTMLPanel styleName="aon-finding-toolbar-item-group">
								<g:Button ui:field='acceptButton'
									styleName='aon-finding-toolbar-item aon-icon-accept' text="GUARDAR" />
							</g:HTMLPanel>
						</g:HorizontalPanel>
					</g:HorizontalPanel>
				</g:FlowPanel>		
			</g:FlowPanel>	
		</g:north>
		
		<g:center>
		    <g:HTMLPanel>
		        
		        <!-- PANEL CAMBIO DE AÑO-->
		        <g:HorizontalPanel styleName="{style.paddingHorizontalPanel}">
					<g:Label styleName="{style.year}" ui:field="yearLabel">2017</g:Label>
					<g:Button
						styleName="{style.optionButtons} {style.optionButtonsLeft} aon-icon-previous"
						ui:field="lastYearButton" />
					<g:Button
						styleName="{style.optionButtons} {style.optionButtonsRight} aon-icon-next"
						ui:field="nextYearButton" />
				</g:HorizontalPanel>
		         
		        
			    <g:DockLayoutPanel
				    unit="EM" height="90%">
			        
				    <!-- DataGrid. -->
				    <g:north size="1">
				        <g:Grid width="99%" styleName="{style.tableStyle}">
				   		    <g:row>
							    <g:customCell styleName="{style.cabeceraFirstStyleHide}">
									<g:Label>DIAS_MANUTENCION_EXTRANJERO</g:Label>
								</g:customCell>
							    <g:customCell styleName="{style.cabeceraStyle}">
							      <g:Label>ENERO</g:Label>
							    </g:customCell>
							    <g:customCell styleName="{style.cabeceraStyle}">
							      <g:Label>FEBRERO</g:Label>
							    </g:customCell>
							    <g:customCell styleName="{style.cabeceraStyle}">
							      <g:Label>MARZO</g:Label>
							    </g:customCell>
							    <g:customCell styleName="{style.cabeceraStyle}">
							      <g:Label>ABRIL</g:Label>
							    </g:customCell>
							    <g:customCell styleName="{style.cabeceraStyle}">
							      <g:Label>MAYO</g:Label>
							    </g:customCell>
							    <g:customCell styleName="{style.cabeceraStyle}">
							      <g:Label>JUNIO</g:Label>
							    </g:customCell>
							    <g:customCell styleName="{style.cabeceraStyle}">
							      <g:Label>JULIO</g:Label>
							    </g:customCell>
							    <g:customCell styleName="{style.cabeceraStyle}">
							      <g:Label>AGOSTO</g:Label>
							    </g:customCell>
							    <g:customCell styleName="{style.cabeceraStyle}">
							      <g:Label>SEPTIEMBRE</g:Label>
							    </g:customCell>
							    <g:customCell styleName="{style.cabeceraStyle}">
							      <g:Label>OCTUBRE</g:Label>
							    </g:customCell>
							    <g:customCell styleName="{style.cabeceraStyle}">
							      <g:Label>NOVIEMBRE</g:Label>
							    </g:customCell>
							    <g:customCell styleName="{style.cabeceraStyle}">
							      <g:Label>DICIEMBRE</g:Label>
							    </g:customCell>
	 						 </g:row>
				 		</g:Grid>
				    </g:north>
				    <g:center>
				        <g:ScrollPanel>
					   		<g:Grid ui:field="eventsGrid" width="99%" styleName="{style.tableStyle}">
				   		    	<!-- PARTE OCULTA PARA REDIMENSIONAR LA TABLA -->
				   		    	<g:row>
									<g:customCell styleName="{style.cabeceraFirstStyleHide}">
										<g:Label>DIAS_MANUTENCION_EXTRANJERO</g:Label>
									</g:customCell>
								    <g:customCell styleName="{style.cabeceraStyleHide}">
								      <g:Label>ENERO</g:Label>
								    </g:customCell>
								    <g:customCell styleName="{style.cabeceraStyleHide}">
								      <g:Label>FEBRERO</g:Label>
								    </g:customCell>
								    <g:customCell styleName="{style.cabeceraStyleHide}">
								      <g:Label>MARZO</g:Label>
								    </g:customCell>
								    <g:customCell styleName="{style.cabeceraStyleHide}">
								      <g:Label>ABRIL</g:Label>
								    </g:customCell>
								    <g:customCell styleName="{style.cabeceraStyleHide}">
								      <g:Label>MAYO</g:Label>
								    </g:customCell>
								    <g:customCell styleName="{style.cabeceraStyleHide}">
								      <g:Label>JUNIO</g:Label>
								    </g:customCell>
								    <g:customCell styleName="{style.cabeceraStyleHide}">
								      <g:Label>JULIO</g:Label>
								    </g:customCell>
								    <g:customCell styleName="{style.cabeceraStyleHide}">
								      <g:Label>AGOSTO</g:Label>
								    </g:customCell>
								    <g:customCell styleName="{style.cabeceraStyleHide}">
								      <g:Label>SEPTIEMBRE</g:Label>
								    </g:customCell>
								    <g:customCell styleName="{style.cabeceraStyleHide}">
								      <g:Label>OCTUBRE</g:Label>
								    </g:customCell>
								    <g:customCell styleName="{style.cabeceraStyleHide}">
								      <g:Label>NOVIEMBRE</g:Label>
								    </g:customCell>
								    <g:customCell styleName="{style.cabeceraStyleHide}">
								      <g:Label>DICIEMBRE</g:Label>
								    </g:customCell>
								</g:row>
				   		    	<g:row styleName="{style.filasImparesStyle}">
		 						     <g:customCell styleName="{style.cabeceraFirstStyle}">
										<g:Label>DIAS_TRABAJADOS</g:Label>
									</g:customCell>
								</g:row>
								<g:row>
		 						     <g:customCell styleName="{style.cabeceraFirstStyle}">
										<g:Label>DIAS_EFECTIVOS</g:Label>
									</g:customCell>
								</g:row>
								<g:row styleName="{style.filasImparesStyle}">
		 						     <g:customCell styleName="{style.cabeceraFirstStyle}">
										<g:Label>DIAS_ERE</g:Label>
									</g:customCell>
								</g:row>
								<g:row>
		 						     <g:customCell styleName="{style.cabeceraFirstStyle}">
										<g:Label>DIAS_HUELGA</g:Label>
									</g:customCell>
								</g:row>
								<g:row styleName="{style.filasImparesStyle}">
		 						     <g:customCell styleName="{style.cabeceraFirstStyle}">
										<g:Label>DIAS_AUSENCIA</g:Label>
									</g:customCell>
								</g:row>
								<g:row>
		 						     <g:customCell styleName="{style.cabeceraFirstStyle}">
										<g:Label>HORAS_TRABAJADAS</g:Label>
									</g:customCell>
								</g:row>
								<g:row styleName="{style.filasImparesStyle}">
		 						     <g:customCell styleName="{style.cabeceraFirstStyle}">
										<g:Label>HORAS_COMPLEMENTARIAS</g:Label>
									</g:customCell>
								</g:row>
								<g:row>
		 						     <g:customCell styleName="{style.cabeceraFirstStyle}">
										<g:Label>DIAS_PECNORTA</g:Label>
									</g:customCell>
								</g:row>
								<g:row styleName="{style.filasImparesStyle}">
		 						     <g:customCell styleName="{style.cabeceraFirstStyle}">
										<g:Label>DIAS_MANUTENCION</g:Label>
									</g:customCell>
								</g:row>
								<g:row>
		 						     <g:customCell styleName="{style.cabeceraFirstStyle}">
										<g:Label>DIAS_PECNORTA_EXTRAJERO</g:Label>
									</g:customCell>
								</g:row>
								<g:row styleName="{style.filasImparesStyle}">
		 						     <g:customCell styleName="{style.cabeceraFirstStyle}">
										<g:Label>DIAS_MANUTENCION_EXTRANJERO</g:Label>
									</g:customCell>
								</g:row>
								<g:row>
		 						     <g:customCell styleName="{style.cabeceraFirstStyle}">
										<g:Label>KMS</g:Label>
									</g:customCell>
								</g:row>
								<g:row styleName="{style.filasImparesStyle}">
		 						     <g:customCell styleName="{style.cabeceraFirstStyle}">
										<g:Label>DIAS_VACACIONES</g:Label>
									</g:customCell>
								</g:row>
								<g:row>
		 						     <g:customCell styleName="{style.cabeceraFirstStyle}">
										<g:Label>JORNADAS_REALES</g:Label>
									</g:customCell>
								</g:row>
								<g:row styleName="{style.filasImparesStyle}">
		 						     <g:customCell styleName="{style.cabeceraFirstStyle}">
										<g:Label>HORAS_EXTRAS</g:Label>
									</g:customCell>
								</g:row>
								<g:row>
		 						     <g:customCell styleName="{style.cabeceraFirstStyle}">
										<g:Label>HORAS_EXTRAS_FZA</g:Label>
									</g:customCell>
								</g:row>						
					   		</g:Grid>
					   	</g:ScrollPanel>  
				    </g:center>
				</g:DockLayoutPanel>	
			 </g:HTMLPanel>
		</g:center>
	</g:DockLayoutPanel>
</ui:UiBinder>
