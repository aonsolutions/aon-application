<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<ui:UiBinder xmlns:ui='urn:ui:com.google.gwt.uibinder'
	xmlns:g='urn:import:com.google.gwt.user.client.ui' 
	xmlns:c='urn:import:com.google.gwt.user.cellview.client'
	xmlns:employee='urn:import:com.esferalia.aon.gwt.payroll.client'
	xmlns:s="urn:import:com.google.gwt.dom.builder.shared" 
	xmlns:i="urn:import:com.vaadin.polymer.iron.widget"
	xmlns:p="urn:import:com.vaadin.polymer.paper.widget" 
	xmlns:a='urn:import:com.esferalia.aon.gwt.common.client.widget'>

	<ui:with field='res'
		type='com.esferalia.aon.gwt.common.client.css.AonResources' />

	<ui:style
		type="com.esferalia.aon.gwt.payroll.client.EmployeeEventsDraft.MyStyle">

		/* ESTILOS TABLA */

		.tableStyle {
		border-collapse: collapse;
		cursor: pointer;
		margin-left: 0.8em;
		width: 99%;
		}

		.tableStyle tr {
		text-align: center;
		border-bottom: 1px solid #ddd;
		font-family: Arial, Helvetica, sans-serif !important;
		font-size: 11px !important;
		}

		.firstHeadStyle {
		width: 16em;
		font-weight: bold;
		font-family: Arial, Helvetica, sans-serif !important;
		font-size: 11px !important;
		padding: 3px;
		}

		.firstHeadStyleHide {
		/* width:16em; */
		padding-bottom: 15px;
		visibility: hidden;
		font-weight: bold;
		font-family: Arial, Helvetica, sans-serif !important;
		font-size: 11px !important;
		}

		.cabeceraStyle {
		width: 5.5em;
		font-weight: bold;
		font-family: Arial, Helvetica, sans-serif !important;
		font-size: 11px !important;
		}

		.cabeceraStyleHide {
		width: 5.5em;
		visibility:hidden;
		font-weight: bold;
		font-family: Arial, Helvetica, sans-serif !important;
		font-size: 11px !important;
		}

		.oddRowStyle {
		background-color: #eee;
		}

		.ocultarFila{
		display: none;
		}

		.noselect {
		-webkit-touch-callout: none; /* iOS Safari */
		-webkit-user-select: none; /* Safari */
		-khtml-user-select: none; /* Konqueror HTML */
		-moz-user-select: none; /* Firefox */
		-ms-user-select: none; /* Internet Explorer/Edge */
		user-select: none; /* Non-prefixed version, currently supported by Chrome and
		Opera */
		}

		.scrollStyle {
		position: absolute !important;
		right: 5px !important;
		bottom: 50px !important;
		}

		.scrollStyle1 {
		top: 50px !important;
		}

		/* ESTILOS CELDA TABLA */

		.cellFormat{
		/* width: 40px; */
		/* margin-left: 8px; */
		text-align: center;
		border: none;
		cursor: pointer;
		font-family: Arial, Helvetica, sans-serif !important;
		font-size: 11px !important;
		}

		.cellOddFormat{
		background-color: #eee;
		/* width: 40px; */
		/* margin-left: 8px; */
		text-align: center;
		border: none;
		cursor: pointer;
		font-family: Arial, Helvetica, sans-serif !important;
		font-size: 11px !important;
		}

		.isSelectedCell{
		background-color: #166ef3 !important;
		color: #ffffff !important;
		border-radius: 9px !important;
		/* width: 40px; */
		/* margin-left: 8px; */
		text-align: center;
		border: none;
		cursor: pointer;
		font-family: Arial, Helvetica, sans-serif !important;
		font-size: 11px !important;
		}

		.onChange {
		background-color: rgba(255, 255, 0, 0.38);
		font-family: Arial, Helvetica, sans-serif !important;
		font-size: 11px !important;
		}

		.setBlockVariableStyle{
		color: #aaa;
		font-family: Arial, Helvetica, sans-serif !important;
		font-size: 11px !important;
		}

		/* ESTILOS CAMBIO DE AÑO */

		.paddingHorizontalPanel{
		padding-bottom: 30px;
		}

		.year {
		font-size: 30px;
		color: #FF704D;
		padding-left: 8px;
		padding-right: 8px;
		padding-top: 2px;
		}

		.optionButtons{
		width: 30px;
		height: 25px;
		cursor: pointer;
		border: none;
		}

		.optionButtonsLeft {
		margin-top: 8px;
		margin-left: 18px;
		}

		.optionButtonsRight {
		margin-top: 8px;
		}

		/* ESTILO PAPER DAILOG */

		.marginTopCloseDialog{
		margin-top: 1px !important;
		padding-left: 0px;
		padding-right: 0px;
		}

		.paddingLeftShowVaribalesDialog{
		padding-left: 5px;
		}

		.marginTopShowVariablesDialog{
		margin-top: 10px !important;
		}

		.showVariablesStyle{
		padding: 3px;
		}		

	</ui:style>

	<ui:import field="com.esferalia.aon.gwt.payroll.client.EventsDraft.*" />

	<g:DockLayoutPanel unit="PX" ui:field="mainPanel">
		<g:north size="72">

			<!-- BARRA SUPERIOR -->
			<g:FlowPanel>

				<!-- MENU BAR -->
				<g:MenuBar>
					<g:MenuItem text="Archivo">
						<g:MenuBar vertical="true">
							<g:MenuItem ui:field="addNewValueMenuItem" text="Añadir nuevo valor" />
						</g:MenuBar>
					</g:MenuItem>
					<g:MenuItem text="Visualización" ui:field="viewMenuItem">
						<g:MenuBar vertical="true">
							<g:MenuItem ui:field="showVariablesMenuItem" text="Variables mostradas" />
							<g:MenuItem styleName="gwt-MenuItemSeparator">
								<div class="menuSeparatorInner"></div>
							</g:MenuItem>
							<!-- g:MenuItem ui:field="showMonthMenuItem" text="Mensual"/ -->
							<g:MenuItem ui:field="showYearMenuItem" text="Anual" />
						</g:MenuBar>
					</g:MenuItem>
				</g:MenuBar>

				<!-- EVENTOS: GUARDAR -->
				<g:FlowPanel styleName="aon-finding-title-toolbar">
					<g:HorizontalPanel>
						<g:HTMLPanel styleName="aon-finding-title">
							<g:HTMLPanel styleName="aon-finding-title-internal">
								<g:Label styleName="aon-outputText">Incidencias</g:Label>
							</g:HTMLPanel>
						</g:HTMLPanel>
						<g:HTMLPanel styleName="aon-finding-subtitle">
							<g:HTMLPanel styleName="aon-finding-subtitle-internal">
								<g:Label styleName="aon-outputText"></g:Label>
							</g:HTMLPanel>
						</g:HTMLPanel>
						<g:HorizontalPanel styleName="aon-finding-toolbar">
							<g:HTMLPanel styleName="aon-finding-toolbar-item-group">
								<g:Button debugId='undoAllButton' ui:field='undoAllButton'
									styleName='aon-finding-toolbar-item {res.css.aonIconUndoAll}'
									enabled="false" />
								<g:Button ui:field="undoButton"
									styleName='aon-finding-toolbar-item aon-icon-undo' enabled="false" />
								<g:Button ui:field='redoButton'
									styleName="aon-finding-toolbar-item aon-icon-redo" enabled="false" />
							</g:HTMLPanel>
						</g:HorizontalPanel>
						<g:HorizontalPanel styleName="aon-finding-toolbar">
							<g:HTMLPanel styleName="aon-finding-toolbar-item-group">
								<g:Button ui:field='newValueButton'
									styleName='aon-finding-toolbar-item aon-icon-reset' text="NUEVO VALOR"
									enabled="false" />
								<g:Button ui:field='saveButton'
									styleName='aon-finding-toolbar-item aon-icon-accept' text="GUARDAR"
									enabled="false" />
							</g:HTMLPanel>
						</g:HorizontalPanel>
					</g:HorizontalPanel>
				</g:FlowPanel>

			</g:FlowPanel>

		</g:north>

		<g:center>

			<g:HTMLPanel>

				<!-- DIALOG PARA SELECCIONAR QUE VARIABLES SE MUESTRAN -->
				<p:PaperDialog ui:field="showVariablesDialog" modal="true"
					entryAnimation="scale-up-animation" exitAnimation="fade-out-animation"
					withBackdrop="true">
					<a:CustomDialogBar ui:field="customDialogBarShowVariables"
						styleName="{style.marginTopCloseDialog}" caption="Variables mostradas" />
					<!-- p:PaperDialogScrollable ui:field="showVariablesContent"/ -->
					<g:HTMLPanel ui:field="showVariablesContent"></g:HTMLPanel>
					<HTMLPanel class="buttons">
						<p:PaperButton ui:field="showVariablesDialogCancel"
							attributes="dialog-dismiss">Cancel</p:PaperButton>
						<p:PaperButton ui:field="showVariablesDialogOk"
							attributes="dialog-confirm">OK</p:PaperButton>
					</HTMLPanel>
				</p:PaperDialog>

				<!-- PANEL CAMBIO DE AÑO -->
				<g:HorizontalPanel styleName="{style.paddingHorizontalPanel}">
					<g:Button
						styleName="{style.optionButtons} {style.optionButtonsLeft} aon-icon-previous"
						ui:field="lastYearButton" />
					<g:Label styleName="{style.year}" ui:field="yearLabel">2017</g:Label>
					<g:Button
						styleName="{style.optionButtons} {style.optionButtonsRight} aon-icon-next"
						ui:field="nextYearButton" />
				</g:HorizontalPanel>


				<g:DockLayoutPanel unit="PX" height="90%">
					<!-- DataGrid. -->
					<g:center>
						<g:ScrollPanel styleName="{style.scrollStyle}">
							<g:Grid ui:field="eventsGrid" styleName="{style.tableStyle} {style.noselect}">
								<!-- PARTE OCULTA PARA REDIMENSIONAR LA TABLA -->
								<g:row>
									<g:customCell styleName="{style.firstHeadStyleHide}">
										<g:Label></g:Label>
									</g:customCell>
									<g:customCell styleName="{style.cabeceraStyle}">
										<g:Label>ENERO</g:Label>
									</g:customCell>
									<g:customCell styleName="{style.cabeceraStyle}">
										<g:Label>FEBRERO</g:Label>
									</g:customCell>
									<g:customCell styleName="{style.cabeceraStyle}">
										<g:Label>MARZO</g:Label>
									</g:customCell>
									<g:customCell styleName="{style.cabeceraStyle}">
										<g:Label>ABRIL</g:Label>
									</g:customCell>
									<g:customCell styleName="{style.cabeceraStyle}">
										<g:Label>MAYO</g:Label>
									</g:customCell>
									<g:customCell styleName="{style.cabeceraStyle}">
										<g:Label>JUNIO</g:Label>
									</g:customCell>
									<g:customCell styleName="{style.cabeceraStyle}">
										<g:Label>JULIO</g:Label>
									</g:customCell>
									<g:customCell styleName="{style.cabeceraStyle}">
										<g:Label>AGOSTO</g:Label>
									</g:customCell>
									<g:customCell styleName="{style.cabeceraStyle}">
										<g:Label>SEPTIEMBRE</g:Label>
									</g:customCell>
									<g:customCell styleName="{style.cabeceraStyle}">
										<g:Label>OCTUBRE</g:Label>
									</g:customCell>
									<g:customCell styleName="{style.cabeceraStyle}">
										<g:Label>NOVIEMBRE</g:Label>
									</g:customCell>
									<g:customCell styleName="{style.cabeceraStyle}">
										<g:Label>DICIEMBRE</g:Label>
									</g:customCell>
								</g:row>
							</g:Grid>
						</g:ScrollPanel>
					</g:center>
				</g:DockLayoutPanel>
			</g:HTMLPanel>
		</g:center>
	</g:DockLayoutPanel>
</ui:UiBinder>
