<?xml version="1.0" encoding="UTF-8"?>
<module rename-to='aon_gwt_payroll' >
	<!-- Inherit the core Web Toolkit stuff.                        -->
	<inherits name='com.google.gwt.user.User' />
	<inherits name="com.google.gwt.i18n.I18N" />
	<inherits name="com.google.gwt.logging.Logging"/>

	<inherits name="com.google.gwt.json.JSON" />

	<inherits name='net.aonsolutions.gwt.pdfjs.PdfJs'/>
	<inherits name='com.esferalia.aon.gwt.common.Common'/>
	<inherits name="com.esferalia.aon.occam.api.Occam" />	
	<inherits name='com.esferalia.aon.gwt.codemirror.CodeMirror'/>
	<inherits name='com.esferalia.aon.js.payroll.Payroll'/>
	
	<!-- Chart Tools -->
	<inherits name='com.google.gwt.visualization.Visualization'/>
	<inherits name='com.esferalia.aon.gwt.visualization.Visualization'/>
		
	
	<!-- stylesheets eclipse them -->
	<stylesheet src="codemirror/theme/eclipse.css"/>
	<!-- stylesheets aon them -->
	<stylesheet src="codemirror/theme/aon.css"/>
	<!-- stylesheets merge them -->
	<stylesheet src="codemirror/addon/merge/merge.css"/>
	<!-- stylesheets fold gutter -->
	<stylesheet src="codemirror/addon/fold/foldgutter.css"/>
	<!-- stylesheets dialog  -->
	<stylesheet src="codemirror/addon/dialog/dialog.css"/>
	<!-- stylesheets search on scrollbar  -->
	<stylesheet src="codemirror/addon/search/matchesonscrollbar.css"/>


	<stylesheet src="aonReadOnly.css"/>

	<!-- Spanish language, independent of country -->
	<!--  extend-property name="locale" values="es" /-->
	<!-- English language, independent of country -->
	<!--  extend-property name="locale" values="en"/-->
	
	<!--  Spanish in Spain -->
	<extend-property name="locale" values="es_ES" />
	
	<set-property name="locale" value="es_ES"/>
	<set-property-fallback name="locale" value="es_ES"/> 

	<set-property name="user.agent" value="gecko1_8" />	
	<extend-property name="user.agent" values="safari" />
	<!--extend-property name="user.agent" values="ie8" /-->
	<!--extend-property name="user.agent" values="ie9" /-->
	<!-- extend-property name="user.agent" values="ie10" /-->

	<set-configuration-property name="locale.useragent" value="Y" />
	
	<!-- To change the  default logLevel -->
    <set-property name="gwt.logging.logLevel" value="SEVERE"/>   
	<!-- To disable logging -->
    <set-property name="gwt.logging.enabled" value="FALSE"/>          
    <!-- To disable a default Handler -->
    <set-property name="gwt.logging.consoleHandler" value="DISABLED"/> 
    
    <!-- Inherit the default GWT style sheet.  You can change       -->
	<!-- the theme of your GWT application by uncommenting          -->
	<!-- any one of the following lines.                            -->
	<inherits name='com.google.gwt.user.theme.clean.Clean' />
	<!-- <inherits name='com.google.gwt.user.theme.standard.Standard'/> -->
	<!-- <inherits name='com.google.gwt.user.theme.chrome.Chrome'/> -->
	<!-- <inherits name='com.google.gwt.user.theme.dark.Dark'/>     -->

	<!-- Other module inherits                                      -->

	<!-- Specify the app entry point class.                         -->
	<entry-point class='com.esferalia.aon.gwt.payroll.client.MainEntryPoint' />

	<!-- Specify the paths for translatable code                    -->
	<source path='client' />
	<source path='shared' />

</module>
