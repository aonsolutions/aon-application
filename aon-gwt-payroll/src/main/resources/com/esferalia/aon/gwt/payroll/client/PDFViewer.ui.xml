<ui:UiBinder xmlns:ui='urn:ui:com.google.gwt.uibinder'
	xmlns:g='urn:import:com.google.gwt.user.client.ui' 
	xmlns:p="urn:import:net.aonsolutions.gwt.pdfjs.client"
>

	<ui:style>
		.editor {
			width:100% !important;
			height:100% !important;
		}

		.document {
			margin-top: 5px;
			margin-left: auto;
			margin-right: auto;
			margin-bottom: 15px;
		}			
	</ui:style>
	<g:DockLayoutPanel unit="PX" >
		<g:north size="72"  >

			<g:FlowPanel >

				<g:MenuBar >
					<g:MenuItem text="Archivo">
						<g:MenuBar vertical="true">
							<g:MenuItem ui:field="saveMenuItem"  text="Guardar" />
						</g:MenuBar>
					</g:MenuItem>
				</g:MenuBar>
				
				<g:FlowPanel styleName="aon-finding-title-toolbar" >
					<g:HorizontalPanel >
						<g:HTMLPanel styleName="aon-finding-title">
							<g:HTMLPanel styleName="aon-finding-title-internal" >
								<g:Label styleName="aon-outputText" ui:field="titleLabel"></g:Label>
							</g:HTMLPanel>
						</g:HTMLPanel>
						<g:HTMLPanel styleName="aon-finding-subtitle">
							<g:HTMLPanel styleName="aon-finding-aubtitle-internal" >
								<g:Label styleName="aon-outputText" text=" "/> 
							</g:HTMLPanel>
						</g:HTMLPanel>
						<g:HorizontalPanel ui:field="toolBarPanel" styleName="aon-finding-toolbar" >
							<g:HTMLPanel styleName="aon-finding-toolbar-item-group">
								<g:ListBox debugId='zoomListBox' ui:field="zoomListBox" />
							</g:HTMLPanel>
							<g:HTMLPanel styleName="aon-finding-toolbar-item-group">
								<g:Button debugId='downloadButton' ui:field='downloadButton'
									styleName='aon-finding-toolbar-item aon-icon-mail-save' text="Descargar" />	
							</g:HTMLPanel>
							<g:HTMLPanel styleName="aon-finding-toolbar-item-group" ui:field="customToolBarPanel">
							</g:HTMLPanel>
							
						</g:HorizontalPanel>
					</g:HorizontalPanel>
				</g:FlowPanel>				

			</g:FlowPanel>

		</g:north>
		<g:center>
		    <g:ScrollPanel>
				<g:VerticalPanel styleName="{style.document}" ui:field="scrolledPanel" >
					<p:Viewer styleName="reset" ui:field='pdfViewer' /> 
				</g:VerticalPanel>
			</g:ScrollPanel>
		</g:center>
	</g:DockLayoutPanel>

</ui:UiBinder>
