<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
	xmlns:g='urn:import:com.google.gwt.user.client.ui'
	xmlns:c='urn:import:com.google.gwt.user.cellview.client'
	xmlns:p="urn:import:net.aonsolutions.gwt.pdfjs.client"	
	xmlns:w='urn:import:com.esferalia.aon.gwt.common.client.widget'
	xmlns:aon='urn:import:com.esferalia.aon.gwt.common.client.widget.solutions'>

	<ui:with field='res' type='com.esferalia.aon.gwt.common.client.css.AonResources'/>

	<ui:style type="com.esferalia.aon.gwt.payroll.client.AgreementPreview.MyStyle">
		
		.borderCollapse {
			border-collapse: collapse;
		}
		
		.borderBottom {
			border-bottom: 1px solid #eee;
		}
		
		.disclouruseTitle {
			color: #4b4b4b;
			vertical-align: top;
			min-width: 7rem;
			font-weight: bold;
			text-transform: uppercase;
			font-size: 1.1em;
		}
		
		.container {
			padding: 0.5rem 2rem 0;
		}
		
		.dateGap {
			gap: 0px !important;
			align-items: center;
		}
		
		.discContent {
			padding: .6rem 0 !important;
		}
		
		.flex {
			display: flex;
			gap: 1rem;
			align-items: center;
		}
		
		.flexTitle {
			display: flex;
			gap: 1rem;
			align-items: center;
			border-bottom: 1px solid #c1bebe;
		}
		
		.flexCenter {
			display: flex;
			justify-content: center;
		}
		
		.flexColumn{
			display: flex;
			flex-direction: column;
			gap: .1rem;
			border-left: none !important;
		}
		
		.hideScroll{}
		
		.hideScroll::-webkit-scrollbar {
			width: 1px;
			height: 6px;
			background-color: gray;
		}
		
		/* To hide the vertical scroll. */
		.hideScroll::-webkit-scrollbar:vertical {
			display: none;
		}
		
		.hideScroll::-webkit-scrollbar-thumb:horizontal {
			background: black;
		}
		
		.heigthAll {
			height: 100%;
		}
		
		.inputTitle {
			min-width: 7rem; 
			font-weight: bold;
			text-transform: uppercase;
			font-size: 1.1em;
		}
		
		.message {
			font-weight: bold;
		}	
		
		.textBox {
			width: auto;
			border: none;
		}	
				
		/* Class AgreementPreview.Style */
		
		.categoryWidth {
			width: 215px;
		}
		
		.cellWidth {
			min-width: 120px;
		}
		
		.columnBorder {
			border: 1px solid #eee;
			border-bottom: none;
		}
		
		.dateNoSelected {
			padding: .3rem;
			background-color: white;
			border: 1px solid #eee;
			font-weight: bold;
			cursor: pointer;
		}
		
		.dateSelected {
			background-color: #eee;
			border: 1px solid #eee;
		}
		
		.datePanel {
			gap: .3rem !important;
		}
		
		.dialogGlass {
			z-index: 7;
			background-color: #000;
			opacity: 0.2;
			filter: opacity(45%);
		}
		
		.dialogZIndex {
			z-index: 8;
		}
		
		.displayNone {
			display: none !important;
		}
		
		.extraCellHeight{
			height: 1.5rem;
		}
		
		.gridCell{
			text-transform: uppercase;
			text-align: center;
			min-width: 120px;
		}
		
		.gridTitle{
			text-transform: uppercase;
			font-weight: bold;
		}
		
		.headerColor {
			background-color: #eee;
		}
		
		.headerFixed {
			position: sticky;
  			top: 0;
  			height: 1.5rem;
			font-size: .7rem;
			background-color: #eee;
			/*min-width: 120px;*/
		}
		
		.headerFSize{
			font-size: .8em;
			text-align: left;
			padding-left: 0.5rem;
		}
		
		.headerLevelFixed {
			z-index: 5;
			position: sticky;
			top: 0;
			left: 0;
			height: 1.5rem;
			font-size: .7rem;
			background-color: #eee;
		}
		
		.levelCell {
			text-align: left;
			padding-left: 0.5rem;
		}
		
		.levelColumn {
			font-size: .7rem;
		}
		
		.levelDefaultValue {
			color: #5b93dc !important;
		}

		.levelFixed {
			position: sticky;
			left: 0;
			z-index: 2;
			font-size: .7rem;
			background-color: white;
		}
		
		.modify {
			background-color: lightyellow !important;
    		border: 0.5px solid yellow !important;
		}
		
		.oddRow {
			background-color: #f8f7f7;
		}
		
		.overflowEllipsis {
			white-space: nowrap;
  			overflow: hidden;
  			text-overflow: ellipsis;
  			width: 300px;
		}
		
		.textCenter {
			text-align: center;
		}
		
		.valueCell {
			text-align: right;
			padding-right: 0.5rem;
		}
		
		.widthAll {
			width: 100%;
		}
		
		
		
		.textBoxSalary {
			border-style: none;
			width: 95%;
			font-size: 0.8em !important;
			cursor: pointer;
		}
		
		.datePickerPanel{
			border: none !important;
    		box-shadow: none !important;
    		z-index: 6;
		}
		
		.headerDeleteFixed {
			z-index: 5;
			position: sticky;
			top: 0;
			right: 0;
			height: 1.5rem;
			font-size: .7rem;
			background-color: #eee;
		}
		
		.deleteFixed {
			position: sticky;
			right: 0;
			z-index: 2;
			font-size: .7rem;
			background-color: white;
		}
		
		.elipsis{
			text-overflow: ellipsis;
			overflow: hidden;
			white-space: nowrap;
			width: 95%;
		}
		
		@external modify;
		@external elipsis;
		
	</ui:style>
	
	<g:HTMLPanel styleName="{style.flexColumn} {style.heigthAll}">
		<g:HTMLPanel ui:field="messagePanel" />
		<g:DeckLayoutPanel ui:field="deckLayoutPanel" styleName="{style.heigthAll}">
			<!-- AGREEMENT PREVIEW -->
			<g:HTMLPanel styleName="{style.flexColumn}">
				<aon:AonToolbar ui:field="toolbar" />
				<g:HTMLPanel styleName="{style.flexColumn} {style.container}">
					<g:HTMLPanel styleName="{style.flex}">
						<g:Label text="Descripción" styleName="{style.inputTitle}" />
						<g:TextBox ui:field="description" styleName="{style.textBox} {style.widthAll}" />
					</g:HTMLPanel>
					<g:HTMLPanel styleName="{style.flex}">
						<g:Label text="Código SS" styleName="{style.inputTitle}" />
						<g:TextBox ui:field="ssNumber" styleName="{style.textBox}" />
						<g:HTMLPanel ui:field="serviAgreementPanel" styleName="{style.flex}" />
					</g:HTMLPanel>
					
					<!-- LEVEL / CATEGORY -->
					
					<g:DisclosurePanel ui:field="levelDiscPanel">
						<g:customHeader>
					   		<g:HTMLPanel styleName="{style.flexTitle}">
					   	  		<aon:AonToolbarButton ui:field="levelDiscBtn" />
					   	  		<g:Label styleName="{style.disclouruseTitle}">Nivel / Categoría</g:Label>
					   	 	</g:HTMLPanel>
					   	</g:customHeader>
					   
					   	<g:HTMLPanel styleName="{style.flexColumn} {style.discContent}" ui:field="levelDiscPanelContent">
					   		<g:ScrollPanel ui:field="levelScrollPanel" styleName="{style.hideScroll}">
								<g:Grid ui:field="levelGrid" styleName="{style.borderCollapse}" />
							</g:ScrollPanel>
							<g:HTMLPanel ui:field="agreementLevelMessage" styleName="{style.flexCenter}">
								<g:Label text="DEBE CREAR UN NIVEL PARA VISUALIZAR LA TABLA (+)" styleName="{style.message}" />
							</g:HTMLPanel>
					   	</g:HTMLPanel>
					</g:DisclosurePanel>
					
					<!-- SALARY TABLE -->
					
					<g:DisclosurePanel ui:field="salaryDiscPanel" >
						<g:customHeader>
					   		<g:HTMLPanel styleName="{style.flexTitle}">
					   	  		<aon:AonToolbarButton ui:field="salaryDiscBtn" debugId="agreementSalaryTableTabButton" />
					   	  		<g:Label styleName="{style.disclouruseTitle}">Tabla Salarial</g:Label>
					   	 	</g:HTMLPanel>
						</g:customHeader>
					   
					   	<g:HTMLPanel styleName="{style.flexColumn} {style.discContent} {style.dateGap}" ui:field="salaryDiscPanelContent">
					   		<g:ScrollPanel ui:field="salaryScrollPanel">
								<g:Grid ui:field="salaryGrid" styleName="{style.borderCollapse}" />
							</g:ScrollPanel>
							<g:HTMLPanel ui:field="agreementSalaryTableMessage" styleName="{style.flexCenter}">
								<g:Label text="DEBE CREAR UN TRAMO PARA VISUALIZAR LA TABLA SALARIAL (+)" styleName="{style.message}" />
							</g:HTMLPanel>
					   	</g:HTMLPanel>
					  </g:DisclosurePanel>
					  
					  <!-- PAYMENT -->
					  
					  <g:DisclosurePanel ui:field="paymentDiscPanel">
						  <g:customHeader>
						   	 <g:HTMLPanel styleName="{style.flexTitle}">
						   	  	<aon:AonToolbarButton ui:field="paymentDiscBtn" debugId="agreementPaymentTabButton" />
						   	  	<g:Label styleName="{style.disclouruseTitle}">Devengos</g:Label>
						   	 </g:HTMLPanel>
						   </g:customHeader>
						   
						   <g:HTMLPanel styleName="{style.flexColumn} {style.discContent} {style.widthAll}" ui:field="paymentDiscPanelContent">
						   		<g:ScrollPanel ui:field="paymentScrollPanel" styleName="{style.hideScroll}">
									<g:Grid ui:field="paymentGrid" debugId="agreementPaymentDG" styleName="{style.borderCollapse}" />
								</g:ScrollPanel>
								<g:HTMLPanel ui:field="agreementPaymentTableMessage" styleName="{style.flexCenter}">
									<g:Label text="DEBE CREAR UN DEVENGO PARA VISUALIZAR LA TABLA DE DEVENGOS (+)" styleName="{style.message}" />
								</g:HTMLPanel>
						   	</g:HTMLPanel>
					   </g:DisclosurePanel>
					   
					   <!-- EXTRA -->
					   
						<g:DisclosurePanel ui:field="paymentExtraDiscPanel">
							<g:customHeader>
								<g:HTMLPanel styleName="{style.flexTitle}">
						   	  		<aon:AonToolbarButton ui:field="paymentExtraDiscBtn" debugId="agreementPaymentExtraTabButton" />
						   	  		<g:Label styleName="{style.disclouruseTitle}">Extras</g:Label>
						   	 	</g:HTMLPanel>
						   	</g:customHeader>
						   	
						   	<g:HTMLPanel styleName="{style.flexColumn} {style.discContent} {style.widthAll}" ui:field="extraDiscPanelContent">
						   		<g:ScrollPanel ui:field="extraScrollPanel" styleName="{style.hideScroll}">
									<g:Grid ui:field="extraGrid" debugId="agreementExtraPaymentDG" styleName="{style.borderCollapse}" />
								</g:ScrollPanel>
								<g:HTMLPanel ui:field="agreementExtraTableMessage" styleName="{style.flexCenter}">
									<g:Label text="DEBE CREAR UN DEVENGO PARA VISUALIZAR LA TABLA DE EXTRAS (+)" styleName="{style.message}" />
								</g:HTMLPanel>
						   	</g:HTMLPanel>
					   </g:DisclosurePanel>
					
				</g:HTMLPanel>
			</g:HTMLPanel>
			
			<!-- AGREEMENT SIMULATOR -->
			<g:HTMLPanel styleName="{style.flexColumn}">
				<aon:AonToolbar ui:field="toolbarSimulator" />
				<p:FullViewer styleName="reset" ui:field='printPreviewViewer' debugId='printPreviewViewer' />
			</g:HTMLPanel>
			
		</g:DeckLayoutPanel>
	</g:HTMLPanel>
</ui:UiBinder> 

