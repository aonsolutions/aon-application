<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
	xmlns:g='urn:import:com.google.gwt.user.client.ui'
	xmlns:c='urn:import:com.google.gwt.user.cellview.client'
	xmlns:p="urn:import:net.aonsolutions.gwt.pdfjs.client"	
	xmlns:w='urn:import:com.esferalia.aon.gwt.common.client.widget'
	xmlns:aon='urn:import:com.esferalia.aon.gwt.common.client.widget.solutions'>

	<ui:with field='res' type='com.esferalia.aon.gwt.common.client.css.AonResources'/>

	<ui:style type="com.esferalia.aon.gwt.payroll.client.AgreementPreview.MyStyle">
		
		.borderCollapse {
			border-collapse: collapse;
		}
		
		.borderBottom {
			border-bottom: 1px solid #eee;
		}
		
		.container {
			padding: 0 1rem;
		}
		
		.dateGap {
			gap: 0px !important;
			align-items: center;
		}
		
		.discContent {
			padding: .6rem 0 !important;
		}
		
		.flex {
			display: flex;
			align-items: center;
		}
		
		.flexTitle {
			display: flex;
			gap: 1rem;
			align-items: center;
			border-bottom: 1px solid #c1bebe;
		}
		
		.flexCenter {
			display: flex;
			justify-content: center;
		}
		
		.flexColumn{
			display: flex;
			flex-direction: column;
			gap: .5rem;
			border-left: none !important;
		}
		
		.hideScroll{}
		
		.hideScroll::-webkit-scrollbar {
			width: 1px;
			height: 6px;
			background-color: gray;
		}
		
		/* To hide the vertical scroll. */
		.hideScroll::-webkit-scrollbar:vertical {
			display: none;
		}
		
		.hideScroll::-webkit-scrollbar-thumb:horizontal {
			background: black;
		}
		
		.heigthAll {
			height: 100%;
		}
		
		.inputTitle {
			min-width: 7rem; 
			font-weight: bold;
			text-transform: uppercase;
			font-size: 1.1em;
		}
		
		.message {
			font-weight: bold;
		}	
		
		.textBox {
			width: auto;
			border: none;
		}	
				
		/* Class AgreementPreview.Style */
		
		.categoryWidth {
			width: 215px;
		}
		
		.cellWidth {
			min-width: 120px;
		}
		
		.columnBorder {
			border: 1px solid #eee;
			border-bottom: none;
		}
		
		.dateNoSelected {
			padding: .3rem;
			background-color: white;
			border: 1px solid #eee;
			font-weight: bold;
			cursor: pointer;
		}
		
		.dateSelected {
			background-color: #eee;
			border: 1px solid #eee;
		}
		
		.datePanel {
			gap: .3rem !important;
		}
		
		.dialogGlass {
			z-index: 7;
			background-color: #000;
			opacity: 0.2;
			filter: opacity(45%);
		}
		
		.dialogZIndex {
			z-index: 8;
		}
		
		.displayNone {
			display: none !important;
		}
		
		.extraCellHeight{
			height: 1.5rem;
		}
		
		.gridCell{
			text-transform: uppercase;
			text-align: center;
			min-width: 120px;
		}
		
		.gridTitle{
			text-transform: uppercase;
			font-weight: bold;
		}
		
		.headerColor {
			background-color: #eee;
		}
		
		.headerFixed {
			position: sticky;
  			top: 0;
  			height: 1.5rem;
			background-color: #eee;
			/*min-width: 120px;*/
		}
		
		.headerFSize{
			font-size: .8em;
			text-align: left;
			padding-left: 0.5rem;
		}
		
		.headerLevelFixed {
			z-index: 5;
			position: sticky;
			top: 0;
			left: 0;
			height: 1.5rem;
			background-color: #eee;
		}
		
		.levelCell {
			text-align: left;
			padding-left: 0.5rem;
		}
		
		.levelDefaultValue {
			color: #5b93dc !important;
		}

		.levelFixed {
			position: sticky;
			left: 0;
			z-index: 2;
			background-color: white;
		}
		
		.modify {
			background-color: lightyellow !important;
    		/*border: 0.5px solid yellow !important;*/
		}
		
		.oddRow {
			background-color: #f8f7f7;
		}
		
		.overflowEllipsis {
			white-space: nowrap;
  			overflow: hidden;
  			text-overflow: ellipsis;
  			width: 300px;
		}
		
		.textCenter {
			text-align: center;
		}
		
		.valueCell {
			text-align: right;
			padding-right: 0.5rem;
		}
		
		.widthAll {
			width: 100%;
		}
		
		
		
		.textBoxSalary {
			border-style: none;
			width: 85%;
			cursor: pointer;
		}
		
		.datePickerPanel{
			border: none !important;
    		box-shadow: none !important;
    		z-index: 6;
		}
		
		.headerDeleteFixed {
			z-index: 5;
			position: sticky;
			top: 0;
			right: 0;
			height: 1.5rem;
			background-color: #eee;
		}
		
		.deleteFixed {
			position: sticky;
			right: 0;
			z-index: 2;
			background-color: white;
		}
		
		.elipsis{
			text-overflow: ellipsis;
			overflow: hidden;
			white-space: nowrap;
			padding: 0 .5rem;
		}
		
		.elipsisConceptWidth{
			width: 180px;
		}
		
		.elipsisOpenCollapseWidth{
			width: 320px;
		}
		
		.elipsisCloseCollapseWidth{
			width: 410px;
		}
		
		.elipsisOpenCollapseExtraWidth{
			width: 210px;
		}
		
		.elipsisCloseCollapseExtraWidth{
			width: 300px;
		}
		
		.zIndex1 {
			z-index: 1;
		}
		
		.gap0{
			gap: 0;
		}
		
		.p1{
			padding: 0 .5rem 1rem .5rem;
		}
		
		.p0{
			padding: 0;
		}
		
		.p5{
			padding: 5px;
		}
		
		.gap05{
			gap: 0.5rem;
		}
		
		.unSelectDate {
			padding: 5px;
			border: 1px solid #eee;
			border-bottom: none;
			cursor: pointer;
		}
		
		.selectDate {
			padding: 0px 5px;
			border: 1px solid #eee;
			border-bottom: none;
			background-color: #eee;
			cursor: pointer;
		}
		
		@external modify;
		@external elipsis;
		
	</ui:style>
	
	<g:HTMLPanel styleName="{style.flexColumn} {style.heigthAll}">
		<g:HTMLPanel ui:field="messagePanel" />
		<g:DeckLayoutPanel ui:field="deckLayoutPanel" styleName="{style.heigthAll}">
			<!-- AGREEMENT PREVIEW -->
			<g:HTMLPanel styleName="{style.flexColumn}">
				<aon:AonToolbar ui:field="toolbar" />
		
				<g:ScrollPanel ui:field="scrollPanel" styleName="{style.p1}">
				
					<g:HTMLPanel styleName="{style.flexColumn} {style.container}">
						<g:HTMLPanel styleName="{style.flexColumn} {style.gap0}">
							<g:HTMLPanel styleName="{style.flex}">
								<g:Label text="Descripción" styleName="{style.inputTitle}" />
								<g:TextBox ui:field="description" styleName="{style.textBox} {style.widthAll}" debugId="descriptionTextBox" />
							</g:HTMLPanel>
							<g:HTMLPanel styleName="{style.flex}">
								<g:Label text="Código SS" styleName="{style.inputTitle}" />
								<g:TextBox ui:field="ssNumber" styleName="{style.textBox}" debugId="ssNumberTextBox" />
								<g:HTMLPanel ui:field="serviAgreementPanel" styleName="{style.flex}" />
							</g:HTMLPanel>
						</g:HTMLPanel>
						
						<!-- LEVEL / CATEGORY && SALARY TABLE -->
						<g:HTMLPanel styleName="{style.flexColumn}">
							<aon:AonToolbarSmall ui:field="levelSalaryToolbar" />
							<g:HTMLPanel styleName="{style.flexColumn} {style.gap0}">
								<g:HTMLPanel ui:field="levelSalaryTabs" styleName="{style.flex} {style.gap05}" />
								<g:DeckPanel ui:field="levelSalaryDeck">
									<g:ScrollPanel ui:field="levelScrollPanel" styleName="{style.hideScroll} {style.flexCenter}">
										<g:Grid ui:field="levelGrid" styleName="{style.borderCollapse}" />
									</g:ScrollPanel>
									<g:ScrollPanel ui:field="salaryScrollPanel">
										<g:Grid ui:field="salaryGrid" styleName="{style.borderCollapse}" />
									</g:ScrollPanel>
									<g:HTMLPanel styleName="{style.flexCenter}">
										<g:Label text="DEBE CREAR UN NIVEL PARA VISUALIZAR LA TABLA (+)" styleName="{style.message}" />
									</g:HTMLPanel>
									<g:HTMLPanel styleName="{style.flexCenter}">
										<g:Label text="DEBE CREAR UN TRAMO PARA VISUALIZAR LA TABLA SALARIAL (+)" styleName="{style.message}" />
									</g:HTMLPanel>
								</g:DeckPanel>
							</g:HTMLPanel>
						</g:HTMLPanel>
						  
						  <!-- PAYMENT -->
						  
						  <g:HTMLPanel styleName="{style.flexColumn}">
						  	<aon:AonToolbarSmall ui:field="paymentToolbar" />
						  	<g:DeckPanel ui:field="paymentDeck">
						  		<g:Grid ui:field="paymentGrid" debugId="agreementPaymentDG" styleName="{style.borderCollapse} " />
								<g:HTMLPanel styleName="{style.flexCenter}">
									<g:Label text="DEBE CREAR UN DEVENGO PARA VISUALIZAR LA TABLA DE DEVENGOS (+)" styleName="{style.message}" />
								</g:HTMLPanel>
						  	</g:DeckPanel>
						  </g:HTMLPanel>
						   
						   <!-- EXTRA -->
						   
						   <g:HTMLPanel styleName="{style.flexColumn}">
						  	<aon:AonToolbarSmall ui:field="extraToolbar" />
						  	<g:DeckPanel ui:field="extraDeck">
						  		<g:Grid ui:field="extraGrid" debugId="agreementExtraPaymentDG" styleName="{style.borderCollapse}" />
								<g:HTMLPanel ui:field="agreementExtraTableMessage" styleName="{style.flexCenter}">
									<g:Label text="DEBE CREAR UN DEVENGO PARA VISUALIZAR LA TABLA DE EXTRAS (+)" styleName="{style.message}" />
								</g:HTMLPanel>
						  	</g:DeckPanel>
						  </g:HTMLPanel>
						   
					</g:HTMLPanel>
				</g:ScrollPanel>
			</g:HTMLPanel>
			
			<!-- AGREEMENT SIMULATOR -->
			<g:HTMLPanel styleName="{style.flexColumn}">
				<aon:AonToolbar ui:field="toolbarSimulator" />
				<p:FullViewer styleName="reset" ui:field='printPreviewViewer' debugId='printPreviewViewer' />
			</g:HTMLPanel>
			
		</g:DeckLayoutPanel>
	</g:HTMLPanel>
</ui:UiBinder> 

