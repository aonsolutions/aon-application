<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
	xmlns:g='urn:import:com.google.gwt.user.client.ui'
	xmlns:p="urn:import:net.aonsolutions.gwt.pdfjs.client"
	xmlns:aon='urn:import:com.esferalia.aon.gwt.common.client.widget.solutions'>

	<ui:with field='res' type='com.esferalia.aon.gwt.common.client.css.AonResources' />

	<ui:style type="com.esferalia.aon.gwt.payroll.client.MainMassiveContracts.MyStyle">
	
		.container { margin: 0 1rem; }
		
		.dockLayoutPanel { margin: 1rem 0; }
		
		.emptyMessage{
			text-align: center;
			text-transform: uppercase;
			font-weight: bold;
			padding-top: .5rem;
		}
		
		.filterPanel{
			display: flex;
			justify-content: space-between;
			margin: auto 15px;
		}
		
		.flex{
			display: flex;
			align-items: center;
			gap: .5rem;
		}
	
		.flexColumn {
			display: flex;
			flex-direction: column;
			gap: .5rem;
		}
		
		.gridTitle{
			text-transform: uppercase;
			font-weight: bold;
		}
		
		.headerFixed {
			position: sticky;
  			top: 0;
  			height: 1.5rem;
			background-color: #eee;
		}
		
		.headerFSize{
			font-size: .8em;
			text-align: left;
			padding-left: 0.5rem;
		}
		
		.heigthAll { height: 100%; }
		
		.heigthAuto { height: auto !important; }
		
		.modify { background-color: lightyellow !important; }
		
		.oddRow { background-color: #f8f7f7; }
		
		.pl05{ padding-left: 0.5rem; }
		
		.widthAll { width: 100%; }
		
		@external dockLayoutPanel;
		
	</ui:style>

	<g:DockLayoutPanel ui:field="dockLayoutPanel" styleName="{style.dockLayoutPanel}" unit="PX">
		<g:north size="50">
			<aon:AonToolbar ui:field="toolbar" />
		</g:north>
		<g:center>
			<g:HTMLPanel styleName="{style.flexColumn}">
				<g:HTMLPanel ui:field="messagePanel" />
				<g:HTMLPanel ui:field="filterEmployeePanel" styleName="{style.container}" />
				
				<g:HTMLPanel styleName="{style.flexColumn} {style.container}">
					<g:Grid ui:field="contractsDataTableHeader" styleName="{style.widthAll}" />
		    		<g:ScrollPanel ui:field="scrollPanel">
		    			<g:DeckPanel styleName="{style.widthAll} {style.heigthAll}" ui:field="deckPanel">
		    				<g:Grid ui:field="contractDataTable" styleName="{style.heigthAuto}"/>
		    				<g:Label text="No existe contratos para este filtro" styleName="{style.emptyMessage}" />
		    				<g:Label text="No existen contratos inativos para realizar un llamamiento" styleName="{style.emptyMessage}" />
		    			</g:DeckPanel>
		    		</g:ScrollPanel>
				</g:HTMLPanel>
			
			</g:HTMLPanel>
			
		</g:center>
	</g:DockLayoutPanel>
	
</ui:UiBinder> 

