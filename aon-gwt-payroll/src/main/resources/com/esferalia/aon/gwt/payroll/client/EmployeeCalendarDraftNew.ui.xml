	<ui:style type="com.esferalia.aon.gwt.payroll.client.EmployeeCalendarDraftNew.MyStyle">

		/* ------------------- Menu Bar ------------------- */
		.menuBar{
			cursor: pointer;
			display: grid;
			border-right: #808080 1px solid;
		}

		.findingTitleCalendar{
			width: 90px !important;
		}

		.findingTitleEdition{
			width: 65px !important;
		}

		.bold{
			text-transform: uppercase;
			font-size: 0.8em;
			font-weight: bold;
			padding: 4px;
		}

		/* ------------------- Year Panel ------------------- */
		.aonCheck{
			background-position: .2rem .2rem !important;
		}

		/* ------------------- Days Type Panel ------------------- */

		.daysTypePanel{
			margin: 1rem;
			display: flex;
			justify-content: space-between;
			border-bottom: .1rem solid #ff704d;
			padding: .3rem 0;
			flex-wrap: wrap;
		}

		.typeButtonUpperMenuStyle{
    		border-radius: 8%;
			border: none;
			margin-right: .3rem;
			color: white;
			padding: .3rem .4rem;
			cursor: pointer;
		}

		.aonButtonStyle{
			background-color: #e1e1e1;
			border: none;
			padding: 0 .5rem 0 1.5rem;
			height: 1.4rem;
			border-radius: 8%;
			background-position: .2rem;
			margin-right: .3rem;
			cursor: pointer;
		}

		.aonButtonStyleWithOutIcon {
			padding: 0 .5rem 0 .5rem;
		}

		.eraseEventStyle{
			padding: 0 0.5rem 0 1.8rem;
		}

		.aon-toolbar-button {
		    height: 24px;
		    padding-left: 25px;
		    background-position: .2rem;
		    background-repeat: no-repeat;
		    background-color: #f6f6f6;
		    background-size: 20px;
		}

		/* ------------------- Color Days Type Panel ------------------- */

		.workingColor {
			background-color: #f6f6f6;
			color: black;
		}

		.noWorkingColor{
			background-color: salmon;
		}

		.inactivityColor{
			background-color: #71b1e8;
		}

		.dropColor{
			background-color: #733969;
		}

		.holidayColor{
			background-color: green;
		}

		.leaveColor{
			background-color: red;
		}

		.partialityColor{
			background-color: #9c85ee;
		}

		.peonadasColor{
			background-color: #d692f9;
		}

		.effectiveColor{
			background-color: #77e1d2;
		}

		/* ------------------- Calendar Panel ------------------- */

		.tableStyle {
			border-collapse: collapse;
			margin-left: 0.8em;
			width: 97%;
		}

		.tableStyle td {
			text-align: center;
			border-bottom: 1px solid #ddd;
		}

		.noselect {
			-webkit-touch-callout: none; /* iOS Safari */
			-webkit-user-select: none; /* Safari */
			-khtml-user-select: none; /* Konqueror HTML */
			-moz-user-select: none; /* Firefox */
			-ms-user-select: none; /* Internet Explorer/Edge */
			user-select: none; /* Non-prefixed version, currently supported by Chrome and Opera */
		}

		.cabeceraStyle {
			font-weight: bold;
			background-color: transparent;
			padding: .2rem;
		}

		.mesesImparesStyle {
			background-color: #eee;
		}

		.labelStyle{
			width: 20px;
			height: 20px;
		}

		/* ------------------- Selected Days ------------------- */

		.isSelectedStyle {
			background-color: #166ef3 !important;
			color: #ffffff !important;
			border-radius: 0px !important;
			padding: .3rem .2rem !important;
		}

		.onChange {
