		}

		.cursorPointer{
			cursor: pointer;
			display: flex;
			align-items: center;
			justify-content: center;
			margin: 0 auto;
		}

		.outOfContractStyle {
			color: #aaa;
			cursor: auto;
		}

		.hide{
			display : none;
		}

		.flex{
			display: flex;
			align-items: center;
		}

		.cmdBtn{
			background-position: center left;
			background-repeat: no-repeat;
			padding-left: 25px !important;
			background-size: contain;
		}

		.flexColumn{
			display: flex;
			flex-direction: column;
		}

		.container{
			width: 100%;
			min-width: 600px;
			height: 100%;
		}

		.mt50{
			margin-top: 50px;
		}

