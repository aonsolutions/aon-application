	<ui:style type="com.esferalia.aon.gwt.payroll.client.EmployeeCalendarDraftNew.MyStyle">
	
		/* ------------------- Menu Bar ------------------- */
		.menuBar{
			cursor: pointer;
			display: grid;
			border-right: #808080 1px solid;
		}
		
		.findingTitleCalendar{
			width: 90px !important;
		}
		
		.findingTitleEdition{
			width: 65px !important;
		}
		
		.bold{
			text-transform: uppercase;
			font-size: 0.8em;
			font-weight: bold;
			padding: 4px;
		}
	
		/* ------------------- Year Panel ------------------- */
		.aonCheck{
			background-position: .2rem .2rem !important;
		}
	
		/* ------------------- Days Type Panel ------------------- */
		
		.daysTypePanel{
			margin: 1rem;
			display: flex;
			justify-content: space-between;
			border-bottom: .1rem solid #ff704d;
			padding: .3rem 0;
		}
		
		.typeButtonUpperMenuStyle{
    		border-radius: 8%;
			border: none;
			margin-right: .3rem;
			color: white;
			padding: .3rem .4rem;
			cursor: pointer;
		}
		
		.aonButtonStyle{
			background-color: #e1e1e1;
			border: none;
			padding: 0 .5rem 0 1.5rem;
			height: 1.4rem;
			border-radius: 8%;
			background-position: .2rem;
			margin-right: .3rem;
			cursor: pointer;
		}
		
		.aonButtonStyleWithOutIcon {
			padding: 0 .5rem 0 .5rem;
		}
		
		.eraseEventStyle{
			padding: 0 0.5rem 0 1.8rem;
		}
		
		/* ------------------- Color Days Type Panel ------------------- */
		
		.noWorkingColor{
			background-color: salmon;
		}
		
		.inactivityColor{
			background-color: #71b1e8;
		}
		
		.dropColor{
			background-color: #733969;
		}

		.holidayColor{
			background-color: green;
		}
		
		.partialityColor{
			background-color: #9c85ee;
		}

		.peonadasColor{
			background-color: #d692f9;
		}
		
		/* ------------------- Calendar Panel ------------------- */
		
		.tableStyle {
			border-collapse: collapse;
			margin-left: 0.8em;
			width: 97%;	
		}
		
		.tableStyle td {
			text-align: center;
			border-bottom: 1px solid #ddd;
		}
		
		.noselect {
			-webkit-touch-callout: none; /* iOS Safari */
			-webkit-user-select: none; /* Safari */
			-khtml-user-select: none; /* Konqueror HTML */
			-moz-user-select: none; /* Firefox */
			-ms-user-select: none; /* Internet Explorer/Edge */
			user-select: none; /* Non-prefixed version, currently supported by Chrome and Opera */
		}
		
		.cabeceraStyle {
			font-weight: bold;
			background-color: transparent;
			padding: .2rem;
		}
		
		.mesesImparesStyle {
			background-color: #eee;
		}
		
		.labelStyle{
			padding: .3rem .2rem;
			width: 16px;
			height: 16px;
		}
		
		/* ------------------- Selected Days ------------------- */
		
		.isSelectedStyle {
			background-color: #166ef3 !important;
			color: #ffffff !important;
			border-radius: 0px !important;
			padding: .3rem .2rem !important;
		}
		
		.onChange {
			background-color: rgba(255, 255, 0, 0.38);
		}
		
		.dayTypeButton{
			border-radius: 20%;
			padding: 3px;
			color: #ffffff;
		}

		.nonWorkingStyle{
			background-color: salmon;
		}
		
		.inactivityStyle {
			background-color: #71b1e8;
		}
		
		.holidayStyle {
			background-color: #52ab3c;
		}
		
		.partialityStyle {
			background-color: #9c85ee;
		}
		
		.dropStyle {
			background-color: #733969;	
		}
		
		.strikeStyle {
			background-color: #a09c13;
		}
		
		.ereStyle {
			background-color: #b91257;
		}
		
		.ereFzaStyle {
			background-color: rgba(185, 18, 87, 0.7);
		}
		
		.ereFzaExonStyle {
			background-color: rgba(185, 18, 87, 0.4);
		}

		.peonadasStyle {
			background-color: #d692f9;
		}
		
		.itStyle {
			background-color: rgba(255, 0, 0, 0.72);
		}
		
		.freeDayStyle{
			background-color: #445a69;
		}
		
		/* ------------------- Hour Days ------------------- */
		
		.hourStyle{
			padding: .2rem;
			border: none;
			text-align: center;
			background-color: transparent;
			width: 16px;
			height: 16px;
		}
		
		/* ------------------- Utilities ------------------- */
		
		.selectedStyle{
			background-color: #166ef3 !important;
			color: #ffffff !important;
			border-radius: 0px !important;
			padding: 3px !important;
		}
		
		.onChange{
			background-color: rgba(255, 255, 0, 0.38);
		}
		
		.cursorPointer{
			cursor: pointer;
		}
		
		.outOfContractStyle {
			color: #aaa;
			cursor: auto;
		}
		
		.hide{
			display : none;
		}
		
		.flex{
			display: flex;
			align-items: center;
		}
		
		.cmd_btn{
			background-position: center left;
			background-repeat: no-repeat;
			padding-left: 25px !important;
			background-size: contain;
		}	
		
		.flexColumn{
			display: flex;
			flex-direction: column;
		}
		
		.container{
			width: 100%;
			min-width: 600px;
			height: 100%;
		}
		
		.mt50{
			margin-top: 50px;
		}

