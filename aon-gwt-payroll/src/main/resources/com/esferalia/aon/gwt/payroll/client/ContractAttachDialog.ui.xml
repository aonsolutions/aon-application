<ui:UiBinder 
    xmlns:ui='urn:ui:com.google.gwt.uibinder'
	xmlns:g='urn:import:com.google.gwt.user.client.ui'
	xmlns:a='urn:import:com.esferalia.aon.gwt.common.client.widget'
	xmlns:aon='urn:import:com.esferalia.aon.gwt.common.client.widget.solutions'>
    
    
	<ui:style type="com.esferalia.aon.gwt.payroll.client.ContractAttachDialog.MyStyle">
	
		.form {
			display: flex;
			flex-direction: column;
			min-width: 350px;
			gap: 10px;
			padding-top: .5rem;
		}
		
		.padding {
			padding: 10px;
			padding-top: 0px;
		}
		
		.flexColumn{
			display: flex;
			flex-direction: column;
			gap: 10px;
		}
		
		.input{
			display: flex;
			flex-direction: column;
			gap: 5px;
		}
		
		.inputHeight{
			height: 1.4rem !important;
		}
		
		.title{
			font-size: 11px;
			font-weight: bold;
		}
		
		.flex{
			display: flex;
			align-items: center;
			gap: 10px;
		}
		
		.flexBetween{
			display: flex;
			justify-content: space-between;
			width: 100%;
		}
		
		.buttonsPanel{
			display: flex;
			justify-content: flex-end;
			gap: 10px;
			margin-top: 10px;
		}
		
		.widthAll{
			width: 100%;
		}
		
		.checkBox input {
			width: 1rem;
			height: 1rem;
		}
		
		.noGap {
			gap: 0;
		}
		
		.security {
			width: 1.2rem;
			height: 1.2rem;
			background-size: cover;
		}
		
		.pl1{
			padding-left: 1rem;
		}
		
		.cursorDefualt{
			cursor: default !important;
		}
		
		.textCenter{
			text-align: center !important;
		}
		
		.footerButton{
			background-attachment: scroll;
			background-clip: border-box;
			background-color: inherit;
			background-position: 1px -2px;
			background-repeat: no-repeat;
			background-size: auto auto;
			border: 1px solid #aaa;
			cursor: pointer;
			height: 24px;
			overflow: visible;
			padding-left: 25px;
			text-align: left;
			text-transform: uppercase;
			width: auto;
		}
		
	</ui:style>

	<g:HTMLPanel ui:field="mainPanel" styleName="{style.form}">
	
		<g:HTMLPanel ui:field="messagePanel" />
	
		<g:HTMLPanel ui:field="formPanel" styleName="{style.flexColumn} {style.padding}">
		
			<g:HTMLPanel styleName="{style.flexColumn}">
				
				<g:HTMLPanel styleName="{style.input}">
					<g:Label text="Descripción" styleName="{style.title}" />
					<g:HTMLPanel ui:field="filePanel" styleName="{style.flex}">
						<g:TextBox ui:field="descriptionTB" styleName="{style.widthAll} {style.inputHeight}" />
					</g:HTMLPanel>
				</g:HTMLPanel>
				
				<g:HTMLPanel styleName="{style.input}">
					<g:Label text="Tipo documento" styleName="{style.title}" />
					<g:ListBox ui:field="typeLB" styleName="{style.widthAll} {style.inputHeight}" />
				</g:HTMLPanel>
				
				<g:HTMLPanel styleName="{style.input}">
					<g:Label text="Visibiliadad" styleName="{style.title}" />
					<g:HTMLPanel ui:field="visibilityPanel"/>
				</g:HTMLPanel>

				<g:HTMLPanel styleName="{style.input}">
					<g:Label text="Fecha" styleName="{style.title}" />
					<aon:AonDateBox ui:field="dateBox" styleName="{style.inputHeight} {style.textCenter}" />
				</g:HTMLPanel>
				
				<g:HTMLPanel styleName="{style.input}">
					<g:Label text="Ámbito" styleName="{style.title}" />
					<g:ListBox ui:field="scopeLB" styleName="{style.widthAll} {style.inputHeight}" />
				</g:HTMLPanel>
								
			</g:HTMLPanel>
			
		   	<g:HTMLPanel ui:field="buttonsPanel" styleName="{style.buttonsPanel}" />
		   	
		</g:HTMLPanel>

	</g:HTMLPanel>

</ui:UiBinder>