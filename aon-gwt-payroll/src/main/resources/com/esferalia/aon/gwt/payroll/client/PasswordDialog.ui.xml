<ui:UiBinder xmlns:ui='urn:ui:com.google.gwt.uibinder'
	xmlns:g='urn:import:com.google.gwt.user.client.ui'
	xmlns:datepicker='urn:import:com.google.gwt.user.datepicker.client'>

	<ui:with field='msgs' type='com.esferalia.aon.gwt.payroll.client.i18n.PayrollMessages'/>

	<ui:Style>

		.form {
			padding: 10px;
		}


		.field {
			padding: 1px 0.5em;
		}

		.buttons {
			padding-top: 10px;
			text-align: right;
		}

		.info {
		}

		.warn {
		}

		.error {
		}

		.messages {
			padding-left: 0.5em;
			padding-bottom: 10px;
		}


	</ui:Style>
	<g:HTMLPanel styleName="{style.form}">

		<div class="{style.messages}" >
			<g:Label styleName="{style.info}" ui:field="messageLabel"></g:Label>
		</div>

		<g:Grid width="100%" >
			<g:row>
				<g:customCell styleName="{style.field}"><g:PasswordTextBox  width="100%" ui:field="passwordTextBox"/></g:customCell>
			</g:row>
		</g:Grid>

		<div class="{style.buttons}">
			<g:Button ui:field="cancelButton" >{msgs.cancel}</g:Button>
			<g:Button ui:field="acceptButton">{msgs.accept}</g:Button>
		</div>

	</g:HTMLPanel>


</ui:UiBinder>
