<ui:UiBinder xmlns:ui='urn:ui:com.google.gwt.uibinder'
	xmlns:g='urn:import:com.google.gwt.user.client.ui' 
	xmlns:employee='urn:import:com.esferalia.aon.gwt.payroll.client'
	xmlns:common='urn:import:com.esferalia.aon.gwt.common.client.widget'
	xmlns:commonsolutions='urn:import:com.esferalia.aon.gwt.common.client.widget.solutions'>


	<ui:style>
	
	.employees img {
		filter: grayscale(100%) contrast(200%);
	}
	
	</ui:style>


	<g:DockLayoutPanel unit='PX' >
		<g:north size="50">
			<commonsolutions:AonEmployeesTreeToolbar ui:field="toolbar" />
		</g:north>

		<g:center>
			<g:ScrollPanel styleName="{style.employees}"  ui:field="scrollPanel" debugId="employeesScrollPanel">
				<g:Tree  ui:field="tree" debugId="employeesTree"/>
			</g:ScrollPanel>
		</g:center>
	</g:DockLayoutPanel>

</ui:UiBinder>
