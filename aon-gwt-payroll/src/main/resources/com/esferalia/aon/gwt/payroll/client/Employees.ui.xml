<ui:UiBinder xmlns:ui='urn:ui:com.google.gwt.uibinder'
	xmlns:g='urn:import:com.google.gwt.user.client.ui' 
	xmlns:employee='urn:import:com.esferalia.aon.gwt.payroll.client'
	xmlns:aon='urn:import:com.esferalia.aon.gwt.common.client.widget.solutions'>


	<ui:style type="com.esferalia.aon.gwt.payroll.client.Employees.MyStyle">
	
		.animate {
			transition: 0.5s;
		}
	
		.aon-EmployeesPanel img {
			filter: grayscale(100%) contrast(200%);
		}
		
		.aon-EmployeesTree  {
			text-transform: uppercase;
		}

		.flex {
			display: flex;
			gap: .5rem;
			align-items: center;
		}
		
		.flexColumn {
			display: flex;
			flex-direction: column;
			gap: .5rem;
		}
		
		.staticEmployees {
			position: fixed !important;
			width: 290px !important;
			height: 90% !important;
			z-index: 1;
		}
		
		.aon-EmployeesToolbar-Title {
			text-transform: uppercase;
		}
		
		.heightAll { height: 100%; }
		
		@external aon-EmployeesTree;
		@external aon-EmployeesToolbar-Title;
	
	</ui:style>


	<g:DockLayoutPanel unit='PX' styleName="{style.animate}" >
		<g:center >
			<g:DeckPanel ui:field="employeesDeck">
				<g:HTMLPanel styleName="{style.flexColumn}" ui:field="dynamicEmployees">
					<g:HTMLPanel styleName="{style.flex}" ui:field="employeesToolbar"/>
					<aon:AonEmployeesTreeToolbar ui:field="toolbar" />
					<g:ScrollPanel styleName="{style.aon-EmployeesPanel} {style.heightAll}"  ui:field="scrollPanel" debugId="employeesScrollPanel">
						<g:Tree  ui:field="tree" debugId="employeesTree"  styleName="{style.aon-EmployeesTree} gwt-Tree" />
					</g:ScrollPanel>
				</g:HTMLPanel>
				
				<g:HTMLPanel ui:field="staticEmployees" styleName="{style.flexColumn}" />
			
			</g:DeckPanel>
			
		</g:center>
	</g:DockLayoutPanel>

</ui:UiBinder>
