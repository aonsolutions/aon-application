


<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
	xmlns:g='urn:import:com.google.gwt.user.client.ui'
	xmlns:a='urn:import:com.esferalia.aon.gwt.common.client.widget'>

	<ui:with field='msgs' type='com.esferalia.aon.gwt.payroll.client.i18n.PayrollMessages'/>
	<ui:with field='res' type='com.esferalia.aon.gwt.common.client.css.AonResources' />

	<ui:style type="com.esferalia.aon.gwt.payroll.client.Employee.MyStyle">



		.agreementTitle {
			height: 40px;
			align-items: center;
			display: flex;
		}

		.alignTextCenter { text-align: center; }

		.aonEmployeeCardLabel{
			min-width: 200px;
			padding: 5px;
			background-color: #f6f6f6;
		}

		.flex{
			display: flex;
			align-items: center;
			width: 100%;
			margin: 2px 0;
			gap: 5px;
		}

		.flexColumn{
			display: flex;
			justify-content: center;
			align-items: center;
			flex-direction: column;
		}

		.flexBetween{
			display: flex;
			justify-content: space-between;
			align-items: center;
		}

		.flexItem{
			display: flex;
			align-items: center;
			gap: .5rem;
		}

		.firstColumnTextStyle { padding: 5px !important; }

		.heightTB { height: 1.1rem; }

		.mt20 { margin-top: 20px; }

		.mw { min-width: fit-content; }

		.aonEmployeeCardRequired{
			color: #2152A5;
			font-weight: bold !important;
		}

		.shortTB { width: 70px; }

		.aonEmployeeCard {
			border: 1px solid black;
			border-radius: 5px;
			padding: 0 1rem .5rem;
		}

		.aonEmployeeCardTitle {
			position: relative;
			top: -10px;
			left: 20px;
			width: 130px;
			padding: 0 5px;
			background-color: white;
			font-size: 12px;
			font-weight: bold;
			text-align: center;
		}

		.widthAll { width: 100% !important; }

		/* INNER CLASS */

		.errorBorder { border: 1px solid red !important; }

		.journeyDurationWarning{
			font-weight: bold;
			font-size: 11px;
			cursor: pointer;
		}

		.warningTB { border: 1px solid red !important; }


		.iconButton {
			display:flex;
  			background-color: transparent;
  			border: none;
  				padding: 0;
  				margin: 0;
  				width: 24px;
 				height: 24px;
  				cursor: pointer;
  				left: 25px;
		}

		.drag-over {
 			 border: 2px dashed #2152A5;
				}

		.gwt-fileUpload{
			display:flex;
				width: 250px;
 				height: 25px;
		}

		.uploaded{
			border: 2px solid green;
			padding-right: 25px;
			padding-bottom: 25px;
		}

		.uploadedFail{
			border: 2px solid red;
			padding-right: 20px;
			padding-bottom: 20px;
		}

		.heightAll {height: 100%}

		.container {
			gap: 1rem;
  			margin-top: 1rem;
		}

		.uploadButtonHidde{

		}
		@external aonEmployeeCard;
		@external aonEmployeeCardTitle;
		@external aonEmployeeCardLabel;
		@external aonEmployeeCardRequired;


	</ui:style>

	<ui:import field="com.google.gwt.user.client.ui.FormPanel.*" />

   	<g:ScrollPanel styleName="{style.heightAll}">

   		<g:FlowPanel styleName="{style.flexColumn} {style.container}">

	   		<g:HTMLPanel styleName="{style.widthAll}" debugId="employeeTablePanel">
		   		<g:HTMLPanel styleName="{style.aonEmployeeCard}">
		    		<g:Label styleName='{style.aonEmployeeCardTitle}'>{msgs.contractData}</g:Label>
			    	<g:HTMLPanel styleName="{style.widthAll} {style.flexColumn}" ui:field="contractDataTable">

			    		<!-- LINEA 0 -->
			    		<g:HTMLPanel styleName="{style.flex}">
			    			<g:Label  styleName='{style.aonEmployeeCardLabel}' text="{msgs.document}" />
			    			<g:SuggestBox ui:field="document" debugId="document" styleName='aon-inputText {style.widthAll} {style.heightTB}'/>
			    			<g:Label styleName='{style.mw}' ui:field="documentType" debugId="document_type" />

			    			<!--  FILEUPLOAD-->
	<!-- 						<g:HTMLPanel > 											 -->
	<!-- 						  <g:FormPanel ui:field="formPanel" visible="true" method="POST" action="DNIServlet" encoding="multipart/form-data"> -->
	<!-- 						    <g:HTMLPanel styleName="{style.flex}"> -->
	<!-- 						       <g:Button ui:field="uploadButton" styleName="{style.iconButton}" > -->
	<!-- 						        <i class="material-icons">publish</i> -->
	<!-- 						      </g:Button> -->
	<!-- 						      <g:FileUpload ui:field="fileUpload" visible= "false" styleName="{style.gwt-fileUpload}"/> -->
	<!-- 						    </g:HTMLPanel> -->
	<!-- 						  </g:FormPanel> -->
	<!-- 						</g:HTMLPanel> -->
						    <!-- FILEUPLOAD-->

			    			<g:HTMLPanel styleName="{style.flexItem} {style.widthAll}" ui:field="nationalityPanel">
			    				<g:Label ui:field="nationalityLabel" debugId="nationalityLabel" styleName='{style.mw}' text="{msgs.nationality}" />
			    				<g:SuggestBox ui:field="nationality" debugId="nationality" styleName='aon-inputText {style.widthAll} {style.heightTB}' />
			    			</g:HTMLPanel>
			    			<g:Label styleName='{style.mw}' text="{msgs.socialSecurityNumber}" />
			    			<g:SuggestBox ui:field="securitySocialNum" debugId="security_social_num" styleName='aon-inputText {style.widthAll} {style.heightTB}' />
						</g:HTMLPanel>
						<!-- LINEA 1 -->
			    		<g:HTMLPanel styleName="{style.flex}">
			    			<g:Label  styleName='{style.aonEmployeeCardLabel}' text="{msgs.name}" />
			    			<g:SuggestBox ui:field="name" debugId="name" styleName='aon-inputText {style.widthAll} {style.heightTB}' />
			    			<g:Label ui:field="firstSurnameLabel" styleName='{style.mw}' text="{msgs.firstSurname}" />
			    			<g:SuggestBox ui:field="firstSurname" debugId="first_surname" styleName='aon-inputText {style.widthAll} {style.heightTB}' />
			    			<g:Label styleName='{style.mw}' text="{msgs.secondSurname}" />
			    			<g:TextBox ui:field="secondSurname" debugId="second_surname" styleName='aon-inputText {style.widthAll} {style.heightTB}' />
						</g:HTMLPanel>
						<!-- LINEA 2 -->
			    		<g:HTMLPanel styleName="{style.flex}">
			    			<g:Label  styleName='{style.aonEmployeeCardLabel}' text="{msgs.quoteType}" />
			    			<g:ListBox ui:field="ssRegimeType" debugId="ssRegimeType" styleName='aon-selectOneMenu {style.widthAll}' />
			    			<g:Label styleName='{style.mw}' text="{msgs.tributationType}" />
			    			<g:ListBox ui:field="mdTBTLB" debugId="mdTBT" styleName='aon-selectOneMenu {style.widthAll}' />
						</g:HTMLPanel>
						<!-- LINEA 3 -->
			    		<g:HTMLPanel styleName="{style.flex}">
			    			<g:Label  styleName='{style.aonEmployeeCardLabel}' text="{msgs.activityQuoteAccount}" />
			    			<g:ListBox ui:field="activityCCC" debugId="activityCCC" styleName='aon-selectOneMenu {style.widthAll}' />
						</g:HTMLPanel>
						<!-- LINEA 4 -->
			    		<g:HTMLPanel styleName="{style.flex}">
			    			<g:Label  styleName='{style.aonEmployeeCardLabel}' text="{msgs.quoteModality}" />
			    			<g:ListBox ui:field="mdCTZLB" debugId="mdCTZ" styleName='aon-selectOneMenu {style.widthAll}' />
						</g:HTMLPanel>
						<!-- LINEA 5 -->
			    		<g:HTMLPanel styleName="{style.flex}">
			    			<g:Label  styleName='{style.aonEmployeeCardLabel}' text="{msgs.workplace}" />
			    			<g:ListBox ui:field="workplace" debugId="workplace" styleName='aon-selectOneMenu {style.widthAll}' />
						</g:HTMLPanel>
						<!-- LINEA 6 -->
			    		<g:HTMLPanel styleName="{style.flex}">
			    			<g:Label  styleName='{style.aonEmployeeCardLabel}' text="{msgs.contractType}" />
			    			<g:ListBox ui:field="contractTypeLB" debugId="contractType" styleName='aon-selectOneMenu {style.widthAll}' />
			    			<g:Label ui:field="contractTypeFreelance" debugId="contractTypeFreelance" styleName='{style.mw}' text="{msgs.freelanceRegime}" />
						</g:HTMLPanel>
