		    	</g:HTMLPanel>
		    </g:HTMLPanel>
	   	</g:HTMLPanel>

		<g:HTMLPanel styleName="{style.widthAll}" debugId="employeeTablePanel" ui:field="employeeTablePanel">
	   		<g:HTMLPanel styleName="{style.aonEmployeeCard}">
	    		<g:Label styleName='{style.aonEmployeeCardTitle}'>{msgs.personalData}</g:Label>
		    	<g:HTMLPanel styleName="{style.widthAll} {style.flexColumn}">
		    		<g:HTMLPanel styleName="{style.flex}">
		    			<g:Label  styleName='{style.aonEmployeeCardLabel}' text="{msgs.birthDate}" />
		    			<a:DateBoxEx ui:field="birthDate" debugId="birth_date" styleName="aon-inputText {style.alignTextCenter} {style.heightTB} {style.widthAll}" />
		    			<g:Label styleName='{style.mw}' ui:field="age" debugId="age" />
						<g:Label styleName='{style.mw}' text="{msgs.gender}" />
						<g:ListBox ui:field="gender" debugId="gender" styleName='aon-selectOneMenu {style.widthAll}' />
						<g:Label styleName="{style.mw}" text="{msgs.civilStatus}" />
						<g:ListBox ui:field="civilStatus" debugId="civilStatus" styleName='aon-selectOneMenu {style.widthAll}' />
					</g:HTMLPanel>
					<g:HTMLPanel styleName="{style.flex}">
		    			<g:Label  styleName='{style.aonEmployeeCardLabel}' text="{msgs.address}" />
		    			<g:ListBox ui:field="streetType" debugId="street_type" styleName='aon-selectOneMenu' />
		    			<g:SuggestBox ui:field="address" debugId="address" styleName='aon-inputText {style.widthAll} {style.heightTB}' />
		    			<g:Label styleName='{style.mw}' text="{msgs.number}" />
						<g:TextBox ui:field="addressNum" debugId="addressNum" styleName='aon-inputText {style.shortTB} {style.alignTextCenter} {style.heightTB}' />
						<g:Label styleName='{style.mw}' text="{msgs.addressRest}" />
						<g:TextBox ui:field="addressInfo" debugId="addressInfo" styleName='aon-inputText {style.widthAll} {style.heightTB}' />
					</g:HTMLPanel>
					<g:HTMLPanel styleName="{style.flex}">
		    			<g:Label styleName='{style.aonEmployeeCardLabel}' text="{msgs.zipCode}" />
		    			<g:TextBox ui:field="addressZip" debugId="addressZip" styleName='aon-inputText {style.alignTextCenter} {style.heightTB}' />
		    			<g:Label styleName="{style.mw}" text="{msgs.province}" />
		    			<g:ListBox ui:field="addressProvince" debugId="addressProvince" styleName='aon-inputText {style.widthAll}' />
