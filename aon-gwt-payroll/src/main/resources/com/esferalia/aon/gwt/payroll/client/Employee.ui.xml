							<td colspan="2">
								<g:TextBox ui:field="email" debugId="email" styleName='aon-inputText {style.maxWidthTextBox3}'></g:TextBox>
							</td>
						</tr>
						<tr>
							<td style="background-color: #eaeaea; width: 200px;">
								<g:Label styleName="{style.firstColumnTextStyle}">Forma de pago</g:Label>
							</td>
							<td colspan="2">
								<g:ListBox ui:field="payMethod" debugId="payMethod" styleName='{style.maxWidth}'></g:ListBox>
							</td>
							<td style="width: 8%;">
								<g:Label styleName='{style.alignTextCenter}'>IBAN</g:Label>
							</td>
							<td colspan="3">
								<g:HorizontalPanel styleName="{style.maxWidth}">
									<g:SuggestBox ui:field="account" debugId="account" styleName='aon-inputText {style.maxWidthTextBox}'></g:SuggestBox>
									<g:Label ui:field="accountStatus" debugId="ssNumberStatus"></g:Label>
								</g:HorizontalPanel>
							</td>
							<td>
								<g:Label styleName='{style.alignTextCenter}'>BIC</g:Label>
							</td>
							<td>
								<g:TextBox ui:field="bic" debugId="bic" styleName='aon-inputText {style.maxWidthTextBox3}'></g:TextBox>
							</td>
							
						</tr>
					</body>
				</table>
			</g:HTMLPanel>
		</g:VerticalPanel>
       </g:HTMLPanel> 
</ui:UiBinder> 

