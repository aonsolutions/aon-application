<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
	xmlns:g='urn:import:com.google.gwt.user.client.ui'
	xmlns:a='urn:import:com.esferalia.aon.gwt.common.client.widget'>

	<ui:with field='res'
		type='com.esferalia.aon.gwt.common.client.css.AonResources' />

	<ui:style
		type="com.esferalia.aon.gwt.payroll.client.Employee.MyStyle">
		
		.form {
			padding: 10px;
		}

		.noselect {
			-webkit-touch-callout: none; /* iOS Safari */
			-webkit-user-select: none; /* Safari */
			-khtml-user-select: none; /* Konqueror HTML */
			-moz-user-select: none; /* Firefox */
			-ms-user-select: none; /* Internet Explorer/Edge */
			user-select: none; /* Non-prefixed version, currently supported by Chrome and Opera */
		}
		
		@external gwt-Selector;
		@external gwt-SuggestBoxPopup;
		.gwt-SuggestBoxPopup {
			z-index: 105;
		}
		
		.gwt-Selector .gwt-SuggestBoxPopup {
			z-index: 105;
			height: inherit;
		}

		.headerStyle{
			top: -0.5em;
			font-size: 12px;
			margin-left: 10px;
		}

		.requiredColor{
			color: #2152A5;
			font-weight: bold !important;
		}

		.maxWidth{
		width: 100%;
		}

		.maxWidthTextBox{
		width: 99%;
		}

		.maxWidthTextBox2{
		width: 98%;
		}

		.maxWidthTextBox3{
		width: 97%;
		}

		.maxWidthTextBox4{
			width: 96%;
		}

		.dateBoxStyle{
		width: 98% !important;
		text-align: center !important;
		}

		.dateBoxStyle2{
		width: 96% !important;
		text-align: center !important;
		}

		.alignTextCenter{
		text-align: center;
		}

		.firstColumnTextStyle{
		padding:
		5px !important;
		}

		.nssWidht{
			width: 96%;
		}

		.paddingLeft{
			padding-left: 2px;
		}

		.retaTopLabel{
			top: 330px;
		}
		
		.styleBorder{
			border-style: solid; 
			width: 975px; 
			border-width: 1px; 
			margin-top: 20px; 
			margin-left: 10px;
		}
		
		.styleBorder2{
			border-style: solid; 
			width: 975px; 
			border-width: 1px; 
			margin-top: 40px; 
			margin-left: 10px;
		}
		
		.fontSaveStyle{
			font-weight: bold;
    		color: #000;
    		white-space: nowrap;
    		font-size: smaller;
    		padding-left: 30px;
    		width: 80px;	
		}
		
		.journeyDurationWarning{
			font-weight: bold;
			font-size: 11px;
			cursor: pointer;
		}
		
		.journeyDuration{
			font-size: 11px;
			cursor: pointer;
		}
		
		.addressPadding{
			padding-top: 2px;
			padding-right: 10px;
			padding-left: 5px;
		}
		
		.labelsWidth{
			width: 100px;
		}
		
		.mr-10{
			margin-right: 10px;
		}
		
	</ui:style>

   	<g:HTMLPanel> 
        <g:VerticalPanel styleName="{style.styleBorder}"> 
	    	<g:Label width="105px" styleName='aon-group-title {style.headerStyle}'>Datos de contrato</g:Label>
	    	<g:HTMLPanel>
				<table ui:field="contractDataTable" debugId="contractDataTable"
					style="margin-left: 10px; margin-bottom: 10px; width: 950px;">
					<tbody>
					    <tr>
					        <td></td>
					        <td></td>
					        <td></td>
					        <td></td>
					        <td></td>
					        <td></td>
					        <td></td>
					    </tr>
					    <tr>
							<td style="background-color: #eaeaea; width: 200px;">
								<g:Label styleName='{style.firstColumnTextStyle}'>Documento</g:Label>
							</td>
							<td ui:field="documentTypeCell" debugId="documentTypeCell">
							    <g:HorizontalPanel ui:field="horizontalPanel">
							        <g:Button styleName="aon-lookupButton-clear" ui:field="clear_employee" debugId="clear_employee"></g:Button>
							        <g:Label styleName='{style.alignTextCenter}' ui:field="document_type" debugId="document_type"></g:Label>
							    </g:HorizontalPanel>
							</td>
							<td>
								<g:HorizontalPanel>
									<g:SuggestBox ui:field="document" debugId="document" styleName='aon-inputText {style.maxWidthTextBox}'></g:SuggestBox>
									<g:Label ui:field="documentStatus" debugId="documentStatus"></g:Label>
								</g:HorizontalPanel>
							</td>
							<td style="width: 10%;" ui:field="nationalityLabelCell" debugId="nationalityLabelCell">
								<g:Label ui:field="nationalityLabel" debugId="nationalityLabel" styleName='{style.alignTextCenter}'>Nacionalidad</g:Label>
							</td>
							<td ui:field="nationalityCell" debugId="nationalityCell">
								<g:SuggestBox ui:field="nationality" debugId="nationality" styleName='aon-inputText {style.maxWidthTextBox}'></g:SuggestBox>
							</td>
							<td style="width: 10%;">
								<g:Label styleName='{style.alignTextCenter}'>Nº S.S.</g:Label>
							</td>
							<td >
								<g:HorizontalPanel>
									<g:SuggestBox ui:field="security_social_num" debugId="security_social_num" styleName='aon-inputText {style.maxWidthTextBox}'></g:SuggestBox>
									<g:Label ui:field="ssNumberStatus" debugId="ssNumberStatus"></g:Label>
								</g:HorizontalPanel>
							</td>
						</tr>
					    <tr>
							<td style="background-color: #eaeaea; width: 200px;">
								<g:Label styleName='{style.requiredColor} {style.firstColumnTextStyle}'>Nombre</g:Label>
							</td>
							<td colspan="2">
								<g:SuggestBox ui:field="name" debugId="name" styleName='aon-inputText {style.maxWidthTextBox}'></g:SuggestBox>
							</td>
							<td>
								<g:Label ui:field="firstSurnameLabel" debugId="firstSurnameLabel"
									styleName='{style.alignTextCenter}'>1er Apellido</g:Label>
							</td>
							<td >
								<g:SuggestBox ui:field="first_surname" debugId="first_surname" styleName='aon-inputText {style.maxWidthTextBox}'></g:SuggestBox>
							</td>
							<td style="width: 10%;">
								<g:Label styleName='{style.alignTextCenter}'>2º Apellido</g:Label>
							</td>
							<td >
								<g:TextBox ui:field="second_surname" debugId="second_surname" styleName='aon-inputText {style.maxWidthTextBox4}'></g:TextBox>
							</td>
						</tr>
						<tr>
							<td style="background-color: #eaeaea; width: 200px;">
								<g:Label styleName='{style.requiredColor} {style.firstColumnTextStyle}'>Tipo de cotización</g:Label>
							</td>
							<td colspan="6">
								<g:ListBox ui:field="ssRegimeType" debugId="ssRegimeType" styleName='aon-selectOneMenu {style.maxWidth}'></g:ListBox>
							</td>
						</tr>
						<tr>
							<td style="background-color: #eaeaea; width: 200px;">
								<g:Label styleName='{style.requiredColor} {style.firstColumnTextStyle}'>Actividad - Cuenta de cotización</g:Label>
							</td>
							<td colspan="6">
								<g:ListBox ui:field="activityCCC" debugId="activityCCC" styleName='aon-selectOneMenu {style.maxWidth}'></g:ListBox>
							</td>
						</tr>
						<tr>
						    <td style="background-color: #eaeaea; width: 200px;">
								<g:Label styleName='{style.requiredColor} {style.firstColumnTextStyle}'>Centro de trabajo</g:Label>
							</td>
							<td colspan="6">
								<g:ListBox ui:field="workplace" debugId="workplace" styleName='aon-selectOneMenu {style.maxWidth}'></g:ListBox>
							</td>
						</tr>
						<tr>
							<td style="background-color: #eaeaea; width: 200px;">
								<g:Label styleName='{style.requiredColor} {style.firstColumnTextStyle}'>Tipo de contrato</g:Label>
							</td>
							<td colspan="6" ui:field="contractTypeNode" debugId="contractTypeNode">
								<g:ListBox ui:field="contractType" debugId="contractType" styleName='aon-selectOneMenu {style.maxWidth}'></g:ListBox>
							</td>
							<td ui:field="contractFreelancerNode" debugId="contractFreelancerNode" colspan="6">
								<g:Label ui:field="contractTypeFreelance" debugId="contractTypeFreelance"
									styleName='{style.maxWidthTextBox}'>
									Régimen especial de trabajadores autónomos
								</g:Label>
							</td>
						</tr>
						<tr>
							<td style="background-color: #eaeaea; width: 200px;">
								<g:Label styleName="{style.firstColumnTextStyle}">Modalidad</g:Label>
							</td>
							<td colspan="6">
								<g:ListBox ui:field="modality" debugId="modality" styleName='aon-selectOneMenu {style.maxWidth}'></g:ListBox>
							</td>
						</tr>
						<tr>
							<td style="background-color: #eaeaea; width: 200px;">
								<g:Label styleName="{style.firstColumnTextStyle}">Periodo contratación</g:Label>
							</td>
							<td>
								<g:Label styleName='{style.requiredColor}'>Fecha inicio</g:Label>
							</td>
							<td>
								<a:DateBoxEx ui:field="start_date" debugId="start_date" styleName='rich-calendar-input aon-selectInputDate-inputClass {style.dateBoxStyle}'></a:DateBoxEx>
							</td>
							<td>
								<g:Label styleName='{style.alignTextCenter}'>Fecha fin</g:Label>
							</td>
							<td>
								<a:DateBoxEx ui:field="end_date" debugId="end_date" styleName='rich-calendar-input aon-selectInputDate-inputClass {style.dateBoxStyle}'></a:DateBoxEx>
							</td>
							<td style="width: 12%;">
								<g:Label ui:field="seniority_date_label" debugId="seniority_date_label" styleName='{style.alignTextCenter}'>Fecha
									antigüedad</g:Label>
							</td>
							<td>
								<g:HorizontalPanel>
									<a:DateBoxEx ui:field="seniority_date" debugId="seniority_date" styleName='rich-calendar-input aon-selectInputDate-inputClass {style.dateBoxStyle2}'></a:DateBoxEx>
									<g:Label ui:field="seniority_dateStatus" debugId="seniority_dateStatus"></g:Label>	
								</g:HorizontalPanel>
							</td>
						</tr>
						<tr>
							<td rowspan="2" style="background-color: #eaeaea; width: 200px;">
								<g:Label styleName="{style.firstColumnTextStyle}">Categoría/Nivel retributario</g:Label>
							</td>
							<td>
								<g:Label>Convenio</g:Label>
							</td>
							<td colspan="5">
								<g:ListBox ui:field="agreement" debugId="agreement" styleName='aon-selectOneMenu {style.maxWidth}'></g:ListBox>
							</td>
						</tr>
						<tr>
							<td>
								<g:Label>Nivel/Categoría</g:Label>
							</td>
							<td colspan="3">
								<g:ListBox ui:field="level" debugId="level" styleName='aon-selectOneMenu {style.maxWidth}'></g:ListBox>
							</td>
							<td>
								<g:Label styleName='{style.alignTextCenter}'>Mostrar como</g:Label>
							</td>
							<td>
								<g:TextBox ui:field="category" debugId="category" styleName='aon-inputText {style.maxWidthTextBox3}'></g:TextBox>
							</td>
						</tr>
						<tr>
							<td style="background-color: #eaeaea; width: 200px;">
								<g:Label styleName="{style.firstColumnTextStyle}">Grupo de cotización</g:Label>
							</td>
							<td colspan="6">
								<g:ListBox ui:field="quote_group" debugId="quote_group" styleName='aon-selectOneMenu {style.maxWidth}'></g:ListBox>
							</td>
						</tr>
						<tr>
							<td style="background-color: #eaeaea; width: 200px;">
								<g:Label styleName="{style.firstColumnTextStyle}">Ocupación</g:Label>
							</td>
							<td colspan="6">
								<g:ListBox ui:field="occupation" debugId="occupation" styleName='aon-selectOneMenu {style.maxWidth}'></g:ListBox>
							</td>
						</tr>
						<tr>
							<td style="background-color: #eaeaea; width: 200px;">
								<g:Label styleName="{style.requiredColor} {style.firstColumnTextStyle}">Tipo de jornada</g:Label>
							</td>
							<td colspan="6">
								<g:ListBox ui:field="journeyType" debugId="journeyType" styleName='aon-selectOneMenu {style.maxWidth}'></g:ListBox>
							</td>
						</tr>
						<tr>
							<td style="background-color: #eaeaea; width: 200px;">
								<g:Label styleName="{style.firstColumnTextStyle}">Duración de lo jornada</g:Label>
							</td>
							<td colspan="6">
								<g:Label ui:field="journeyDuration" debugId="journeyDuration" styleName='{style.maxWidth}'> </g:Label>
							</td>
						</tr>
					</tbody>
				</table>
			</g:HTMLPanel>
		</g:VerticalPanel>
		<g:VerticalPanel styleName="{style.styleBorder2}"> 
			<g:Label ui:field="labelEmployee" debugId="labelEmployee" width="105px" styleName='aon-group-title {style.headerStyle}'>Datos personales</g:Label>
			<g:HTMLPanel>
				<table ui:field="employeeDataTable" debugId="employeeDataTable"
					style="margin-left: 10px; margin-bottom: 10px; width: 950px;">
					<body>
					    <tr>
					        <td></td>
					        <td></td>
					        <td></td>
					        <td></td>
					        <td></td>
					        <td></td>
					        <td></td>
					        <td></td>
					        <td></td>
					    </tr>
						<tr>
							<td style="background-color: #eaeaea; width: 200px;">
								<g:Label styleName="{style.firstColumnTextStyle}">Fecha de nacimiento</g:Label>
							</td>
							<td colspan="2">
								<a:DateBoxEx ui:field="birth_date" debugId="birth_date" styleName='rich-calendar-input aon-selectInputDate-inputClass {style.dateBoxStyle}'></a:DateBoxEx>
							</td>
							<td style="width: 100px;">
								<g:HorizontalPanel styleName="{style.paddingLeft} {style.labelsWidth}">
									<g:Label ui:field="age" debugId="age"></g:Label>
									<g:Label styleName='{style.alignTextCenter}'>Sexo</g:Label>
								</g:HorizontalPanel>
							</td>
							<td colspan="2">
								<g:ListBox ui:field="gender" debugId="gender" styleName='aon-selectOneMenu {style.maxWidth}'></g:ListBox>
							</td>
						</tr>
						<tr>
							<td rowspan="2" style="background-color: #eaeaea; width: 200px;">
								<g:Label styleName='{style.firstColumnTextStyle}'>Dirección</g:Label>
							</td>
							<td>
							    <g:ListBox ui:field="street_type" debugId="street_type" styleName='aon-selectOneMenu {style.maxWidth}'></g:ListBox>
							</td>
							<td colspan="3">
								<g:SuggestBox ui:field="address" debugId="address" styleName='aon-inputText {style.maxWidthTextBox}'></g:SuggestBox>
							</td>
							<td>
								<g:HorizontalPanel>
									<g:Label styleName='{style.alignTextCenter} {style.addressPadding}'>Nº</g:Label>
									<g:TextBox ui:field="addressNum" debugId="addressNum" styleName='aon-inputText {style.maxWidth}'></g:TextBox>
									<g:Label styleName='{style.alignTextCenter} {style.addressPadding} {style.mr-10} {style.maxWidth}'>Rest. Dir.</g:Label>
								</g:HorizontalPanel>
							</td>
							<td colspan="3">
								<g:TextBox ui:field="addressInfo" debugId="addressInfo" styleName='aon-inputText {style.maxWidthTextBox}'></g:TextBox>
							</td>
						</tr>
						<tr>
							<td style="width: 10%;">
								<g:Label styleName='{style.alignTextCenter}'>C.P.</g:Label>
							</td>
							<td>
								<g:TextBox ui:field="addressZip" debugId="addressZip" styleName='aon-inputText {style.maxWidthTextBox3}'></g:TextBox>
							</td>
							<td style="width: 8%;">
								<g:Label styleName='{style.alignTextCenter}'>  Provincia  </g:Label>
								
							</td>
							<td colspan="2">
								<g:ListBox ui:field="addressProvince" debugId="addressProvince" styleName='aon-inputText {style.maxWidth}'></g:ListBox>
							</td>
							<td style="width: 9%;">
								<g:Label styleName='{style.alignTextCenter}'>Municipio</g:Label>
							</td>
							<td colspan="2"> 
								<g:ListBox ui:field="addressMunicipality" debugId="addressMunicipality" styleName='aon-inputText {style.maxWidthTextBox}'></g:ListBox>
							</td>
						</tr>
						<tr>
							<td style="background-color: #eaeaea; width: 200px;">
								<g:Label styleName="{style.firstColumnTextStyle}">Contacto</g:Label>
							</td>
							<td>
								<g:Label styleName='{style.alignTextCenter}'>Móvil</g:Label>
							</td>
							<td>
								<g:TextBox ui:field="mobile" debugId="mobile" styleName='aon-inputText {style.maxWidthTextBox3}'></g:TextBox>
							</td>
							<td>
								<g:Label styleName='{style.alignTextCenter}'>Teléfono</g:Label>
							</td>
							<td colspan="2">
								<g:TextBox ui:field="phone" debugId="phone" styleName='aon-inputText {style.maxWidthTextBox3}'></g:TextBox>
							</td>
							<td>
