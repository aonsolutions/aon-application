			    		<g:HTMLPanel styleName="{style.flex}">
			    			<g:Label  styleName='{style.aonEmployeeCardLabel}' text="{msgs.modality}" />
			    			<g:ListBox ui:field="modality" debugId="modality" styleName='aon-selectOneMenu {style.widthAll}' />
						</g:HTMLPanel>
						<!-- LINEA 8 -->
			    		<g:HTMLPanel styleName="{style.flex}">
			    			<g:Label  styleName='{style.aonEmployeeCardLabel}' text="{msgs.contractPeriod}" />
			    			<g:Label styleName='{style.aonEmployeeCardRequired} {style.mw}' text="{msgs.startDate}" />
			    			<a:DateBoxEx ui:field="startDate" debugId="start_date" styleName='aon-inputText {style.alignTextCenter} {style.widthAll} {style.heightTB}' />
			    			<g:Label styleName='{style.mw}' text="{msgs.endDate}" />
			    			<a:DateBoxEx ui:field="endDate" debugId="end_date" styleName='aon-inputText {style.alignTextCenter} {style.widthAll} {style.heightTB}' />
			    			<g:Label styleName='{style.mw}' text="{msgs.seniorityDate}" />
			    			<a:DateBoxEx ui:field="seniorityDate" debugId="seniority_date" styleName='aon-inputText {style.alignTextCenter} {style.widthAll} {style.heightTB}' />
						</g:HTMLPanel>
						<!-- LINEA 9 -->
			    		<g:HTMLPanel styleName="{style.flex}">
		    				<g:Label  styleName='{style.aonEmployeeCardLabel} {style.agreementTitle}' text="{msgs.categoryLevel}" />
		    				<g:HTMLPanel styleName="{style.flexColumn} {style.widthAll}">
		    					<g:HTMLPanel styleName="{style.flex}">
		    						<g:Label styleName='{style.mw}' text="{msgs.agreement}" />
		    						<g:SuggestBox ui:field="agreement" debugId="agreement" styleName='aon-inputText {style.widthAll} {style.heightTB}' />
		    					</g:HTMLPanel>
