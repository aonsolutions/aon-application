							</tr>
							<!-- LINEA 4 -->
							<tr>
								<td style="background-color: #eaeaea; width: 400px;">
									<g:Label styleName='{style.firstColumnTextStyle}'>Certificado de profesionalidad</g:Label>
								</td>
								<td>
								    <g:CheckBox ui:field="profesionalityCB"/>
								</td>
							</tr>
							<!-- LINEA 5 -->
							<tr>
								<td style="background-color: #eaeaea; width: 400px;">
									<g:Label styleName='{style.firstColumnTextStyle}'>Tipo firma copia básica</g:Label>
								</td>
								<td>
								    <g:ListBox ui:field="signBasicCopyLB" styleName='{style.maxWidthLB}'></g:ListBox>
								</td>
							</tr>
							<!-- LINEA 6 -->
							<tr>
								<td style="background-color: #eaeaea; width: 400px; vertical-align: top;">
									<g:Label styleName='{style.firstColumnTextStyle}'>Texto copia básica</g:Label>
								</td>
								<td>
								    <g:TextArea ui:field="basicCopyTA" styleName='{style.maxWidthTB}'></g:TextArea>
								</td>
							</tr>
							<!-- LINEA 7 -->
							<tr>
								<td style="background-color: #eaeaea; width: 400px;">
									<g:Label styleName='{style.firstColumnTextStyle}'>Uso libre empresa</g:Label>
								</td>
								<td>
								    <g:TextBox ui:field="useEnterpriseFreeTB" styleName='{style.maxWidthTB}'></g:TextBox>
								</td>
							</tr>
							<!-- LINEA 8 -->
							<tr>
								<td style="background-color: #eaeaea; width: 400px;">
									<g:Label styleName='{style.firstColumnTextStyle}'>Horas de convenio</g:Label>
								</td>
								<td>
									<g:HorizontalPanel>
										<g:Label styleName="{style.labelStyle}">Horas: </g:Label>
										<g:TextBox ui:field="agreementHoursTB" styleName='{style.maxWidthTB}'></g:TextBox>
										<g:Label styleName="{style.labelStyle}">Minutos: </g:Label>
										<g:TextBox ui:field="agreementMinutesTB" styleName='{style.maxWidthTB}'></g:TextBox>
									</g:HorizontalPanel>
								    
								</td>
							</tr>
							<!-- LINEA 9 -->
							<tr>
								<td style="background-color: #eaeaea; width: 400px;">
									<g:Label styleName='{style.firstColumnTextStyle}'>¿Realiza trabajos fijos discontinuos o periódicos que se repiten en fechas ciertas?</g:Label>
								</td>
								<td>
								    <g:CheckBox ui:field="repeatFDCB"/>
								</td>
							</tr>
							<!-- LINEA 10 -->
							<tr>
								<td style="background-color: #eaeaea; width: 400px;">
									<g:Label styleName='{style.firstColumnTextStyle}'>Tipo de jornada</g:Label>
								</td>
								<td>
									<g:ListBox ui:field="journeyTypeLB" styleName='{style.maxWidthLB}'></g:ListBox>
								</td>
							</tr>
							<!-- LINEA 11 -->
							<tr>
								<td style="background-color: #eaeaea; width: 400px;">
									<g:Label styleName='{style.firstColumnTextStyle}'>Duración de la jornada</g:Label>
								</td>
								<td>
									<g:HorizontalPanel>
										<g:Label styleName="{style.labelStyle}">Horas: </g:Label>
										<g:TextBox ui:field="journeyDurationHoursTB" styleName='{style.maxWidthTB}'></g:TextBox>
										<g:Label styleName="{style.labelStyle}">Minutos: </g:Label>
										<g:TextBox ui:field="journeyDurationMinutesTB" styleName='{style.maxWidthTB}'></g:TextBox>
									</g:HorizontalPanel>    
								</td>
							</tr>
							<!-- LINEA 12 -->
							<tr>
								<td style="background-color: #eaeaea; width: 400px;">
									<g:Label styleName='{style.firstColumnTextStyle}'>Formación teórica recibida</g:Label>
								</td>
								<td>
									<g:HorizontalPanel>
								    	<g:RadioButton ui:field="teoricFormationYesRB" name="annexedRB">Si</g:RadioButton>
								    	<g:RadioButton ui:field="teoricFormationNoRB" name="annexedRB">No</g:RadioButton>
								    </g:HorizontalPanel>
								</td>
							</tr>
							<!-- LINEA 13 -->
							<tr>
								<td style="background-color: #eaeaea; width: 400px;">
									<g:Label styleName='{style.firstColumnTextStyle}'>Horas formación</g:Label>
								</td>
