							</tr>
							<!-- LINEA 3 -->
							<tr>
								<td style="background-color: #eaeaea; width: 400px;">
									<g:Label styleName='{style.firstColumnTextStyle}'>Titulación académica</g:Label>
								</td>
								<td>
