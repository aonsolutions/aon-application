<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
	xmlns:g='urn:import:com.google.gwt.user.client.ui'
	xmlns:a='urn:import:com.esferalia.aon.gwt.common.client.widget'
	xmlns:s='urn:import:com.esferalia.aon.gwt.common.client.widget.solutions'>

	<ui:with field='res' type='com.esferalia.aon.gwt.common.client.css.AonResources' />

	<ui:style type="com.esferalia.aon.gwt.payroll.client.ContractSpecificData.MyStyle">

		.headerStyle{
			top: -0.5em;
			font-size: 12px;
			margin-left: 10px;
		}

		.maxWidthTB{
			width: 99% !important;
			min-height: 1.1rem;
		}
		
		.maxWidthLB{
			width: 100%;
		}

		.firstColumnTextStyle{
			padding:5px !important;
		}
		
		.styleBorder{
			border-style: solid; 
			width: 975px; 
			border-width: 1px; 
			margin: 20px 10px;
		}
		
		.labelStyle{
			padding: 4px;
			margin-left: 6px;
			margin-right: 6px;
		}
		
		.dateLabelStyle{
			margin-left: 6px;
			margin-right: 6px;
		}
		
		.checksPanel{
			width: 948px;
			display: flex;
			flex-wrap: wrap;
			padding-left: 10px;
			padding-bottom: 10px;
		}
		
		.checkPanel{
			display:flex;
		}
		
		.checks{
			background-color: #eaeaea;
			width: 35px;
		}
		
		.checksLabel{
			width: 270px;
			padding: 4px;
		}
		
		.flex{
			display: flex;
			justify-content: space-between;
			align-items: center;
			border: 3px solid #eaeaea;
			padding: 5px 10px;
			width: 950px;
			margin-left: 10px;
			font-weight: bold;
		}
		
		.messagePanel{
			display: flex;
			justify-content: center;
			border: 1px solid #f3f3f3;
			padding: 1rem;
			width: 975px !important;
		}
		
		.message {
			font-weight: bold;
			text-transform: uppercase;
		}
		
		.textCenter {
			text-align: center;
		}
		
		.row {
			width: 100%;
			display: flex;
			gap: 1rem;
			align-items: center;
		}
		
	</ui:style>

   	<g:HTMLPanel> 
  			<g:HTMLPanel>
  				<!-- CNO TABLE -->
	   		<g:VerticalPanel ui:field="cnoTable" styleName="{style.styleBorder}"> 
		    	<g:Label width="105px" styleName='aon-group-title {style.headerStyle}'>CNO</g:Label>
		    	<g:HTMLPanel>
					<table ui:field="contractCNOTable" debugId="contractCNOTable"
						style="margin-left: 10px; margin-bottom: 10px; width: 950px;">
						<tbody>
						    <tr>
						        <td></td>
						        <td></td>
						    </tr>
						    <tr>
								<td style="background-color: #eaeaea; width: 400px;">
									<g:Label styleName='{style.firstColumnTextStyle}'>CNO</g:Label>
								</td>
								<td>
								    <g:SuggestBox ui:field="cnoSB" styleName='{style.maxWidthTB}'></g:SuggestBox>
								</td>
							</tr>
						</tbody>
					</table>
				</g:HTMLPanel>
			</g:VerticalPanel>
			
			<!-- SEPE COMUNICATION -->
			<g:VerticalPanel ui:field="ideTable" styleName="{style.styleBorder}"> 
		    	<g:Label width="105px" styleName='aon-group-title {style.headerStyle}'>Comunicación Sepe</g:Label>
		    	<g:HTMLPanel>
					<table ui:field="contractIDETable" debugId="contractIDETable"
						style="margin-left: 10px; margin-bottom: 10px; width: 950px;">
						<tbody>
						    <tr>
						        <td></td>
						        <td></td>
						    </tr>
						    <tr>
								<td style="background-color: #eaeaea; width: 400px;">
									<g:Label styleName='{style.firstColumnTextStyle}'>IDE</g:Label>
								</td>
								<td>
									<g:HTMLPanel styleName="{style.row}">
										<g:HTMLPanel ui:field="idePanel" styleName='{style.row}'/>
									</g:HTMLPanel>
								</td>
							</tr>
							<tr>
								<td style="background-color: #eaeaea; width: 400px;">
									<g:Label styleName='{style.firstColumnTextStyle}'>Fecha comunicación</g:Label>
								</td>
								<td>
									<a:DateBoxEx ui:field="comunicationDateBx" styleName="{style.maxWidthTB} {style.textCenter}" />
								</td>
							</tr>
						</tbody>
					</table>
				</g:HTMLPanel>
			</g:VerticalPanel>
			
			<!-- SEPE COMUNICATION -->
			<g:VerticalPanel ui:field="ideTransformTable" styleName="{style.styleBorder}"> 
		    	<g:Label width="105px" styleName='aon-group-title {style.headerStyle}'>Comunicación Transformación Sepe</g:Label>
		    	<g:HTMLPanel>
					<table ui:field="contractTransformIDETable" debugId="contractIDETable"
						style="margin-left: 10px; margin-bottom: 10px; width: 950px;">
						<tbody>
						    <tr>
						        <td></td>
						        <td></td>
						    </tr>
						    <tr>
								<td style="background-color: #eaeaea; width: 400px;">
									<g:Label styleName='{style.firstColumnTextStyle}'>IDE Transformación</g:Label>
								</td>
								<td>
									<g:HTMLPanel styleName="{style.row}">
										<g:HTMLPanel ui:field="ideTransformPanel" styleName='{style.row}'/>
									</g:HTMLPanel>
								</td>
							</tr>
							<tr>
								<td style="background-color: #eaeaea; width: 400px;">
									<g:Label styleName='{style.firstColumnTextStyle}'>Fecha Comunicación Transformación</g:Label>
								</td>
								<td>
									<a:DateBoxEx ui:field="comunicationTransformDateBx" styleName="{style.maxWidthTB} {style.textCenter}" />
								</td>
							</tr>
						</tbody>
					</table>
				</g:HTMLPanel>
			</g:VerticalPanel>
			
			<!-- SEPE COMUNICATION -->
			<g:VerticalPanel ui:field="ideExtensionTable" styleName="{style.styleBorder}"> 
		    	<g:Label width="105px" styleName='aon-group-title {style.headerStyle}'>Comunicación Prórroga Sepe</g:Label>
		    	<g:HTMLPanel>
					<table ui:field="contractExtensionIDETable" debugId="contractIDETable"
						style="margin-left: 10px; margin-bottom: 10px; width: 950px;">
						<tbody>
						    <tr>
						        <td></td>
						        <td></td>
						    </tr>
						     <tr>
								<td style="background-color: #eaeaea; width: 400px;">
									<g:Label styleName='{style.firstColumnTextStyle}'>Prórrogas</g:Label>
								</td>
								<td>
									<g:HTMLPanel styleName="{style.row}">
										<g:ListBox ui:field="extensionsLB" />
									</g:HTMLPanel>
								</td>
							</tr>
						    <tr>
								<td style="background-color: #eaeaea; width: 400px;">
									<g:Label styleName='{style.firstColumnTextStyle}'>IDE Prórroga</g:Label>
								</td>
								<td>
									<g:HTMLPanel styleName="{style.row}">
										<g:HTMLPanel ui:field="ideExtensionPanel" styleName='{style.row}'/>
