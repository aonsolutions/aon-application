			<g:VerticalPanel ui:field="specificDataTable" styleName="{style.styleBorder}"> 
		    	<g:Label width="105px" styleName='aon-group-title {style.headerStyle}'>Datos específicos</g:Label>
		    	<g:HTMLPanel>
		    		<g:HTMLPanel styleName="{style.checksPanel}">
		    			<g:HTMLPanel styleName="{style.checkPanel}" ui:field="workProgramDataCBPanel">
		    				<g:HTMLPanel styleName="{style.checks}">
