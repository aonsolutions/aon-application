										<g:TextBox ui:field="formationMinutesTB" styleName='{style.maxWidthTB}'></g:TextBox>
									</g:HorizontalPanel>    
								</td>
							</tr>
							<!-- LINEA 14 -->
							<tr>
								<td style="background-color: #eaeaea; width: 400px;">
									<g:Label styleName='{style.firstColumnTextStyle}'>Porcentaje jubilación</g:Label>
								</td>
								<td>
									<g:HorizontalPanel>
										<g:TextBox ui:field="retirementPercentTB" styleName='{style.maxWidthTB}'></g:TextBox>
