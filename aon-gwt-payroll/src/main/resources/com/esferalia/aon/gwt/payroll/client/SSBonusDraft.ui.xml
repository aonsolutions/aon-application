<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
	xmlns:g='urn:import:com.google.gwt.user.client.ui'
	xmlns:a='urn:import:com.esferalia.aon.gwt.common.client.widget'>

	<ui:with field='res'
		type='com.esferalia.aon.gwt.common.client.css.AonResources' />

	<ui:style
		type="com.esferalia.aon.gwt.payroll.client.SSBonusDraft.MyStyle">
		
		.noselect {
			-webkit-touch-callout: none; /* iOS Safari */
			-webkit-user-select: none; /* Safari */
			-khtml-user-select: none; /* Konqueror HTML */
			-moz-user-select: none; /* Firefox */
			-ms-user-select: none; /* Internet Explorer/Edge */
			user-select: none; /* Non-prefixed version, currently supported by Chrome and Opera */
		}
		
		@external gwt-Selector;
		@external gwt-SuggestBoxPopup;
		.gwt-SuggestBoxPopup {
			z-index: 105;
		}
		
		.gwt-Selector .gwt-SuggestBoxPopup {
			z-index: 105;
			height: inherit;
		}

		.title{
			padding-left: 25px;
    		font-size: small;
		}

		.title2{
			font-size: small;
		}

		.paddingBlock{
			padding-left: 35px;
    		padding-top: 5px;
		}

		.bold{
			font-weight: bold;
			padding-bottom: 5px;
			padding-top: 10px;
		}

		.paddingLabel{
			padding: 8px;
		}

		.widthBox{
			width: 400px;
		}

		.dateBox{
			width: 121px !important;
			text-align: center;
			margin-top: 5px;
		}
		
		.widthBlack{
			width: 200px;
		}

		.firstCheckBox{
			margin-left: 110px;
    		margin-top: 10px;
		}

		.secondCheckBox{
			margin-left: 110px;
    		margin-top: 10px;
		}

		.secondColumnPadding{
			padding-left: 20px;
		}

		.alignCenter{
			text-align: center;
		}

		.marginLeftLine{
			margin-left: 25px;
		}

		.button{
			background: none;
    		border: 1px solid #555555;
    		margin-top: 15px;
    		margin-left: 319px;
		}

		.paddingTop{
			padding-top: 5px;
			padding-right: 10px;
		}

		.paddingHide{
			padding-left: 35px;
    		padding-top: 25px;
		}

		.hide{
			display: none;
		}

		.paddingLeft{
			padding-left : 5px;
		}

		.noselect {
			-webkit-touch-callout: none; /* iOS Safari */
			-webkit-user-select: none; /* Safari */
			-khtml-user-select: none; /* Konqueror HTML */
			-moz-user-select: none; /* Firefox */
			-ms-user-select: none; /* Internet Explorer/Edge */
			user-select: none; /* Non-prefixed version, currently
				                                  supported by Chrome and Opera */
		}

		.buttonTable{
			background: white;
    		border-color: black !important;
    		border-width: 1px !important;
    		width: 60px;
		}

		.bold{
			font-weight: bold;
		}
	</ui:style>

	<g:DockLayoutPanel unit="PX">
		<g:north size="40">
			<g:FlowPanel>
				<g:FlowPanel styleName="aon-finding-title-toolbar">
					<g:HorizontalPanel>
						<g:HTMLPanel styleName="aon-finding-title">
							<g:HTMLPanel styleName="aon-finding-title-internal">
								<g:Label styleName="aon-outputText">Bonificaciones : </g:Label>
							</g:HTMLPanel>
						</g:HTMLPanel>
						<g:HTMLPanel styleName="aon-finding-subtitle">
							<g:HTMLPanel styleName="aon-finding-subtitle-internal">
								<g:Label styleName="aon-outputText"></g:Label>
							</g:HTMLPanel>
						</g:HTMLPanel>
						<g:HTMLPanel styleName="aon-finding-toolbar-item-group">
						    <g:Button ui:field='listBonusesButton'
								styleName='aon-finding-toolbar-item aon-icon-white-list' text="LISTAR BONIFICACIONES"
								enabled="true" />
							<g:Button ui:field='saveButton'
								styleName='aon-finding-toolbar-item aon-icon-accept' text="GUARDAR"
								enabled="true" />
						</g:HTMLPanel>
					</g:HorizontalPanel>
				</g:FlowPanel>

			</g:FlowPanel>
		</g:north>
		<g:center> 
		    <g:ScrollPanel>
		        <g:HTMLPanel> 
		            <g:Label styleName="{style.title}">BONIFICACIONES</g:Label>
		            <hr align="left" noshade="noshade" style="margin-left: 25px;width: 80%;margin-top: 5px;border-width: 0.5px;"/>
		            <g:HTMLPanel styleName="{style.paddingBlock}">
			            <g:HTMLPanel ui:field='idPanel'>
			                <g:Label styleName="{style.bold}">Id Bonificación</g:Label>
			           		<g:TextBox ui:field='idBonus' styleName="{style.widthBox}"></g:TextBox>
			            </g:HTMLPanel>
			            <g:Label styleName="{style.bold}">1. Periodo de bonificación</g:Label>
			            <g:HorizontalPanel>
			                <g:Label styleName="{style.paddingLabel} {style.bold}">Fecha incio</g:Label>
			                <a:DateBoxEx ui:field='startDateBonus' styleName="{style.dateBox}"></a:DateBoxEx>
			                <g:Label styleName="{style.paddingLabel} {style.bold}">Fecha fin</g:Label>
			                <a:DateBoxEx ui:field='endDateBonus' styleName="{style.dateBox}"></a:DateBoxEx>
			            </g:HorizontalPanel>
			            <g:Label styleName="{style.bold}">2. Descripción de la bonificación</g:Label>
			            <g:TextBox ui:field='descriptionBonus' styleName="{style.widthBox}"></g:TextBox>
			            <g:Label styleName="{style.bold}">3. Tipo de bonificación</g:Label>
			            <g:ListBox ui:field='typeBonus' width="405px"></g:ListBox>
			            <g:Label styleName="{style.bold}">4. Fórmula de la bonificación</g:Label>
			            <g:TextBox ui:field='formulaBonus' styleName="{style.widthBox}"></g:TextBox>
			            <g:HTMLPanel ui:field='checksPanel' styleName="{style.paddingHide}"> <!-- TABLE -->
			                <hr align="left" noshade="noshade" style="margin-bottom: 20px;width: 80%;border-width: 0.5px;"/>
			                <g:HorizontalPanel>
			                	<g:Label styleName="{style.paddingTop} {style.bold}">Porcentaje: </g:Label>
			            		<g:TextBox ui:field='percentBonus' width="300px"></g:TextBox>
			            		<g:Label styleName="{style.paddingTop} {style.bold} {style.paddingLeft}">%</g:Label>
			            	</g:HorizontalPanel>
			                <g:Grid>
								<g:row>
									<g:customCell>
										<g:Label width="150px"></g:Label>
									</g:customCell>
									<g:customCell>
										<g:Label styleName="{style.bold}">Cuota de empresa</g:Label>
									</g:customCell>
									<g:customCell>
										<g:Label styleName="{style.bold}">Cuota de trabajador</g:Label>
									</g:customCell>
								</g:row>
								<g:row>
									<g:customCell>
										<g:Label styleName="{style.bold}">Contigencias comunes</g:Label>
									</g:customCell>
									<g:customCell styleName="{style.alignCenter}">
										<g:CheckBox ui:field='checkCommonC'></g:CheckBox>
									</g:customCell>
									<g:customCell styleName="{style.alignCenter}">
										<g:CheckBox ui:field='checkCommonE'></g:CheckBox>
									</g:customCell>
								</g:row>
								<g:row>
									<g:customCell>
										<g:Label styleName="{style.bold}">Accidentes de trabajo</g:Label>
									</g:customCell>
									<g:customCell styleName="{style.alignCenter}">
										<g:CheckBox ui:field='checkAccidentC'></g:CheckBox>
									</g:customCell>
									<g:customCell styleName="{style.alignCenter}">
										<g:CheckBox ui:field='checkAccidentE'></g:CheckBox>
									</g:customCell>
								</g:row>
								<g:row>
									<g:customCell>
										<g:Label styleName="{style.bold}">Desempleo</g:Label>
									</g:customCell>
									<g:customCell styleName="{style.alignCenter}">
										<g:CheckBox ui:field='checkUnemploymentC'></g:CheckBox>
									</g:customCell>
									<g:customCell styleName="{style.alignCenter}">
										<g:CheckBox ui:field='checkUnemploymentE'></g:CheckBox>
									</g:customCell>
								</g:row>
								<g:row>
									<g:customCell>
										<g:Label styleName="{style.bold}">FOGASA</g:Label>
									</g:customCell>
									<g:customCell styleName="{style.alignCenter}">
										<g:CheckBox ui:field='checkFogasaC'></g:CheckBox>
									</g:customCell>
									<g:customCell styleName="{style.alignCenter}">
										<g:CheckBox ui:field='checkFogasaE'></g:CheckBox>
									</g:customCell>
								</g:row>
								<g:row>
									<g:customCell>
										<g:Label styleName="{style.bold}">Formación profesional</g:Label>
									</g:customCell>
									<g:customCell styleName="{style.alignCenter}">
										<g:CheckBox ui:field='checkFormationC'></g:CheckBox>
									</g:customCell>
									<g:customCell styleName="{style.alignCenter}">
										<g:CheckBox ui:field='checkFormationE'></g:CheckBox>
									</g:customCell>
								</g:row>
							</g:Grid>
							<g:Button ui:field='applyChecks' styleName="{style.button}">Aplicar</g:Button>
			            </g:HTMLPanel>
			            <g:HTMLPanel ui:field='amountPanel' styleName="{style.paddingHide}">
			                <hr align="left" noshade="noshade" style="margin-bottom: 20px;width: 80%;border-width: 0.5px;"/>
			                <g:HorizontalPanel>
			                	<g:Label styleName="{style.paddingTop} {style.bold}">Cantidad: </g:Label>
			            		<g:TextBox ui:field='amountBonus' width="300px"></g:TextBox>
			            	</g:HorizontalPanel>
			            	<g:Button ui:field='applyAmount' styleName="{style.button}">Aplicar</g:Button>
			            </g:HTMLPanel>
             		</g:HTMLPanel>
             		<g:HTMLPanel ui:field='listBonusesPanel' styleName="{style.paddingHide}">
             		    <g:Label styleName="{style.title2}">LISTA BONIFICACIONES</g:Label>
             			<hr align="left" noshade="noshade" style="margin-bottom: 20px;width: 80%;border-width: 0.5px;"/>
             			<g:ScrollPanel>
             				<g:Grid ui:field="listBonusesTable" width="95%" styleName="{style.noselect}">
             				    <g:row>
             				        <g:customCell>
										<g:Label>&nbsp;</g:Label>
									</g:customCell>
             				        <g:customCell>
										<g:Label>&nbsp;</g:Label>
									</g:customCell>
             				        <g:customCell>
										<g:Label>&nbsp;</g:Label>
									</g:customCell>
									<g:customCell>
										<g:Label>&nbsp;</g:Label>
									</g:customCell>
									<g:customCell>
										<g:Label>&nbsp;</g:Label>
									</g:customCell>
									<g:customCell>
										<g:Label>&nbsp;</g:Label>
									</g:customCell>
									<g:customCell>
										<g:Label>&nbsp;</g:Label>
									</g:customCell>
									<g:customCell>
										<g:Label>&nbsp;</g:Label>
									</g:customCell>
             				    </g:row>
             				</g:Grid>
             			</g:ScrollPanel>
             		</g:HTMLPanel>
		        </g:HTMLPanel> 
		    </g:ScrollPanel>
		</g:center>
	</g:DockLayoutPanel>
</ui:UiBinder> 

