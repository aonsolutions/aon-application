<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<ui:UiBinder xmlns:ui='urn:ui:com.google.gwt.uibinder'
	xmlns:g='urn:import:com.google.gwt.user.client.ui' xmlns:aon='urn:import:com.esferalia.aon.gwt.payroll.client'>

	<ui:with field='msgs' type='com.esferalia.aon.gwt.payroll.client.i18n.PayrollMessages'/>

	<ui:Style>
	.editor {
		
	}
	
	.vertical-space {
		height: 20px;
	}
	
	.document {
		margin-top: 5px;
		margin-left: auto;
		margin-right: auto;
		margin-bottom: 15px;
	}
	
	</ui:Style>



	<g:DockLayoutPanel unit="PX" ui:field="mainPanel">
		<g:north size="72">

			<g:FlowPanel>

				<g:FlowPanel styleName="aon-finding-title-toolbar">
					<g:HorizontalPanel>
						<g:HTMLPanel styleName="aon-finding-title">
							<g:HTMLPanel styleName="aon-finding-title-internal">
								<g:Label styleName="aon-outputText">{msgs.bonuses}</g:Label>
							</g:HTMLPanel>
						</g:HTMLPanel>
						<g:HTMLPanel styleName="aon-finding-subtitle">
							<g:HTMLPanel styleName="aon-finding-subtitle-internal">
								<g:Label styleName="aon-outputText"></g:Label>
							</g:HTMLPanel>
						</g:HTMLPanel>
						<g:HorizontalPanel styleName="aon-finding-toolbar">
							<g:HTMLPanel styleName="aon-finding-toolbar-item-group">
								<g:Button ui:field='acceptButton'
									styleName='aon-finding-toolbar-item aon-icon-accept' text="{msgs.saveAction}" />
								<g:Button ui:field='deleteButton'
									styleName='aon-finding-toolbar-item aon-icon-delete' text="{msgs.deleteAction}" />
								<!--  g:Button ui:field="undoButton" styleName='aon-finding-toolbar-item 
									{style.undoButton}' enabled="false" /> <g:Button ui:field='redoButton' styleName="aon-finding-toolbar-item 
									{style.redoButton}" enabled="false" /> -->
							</g:HTMLPanel>
						</g:HorizontalPanel>
					</g:HorizontalPanel>
				</g:FlowPanel>

			</g:FlowPanel>

		</g:north>
		<g:center>

			<g:ScrollPanel styleName="{style.editor}">
				<g:VerticalPanel styleName="{style.document} aon-width-all">
					<aon:Bonus ui:field="bonusUI" />
				</g:VerticalPanel>
			</g:ScrollPanel>

		</g:center>

	</g:DockLayoutPanel>

</ui:UiBinder>