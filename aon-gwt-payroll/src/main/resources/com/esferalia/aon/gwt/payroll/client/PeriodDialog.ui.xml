<ui:UiBinder xmlns:ui='urn:ui:com.google.gwt.uibinder'
	xmlns:g='urn:import:com.google.gwt.user.client.ui' 
	xmlns:es3='urn:import:com.google.gwt.user.client.ui'
	xmlns:datepicker='urn:import:com.google.gwt.user.datepicker.client'>
	
	<ui:Style>

		.form {
			padding: 10px; 		
		}

		.label {
			margin-top:10x;
			font-weight: bold;
			padding: 1px 0.5em;
			white-space: nowrap;
			background-color: #F2F2F2;
		}

		.labeltop {
			margin-top:10x;
			font-weight: bold;
			padding: 1px 0.5em;
			vertical-align: top;			
			white-space: nowrap;
			background-color: #F2F2F2;
		}

		.field {
			padding: 1px 0.5em;
		}
		
		.info {
		}

		.warn {
		}

		.error {
		}

		.messages {
			padding-left: 0.5em;
			padding-bottom: 10px; 		
		}

		.buttons {
			padding-top: 10px; 		
			text-align: right;
		}



	</ui:Style>
	<g:HTMLPanel styleName="{style.form}">
		
		<div class="{style.messages}" >
			<g:Label styleName="{style.info}">Introduzca las fechas:</g:Label>
		</div>

		<g:Grid width="100%" >
			<g:row>
				<g:customCell styleName="{style.label}" ><g:Label text="Fecha" /></g:customCell>
				<g:customCell styleName="{style.label}" ><g:Label text="Desde" /></g:customCell>
				<g:customCell styleName="{style.field}" ><datepicker:DateBox ui:field="startDateBox"/></g:customCell>
				<g:customCell styleName="{style.label}" ><g:Label text="Hasta" /></g:customCell>
				<g:customCell styleName="{style.field}" ><datepicker:DateBox ui:field="endDateBox"/></g:customCell>
			</g:row>
			<g:row>
				<g:customCell ><g:Label/></g:customCell>
				<g:customCell ><g:Label/></g:customCell>
				<g:customCell ><g:Label ui:field="startDatePatternLabel"  /></g:customCell>
				<g:customCell ><g:Label/></g:customCell>
				<g:customCell ><g:Label ui:field="endDatePatternLabel"  /></g:customCell>
			</g:row>
		</g:Grid>
		
		<div class="{style.buttons}">
			<g:Button ui:field="cancelButton" >Cancelar</g:Button>
			<g:Button ui:field="acceptButton" enabled="false">Aceptar</g:Button>
		</div>
	
	</g:HTMLPanel>


</ui:UiBinder>