<?xml version="1.0" encoding="UTF-8" ?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xmlns="http://www.esferalia.com/common">

	<config:config version="1.0" xmlns:config="http://www.esferalia.com/config" >
		<config:series
			showOfferData="true"
			showSalesData="false"
			showDeliveryData="false"
			showInvoiceData="false"
		/>
	</config:config>	

	<product:config version="1.2" xmlns:product="http://www.esferalia.com/product">
		<product:catalogue
			showEcommerceData="true"
		/>		
		<product:product
			showBarcode="true"
			showType="false"
			showBrand="true"
			showStock="false"
			showTariff="false"
			showCatalogues="false"
			showComposition="false"
			showAlternatives="false"
			showSuppliers="false"
			showAccount="false"
			showAttachment="true"
			showEcommerceData="true"
			showHistory="false"
		/>
		<product:productCategory
			showCategoryGroup="true"
		/>
	</product:config>
	
	<commercial:config version="1.3" xmlns:commercial="http://www.esferalia.com/commercial">
		<commercial:offer
			showInvoicing="false"
			showSalesOrder="true"
			showSeller="false"
		/>
		<commercial:target
			showTaxInfoData="true"
			showEcommerceTab="true"
			showProfile="false"
			showSearchOnlyCustomers="false"
			showProject="false"
			showProduct="true"
			showSeller="false"
			showAddInfo="true"
			showSupplier="false"
			showTariff="false"
			showFinanceData="false"
			showNote="false"
		/>
		
	</commercial:config>

	<webmail:config version="1.2" xmlns:webmail="http://www.esferalia.com/webmail" >
		<webmail:webmail
			connect="true"
			showDomainMailAccounts="true"
		/>
	</webmail:config>	

</config>
