<faces-config version="1.2"
	xmlns="http://java.sun.com/xml/ns/javaee"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://java.sun.com/xml/ns/javaee http://java.sun.com/xml/ns/javaee/web-facesconfig_1_2.xsd">

	<application>
		<resource-bundle>
			<base-name>com.code.aon.ui.sales.i18n.messages</base-name>
			<var>salesBundle</var>
		</resource-bundle>
	</application>

	<!--  *************** COLLECTIONS ***************** -->
	<managed-bean>
		<managed-bean-name>salesCollections</managed-bean-name>
		<managed-bean-class>
			com.code.aon.ui.sales.controller.SalesCollectionsController
		</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
	</managed-bean>

	<!-- ****** SALES ****** -->
	<managed-bean>
		<managed-bean-name>sales</managed-bean-name>
		<managed-bean-class>
			com.code.aon.ui.sales.controller.SalesController
		</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
		<managed-property>
			<property-name>pojo</property-name>
			<value>com.code.aon.sales.Sales</value>
		</managed-property>
		<managed-property>
			<property-name>beanName</property-name>
			<value>sales</value>
		</managed-property>
		<managed-property>
			<property-name>defaultOrder</property-name>
			<value>Sales_issueDate desc,Sales_series desc,Sales_number desc</value>
		</managed-property>
		<managed-property>
			<property-name>listenerClasses</property-name>
			<list-entries>
				<value-class>
					com.code.aon.ui.form.event.IControllerListener
				</value-class>
				<value>#{salesSearch}</value>
				<value>#{salesScopeListener}</value>
				<value>#{salesHeaderControllerListener}</value>
				<value>#{salesControllerListener}</value>
				<value>#{salesDetailChildListener}</value>
				<value>#{nullableBankAccountValidatorListener}</value>
			</list-entries>
		</managed-property>
	</managed-bean>

	<managed-bean>
		<managed-bean-name>salesSearch</managed-bean-name>
		<managed-bean-class>
			com.code.aon.ui.sales.event.SalesSearchListener
		</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
	</managed-bean>

	<managed-bean>
		<managed-bean-name>salesScopeListener</managed-bean-name>
		<managed-bean-class>com.code.aon.ui.config.event.ScopeFilterListener</managed-bean-class>
		<managed-bean-scope>none</managed-bean-scope>
		<managed-property>
			<property-name>aliasName</property-name>
			<value>Sales_scope_id</value>
		</managed-property>
	</managed-bean>
	
 	<managed-bean>
		<managed-bean-name>salesHeaderControllerListener</managed-bean-name>
		<managed-bean-class>com.code.aon.ui.config.event.HeaderControllerListener</managed-bean-class>
		<managed-bean-scope>none</managed-bean-scope>
	</managed-bean>

	<managed-bean>
		<managed-bean-name>salesControllerListener</managed-bean-name>
		<managed-bean-class>
			com.code.aon.ui.sales.event.SalesControllerListener
		</managed-bean-class>
		<managed-bean-scope>none</managed-bean-scope>
	</managed-bean>

	<managed-bean>
		<managed-bean-name>salesDetailChildListener</managed-bean-name>
		<managed-bean-class>
			com.code.aon.ui.form.listener.LinesControllerListener
		</managed-bean-class>
		<managed-bean-scope>none</managed-bean-scope>
		<managed-property>
			<property-name>childBean</property-name>
			<value>salesDetail</value>
		</managed-property>
		<managed-property>
			<property-name>aliasMap</property-name>
			<map-entries>
				<map-entry>
					<key>SalesDetail_sales_id</key>
                    <value>id</value>
				</map-entry>
			</map-entries>
		</managed-property>
	</managed-bean>

	<!-- ****** SALES DETAIL ****** -->
	<managed-bean>
		<managed-bean-name>salesDetail</managed-bean-name>
		<managed-bean-class>
			com.code.aon.ui.sales.controller.SalesDetailController
		</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
		<managed-property>
			<property-name>pageLimit</property-name>
			<value>-1</value>
		</managed-property>
		<managed-property>
			<property-name>pojo</property-name>
			<value>com.code.aon.sales.SalesDetail</value>
		</managed-property>
		<managed-property>
			<property-name>beanName</property-name>
			<value>salesDetail</value>
		</managed-property>
		<managed-property>
			<property-name>defaultOrder</property-name>
			<value>SalesDetail_line</value>
		</managed-property>
		<managed-property>
			<property-name>masterControllerName</property-name>
			<value>sales</value>
		</managed-property>
		<managed-property>
			<property-name>propertyMap</property-name>
			<map-entries>
				<map-entry>
					<key>id</key>
					<value>sales.id</value>
				</map-entry>
			</map-entries>
		</managed-property>
		<managed-property>
			<property-name>cascadeDelete</property-name>
			<value>true</value>
		</managed-property>
		<managed-property>
			<property-name>listenerClasses</property-name>
			<list-entries>
				<value-class>com.code.aon.ui.form.event.IControllerListener</value-class>
				<value>#{salesDetailControllerListener}</value>
				<value>#{salesDetailCompositeListener}</value>
			</list-entries>
		</managed-property>
	</managed-bean>
	
	<managed-bean>
		<managed-bean-name>salesDetailControllerListener</managed-bean-name>
		<managed-bean-class>
			com.code.aon.ui.sales.event.SalesDetailControllerListener
		</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
	</managed-bean>
	
	<managed-bean>
		<managed-bean-name>salesDetailCompositeListener</managed-bean-name>
		<managed-bean-class>
			com.code.aon.ui.sales.event.SalesDetailCompositeListener
		</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
	</managed-bean>
	
	<!-- ****** ORDER SERVER ****** -->
	<managed-bean>
		<managed-bean-name>orderServer</managed-bean-name>
		<managed-bean-class>
			com.code.aon.ui.sales.controller.OrderServerController
		</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
		<managed-property>
			<property-name>pojo</property-name>
			<value>com.code.aon.sales.Sales</value>
		</managed-property>
		<managed-property>
			<property-name>beanName</property-name>
			<value>orderServer</value>
		</managed-property>
		<managed-property>
			<property-name>defaultOrder</property-name>
			<value>Sales_issueDate desc,Sales_series desc,Sales_number desc</value>
		</managed-property>
		<managed-property>
			<property-name>listenerClasses</property-name>
			<list-entries>
				<value-class>
					com.code.aon.ui.form.event.IControllerListener
				</value-class>
				<value>#{salesSearch}</value>
				<value>#{salesScopeListener}</value>
				<!--  
				<value>#{salesHeaderControllerListener}</value>
				<value>#{salesControllerListener}</value>
				-->
			</list-entries>
		</managed-property>
	</managed-bean>
	
	<!-- ****** AMAZON SALES IMPORTER ****** -->
	<managed-bean>
		<managed-bean-name>salesImporter</managed-bean-name>
		<managed-bean-class>
			com.code.aon.ui.sales.controller.SalesImporterController
		</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
	</managed-bean>

	<!-- ****** SALES APP PARAMS ****** -->
	<managed-bean>
		<managed-bean-name>salesAppParam</managed-bean-name>
		<managed-bean-class>
			com.code.aon.ui.sales.controller.SalesAppParamController
		</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
	</managed-bean>
	
   	<!-- ************* NAVIGATION RULES ***************** -->
	<navigation-rule>
		<navigation-case>
			<from-outcome>sales_list</from-outcome>
			<to-view-id>/com/code/aon/ui/sales/facelet/sales/list.xhtml</to-view-id>
		</navigation-case>
		<navigation-case>
			<from-outcome>sales_form</from-outcome>
			<to-view-id>/com/code/aon/ui/sales/facelet/sales/form.xhtml</to-view-id>
		</navigation-case>
		<navigation-case>
			<from-outcome>sales_search</from-outcome>
			<to-view-id>/com/code/aon/ui/sales/facelet/sales/search.xhtml</to-view-id>
		</navigation-case>
	</navigation-rule>
	
	<!-- ************* ORDER SERVER ***************** -->
	<navigation-rule>
		<navigation-case>
			<from-outcome>orderServer_search</from-outcome>
			<to-view-id>/com/code/aon/ui/sales/facelet/orderServer/search.xhtml</to-view-id>
		</navigation-case>
		<navigation-case>
			<from-outcome>orderServer_list</from-outcome>
			<to-view-id>/com/code/aon/ui/sales/facelet/orderServer/list.xhtml</to-view-id>
		</navigation-case>
	</navigation-rule>		
	
	<!-- ************* AMAZON SALES IMPORTER ***************** -->
	<navigation-rule>
		<navigation-case>
			<from-outcome>salesImporter_form</from-outcome>
			<to-view-id>/com/code/aon/ui/sales/facelet/salesImporter/form.xhtml</to-view-id>
		</navigation-case>
	</navigation-rule>		
	
</faces-config>