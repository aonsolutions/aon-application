	<parameter name="invoiceId" isForPrompting="false" class="java.lang.Integer"/>
	<queryString><![CDATA[select finance.due_date,
       finance.concept,
       finance.amount,
       pay_method.name
FROM finance inner join invoice on finance.`invoice` = invoice.`id`
     inner join `pay_method` on `finance`.`pay_method` = `pay_method`.`id`
where finance.`invoice` = $P{invoiceId}]]></queryString>

