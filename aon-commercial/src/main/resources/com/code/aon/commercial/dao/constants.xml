<?xml version="1.0" encoding="ISO-8859-1"?>
<dao>
	<bean class="com.code.aon.commercial.OfferDetail" sqlName="offer_detail">
		<alias names="id,offer_id,line,item_id,item_product_type,description,quantity,price,discountExpression,status"/>
		<hibernate names="id,offer.id,line,item.id,item.product.type,description,quantity,price,discountExpression,status"/>
	</bean>
	<bean class="com.code.aon.commercial.Target" sqlName="target">
		<alias names="id,registry_id,registry_name,registry_surname,registry_alias,registry_document,advertising,surcharge,withholding,transaction,status"/>
		<hibernate names="id,registry.id,registry.name,registry.surname,registry.alias,registry.document,advertising,surcharge,withholding,transaction,status"/>
	</bean>	
	<bean class="com.code.aon.commercial.TargetThirdParty" sqlName="target_third_party">
		<alias names="id,target_id,thirdParty_id,thirdParty_registry_name,thirdParty_registry_surname,targetExternalCode,tariff_id,payMethod_id,numberOfPayments,daysToFirstPayment,daysBetweenPayments,paymentDays,bank_id,bankAccount"/>
		<hibernate names="id,target.id,thirdParty.id,thirdParty.registry.name,thirdParty.registry.surname,targetExternalCode,tariff.id,payMethod.id,numberOfPayments,daysToFirstPayment,daysBetweenPayments,paymentDays,bank.id,bankAccount"/>
	</bean>
</dao>