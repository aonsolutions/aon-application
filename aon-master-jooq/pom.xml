<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">

	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>com.code.aon</groupId>
		<artifactId>aon.parent</artifactId>
		<version>9.23-SNAPSHOT</version>
	</parent>
	<groupId>com.esferalia.aon</groupId>
	<artifactId>aon.master.jooq</artifactId>
	<name>AON MASTER JOOQ</name>
	<description>AON MASTER JOOQ</description>

	<build>
		<plugins>
			<!-- Creates database -->
			<plugin>
				<groupId>com.esferalia.aon</groupId>
				<artifactId>aon-maven-plugin</artifactId>
				<version>${project.version}</version>
				<executions>
					<execution>
						<id>create-db</id>
						<goals>
							<goal>create-db</goal>
						</goals>
						<configuration>
							<dbName>aon_jooq_${buildNumber}</dbName>
						</configuration>
					</execution>
				</executions>
			</plugin>

			<plugin>

				<!-- Specify the maven code generator plugin -->
				<groupId>org.jooq</groupId>
				<artifactId>jooq-codegen-maven</artifactId>
				<version>3.16.6</version>

				<!-- The plugin should hook into the generate goal -->
				<executions>
					<execution>
						<goals>
							<goal>generate</goal>
						</goals>
					</execution>
				</executions>

				<!-- Manage the plugin's dependency. We'll use a MySQL database -->
				<dependencies>
					<dependency>
						<groupId>mysql</groupId>
						<artifactId>mysql-connector-java</artifactId>
						<version>8.0.13</version>
					</dependency>
				</dependencies>

				<!-- Specify the plugin configuration. The configuration format is the 
					same as for the standalone code generator -->
				<configuration>

					<!-- JDBC connection parameters -->
					<jdbc>
						<driver>com.mysql.jdbc.Driver</driver>
						<url>jdbc:mysql://127.0.0.1:3306</url>
						<user>dbuser</user>
						<password>serubd2000</password>
					</jdbc>

					<!-- Generator parameters -->
					<generator>
						<name>org.jooq.codegen.DefaultGenerator</name>

						<database>
		
							<forcedTypes>
								<forcedType>
									<name>DOUBLE</name>
									<includeTypes>(?i:DECIMAL)</includeTypes>
								</forcedType>
							</forcedTypes>
							
							<!-- MySQL database dialect from jooq-meta. -->
							<name>org.jooq.meta.mysql.MySQLDatabase</name>

      							<!-- All elements are generated from our schema  -->
							<includes>.*</includes>

      							<!--No elements are excluded from our schema  -->
							<excludes />

							<inputSchema>aon_jooq_${buildNumber}</inputSchema>

							<!-- Use this as the integration / production database: -->
							<outputSchema>aon-master</outputSchema>
			
						</database>
						
						<generate>
							<javaTimeTypes>false</javaTimeTypes>						
						</generate>

						<target>
							<packageName>com.esferalia.aon.jooq</packageName>
							<directory>target/generated-sources</directory>
						</target>
					</generator>
				</configuration>
			</plugin>
		</plugins>
	</build>

	<dependencies>

		<dependency>
			<groupId>org.jooq</groupId>
			<artifactId>jooq</artifactId>
			<version>3.16.6</version>
		</dependency>
		<dependency>
			<groupId>javax.annotation</groupId>
			<artifactId>javax.annotation-api</artifactId>
			<version>1.3.2</version>
		</dependency>

	</dependencies>
</project>
