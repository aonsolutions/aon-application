<faces-config version="1.2" xmlns="http://java.sun.com/xml/ns/javaee"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://java.sun.com/xml/ns/javaee http://java.sun.com/xml/ns/javaee/web-facesconfig_1_2.xsd">
 
	<!-- ************ COLLECTION **************** -->
	<managed-bean>
		<managed-bean-name>fiscalCollections</managed-bean-name>
		<managed-bean-class>com.code.aon.ui.fiscal.controller.FiscalCollectionsController</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
	</managed-bean>

	<!-- ************ PARAMETERS **************** -->
	<managed-bean>
		<managed-bean-name>fiscalParams</managed-bean-name>
		<managed-bean-class>com.code.aon.ui.fiscal.controller.FiscalParametersController</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
	</managed-bean>

	<!-- **************** INVOICE REPORT  *************** -->
	<managed-bean>
		<managed-bean-name>invoiceReport</managed-bean-name>
		<managed-bean-class>com.code.aon.ui.fiscal.controller.InvoiceReportController</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
	</managed-bean>

	<!-- **************** FISCAL MATRIX  *************** -->
	<managed-bean>
		<managed-bean-name>fiscalMatrix</managed-bean-name>
		<managed-bean-class>com.code.aon.ui.fiscal.controller.FiscalMatrix</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
	</managed-bean>
	
	<!-- **************** VAT REPORT  *************** -->
	<managed-bean>
		<managed-bean-name>vatReport</managed-bean-name>
		<managed-bean-class>com.code.aon.ui.fiscal.controller.VatReportController</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
		<managed-property>
			<property-name>beanName</property-name>
			<value>vatReport</value>
		</managed-property>				
	</managed-bean>

	<!-- ================================================ -->
	<!-- =================== NAVIGATION ================= -->
	<!-- ================================================ -->

	<!-- =================== FISCAL PARAMETERS ================= -->
	<navigation-rule>
		<navigation-case>
			<from-outcome>fiscalParams</from-outcome>
			<to-view-id>/com/code/aon/ui/fiscal/facelet/params/form.xhtml</to-view-id>
		</navigation-case>
	</navigation-rule>

	<!-- =================== INVOICE REPORT ================= -->
	<navigation-rule>
		<navigation-case>
			<from-outcome>invoiceReport_search</from-outcome>
			<to-view-id>/com/code/aon/ui/fiscal/facelet/invoice/search.xhtml</to-view-id>
		</navigation-case>
	</navigation-rule>

	<!-- =================== VAT REPORT ================= -->
	<navigation-rule>
		<navigation-case>
			<from-outcome>vat_report_search</from-outcome>
			<to-view-id>/com/code/aon/ui/fiscal/facelet/vat/search.xhtml</to-view-id>
		</navigation-case>
		<navigation-case>
			<from-outcome>vat_report_list</from-outcome>
			<to-view-id>/com/code/aon/ui/fiscal/facelet/vat/list.xhtml</to-view-id>
		</navigation-case>
		<navigation-case>
			<from-outcome>vat_report_detail</from-outcome>
			<to-view-id>/com/code/aon/ui/fiscal/facelet/vat/detailList.xhtml</to-view-id>
		</navigation-case>
	</navigation-rule>
	
	<!-- =================== FISCAL ACTIVITY  ================= -->
	<navigation-rule>
		<navigation-case>
			<from-outcome>fiscalMatrix_list</from-outcome>
			<to-view-id>/com/code/aon/ui/fiscal/facelet/matrix/list.xhtml</to-view-id>
		</navigation-case>
	</navigation-rule>
	
		
</faces-config>
