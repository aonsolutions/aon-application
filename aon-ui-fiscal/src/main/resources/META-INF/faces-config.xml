<faces-config version="1.2" xmlns="http://java.sun.com/xml/ns/javaee"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://java.sun.com/xml/ns/javaee http://java.sun.com/xml/ns/javaee/web-facesconfig_1_2.xsd">
 
	<!-- ************ COLLECTION **************** -->
	<managed-bean>
		<managed-bean-name>fiscalCollections</managed-bean-name>
		<managed-bean-class>com.code.aon.ui.fiscal.controller.FiscalCollectionsController</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
	</managed-bean>

	<!-- ************ PARAMETERS **************** -->
	<managed-bean>
		<managed-bean-name>fiscalParams</managed-bean-name>
		<managed-bean-class>com.code.aon.ui.fiscal.controller.FiscalParametersController</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
	</managed-bean>

	<!-- **************** INVOICE REPORT  *************** -->
	<managed-bean>
		<managed-bean-name>invoiceReport</managed-bean-name>
		<managed-bean-class>com.code.aon.ui.fiscal.controller.InvoiceReportController</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
	</managed-bean>

	<!-- **************** FISCAL MATRIX  *************** -->
	<managed-bean>
		<managed-bean-name>fiscalMatrix</managed-bean-name>
		<managed-bean-class>com.code.aon.ui.fiscal.controller.FiscalMatrix</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
	</managed-bean>
	
	<!-- **************** MODEL 340 REPORT  *************** -->
	<managed-bean>
		<managed-bean-name>mod340</managed-bean-name>
		<managed-bean-class>com.code.aon.ui.fiscal.controller.mod340.Mod340Controller</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
	</managed-bean>

	<!-- **************** RETENTION REPORT  *************** -->
	<managed-bean>
		<managed-bean-name>retentionReport</managed-bean-name>
		<managed-bean-class>com.code.aon.ui.fiscal.controller.RetentionReportController</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
	</managed-bean>

	<!-- **************** VAT REPORT  *************** -->
	<managed-bean>
		<managed-bean-name>vatReport</managed-bean-name>
		<managed-bean-class>com.code.aon.ui.fiscal.controller.VatReportController</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
		<managed-property>
			<property-name>beanName</property-name>
			<value>vatReport</value>
		</managed-property>				
	</managed-bean>

	<!-- **************** FISCAL ACTIVITY  *************** -->
	<managed-bean>
		<managed-bean-name>fiscalActivity</managed-bean-name>
		<managed-bean-class>com.code.aon.ui.fiscal.controller.activity.FiscalActivityController</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
		<managed-property>
			<property-name>queryOnStartUP</property-name>
			<value>true</value>
		</managed-property>
		<managed-property>
			<property-name>pojo</property-name>
			<value>com.code.aon.fiscal.FiscalActivity</value>
		</managed-property>
		<managed-property>
			<property-name>beanName</property-name>
			<value>fiscalActivity</value>
		</managed-property>		
		<managed-property>
			<property-name>defaultOrder</property-name>
			<value>FiscalActivity_year desc,FiscalActivity_id</value>
		</managed-property>
		<managed-property>
			<property-name>listenerClasses</property-name>
			<list-entries>
				<value-class>com.code.aon.ui.form.event.IControllerListener</value-class>
				<value>#{fiscalActivityControllerListener}</value>
			</list-entries>
		</managed-property>
	</managed-bean>

	<managed-bean>
		<managed-bean-name>fiscalActivityControllerListener</managed-bean-name>
		<managed-bean-class>com.code.aon.ui.fiscal.event.FiscalActivityControllerListener</managed-bean-class>
		<managed-bean-scope>none</managed-bean-scope>
	</managed-bean>

	<!-- ================================================ -->
	<!-- =================== NAVIGATION ================= -->
	<!-- ================================================ -->

	<!-- =================== FISCAL PARAMETERS ================= -->
	<navigation-rule>
		<navigation-case>
			<from-outcome>fiscalParams</from-outcome>
			<to-view-id>/com/code/aon/ui/fiscal/facelet/params/form.xhtml</to-view-id>
		</navigation-case>
	</navigation-rule>

	<!-- =================== INVOICE REPORT ================= -->
	<navigation-rule>
		<navigation-case>
			<from-outcome>invoiceReport_search</from-outcome>
			<to-view-id>/com/code/aon/ui/fiscal/facelet/invoice/search.xhtml</to-view-id>
		</navigation-case>
	</navigation-rule>

	<!-- =================== MODEL 340 REPORT ================= -->
	<navigation-rule>
		<navigation-case>
			<from-outcome>mod340_search</from-outcome>
			<to-view-id>/com/code/aon/ui/fiscal/facelet/mod340/search.xhtml</to-view-id>
		</navigation-case>
		<navigation-case>
			<from-outcome>mod340_list</from-outcome>
			<to-view-id>/com/code/aon/ui/fiscal/facelet/mod340/list.xhtml</to-view-id>
		</navigation-case>
	</navigation-rule>

	<!-- =================== RETENTION REPORT ================= -->
	<navigation-rule>
		<navigation-case>
			<from-outcome>retention_report_search</from-outcome>
			<to-view-id>/com/code/aon/ui/fiscal/facelet/retention/search.xhtml</to-view-id>
		</navigation-case>
		<navigation-case>
			<from-outcome>retention_report_list</from-outcome>
			<to-view-id>/com/code/aon/ui/fiscal/facelet/retention/list.xhtml</to-view-id>
		</navigation-case>
		<navigation-case>
			<from-outcome>retention_report_detail</from-outcome>
			<to-view-id>/com/code/aon/ui/fiscal/facelet/retention/detailList.xhtml</to-view-id>
		</navigation-case>
		<navigation-case>
			<from-outcome>retention_report_detail_grouped</from-outcome>
			<to-view-id>/com/code/aon/ui/fiscal/facelet/retention/groupedDetailList.xhtml</to-view-id>
		</navigation-case>
	</navigation-rule>

	<!-- =================== VAT REPORT ================= -->
	<navigation-rule>
		<navigation-case>
			<from-outcome>vat_report_search</from-outcome>
			<to-view-id>/com/code/aon/ui/fiscal/facelet/vat/search.xhtml</to-view-id>
		</navigation-case>
		<navigation-case>
			<from-outcome>vat_report_list</from-outcome>
			<to-view-id>/com/code/aon/ui/fiscal/facelet/vat/list.xhtml</to-view-id>
		</navigation-case>
		<navigation-case>
			<from-outcome>vat_report_detail</from-outcome>
			<to-view-id>/com/code/aon/ui/fiscal/facelet/vat/detailList.xhtml</to-view-id>
		</navigation-case>
	</navigation-rule>
	
	<!-- =================== FISCAL ACTIVITY  ================= -->
	<navigation-rule>
		<navigation-case>
			<from-outcome>fiscalActivity_search</from-outcome>
			<to-view-id>/com/code/aon/ui/fiscal/facelet/activity/search.xhtml</to-view-id>
		</navigation-case>
		<navigation-case>
			<from-outcome>fiscalActivity_list</from-outcome>
			<to-view-id>/com/code/aon/ui/fiscal/facelet/activity/list.xhtml</to-view-id>
		</navigation-case>
		<navigation-case>
			<from-outcome>fiscalActivity_form</from-outcome>
			<to-view-id>/com/code/aon/ui/fiscal/facelet/activity/form.xhtml</to-view-id>
		</navigation-case>
	</navigation-rule>
	
	<!-- =================== FISCAL ACTIVITY  ================= -->
	<navigation-rule>
		<navigation-case>
			<from-outcome>fiscalMatrix_list</from-outcome>
			<to-view-id>/com/code/aon/ui/fiscal/facelet/matrix/list.xhtml</to-view-id>
		</navigation-case>
	</navigation-rule>
	
		
</faces-config>
