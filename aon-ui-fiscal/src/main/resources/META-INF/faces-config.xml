<faces-config version="1.2"
	xmlns="http://java.sun.com/xml/ns/javaee"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://java.sun.com/xml/ns/javaee http://java.sun.com/xml/ns/javaee/web-facesconfig_1_2.xsd">

	<application>
		<resource-bundle>
			<base-name>com.code.aon.ui.fiscal.i18n.messages</base-name>
			<var>fiscalBundle</var>
		</resource-bundle>
	</application>

	<!-- ************ COLLECTION **************** -->
	<managed-bean>
		<managed-bean-name>fiscalCollections</managed-bean-name>
		<managed-bean-class>
			com.code.aon.ui.fiscal.controller.FiscalCollectionsController
		</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
	</managed-bean>

	<!-- **************** VAT REPORT  *************** -->
	<managed-bean>
		<managed-bean-name>vatReport</managed-bean-name>
		<managed-bean-class>
			com.code.aon.ui.fiscal.controller.VatReportController
		</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
	</managed-bean>
	
	<!-- **************** RETENTION REPORT  *************** -->
	<managed-bean>
		<managed-bean-name>retentionReport</managed-bean-name>
		<managed-bean-class>
			com.code.aon.ui.fiscal.controller.RetentionReportController
		</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
	</managed-bean>
	
	<!-- **************** MODEL 347 REPORT  *************** -->
	<managed-bean>
		<managed-bean-name>model347</managed-bean-name>
		<managed-bean-class>
			com.code.aon.ui.fiscal.controller.Model347Controller
		</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
	</managed-bean>

	<!-- **************** MODEL 303 REPORT  *************** -->
	<managed-bean>
		<managed-bean-name>model303</managed-bean-name>
		<managed-bean-class>
			com.code.aon.ui.fiscal.controller.Model303Controller
		</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
	</managed-bean>
	

	<!-- ================================================ -->
	<!-- =================== NAVIGATION ================= -->
	<!-- ================================================ -->

	<!-- =================== VAT REPORT ================= -->
	<navigation-rule>
		<navigation-case>
			<from-outcome>vat_report_search</from-outcome>
			<to-view-id>/com/code/aon/ui/fiscal/facelet/vat/search.xhtml</to-view-id>
		</navigation-case>
		<navigation-case>
			<from-outcome>vat_report_list</from-outcome>
			<to-view-id>/com/code/aon/ui/fiscal/facelet/vat/list.xhtml</to-view-id>
		</navigation-case>
		<navigation-case>
			<from-outcome>vat_report_detail</from-outcome>
			<to-view-id>/com/code/aon/ui/fiscal/facelet/vat/detailList.xhtml</to-view-id>
		</navigation-case>
	</navigation-rule>
	
	<!-- =================== RETENTION REPORT ================= -->
	<navigation-rule>
		<navigation-case>
			<from-outcome>retentionReport_search</from-outcome>
			<to-view-id>/com/code/aon/ui/fiscal/facelet/retention/search.xhtml</to-view-id>
		</navigation-case>
		<navigation-case>
			<from-outcome>retentionReport_list</from-outcome>
			<to-view-id>/com/code/aon/ui/fiscal/facelet/retention/list.xhtml</to-view-id>
		</navigation-case>
	</navigation-rule>

	<!-- =================== MODEL 347 REPORT ================= -->
	<navigation-rule>
		<navigation-case>
			<from-outcome>model347_search</from-outcome>
			<to-view-id>/com/code/aon/ui/fiscal/facelet/model347/search.xhtml</to-view-id>
		</navigation-case>
		<navigation-case>
			<from-outcome>model347_list</from-outcome>
			<to-view-id>/com/code/aon/ui/fiscal/facelet/model347/list.xhtml</to-view-id>
		</navigation-case>
	</navigation-rule>

	<!-- =================== MODEL 303 REPORT ================= -->
	<navigation-rule>
		<navigation-case>
			<from-outcome>model303_search</from-outcome>
			<to-view-id>/com/code/aon/ui/fiscal/facelet/model303/search.xhtml</to-view-id>
		</navigation-case>
		<navigation-case>
			<from-outcome>model303_list</from-outcome>
			<to-view-id>/com/code/aon/ui/fiscal/facelet/model303/list.xhtml</to-view-id>
		</navigation-case>
	</navigation-rule>
</faces-config>
