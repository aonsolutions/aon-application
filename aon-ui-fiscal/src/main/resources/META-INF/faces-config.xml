<faces-config version="1.2" xmlns="http://java.sun.com/xml/ns/javaee"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://java.sun.com/xml/ns/javaee http://java.sun.com/xml/ns/javaee/web-facesconfig_1_2.xsd">

	<application>
		<resource-bundle>
			<base-name>com.code.aon.ui.fiscal.i18n.messages</base-name>
			<var>fiscalBundle</var>
		</resource-bundle>
	</application>

	<!-- ************ COLLECTION **************** -->
	<managed-bean>
		<managed-bean-name>fiscalCollections</managed-bean-name>
		<managed-bean-class>com.code.aon.ui.fiscal.controller.FiscalCollectionsController</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
	</managed-bean>

	<!-- ************ PARAMETERS **************** -->
	<managed-bean>
		<managed-bean-name>fiscalParams</managed-bean-name>
		<managed-bean-class>com.code.aon.ui.fiscal.controller.FiscalParametersController</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
	</managed-bean>

	<!-- **************** INVOICE REPORT  *************** -->
	<managed-bean>
		<managed-bean-name>invoiceReport</managed-bean-name>
		<managed-bean-class>com.code.aon.ui.fiscal.controller.InvoiceReportController</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
	</managed-bean>

	<!-- **************** MODEL 347  *************** -->
	<managed-bean>
		<managed-bean-name>mod347</managed-bean-name>
		<managed-bean-class>com.code.aon.ui.fiscal.controller.Mod347Controller</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
		<managed-property>
			<property-name>queryOnStartUP</property-name>
			<value>true</value>
		</managed-property>
		<managed-property>
			<property-name>pojo</property-name>
			<value>com.code.aon.fiscal.Mod347</value>
		</managed-property>
		<managed-property>
			<property-name>beanName</property-name>
			<value>mod347</value>
		</managed-property>		
		<managed-property>
			<property-name>defaultOrder</property-name>
			<value>Mod347_year desc</value>
		</managed-property>
		<managed-property>
			<property-name>listenerClasses</property-name>
			<list-entries>
				<value-class>com.code.aon.ui.form.event.IControllerListener</value-class>
				<value>#{mod347ControllerListener}</value>
				<value>#{mod347DetailListener}</value>
			</list-entries>
		</managed-property>
	</managed-bean>

	<managed-bean>
		<managed-bean-name>mod347ControllerListener</managed-bean-name>
		<managed-bean-class>com.code.aon.ui.fiscal.event.Mod347ControllerListener</managed-bean-class>
		<managed-bean-scope>none</managed-bean-scope>
	</managed-bean>

	<managed-bean>
		<managed-bean-name>mod347DetailListener</managed-bean-name>
		<managed-bean-class>com.code.aon.ui.form.listener.LinesControllerListener</managed-bean-class>
		<managed-bean-scope>none</managed-bean-scope>
		<managed-property>
			<property-name>childBean</property-name>
			<value>mod347Detail</value>
		</managed-property>
		<managed-property>
			<property-name>aliasMap</property-name>
			<map-entries>
				<map-entry>
					<key>Mod347Detail_mod347_id</key>
                    <value>id</value>
				</map-entry>
			</map-entries>
		</managed-property>
	</managed-bean>
	
	<managed-bean>
		<managed-bean-name>mod347Detail</managed-bean-name>
		<managed-bean-class>com.code.aon.ui.fiscal.controller.Mod347DetailController</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
		<managed-property>
			<property-name>pojo</property-name>
			<value>com.code.aon.fiscal.Mod347Detail</value>
		</managed-property>
		<managed-property>
			<property-name>beanName</property-name>
			<value>mod347Detail</value>
		</managed-property>
		<managed-property>
			<property-name>masterControllerName</property-name>
			<value>mod347</value>
		</managed-property>
		<managed-property>
			<property-name>cascadeDelete</property-name>
			<value>true</value>
		</managed-property>
		<managed-property>
			<property-name>defaultOrder</property-name>
			<value>Mod347Detail_type, Mod347Detail_name</value>
		</managed-property>
		<managed-property>
			<property-name>propertyMap</property-name>
			<map-entries>
				<map-entry>
					<key>id</key>
					<value>mod347.id</value>
				</map-entry>
			</map-entries>
		</managed-property>
	</managed-bean>
	<!-- **************** MODEL 340 REPORT  *************** -->
	<managed-bean>
		<managed-bean-name>model340</managed-bean-name>
		<managed-bean-class>com.code.aon.ui.fiscal.controller.Model340Controller</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
	</managed-bean>

	<!-- **************** RENTING *************** -->
	<managed-bean>
		<managed-bean-name>renting</managed-bean-name>
		<managed-bean-class>com.code.aon.ui.fiscal.controller.RentingController</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
		<managed-property>
			<property-name>queryOnStartUP</property-name>
			<value>false</value>
		</managed-property>
		<managed-property>
			<property-name>pojo</property-name>
			<value>com.code.aon.fiscal.Renting</value>
		</managed-property>
		<managed-property>
			<property-name>beanName</property-name>
			<value>renting</value>
		</managed-property>		
		<managed-property>
			<property-name>defaultOrder</property-name>
			<value>Renting_year desc,Renting_period desc</value>
		</managed-property>
		<managed-property>
			<property-name>listenerClasses</property-name>
			<list-entries>
				<value-class>com.code.aon.ui.form.event.IControllerListener</value-class>
				<value>#{rentingControllerListener}</value>
				<value>#{rentingDetailListener}</value>
			</list-entries>
		</managed-property>
	</managed-bean>

	<managed-bean>
		<managed-bean-name>rentingControllerListener</managed-bean-name>
		<managed-bean-class>com.code.aon.ui.fiscal.event.RentingControllerListener</managed-bean-class>
		<managed-bean-scope>none</managed-bean-scope>
	</managed-bean>

	<managed-bean>
		<managed-bean-name>rentingDetailListener</managed-bean-name>
		<managed-bean-class>com.code.aon.ui.form.listener.LinesControllerListener</managed-bean-class>
		<managed-bean-scope>none</managed-bean-scope>
		<managed-property>
			<property-name>childBean</property-name>
			<value>rentingDetail</value>
		</managed-property>
		<managed-property>
			<property-name>aliasMap</property-name>
			<map-entries>
				<map-entry>
					<key>RentingDetail_renting_id</key>
                    <value>id</value>
				</map-entry>
			</map-entries>
		</managed-property>
	</managed-bean>
	
	<managed-bean>
		<managed-bean-name>rentingDetail</managed-bean-name>
		<managed-bean-class>com.code.aon.ui.fiscal.controller.RentingDetailController</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
		<managed-property>
			<property-name>pageLimit</property-name>
			<value>-1</value>
		</managed-property>
		<managed-property>
			<property-name>pojo</property-name>
			<value>com.code.aon.fiscal.RentingDetail</value>
		</managed-property>
		<managed-property>
			<property-name>beanName</property-name>
			<value>rentingDetail</value>
		</managed-property>
		<managed-property>
			<property-name>masterControllerName</property-name>
			<value>renting</value>
		</managed-property>
		<managed-property>
			<property-name>cascadeDelete</property-name>
			<value>true</value>
		</managed-property>
		<managed-property>
			<property-name>propertyMap</property-name>
			<map-entries>
				<map-entry>
					<key>id</key>
					<value>renting.id</value>
				</map-entry>
			</map-entries>
		</managed-property>
	</managed-bean>

	<!-- **************** RETENTION REPORT  *************** -->
	<managed-bean>
		<managed-bean-name>retentionReport</managed-bean-name>
		<managed-bean-class>com.code.aon.ui.fiscal.controller.RetentionReportController</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
	</managed-bean>

	<!-- **************** VAT REPORT  *************** -->
	<managed-bean>
		<managed-bean-name>vatReport</managed-bean-name>
		<managed-bean-class>com.code.aon.ui.fiscal.controller.VatReportController</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
	</managed-bean>

	<!-- **************** VAT TAX  *************** -->
	<managed-bean>
		<managed-bean-name>vatTax</managed-bean-name>
		<managed-bean-class>com.code.aon.ui.fiscal.controller.VatTaxController</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
		<managed-property>
			<property-name>queryOnStartUP</property-name>
			<value>false</value>
		</managed-property>
		<managed-property>
			<property-name>pojo</property-name>
			<value>com.code.aon.fiscal.VatTax</value>
		</managed-property>
		<managed-property>
			<property-name>beanName</property-name>
			<value>vatTax</value>
		</managed-property>		
		<managed-property>
			<property-name>defaultOrder</property-name>
			<value>VatTax_year desc,VatTax_period desc,VatTax_number desc</value>
		</managed-property>			
		<managed-property>
			<property-name>listenerClasses</property-name>
			<list-entries>
				<value-class>com.code.aon.ui.form.event.IControllerListener</value-class>
				<value>#{vatTaxControllerListener}</value>
				<value>#{vatTaxDeclarationListener}</value>
			</list-entries>
		</managed-property>
	</managed-bean>
	
	<managed-bean>
		<managed-bean-name>vatTaxControllerListener</managed-bean-name>
		<managed-bean-class>com.code.aon.ui.fiscal.event.VatTaxControllerListener</managed-bean-class>
		<managed-bean-scope>none</managed-bean-scope>
	</managed-bean>

	<managed-bean>
		<managed-bean-name>vatTaxDeclarationListener</managed-bean-name>
		<managed-bean-class>com.code.aon.ui.form.listener.LinesControllerListener</managed-bean-class>
		<managed-bean-scope>none</managed-bean-scope>
		<managed-property>
			<property-name>childBean</property-name>
			<value>vatTaxDeclaration</value>
		</managed-property>
		<managed-property>
			<property-name>aliasMap</property-name>
			<map-entries>
				<map-entry>
					<key>VatTaxDeclaration_vatTax_id</key>
                    <value>id</value>
				</map-entry>
			</map-entries>
		</managed-property>
	</managed-bean>
	
	<managed-bean>
		<managed-bean-name>vatTaxDeclaration</managed-bean-name>
		<managed-bean-class>com.code.aon.ui.fiscal.controller.VatTaxDeclarationController</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
		<managed-property>
			<property-name>pageLimit</property-name>
			<value>-1</value>
		</managed-property>
		<managed-property>
			<property-name>pojo</property-name>
			<value>com.code.aon.fiscal.VatTaxDeclaration</value>
		</managed-property>
		<managed-property>
			<property-name>beanName</property-name>
			<value>vatTaxDeclaration</value>
		</managed-property>
		<managed-property>
			<property-name>defaultOrder</property-name>
			<value>VatTaxDeclaration_administration</value>
		</managed-property>				
		<managed-property>
			<property-name>masterControllerName</property-name>
			<value>vatTax</value>
		</managed-property>
		<managed-property>
			<property-name>cascadeDelete</property-name>
			<value>true</value>
		</managed-property>
		<managed-property>
			<property-name>propertyMap</property-name>
			<map-entries>
				<map-entry>
					<key>id</key>
					<value>vatTax.id</value>
				</map-entry>
			</map-entries>
		</managed-property>
		<managed-property>
			<property-name>listenerClasses</property-name>
			<list-entries>
				<value-class>com.code.aon.ui.form.event.IControllerListener</value-class>
				<value>#{vatTaxDeclarationControllerListener}</value>
			</list-entries>
		</managed-property>
	</managed-bean>

	<managed-bean>
		<managed-bean-name>vatTaxDeclarationControllerListener</managed-bean-name>
		<managed-bean-class>com.code.aon.ui.fiscal.event.VatTaxDeclarationControllerListener</managed-bean-class>
		<managed-bean-scope>none</managed-bean-scope>
	</managed-bean>
	
	<!-- ================================================ -->
	<!-- =================== NAVIGATION ================= -->
