	<!-- =================== FISCAL PARAMETERS ================= -->
	<navigation-rule>
		<navigation-case>
			<from-outcome>fiscalParams</from-outcome>
			<to-view-id>/com/code/aon/ui/fiscal/facelet/params/form.xhtml</to-view-id>
		</navigation-case>
	</navigation-rule>

	<!-- =================== INVOICE REPORT ================= -->
	<navigation-rule>
		<navigation-case>
			<from-outcome>invoiceReport_search</from-outcome>
			<to-view-id>/com/code/aon/ui/fiscal/facelet/invoice/search.xhtml</to-view-id>
		</navigation-case>
		<navigation-case>
			<from-outcome>invoiceReport_list</from-outcome>
			<to-view-id>/com/code/aon/ui/fiscal/facelet/invoice/list.xhtml</to-view-id>
