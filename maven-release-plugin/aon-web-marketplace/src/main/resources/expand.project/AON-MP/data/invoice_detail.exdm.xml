<?xml version="1.0" encoding="UTF-8"?>
<table tableName="invoice_detail">
    <columns>
        <column label="Identificador unico del Detalle de la Factura"
            name="id" sqlType="integer" type="integer"/>
        <column label="Identificador de la Factura" name="invoice"
            sqlType="integer" type="integer"/>
        <column
