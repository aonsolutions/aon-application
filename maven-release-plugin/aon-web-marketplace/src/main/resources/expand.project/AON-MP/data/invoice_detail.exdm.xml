            name="line" sqlType="smallint" type="short"/>
        <column
            label="Identificador del Articulo del Detalle de Factura"
            name="item" sqlType="integer" type="integer"/>
        <column label="Descripcion del Detalle de Factura" length="64"
            name="description" sqlType="varchar" type="string"/>
        <column label="Cantidad del Detalle de Factura" name="quantity"
