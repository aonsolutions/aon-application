<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<ui:UiBinder xmlns:ui='urn:ui:com.google.gwt.uibinder'
	xmlns:g='urn:import:com.google.gwt.user.client.ui' 
	xmlns:i='urn:import:com.vaadin.polymer.iron.widget'
	xmlns:p='urn:import:com.vaadin.polymer.paper.widget'
	xmlns:aon='urn:import:com.esferalia.aon.gwt.common.client.widget' >

	<ui:with type="com.esferalia.aon.gwt.common.client.i18n.CommonMessages" field="msg"></ui:with>
	<ui:with type="com.esferalia.aon.gwt.common.client.css.AonResources" field="aonResources"></ui:with>
	<ui:with type="com.esferalia.aon.gwt.common.client.css.AonGwtIssuesResources" field="issuesResources"></ui:with>

	<aon:MinimizePanel ui:field="footPanel" styleName="{aonResources.css.aonSelector}">
		<g:TabLayoutPanel ui:field="tabPanel" barHeight="26" barUnit="PX" width="100%">
 			<g:tab >
				<g:customHeader>
					<g:HTMLPanel>
						<i:IronIcon icon="receipt" styleName="{issuesResources.css.aonIronIconFilterIssues}" />
						<g:InlineLabel text="Parametros" styleName="{issuesResources.css.aonInlineLabelFilterIssues}" />
					</g:HTMLPanel>
				</g:customHeader>
				<g:SimpleLayoutPanel ui:field="parameterPanel" styleName="{aonResources.css.aonTextCenter}"/>
			</g:tab>
			<g:tab>
				<g:customHeader>
					<g:HTMLPanel>
						<i:IronIcon icon="speaker-notes" styleName="{issuesResources.css.aonIronIconFilterIssues}" />
						<g:InlineLabel text="Observaciones" styleName="{issuesResources.css.aonInlineLabelFilterIssues}" />
					</g:HTMLPanel>
				</g:customHeader>
				<g:ScrollPanel ui:field="observationPanel"
					styleName="{aonResources.css.aonTextCenter}" />
			</g:tab>
			
			<g:tab>
				<g:customHeader>
					<g:HTMLPanel>
						<i:IronIcon icon="redo" styleName="{issuesResources.css.aonIronIconFilterIssues}" />
						<g:InlineLabel text="Recepcion" styleName="{issuesResources.css.aonInlineLabelFilterIssues}" />
					</g:HTMLPanel>
				</g:customHeader>
					<g:SimpleLayoutPanel ui:field="receptionPanel" styleName="{aonResources.css.aonTextCenter}"/>
			</g:tab>
		</g:TabLayoutPanel>
	</aon:MinimizePanel>

</ui:UiBinder>
