<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<ui:UiBinder xmlns:ui='urn:ui:com.google.gwt.uibinder'
	xmlns:g='urn:import:com.google.gwt.user.client.ui' 
	xmlns:cell='urn:import:com.google.gwt.user.cellview.client'
	xmlns:aon='urn:import:com.esferalia.aon.gwt.common.client.widget'
	xmlns:fiscal='urn:import:com.esferalia.aon.gwt.fiscal.client.widget'
	xmlns:accPanel='urn:import:com.esferalia.aon.gwt.fiscal.client.accounting.panel'>

	<ui:with type="com.esferalia.aon.gwt.common.client.i18n.CommonMessages" field="msg"></ui:with>
	<ui:with type="com.esferalia.aon.gwt.common.client.css.AonResources" field="aonResources"></ui:with>

	<g:HTMLPanel ui:field="entryHeader" styleName="aon-margin-top10" >
		<table class="{aonResources.css.aonPanelGrid} {aonResources.css.aonWidthAll}">
			<tr>
				<td style="width: 65px;" class="{aonResources.css.aonPanelGridOdd}">
					<g:InlineLabel text="{msg.type}"/>
				</td>
				<td style="width: 65px;" class="{aonResources.css.aonPanelGridEven}">
					<g:HorizontalPanel>
						<g:ListBox ui:field="type" styleName="{aonResources.css.aonListBox}" />
						<g:ListBox ui:field="status" styleName="{aonResources.css.aonListBox}"/>
					</g:HorizontalPanel>
				</td>
				
				<td style="width: 65px;" class="{aonResources.css.aonPanelGridOdd}">
					<g:InlineLabel text="{msg.issueDate}"/>
				</td>
				<td style="width: 65px;" class="{aonResources.css.aonPanelGridEven}">
					<aon:DateBoxEx ui:field="issueDate" styleName="{aonResources.css.aonTextBox}"/>
				</td>
			</tr>
			<tr>
				<td style="width: 65px;" class="{aonResources.css.aonPanelGridOdd}">
					<g:InlineLabel text="{msg.fiscalYear}"/>
				</td>
				<td style="width: 65px;" class="{aonResources.css.aonPanelGridEven}">
					<g:HorizontalPanel>
						<g:ListBox ui:field="series" styleName="{aonResources.css.aonListBox}"/>
						<g:TextBox ui:field="number" width="50px" styleName="{aonResources.css.aonTextBox}"/>
					</g:HorizontalPanel>
				</td>
				
				<td style="width: 65px;" class="{aonResources.css.aonPanelGridOdd}">
					<g:InlineLabel text="Referencia"/>
				</td>
				<td style="width: 65px;" class="{aonResources.css.aonPanelGridEven}">
					<g:TextBox ui:field="reference" styleName="{aonResources.css.aonTextBox}"/>
				</td>
			</tr>
			<tr>
				<td style="width: 65px;" class="{aonResources.css.aonPanelGridOdd}">
					<g:InlineLabel text="{msg.carrier}"/>
				</td>
				<td style="width: 65px;" class="{aonResources.css.aonPanelGridEven}">
					<g:ListBox ui:field="carrier" styleName="{aonResources.css.aonListBox}" />
				</td>
				
				<td style="width: 65px;" class="{aonResources.css.aonPanelGridOdd}">
					<g:InlineLabel text="{msg.deliveryDate}"/>
				</td>
				<td style="width: 100%;" class="{aonResources.css.aonPanelGridEven}">
					<aon:DateBoxEx ui:field="deliveryDate" styleName="{aonResources.css.aonTextBox}"/>
				</td>

			</tr>
		</table>
		<table class="{aonResources.css.aonPanelGrid} {aonResources.css.aonMarginTop5} {aonResources.css.aonWidthAll}">
			<tr>
				<td style="width: 65px;" class="{aonResources.css.aonPanelGridOdd}">
					<g:InlineLabel text="Matricula"/>
				</td>
				<td style="width: 65px;" class="{aonResources.css.aonPanelGridEven}">
					<g:TextBox ui:field="numberPlate" styleName="{aonResources.css.aonTextBox}"/>
				</td>
				
				<td style="width: 65px;" class="{aonResources.css.aonPanelGridOdd}">
					<g:InlineLabel text="Conductor"/>
				</td>
				<td style="width: 100%;" class="{aonResources.css.aonPanelGridEven}">
					<g:InlineLabel text="Documento:"/>
					<g:TextBox ui:field="driverDocument" styleName="{aonResources.css.aonTextBox}"/>
					<g:InlineLabel text="{msg.name}:"/>	
					<g:TextBox ui:field="driverName" styleName="{aonResources.css.aonTextBox}"/>
				</td>
			</tr> 
		</table>
	</g:HTMLPanel> 

</ui:UiBinder>
