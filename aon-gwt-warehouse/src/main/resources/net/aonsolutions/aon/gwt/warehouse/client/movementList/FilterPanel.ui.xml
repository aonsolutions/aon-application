
<!DOCTYPE html [
    <!ENTITY nbsp "&#160;"> 
]>
<ui:UiBinder xmlns:ui='urn:ui:com.google.gwt.uibinder'
	xmlns:g='urn:import:com.google.gwt.user.client.ui' xmlns:aon='urn:import:com.esferalia.aon.gwt.common.client.widget'
	xmlns:c="urn:import:com.google.gwt.user.cellview.client" xmlns:b="http://java.sun.com/jstl/core"
	xmlns:p='urn:import:com.vaadin.polymer.paper.widget' xmlns:i='urn:import:com.vaadin.polymer.iron.widget'>

	<ui:with
		type="com.esferalia.aon.gwt.common.client.css.AonGwtIssuesResources"
		field="issuesResources"></ui:with>

	<ui:style>
	@external .gwt-PopupPanel;
	.gwt-PopupPanel {
		margin: 0px !important;
		border: 1px solid #EEE !important;
		padding: 4px 0px !important;
		width: 200px;
	}
	</ui:style>

	<g:HTMLPanel styleName="aon-panelGrid-search" height="55px">
		<div
			class="aon-panelGrid-search-info {issuesResources.css.aonPanelGridSearchInfoIssues}">
			<g:HorizontalPanel ui:field="filterHorizontal"
				styleName="aon-width-all">
				<g:HTMLPanel>
					<span class="aon-panelGrid-search-info-internal" style="position: relative;top: 2px;">Filtrar:</span>
				</g:HTMLPanel>
			</g:HorizontalPanel>
		</div>

		<g:HorizontalPanel ui:field="panel" styleName="aon-width-all">
			<p:PaperIconButton ui:field="searchButton" icon="search"
				style="position:absolute;right:45px;" />
			<p:PaperIconButton ui:field="cleanButton" icon="close"
				style="position:absolute;right:15px;" />
		</g:HorizontalPanel>

	</g:HTMLPanel>

</ui:UiBinder>
