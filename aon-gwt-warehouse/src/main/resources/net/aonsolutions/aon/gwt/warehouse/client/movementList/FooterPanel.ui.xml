<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<ui:UiBinder xmlns:ui='urn:ui:com.google.gwt.uibinder'
	xmlns:g='urn:import:com.google.gwt.user.client.ui' xmlns:i='urn:import:com.vaadin.polymer.iron.widget'
	xmlns:p='urn:import:com.vaadin.polymer.paper.widget' xmlns:aon='urn:import:com.esferalia.aon.gwt.common.client.widget'>

	<ui:with type="com.esferalia.aon.gwt.common.client.i18n.CommonMessages"
		field="msg" />
	<ui:with type="com.esferalia.aon.gwt.common.client.css.AonResources"
		field="aonResources" />
	<ui:with
		type="com.esferalia.aon.gwt.common.client.css.AonGwtIssuesResources"
		field="issuesResources" />

	<aon:MinimizePanel ui:field="footerPanel"
		styleName="{aonResources.css.aonSelector}">
		<g:TabLayoutPanel ui:field="tabPanel" barHeight="26"
			barUnit="PX" width="100%">
			
			<g:tab>
				<g:customHeader>
					<g:HTMLPanel>
						<i:IronIcon icon="receipt"
							styleName="{issuesResources.css.aonIronIconFilterIssues}" />
						<g:InlineLabel text="Detalle"
							styleName="{issuesResources.css.aonInlineLabelFilterIssues}" />
						<g:InlineLabel ui:field="itemCount"
							styleName="{issuesResources.css.aonInlineLabelFilterIssues}" />
					</g:HTMLPanel>
				</g:customHeader>
				<g:HTMLPanel>
					<g:ScrollPanel ui:field="itemPanel"
						styleName="{aonResources.css.aonTextCenter}" />
				</g:HTMLPanel>
			</g:tab>
			<g:tab>
				<g:customHeader>
					<g:HTMLPanel>
						<i:IronIcon icon="receipt"
							styleName="{issuesResources.css.aonIronIconFilterIssues}" />
						<g:InlineLabel text="Albs. compra"
							styleName="{issuesResources.css.aonInlineLabelFilterIssues}" />
						<g:InlineLabel ui:field="incomeCount"
							styleName="{issuesResources.css.aonInlineLabelFilterIssues}" />
					</g:HTMLPanel>
				</g:customHeader>
				<g:HTMLPanel>
					<g:ScrollPanel ui:field="incomePanel"
						styleName="{aonResources.css.aonTextCenter}" />
				</g:HTMLPanel>
			</g:tab>
			<g:tab>
				<g:customHeader>
					<g:HTMLPanel>
						<i:IronIcon icon="receipt"
							styleName="{issuesResources.css.aonIronIconFilterIssues}" />
						<g:InlineLabel text="Albs. venta"
							styleName="{issuesResources.css.aonInlineLabelFilterIssues}" />
						<g:InlineLabel ui:field="deliveryCount"
							styleName="{issuesResources.css.aonInlineLabelFilterIssues}" />
					</g:HTMLPanel>
				</g:customHeader>
				<g:HTMLPanel>
					<g:ScrollPanel ui:field="deliveryPanel"
						styleName="{aonResources.css.aonTextCenter}" />
				</g:HTMLPanel>
			</g:tab>
			<g:tab>
				<g:customHeader>
					<g:HTMLPanel>
						<i:IronIcon icon="receipt"
							styleName="{issuesResources.css.aonIronIconFilterIssues}" />
						<g:InlineLabel text="Fras. compra"
							styleName="{issuesResources.css.aonInlineLabelFilterIssues}" />
						<g:InlineLabel ui:field="purchaseInvoiceCount"
							styleName="{issuesResources.css.aonInlineLabelFilterIssues}" />
					</g:HTMLPanel>
				</g:customHeader>
				<g:HTMLPanel>
					<g:ScrollPanel ui:field="purchaseInvoicePanel"
						styleName="{aonResources.css.aonTextCenter}" />
				</g:HTMLPanel>
			</g:tab>
			<g:tab>
				<g:customHeader>
					<g:HTMLPanel>
						<i:IronIcon icon="receipt"
							styleName="{issuesResources.css.aonIronIconFilterIssues}" />
						<g:InlineLabel text="Fras. venta"
							styleName="{issuesResources.css.aonInlineLabelFilterIssues}" />
						<g:InlineLabel ui:field="saleInvoiceCount"
							styleName="{issuesResources.css.aonInlineLabelFilterIssues}" />
					</g:HTMLPanel>
				</g:customHeader>
				<g:HTMLPanel>
					<g:ScrollPanel ui:field="saleInvoicePanel"
						styleName="{aonResources.css.aonTextCenter}" />
				</g:HTMLPanel>
			</g:tab>
			<g:tab>
				<g:customHeader>
					<g:HTMLPanel>
						<i:IronIcon icon="receipt"
							styleName="{issuesResources.css.aonIronIconFilterIssues}" />
						<g:InlineLabel text="Traspasos almacen"
							styleName="{issuesResources.css.aonInlineLabelFilterIssues}" />
						<g:InlineLabel ui:field="warehouseTransferCount"
							styleName="{issuesResources.css.aonInlineLabelFilterIssues}" />
					</g:HTMLPanel>
				</g:customHeader>
				<g:HTMLPanel>
					<g:ScrollPanel ui:field="warehouseTransferPanel"
						styleName="{aonResources.css.aonTextCenter}" />
				</g:HTMLPanel>
			</g:tab>
			<g:tab>
				<g:customHeader>
					<g:HTMLPanel>
						<i:IronIcon icon="receipt"
							styleName="{issuesResources.css.aonIronIconFilterIssues}" />
						<g:InlineLabel text="Elaboraciones"
							styleName="{issuesResources.css.aonInlineLabelFilterIssues}" />
						<g:InlineLabel ui:field="elaborationCount"
							styleName="{issuesResources.css.aonInlineLabelFilterIssues}" />
					</g:HTMLPanel>
				</g:customHeader>
				<g:HTMLPanel>
					<g:ScrollPanel ui:field="elaborationPanel"
						styleName="{aonResources.css.aonTextCenter}" />
				</g:HTMLPanel>
			</g:tab>
			
		</g:TabLayoutPanel>
	</aon:MinimizePanel>

</ui:UiBinder>
