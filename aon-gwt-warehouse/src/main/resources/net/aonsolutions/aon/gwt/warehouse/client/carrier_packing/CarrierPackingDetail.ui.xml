<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<ui:UiBinder xmlns:ui='urn:ui:com.google.gwt.uibinder'
	xmlns:g='urn:import:com.google.gwt.user.client.ui' 
	xmlns:cell='urn:import:com.google.gwt.user.cellview.client'
	xmlns:aon='urn:import:com.esferalia.aon.gwt.common.client.widget' >

	<ui:with type="com.esferalia.aon.gwt.common.client.i18n.CommonMessages" field="msg"></ui:with>
	<ui:with type="com.esferalia.aon.gwt.common.client.css.AonResources" field="aonResources"></ui:with>
	<ui:style>
		.observations {
    		right: 5px;
		    position: absolute;
    		padding-top: 3px;
    		cursor: pointer;
		}
	</ui:style>
	<g:DockLayoutPanel ui:field="contentDockLayoutPanel">
		<g:north size="120">
			<g:HTMLPanel ui:field="entryHeader" styleName="aon-margin-top10 aon-margin-left10 aon-margin-right10" >
				<table class="{aonResources.css.aonPanelGrid} {aonResources.css.aonWidthAll}">
					<tr>
						<td style="width: 65px;" class="{aonResources.css.aonPanelGridOdd}">
							<g:InlineLabel text="{msg.type}"/>
						</td>
						<td style="width: 65px;" class="{aonResources.css.aonPanelGridEven}">
							<g:HorizontalPanel>
								<g:ListBox ui:field="type" styleName="{aonResources.css.aonListBox}" />
								<g:ListBox ui:field="status" styleName="{aonResources.css.aonListBox}"/>
								<g:SimplePanel ui:field="simple"></g:SimplePanel>
							</g:HorizontalPanel>
						</td>
						<td style="width: 65px;" class="{aonResources.css.aonPanelGridOdd}">
							<g:InlineLabel text="Fecha de Carga"/>
						</td>
						<td style="width: 65px;" class="{aonResources.css.aonPanelGridEven}">
							<aon:DateBoxEx ui:field="issueDate" styleName="{aonResources.css.aonTextBox}"/>
						</td>
					</tr>
					<tr>
						<td style="width: 65px;" class="{aonResources.css.aonPanelGridOdd}">
							<g:InlineLabel text="{msg.series}/{msg.number}"/>
						</td>
						<td style="width: 65px;" class="{aonResources.css.aonPanelGridEven}">
							<g:HorizontalPanel>
								<g:ListBox ui:field="series" styleName="{aonResources.css.aonListBox}"/>
								<g:TextBox ui:field="number" width="50px" styleName="{aonResources.css.aonTextBox}"/>
							</g:HorizontalPanel>
						</td>		
						<td style="width: 65px;" class="{aonResources.css.aonPanelGridOdd}">
							<g:InlineLabel text="Referencia"/>
						</td>
						<td style="width: 65px;" class="{aonResources.css.aonPanelGridEven}">
							<g:TextBox ui:field="reference" styleName="{aonResources.css.aonTextBox}"/>
						</td>
					</tr>
					<tr>
						<td style="width: 65px;" class="{aonResources.css.aonPanelGridOdd}">
							<g:InlineLabel text="{msg.carrier}"/>
						</td>
						<td style="width: 65px;" class="{aonResources.css.aonPanelGridEven}">
							<g:ListBox ui:field="carrier" styleName="{aonResources.css.aonListBox}" />
						</td>	
						<td style="width: 65px;" class="{aonResources.css.aonPanelGridOdd}">
							<g:InlineLabel text="{msg.deliveryDate}"/>
						</td>
						<td style="width: 100%;" class="{aonResources.css.aonPanelGridEven}">
							<aon:DateBoxEx ui:field="deliveryDate" styleName="{aonResources.css.aonTextBox}"/>
						</td>
					</tr>
				</table>
				<table class="{aonResources.css.aonPanelGrid} {aonResources.css.aonMarginTop5} {aonResources.css.aonWidthAll}">
					<tr>
						<td style="width: 65px;" class="{aonResources.css.aonPanelGridOdd}">
							<g:InlineLabel text="Matrícula"/>
						</td>
						<td style="width: 65px;" class="{aonResources.css.aonPanelGridEven}">
							<g:TextBox ui:field="numberPlate" styleName="{aonResources.css.aonTextBox}"/>
						</td>
						<td style="width: 65px;" class="{aonResources.css.aonPanelGridOdd}">
							<g:InlineLabel text="Conductor"/>
						</td>
						<td style="width: 100%;" class="{aonResources.css.aonPanelGridEven}">
							<g:InlineLabel text="Documento:"/>
							<g:TextBox ui:field="driverDocument" styleName="{aonResources.css.aonTextBox}"/>
							<g:InlineLabel text="{msg.name}:"/>	
							<g:TextBox ui:field="driverName" styleName="{aonResources.css.aonTextBox}"/>
							<g:InlineLabel ui:field="addObservations" text="Añadir Observaciones" styleName="{style.observations}"/>
						</td>
					</tr> 
				</table>
			</g:HTMLPanel> 
		</g:north>
		<g:center>
			<g:SplitLayoutPanel ui:field="contentSplitLayoutPanel">
				<g:center>
					<g:SimpleLayoutPanel styleName="aon-margin-left10 aon-margin-right10" ui:field="content" />	
				</g:center>
				<g:south size="0">
					<g:SimpleLayoutPanel ui:field="southContent" />
				</g:south>
			</g:SplitLayoutPanel>
		</g:center>
	</g:DockLayoutPanel>
</ui:UiBinder>
