
<!DOCTYPE html [
    <!ENTITY nbsp "&#160;"> 
]>
<ui:UiBinder xmlns:ui='urn:ui:com.google.gwt.uibinder' 
	xmlns:g='urn:import:com.google.gwt.user.client.ui' 
	xmlns:p='urn:import:com.vaadin.polymer.paper.widget'
	xmlns:i='urn:import:com.vaadin.polymer.iron.widget'>
    	
<ui:with type="com.esferalia.aon.gwt.common.client.css.AonGwtIssuesResources"
		field="issuesResources"></ui:with>

<ui:style>
	@external .gwt-PopupPanel;

	.gwt-PopupPanel {
		margin: 0px !important;
		border: 1px solid #EEE !important;
		padding: 4px 0px !important;
		width:200px;
	}    

</ui:style>

<g:HTMLPanel   height="55px" >
   	<div >							
		<g:HTMLPanel>
			<g:InlineLabel ui:field="categoryLabel" styleName="{issuesResources.css.filterLabelIssues}"></g:InlineLabel>
			<g:InlineLabel ui:field="customerLabel" styleName="{issuesResources.css.filterLabelIssues}"></g:InlineLabel>
			<g:InlineLabel ui:field="sellerLabel" styleName="{issuesResources.css.filterLabelIssues}"></g:InlineLabel>
			<g:InlineLabel ui:field="workplaceLabel" styleName="{issuesResources.css.filterLabelIssues}"></g:InlineLabel>
			<g:InlineLabel ui:field="periodLabel" styleName="{issuesResources.css.filterLabelIssues}"></g:InlineLabel>
		</g:HTMLPanel>			
	</div>
    <g:HorizontalPanel ui:field="panel" styleName="aon-width-all"/>
</g:HTMLPanel>
</ui:UiBinder>
