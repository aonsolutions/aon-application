<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<ui:UiBinder xmlns:ui='urn:ui:com.google.gwt.uibinder'
	xmlns:g='urn:import:com.google.gwt.user.client.ui' xmlns:cell='urn:import:com.google.gwt.user.cellview.client'
	xmlns:aon='urn:import:com.esferalia.aon.gwt.common.client.widget'>

	<ui:with type="com.esferalia.aon.gwt.common.client.i18n.CommonMessages"
		field="msg"></ui:with>
	<ui:with type="com.esferalia.aon.gwt.common.client.css.AonResources"
		field="aonResources"></ui:with>

	<g:HTMLPanel ui:field="entryHeader" styleName="aon-margin-top10">
		<table
			class="{aonResources.css.aonPanelGrid} {aonResources.css.aonWidthAll}">
			<tr>
				<td style="width: 65px;" class="{aonResources.css.aonPanelGridOdd}">
					<g:InlineLabel text="{msg.series}/{msg.number}" />
				</td>
				<td style="width: 65px;" class="{aonResources.css.aonPanelGridEven}">
					<g:HorizontalPanel>
						<!--  
						<g:ListBox ui:field="series" styleName="{aonResources.css.aonListBox}" />
						-->
						<g:TextBox ui:field="series" width="50px"
							styleName="{aonResources.css.aonTextBox}" />
						<g:InlineLabel text="/"
							styleName="{aonResources.css.aonMargin}" />
						<g:TextBox ui:field="number" width="50px"
							styleName="{aonResources.css.aonTextBox}" />
						<!--  
						<g:ListBox ui:field="status" styleName="{aonResources.css.aonListBox}" />
						-->
						<g:InlineLabel ui:field="status" 
							styleName="{aonResources.css.aonMarginLeft} {aonResources.css.aonNowrap}" />
						<g:Button ui:field="closeButton" />
					</g:HorizontalPanel>
				</td>

				<td style="width: 65px;" class="{aonResources.css.aonPanelGridOdd}">
					<g:InlineLabel text="{msg.issueDate}" />
				</td>
				<td style="width: 65px;" class="{aonResources.css.aonPanelGridEven}">
					<aon:DateBoxEx ui:field="date"
						styleName="{aonResources.css.aonTextBox}" />
				</td>
			</tr>
			<tr>
				<td style="width: 65px;" class="{aonResources.css.aonPanelGridOdd}">
					<g:InlineLabel text="{msg.quantity}" />
				</td>
				<td style="width: 65px;" class="{aonResources.css.aonPanelGridEven}">
					<g:TextBox ui:field="quantity" width="50px"
						styleName="{aonResources.css.aonTextBox}" />
				</td>

				<td style="width: 65px;" class="{aonResources.css.aonPanelGridOdd}">
					<g:InlineLabel text="Producto" />
				</td>
				<td style="width: 100%;" class="{aonResources.css.aonPanelGridEven}">
					<g:HorizontalPanel ui:field="itemPanel" width="400px"
						styleName="{aonResources.css.aonTextBox}" />
				</td>
			</tr>
			<tr>
				<td style="width: 65px;" class="{aonResources.css.aonPanelGridOdd}">
					<g:InlineLabel text="{msg.warehouseTemplates}" />
				</td>
				<td style="width: 65px;" class="{aonResources.css.aonPanelGridEven}">
					<g:ListBox ui:field="warehouse" styleName="{aonResources.css.aonListBox}" />
				</td>

				<td style="width: 65px;" class="{aonResources.css.aonPanelGridOdd}">
					
				</td>
				<td style="width: 100%;" class="{aonResources.css.aonPanelGridEven}">
					
				</td>
			</tr>
		</table>
		
	</g:HTMLPanel>

</ui:UiBinder>
