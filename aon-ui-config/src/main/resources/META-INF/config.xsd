<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
	<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
		xmlns="http://www.esferalia.com/config" targetNamespace="http://www.esferalia.com/config"
		elementFormDefault="qualified">
	<xs:element name="config">	
		<xs:complexType>
		    <xs:sequence>
		      <xs:element ref="series" />
		    </xs:sequence>		
			<xs:attribute name="version" type="xs:string" use="required" fixed="1.1"/>		    
		</xs:complexType>
	</xs:element>
	<xs:element name="series">
		<xs:complexType>
			<xs:attribute name="showOfferData" type="xs:boolean" use="required"/>
			<xs:attribute name="showSalesData" type="xs:boolean" use="required"/>
			<xs:attribute name="showDeliveryData" type="xs:boolean" use="required"/>
			<xs:attribute name="showInvoiceData" type="xs:boolean" use="required"/>
			<xs:attribute name="showPosData" type="xs:boolean" use="required"/>
			<xs:attribute name="showTasData" type="xs:boolean" use="required"/>
		</xs:complexType>
	</xs:element>
</xs:schema>