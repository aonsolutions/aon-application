<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
	xmlns:g="urn:import:com.google.gwt.user.client.ui" xmlns:aon='urn:import:com.esferalia.aon.gwt.common.client.widget'
	xmlns:connect='urn:import:com.esferalia.aon.gwt.connect.client'>

	<g:SplitLayoutPanel ui:field="splitLayoutPanel">
		<g:center>
			<g:HTMLPanel styleName="aon-scroll-area">

				<g:HTMLPanel styleName="aon-panelGrid-search">

					<div class="aon-panelGrid-search-info ">
						<span class="aon-panelGrid-search-info-internal">Seleccione el fichero a importar: </span>
					</div>

					<div class="aon-scroll-area">

						<div>
							<g:Button ui:field="button" />
						</div>
					</div>
				</g:HTMLPanel>

			</g:HTMLPanel>

		</g:center>
	</g:SplitLayoutPanel>
</ui:UiBinder> 