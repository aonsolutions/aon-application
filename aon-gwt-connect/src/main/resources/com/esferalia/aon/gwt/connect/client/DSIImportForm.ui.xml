<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<ui:UiBinder xmlns:ui='urn:ui:com.google.gwt.uibinder'
	xmlns:g='urn:import:com.google.gwt.user.client.ui' xmlns:aon='urn:import:com.esferalia.aon.gwt.common.client.widget'
	xmlns:cell='urn:import:com.google.gwt.user.cellview.client'>

	<ui:import field="com.google.gwt.user.client.ui.FormPanel.*" />
	<ui:import field="com.esferalia.aon.gwt.connect.shared.DSIImportService.*" />

	<ui:style>
	.monthListBox-item {
		padding-left: 16px;
	}
	
	.options-scroll-panel>div {
		height: 99%;
	}
	</ui:style>


	<g:SplitLayoutPanel ui:field="splitLayoutPanel">


		<g:center>
			<g:ScrollPanel styleName="aon-scroll-area {style.options-scroll-panel}">

				<g:HTMLPanel styleName="aon-panelGrid-search aon-height-all">
					<div class="aon-panelGrid-search-info ">
						<span class="aon-panelGrid-search-info-internal">Introduzca los parámetros de cálculo:</span>
						<a style="font-size:1em;font-weight:bold;float:right;" onclick=""
							href="#">
							<span class="aon-outputText">[?]</span>
						</a>
					</div>

					<g:FormPanel ui:field="importPanel"  method="{METHOD_POST}"
						action="/aon_gwt_connect/dsiimport" encoding="{ENCODING_MULTIPART}">

						<g:Grid styleName="aon-panelGrid">
							<g:row>
								<g:customCell styleName="aon-panelGrid-odd">
									<g:Label styleName="aon-outputLabel">&nbsp;</g:Label>
								</g:customCell>
								<g:customCell styleName="aon-panelGrid-even">
									<g:FileUpload name="{ZIP_FILE_PART}" />
								</g:customCell>
							</g:row>
							<g:row>
								<g:customCell styleName="aon-panelGrid-odd">
									<g:Label styleName="aon-outputLabel">Mes</g:Label>
								</g:customCell>
								<g:customCell styleName="aon-panelGrid-even">
									<aon:MonthListBox styleName="aon-selectOneMenu"
										ui:field="monthListBox" monthStyles="{style.monthListBox-item}"
										highLightStyles="aon-bold aon-black aon-icon-accept {style.monthListBox-item}" />
								</g:customCell>
							</g:row>
							<g:row>
								<g:customCell styleName="aon-panelGrid-odd">
									<g:Label styleName="aon-outputLabel">Guardar</g:Label>
								</g:customCell>
								<g:customCell styleName="aon-panelGrid-even">
									<g:CheckBox ui:field="saveCheckBox" />
								</g:customCell>
							</g:row>
							<g:row>
								<g:customCell styleName="aon-panelGrid-odd">
									<g:Label styleName="aon-outputLabel">&nbsp;</g:Label>
								</g:customCell>
								<g:customCell styleName="aon-panelGrid-even">
									<g:Button ui:field="importButton" >Importar</g:Button>
								</g:customCell>
							</g:row>
						</g:Grid>

					</g:FormPanel>


				</g:HTMLPanel>

			</g:ScrollPanel>

		</g:center>

		<g:south size="0">
			<aon:MinimizePanel ui:field="footPanel">
				<g:TabLayoutPanel barHeight="26" barUnit="PX">
					<g:tab>
						<g:header>
							<span class="aon-icon-time aon-icon-commandButton">Resultados</span>
						</g:header>

						<g:Label styleName="aon-outputLabel">&nbsp;</g:Label>

					</g:tab>
				</g:TabLayoutPanel>
			</aon:MinimizePanel>
		</g:south>

	</g:SplitLayoutPanel>

</ui:UiBinder>
