<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<ui:UiBinder xmlns:ui='urn:ui:com.google.gwt.uibinder'
	xmlns:g='urn:import:com.google.gwt.user.client.ui' xmlns:aon='urn:import:com.esferalia.aon.gwt.common.client.widget'
	xmlns:cell='urn:import:com.google.gwt.user.cellview.client'
	xmlns:connect='urn:import:com.esferalia.aon.gwt.connect.client'
	xmlns:datepicker='urn:import:com.google.gwt.user.datepicker.client'>

	<ui:style>
	.monthListBox-item {
		padding-left: 16px;
	}
	
	.options-scroll-panel>div {
		height: 99%;
	}
	
	.button-bar button {
		float: right;
		width: 16px;
		height: 16px;
		margin-left: 5px;
		margin-right: 5px;
	}
	
	.button-bar button:first-of-type {
		margin-right: 15px;
	}
	
	.simple-panel {
		background: #FFFFFF;
	}
	</ui:style>

	<g:SplitLayoutPanel ui:field="splitLayoutPanel">
		<g:center>
			<g:HTMLPanel>
				<g:ScrollPanel styleName="aon-scroll-area {style.options-scroll-panel}">

					<g:HTMLPanel styleName="aon-panelGrid-search">
						<div class="aon-panelGrid-search-info ">
							<span class="aon-panelGrid-search-info-internal">Seleccione la Base de Datos: </span>
						</div>

						<div class="aon-scroll-area">
							<table class="aon-panelGrid" cellspacing="0" cellpadding="0">
								<tr>
									<td class="aon-panelGrid-odd">
										<g:Label styleName="aon-outputLabel">Fecha inicio de carga</g:Label>
									</td>
									<td>
										<datepicker:DateBox ui:field="dateBox"
											styleName="aon-inputText" width="6em" />
									</td>
								</tr>
								<tr>
									<td class="aon-panelGrid-odd">
										<g:Label styleName="aon-outputLabel">Modo prueba</g:Label>
									</td>
									<td class="aon-panelGrid-even">
										<g:CheckBox styleName="aon-selectBooleanCheckbox"></g:CheckBox>
									</td>
								</tr>
								<tr>
									<td class="aon-panelGrid-odd">
										<g:Label styleName="aon-outputLabel">Adjuntar archivo</g:Label>
									</td>
									<td>
										<!--table border="10px" cellpadding="40px" width="200" -->
										<table>
											<tr>
												<td>
													<g:FormPanel ui:field="uploadFormPanel">
														<!--g:FileUpload ui:field="fileUpload" name="zipfile" / -->
													</g:FormPanel>
												</td>
											</tr>
										</table>
									</td>
								</tr>
								<tr>
									<td>
										<g:Button ui:field="sendButton" styleName="aon-search-lookup-button">Importar</g:Button>
									</td>
									<td>
										<g:HorizontalPanel ui:field="barPanel"></g:HorizontalPanel>
									</td>
								</tr>
							</table>
						</div>
					</g:HTMLPanel>
				</g:ScrollPanel>

				<g:ResizeLayoutPanel ui:field="dockPanel">
					<g:HTMLPanel styleName="aon-scroll-area {style.options-scroll-panel}">
						<g:SimpleLayoutPanel styleName="aon-panelGrid-search {style.simple-panel}">
							<connect:DSILoadSelectedGrid
								ui:field="dataGrid" />
						</g:SimpleLayoutPanel>
					</g:HTMLPanel>
				</g:ResizeLayoutPanel>

			</g:HTMLPanel>
		</g:center>

		<g:south size="0">
			<aon:MinimizePanel ui:field="footPanel">
				<g:TabLayoutPanel addStyleNames="aon-pointer-events-auto" barHeight="26" barUnit="PX"
					ui:field="footTabPanel" />
			</aon:MinimizePanel>
		</g:south>
	</g:SplitLayoutPanel>
</ui:UiBinder>
