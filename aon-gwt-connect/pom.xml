<?xml version="1.0"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
  <parent>
    <groupId>com.code.aon</groupId>
    <artifactId>aon.parent</artifactId>
    <version>8.79-SNAPSHOT</version>
  </parent>
  <modelVersion>4.0.0</modelVersion>
  <groupId>com.esferalia.aon</groupId>
  <artifactId>aon.gwt.connect</artifactId>
  <packaging>jar</packaging>
  <description>AON GWT CONECT@</description>
  <name>AON GWT CONECT@</name>
  <build>
    <plugins>
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>gwt-maven-plugin</artifactId>
        <version>2.7.0</version>
        <configuration>
          <deploy>${project.build.directory}/extra</deploy>
          <extra>${project.build.directory}/extra</extra>
          <webappDirectory>${project.build.outputDirectory}</webappDirectory>
	      <module>com.esferalia.aon.gwt.connect.Connect</module>
				<compileSourcesArtifacts>
				  <compileSourcesArtifact>com.esferalia.aon:aon.gwt.common</compileSourcesArtifact>  
				  <compileSourcesArtifact>com.esferalia.aon:aon.occam</compileSourcesArtifact>
				</compileSourcesArtifacts>
        </configuration>
        <executions>
          <execution>
            <phase>prepare-package</phase>
            <goals>
              <goal>compile</goal>
              <!--goal>generateAsync</goal-->
              <!--goal>test</goal -->
            </goals>
          </execution>
        </executions>
      </plugin>
			<plugin>
				<groupId>com.google.code.maven-replacer-plugin</groupId>
				<artifactId>replacer</artifactId>
				<version>1.5.3</version>
				<executions>
					<execution>
						<phase>prepare-package</phase>
						<goals>
							<goal>replace</goal>
						</goals>                   
					</execution>
				</executions>
				<configuration>
					<basedir>${project.basedir}/target/classes</basedir>
					<includes>
						<include>**/gwt/clean/clean.css</include>
					</includes>
					<regexFlags>
					    <regexFlag>MULTILINE</regexFlag>
					    <regexFlag>CASE_INSENSITIVE</regexFlag>
					</regexFlags>
					<replacements>
						<replacement>
							<token>^([a-z: \t,]*)\{$</token>
							<value>/** $1 */
.disabled-by-aon {</value>
						</replacement>         
					</replacements>
				</configuration>
			</plugin>
  </plugins>
  </build>
  <dependencies>
    <dependency>
      <groupId>javax.servlet</groupId>
      <artifactId>javax.servlet-api</artifactId>
      <version>3.1.0</version>
      <scope>provided</scope>
    </dependency>
    <!--dependency>
      <groupId>com.esferalia.aon</groupId>
      <artifactId>aon.dsi</artifactId>
      <version>${project.version}</version>
    </dependency-->
    <dependency>
      <groupId>com.google.gwt</groupId>
      <artifactId>gwt-servlet</artifactId>
      <version>2.7.0</version>
      <scope>compile</scope>
    </dependency>
    <dependency>
      <groupId>com.google.gwt</groupId>
      <artifactId>gwt-user</artifactId>
      <version>2.7.0</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>com.esferalia.aon</groupId>
      <artifactId>aon.gwt.common</artifactId>
      <version>${project.version}</version>
    </dependency>
	<dependency>
		<groupId>com.esferalia.aon</groupId>
		<artifactId>aon.gwt.common</artifactId>
		<version>${project.version}</version>
		<scope>compile</scope>
		<classifier>sources</classifier>
	</dependency>
		<dependency>
			<groupId>com.esferalia.aon</groupId>
			<artifactId>aon.occam</artifactId>
			<version>${project.version}</version>
			<scope>compile</scope>
		</dependency>
		<dependency>
			<groupId>com.esferalia.aon</groupId>
			<artifactId>aon.occam</artifactId>
			<version>${project.version}</version>
			<scope>provided</scope>
			<classifier>sources</classifier>
		</dependency>
    <dependency>
      <groupId>com.code.aon</groupId>
      <artifactId>aon.ui.config</artifactId>
      <version>${project.version}</version>
      <scope>compile</scope>
      <exclusions>
        <exclusion>
          <groupId>asm</groupId>
          <artifactId>asm</artifactId>
        </exclusion>
        <exclusion>
          <groupId>asm</groupId>
          <artifactId>asm-attrs</artifactId>
        </exclusion>
      </exclusions>
    </dependency>
    <dependency>
      <groupId>com.code.aon</groupId>
      <artifactId>aon-dbutils</artifactId>
      <version>${project.version}</version>
      <scope>compile</scope>
    </dependency>
    <dependency>
      <groupId>com.code.aon</groupId>
      <artifactId>aon.pool</artifactId>
      <version>${project.version}</version>
      <scope>compile</scope>
    </dependency>
          <dependency>
        <groupId>com.googlecode.gwtupload</groupId>
        <artifactId>gwtupload</artifactId>
        <version>1.0.1</version>
      </dependency>
    
  </dependencies>
  <profiles>
    <profile>
    <id>dev</id>
    <activation>
      <property>
        <name>gwt.working</name>
        <value>true</value>
      </property>
    </activation>
    <build>
      <plugins>
        <plugin>
          <groupId>org.codehaus.mojo</groupId>
          <artifactId>gwt-maven-plugin</artifactId>
          <configuration>
            <draftCompile>true</draftCompile>
	    <module>com.esferalia.aon.gwt.connect.WorkingConnect</module>
          </configuration>
        </plugin>
      </plugins>
    </build>
    </profile>
  </profiles>
	

</project>
