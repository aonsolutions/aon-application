<?xml version="1.0" encoding="ISO-8859-1"?>

<!DOCTYPE report-config 
	PUBLIC "-//CODE-AON//DTD Report Config//EN" 
	"http://co-de.com/aon/report-config.dtd">

<report-config>
	
	<report id="customerReport" description="Customer report ">
		<template path="/com/code/aon/ui/registry/report/masterRegistryList.jasper" />
		<bean key="com.code.aon.customer.Customer" />
		<collection provider="#{customer}" forceRefresh="false"/>
		<params>
			<param id="REPORT_RESOURCE_BUNDLE" value="com.code.aon.common.i18n.messages" />
			<param id="printHeader" value="#{company.isPrintHeader}" />
			<param id="company" value="#{company.obtainCompany}" />
			<param id="title" value="#{customer.getReportTitle}" />
		</params>
	</report>
	<report id="creditorReport" description="Creditor report ">
		<template path="/com/code/aon/ui/registry/report/masterRegistryList.jasper" />
		<bean key="com.code.aon.finance.Creditor" />
		<collection provider="#{creditor}" forceRefresh="false"/>
		<params>
			<param id="REPORT_RESOURCE_BUNDLE" value="com.code.aon.common.i18n.messages" />
			<param id="printHeader" value="#{company.isPrintHeader}" />
			<param id="company" value="#{company.obtainCompany}" />
			<param id="title" value="#{creditor.getReportTitle}" />
		</params>
	</report>
	
	<report id="supplierReport" description="Supplier report ">
		<template path="/com/code/aon/ui/registry/report/masterRegistryList.jasper" />
		<bean key="com.code.aon.supplier.Supplier" />
		<collection provider="#{supplier}" forceRefresh="false"/>
		<params>
			<param id="REPORT_RESOURCE_BUNDLE" value="com.code.aon.common.i18n.messages" />
			<param id="printHeader" value="#{company.isPrintHeader}" />
			<param id="company" value="#{company.obtainCompany}" />
			<param id="title" value="#{supplier.getReportTitle}" />
		</params>
	</report>
	<report id="sellerReport" description="Seller report ">
		<template path="/com/code/aon/ui/registry/report/masterRegistryList.jasper" />
		<bean key="com.code.aon.seller.Seller" />
		<collection provider="#{seller}" forceRefresh="false"/>
		<params>
			<param id="REPORT_RESOURCE_BUNDLE" value="com.code.aon.common.i18n.messages" />
			<param id="printHeader" value="#{company.isPrintHeader}" />
			<param id="company" value="#{company.obtainCompany}" />
			<param id="title" value="#{seller.getReportTitle}" />
		</params>
	</report>
	<report id="carrierReport" description="Carrier report ">
		<template path="/com/code/aon/ui/registry/report/masterRegistryList.jasper" />
		<bean key="com.code.aon.carrier.Carrier" />
		<collection provider="#{carrier}" forceRefresh="false"/>
		<params>
			<param id="REPORT_RESOURCE_BUNDLE" value="com.code.aon.common.i18n.messages" />
			<param id="printHeader" value="#{company.isPrintHeader}" />
			<param id="company" value="#{company.obtainCompany}" />
			<param id="title" value="#{customer.getReportTitle}" />
		</params>
	</report>

	<!-- *********  REGISTRY ADD INFO  ********* -->
	<report id="registryAddInfoReport" description="Registry Add Info report ">
		<template path="/com/code/aon/ui/registry/report/registryAddInfo.jasper" />
		<bean key="com.code.aon.registry.RegistryAddInfo" />
		<criteria provider="#{registryAddInfo}" />
		<params>
			<param id="REPORT_RESOURCE_BUNDLE" value="com.code.aon.common.i18n.messages" />
			<param id="printHeader" value="#{company.isPrintHeader}" />
			<param id="company" value="#{company.obtainCompany}" />
		</params>
	</report>

	<!-- *********  FAX  ********* -->
	<report id="corporateIdentity_fax" description="Fax report">
		<template path="/com/code/aon/ui/registry/report/corporateIdentity_fax.jasper" />
		<collection provider="#{corporateIdentity}"/>
		<params>
			<param id="REPORT_RESOURCE_BUNDLE" value="com.code.aon.common.i18n.messages" />
			<param id="logoImageFile" value="#{corporateIdentity.getAttachAsInputStream}" />
		</params>
	</report>

	<!-- *********  LETTER  ********* -->
	<report id="corporateIdentity_letter" description="Letter report">
		<template path="/com/code/aon/ui/registry/report/corporateIdentity_letter.jasper" />
		<collection provider="#{corporateIdentity}"/>
		<params>
			<param id="REPORT_RESOURCE_BUNDLE" value="com.code.aon.common.i18n.messages" />
			<param id="logoImageFile" value="#{corporateIdentity.getAttachAsInputStream}" />
			<param id="company" value="#{corporateIdentity.getCompany}" />
			<param id="recordData" value="#{corporateIdentity.getRecordData}" />
		</params>
	</report>
	
	<!--  *********  LABEL  ********* -->
	<report id="corporateIdentity_label" description="Label report">
		<template path="/com/code/aon/ui/registry/report/corporateIdentity_label.jasper" />
		<collection provider="#{corporateIdentity}"/>
		<params>
			<param id="REPORT_RESOURCE_BUNDLE" value="com.code.aon.common.i18n.messages" />
			<param id="logoImageFile" value="#{corporateIdentity.getAttachAsInputStream}" />
		</params>
	</report>
	
	<!--  *********  RECIBI  ********* -->
	<report id="corporateIdentity_receipt" description="Recibi report">
		<template path="/com/code/aon/ui/registry/report/corporateIdentity_receipt.jasper" />
		<collection provider="#{corporateIdentity}"/>
		<params>
			<param id="REPORT_RESOURCE_BUNDLE" value="com.code.aon.common.i18n.messages" />
			<param id="logoImageFile" value="#{corporateIdentity.getAttachAsInputStream}" />
		</params>
	</report>

</report-config>