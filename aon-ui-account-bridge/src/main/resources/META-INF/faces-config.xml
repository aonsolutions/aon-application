<?xml version="1.0"?>
<!DOCTYPE faces-config PUBLIC
  "-//Sun Microsystems, Inc.//DTD JavaServer Faces Config 1.1//EN"
  "http://java.sun.com/dtd/web-facesconfig_1_1.dtd">

<faces-config>

	<managed-bean>
		<managed-bean-name>productAccountListener</managed-bean-name>
		<managed-bean-class>
			com.code.aon.ui.account.bridge.event.ProductAccountListener
		</managed-bean-class>
		<managed-bean-scope>none</managed-bean-scope>
	</managed-bean>

	<managed-bean>
		<managed-bean-name>accountControllerCascadeListener</managed-bean-name>
		<managed-bean-class>com.code.aon.ui.account.bridge.event.AccountControllerCascadeListener</managed-bean-class>
		<managed-bean-scope>none</managed-bean-scope>
	</managed-bean>

	<managed-bean>
		<managed-bean-name>customerAccount</managed-bean-name>
		<managed-bean-class>com.code.aon.ui.account.bridge.event.BasicAccountListener</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
		<managed-property>
			<property-name>pojo</property-name>
			<value>com.code.aon.account.bridge.CustomerAccount</value>
		</managed-property>
		<managed-property>
			<property-name>alias</property-name>
			<value>CustomerAccount_customer_id</value>
		</managed-property>		
	</managed-bean>

	<managed-bean>
		<managed-bean-name>supplierAccount</managed-bean-name>
		<managed-bean-class>com.code.aon.ui.account.bridge.event.BasicAccountListener</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
		<managed-property>
			<property-name>pojo</property-name>
			<value>com.code.aon.account.bridge.SupplierAccount</value>
		</managed-property>
		<managed-property>
			<property-name>alias</property-name>
			<value>SupplierAccount_supplier_id</value>
		</managed-property>		
	</managed-bean>

	<managed-bean>
		<managed-bean-name>creditorAccount</managed-bean-name>
		<managed-bean-class>com.code.aon.ui.account.bridge.event.BasicAccountListener</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
		<managed-property>
			<property-name>pojo</property-name>
			<value>com.code.aon.account.bridge.CreditorAccount</value>
		</managed-property>
		<managed-property>
			<property-name>alias</property-name>
			<value>CreditorAccount_creditor_id</value>
		</managed-property>		
	</managed-bean>
	
	<managed-bean>
		<managed-bean-name>taxAccountListener</managed-bean-name>
		<managed-bean-class>
			com.code.aon.ui.account.bridge.event.TaxAccountListener
		</managed-bean-class>
		<managed-bean-scope>none</managed-bean-scope>
	</managed-bean>

</faces-config>