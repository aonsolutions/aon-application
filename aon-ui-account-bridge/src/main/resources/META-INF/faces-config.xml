<?xml version="1.0"?>
<!DOCTYPE faces-config PUBLIC
  "-//Sun Microsystems, Inc.//DTD JavaServer Faces Config 1.1//EN"
  "http://java.sun.com/dtd/web-facesconfig_1_1.dtd">

<faces-config>

	<managed-bean>
		<managed-bean-name>itemListeners</managed-bean-name>
	    <managed-bean-class>java.util.LinkedList</managed-bean-class>
		<managed-bean-scope>none</managed-bean-scope>
		<list-entries>
			<value-class>
				com.code.aon.ui.form.event.IControllerListener
			</value-class>
			<value>#{productAccountListener}</value>
		</list-entries>
	</managed-bean>

	<managed-bean>
		<managed-bean-name>productAccountListener</managed-bean-name>
		<managed-bean-class>
			com.code.aon.ui.account.bridge.event.ProductAccountListener
		</managed-bean-class>
		<managed-bean-scope>none</managed-bean-scope>
	</managed-bean>

	<managed-bean>
		<managed-bean-name>accountListeners</managed-bean-name>
	    <managed-bean-class>java.util.LinkedList</managed-bean-class>
		<managed-bean-scope>none</managed-bean-scope>
		<list-entries>
			<value-class>
				com.code.aon.ui.form.event.IControllerListener
			</value-class>
			<value>#{accountControllerCascadeListener}</value>
		</list-entries>
	</managed-bean>

	<managed-bean>
		<managed-bean-name>accountControllerCascadeListener</managed-bean-name>
		<managed-bean-class>com.code.aon.ui.account.bridge.event.AccountControllerCascadeListener</managed-bean-class>
		<managed-bean-scope>none</managed-bean-scope>
	</managed-bean>

</faces-config>