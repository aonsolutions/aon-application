	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
	<parent>
		<groupId>com.code.aon</groupId>
		<artifactId>aon.web.parent</artifactId>
		<version>7.0-SNAPSHOT</version>
		<relativePath>../aon-web-parent</relativePath>
	</parent>
	<modelVersion>4.0.0</modelVersion>
	<groupId>com.code.aon</groupId>
	<artifactId>aon-employee</artifactId>
	<packaging>war</packaging>
	<version>7.0-SNAPSHOT</version>
	<description>AON GWT EMPLOYEE</description>
	<name>AON GWT EMPLOYEE</name>
	<properties>
		<dbVersion>5.0.0</dbVersion>
	</properties>
	<build>
		<finalName>aon-employee</finalName>
		<plugins>
			<!-- Para construir el RPM -->
			<plugin>
				<groupId>org.codehaus.mojo</groupId>
				<artifactId>rpm-maven-plugin</artifactId>
				<version>2.0.1</version>
	                                                   <configuration>
                                                                <requires>
                                                                        <require>openoffice.org-core</require>
                                                                        <require>openoffice.org-headless</require>
                                                                        <require>openoffice.org-calc</require>
                                                                        <require>openoffice.org-draw</require>
                                                                        <require>openoffice.org-writer</require>
                                                                        <require>openoffice.org-impress</require>
                                                                </requires>
	                                                   </configuration>
			</plugin>
			<plugin>
				<groupId>org.codehaus.mojo</groupId>
				<artifactId>gwt-maven-plugin</artifactId>
				<version>2.4.0</version>
				<executions>
					<execution>
						<goals>
							<goal>compile</goal>
							<!--goal>generateAsync</goal -->
							<goal>test</goal>
						</goals>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>

	<repositories>
              <repository>
                        <id>dynamicJasper-public-repository</id>
                        <name>DynamicJasper public Repository</name>
                        <url>http://archiva.fdvs.com.ar/repository/public1/</url>
                        <releases>
                                <enabled>false</enabled>
                                <updatePolicy>never</updatePolicy>
                        </releases>
                        <snapshots>
                                <enabled>false</enabled>
                                <updatePolicy>never</updatePolicy>
                        </snapshots>
                </repository>
	</repositories>

