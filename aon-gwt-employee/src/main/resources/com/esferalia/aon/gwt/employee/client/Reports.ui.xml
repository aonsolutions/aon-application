<ui:UiBinder xmlns:ui='urn:ui:com.google.gwt.uibinder'
	xmlns:g='urn:import:com.google.gwt.user.client.ui' xmlns:employee='urn:import:com.esferalia.aon.gwt.employee.client'>

	<ui:style>
		.editor {
		}

		.document {
			margin-top: 5px;
			margin-left: auto;
			margin-right: auto;
			margin-bottom: 15px;
			border: 1px solid #D4D0C8;
			box-shadow: 5px 5px 10px 5px #D4D0C8;
		}
		
	</ui:style>
	<g:DockLayoutPanel unit="EM">
		<g:north size="6">

			<g:FlowPanel>

				<g:MenuBar >
					<g:MenuItem text="Archivo">
						<g:MenuBar vertical="true">
							<g:MenuItem text="Descargar como" >
								<g:MenuBar vertical="true" >
									<g:MenuItem text="PDF" />
								</g:MenuBar>
							</g:MenuItem>
							<g:MenuItem text="Enviar por correo electrónico al trabajador" />
							<g:MenuItem text="Enviar por correo electrónico como archivo adjunto..." />
							<g:MenuItem styleName="gwt-MenuItemSeparator"><div class="menuSeparatorInner"></div></g:MenuItem> 
							<g:MenuItem text="Imprimir" />
						</g:MenuBar>
					</g:MenuItem>
					<!--  
					<g:MenuItem text="Ver">
					</g:MenuItem>
					-->
				</g:MenuBar>
				
				<g:FlowPanel styleName="aon-finding-title-toolbar" >
					<g:HorizontalPanel >
						<g:HTMLPanel styleName="aon-finding-title">
							<g:HTMLPanel styleName="aon-finding-title-internal" >
								<g:Label styleName="aon-outputText">Nóminas</g:Label>
							</g:HTMLPanel>
						</g:HTMLPanel>
						<g:HTMLPanel styleName="aon-finding-subtitle">
							<g:HTMLPanel styleName="aon-finding-aubtitle-internal" >
								<g:Label styleName="aon-outputText" text=" "/> 
							</g:HTMLPanel>
						</g:HTMLPanel>
						<g:HorizontalPanel styleName="aon-finding-toolbar">
							<g:HTMLPanel styleName="aon-finding-toolbar-item-group" >
								<g:Button styleName='aon-finding-toolbar-item aon-icon-pdf' text="Imprimir" /> 
								<g:HTMLPanel styleName="aon-spin-control" >
									<g:HTMLPanel styleName="aon-spin-control-element" >
										<g:Button ui:field='first'  stylePrimaryName='aon-dataScroller-button aon-dataScroller-button-first'  />
									</g:HTMLPanel>
									<g:HTMLPanel  styleName="aon-spin-control-element" >
										<g:Button ui:field='previous' styleName='aon-dataScroller-button aon-dataScroller-button-previous' />
									</g:HTMLPanel>
									<g:Label ui:field='text'  styleName="aon-spin-control-element aon-nowrap" > 1 de ..	</g:Label>
									<g:HTMLPanel styleName="aon-spin-control-element" >
										<g:Button ui:field='next' styleName='aon-dataScroller-button aon-dataScroller-button-next' />
									</g:HTMLPanel>
									<g:HTMLPanel styleName="aon-spin-control-element" >
										<g:Button ui:field='last' styleName='aon-dataScroller-button aon-dataScroller-button-last' />
									</g:HTMLPanel>
								</g:HTMLPanel>
							</g:HTMLPanel>
						</g:HorizontalPanel>
					</g:HorizontalPanel>
				</g:FlowPanel>				

			</g:FlowPanel>

		</g:north>
		<g:center>
			<g:ScrollPanel styleName="{style.editor}" >
				<g:VerticalPanel styleName="{style.document}">
					<g:HTML styleName="reset" ui:field='container' wordWrap='true' />
				</g:VerticalPanel>
			</g:ScrollPanel>
		</g:center>
	</g:DockLayoutPanel>

</ui:UiBinder>
