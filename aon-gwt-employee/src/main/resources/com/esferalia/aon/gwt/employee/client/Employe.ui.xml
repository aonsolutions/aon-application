<ui:UiBinder xmlns:ui='urn:ui:com.google.gwt.uibinder'
	xmlns:g='urn:import:com.google.gwt.user.client.ui' 
	xmlns:employe='urn:import:com.esferalia.aon.gwt.employee.client'>

	<!-- GIFs needed for ie6 work arounds. Can't use <ui:image>, it makes PNGs -->
	<ui:data field='notesgroupIe6Data' src='notesgroup_ie6.gif' />
	<ui:data field='salariesgroupIe6Data' src='salariesgroup_ie6.gif' />
	<ui:data field='documentsgroupIe6Data' src='documentsgroup_ie6.gif' />

	<ui:style>
	 .shortcuts {
	   border-left: 1px solid #e5e5e5;
	   border-right: 1px solid #e5e5e5;
	   border-bottom: 1px solid #e5e5e5;
	 }
	
	 .stackHeader {
	   background-color: #f5f5f5;
	   cursor: pointer;
	
	   font-size: 1.2em;
	   font-weight: bold;
	   color: #000;
	   padding: .7em .5em .7em .6em;
	   border-top: 1px solid #e5e5e5;
	   
	 }
	
	 @if user.agent ie6 {
	   @url notesgroupIe6 notesgroupIe6Data;
	   @url documentsgroupIe6 notesgroupIe6Data;
	   @url salariesgroupIe6 salariesgroupIe6Data;
	
	   .notesIcon {
	     background-image: notesgroupIe6;
	     width: 31px;
	     height: 22px;
	     float: left;
	   }

	   .salariesIcon {
	     background-image: salariesgroupIe6;
	     width: 31px;
	     height: 22px;
	     float: left;
	   }

	   .documentsIcon {
	     background-image: documentsgroupIe6;
	     width: 31px;
	     height: 22px;
	     float: left;
	   }

	 } @else {
	
	@sprite .notesIcon {
	     gwt-image: 'notesgroup';
	     float: left;
	   }

	@sprite .salariesIcon {
	     gwt-image: 'salariesgroup';
	     float: left;
	   }

	@sprite .documentsIcon {
	     gwt-image: 'documentsgroup';
	     float: left;
	   }

	 }
	</ui:style>

	<ui:image field='notesgroup' src='notesgroup.png' />
	<ui:image field='salariesgroup' src='salariesgroup.png' />
	<ui:image field='documentsgroup' src='documentsgroup.png' />

	<g:DockLayoutPanel>

		<g:north size='71'>
			<employe:TopPanel ui:field='topPanel' />
		</g:north>

		<g:center>
			<g:SplitLayoutPanel>
				<g:west size='192'>	

						<g:StackLayoutPanel styleName='{style.shortcuts}' unit='EM'>

							<g:stack>
								<g:header size='3'>
									<div class='{style.stackHeader}'>
										<div class='{style.salariesIcon}' />
										Nominas
									</div>
								</g:header>
								<g:ScrollPanel>
									<employe:Salaries ui:field='salaries' />
								</g:ScrollPanel>
							</g:stack>
							<g:stack>
								<g:header size='3'>
									<div class='{style.stackHeader}'>
										<div class='{style.notesIcon}' />
										Notas
									</div>
								</g:header>
								<g:ScrollPanel>
								</g:ScrollPanel>
							</g:stack>
							<g:stack>
								<g:header size='3'>
									<div class='{style.stackHeader}'>
										<div class='{style.documentsIcon}' />
										Documentos
									</div>
								</g:header>
								<g:ScrollPanel>
								</g:ScrollPanel>
							</g:stack>

						</g:StackLayoutPanel>

					
				</g:west>

				<g:center>
					<employe:EmployeeDetail ui:field='employeDetail' />
				</g:center>
			</g:SplitLayoutPanel>
		</g:center>

	</g:DockLayoutPanel>

</ui:UiBinder>
