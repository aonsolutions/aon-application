<ui:UiBinder xmlns:ui='urn:ui:com.google.gwt.uibinder'
	xmlns:g='urn:import:com.google.gwt.user.client.ui' xmlns:employee='urn:import:com.esferalia.aon.gwt.employee.client'>

	<ui:style>
		.editor {
		}

		.document {
			margin: auto;
			border: 1px solid #e5e5e5;
			box-shadow: 4px 4px 4px #e5e5e5;
		}
		
		.toolbar {
			width: 100%;
			border: 1px solid #e5e5e5;
			padding: 4px 2px 4px 2px ;
			background-color: #f5f5f5;
		}
		
	</ui:style>
	<g:DockLayoutPanel unit="EM">
		<g:north size="6">

			<g:FlowPanel>

				<g:MenuBar >
					<g:MenuItem text="Archivo">
						<g:MenuBar vertical="true">
							<g:MenuItem text="Descargar como" >
								<g:MenuBar vertical="true" >
									<g:MenuItem text="PDF" />
									<g:MenuItem text="RTF" />
									<g:MenuItem text="Word" />
									<g:MenuItem text="HTML" />
								</g:MenuBar>
							</g:MenuItem>
							<g:MenuItem text="Enviar por correo electrónico al trabajador" />
							<g:MenuItem text="Enviar por correo electrónico como archivo adjunto..." />
							<g:MenuItem styleName="gwt-MenuItemSeparator"><div class="menuSeparatorInner"></div></g:MenuItem> 
							<g:MenuItem text="Imprimir" />
						</g:MenuBar>
					</g:MenuItem>
					<g:MenuItem text="Ver">
					</g:MenuItem>
				</g:MenuBar>
				
				<g:FlowPanel styleName="{style.toolbar}" >
					<g:Button></g:Button>
				</g:FlowPanel>

			</g:FlowPanel>

		</g:north>
		<g:center>
			<g:ScrollPanel styleName="{style.editor}" >
				<g:VerticalPanel styleName="{style.document}">
					<g:HTML ui:field='receipt' wordWrap='true' />
				</g:VerticalPanel>
			</g:ScrollPanel>
		</g:center>
	</g:DockLayoutPanel>

</ui:UiBinder>
