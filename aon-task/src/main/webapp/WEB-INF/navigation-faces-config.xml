<?xml version="1.0"?>
<!DOCTYPE faces-config PUBLIC
  "-//Sun Microsystems, Inc.//DTD JavaServer Faces Config 1.1//EN"
  "http://java.sun.com/dtd/web-facesconfig_1_1.dtd">

<faces-config>

	<navigation-rule>
		<navigation-case>
			<from-outcome>logout</from-outcome>
			<to-view-id>/home.jsf</to-view-id> 
			<redirect/>
		</navigation-case>
	</navigation-rule>

	<!-- =================== Dossier Type ================= -->
	<navigation-rule>
		<navigation-case>
			<from-outcome>dossier_type_list</from-outcome>
			<to-view-id>/facelet/dossier/dossier_type/list.jsf</to-view-id>
		</navigation-case>
		<navigation-case>
			<from-outcome>dossier_type_form</from-outcome>
			<to-view-id>/facelet/dossier/dossier_type/form.jsf</to-view-id>
		</navigation-case>
		<navigation-case>
			<from-outcome>dossier_type_search</from-outcome>
			<to-view-id>/facelet/dossier/dossier_type/search.jsf</to-view-id>
		</navigation-case>
	</navigation-rule>

	<!-- =================== Employee ================= -->
	<navigation-rule>
		<navigation-case>
			<from-outcome>employee_list</from-outcome>
			<to-view-id>/facelet/employee/list.jsf</to-view-id>
		</navigation-case>
		<navigation-case>
			<from-outcome>employee_form</from-outcome>
			<to-view-id>/facelet/employee/form.jsf</to-view-id>
		</navigation-case>
		<navigation-case>
			<from-outcome>employee_search</from-outcome>
			<to-view-id>/facelet/employee/search.jsf</to-view-id>
		</navigation-case>
	</navigation-rule>

	<!-- =================== Customer ================= -->
	<navigation-rule>
		<navigation-case>
			<from-outcome>customer</from-outcome>
			<to-view-id>/facelet/customer/search.jsf</to-view-id>
		</navigation-case>
		<navigation-case>
			<from-outcome>customer_list</from-outcome>
			<to-view-id>/facelet/customer/list.jsf</to-view-id>
		</navigation-case>
		<navigation-case>
			<from-outcome>customer_form</from-outcome>
			<to-view-id>/facelet/customer/form.jsf</to-view-id>
		</navigation-case>
		<navigation-case>
			<from-outcome>customer_search</from-outcome>
			<to-view-id>/facelet/customer/search.jsf</to-view-id>
		</navigation-case>
	</navigation-rule>

	<!-- =================== Dossier ================= -->
	<navigation-rule>
		<navigation-case>
			<from-outcome>dossier_list</from-outcome>
			<to-view-id>/facelet/dossier/list.jsf</to-view-id>
		</navigation-case>
		<navigation-case>
			<from-outcome>dossier_form</from-outcome>
			<to-view-id>/facelet/dossier/form.jsf</to-view-id>
		</navigation-case>
		<navigation-case>
			<from-outcome>dossier_search</from-outcome>
			<to-view-id>/facelet/dossier/search.jsf</to-view-id>
		</navigation-case>
	</navigation-rule>

	<!-- =================== Task ================= -->
	<navigation-rule>
		<navigation-case>
			<from-outcome>task_list</from-outcome>
			<to-view-id>/facelet/task/list.jsf</to-view-id>
		</navigation-case>
		<navigation-case>
			<from-outcome>task_form</from-outcome>
			<to-view-id>/facelet/task/form.jsf</to-view-id>
		</navigation-case>
		<navigation-case>
			<from-outcome>task_search</from-outcome>
			<to-view-id>/facelet/task/search.jsf</to-view-id>
		</navigation-case>
	</navigation-rule>

	<!-- =================== Process Launcher ================= -->
	<navigation-rule>
		<navigation-case>
			<from-outcome>process_wizard_step0</from-outcome>
			<to-view-id>/facelet/process/launcher/step0.jsf</to-view-id>
		</navigation-case>
		<navigation-case>
			<from-outcome>process_wizard_step1</from-outcome>
			<to-view-id>/facelet/process/launcher/step1.jsf</to-view-id>
		</navigation-case>
		<navigation-case>
			<from-outcome>process_wizard_step2</from-outcome>
			<to-view-id>/facelet/process/launcher/step2.jsf</to-view-id>
		</navigation-case>
		<navigation-case>
			<from-outcome>process_wizard_step3</from-outcome>
			<to-view-id>/facelet/process/launcher/step3.jsf</to-view-id>
		</navigation-case>
		<navigation-case>
			<from-outcome>process_wizard_step4</from-outcome>
			<to-view-id>/facelet/process/launcher/step4.jsf</to-view-id>
		</navigation-case>
	</navigation-rule>

</faces-config>
