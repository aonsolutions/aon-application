	<modelVersion>4.0.0</modelVersion>
	<artifactId>aon.google.apis</artifactId>
	<description>AON GOOGLE APIS</description>
	<name>AON GOOGLE APIS</name>

	<dependencies>
		<dependency>
			<groupId>com.esferalia.aon</groupId>
			<artifactId>aon.master.jooq</artifactId>
			<version>${project.version}</version>
