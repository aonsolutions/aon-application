		<dependency>
			<groupId>com.mchange</groupId>
			<artifactId>mchange-commons-java</artifactId>
			<version>0.2.3.3</version>
			<scope>provided</scope>
			
		</dependency>
		




	</dependencies>
	<profiles>
		<profile>
			<id>rpm-release</id>
			<activation>
				<property>
					<name>rpm.release</name>
					<value>true</value>
				</property>
			</activation>



			<build>
				<plugins>
					<!-- Para construir el RPM -->
					<plugin>

						<groupId>org.codehaus.mojo</groupId>
						<artifactId>rpm-maven-plugin</artifactId>
						<version>2.0.1</version>
						<extensions>true</extensions>

						<executions>
							<execution>
								<id>rpm-build</id>
								<goals>
									<goal>attached-rpm</goal>
								</goals>
							</execution>
						</executions>

						<configuration>
							<group>Applications/Aon</group>
							<release>${buildNumber}</release>
							<copyright>2010, esferalia Networks S.A</copyright>
							<requires>
								<require>slf4j</require>
								<require>aon-dbutils</require>
								<require>mysql-connector-java</require>
								<require>apache-commons-cli</require>
							</requires>
							<mappings>

								<mapping>
									<filemode>755</filemode>
									<username>root</username>
									<groupname>root</groupname>

									<directory>/usr/share/java</directory>
									<dependency>
										<includes>
											<include>com.google.api-client:google-api-client-servlet:1.18.0-rc</include>

											<include>javax.mail:mail:1.4</include>

											<include>com.google.http-client:google-http-client-jackson2:1.18.0-rc</include>

											<include>com.esferalia.aon:aon.sql.google:${project.version}</include>

											<include>com.google.apis:google-api-services-drive:v2-rev102-1.17.0-rc</include>

											<include>com.code.aon:aon.pool:${project.version}</include>

											<include>javax.servlet:servlet-api:2.5</include>

											<include>com.esferalia.aon:aon.master.jooq:${project.version}</include>

											<include>commons-io:commons-io:1.4</include>

											<include>commons-lang:commons-lang:2.5</include>

											<include>com.esferalia.aon:aon.entity.common:${project.version}</include>

											<include>com.code.aon:aon.ui.common:${project.version}</include>

											<include>com.code.aon:aon.common:${project.version}</include>

											<include>com.google.apis:google-api-services-oauth2:v2-rev47-1.16.0-rc</include>

											<include>org.jooq:jooq-codegen-maven:3.3.2</include>

											<include>com.mchange:mchange-commons-java:0.2.3.3</include>

											<include>com.mchange:c3p0:0.9.2-pre3</include>

										</includes>
									</dependency>
									<sources>

										<source>
											<location>target</location>
											<includes>
												<include>${project.artifactId}-${project.version}.jar</include>
											</includes>
										</source>

										<softlinkSource>
											<location>${project.artifactId}-${project.version}.jar</location>
											<destination>${project.artifactId}.jar</destination>

										</softlinkSource>


										<softlinkSource>
											<location>google-api-client-servlet-1.18.0-rc.jar</location>
											<destination>google-api-client-servlet.jar</destination>
										</softlinkSource>

										<softlinkSource>
											<location>google-http-client-jackson2-1.18.0-rc.jar</location>
											<destination>google-http-client-jackson2.jar</destination>
										</softlinkSource>

										<softlinkSource>
											<location>mail-1.4.jar</location>
											<destination>mail.jar</destination>
										</softlinkSource>

										<softlinkSource>
											<location>aon.sql.google-${project.version}.jar</location>
											<destination>aon.sql.google.jar</destination>
										</softlinkSource>

										<softlinkSource>
											<location>google-api-services-drive-v2-rev102-1.17.0-rc.jar</location>
											<destination>google-api-services-drive.jar</destination>
										</softlinkSource>

										<softlinkSource>
											<location>aon.pool-${project.version}.jar</location>
											<destination>aon.pool.jar</destination>
										</softlinkSource>
										<softlinkSource>
											<location>servlet-api-2.5.jar</location>
											<destination>javax.servlet.jar</destination>
										</softlinkSource>

										<softlinkSource>
											<location>c3p0-0.9.2.jar</location>
											<destination>c3p0.jar</destination>
										</softlinkSource>
										<softlinkSource>
											<location>mchange-commons-java-0.2.3.3.jar</location>
											<destination>mchange-commons-java.jar</destination>
										</softlinkSource>
										<softlinkSource>
											<location>jooq-3.3.2.jar</location>
											<destination>jooq.jar</destination>
										</softlinkSource>

										<softlinkSource>
											<location>aon.master.jooq-${project.version}.jar</location>
											<destination>aon.master.jooq.jar</destination>
										</softlinkSource>

										<softlinkSource>
											<location>jackson-core-2.1.3.jar</location>
											<destination>jackson-core.jar</destination>
										</softlinkSource>

										<softlinkSource>
											<location>google-oauth-client-1.18.0-rc.jar</location>
											<destination>google-oauth-client.jar</destination>
										</softlinkSource>

										<softlinkSource>
											<location>aon.entity.common-${project.version}.jar</location>
											<destination>aon.entity.common.jar</destination>
										</softlinkSource>

										<softlinkSource>
											<location>aon.common-${project.version}.jar</location>
											<destination>aon.common.jar</destination>
										</softlinkSource>

										<softlinkSource>
											<location>commons-lang-2.5.jar</location>
											<destination>commons-lang.jar</destination>
										</softlinkSource>

										<softlinkSource>
											<location>commons-io-1.4.jar</location>
											<destination>commons-io.jar</destination>
										</softlinkSource>


									</sources>



								</mapping>
								<mapping>
									<sources>
										<softlinkSource>
											<location>src/main/scripts</location>
											<excludes>
												<exclude>sync</exclude>
											</excludes>
										</softlinkSource>
									</sources>
									<filemode>755</filemode>
									<username>root</username>
									<groupname>root</groupname>
									<directory>/usr/share/aon-google-apis/bin</directory>
								</mapping>

								<mapping>

									<filemode>755</filemode>
									<username>root</username>
									<groupname>root</groupname>

									<directory>/etc/cron.daily</directory>
									<sources>
										<softlinkSource>
											<location>src/main/scripts/autosynchronize</location>
											<destination>autosynchronize</destination>
										</softlinkSource>
									</sources>
								</mapping>

							</mappings>


						</configuration>
					</plugin>



				</plugins>
			</build>
		</profile>

		<profile>
			<id>perform-stats</id>
		</profile>

	</profiles>
</project>
 
