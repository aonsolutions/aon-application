<faces-config version="1.2" xmlns="http://java.sun.com/xml/ns/javaee"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://java.sun.com/xml/ns/javaee http://java.sun.com/xml/ns/javaee/web-facesconfig_1_2.xsd">

	<!-- ************ PARAMETERS **************** -->
	<managed-bean>
		<managed-bean-name>audabridgeParams</managed-bean-name>
		<managed-bean-class>com.code.aon.ui.audabridge.controller.AudabridgeParametersController</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
	</managed-bean>
	
	<!-- ************ Audabridge Offer  **************** -->
	<managed-bean>
		<managed-bean-name>audabridgeOffer</managed-bean-name>
		<managed-bean-class>com.code.aon.ui.audabridge.controller.AudabridgeOfferController</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
	</managed-bean>

	<!-- ************ Audabridge Offer OPTIONAL listener **************** -->
	<managed-bean>
		<managed-bean-name>audabridgeOfferControllerListener</managed-bean-name>
		<managed-bean-class>com.code.aon.ui.audabridge.event.AudabridgeOfferControllerListener</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
	</managed-bean>


	<!-- ================================================ -->
	<!-- =================== NAVIGATION ================= -->
	<!-- ================================================ -->

	<!-- =================== AUDABRIDGE PARAMETERS ================= -->
	<navigation-rule>
		<navigation-case>
			<from-outcome>audabridgeParams</from-outcome>
			<to-view-id>/com/code/aon/ui/audabridge/facelet/params/form.xhtml</to-view-id>
		</navigation-case>
	</navigation-rule>
	
	<!-- =================== AUDABRIDGE OFFER ================= -->
	<navigation-rule>
		<navigation-case>
			<from-outcome>audabridgeOffer</from-outcome>
			<to-view-id>/com/code/aon/ui/audabridge/facelet/offer/form.xhtml</to-view-id>
		</navigation-case>
	</navigation-rule>
</faces-config>
