<faces-config version="1.2"
	xmlns="http://java.sun.com/xml/ns/javaee"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://java.sun.com/xml/ns/javaee http://java.sun.com/xml/ns/javaee/web-facesconfig_1_2.xsd">

	<application>
		<resource-bundle>
			<base-name>com.code.aon.ui.admin.i18n.messages</base-name>
			<var>adminBundle</var>
		</resource-bundle>
	</application>
	
	<!-- ************ COLLECTION **************** -->
	<managed-bean>
		<managed-bean-name>adminCollections</managed-bean-name>
		<managed-bean-class>
			com.code.aon.ui.admin.controller.AdminCollectionsController
		</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
	</managed-bean>	
	
	<!-- ************* ADMIN MAIN ***************** -->
	<managed-bean>
		<managed-bean-name>adminMain</managed-bean-name>
		<managed-bean-class>
			com.code.aon.ui.admin.controller.AdminMainController
		</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
	</managed-bean>	
	
	<!-- ************* DB MANAGER ***************** -->
	<managed-bean>
		<managed-bean-name>dbManager</managed-bean-name>
		<managed-bean-class>
			com.code.aon.ui.admin.controller.DBManagerController
		</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
	</managed-bean>		
			
	<!-- ************* NEW DOMAIN ***************** -->
	<managed-bean>
		<managed-bean-name>adminNewDomain</managed-bean-name>
		<managed-bean-class>com.code.aon.ui.admin.controller.NewDomainController</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
	</managed-bean>	

	<!-- ************* REMOVE DOMAIN ***************** -->
	<managed-bean>
		<managed-bean-name>adminRemoveDomain</managed-bean-name>
		<managed-bean-class>com.code.aon.ui.admin.controller.RemoveDomainController</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
	</managed-bean>	

	<!-- ************* DOMAIN ***************** -->
	<managed-bean>
		<managed-bean-name>adminDomain</managed-bean-name>
		<managed-bean-class>
			com.code.aon.ui.admin.controller.DomainController
		</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
		<managed-property>
			<property-name>queryOnStartUP</property-name>
			<value>true</value>
		</managed-property>
		<managed-property>
			<property-name>pojo</property-name>
			<value>com.code.aon.config.Domain</value>
		</managed-property>
		<managed-property>
			<property-name>beanName</property-name>
			<value>adminDomain</value>
		</managed-property>								
		<managed-property>
			<property-name>defaultOrder</property-name>
			<value>Domain_name</value>
		</managed-property>
		<managed-property>
			<property-name>listenerClasses</property-name>
			<list-entries>
				<value-class>com.code.aon.ui.form.event.IControllerListener</value-class>
				<value>#{domainControllerListener}</value>
			</list-entries>
		</managed-property>		
	</managed-bean>	

	<managed-bean>
		<managed-bean-name>domainControllerListener</managed-bean-name>
		<managed-bean-class>
			com.code.aon.ui.admin.event.DomainControllerListener
		</managed-bean-class>
		<managed-bean-scope>none</managed-bean-scope>
	</managed-bean>
	
	<!-- ************* DOMAIN CAPABILITIES ***************** -->
	<managed-bean>
		<managed-bean-name>domainCapabilities</managed-bean-name>
		<managed-bean-class>
			com.code.aon.ui.admin.controller.DomainCapabilitiesController
		</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
		<managed-property>
			<property-name>beanName</property-name>
			<value>domainCapabilities</value>
		</managed-property>								
	</managed-bean>					
	
	<!-- ************* DOMAIN USER ***************** -->
	<managed-bean>
		<managed-bean-name>domainUser</managed-bean-name>
		<managed-bean-class>
			com.code.aon.ui.admin.controller.DomainUserController
		</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
		<managed-property>
			<property-name>queryOnStartUP</property-name>
			<value>true</value>
		</managed-property>
		<managed-property>
			<property-name>pojo</property-name>
			<value>com.code.aon.config.User</value>
		</managed-property>
		<managed-property>
			<property-name>beanName</property-name>
			<value>domainUser</value>
		</managed-property>								
		<managed-property>
			<property-name>defaultOrder</property-name>
			<value>User_login</value>
		</managed-property>
		<managed-property>
			<property-name>listenerClasses</property-name>
			<list-entries>
				<value-class>com.code.aon.ui.form.event.IControllerListener</value-class>
				<value>#{domainUserControllerListener}</value>
				<value>#{domainUserSearch}</value>
			</list-entries>
		</managed-property>		
	</managed-bean>	

	<managed-bean>
		<managed-bean-name>domainUserControllerListener</managed-bean-name>
		<managed-bean-class>
			com.code.aon.ui.admin.event.DomainUserControllerListener
		</managed-bean-class>
		<managed-bean-scope>none</managed-bean-scope>
	</managed-bean>			

	<managed-bean>
		<managed-bean-name>domainUserSearch</managed-bean-name>
		<managed-bean-class>
			com.code.aon.ui.admin.event.DomainUserSearchListener
		</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
	</managed-bean>			

	<!-- ************ USER SCOPE ************** -->
	<managed-bean>
		<managed-bean-name>userScopeEx</managed-bean-name>
		<managed-bean-class>com.code.aon.ui.admin.controller.UserScopeController</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
	</managed-bean>
	
	<!-- ************ USER WORKGROUP ************** -->
	<managed-bean>
		<managed-bean-name>userWorkGroupEx</managed-bean-name>
		<managed-bean-class>com.code.aon.ui.admin.controller.UserWorkGroupController</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
	</managed-bean>
	
	<!-- ************* DOMAIN APPLICATION ***************** -->
	<managed-bean>
		<managed-bean-name>domainApplication</managed-bean-name>
		<managed-bean-class>
			com.code.aon.ui.admin.controller.DomainApplicationController
		</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
		<managed-property>
			<property-name>queryOnStartUP</property-name>
			<value>true</value>
		</managed-property>
		<managed-property>
			<property-name>pojo</property-name>
			<value>com.code.aon.config.DomainApplication</value>
		</managed-property>
		<managed-property>
			<property-name>beanName</property-name>
			<value>domainApplication</value>
		</managed-property>								
		<managed-property>
			<property-name>defaultOrder</property-name>
			<value>DomainApplication_application_name</value>
		</managed-property>
		<managed-property>
			<property-name>listenerClasses</property-name>
			<list-entries>
				<value-class>com.code.aon.ui.form.event.IControllerListener</value-class>
				<value>#{domainApplicationControllerListener}</value>
				<value>#{domainApplicationUserControllerListener}</value>
				<value>#{domainApplicationProfileChildListener}</value>
			</list-entries>
		</managed-property>		
	</managed-bean>	

	<managed-bean>
		<managed-bean-name>domainApplicationControllerListener</managed-bean-name>
		<managed-bean-class>
			com.code.aon.ui.admin.event.DomainApplicationControllerListener
		</managed-bean-class>
		<managed-bean-scope>none</managed-bean-scope>
	</managed-bean>
	
	<!-- ************* DOMAIN APPLICATION USER ***************** -->
	<managed-bean>
		<managed-bean-name>appUser</managed-bean-name>
		<managed-bean-class>
			com.code.aon.ui.admin.controller.DomainApplicationUserController
		</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
		<managed-property>
			<property-name>queryOnStartUP</property-name>
			<value>true</value>
		</managed-property>
		<managed-property>
			<property-name>pojo</property-name>
			<value>com.code.aon.config.ApplicationUser</value>
		</managed-property>
		<managed-property>
			<property-name>beanName</property-name>
			<value>appUser</value>
		</managed-property>
		<managed-property>
			<property-name>masterControllerName</property-name>
			<value>domainApplication</value>
		</managed-property>										
		<managed-property>
			<property-name>defaultOrder</property-name>
			<value>ApplicationUser_user_login</value>
		</managed-property>
		<managed-property>
			<property-name>propertyMap</property-name>
			<map-entries>
				<map-entry>
					<key>id</key>
					<value>domainApplication.id</value>
				</map-entry>
			</map-entries>
		</managed-property>		
		<managed-property>
			<property-name>listenerClasses</property-name>
			<list-entries>
				<value-class>com.code.aon.ui.form.event.IControllerListener</value-class>
				<value>#{appUserControllerListener}</value>
			</list-entries>
		</managed-property>		
	</managed-bean>	

	<managed-bean>
		<managed-bean-name>appUserControllerListener</managed-bean-name>
		<managed-bean-class>
			com.code.aon.ui.admin.event.DomainApplicationUserControllerListener
		</managed-bean-class>
		<managed-bean-scope>none</managed-bean-scope>
	</managed-bean>
	
	<managed-bean>
		<managed-bean-name>domainApplicationUserControllerListener</managed-bean-name>
		<managed-bean-class>
			com.code.aon.ui.form.listener.LinesControllerListener
		</managed-bean-class>
		<managed-bean-scope>none</managed-bean-scope>
		<managed-property>
			<property-name>childBean</property-name>
			<value>appUser</value>
		</managed-property>
		<managed-property>
			<property-name>aliasMap</property-name>
			<map-entries>
				<map-entry>
					<key>ApplicationUser_domainApplication_id</key>
                    <value>id</value>
				</map-entry>
			</map-entries>
		</managed-property>
	</managed-bean>		
		
	<!-- ************* APPLICATION PROFILE ***************** -->
	<managed-bean>
		<managed-bean-name>applicationProfile</managed-bean-name>
		<managed-bean-class>com.code.aon.ui.form.BasicController</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
		<managed-property>
			<property-name>pojo</property-name>
			<value>com.code.aon.admin.Profile</value>
		</managed-property>
		<managed-property>
			<property-name>beanName</property-name>
			<value>applicationProfile</value>
		</managed-property>
		<managed-property>
			<property-name>defaultOrder</property-name>
			<value>Profile_name</value>
		</managed-property>
		<managed-property>
			<property-name>defaultExpressions</property-name>
			<map-entries>
				<map-entry>
					<key>Profile_domain</key>
					<value>null</value>
				</map-entry>
			</map-entries>
		</managed-property>				
	</managed-bean>	
		
	<!-- ************* DOMAIN APPLICATION PROFILE ***************** -->
	<managed-bean>
		<managed-bean-name>domainApplicationProfile</managed-bean-name>
		<managed-bean-class>com.code.aon.ui.admin.controller.ApplicationProfileController</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
		<managed-property>
			<property-name>queryOnStartUP</property-name>
			<value>true</value>
		</managed-property>
		<managed-property>
			<property-name>pojo</property-name>
			<value>com.code.aon.admin.Profile</value>
		</managed-property>
		<managed-property>
			<property-name>beanName</property-name>
			<value>domainApplicationProfile</value>
		</managed-property>
		<managed-property>
			<property-name>masterControllerName</property-name>
			<value>domainApplication</value>
		</managed-property>
		<managed-property>
			<property-name>defaultOrder</property-name>
			<value>Profile_name</value>
		</managed-property>
		<managed-property>
			<property-name>propertyMap</property-name>
			<map-entries>
				<map-entry>
					<key>application.id</key>
					<value>application.id</value>
				</map-entry>
				<map-entry>
					<key>domain</key>
					<value>domain.id</value>
				</map-entry>
			</map-entries>
		</managed-property>
		<managed-property>
			<property-name>listenerClasses</property-name>
			<list-entries>
				<value-class>com.code.aon.ui.form.event.IControllerListener</value-class>
				<value>#{domainApplicationProfileListener}</value>
			</list-entries>
		</managed-property>		
	</managed-bean>	

	<managed-bean>
		<managed-bean-name>domainApplicationProfileListener</managed-bean-name>
		<managed-bean-class>
			com.code.aon.ui.admin.event.DomainApplicationProfileControllerListener
		</managed-bean-class>
		<managed-bean-scope>none</managed-bean-scope>
	</managed-bean>		
	
	<managed-bean>
		<managed-bean-name>domainApplicationProfileChildListener</managed-bean-name>
		<managed-bean-class>
			com.code.aon.ui.admin.event.DomainApplicationProfileLinesListener
		</managed-bean-class>
		<managed-bean-scope>none</managed-bean-scope>
		<managed-property>
			<property-name>childBean</property-name>
			<value>domainApplicationProfile</value>
		</managed-property>
	</managed-bean>		

	<!-- =================== Main ================= -->
	<navigation-rule>
		<navigation-case>
			<from-outcome>advancedMode</from-outcome>
			<to-view-id>/com/code/aon/ui/admin/facelet/adminMain/advancedMode.xhtml</to-view-id>
		</navigation-case>
	</navigation-rule>	
	
	<!-- =================== Domain ================= -->
	<navigation-rule>
		<navigation-case>
			<from-outcome>adminDomain_form</from-outcome>
			<to-view-id>/com/code/aon/ui/admin/facelet/adminDomain/form.xhtml</to-view-id>
		</navigation-case>
	</navigation-rule>		
		
	<!-- =================== Domain User ================= -->
	<navigation-rule>
		<navigation-case>
			<from-outcome>domainUser_list</from-outcome>
			<to-view-id>/com/code/aon/ui/admin/facelet/domainUser/list.xhtml</to-view-id>
		</navigation-case>
		<navigation-case>
			<from-outcome>domainUser_form</from-outcome>
			<to-view-id>/com/code/aon/ui/admin/facelet/domainUser/form.xhtml</to-view-id>
		</navigation-case>
		<navigation-case>
			<from-outcome>domainUser_search</from-outcome>
			<to-view-id>/com/code/aon/ui/admin/facelet/domainUser/search.xhtml</to-view-id>
		</navigation-case>
	</navigation-rule>
	
	<!-- =================== Domain Application ================= -->
	<navigation-rule>
		<navigation-case>
			<from-outcome>domainApplication_list</from-outcome>
			<to-view-id>/com/code/aon/ui/admin/facelet/domainApplication/list.xhtml</to-view-id>
		</navigation-case>
		<navigation-case>
			<from-outcome>domainApplication_form</from-outcome>
			<to-view-id>/com/code/aon/ui/admin/facelet/domainApplication/form.xhtml</to-view-id>
		</navigation-case>
	</navigation-rule>			

	<!-- =================== New Domain  ================= -->
	<navigation-rule>
		<navigation-case>
			<from-outcome>newDomain_form</from-outcome>
			<to-view-id>/com/code/aon/ui/admin/facelet/newDomain/form.xhtml</to-view-id>
		</navigation-case>
	</navigation-rule>			

	<!-- =================== Remove Domain  ================= -->
	<navigation-rule>
		<navigation-case>
			<from-outcome>removeDomain_form</from-outcome>
			<to-view-id>/com/code/aon/ui/admin/facelet/removeDomain/form.xhtml</to-view-id>
		</navigation-case>
	</navigation-rule>			
	
</faces-config>