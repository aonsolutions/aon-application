<?xml version="1.0"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
	<parent>
		<groupId>com.code.aon</groupId>
		<artifactId>aon.parent</artifactId>
		<version>7.0-SNAPSHOT</version>
	</parent>
	<modelVersion>4.0.0</modelVersion>
	<artifactId>aon.company</artifactId>
	<description>AON COMPANY</description>
	<name>AON COMPANY</name>	
	<build>
		<plugins>
			<plugin>
				<groupId>com.esferalia.aon</groupId>
				<artifactId>aon-alias-maven-plugin</artifactId>
				<version>7.0-SNAPSHOT</version>
				<executions>
					<execution>
						<phase>generate-sources</phase>
						<goals>
							<goal>generate-alias</goal>
						</goals>
					</execution>
				</executions>
				<configuration>
					<targetPackage>com.code.aon.company.dao</targetPackage>
					<targetName>ICompanyAlias</targetName>
					<sourcePackages>com.code.aon.company</sourcePackages>
					<excludes>EnterpriseUser</excludes>
				</configuration>
				<dependencies>
					<dependency>
						<groupId>com.code.aon</groupId>
						<artifactId>aon.entity</artifactId>
						<version>${project.version}</version>
						<scope>compile</scope>
					</dependency>
					<dependency>
						<groupId>com.code.aon</groupId>
						<artifactId>aon.common</artifactId>
						<version>${project.version}</version>
						<scope>runtime</scope>
					</dependency>
				</dependencies>
			</plugin>
		</plugins>
	</build>

	<dependencies>
		<dependency>
			<groupId>com.esferalia.aon</groupId>
			<artifactId>aon.calendar</artifactId>
			<version>${project.version}</version>
			<scope>compile</scope>
		</dependency>
		<dependency>
			<groupId>com.code.aon</groupId>
			<artifactId>aon.entity</artifactId>
			<version>${project.version}</version>
			<scope>compile</scope>
		</dependency>
		<dependency>
			<groupId>com.code.aon</groupId>
			<artifactId>aon.registry</artifactId>
			<version>${project.version}</version>
			<scope>compile</scope>
		</dependency>
  	</dependencies>

</project>
 
