<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<ui:UiBinder xmlns:ui='urn:ui:com.google.gwt.uibinder'
	xmlns:g='urn:import:com.google.gwt.user.client.ui'
	xmlns:cell='urn:import:com.google.gwt.user.cellview.client'
	xmlns:aon='urn:import:com.esferalia.aon.gwt.common.client.widget'>
	
	<ui:with type="com.esferalia.aon.gwt.common.client.i18n.CommonMessages" field="msg"></ui:with>
	<ui:with type="com.esferalia.aon.gwt.common.client.css.AonResources" field="aonResources"></ui:with>
	
	<g:DockLayoutPanel styleName="{aonResources.css.aonSelector}">
		<g:north size="30"> 
			<g:FlowPanel ui:field="toolbarPanel" height="100%"
				styleName="aon-finding-title-toolbar aon-width-all {aonResources.css.aonNoPrint}">
				<g:HorizontalPanel>
					<g:HTMLPanel styleName="aon-finding-title">
						<g:HTMLPanel styleName="aon-finding-title-internal">
							<g:Label styleName="aon-outputText" text="{msg.callcenterModule}" />
						</g:HTMLPanel>
					</g:HTMLPanel>
					<g:HTMLPanel styleName="aon-finding-subtitle">
						<g:HTMLPanel styleName="aon-finding-subtitle-internal">
							<g:Label ui:field="subtitle" styleName="aon-outputText"/>
						</g:HTMLPanel>
					</g:HTMLPanel>
					<g:HorizontalPanel styleName="aon-finding-toolbar">
						<g:HTMLPanel styleName="aon-finding-toolbar-item-group">
							<!--  
							<g:SuggestBox ui:field="enterpriseSuggest"/>
							-->
						</g:HTMLPanel>
					</g:HorizontalPanel>
				</g:HorizontalPanel>
			</g:FlowPanel>
		</g:north>
		<g:center>
			<g:DockLayoutPanel >
				
				<g:north size="100">
					<g:HTMLPanel styleName="aon-panelGrid-search searchPanel-document">
						<div class="aon-panelGrid-search-info">
							<span class="aon-panelGrid-search-info-internal">Filtrar:</span>
							<g:InlineHTML ui:field="html" visible="false" />
							<!--  
							<g:Button ui:field="filterButton" visible="false" text="&nbsp;" styleName="aon-editDataTable-button aon-icon-close" /> 
							<a style="font-size:10px;font-weight:bold;float:right;"
								onclick="" href="#">
								<span class="aon-outputText">
								    <g:Button ui:field="advanceSearch" text="Búsqueda Avanzada" styleName="aon-editDataTable-button aon-icon-search"/>
								</span>
							</a>
							-->
						</div>
						<table class="aon-panelGrid">
							<tr>
								<td>
									<span class="aon-panelGrid-search-info-internal2-document">Asunto:</span>
								</td>
								<td style="width:600px">
									<g:TextBox ui:field="searchBoxSubject" styleName="aon-search-box-document"/>
								</td>
							</tr>
						</table>
					</g:HTMLPanel>
				</g:north> 
				
				<g:center>
					<g:SimpleLayoutPanel ui:field="content"/>
				</g:center>
				
			</g:DockLayoutPanel>
		</g:center>
	</g:DockLayoutPanel>
	
</ui:UiBinder>
