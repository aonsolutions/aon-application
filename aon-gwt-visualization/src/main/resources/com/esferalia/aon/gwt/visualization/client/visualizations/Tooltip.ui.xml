<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
	xmlns:g="urn:import:com.google.gwt.user.client.ui" 
	xmlns:datepicker='urn:import:com.google.gwt.user.datepicker.client'>

	<ui:style >

		.buttons {
			padding-top: 10px;
			text-align: right;
		}
		
		.padding-left{
			padding-left: 16px;
		}

	</ui:style>

	<g:HTMLPanel>
		<table>
			<tr>
				<td colspan="2" align="left">
					<g:SimplePanel ui:field="titlePanel" />
				</td>
			</tr>
			<tr>
				<td>
					<g:InlineLabel styleName="aon-bold" ui:field="nameLabel"></g:InlineLabel>
				</td>
				<td>
					<g:SimplePanel ui:field="valuePanel" />
				</td>
			</tr>
		</table>
		<table width="100%">
			<tr>
				<td>
					<g:InlineLabel ui:field="startDateLabel">Inicio:</g:InlineLabel>
				</td>
				<td align="left" >
					<datepicker:DateBox ui:field="startDateBox" />
				</td>
				<td>
					<g:InlineLabel>&nbsp;</g:InlineLabel>
				</td>
				<td  align="left" >
					<g:InlineLabel ui:field="endDateLabel">Fin:</g:InlineLabel>
				</td>
				<td align="right" >
					<datepicker:DateBox ui:field="endDateBox" />
				</td>
			</tr>
			<tr>
				<td colspan="6" align="right">
				    <br></br>
					<div styleName="{style.buttons}" >
						<g:Button ui:field="acceptButton" visible="false">Aceptar</g:Button>
					</div>
				</td>
			</tr>
		</table>

	</g:HTMLPanel>
</ui:UiBinder> 