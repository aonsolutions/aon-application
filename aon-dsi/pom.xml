<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<parent>
		<groupId>com.code.aon</groupId>
		<artifactId>aon.parent</artifactId>
		<version>8.52</version>
	</parent>
	<groupId>com.esferalia.aon</groupId>
	<artifactId>aon.dsi</artifactId>
	<packaging>jar</packaging>

	<name>AON-DSI</name>

	<properties>
		<project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
	</properties>

	<scm>
		<developerConnection>scm:svn:http://dev.esferalia.net/repos/aon-application/trunk/aon-dsi</developerConnection>
		<connection>scm:svn:http://dev.esferalia.net/repos/aon-application/trunk/aon-dsi</connection>
	  <tag>8.52.x</tag>
  </scm>
	<build>
		<plugins>
                       	<plugin>
                                <groupId>org.apache.maven.plugins</groupId>
                               	<artifactId>maven-surefire-plugin</artifactId>
	      			<configuration>
					<skipTests>true</skipTests>
				</configuration>
                        </plugin>

			<plugin>

				<!-- Specify the maven code generator plugin -->
				<groupId>org.jooq</groupId>
				<artifactId>jooq-codegen-maven</artifactId>
				<version>3.5.2</version>

				<!-- The plugin should hook into the generate goal -->
				<executions>
					<execution>
						<goals>
							<goal>generate</goal>
						</goals>
					</execution>
				</executions>

				<!-- Manage the plugin's dependency. We'll use a Paradox database -->
				<dependencies>
					<dependency>
						<groupId>com.hxtt.sql.paradox</groupId>
						<artifactId>paradoxjdbc3</artifactId>
						<version>5.2.015</version>
						<scope>compile</scope>
					</dependency>
				</dependencies>

				<!-- Specify the plugin configuration. The configuration format is the 
					same as for the standalone code generator -->
				<configuration>

					<!-- JDBC connection parameters -->
					<jdbc>
						<driver>com.hxtt.sql.paradox.ParadoxDriver</driver>
						<url>jdbc:paradox:///${basedir}/src/test/resources/db</url>
					</jdbc>

					<!-- Generator parameters -->
					<generator>
						<name>org.jooq.util.DefaultGenerator</name>

						<database>
							<!-- All elements are generated from our schema -->
							<includes>.*</includes>
							<outputSchema>fn</outputSchema>

						</database>

						<generate>

							<!-- Generate jOOQ Record classes for type-safe querying. You can 
								turn this off, if you don't need "active records" for CRUD Defaults to true -->
							<records>true</records>

							<!-- Generate interfaces that will be implemented by records and/or 
								pojos. You can also use these interfaces in Record.into(Class<?>) and similar 
								methods, to let jOOQ return proxy objects for them. Defaults to false -->
							<interfaces>false</interfaces>
							<!-- Generate fluent setters in - records - pojos - interfaces Fluent 
								setters are against the JavaBeans specification, but can be quite useful 
								to those users who do not depend on EL, JSP, JSF, etc. Defaults to false -->
							<fluentSetters>false</fluentSetters>
						</generate>

						<target>
							<packageName>com.esferalia.aon.dsi.jooq</packageName>
							<directory>target/generated-sources</directory>
						</target>
					</generator>
				</configuration>
			</plugin>
			<plugin>
				<groupId>com.google.code.maven-replacer-plugin</groupId>
				<artifactId>replacer</artifactId>
				<version>1.5.3</version>
				<executions>
					<execution>
						<phase>process-sources</phase>
						<goals>
							<goal>replace</goal>
						</goals>
					</execution>
				</executions>
				<configuration>
					<basedir>${basedir}/target/generated-sources</basedir>
					<includes>
						<include>**/*.java</include>
					</includes>
					<regexFlags>
						<regexFlag>DOTALL</regexFlag>
						<regexFlag>MULTILINE</regexFlag>
						<regexFlag>CASE_INSENSITIVE</regexFlag>
					</regexFlags>
					<replacements>
						<replacement>
							<token>""\.""</token>
							<value>"db"</value>
						</replacement>
						<replacement>
							<token>/\*\*\s+\* Create a detached, initialised .+</token>
							<value>// Avoid generating constructors for tables with more than 254 columns (Java's method argument limit)
}</value>
						</replacement>
					</replacements>
				</configuration>
			</plugin>
		</plugins>
	</build>
	<dependencies>
		<dependency>
			<groupId>junit</groupId>
			<artifactId>junit</artifactId>
			<version>4.11</version>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>com.hxtt.sql.paradox</groupId>
			<artifactId>paradoxjdbc3</artifactId>
			<version>5.2.015</version>
			<scope>compile</scope>
		</dependency>
		<dependency>
			<groupId>mysql</groupId>
			<artifactId>mysql-connector-java</artifactId>
			<version>5.1.10</version>
			<scope>compile</scope>
		</dependency>
		<dependency>
			<groupId>org.jooq</groupId>
			<artifactId>jooq</artifactId>
			<version>3.5.2</version>
		</dependency>
		<dependency>
			<groupId>org.slf4j</groupId>
			<artifactId>slf4j-api</artifactId>
			<version>1.5.11</version>
			<scope>compile</scope>
		</dependency>
		<dependency>
			<groupId>org.slf4j</groupId>
			<artifactId>slf4j-simple</artifactId>
			<version>1.5.11</version>
			<scope>runtime</scope>
		</dependency>
		<dependency>
			<groupId>com.code.aon</groupId>
			<artifactId>aon-master</artifactId>
			<version>${project.version}</version>
			<scope>compile</scope>
		</dependency>
		<dependency>
			<groupId>com.code.aon</groupId>
			<artifactId>aon-dbutils</artifactId>
			<version>${project.version}</version>
			<scope>compile</scope>
		</dependency>
		<dependency>
			<groupId>com.esferalia.aon</groupId>
			<artifactId>aon.master.jooq</artifactId>
			<version>${project.version}</version>
			<scope>compile</scope>
		</dependency>
		<dependency>
			<groupId>com.esferalia.aon</groupId>
			<artifactId>aon.master.jooq</artifactId>
			<version>${project.version}</version>
			<scope>compile</scope>
		</dependency>
		<dependency>
			<groupId>com.esferalia.aon</groupId>
			<artifactId>aon.entity.common</artifactId>
			<version>${project.version}</version>
			<scope>compile</scope>
		</dependency>
		<dependency>
			<groupId>com.esferalia.aon</groupId>
			<artifactId>aon.payroll</artifactId>
			<version>${project.version}</version>
			<scope>compile</scope>
		</dependency>
		<dependency>
			<groupId>commons-cli</groupId>
			<artifactId>commons-cli</artifactId>
			<version>1.2</version>
			<scope>compile</scope>
			<optional>false</optional>
		</dependency>
		<dependency>
			<groupId>commons-lang</groupId>
			<artifactId>commons-lang</artifactId>
			<version>2.5</version>
			<scope>compile</scope>
			<optional>false</optional>
		</dependency>
		<dependency>
			<groupId>commons-codec</groupId>
			<artifactId>commons-codec</artifactId>
			<version>1.3</version>
			<scope>provided</scope>
		</dependency>
	</dependencies>
</project>
