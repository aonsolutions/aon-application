<?xml version="1.0" encoding="ISO-8859-1"?>

<!DOCTYPE report-config 
	PUBLIC "-//CODE-AON//DTD Report Config//EN" 
	"http://co-de.com/aon/report-config.dtd">

<report-config>

	<!--  *********  Reservation ********* -->
	<report id="reservationList" description="Reservation list Report">
		<template path="/com/esferalia/aon/ui/pms/report/reservationList.jasper" />
		<bean key="com.esferalia.aon.pms.ProjectReservation" />
		<criteria provider="#{reservation}"/>
		<fetch-mode paginated="true" page-count="500" virtualizer-max-size="50"/>
		<params>
			<param id="REPORT_RESOURCE_BUNDLE" value="com.code.aon.common.i18n.messages" />
			<param id="company" value="#{company.obtainCompany}" />
			<param id="logoImageFile" value="#{company.getAttachAsInputStream}" />
			<param id="printHeader" value="#{company.isPrintHeader}" />
		</params>
	</report>

	<!--  *********  Reservation Input Output  ********* -->
	<report id="reservationIO" description="Reservation input-output Report">
		<template path="/com/esferalia/aon/ui/pms/report/reservationInputOuput.jasper" />
		<collection provider="#{reservationIO}"/>
		<params>
			<param id="REPORT_RESOURCE_BUNDLE" value="com.code.aon.common.i18n.messages" />
			<param id="company" value="#{company.obtainCompany}" />
			<param id="logoImageFile" value="#{company.getAttachAsInputStream}" />
			<param id="printHeader" value="#{company.isPrintHeader}" />
			<param id="hotel" value="#{reservationIO.getHotel}" />
			<param id="checkin" value="#{reservationIO.isCheckin}" />
			<param id="fromDate" value="#{reservationIO.getFromDate}" />
			<param id="toDate" value="#{reservationIO.getToDate}" />
		</params>
	</report>

	<!--  *********  Reservation Invoice liquidation  ********* -->
	<report id="reservationLiquidation" description="Reservation liquidation Report">
		<template path="/com/esferalia/aon/ui/pms/report/reservationLiquidation.jasper" />
		<collection provider="#{reservationLiquidationPrinter}"/>
		<params>
			<param id="REPORT_RESOURCE_BUNDLE" value="com.code.aon.common.i18n.messages" />
			<param id="company" value="#{company.obtainCompany}" />
			<param id="logoImageFile" value="#{company.getAttachAsInputStream}" />
			<param id="printHeader" value="#{company.isPrintHeader}" />
			<param id="reservation" value="#{reservationLiquidationPrinter.getProjectReservation}" />
		</params>
	</report>

	<!--  ********* Governess - Work planning  ********* -->
	<report id="workPlanning" description="Governess Work Planning Report">
		<template path="/com/esferalia/aon/ui/pms/report/workPlanning.jasper" />
		<collection provider="#{workPlanning}" />
		<params>
			<param id="REPORT_RESOURCE_BUNDLE" value="com.code.aon.common.i18n.messages" />
			<param id="company" value="#{company.obtainCompany}" />
			<param id="logoImageFile" value="#{company.getAttachAsInputStream}" />
			<param id="printHeader" value="#{company.isPrintHeader}" />
			<param id="hotel" value="#{workPlanning.getHotel}" />
			<param id="date" value="#{workPlanning.getDate}" />
		</params>
	</report>

	<!--  ********* Board list ********* -->
	<report id="boardList" description="Board list Report">
		<template path="/com/esferalia/aon/ui/pms/report/boardList.jasper" />
		<collection provider="#{boardList}" />
		<params>
			<param id="REPORT_RESOURCE_BUNDLE" value="com.code.aon.common.i18n.messages" />
			<param id="company" value="#{company.obtainCompany}" />
			<param id="logoImageFile" value="#{company.getAttachAsInputStream}" />
			<param id="printHeader" value="#{company.isPrintHeader}" />
			<param id="hotel" value="#{boardList.getHotel}" />
			<param id="date" value="#{boardList.getDate}" />
			<param id="pageBreak" value="#{boardList.isPageBreak}" />
		</params>
	</report>

	<!--  ********* Board Booking ********* -->
	<report id="boardBooking" description="Board Booking Report">
		<template path="/com/esferalia/aon/ui/pms/report/boardBooking.jasper" />
		<collection provider="#{boardBooking}" />
		<params>
			<param id="REPORT_RESOURCE_BUNDLE" value="com.code.aon.common.i18n.messages" />
			<param id="company" value="#{company.obtainCompany}" />
			<param id="logoImageFile" value="#{company.getAttachAsInputStream}" />
			<param id="printHeader" value="#{company.isPrintHeader}" />
			<param id="hotel" value="#{boardBooking.getHotel}" />
			<param id="fromDate" value="#{boardBooking.getFromDate}" />
			<param id="toDate" value="#{boardBooking.getToDate}" />
			<param id="boardLabels" value="#{boardBooking.getBoardLabels}" />
		</params>
	</report>

	<!--  ********* Room Booking ********* -->
	<report id="roomBooking" description="Room Booking Report">
		<template path="/com/esferalia/aon/ui/pms/report/roomBooking.jasper" />
		<collection provider="#{roomBooking}" />
		<params>
			<param id="REPORT_RESOURCE_BUNDLE" value="com.code.aon.common.i18n.messages" />
			<param id="company" value="#{company.obtainCompany}" />
			<param id="logoImageFile" value="#{company.getAttachAsInputStream}" />
			<param id="printHeader" value="#{company.isPrintHeader}" />
			<param id="items" value="#{roomBooking.getItemNames}" />
			<param id="agencies" value="#{roomBooking.getAgencyNames}" />
			<param id="fromDate" value="#{roomBooking.getFromDate}" />
			<param id="toDate" value="#{roomBooking.getToDate}" />
			<param id="showCancelled" value="#{roomBooking.isShowCancelled}" />
		</params>
	</report>

	<!--  ********* Empty Room ********* -->
	<report id="emptyRoomList" description="Empty Room Report">
		<template path="/com/esferalia/aon/ui/pms/report/emptyRoomList.jasper" />
		<collection provider="#{emptyRoom}" />
		<params>
			<param id="REPORT_RESOURCE_BUNDLE" value="com.code.aon.common.i18n.messages" />
			<param id="company" value="#{company.obtainCompany}" />
			<param id="logoImageFile" value="#{company.getAttachAsInputStream}" />
			<param id="printHeader" value="#{company.isPrintHeader}" />
			<param id="hotel" value="#{emptyRoom.getHotel}" />
			<param id="date" value="#{emptyRoom.getDate}" />
		</params>
	</report>

	<!--  ********* Hotel Guests ********* -->
	<report id="hotelGuest" description="Hotel Guests Report">
		<template path="/com/esferalia/aon/ui/pms/report/hotelGuest.jasper" />
		<collection provider="#{hotelGuest}" />
		<params>
			<param id="REPORT_RESOURCE_BUNDLE" value="com.code.aon.common.i18n.messages" />
			<param id="company" value="#{company.obtainCompany}" />
			<param id="logoImageFile" value="#{company.getAttachAsInputStream}" />
			<param id="printHeader" value="#{company.isPrintHeader}" />
			<param id="hotel" value="#{hotelGuest.getHotel}" />
			<param id="date" value="#{hotelGuest.getDate}" />
		</params>
	</report>
	
	<!--  ********* Hotel Guests ********* -->
	<report id="hotelEmailCatchment" description="Hotel Email Catchment Report">
		<collection provider="#{hotelEmailCatchment}" />
		<params>
			<param id="REPORT_RESOURCE_BUNDLE" value="com.code.aon.common.i18n.messages" />
			<param id="company" value="#{company.obtainCompany}" />
			<param id="logoImageFile" value="#{company.getAttachAsInputStream}" />
			<param id="printHeader" value="#{company.isPrintHeader}" />
			<param id="hotels" value="#{hotelEmailCatchment.getHotels}" />
			<param id="year" value="#{hotelEmailCatchment.getYear}" />
		</params>
	</report>

	<!--  *********  Sale Invoice ********* -->
	<report id="saleInvoiceHotel" description="Fee Hotel Invoice's Report Template">
		<template path="/com/esferalia/aon/ui/pms/report/saleInvoice.jasper" />
		<collection provider="#{saleInvoice}" forceRefresh="true" />
		<params>
			<param id="REPORT_RESOURCE_BUNDLE" value="com.code.aon.common.i18n.messages" />
			<param id="logoImageFile" value="#{company.getAttachAsInputStream}" />
			<param id="PriceStrategy" value="#{saleInvoice.getPriceStrategy}" />
			<param id="printHeader" value="#{company.isPrintHeader}" />
			<param id="printRecordData" value="#{company.isPrintRecordData}" />
			<param id="invoiceDetailPrinter" value="#{invoiceDetailByDeliveryPrinter.getInstance}" />
			<param id="pmsInvoicePrinter" value="#{pmsInvoicePrinter.getInstance}" />
			<param id="invoiceFooterText" value="#{companySaleInvoiceFooter.getText}" />
			<param id="companyController" value="#{saleInvoice.getCompanyController}" />
		</params>
	</report>
	
	<report id="invoicePrintHotel" description="Hotel Invoice's Report">
		<template path="/com/esferalia/aon/ui/pms/report/saleInvoice.jasper" />
		<bean key="com.code.aon.finance.Invoice" />
		<criteria provider="#{invoicePrint}"/>
		<params>
			<param id="REPORT_RESOURCE_BUNDLE" value="com.code.aon.common.i18n.messages" />
			<param id="logoImageFile" value="#{company.getAttachAsInputStream}" />
			<param id="PriceStrategy" value="#{saleInvoice.getPriceStrategy}" />
			<param id="printHeader" value="#{company.isPrintHeader}" />
			<param id="printRecordData" value="#{company.isPrintRecordData}" />
			<param id="invoiceDetailPrinter" value="#{invoiceDetailByDeliveryPrinter.getInstance}" />
			<param id="pmsInvoicePrinter" value="#{pmsInvoicePrinter.getInstance}" />
			<param id="invoiceFooterText" value="#{companySaleInvoiceFooter.getText}" />
			<param id="companyController" value="#{saleInvoice.getCompanyController}" />
		</params>
	</report>
	
</report-config>