<?xml version="1.0" encoding="ISO-8859-1"?>

<!DOCTYPE report-config 
	PUBLIC "-//CODE-AON//DTD Report Config//EN" 
	"http://co-de.com/aon/report-config.dtd">

<report-config>

	<!--  *********  Pos Shift ********* -->
	<report id="posShift" description="Pos Shift Count Report">
		<template path="/com/esferalia/aon/ui/pms/report/posShift.jasper" />
		<collection provider="#{posShift}" forceRefresh="true" />
		<params>
			<param id="REPORT_RESOURCE_BUNDLE" value="com.esferalia.aon.ui.pms.i18n.report" />
			<param id="company" value="#{company.obtainCompany}" />
			<param id="logoImageFile" value="#{company.getAttachAsInputStream}" />
			<param id="printHeader" value="#{company.isPrintHeader}" />
		</params>
	</report>

	<!--  *********  Pos Shift List ********* -->
	<report id="posShiftList" description="Pos Shift Count Report">
		<template path="/com/esferalia/aon/ui/pms/report/posShiftList.jasper" />
		<bean key="com.esferalia.aon.pms.PosShift" />
		<criteria provider="#{posShift}" />
		<params>
			<param id="REPORT_RESOURCE_BUNDLE" value="com.esferalia.aon.ui.pms.i18n.report" />
			<param id="company" value="#{company.obtainCompany}" />
			<param id="logoImageFile" value="#{company.getAttachAsInputStream}" />
			<param id="printHeader" value="#{company.isPrintHeader}" />
		</params>
	</report>

	<!--  *********  Reservation ********* -->
	<report id="reservationList" description="Reservation list Report">
		<template path="/com/esferalia/aon/ui/pms/report/reservationList.jasper" />
		<bean key="com.esferalia.aon.pms.ProjectReservation" />
		<criteria provider="#{reservation}"/>
		<params>
			<param id="REPORT_RESOURCE_BUNDLE" value="com.esferalia.aon.ui.pms.i18n.report" />
			<param id="company" value="#{company.obtainCompany}" />
			<param id="logoImageFile" value="#{company.getAttachAsInputStream}" />
			<param id="printHeader" value="#{company.isPrintHeader}" />
		</params>
	</report>

	<!--  *********  Reservation Input Output  ********* -->
	<report id="reservationIO" description="Reservation input-output Report">
		<template path="/com/esferalia/aon/ui/pms/report/reservationInputOuput.jasper" />
		<collection provider="#{reservationIO}"/>
		<params>
			<param id="REPORT_RESOURCE_BUNDLE" value="com.esferalia.aon.ui.pms.i18n.report" />
			<param id="company" value="#{company.obtainCompany}" />
			<param id="logoImageFile" value="#{company.getAttachAsInputStream}" />
			<param id="printHeader" value="#{company.isPrintHeader}" />
			<param id="hotel" value="#{reservationIO.getHotel}" />
			<param id="checkin" value="#{reservationIO.isCheckin}" />
			<param id="fromDate" value="#{reservationIO.getFromDate}" />
			<param id="toDate" value="#{reservationIO.getToDate}" />
		</params>
	</report>

	<!--  *********  Pos Closing Cash Count  ********* -->
	<report id="cashDetailCount" description="Pos closing cash count Report">
		<template path="/com/esferalia/aon/ui/pms/report/cashDetailCount.jasper" />
		<collection provider="#{cashCalculator}" />
		<params>
			<param id="REPORT_RESOURCE_BUNDLE" value="com.esferalia.aon.ui.pms.i18n.report" />
			<param id="company" value="#{company.obtainCompany}" />
			<param id="logoImageFile" value="#{company.getAttachAsInputStream}" />
			<param id="printHeader" value="#{company.isPrintHeader}" />
			<param id="posShift" value="#{cashCalculator.getPosShift}" />
			<param id="initialAmount" value="#{cashCalculator.isInitialAmount}" />
			<param id="calcTotal" value="#{cashCalculator.getCalcTotal}" />
		</params>
	</report>

	<!--  ********* Governess - Work planning  ********* -->
	<report id="workPlanning" description="Governess Work Planning Report">
		<template path="/com/esferalia/aon/ui/pms/report/workPlanning.jasper" />
		<collection provider="#{workPlanning}" />
		<params>
			<param id="REPORT_RESOURCE_BUNDLE" value="com.esferalia.aon.ui.pms.i18n.report" />
			<param id="company" value="#{company.obtainCompany}" />
			<param id="logoImageFile" value="#{company.getAttachAsInputStream}" />
			<param id="printHeader" value="#{company.isPrintHeader}" />
			<param id="hotel" value="#{workPlanning.getHotel}" />
			<param id="date" value="#{workPlanning.getDate}" />
		</params>
	</report>

	<!--  ********* Board list ********* -->
	<report id="boardList" description="Board list Report">
		<template path="/com/esferalia/aon/ui/pms/report/boardList.jasper" />
		<collection provider="#{boardList}" />
		<params>
			<param id="REPORT_RESOURCE_BUNDLE" value="com.esferalia.aon.ui.pms.i18n.report" />
			<param id="company" value="#{company.obtainCompany}" />
			<param id="logoImageFile" value="#{company.getAttachAsInputStream}" />
			<param id="printHeader" value="#{company.isPrintHeader}" />
			<param id="hotel" value="#{boardList.getHotel}" />
			<param id="date" value="#{boardList.getDate}" />
			<param id="boardPageBreak" value="#{boardList.isBoardPageBreak}" />
		</params>
	</report>

	<!--  ********* Board Booking ********* -->
	<report id="boardBooking" description="Board Booking Report">
		<template path="/com/esferalia/aon/ui/pms/report/boardBooking.jasper" />
		<collection provider="#{boardBooking}" />
		<params>
			<param id="REPORT_RESOURCE_BUNDLE" value="com.esferalia.aon.ui.pms.i18n.report" />
			<param id="company" value="#{company.obtainCompany}" />
			<param id="logoImageFile" value="#{company.getAttachAsInputStream}" />
			<param id="printHeader" value="#{company.isPrintHeader}" />
			<param id="hotel" value="#{boardBooking.getHotel}" />
			<param id="fromDate" value="#{boardBooking.getFromDate}" />
			<param id="toDate" value="#{boardBooking.getToDate}" />
			<param id="boardItems" value="#{boardBooking.getBoardItems}" />
		</params>
	</report>

	<!--  ********* Room Booking ********* -->
	<report id="roomBooking" description="Room Booking Report">
		<template path="/com/esferalia/aon/ui/pms/report/roomBooking.jasper" />
		<collection provider="#{roomBooking}" />
		<params>
			<param id="REPORT_RESOURCE_BUNDLE" value="com.esferalia.aon.ui.pms.i18n.report" />
			<param id="company" value="#{company.obtainCompany}" />
			<param id="logoImageFile" value="#{company.getAttachAsInputStream}" />
			<param id="printHeader" value="#{company.isPrintHeader}" />
			<param id="hotel" value="#{roomBooking.getHotel}" />
			<param id="agency" value="#{roomBooking.getAgency}" />
			<param id="fromDate" value="#{roomBooking.getFromDate}" />
			<param id="toDate" value="#{roomBooking.getToDate}" />
			<param id="item" value="#{roomBooking.getItem}" />
		</params>
	</report>

</report-config>