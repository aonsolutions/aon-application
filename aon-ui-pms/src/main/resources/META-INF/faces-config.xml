<faces-config version="1.2"
	xmlns="http://java.sun.com/xml/ns/javaee"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://java.sun.com/xml/ns/javaee http://java.sun.com/xml/ns/javaee/web-facesconfig_1_2.xsd">

	<application>
		<resource-bundle>
			<base-name>com.esferalia.aon.ui.pms.i18n.messages</base-name>
			<var>pmsBundle</var>
		</resource-bundle>
	</application>

	<!-- ************ COLLECTION **************** -->
	<managed-bean>
		<managed-bean-name>pmsCollections</managed-bean-name>
		<managed-bean-class>com.esferalia.aon.ui.pms.controller.PmsCollectionsController</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
	</managed-bean>
	
	<!-- ************* HOTEL ***************** -->
	<managed-bean>
		<managed-bean-name>hotel</managed-bean-name>
		<managed-bean-class>com.esferalia.aon.ui.pms.controller.HotelController</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
		<managed-property>
			<property-name>queryOnStartUP</property-name>
			<value>true</value>
		</managed-property>
		<managed-property>
			<property-name>pojo</property-name>
			<value>com.esferalia.aon.pms.Hotel</value>
		</managed-property>
		<managed-property>
			<property-name>beanName</property-name>
			<value>hotel</value>
		</managed-property>		
		<managed-property>
			<property-name>defaultOrder</property-name>
			<value>Hotel_workPlace_description</value>
		</managed-property>				
		<managed-property>
			<property-name>listenerClasses</property-name>
			<list-entries>
				<value-class>com.code.aon.ui.form.event.IControllerListener</value-class>
				<value>#{hotelControllerListener}</value>
			</list-entries>
		</managed-property>
	</managed-bean>
	
	<managed-bean>
		<managed-bean-name>hotelControllerListener</managed-bean-name>
		<managed-bean-class>com.esferalia.aon.ui.pms.event.HotelControllerListener</managed-bean-class>
		<managed-bean-scope>none</managed-bean-scope>
	</managed-bean>
	
	<!-- ************* ROOM ***************** -->
	<managed-bean>
		<managed-bean-name>room</managed-bean-name>
		<managed-bean-class>com.code.aon.ui.form.BasicController</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
		<managed-property>
			<property-name>queryOnStartUP</property-name>
			<value>true</value>
		</managed-property>
		<managed-property>
			<property-name>pojo</property-name>
			<value>com.esferalia.aon.pms.Room</value>
		</managed-property>
		<managed-property>
			<property-name>beanName</property-name>
			<value>room</value>
		</managed-property>		
		<managed-property>
			<property-name>defaultOrder</property-name>
			<value>Room_asset_name</value>
		</managed-property>				
		<managed-property>
			<property-name>listenerClasses</property-name>
			<list-entries>
				<value-class>com.code.aon.ui.form.event.IControllerListener</value-class>
				<value>#{roomSearch}</value>
				<value>#{roomControllerListener}</value>
			</list-entries>
		</managed-property>
	</managed-bean>
	
	<managed-bean>
		<managed-bean-name>roomSearch</managed-bean-name>
		<managed-bean-class>com.esferalia.aon.ui.pms.event.RoomSearchListener</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
	</managed-bean>	

	<managed-bean>
		<managed-bean-name>roomControllerListener</managed-bean-name>
		<managed-bean-class>com.esferalia.aon.ui.pms.event.RoomControllerListener</managed-bean-class>
		<managed-bean-scope>none</managed-bean-scope>
	</managed-bean>	
	
	<!-- ************* RESERVATION ***************** -->
	<managed-bean>
		<managed-bean-name>reservation</managed-bean-name>
		<managed-bean-class>com.esferalia.aon.ui.pms.controller.ProjectReservationController</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
		<managed-property>
			<property-name>pojo</property-name>
			<value>com.esferalia.aon.pms.ProjectReservation</value>
		</managed-property>
		<managed-property>
			<property-name>beanName</property-name>
			<value>reservation</value>
		</managed-property>				
		<managed-property>
			<property-name>defaultOrder</property-name>
			<value>ProjectReservation_startDate desc,ProjectReservation_project_id</value>
		</managed-property>				
		<managed-property>
			<property-name>listenerClasses</property-name>
			<list-entries>
				<value-class>com.code.aon.ui.form.event.IControllerListener</value-class>
				<value>#{reservationSearch}</value>
				<value>#{reservationScopeListener}</value>
				<value>#{reservationControllerListener}</value>
				<value>#{reservationGuestListener}</value>
				<value>#{reservationRoomListener}</value>
				<value>#{reservationServiceListener}</value>
			</list-entries>
		</managed-property>
	</managed-bean>
	
	<managed-bean>
		<managed-bean-name>reservationSearch</managed-bean-name>
		<managed-bean-class>com.esferalia.aon.ui.pms.event.ProjectReservationSearchListener</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
	</managed-bean>	
	
	<managed-bean>
		<managed-bean-name>reservationScopeListener</managed-bean-name>
		<managed-bean-class>com.code.aon.ui.config.event.ScopeFilterListener</managed-bean-class>
		<managed-bean-scope>none</managed-bean-scope>
		<managed-property>
			<property-name>aliasName</property-name>
			<value>ProjectReservation_hotel_scope_id</value>
		</managed-property>
	</managed-bean>
	
	<managed-bean>
		<managed-bean-name>reservationControllerListener</managed-bean-name>
		<managed-bean-class>com.esferalia.aon.ui.pms.event.ProjectReservationControllerListener</managed-bean-class>
		<managed-bean-scope>none</managed-bean-scope>
	</managed-bean>
	
	<managed-bean>
		<managed-bean-name>reservationGuestListener</managed-bean-name>
		<managed-bean-class>
			com.code.aon.ui.form.listener.LinesControllerListener
		</managed-bean-class>
		<managed-bean-scope>none</managed-bean-scope>
		<managed-property>
			<property-name>childBean</property-name>
			<value>reservationGuest</value>
		</managed-property>
		<managed-property>
			<property-name>aliasMap</property-name>
			<map-entries>
				<map-entry>
					<key>ProjectReservationGuest_projectReservation_id</key>
                    <value>id</value>
				</map-entry>
			</map-entries>
		</managed-property>
	</managed-bean>
	
	<managed-bean>
		<managed-bean-name>reservationRoomListener</managed-bean-name>
		<managed-bean-class>com.code.aon.ui.form.listener.LinesControllerListener</managed-bean-class>
		<managed-bean-scope>none</managed-bean-scope>
		<managed-property>
			<property-name>childBean</property-name>
			<value>reservationRoom</value>
		</managed-property>
		<managed-property>
			<property-name>aliasMap</property-name>
			<map-entries>
				<map-entry>
					<key>ProjectReservationRoom_projectReservation_id</key>
                    <value>id</value>
				</map-entry>
			</map-entries>
		</managed-property>
	</managed-bean>
	
	<managed-bean>
		<managed-bean-name>reservationServiceListener</managed-bean-name>
		<managed-bean-class>com.code.aon.ui.form.listener.LinesControllerListener</managed-bean-class>
		<managed-bean-scope>none</managed-bean-scope>
		<managed-property>
			<property-name>childBean</property-name>
			<value>reservationService</value>
		</managed-property>
		<managed-property>
			<property-name>aliasMap</property-name>
			<map-entries>
				<map-entry>
					<key>ProjectReservationService_projectReservation_id</key>
                    <value>id</value>
				</map-entry>
			</map-entries>
		</managed-property>
	</managed-bean>
	
	<!-- ************* RESERVATION GUEST ***************** -->
	<managed-bean>
		<managed-bean-name>reservationGuest</managed-bean-name>
		<managed-bean-class>com.esferalia.aon.ui.pms.controller.ProjectReservationGuestController</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
		<managed-property>
			<property-name>pojo</property-name>
			<value>com.esferalia.aon.pms.ProjectReservationGuest</value>
		</managed-property>
		<managed-property>
			<property-name>beanName</property-name>
			<value>reservationGuest</value>
		</managed-property>
		<managed-property>
			<property-name>cascadeDelete</property-name>
			<value>true</value>
		</managed-property>
		<managed-property>
			<property-name>masterControllerName</property-name>
			<value>reservation</value>
		</managed-property>
		<managed-property>
			<property-name>defaultOrder</property-name>
			<value>ProjectReservationGuest_guestIndex</value>
		</managed-property>	
		<managed-property>
			<property-name>propertyMap</property-name>
			<map-entries>
				<map-entry>
					<key>id</key>
					<value>projectReservation.id</value>
				</map-entry>
			</map-entries>
		</managed-property>
		<managed-property>
			<property-name>listenerClasses</property-name>
			<list-entries>
				<value-class>com.code.aon.ui.form.event.IControllerListener</value-class>
				<value>#{reservationGuestControllerListener}</value>
			</list-entries>
		</managed-property>
	</managed-bean>
	
	<managed-bean>
		<managed-bean-name>reservationGuestControllerListener</managed-bean-name>
		<managed-bean-class>com.esferalia.aon.ui.pms.event.ProjectReservationGuestControllerListener</managed-bean-class>
		<managed-bean-scope>none</managed-bean-scope>
	</managed-bean>
	
	<!-- ************* RESERVATION ROOM ***************** -->
	<managed-bean>
		<managed-bean-name>reservationRoom</managed-bean-name>
		<managed-bean-class>com.esferalia.aon.ui.pms.controller.ProjectReservationRoomController</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
		<managed-property>
			<property-name>pojo</property-name>
			<value>com.esferalia.aon.pms.ProjectReservationRoom</value>
		</managed-property>
		<managed-property>
			<property-name>beanName</property-name>
			<value>reservationRoom</value>
		</managed-property>
		<managed-property>
			<property-name>cascadeDelete</property-name>
			<value>true</value>
		</managed-property>
		<managed-property>
			<property-name>masterControllerName</property-name>
			<value>reservation</value>
		</managed-property>
		<managed-property>
			<property-name>defaultOrder</property-name>
			<value>ProjectReservationRoom_roomIndex</value>
		</managed-property>	
		<managed-property>
			<property-name>propertyMap</property-name>
			<map-entries>
				<map-entry>
					<key>id</key>
					<value>projectReservation.id</value>
				</map-entry>
			</map-entries>
		</managed-property>
		<managed-property>
			<property-name>listenerClasses</property-name>
			<list-entries>
				<value-class>com.code.aon.ui.form.event.IControllerListener</value-class>
				<value>#{reservationRoomControllerListener}</value>
			</list-entries>
		</managed-property>
	</managed-bean>
	
	<managed-bean>
		<managed-bean-name>reservationRoomControllerListener</managed-bean-name>
		<managed-bean-class>com.esferalia.aon.ui.pms.event.ProjectReservationRoomControllerListener</managed-bean-class>
		<managed-bean-scope>none</managed-bean-scope>
	</managed-bean>
	
	<!-- ************* RESERVATION SERVICE ***************** -->
	<managed-bean>
		<managed-bean-name>reservationService</managed-bean-name>
		<managed-bean-class>com.esferalia.aon.ui.pms.controller.ProjectReservationServiceController</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
		<managed-property>
			<property-name>pojo</property-name>
			<value>com.esferalia.aon.pms.ProjectReservationService</value>
		</managed-property>
		<managed-property>
			<property-name>beanName</property-name>
			<value>reservationService</value>
		</managed-property>
		<managed-property>
			<property-name>cascadeDelete</property-name>
			<value>true</value>
		</managed-property>
		<managed-property>
			<property-name>masterControllerName</property-name>
			<value>reservation</value>
		</managed-property>
		<managed-property>
			<property-name>defaultOrder</property-name>
			<value>ProjectReservationService_serviceIndex</value>
		</managed-property>	
		<managed-property>
			<property-name>propertyMap</property-name>
			<map-entries>
				<map-entry>
					<key>id</key>
					<value>projectReservation.id</value>
				</map-entry>
			</map-entries>
		</managed-property>
		<managed-property>
			<property-name>listenerClasses</property-name>
			<list-entries>
				<value-class>com.code.aon.ui.form.event.IControllerListener</value-class>
				<value>#{reservationServiceControllerListener}</value>
			</list-entries>
		</managed-property>
	</managed-bean>
	
	<managed-bean>
		<managed-bean-name>reservationServiceControllerListener</managed-bean-name>
		<managed-bean-class>com.esferalia.aon.ui.pms.event.ProjectReservationServiceControllerListener</managed-bean-class>
		<managed-bean-scope>none</managed-bean-scope>
	</managed-bean>
	
	<!-- ********** RESERVATION TABLE VIEWER ********** -->
	<managed-bean>
		<managed-bean-name>reservationTable</managed-bean-name>
		<managed-bean-class>com.esferalia.aon.ui.pms.controller.ReservationTableController</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
	</managed-bean>

  	<!-- =================== Hotel ================= -->
	<navigation-rule>
		<navigation-case>
			<from-outcome>hotel_list</from-outcome>
			<to-view-id>/com/esferalia/aon/ui/pms/facelet/hotel/list.xhtml</to-view-id>
		</navigation-case>
		<navigation-case>
			<from-outcome>hotel_form</from-outcome>
			<to-view-id>/com/esferalia/aon/ui/pms/facelet/hotel/form.xhtml</to-view-id>
		</navigation-case>
	</navigation-rule>

  	<!-- =================== Room ================= -->
	<navigation-rule>
		<navigation-case>
			<from-outcome>room_search</from-outcome>
			<to-view-id>/com/esferalia/aon/ui/pms/facelet/hotel/room/search.xhtml</to-view-id>
		</navigation-case>
		<navigation-case>
			<from-outcome>room_list</from-outcome>
			<to-view-id>/com/esferalia/aon/ui/pms/facelet/hotel/room/list.xhtml</to-view-id>
		</navigation-case>
		<navigation-case>
			<from-outcome>room_form</from-outcome>
			<to-view-id>/com/esferalia/aon/ui/pms/facelet/hotel/room/form.xhtml</to-view-id>
		</navigation-case>
	</navigation-rule>  

  	<!-- =================== Reservation ================= -->
	<navigation-rule>
		<navigation-case>
			<from-outcome>reservation_list</from-outcome>
			<to-view-id>/com/esferalia/aon/ui/pms/facelet/reservation/list.xhtml</to-view-id>
		</navigation-case>
		<navigation-case>
			<from-outcome>reservation_search</from-outcome>
			<to-view-id>/com/esferalia/aon/ui/pms/facelet/reservation/search.xhtml</to-view-id>
		</navigation-case>
		<navigation-case>
			<from-outcome>reservation_form</from-outcome>
			<to-view-id>/com/esferalia/aon/ui/pms/facelet/reservation/form.xhtml</to-view-id>
		</navigation-case>
	</navigation-rule>  
	
  	<!-- =================== Reservation Table ================= -->
	<navigation-rule>
		<navigation-case>
			<from-outcome>reservationTable_form</from-outcome>
			<to-view-id>/com/esferalia/aon/ui/pms/facelet/reservationTable/form.xhtml</to-view-id>
		</navigation-case>
	</navigation-rule>
	
	
</faces-config>
