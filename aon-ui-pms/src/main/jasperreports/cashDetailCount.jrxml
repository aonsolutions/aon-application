<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="saleInvoiceTemplate2" pageWidth="595" pageHeight="842" columnWidth="535" leftMargin="30" rightMargin="30" topMargin="20" bottomMargin="20">
	<property name="ireport.scriptlethandling" value="0"/>
	<property name="ireport.encoding" value="UTF-8"/>
	<property name="ireport.zoom" value="1.5"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<import value="net.sf.jasperreports.engine.*"/>
	<import value="java.util.*"/>
	<import value="net.sf.jasperreports.engine.data.*"/>
	<subDataset name="detail">
		<field name="description" class="java.lang.String"/>
		<field name="quantity" class="java.lang.Double"/>
		<field name="price" class="java.lang.Double"/>
		<field name="discountExpression" class="com.code.aon.product.util.DiscountExpression"/>
		<field name="taxableBase" class="java.lang.Double"/>
		<field name="sourceId" class="java.lang.Integer"/>
		<field name="sourceTo" class="com.code.aon.warehouse.DeliveryDetail"/>
		<variable name="invoiceTotal" class="java.lang.Double" calculation="Sum">
			<variableExpression><![CDATA[$F{taxableBase}]]></variableExpression>
		</variable>
		<group name="deliveryGroup">
			<groupExpression><![CDATA[$F{sourceTo}.getDelivery().getId()]]></groupExpression>
		</group>
	</subDataset>
	<subDataset name="tax">
		<parameter name="PriceStrategy" class="com.code.aon.product.strategy.IPriceStrategy" isForPrompting="false"/>
		<field name="taxPercent" class="java.lang.Double"/>
		<field name="taxQuota" class="java.lang.Double"/>
		<field name="surchargePercent" class="java.lang.Double"/>
		<field name="surchargeQuota" class="java.lang.Double"/>
		<field name="base" class="java.lang.Double"/>
		<field name="taxType" class="com.code.aon.config.enumeration.TaxType"/>
		<variable name="taxTotal" class="java.lang.Double" calculation="Sum">
			<variableExpression><![CDATA[($F{taxType}.ordinal() == 2?new Double($F{taxQuota}.doubleValue()*(-1)):$F{taxQuota})]]></variableExpression>
			<initialValueExpression><![CDATA[new Double(0)]]></initialValueExpression>
		</variable>
	</subDataset>
	<subDataset name="finances">
		<field name="payMethod" class="com.code.aon.config.PayMethod"/>
		<field name="bank" class="com.code.aon.config.Bank"/>
		<field name="bankAccount" class="com.code.aon.config.BankAccount"/>
		<field name="dueDate" class="java.util.Date"/>
		<field name="amount" class="java.lang.Double"/>
		<field name="negotiableDocument" class="java.lang.Boolean"/>
	</subDataset>
	<subDataset name="reservationServices">
		<field name="projectReservationService" class="com.esferalia.aon.pms.ProjectReservationService"/>
		<field name="projectReservationRoomDetail" class="com.esferalia.aon.pms.ProjectReservationRoomDetail"/>
		<field name="effectiveDate" class="java.util.Date"/>
		<field name="quantity" class="java.lang.Double"/>
		<field name="price" class="java.lang.Double"/>
		<field name="taxableBase" class="java.lang.Double"/>
		<field name="invoiceDetail" class="com.code.aon.finance.InvoiceDetail"/>
	</subDataset>
	<parameter name="printHeaders" class="java.lang.Boolean" isForPrompting="false"/>
	<parameter name="logoImageFile" class="java.io.InputStream"/>
	<parameter name="company" class="com.code.aon.company.Company" isForPrompting="false"/>
	<field name="unit" class="java.lang.Double"/>
	<field name="amount" class="java.lang.Integer"/>
	<variable name="total" class="java.lang.Double" incrementType="Column" calculation="Sum">
		<variableExpression><![CDATA[new Double($F{amount})]]></variableExpression>
		<initialValueExpression><![CDATA[0.0]]></initialValueExpression>
	</variable>
	<title>
		<band splitType="Stretch"/>
	</title>
	<pageHeader>
		<band height="79" splitType="Stretch">
			<image scaleImage="RetainShape" hAlign="Left" vAlign="Top" isUsingCache="true" onErrorType="Blank">
				<reportElement key="image-1" positionType="Float" mode="Opaque" x="21" y="1" width="105" height="75" forecolor="#000000" backcolor="#FFFFFF"/>
				<box>
					<topPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
					<leftPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
					<bottomPen lineWidth="0.0" lineColor="#000000"/>
					<rightPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
				</box>
				<graphicElement fill="Solid"/>
				<imageExpression class="java.io.InputStream"><![CDATA[$P{logoImageFile}]]></imageExpression>
			</image>
		</band>
	</pageHeader>
	<columnHeader>
		<band splitType="Stretch"/>
	</columnHeader>
	<detail>
		<band height="52" splitType="Stretch">
			<textField pattern="dd/MM/yyyy" isBlankWhenNull="false">
				<reportElement key="textField-49" mode="Opaque" x="70" y="8" width="60" height="13" forecolor="#FFFFFF" backcolor="#999999"/>
				<box leftPadding="5">
					<topPen lineWidth="0.5" lineStyle="Solid" lineColor="#000000"/>
					<leftPen lineWidth="0.5" lineStyle="Solid" lineColor="#000000"/>
					<bottomPen lineWidth="0.5" lineColor="#000000"/>
					<rightPen lineWidth="0.5" lineStyle="Solid" lineColor="#000000"/>
				</box>
				<textElement verticalAlignment="Middle">
					<font fontName="SansSerif" size="10" isBold="true" isUnderline="false" pdfFontName="Helvetica-Bold" isPdfEmbedded="false"/>
				</textElement>
				<textFieldExpression class="java.lang.String"><![CDATA[$R{aon_quantity}]]></textFieldExpression>
			</textField>
			<textField isBlankWhenNull="false">
				<reportElement key="textField-50" x="70" y="21" width="60" height="13"/>
				<box leftPadding="5">
					<topPen lineWidth="0.5" lineStyle="Solid" lineColor="#000000"/>
					<leftPen lineWidth="0.5" lineStyle="Solid" lineColor="#000000"/>
					<bottomPen lineWidth="0.5" lineColor="#000000"/>
					<rightPen lineWidth="0.5" lineStyle="Solid" lineColor="#000000"/>
				</box>
				<textElement verticalAlignment="Middle">
					<font fontName="SansSerif" size="10" isBold="false" isUnderline="false" pdfFontName="Helvetica" isPdfEmbedded="false"/>
				</textElement>
				<textFieldExpression class="java.lang.Integer"><![CDATA[$F{amount}]]></textFieldExpression>
			</textField>
			<textField pattern="###0.00" isBlankWhenNull="false">
				<reportElement key="textField-48" x="10" y="21" width="60" height="13"/>
				<box rightPadding="5">
					<topPen lineWidth="0.5" lineStyle="Solid" lineColor="#000000"/>
					<leftPen lineWidth="0.5" lineStyle="Solid" lineColor="#000000"/>
					<bottomPen lineWidth="0.5" lineColor="#000000"/>
					<rightPen lineWidth="0.5" lineStyle="Solid" lineColor="#000000"/>
				</box>
				<textElement textAlignment="Right" verticalAlignment="Middle">
					<font fontName="SansSerif" size="10" isBold="false" isUnderline="false" pdfFontName="Helvetica" isPdfEmbedded="false"/>
				</textElement>
				<textFieldExpression class="java.lang.Double"><![CDATA[$F{unit}]]></textFieldExpression>
			</textField>
			<textField isBlankWhenNull="true">
				<reportElement key="textField-47" mode="Opaque" x="10" y="8" width="60" height="13" forecolor="#FFFFFF" backcolor="#999999"/>
				<box rightPadding="5">
					<topPen lineWidth="0.5" lineStyle="Solid" lineColor="#000000"/>
					<leftPen lineWidth="0.5" lineStyle="Solid" lineColor="#000000"/>
					<bottomPen lineWidth="0.5" lineColor="#000000"/>
					<rightPen lineWidth="0.5" lineStyle="Solid" lineColor="#000000"/>
				</box>
				<textElement textAlignment="Right" verticalAlignment="Middle">
					<font fontName="SansSerif" size="10" isBold="true" isUnderline="false" pdfFontName="Helvetica-Bold" isPdfEmbedded="false"/>
				</textElement>
				<textFieldExpression class="java.lang.String"><![CDATA[""]]></textFieldExpression>
			</textField>
			<textField pattern="dd/MM/yyyy" isBlankWhenNull="false">
				<reportElement key="textField-49" mode="Opaque" x="130" y="8" width="60" height="13" forecolor="#FFFFFF" backcolor="#999999"/>
				<box leftPadding="5">
					<topPen lineWidth="0.5" lineStyle="Solid" lineColor="#000000"/>
					<leftPen lineWidth="0.5" lineStyle="Solid" lineColor="#000000"/>
					<bottomPen lineWidth="0.5" lineColor="#000000"/>
					<rightPen lineWidth="0.5" lineStyle="Solid" lineColor="#000000"/>
				</box>
				<textElement verticalAlignment="Middle">
					<font fontName="SansSerif" size="10" isBold="true" isUnderline="false" pdfFontName="Helvetica-Bold" isPdfEmbedded="false"/>
				</textElement>
				<textFieldExpression class="java.lang.String"><![CDATA[$R{aon_amount}]]></textFieldExpression>
			</textField>
			<textField pattern="###0.00" isBlankWhenNull="false">
				<reportElement key="textField-50" x="130" y="21" width="60" height="13"/>
				<box leftPadding="5">
					<topPen lineWidth="0.5" lineStyle="Solid" lineColor="#000000"/>
					<leftPen lineWidth="0.5" lineStyle="Solid" lineColor="#000000"/>
					<bottomPen lineWidth="0.5" lineColor="#000000"/>
					<rightPen lineWidth="0.5" lineStyle="Solid" lineColor="#000000"/>
				</box>
				<textElement verticalAlignment="Middle">
					<font fontName="SansSerif" size="10" isBold="false" isUnderline="false" pdfFontName="Helvetica" isPdfEmbedded="false"/>
				</textElement>
				<textFieldExpression class="java.lang.Double"><![CDATA[$F{amount}*$F{unit}]]></textFieldExpression>
			</textField>
			<textField pattern="" isBlankWhenNull="false">
				<reportElement key="textField-48" x="10" y="34" width="60" height="13"/>
				<box rightPadding="5">
					<topPen lineWidth="0.5" lineStyle="Solid" lineColor="#000000"/>
					<leftPen lineWidth="0.5" lineStyle="Solid" lineColor="#000000"/>
					<bottomPen lineWidth="0.5" lineColor="#000000"/>
					<rightPen lineWidth="0.5" lineStyle="Solid" lineColor="#000000"/>
				</box>
				<textElement textAlignment="Right" verticalAlignment="Middle">
					<font fontName="SansSerif" size="10" isBold="false" isUnderline="false" pdfFontName="Helvetica" isPdfEmbedded="false"/>
				</textElement>
				<textFieldExpression class="java.lang.String"><![CDATA[""]]></textFieldExpression>
			</textField>
			<textField isBlankWhenNull="false">
				<reportElement key="textField-50" x="70" y="34" width="60" height="13"/>
				<box leftPadding="5">
					<topPen lineWidth="0.5" lineStyle="Solid" lineColor="#000000"/>
					<leftPen lineWidth="0.5" lineStyle="Solid" lineColor="#000000"/>
					<bottomPen lineWidth="0.5" lineColor="#000000"/>
					<rightPen lineWidth="0.5" lineStyle="Solid" lineColor="#000000"/>
				</box>
				<textElement verticalAlignment="Middle">
					<font fontName="SansSerif" size="10" isBold="false" isUnderline="false" pdfFontName="Helvetica" isPdfEmbedded="false"/>
				</textElement>
				<textFieldExpression class="java.lang.String"><![CDATA[$R{aon_total}]]></textFieldExpression>
			</textField>
			<textField pattern="###0.00" isBlankWhenNull="false">
				<reportElement key="textField-50" x="130" y="34" width="60" height="13"/>
				<box leftPadding="5">
					<topPen lineWidth="0.5" lineStyle="Solid" lineColor="#000000"/>
					<leftPen lineWidth="0.5" lineStyle="Solid" lineColor="#000000"/>
					<bottomPen lineWidth="0.5" lineColor="#000000"/>
					<rightPen lineWidth="0.5" lineStyle="Solid" lineColor="#000000"/>
				</box>
				<textElement verticalAlignment="Middle">
					<font fontName="SansSerif" size="10" isBold="false" isUnderline="false" pdfFontName="Helvetica" isPdfEmbedded="false"/>
				</textElement>
				<textFieldExpression class="java.lang.Double"><![CDATA[$V{total}]]></textFieldExpression>
			</textField>
		</band>
	</detail>
	<columnFooter>
		<band splitType="Stretch"/>
	</columnFooter>
	<pageFooter>
		<band splitType="Stretch"/>
	</pageFooter>
	<summary>
