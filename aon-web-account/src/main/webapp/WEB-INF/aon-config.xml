<?xml version="1.0" encoding="UTF-8" ?>
<config
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xmlns="http://www.esferalia.com/common" >
	
	<registry:config version="1.0" xmlns:registry="http://www.esferalia.com/registry">
		<registry:rmedia 
			showSendEmail="true"
		/>
	</registry:config>

	<config:config version="1.1" xmlns:config="http://www.esferalia.com/config" >
		<config:series
			showOfferData="false"
			showSalesData="false"
			showDeliveryData="false"
			showInvoiceData="true"
			showTasData="false"
		/>
	</config:config>	

	<company:config version="1.4" xmlns:company="http://www.esferalia.com/company">
		<company:company 
			showRegistryBank="true" 
			showCompanyOtherData="true"
			showPanelTabSet="true" 
			showEInvoice="false"
			showDigitalCertificate="false"
			showDirStaff="false"
		/>
		<company:enterprise 
			showFinanceData="false" 
			showAddInfo="true"
			showDirStaff="false"
			standalone="false"
			showEnterpriseParams="false"
			showPayrollData="false"
			showPersonInSearch="false"
			showProject="false"
		/>				
	</company:config>

	<customer:config version="1.1" xmlns:customer="http://www.esferalia.com/customer">
		<customer:customer
			showOfferData="false"
			showSalesData="false"
			showDeliveryData="false" 
			showFinanceData="true" 
			showProjectData="false"
			showFinanceFeeData="false" 
			showTaxInfoData="true"
			showAccount="true"
			showTariff="false" 
			showSegment="false"
			showNote="false"
			showRelationship="false"
			showRecordData="false"
			showAddInfo="false"
			showDirStaff="false"
			showHistory="false"
		/>
	</customer:config>

	<supplier:config version="1.0" xmlns:supplier="http://www.esferalia.com/supplier">
		<supplier:supplier
			showFinanceData="true" 
			showTaxInfoData="true"
			showAccount="true"
			showSegment="false"
			showAddInfo="false"
		/>
	</supplier:config>

	<finance:config version="1.1" xmlns:finance="http://www.esferalia.com/finance">
		<finance:creditor
			showFinanceData="true" 
			showTaxInfoData="true"
			showAccount="true"
			showAddInfo="false"
			showSegment="false"
		/>
		<finance:invoice
			showWarehouseData="false" 
			showTasData="false" 
			showSendEmail="false"
		/>
	</finance:config>

	<fiscal:config version="1.0" xmlns:fiscal="http://www.esferalia.com/fiscal">
		<fiscal:fiscal
			model347Enabled="true" 
			enterpriseEnabled="false" 
		/>
	</fiscal:config>

	<webmail:config version="1.3" xmlns:webmail="http://www.esferalia.com/webmail" >
		<webmail:webmail
			connect="true"
			showDomainMailAccounts="true"
			connectDomainMailAccounts="false"
		/>
	</webmail:config>	

</config>

