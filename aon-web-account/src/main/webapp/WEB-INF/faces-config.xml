<faces-config version="1.2"
	xmlns="http://java.sun.com/xml/ns/javaee"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://java.sun.com/xml/ns/javaee http://java.sun.com/xml/ns/javaee/web-facesconfig_1_2.xsd">
	
	<application>
		<message-bundle>com.code.aon.ui.common.i18n.messages</message-bundle>
		<locale-config>
			<default-locale>es</default-locale>
			<supported-locale>en</supported-locale>
		</locale-config>
		<navigation-handler>com.code.aon.ui.audit.AuditNavigationHandler</navigation-handler>
		<resource-bundle>
			<base-name>com.code.aon.ui.web.account.i18n.messages</base-name>
			<var>appBundle</var>
		</resource-bundle>
	</application>

	<!-- *************** RESOURCE RESOLVER ***************** --> 
	<managed-bean>
		<managed-bean-name>aonResource</managed-bean-name>
		<managed-bean-class>
			com.code.aon.ui.resources.bean.ResourceResolver
		</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
		<managed-property>
			<property-name>resourceContextPath</property-name>
			<value>aon-desktop</value>
		</managed-property>
	</managed-bean>

	<!--  **** AON CONFIGURATION **** -->
	<managed-bean>
		<managed-bean-name>aonConfiguration</managed-bean-name>
		<managed-bean-class>
			com.code.aon.ui.common.controller.ConfigurationController
		</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
		<managed-property>
			<property-name>styleSheets</property-name>
			<list-entries>
				<value>#{aonResource.resolve['/aon-richCss.css']}</value>
				<value>#{aonResource.resolveLocal['/css/aon-account.css']}</value>
			</list-entries>
		</managed-property>
	</managed-bean>

	<!-- =================== Application Menu Navigation Rules ================= -->	

	<navigation-rule>
		<navigation-case>
			<from-outcome>menu_masters</from-outcome>
			<to-view-id>/facelet/menu/masters.xhtml</to-view-id> 
		</navigation-case>
		<navigation-case>
			<from-outcome>menu_entries</from-outcome>
			<to-view-id>/facelet/menu/entries.xhtml</to-view-id> 
		</navigation-case>
		<navigation-case>
			<from-outcome>menu_reports</from-outcome>
			<to-view-id>/facelet/menu/reports.xhtml</to-view-id> 
		</navigation-case>
		<navigation-case>
			<from-outcome>menu_fixed_assets</from-outcome>
			<to-view-id>/facelet/menu/fixed_assets.xhtml</to-view-id> 
		</navigation-case>
		<navigation-case>
			<from-outcome>menu_treasury</from-outcome>
			<to-view-id>/facelet/menu/treasury.xhtml</to-view-id> 
		</navigation-case>
		<navigation-case>
			<from-outcome>menu_config</from-outcome>
			<to-view-id>/facelet/menu/config.xhtml</to-view-id> 
		</navigation-case>
	</navigation-rule>
		
   	<!-- ************************************************** -->
   	<!-- ************* OPTIONAL LISTENERS ***************** -->
   	<!-- ************************************************** -->
	
	<!-- ************ ACCOUNT LISTENERS ******************* -->
	<managed-bean>
		<managed-bean-name>accountOptionalListeners</managed-bean-name>
	    <managed-bean-class>java.util.LinkedList</managed-bean-class>
		<managed-bean-scope>none</managed-bean-scope>
		<list-entries>
			<value-class>com.code.aon.ui.form.event.IControllerListener</value-class>
			<!--  aon.ui.account.bridge -->
			<value>#{accountControllerCascadeListener}</value>
		</list-entries>
	</managed-bean>

	<!-- ************ CREDITOR LISTENERS ******************* -->
	<managed-bean>
		<managed-bean-name>creditorOptionalListeners</managed-bean-name>
	    <managed-bean-class>java.util.LinkedList</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
		<list-entries>
			<value-class>com.code.aon.ui.form.event.IControllerListener</value-class>
			<!--  aon.ui.account.bridge -->
			<value>#{creditorAccount}</value>
		</list-entries>
	</managed-bean>

	<!-- ************ SUPPLIER LISTENERS ******************* -->
	<managed-bean>
		<managed-bean-name>supplierOptionalListeners</managed-bean-name>
	    <managed-bean-class>java.util.LinkedList</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
		<list-entries>
			<value-class>com.code.aon.ui.form.event.IControllerListener</value-class>
			<!--  aon.ui.account.bridge -->
			<value>#{supplierAccount}</value>
		</list-entries>
	</managed-bean>
	
	<!-- ************ CUSTOMER LISTENERS ******************* -->
	<managed-bean>
		<managed-bean-name>customerOptionalListeners</managed-bean-name>
	    <managed-bean-class>java.util.LinkedList</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
		<list-entries>
			<value-class>com.code.aon.ui.form.event.IControllerListener</value-class>
			<!--  aon.ui.account.bridge -->
			<value>#{customerAccount}</value>
		</list-entries>
	</managed-bean>

	<!-- ************ TAX LISTENERS ******************* -->
	<managed-bean>
		<managed-bean-name>taxOptionalListeners</managed-bean-name>
	    <managed-bean-class>java.util.LinkedList</managed-bean-class>
		<managed-bean-scope>none</managed-bean-scope>
		<list-entries>
			<value-class>com.code.aon.ui.form.event.IControllerListener</value-class>
			<!--  aon.ui.account.bridge -->
			<value>#{taxAccountListener}</value>
		</list-entries>
	</managed-bean>

	<!-- ************ COMPANY LISTENERS ******************* -->
	<managed-bean>
		<managed-bean-name>companyOptionalListeners</managed-bean-name>
	    <managed-bean-class>java.util.LinkedList</managed-bean-class>
		<managed-bean-scope>none</managed-bean-scope>
		<list-entries>
			<value-class>com.code.aon.ui.form.event.IControllerListener</value-class>
			<!--  aon.ui.company -->
			<value>#{companyCertificateChildListener}</value>
		</list-entries>
	</managed-bean>

	<!-- ************ BANK CONCEPT LISTENERS ******************* -->
	<managed-bean>
		<managed-bean-name>bankConceptOptionalListeners</managed-bean-name>
	    <managed-bean-class>java.util.LinkedList</managed-bean-class>
		<managed-bean-scope>none</managed-bean-scope>
		<list-entries>
			<value-class>com.code.aon.ui.form.event.IControllerListener</value-class>
			<!--  aon.ui.account.bridge -->
			<value>#{bankConceptAccountListener}</value>
		</list-entries>
	</managed-bean>

</faces-config>