<?xml version="1.0" encoding="UTF-8"?>

<!DOCTYPE bean-config 
	PUBLIC "-//CODE-AON//DTD Bean Config//EN" 
	"http://co-de.com/aon/bean-config.dtd">

<bean-config>
	
	<bean description="Listener para controlar el check de permite apuntes de cuentas">
		<pojo>com.code.aon.account.Account</pojo>
		<listeners>
	        <listener>com.code.aon.account.event.AccountBeanListener</listener>
		</listeners>
		<vetoListeners>
	        <vetoListener>com.code.aon.account.event.AccountBeanVetoListener</vetoListener>
		</vetoListeners>
	</bean>

	<bean description="Listener para escribir los acumulados por cuenta">
		<pojo>com.code.aon.account.AccountEntry</pojo>
		<listeners>
	        <listener>com.code.aon.account.event.AccountEntrySummaryBeanListener</listener>
		</listeners>
		<vetoListeners>
	        <vetoListener>com.code.aon.account.event.AccountEntrySummaryBeanVetoListener</vetoListener>
		</vetoListeners>
	</bean>

	<bean description="Listener para escribir los acumulados por cuenta">
		<pojo>com.code.aon.account.AccountEntryDetail</pojo>
		<listeners>
	        <listener>com.code.aon.account.event.AccountEntryDetailSummaryBeanListener</listener>
		</listeners>
		<vetoListeners>
	        <vetoListener>com.code.aon.account.event.AccountEntryDetailSummaryBeanVetoListener</vetoListener>
		</vetoListeners>
	</bean>

</bean-config>