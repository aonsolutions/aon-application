<faces-config xmlns="http://java.sun.com/xml/ns/javaee" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://java.sun.com/xml/ns/j2ee http://java.sun.com/xml/ns/j2ee/web-facesconfig_1_2.xsd"
	version="1.2">

   	<!-- ************* APPLICATION OPTION CONVERTER ***************** -->
	<converter>
		<converter-id>applicationOptionConverter</converter-id>
		<converter-class>com.code.aon.ui.audit.converter.ApplicationOptionConverter</converter-class>
	</converter>
	
	<!--  *************** COLLECTIONS ***************** -->

	<managed-bean>
		<managed-bean-name>auditCollections</managed-bean-name>
		<managed-bean-class>
			com.code.aon.ui.audit.controller.AuditCollectionsController
		</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
	</managed-bean>

	<!-- ************ SESSION ************** -->
	<managed-bean>
		<managed-bean-name>auditSession</managed-bean-name>
		<managed-bean-class>com.code.aon.ui.audit.controller.AuditSessionController</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
		<managed-property>
			<property-name>queryOnStartUP</property-name>
			<value>true</value>
		</managed-property>
		<managed-property>
			<property-name>pojo</property-name>
			<value>com.code.aon.audit.Session</value>
		</managed-property>
		<managed-property>
			<property-name>beanName</property-name>
			<value>auditSession</value> 
		</managed-property>
		<managed-property>
			<property-name>defaultOrder</property-name>
			<value>Session_startDate desc</value>
		</managed-property>						
		<managed-property>
			<property-name>listenerClasses</property-name>
			<list-entries>
				<value-class>com.code.aon.ui.form.event.IControllerListener</value-class>
				<value>#{auditSessionSearch}</value>
				<value>#{auditSessionActionEntryListener}</value>
			</list-entries>
		</managed-property>					
	</managed-bean>
	
	<managed-bean>
		<managed-bean-name>auditSessionActionEntryListener</managed-bean-name>
		<managed-bean-class>
			com.code.aon.ui.form.listener.LinesControllerListener
		</managed-bean-class>
		<managed-bean-scope>none</managed-bean-scope>
		<managed-property>
			<property-name>childBean</property-name>
			<value>actionEntry</value>
		</managed-property>
		<managed-property>
			<property-name>aliasMap</property-name>
			<map-entries>
				<map-entry>
					<key>ActionEntry_session_id</key>
                    <value>id</value>
				</map-entry>
			</map-entries>
		</managed-property>
	</managed-bean>		

	<managed-bean>
		<managed-bean-name>auditSessionSearch</managed-bean-name>
		<managed-bean-class>
			com.code.aon.ui.audit.event.AuditSessionSearchListener
		</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
	</managed-bean>	

	<!-- ************ SESSION MORE USED ************** -->
	<managed-bean>
		<managed-bean-name>sessionMoreUsed</managed-bean-name>
		<managed-bean-class>com.code.aon.ui.audit.controller.AuditSessionMoreUsedController</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
		<managed-property>
			<property-name>beanName</property-name>
			<value>sessionMoreUsed</value> 
		</managed-property>
	</managed-bean>

	<!-- ************ ACTION ENTRY ************** -->
	<managed-bean>
		<managed-bean-name>actionEntry</managed-bean-name>
		<managed-bean-class>com.code.aon.ui.audit.controller.ActionEntryController</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
		<managed-property>
			<property-name>queryOnStartUP</property-name>
			<value>true</value>
		</managed-property>
		<managed-property>
			<property-name>pojo</property-name>
			<value>com.code.aon.audit.ActionEntry</value>
		</managed-property>
		<managed-property>
			<property-name>beanName</property-name>
			<value>actionEntry</value> 
		</managed-property>
		<managed-property>
			<property-name>defaultOrder</property-name>
			<value>ActionEntry_executionDate</value>
		</managed-property>
		<managed-property>
			<property-name>cascadeDelete</property-name>
			<value>true</value>
		</managed-property>
		<managed-property>
			<property-name>masterControllerName</property-name>
			<value>auditSession</value>
		</managed-property>
		<managed-property>
			<property-name>propertyMap</property-name>
			<map-entries>
				<map-entry>
					<key>id</key>
					<value>session.id</value>
				</map-entry>
			</map-entries>
		</managed-property>
												
	</managed-bean>

	<!-- ************ APPLICATION OPTION CONTROLLER **************** -->
	<managed-bean>
		<managed-bean-name>appOption</managed-bean-name>
		<managed-bean-class>
			com.code.aon.ui.audit.controller.ApplicationOptionController
		</managed-bean-class>
		<managed-bean-scope>application</managed-bean-scope>
	</managed-bean>

	<!-- ************ APPLICATION OPTION CONTROLLER **************** -->
	<managed-bean>
		<managed-bean-name>audit</managed-bean-name>
		<managed-bean-class>
			com.code.aon.ui.audit.controller.AuditController
		</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
	</managed-bean>

	<!-- ************ ACTION FAVORITE CONTROLLER **************** -->
	<managed-bean>
		<managed-bean-name>actionFavorite</managed-bean-name>
		<managed-bean-class>
			com.code.aon.ui.audit.controller.ActionFavoriteController
		</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
	</managed-bean>
	
	<!-- ************ ACTION DENIED CONTROLLER **************** -->
	<managed-bean>
		<managed-bean-name>actionDenied</managed-bean-name>
		<managed-bean-class>
			com.code.aon.ui.audit.controller.ActionDeniedController
		</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
	</managed-bean>	
	
	<!-- ************ WEB MAP CONTROLLER **************** -->
	<managed-bean>
		<managed-bean-name>webMap</managed-bean-name>
		<managed-bean-class>
			com.code.aon.ui.audit.controller.WebMapController
		</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
	</managed-bean>	

	<!-- **************** AuditDomainChangeListener **************  -->
	<managed-bean>
		<managed-bean-name>auditDomainChangeListener</managed-bean-name>
		<managed-bean-class>com.code.aon.ui.audit.domain.AuditDomainChangeListener</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
	</managed-bean>
	
	<!-- =================== Action ================= -->	
	<navigation-rule>
		<navigation-case>
			<from-outcome>actionFavorite</from-outcome>
			<to-view-id>/com/code/aon/ui/audit/facelet/action/favorite.xhtml</to-view-id>
		</navigation-case>
		<navigation-case>
			<from-outcome>webMap</from-outcome>
			<to-view-id>/com/code/aon/ui/audit/facelet/shared/webMap.xhtml</to-view-id>
		</navigation-case>
	</navigation-rule>		

	<!-- =================== Session ================= -->	
	<navigation-rule>
		<navigation-case>
			<from-outcome>auditSession_list</from-outcome>
			<to-view-id>/com/code/aon/ui/audit/facelet/auditSession/list.xhtml</to-view-id>
		</navigation-case>
		<navigation-case>
			<from-outcome>auditSession_form</from-outcome>
			<to-view-id>/com/code/aon/ui/audit/facelet/auditSession/form.xhtml</to-view-id>
		</navigation-case>
		<navigation-case>
			<from-outcome>auditSession_search</from-outcome>
			<to-view-id>/com/code/aon/ui/audit/facelet/auditSession/search.xhtml</to-view-id>
		</navigation-case>
		<navigation-case>
			<from-outcome>auditSession_moreUsed</from-outcome>
			<to-view-id>/com/code/aon/ui/audit/facelet/auditSession/moreUsed.xhtml</to-view-id>
		</navigation-case>		
	</navigation-rule>		
	
</faces-config>