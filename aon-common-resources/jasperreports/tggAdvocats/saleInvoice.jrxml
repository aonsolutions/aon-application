		<variable name="taxTotal" class="java.lang.Double" calculation="Sum">
			<variableExpression><![CDATA[($F{taxType}.ordinal() == 2?new Double($F{taxQuota}.doubleValue()*(-1)):$F{taxQuota})]]></variableExpression>
			<initialValueExpression><![CDATA[new Double(0)]]></initialValueExpression>
		</variable>
		<variable name="invoiceTotal" class="java.lang.Double">
			<variableExpression><![CDATA[$F{base}+$F{taxQuota}]]></variableExpression>
			<initialValueExpression><![CDATA[$F{base}+$F{taxQuota}]]></initialValueExpression>
		</variable>
		<variable name="totalAmount" class="java.lang.Double">
			<variableExpression><![CDATA[$V{invoiceTotal} +
($P{prepaymentTotal}!=null?$P{prepaymentTotal}:0.0) -
($P{advanceTotal}!=null?$P{advanceTotal}:0.0)]]></variableExpression>
			<initialValueExpression><![CDATA[$V{invoiceTotal} +
($P{prepaymentTotal}!=null?$P{prepaymentTotal}:0.0) -
($P{advanceTotal}!=null?$P{advanceTotal}:0.0)]]></initialValueExpression>
		</variable>
		<variable name="DoubleFormater" class="java.text.DecimalFormat" resetType="None">
			<variableExpression><![CDATA[new java.text.DecimalFormat("#,##0.00;-#,##0.00")]]></variableExpression>
			<initialValueExpression><![CDATA[new java.text.DecimalFormat("#,##0.00;-#,##0.00")]]></initialValueExpression>
