		<field name="item" class="com.code.aon.product.Item"/>
		<variable name="invoiceTotal" class="java.lang.Double" calculation="Sum">
			<variableExpression><![CDATA[$F{taxableBase}]]></variableExpression>
		</variable>
		<variable name="isService" class="java.lang.Boolean">
			<variableExpression><![CDATA[$F{item}.getProduct().getType()==com.code.aon.product.enumeration.ProductType.SERVICE]]></variableExpression>
		</variable>
		<filterExpression><![CDATA[$V{isService}]]></filterExpression>
		<group name="deliveryGroup">
			<groupExpression><![CDATA[$F{sourceTo}.getReferenceCode()]]></groupExpression>
		</group>
	</subDataset>
	<subDataset name="tax">
		<parameter name="PriceStrategy" class="com.code.aon.product.strategy.IPriceStrategy" isForPrompting="false"/>
		<parameter name="prepaymentTotal" class="java.lang.Double"/>
		<parameter name="expensesTotal" class="java.lang.Double"/>
		<parameter name="advanceTotal" class="java.lang.Double"/>
		<field name="taxPercent" class="java.lang.Double"/>
		<field name="taxQuota" class="java.lang.Double"/>
		<field name="surchargePercent" class="java.lang.Double"/>
		<field name="surchargeQuota" class="java.lang.Double"/>
		<field name="base" class="java.lang.Double"/>
		<field name="taxType" class="com.code.aon.config.enumeration.TaxType"/>
		<variable name="taxTotal" class="java.lang.Double" calculation="Sum">
			<variableExpression><![CDATA[($F{taxType}.ordinal() == 2?new Double($F{taxQuota}.doubleValue()*(-1)):$F{taxQuota})]]></variableExpression>
			<initialValueExpression><![CDATA[new Double(0)]]></initialValueExpression>
		</variable>
		<variable name="invoiceTotal" class="java.lang.Double">
			<variableExpression><![CDATA[$F{base}+$F{taxQuota}]]></variableExpression>
			<initialValueExpression><![CDATA[$F{base}+$F{taxQuota}]]></initialValueExpression>
		</variable>
		<variable name="totalAmount" class="java.lang.Double">
			<variableExpression><![CDATA[$V{invoiceTotal} +
($P{prepaymentTotal}!=null?$P{prepaymentTotal}:0.0) -
($P{advanceTotal}!=null?$P{advanceTotal}:0.0)]]></variableExpression>
			<initialValueExpression><![CDATA[$V{invoiceTotal} +
($P{prepaymentTotal}!=null?$P{prepaymentTotal}:0.0) -
($P{advanceTotal}!=null?$P{advanceTotal}:0.0)]]></initialValueExpression>
		</variable>
	</subDataset>
