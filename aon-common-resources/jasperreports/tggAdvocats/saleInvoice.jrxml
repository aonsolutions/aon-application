"a la cuenta corriente número " +
(($F{bankAccount}!=null && !$F{bankAccount}.toString().isEmpty())?
($F{negotiableDocument}?$F{bankAccount}.getMaskedIban():$F{bankAccount}.toString()):("")) +
", abierta a nombre de " + $P{company}.getName() + ", o bien " +
"mediante cheque nominativo."]]></textFieldExpression>
