	<subDataset name="tax" uuid="32eaae65-0554-4d9b-bc9e-76d3927233cc">
		<parameter name="PriceStrategy" class="com.code.aon.product.strategy.IPriceStrategy" isForPrompting="false"/>
		<parameter name="prepaymentTotal" class="java.lang.Double"/>
		<parameter name="expensesTotal" class="java.lang.Double"/>
		<parameter name="advanceTotal" class="java.lang.Double"/>
		<field name="taxPercent" class="java.lang.Double"/>
