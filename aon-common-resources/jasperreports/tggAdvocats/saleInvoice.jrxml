				<textFieldExpression><![CDATA[($P{printName}.name().equals( "LEFT_SIDE" ) ? $P{company}.getName() : "")
+ (new Boolean($P{printName}.name().equals( "LEFT_SIDE" ) && $P{printRecordData} && $P{recordData}!=null) ? ", " : "")
+ ( new Boolean($P{printRecordData} && $P{recordData}!=null) ?
    ($P{recordData}.getRegistration().isEmpty()?"":$P{recordData}.getRegistration())
    + ($P{recordData}.getVolume().isEmpty()?"":", Tomo " + $P{recordData}.getVolume())
    + ($P{recordData}.getSection().isEmpty()?"":", Sección " + $P{recordData}.getSection())
    + ($P{recordData}.getPage().isEmpty()?"":", Folio " + $P{recordData}.getPage())
