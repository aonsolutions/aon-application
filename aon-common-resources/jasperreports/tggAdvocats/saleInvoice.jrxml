		<variable name="invoiceTotal" class="java.lang.Double" calculation="Sum">
			<variableExpression><![CDATA[$F{taxableBase}]]></variableExpression>
		</variable>
		<variable name="isExpense" class="java.lang.Boolean">
			<variableExpression><![CDATA[$F{item}.getProduct().getType()==com.code.aon.product.enumeration.ProductType.COMMERCIAL_PRODUCT]]></variableExpression>
		</variable>
		<variable name="totalToMap" class="java.lang.String" incrementType="Report">
			<variableExpression><![CDATA[$P{totalValue}.put("total_expenses", $V{invoiceTotal} )]]></variableExpression>
		</variable>
		<filterExpression><![CDATA[$V{isExpense}]]></filterExpression>
		<group name="deliveryGroup">
			<groupExpression><![CDATA[$F{sourceTo}.getReferenceCode()]]></groupExpression>
		</group>
	</subDataset>
