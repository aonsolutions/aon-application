	<subDataset name="detailServices">
		<parameter name="totalBase" class="java.lang.Double">
			<defaultValueExpression><![CDATA[$V{invoiceTotal}]]></defaultValueExpression>
		</parameter>
		<field name="description" class="java.lang.String"/>
		<field name="quantity" class="java.lang.Double"/>
		<field name="price" class="java.lang.Double"/>
