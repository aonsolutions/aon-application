<?xml version="1.0"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">

	<parent>
		<groupId>com.code.aon</groupId>
		<artifactId>aon.parent</artifactId>
		<version>6.14.1</version>
	</parent>

	<modelVersion>4.0.0</modelVersion>
	<groupId>com.code.aon</groupId>
	<artifactId>aon-common-resources</artifactId>
	<version>6.14.1</version>
	<packaging>pom</packaging>
	<description>Plantillas de impresion (jasper).</description>
	<name>AON COMMON TEMPLATES</name>

	<properties>
		<maven.build.timestamp.format>dd/MM/yyyy</maven.build.timestamp.format>
	</properties>

	<scm>
		<developerConnection>scm:svn:http://dev.esferalia.com/repos/aon-application/releases/6.14.x/aon.web.parent</developerConnection>
		<connection>scm:svn:http://dev.esferalia.com/repos/aon-application/releases/6.14.x/aon.web.parent</connection>
		<url>scm:svn:http://dev.esferalia.com/repos/aon-application/releases/6.14.x/aon.web.parent</url>
	</scm>

	<build>
		<plugins>
			<plugin>
				<groupId>org.codehaus.mojo</groupId>
				<artifactId>buildnumber-maven-plugin</artifactId>
				<version>1.0-beta-4</version>
				<executions>
					<execution>
						<phase>validate</phase>
						<goals>
							<goal>create</goal>
						</goals>
					</execution>
				</executions>
				<configuration>
					<doCheck>true</doCheck>
					<doUpdate>true</doUpdate>
				</configuration>
			</plugin>
		</plugins>
	</build>

	<dependencies>
		<dependency>
			<groupId>izenpe</groupId>
			<artifactId>izenpesigner-applet</artifactId>
			<version>1.0</version>
		</dependency>
	</dependencies>

	<profiles>
		<profile>
			<id>rpm-release</id>
			<activation>
				<property>
					<name>rpm.release</name>
					<value>true</value>
				</property>
			</activation>
			<build>
				<plugins>

					<!-- Para construir el RPM -->
					<plugin>
						<groupId>org.codehaus.mojo</groupId>
						<artifactId>rpm-maven-plugin</artifactId>
						<version>2.0.1</version>
						<extensions>true</extensions>

						<executions>
							<execution>
								<goals>
									<goal>attached-rpm</goal>
								</goals>
							</execution>

						</executions>

						<configuration>
							<group>Applications/Aon</group>
							<release>${buildNumber}</release>
							<copyright>2009, esferalia Networks S.A</copyright>
							<requires>
								<require>aon-directory-client &gt;= 5.0.0-4</require>
							</requires>
							<mappings>
								<mapping>
									<filemode>755</filemode>
									<username>jboss</username>
									<groupname>jboss</groupname>
									<directory>/home/COMMON-RESOURCES/aon-report</directory>
									<sources>
										<source>
											<location>templates</location>
										</source>
									</sources>
								</mapping>
								<mapping>
									<filemode>755</filemode>
									<username>jboss</username>
									<groupname>jboss</groupname>
									<directory>/home/COMMON-RESOURCES/aon-ui-sign</directory>
									<sources>
                                                                                <softlinkSource>
                                                                                        <location>/home/COMMON-RESOURCES/aon-ui-sign/izenpesigner-applet-1.0.jar</location>
                                                                                        <destination>izenpesigner-applet.jar</destination>
                                                                                </softlinkSource>
									</sources>
									<dependency>
										<includes>
											<include>izenpe:izenpesigner-applet:1.0</include>
										</includes>
									</dependency>
								</mapping>
							</mappings>
							<postinstallScriptlet>
								<scriptFile>src/main/scripts/postinstall</scriptFile>
								<fileEncoding>utf-8</fileEncoding>
							</postinstallScriptlet>
						</configuration>
					</plugin>
				</plugins>
			</build>
		</profile>
	</profiles>
</project>
 
