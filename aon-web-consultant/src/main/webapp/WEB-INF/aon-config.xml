<?xml version="1.0" encoding="UTF-8" ?>
<config
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.esferalia.com/finance finance.xsd"
	xmlns="http://www.esferalia.com/config" >

	<registry:config version="1.0" xmlns:registry="http://www.esferalia.com/registry">
		<registry:rmedia 
			showSendEmail="true" 
		/>
	</registry:config>
		
	<company:config version="1.0" xmlns:company="http://www.esferalia.com/company">
		<company:company 
			showRegistryBank="true" 
			showCompanyOtherData="true"
			showPanelTabSet="true" 
			showEInvoice="true"			
			showDigitalCertificate="true"
		/>
	</company:config>

	<customer:config version="1.0" xmlns:customer="http://www.esferalia.com/customer">
		<customer:customer
			showDeliveryData="false" 
			showFinanceData="true" 
			showProjectData="true"
			showFinanceFeeData="true" 
			showTaxInfoData="true"
			showAccount="true"
			showTariff="false" 
			showSegment="true"
			showNote="true" 
			showRelationship="true" 
			showRecordData="true" 
			showAddInfo="true"
			showDirStaff="true"
			showHistory="true"
		/>
	</customer:config>

	<supplier:config version="1.0" xmlns:supplier="http://www.esferalia.com/supplier">
		<supplier:supplier
			showFinanceData="true" 
			showAccount="true"
			showSegment="true"
			showTaxInfoData="true"
			showAddInfo="true"
		/>
	</supplier:config>

	<finance:config version="1.0" xmlns:finance="http://www.esferalia.com/finance">
		<finance:creditor
			showFinanceData="true" 
			showTaxInfoData="true"
			showAccount="true"
			showSegment="true"
			showAddInfo="true"
		/>
		<finance:invoice
			showWarehouseData="false" 
		/>
	</finance:config>

	<product:config version="1.0" xmlns:product="http://www.esferalia.com/product">
		<product:catalogue
			showEcommerceData="false"
		/>
		<product:product
			showBarcode="false"
			showType="false"
			showBrand="false"
			showStock="false"
			showSuppliers="false"
			showAccount="true"
			showAttachment="false"
			showEcommerceData="false"
			showHistory="true"
		/>
 		<product:productCategory
 			showCategoryGroup="false"
 		/>
	</product:config>

</config>
