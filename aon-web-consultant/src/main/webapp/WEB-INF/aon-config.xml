<?xml version="1.0" encoding="UTF-8" ?>
<config
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xmlns="http://www.esferalia.com/common" >

	<registry:config version="1.0" xmlns:registry="http://www.esferalia.com/registry">
		<registry:rmedia 
			showSendEmail="true" 
		/>
	</registry:config>
		
	<config:config version="1.1" xmlns:config="http://www.esferalia.com/config" >
		<config:series
			showOfferData="false"
			showSalesData="false"
			showDeliveryData="false"
			showInvoiceData="true"
			showTasData="false"
		/>
	</config:config>	

	<company:config version="1.5" xmlns:company="http://www.esferalia.com/company">
		<company:company 
			showRegistryBank="true" 
			showCompanyOtherData="true"
			showPanelTabSet="true" 
			showEInvoice="true"			
			showDigitalCertificate="true"
			showDirStaff="false"
			showSaleInvoiceReportParams="true"
		/>
		<company:enterprise 
			showFinanceData="false" 
			showAddInfo="true"
			showDirStaff="false"
			standalone="false"
			showEnterpriseParams="false"
			showPayrollData="false"
			showPersonInSearch="false"
			showProject="false"
		/>				
	</company:config>

	<customer:config version="1.1" xmlns:customer="http://www.esferalia.com/customer">
		<customer:customer
			showOfferData="false"
			showSalesData="false"
			showDeliveryData="false" 
			showFinanceData="true" 
			showProjectData="true"
			showFinanceFeeData="true" 
			showTaxInfoData="true"
			showAccount="true"
			showTariff="false" 
			showSegment="true"
			showNote="true" 
			showRelationship="true" 
			showRecordData="true" 
			showAddInfo="true"
			showDirStaff="true"
			showHistory="true"
			showAbsence="false"
			showLoan="false"
			showCourse="false"			
		/>
	</customer:config>

	<supplier:config version="1.0" xmlns:supplier="http://www.esferalia.com/supplier">
		<supplier:supplier
			showFinanceData="true" 
			showTaxInfoData="true"
			showAccount="true"
			showSegment="true"
			showAddInfo="true"
		/>
	</supplier:config>

	<finance:config version="1.1" xmlns:finance="http://www.esferalia.com/finance">
		<finance:creditor
			showFinanceData="true" 
			showTaxInfoData="true"
			showAccount="true"
			showSegment="true"
			showAddInfo="true"
		/>
		<finance:invoice
			showWarehouseData="false" 
			showTasData="false" 
			showSendEmail="true"
		/>
	</finance:config>

	<product:config version="1.3" xmlns:product="http://www.esferalia.com/product">
		<product:catalogue
			showEcommerceData="false"
		/>
		<product:product
			showBarcode="false"
			showType="false"
			showBrand="false"
			showSalesPrice="false"
			showStock="false"
			showTariff="false"
			showCatalogues="false"
			showComposition="false"
			showAlternatives="false"
			showSuppliers="false"
			showAccount="true"
			showAddInfo="true"
			showAttachment="false"
			showEcommerceData="false"
			showHistory="true"
		/>
 		<product:productCategory
 			showCategoryGroup="false"
 		/>
	</product:config>

	<webmail:config version="1.3" xmlns:webmail="http://www.esferalia.com/webmail" >
		<webmail:webmail
			connect="true"
			showDomainMailAccounts="true"
			connectDomainMailAccounts="false"
		/>
	</webmail:config>	

</config>
