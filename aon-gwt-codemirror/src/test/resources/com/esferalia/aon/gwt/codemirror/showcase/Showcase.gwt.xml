<?xml version="1.0"?>
<module rename-to="codemirrorshowcase">
	<!-- Inherit the core Web Toolkit stuff. -->
	<inherits name="com.google.gwt.user.User" />
	<!-- Inherit the default GWT style sheet. You can change -->
	<!-- the theme of your GWT application by uncommenting -->
	<!-- any one of the following lines. -->
	<inherits name="com.google.gwt.user.theme.standard.Standard" />

	<!-- <inherits name="com.google.gwt.user.theme.chrome.Chrome"/> -->
	<!-- <inherits name="com.google.gwt.user.theme.dark.Dark"/> -->
	<!-- Other module inherits -->
	<inherits name="com.google.gwt.resources.Resources" />

	<inherits name="com.esferalia.aon.gwt.codemirror.CodeMirror" />

	<!-- Inherit the default GWT style sheet.  You can change       -->
	<!-- the theme of your GWT application by uncommenting          -->
	<!-- any one of the following lines.                            -->
	<inherits name='com.google.gwt.user.theme.clean.Clean' />
	<!-- <inherits name='com.google.gwt.user.theme.standard.Standard'/> -->
	<!--  <inherits name='com.google.gwt.user.theme.chrome.Chrome'/> -->
	<!-- <inherits name='com.google.gwt.user.theme.dark.Dark'/>     -->


	<!-- c-like languages mode 
	<script src="codemirror/mode/clike.js" />
	-->

	<!-- showing autocompletion hints 
	<script src="codemirror/addon/hint/show-hint.js" />
	-->

	<!-- matching brackets to be highlighted whenever the cursor is next to 
		them 
	<script src="codemirror/addon/edit/matchbrackets.js" />
	-->

	<script src="codemirror/lib/codemirror-compressed.js" />

	<!-- stylesheets eclipse them -->
	<stylesheet src="codemirror/theme/eclipse.css"/>
	
	<!-- stylesheets aon them -->
	<stylesheet src="codemirror/theme/aon.css"/>

	<!-- Specify the app entry point class. -->
	<entry-point
		class="com.esferalia.aon.gwt.codemirror.showcase.client.Showcase" />

	<set-property name="user.agent" value="gecko1_8" />

</module>

