<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<ui:UiBinder xmlns:ui='urn:ui:com.google.gwt.uibinder'
	xmlns:g='urn:import:com.google.gwt.user.client.ui'
	xmlns:d="urn:import:com.google.gwt.user.datepicker.client"
	xmlns:aon='urn:import:com.esferalia.aon.gwt.common.client.widget'
	xmlns:cell='urn:import:com.google.gwt.user.cellview.client'>

	<ui:with type="com.esferalia.aon.gwt.common.client.i18n.CommonMessages"
		field="msg"></ui:with>
	<ui:with type="com.esferalia.aon.gwt.common.client.css.AonResources"
		field="aonResources"></ui:with>


	<g:ScrollPanel styleName="{aonResources.css.aonScrollArea}">
		<g:HTMLPanel styleName="{aonResources.css.aonFiscalContainer}">
			<g:HTMLPanel ui:field="basePanel" styleName="aon-width-all">
				<table class="{aonResources.css.aonWidthAll}">
				
					<!-- DATOS PRODUCTO -->
					
					<tr>
						<td>
							<div class="{aonResources.css.aonGroup}">
								<div class="{aonResources.css.aonGroupTitle}">
									<g:InlineLabel text="Datos Producto" />
								</div>
								<div class="{aonResources.css.aonGroupBody}">
									<g:FlexTable ui:field="productData" styleName="{aonResources.css.aonWidthAll}"></g:FlexTable>
								</div>
							</div>
						</td>
					</tr>
				
					<!-- DATOS TRANSPORTE -->
					
					<tr>
						<td>
							<div class="{aonResources.css.aonGroup}">
								<div class="{aonResources.css.aonGroupTitle}">
									<g:InlineLabel text="Datos Transporte" />
								</div>
								<div class="{aonResources.css.aonGroupBody}">
									<g:FlexTable ui:field="transportData" styleName="{aonResources.css.aonWidthAll}"></g:FlexTable>
								</div>
							</div>
						</td>
					</tr>
					
					<!-- ANALISIS CALIDAD -->
					
					<tr>
						<td>
							<div class="{aonResources.css.aonGroup}">
								<div class="{aonResources.css.aonGroupTitle}">
									<g:InlineLabel text="Analisis Calidad" />
								</div>
								<div class="{aonResources.css.aonGroupBody}">
									<g:FlexTable ui:field="qualityTest" styleName="{aonResources.css.aonWidthAll}"></g:FlexTable>
								</div>
							</div>
						</td>
					</tr>
					
					<!-- CONTROL CALIBRE -->
					<tr>
						<td>
							<div class="{aonResources.css.aonGroup}">
								<div class="{aonResources.css.aonGroupTitle}">
									<g:InlineLabel text="Control Calibres" />
								</div>
								<div class="{aonResources.css.aonGroupBody}">
									<g:FlexTable ui:field="caliberControl" styleName="{aonResources.css.aonWidthAll}"></g:FlexTable>
								</div>
							</div>
						</td>
					</tr>
					
					<!-- CONTROL DEFECTOS 
					<tr>
						<td>
							<div class="{aonResources.css.aonGroup}">
								<div class="{aonResources.css.aonGroupTitle}">
									<g:InlineLabel text="Control Defectos" />
								</div>
								<div class="{aonResources.css.aonGroupBody}">
									<g:FlexTable ui:field="defectControl" styleName="{aonResources.css.aonWidthAll}"></g:FlexTable>
								</div>
							</div>
						</td>
					</tr>
					-->
					<!-- OBSERVACIONES -->
					<tr>
						<td>
							<div class="{aonResources.css.aonGroup}">
								<div class="{aonResources.css.aonGroupTitle}">
									<g:InlineLabel text="Observaciones" />
								</div>
								<div class="{aonResources.css.aonGroupBody}">
									<g:FlexTable ui:field="observation" styleName="{aonResources.css.aonWidthAll}"></g:FlexTable>
								</div>
							</div>
						</td>
					</tr>
				</table>
				<g:FlexTable ui:field="table"
					styleName="{aonResources.css.aonWidthAll} {aonResources.css.aonMarginTop}" />
			</g:HTMLPanel>
		</g:HTMLPanel>
	</g:ScrollPanel>


</ui:UiBinder>
