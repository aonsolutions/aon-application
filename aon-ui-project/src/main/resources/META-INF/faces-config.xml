<faces-config version="1.2"
	xmlns="http://java.sun.com/xml/ns/javaee"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://java.sun.com/xml/ns/javaee http://java.sun.com/xml/ns/javaee/web-facesconfig_1_2.xsd">

	<!--  *************** COLLECTIONS ***************** -->
	<managed-bean>
		<managed-bean-name>projectCollections</managed-bean-name>
		<managed-bean-class>
			com.code.aon.ui.project.controller.ProjectCollectionsController
		</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
	</managed-bean>
	
	<!-- ************* CUSTOMER PROJECT LISTENER ***************** -->
	<managed-bean>
		<managed-bean-name>customerProjectListener</managed-bean-name>
		<managed-bean-class>
			com.code.aon.ui.form.listener.MasterControllerListener
		</managed-bean-class>
		<managed-bean-scope>none</managed-bean-scope>
		<managed-property>
			<property-name>childBean</property-name>
			<value>customerProject</value>
		</managed-property>
		<managed-property>
			<property-name>aliasMap</property-name>
			<map-entries>
				<map-entry>
					<key>Project_registry_id</key>
                    <value>id</value>
				</map-entry>
			</map-entries>
		</managed-property>
	</managed-bean>

	<!-- ************* CUSTOMER PROJECT ***************** -->
	<managed-bean>
		<managed-bean-name>customerProject</managed-bean-name>
		<managed-bean-class>com.code.aon.ui.form.LinesController</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
		<managed-property>
			<property-name>queryOnStartUP</property-name>
			<value>true</value>
		</managed-property>
		<managed-property>
			<property-name>beanName</property-name>
			<value>customerProject</value>
		</managed-property>
		<managed-property>
			<property-name>pojo</property-name>
			<value>com.code.aon.project.Project</value>
		</managed-property>
		<managed-property>
			<property-name>defaultExpressions</property-name>
			<map-entries>
				<map-entry>
					<key>Project_reservation</key>
					<value>0</value>
				</map-entry>
			</map-entries>
		</managed-property>		
		<managed-property>
			<property-name>cascadeDelete</property-name>
			<value>true</value>
		</managed-property>
		<managed-property>
			<property-name>masterControllerName</property-name>
			<value>customer</value>
		</managed-property>
		<managed-property>
			<property-name>propertyMap</property-name>
			<map-entries>
				<map-entry>
					<key>id</key>
					<value>registry.id</value>
				</map-entry>
			</map-entries>
		</managed-property>
		<managed-property>
			<property-name>listenerClasses</property-name>
			<list-entries>
				<value-class>com.code.aon.ui.form.event.IControllerListener</value-class>
				<value>#{customerProjectControllerListener}</value>
			</list-entries>
		</managed-property>
   	</managed-bean>
	
	<managed-bean>
		<managed-bean-name>customerProjectControllerListener</managed-bean-name>
		<managed-bean-class>com.code.aon.ui.project.controller.event.RegistryProjectControllerListener</managed-bean-class>
		<managed-bean-scope>none</managed-bean-scope>
		<managed-property>
			<property-name>backAction</property-name>
			<value>customer_form</value>
		</managed-property>
	</managed-bean>
	
	
	<!-- ************* PROJECT ***************** -->
	<managed-bean>
		<managed-bean-name>project</managed-bean-name>
		<managed-bean-class>
			com.code.aon.ui.project.controller.ProjectController
		</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
		<managed-property>
			<property-name>pojo</property-name>
			<value>com.code.aon.project.Project</value>
		</managed-property>
		<managed-property>
			<property-name>beanName</property-name>
			<value>project</value>
		</managed-property>
		<managed-property>
	         <property-name>defaultOrder</property-name>
    	     <value>Project_name</value>
      	</managed-property>
		<managed-property>
			<property-name>listenerClasses</property-name>
			<list-entries>
				<value-class>com.code.aon.ui.form.event.IControllerListener</value-class>
				<value>#{projectSearchListener}</value>
				<value>#{projectControllerListener}</value>
				<value>#{projectActivityListener}</value>
				<value>#{projectAttachChildListener}</value>
			</list-entries>
		</managed-property>
	</managed-bean>
	
	<managed-bean>
		<managed-bean-name>projectControllerListener</managed-bean-name>
	    <managed-bean-class>com.code.aon.ui.project.controller.event.ProjectControllerListener</managed-bean-class>
		<managed-bean-scope>none</managed-bean-scope>
	</managed-bean>	

