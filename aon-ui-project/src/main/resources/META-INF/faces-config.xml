    <!-- =================== Project ================= --> 	
	<navigation-rule>
		<navigation-case>
			<from-outcome>project_list</from-outcome>
			<to-view-id>/com/code/aon/ui/project/facelet/project/list.xhtml</to-view-id>
		</navigation-case>
		<navigation-case>
			<from-outcome>project_form</from-outcome>
			<to-view-id>/com/code/aon/ui/project/facelet/project/form.xhtml</to-view-id>
		</navigation-case>
		<navigation-case>
			<from-outcome>project_search</from-outcome>
			<to-view-id>/com/code/aon/ui/project/facelet/project/search.xhtml</to-view-id>
		</navigation-case>
	</navigation-rule>	
    <!-- =================== Project Type ================= --> 	
	<navigation-rule>
		<navigation-case>
			<from-outcome>projectType_list</from-outcome>
