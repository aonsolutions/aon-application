	<!--  **********************************************************
						      TASK INBOX
		  ********************************************************** -->
	<report id="taskInbox" description="Task Inbox List">
		<template path="/com/code/aon/ui/project/report/taskInbox.jasper"/>
		<bean key="com.code.aon.project.Task" />
		<criteria provider="#{task}"/>
		<params>
			<param id="REPORT_RESOURCE_BUNDLE" value="com.code.aon.ui.project.i18n.report" />
			<param id="company" value="#{company.obtainCompany}" />
			<param id="logoImageFile" value="#{company.getAttachAsInputStream}" />
		</params>
	</report>

