<?xml version="1.0"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
	<parent>
		<groupId>com.code.aon</groupId>
		<artifactId>aon.parent</artifactId>
		<version>6.20-SNAPSHOT</version>
	</parent>
	<modelVersion>4.0.0</modelVersion>
	<groupId>com.esferalia.aon</groupId>
	<artifactId>aon.pms.api</artifactId>
	<version>6.20-SNAPSHOT</version>
	<name>AON PMS API</name>
	<build>
		<plugins>
			<plugin>
				<groupId>org.codehaus.mojo</groupId>
				<artifactId>jaxws-maven-plugin</artifactId>
				<executions>
					<execution>
						<goals>
							<goal>wsimport</goal>
						</goals>
						<configuration>
							<wsdlUrls>
								<wsdlUrl>http://xmlgatewaytest.tradyso.com/xmlgateway/xmlpush/PMS_Tradyso.wsdl</wsdlUrl>
							</wsdlUrls>
							<packageName>com.esferalia.aon.pms</packageName>
						</configuration>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build> 
</project>
 
