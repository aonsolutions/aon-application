		<xs:annotation>
			<xs:documentation xml:lang="en">Travel agency codes: alphanumeric Strings 1 to 8 numbers plus 3 optional control chars</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:pattern value="[0-9]{1,8}([a-zA-Z]{3})?"/>
		</xs:restriction>
	</xs:simpleType-->
	<xs:complexType name="AgencyCodeType">
		<xs:simpleContent>
			<xs:extension base="xs:string">
				<xs:attribute name="Type" use="optional">
					<xs:simpleType>
						<xs:restriction base="xs:NMTOKEN">
							<xs:enumeration value="IATA"/>
							<xs:enumeration value="SolRes"/>
						</xs:restriction>
					</xs:simpleType>
				</xs:attribute>
			</xs:extension>
		</xs:simpleContent>
	</xs:complexType>
	<xs:simpleType name="StringLength1to20">
		<xs:annotation>
			<xs:documentation xml:lang="en">Used for Strings, length 1 to 20</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:minLength value="1"/>
			<xs:maxLength value="20"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="StringLength1to60">
		<xs:annotation>
			<xs:documentation xml:lang="en">Used for Strings, length 1 to 60</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:minLength value="1"/>
			<xs:maxLength value="60"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="StringLength1to150">
		<xs:annotation>
			<xs:documentation xml:lang="en">Used for Strings, length 1 to 150</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:minLength value="1"/>
			<xs:maxLength value="150"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="DateOrTimeOrDateTimeType">
		<xs:annotation>
			<xs:documentation xml:lang="en">A construct to validate either a date or a time or a dateTime value.</xs:documentation>
		</xs:annotation>
		<xs:union memberTypes="xs:date xs:dateTime xs:time"/>
	</xs:simpleType>
	<xs:simpleType name="NumericStringLength4to9">
		<xs:annotation>
