	<!-- **************************** SolMelia_Messaging ************************************** -->
	<xs:complexType name="HITISOperationAbstractType">
		<xs:annotation>
			<xs:documentation xml:lang="en">This is empty as it will be redefined for each message</xs:documentation>
		</xs:annotation>
	</xs:complexType>
	<xs:element name="HITISOperationAbstract" type="HITISOperationAbstractType" abstract="true"/>
	<xs:element name="HITISMessage">
		<xs:complexType>
			<xs:sequence>
				<xs:element name="Header">
					<xs:complexType>
						<xs:sequence>
							<xs:element name="FromURI" type="xs:string" minOccurs="0"/>
							<xs:element name="ToURI" type="xs:string" minOccurs="0"/>
							<xs:element name="ReplyToURI" type="xs:string" minOccurs="0"/>
							<xs:element name="MessageID" type="xs:string"/>
							<xs:element name="OriginalMessageID" type="xs:string" minOccurs="0"/>
							<xs:element name="TimeStamp" type="TimeStampType" minOccurs="0"/>
							<xs:element name="Token" type="xs:string" minOccurs="0"/>
						</xs:sequence>
						<xs:attribute name="ImmediateResponseRequired" type="xs:string"/>
						<xs:attribute name="OriginalBodyRequested" type="xs:string"/>
						<xs:attribute name="a-dtype" type="xs:NMTOKENS" default="texto"/>
					</xs:complexType>
				</xs:element>
				<xs:element name="Body">
					<xs:complexType>
						<xs:sequence>
							<xs:element ref="HITISOperationAbstract"/>
						</xs:sequence>
					</xs:complexType>
				</xs:element>
			</xs:sequence>
			<xs:attribute name="Version" type="xs:string"/>
		</xs:complexType>
	</xs:element>



	<!-- **************************** SolMelia_CommonTypes ************************************** -->
	<xs:element name="LanguageID" type="xs:language"/>
	<!--xs:element name="duration" type="xs:string"-->
	<xs:element name="Errors">
		<xs:complexType>
			<xs:sequence>
				<xs:element name="Error" maxOccurs="unbounded">
					<xs:complexType>
						<xs:simpleContent>
							<xs:extension base="xs:string">
								<xs:attribute name="HITISCode" type="xs:string" use="required"/>
							</xs:extension>
						</xs:simpleContent>
					</xs:complexType>
				</xs:element>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<xs:element name="duration">
		<xs:simpleType>
			<xs:annotation>
				<xs:documentation xml:lang="en">
					Duration of stay in the format YYYY-MM-ddTHH:mm:ss
					The maximum number of days for a stay is 999 days
				</xs:documentation>
			</xs:annotation>
			<xs:restriction base="xs:string">
				<xs:pattern value="\+0000-00-([0-9]{1,3})T00:00:00"/>
			</xs:restriction>
		</xs:simpleType>
	</xs:element>
	<xs:complexType name="TimeStampType">
		<xs:simpleContent>
			<xs:extension base="xs:string">
				<xs:attribute name="e-dtype" type="xs:NMTOKEN" fixed="timeInstant"/>
			</xs:extension>
		</xs:simpleContent>
	</xs:complexType>
	<xs:element name="startInstant" type="xs:dateTime"/>
	<xs:element name="TimeSpan">
		<xs:complexType>
			<xs:sequence>
				<xs:element ref="DateTimeSpan"/>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<xs:element name="DateTimeSpan">
		<xs:complexType>
			<xs:sequence>
				<xs:element ref="startInstant"/>
				<xs:element ref="duration"/>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<xs:element name="StayDateRange">
		<xs:complexType>
			<xs:sequence>
				<xs:element ref="DateTimeSpan"/>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<!-- ## HotelReference attributes ## -->
	<xs:element name="HotelCode" type="NumericStringLength4to9"/>
	<xs:element name="HotelReferenceRPH" type="xs:positiveInteger"/>
	<xs:element name="ChainCode" type="xs:string"/>
	<xs:element name="HotelAvailability" type="xs:string"/>
	<xs:element name="HotelInformations">
		<xs:complexType>
			<xs:sequence>
				<xs:element name="HotelInformation" maxOccurs="unbounded">
					<xs:complexType>
						<xs:sequence>
							<xs:element name="HotelInformationRPH" type="xs:positiveInteger"/>
							<xs:element name="DetailDescription" type="xs:string"/>
						</xs:sequence>
						<xs:attribute name="HotelInformationType" use="required">
							<xs:simpleType>
								<xs:restriction base="xs:NMTOKEN">
									<xs:enumeration value="GuarantyPolicy"/>
									<xs:enumeration value="DepositPolicy"/>
									<xs:enumeration value="CommisionsPolicy"/>
									<xs:enumeration value="CancelationInformation"/>
								</xs:restriction>
							</xs:simpleType>
						</xs:attribute>
					</xs:complexType>
				</xs:element>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<!-- ## RoomStay attributes ## -->
	<xs:element name="RoomStayRPH" type="xs:positiveInteger"/>
	<xs:element name="InventoryCode" type="xs:string"/>
	<xs:element name="ServiceCharges" type="xs:string"/>
	<xs:element name="RoomInventoryCode" type="xs:string"/>
	<!-- ## Service attributes ## -->
	<xs:element name="ServiceRPH" type="xs:positiveInteger"/>
	<xs:element name="ExtraServiceRPH" type="xs:positiveInteger"/>
	<xs:element name="ServiceInventoryCode" type="xs:string"/>
	<xs:element name="Quantity" type="xs:positiveInteger"/>
	<xs:element name="Price">
		<xs:complexType mixed="true">
			<xs:all minOccurs="0">
				<xs:element ref="Currency" minOccurs="0"/>
			</xs:all>
			<xs:attribute name="CurrencyCode" type="xs:string" use="optional"/>
		</xs:complexType>
	</xs:element>
	<!-- ## RateQuote attributes ## -->
	<xs:element name="QuotedRateAmount">
		<xs:complexType mixed="true">
			<xs:all minOccurs="0">
				<xs:element ref="Currency"/>
			</xs:all>
			<xs:attribute name="CurrencyCode" type="xs:string" use="optional"/>
		</xs:complexType>
	</xs:element>
	<xs:element name="RateBasisTimeUnitType" type="xs:string"/>
	<xs:element name="RequestedCurrencyCode" type="AlphaLength3to3">
		<xs:annotation>
			<xs:documentation xml:lang="en">Currency type based on ISO 4217</xs:documentation>
		</xs:annotation>
	</xs:element>
	<xs:element name="PagingKey" type="xs:string"/>
	<xs:element name="Membership">
		<xs:complexType>
			<xs:choice minOccurs="0" maxOccurs="unbounded">
				<xs:element name="ProgramCode" type="xs:string"/>
				<xs:element name="AccountID" type="xs:string"/>
				<xs:element name="LevelCode" type="xs:string"/>
				<xs:element name="MembershipCategoryCode" type="xs:string" minOccurs="0"/>
				<xs:element name="ExpireDate" type="TimeStampType" minOccurs="0"/>
				<xs:element name="SignupDate" type="TimeStampType" minOccurs="0"/>
				<xs:element name="StartDate" type="TimeStampType" minOccurs="0"/>
				<xs:element ref="Membership" minOccurs="0"/>
			</xs:choice>
		</xs:complexType>
	</xs:element>
	<xs:element name="Profile">
		<xs:complexType>
			<xs:sequence>
				<xs:element name="ProfileID" type="xs:string" minOccurs="0"/>
				<xs:element ref="Membership" minOccurs="0" maxOccurs="unbounded"/>
			</xs:sequence>
			<xs:attribute name="GenderType">
				<xs:simpleType>
					<xs:restriction base="xs:NMTOKEN">
						<xs:enumeration value="Unknown"/>
						<xs:enumeration value="Male"/>
						<xs:enumeration value="Female"/>
					</xs:restriction>
				</xs:simpleType>
			</xs:attribute>
			<xs:attribute name="ProfileType">
				<xs:simpleType>
					<xs:restriction base="xs:NMTOKEN">
						<xs:enumeration value="Guest"/>
						<xs:enumeration value="CorporateAccount"/>
						<xs:enumeration value="TravelAgency"/>
						<xs:enumeration value="Wholesaler"/>
						<xs:enumeration value="Group"/>
						<xs:enumeration value="TourOperator"/>
						<xs:enumeration value="CRO"/>
						<xs:enumeration value="Contact"/>
						<xs:enumeration value="Airline"/>
						<xs:enumeration value="RepCompany"/>
						<xs:enumeration value="InternetBroker"/>
						<xs:enumeration value="Hotel"/>
					</xs:restriction>
				</xs:simpleType>
			</xs:attribute>
		</xs:complexType>
	</xs:element>
	<xs:element name="Currency">
		<xs:complexType>
			<xs:simpleContent>
				<xs:extension base="xs:string">
					<xs:attribute name="CurrencyCode" type="xs:string"/>
				</xs:extension>
			</xs:simpleContent>
		</xs:complexType>
	</xs:element>
	<xs:element name="GuestCounts">
		<xs:complexType>
			<xs:sequence>
				<xs:element name="GuestCount" maxOccurs="unbounded">
					<xs:complexType>
						<xs:sequence>
							<xs:element name="AgeQualifyingCode" type="xs:string" minOccurs="0"/>
							<xs:element name="Age" type="xs:positiveInteger" minOccurs="0"/>
							<xs:element name="Count" type="Numeric1to9"/>
						</xs:sequence>
					</xs:complexType>
				</xs:element>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<xs:element name="RatePlanRPH" type="xs:positiveInteger"/>
	<xs:element name="RatePlanCode" type="xs:string"/>
	<!-- @@@@@@@@@@@@@@@@@@ AVAILABILITY @@@@@@@@@@@@@@@@@-->
	<xs:element name="AvailabilityOriginatorCode" type="xs:string"/>
	<!--xs:element name="AgencyCode" type="NumericStringLength8"/ DEFINED IN SolMelia_SimpleTypes.xsd -->
	<!--######################## BOOKING RULES o Normas de Venta (deposito, garantización y cancelación) ############################################-->
	<xs:complexType name="BankCityType">
		<xs:attribute name="CityCode" type="xs:string" use="required"/>
		<xs:attribute name="CityName" type="xs:string" use="required"/>
	</xs:complexType>
	<xs:complexType name="BankCountryType">
		<xs:attribute name="CountryCode" type="xs:string" use="required"/>
	</xs:complexType>
	<xs:element name="AccountHolderName" type="StringLength1to150"/>
	<xs:element name="AccountNumber" type="StringLength1to60"/>
	<xs:complexType name="BankDetailsType">
		<xs:sequence>
			<xs:element ref="BankName" minOccurs="0"/>
			<xs:element ref="AccountNumber" minOccurs="0"/>
			<xs:element ref="AccountHolderName" minOccurs="0"/>
			<xs:element name="BankCity" type="BankCityType" minOccurs="0"/>
			<xs:element name="BankCountry" type="BankCountryType" minOccurs="0"/>
		</xs:sequence>
	</xs:complexType>
	<xs:element name="BankName" type="StringLength1to60"/>
	<xs:element name="BookingRules">
		<xs:complexType>
			<xs:sequence>
				<xs:element name="GuaranteeRequirements" type="GuaranteeRequirementsType"/>
				<xs:element name="CancelPenalties" type="CancelPenaltiesType" minOccurs="0"/>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<xs:complexType name="CancelPenaltyType">
		<xs:sequence>
			<xs:element name="Deadline" type="DeadlineType" minOccurs="0"/>
			<xs:element name="DuePayment" type="DuePaymentType"/>
			<xs:element ref="Description" minOccurs="0"/>
		</xs:sequence>
		<xs:attribute name="ModificationIncluded" type="xs:boolean" use="optional"/>
	</xs:complexType>
	<xs:complexType name="CancelPenaltiesType">
		<xs:sequence>
			<xs:element name="Comment" type="xs:string" minOccurs="0"/>
			<xs:element name="CancelPenalty" type="CancelPenaltyType" maxOccurs="unbounded"/>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="DeadlineType">
		<xs:attribute name="AbsoluteDeadline" type="DateOrTimeOrDateTimeType" use="optional"/>
		<xs:attribute name="OffsetUnit" use="optional">
			<xs:simpleType>
				<xs:restriction base="xs:NMTOKEN">
					<xs:enumeration value="Hour"/>
					<xs:enumeration value="Day"/>
					<xs:enumeration value="Week"/>
					<xs:enumeration value="Month"/>
				</xs:restriction>
			</xs:simpleType>
		</xs:attribute>
		<xs:attribute name="OffsetUnitMultiplier" type="xs:positiveInteger" use="optional"/>
		<xs:attribute name="OffsetDropTime" use="optional">
			<xs:simpleType>
				<xs:restriction base="xs:NMTOKEN">
					<xs:enumeration value="BeforeArrival"/>
					<xs:enumeration value="AfterBooking"/>
				</xs:restriction>
			</xs:simpleType>
		</xs:attribute>
	</xs:complexType>
	<xs:complexType name="DepositPaymentType">
		<xs:sequence>
			<xs:element name="DuePayment" type="DuePaymentType"/>
			<xs:element name="Deadline" type="DeadlineType"/>
			<xs:element name="BankDetails" type="BankDetailsType" minOccurs="0"/>
		</xs:sequence>
		<xs:attribute name="Method" type="DepositGuaranteeMethod" use="optional"/>
	</xs:complexType>
	<xs:element name="Description" type="xs:string"/>
	<xs:complexType name="DuePaymentType">
		<xs:attribute name="Quantity" type="xs:string" use="required"/>
		<xs:attribute name="Unit" use="required">
			<xs:simpleType>
				<xs:restriction base="xs:NMTOKEN">
					<xs:enumeration value="Percent"/>
					<xs:enumeration value="Amount"/>
					<xs:enumeration value="NightStay"/>
				</xs:restriction>
			</xs:simpleType>
		</xs:attribute>
		<xs:attribute name="CurrencyCode" type="AlphaLength3to3" use="optional"/>
	</xs:complexType>
	<xs:complexType name="GuaranteeType">
		<xs:attribute name="Method" type="DepositGuaranteeMethod" use="required"/>
	</xs:complexType>
	<xs:simpleType name="DepositGuaranteeMethod">
		<xs:restriction base="xs:NMTOKEN">
			<xs:enumeration value="CreditCard"/>
			<xs:enumeration value="Voucher"/>
			<xs:enumeration value="CreditCardOrVoucher"/>
			<xs:enumeration value="CreditCardAuthFax"/>
			<xs:enumeration value="PrepayOrDeposit"/>
			<xs:enumeration value="CreditCardOrDeposit"/>
			<xs:enumeration value="Cheque"/>
			<xs:enumeration value="BankDeposit"/>
			<xs:enumeration value="CreditCardAndCheque"/>
			<xs:enumeration value="PrePay"/>
			<xs:enumeration value="CreditCardAndVoucher"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:complexType name="GuaranteeRequirementsType">
		<xs:choice>
			<xs:element name="LatestArrivalTime" type="xs:time"/>
			<xs:element name="Guarantee" type="GuaranteeType"/>
			<xs:element name="DepositPayment" type="DepositPaymentType"/>
		</xs:choice>
	</xs:complexType>
	<xs:element name="ExtraServices">
		<xs:complexType>
			<xs:sequence>
				<xs:element ref="ExtraService" maxOccurs="unbounded"/>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<xs:element name="ExtraService">
		<xs:complexType>
			<xs:sequence>
				<xs:element ref="ExtraServiceRPH"/>
				<xs:element ref="ServiceInventoryCode"/>
				<xs:element ref="Price"/>
			</xs:sequence>
			<xs:attribute name="ExtraServiceType" use="required">
				<xs:simpleType>
					<xs:restriction base="xs:NMTOKEN">
						<xs:enumeration value="Bed"/>
						<xs:enumeration value="Person"/>
					</xs:restriction>
				</xs:simpleType>
			</xs:attribute>
		</xs:complexType>
	</xs:element>
	<xs:element name="Distributor">
		<xs:complexType>
			<xs:attribute name="Code" type="xs:string" use="required"/>
		</xs:complexType>
	</xs:element>



	<!-- **************************** SolMelia_SimpleTypes ************************************** -->
	<xs:simpleType name="AlphaLength3to3">
		<xs:annotation>
			<xs:documentation xml:lang="en">Used for Alphabetic Strings, length exactly 3</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:pattern value="[a-zA-Z]{3}"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="StringLength1to3">
		<xs:annotation>
			<xs:documentation xml:lang="en">Used for Strings, length 1 to 3</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:minLength value="1"/>
			<xs:maxLength value="3"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="NumericStringLength10">
		<xs:annotation>
			<xs:documentation xml:lang="en">Used for Numeric Strings, length 10</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:pattern value="[0-9]{1,10}"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="NumericStringLength4">
		<xs:annotation>
			<xs:documentation xml:lang="en">Used for Numeric Strings, length 4</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:pattern value="[0-9]{4}"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="NumericStringLength8">
		<xs:annotation>
			<xs:documentation xml:lang="en">Used for Numeric Strings, length 8</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:pattern value="[0-9]{8}"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="Numeric1to9">
		<xs:annotation>
			<xs:documentation xml:lang="en">Used for Numeric values, from 1 to 9 inclusive</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:integer">
			<xs:minInclusive value="1"/>
			<xs:maxInclusive value="9"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="StringLength1YorN">
		<xs:annotation>
			<xs:documentation xml:lang="en">Character Y or N</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:minLength value="1"/>
			<xs:maxLength value="1"/>
			<xs:enumeration value="Y"/>
			<xs:enumeration value="N"/>
		</xs:restriction>
	</xs:simpleType>
