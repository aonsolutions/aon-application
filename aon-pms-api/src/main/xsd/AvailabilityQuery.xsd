	<!-- **************************** SolMelia_Messaging ************************************** -->
	<xs:complexType name="HITISOperationAbstractType">
		<xs:annotation>
			<xs:documentation xml:lang="en">This is empty as it will be redefined for each message</xs:documentation>
		</xs:annotation>
	</xs:complexType>
	<xs:element name="HITISOperationAbstract" type="HITISOperationAbstractType" abstract="true"/>
	<xs:element name="HITISMessage">
		<xs:complexType>
			<xs:sequence>
				<xs:element name="Header">
					<xs:complexType>
						<xs:sequence>
							<xs:element name="FromURI" type="xs:string" minOccurs="0"/>
							<xs:element name="ToURI" type="xs:string" minOccurs="0"/>
							<xs:element name="ReplyToURI" type="xs:string" minOccurs="0"/>
							<xs:element name="MessageID" type="xs:string"/>
							<xs:element name="OriginalMessageID" type="xs:string" minOccurs="0"/>
							<xs:element name="TimeStamp" type="TimeStampType" minOccurs="0"/>
							<xs:element name="Token" type="xs:string" minOccurs="0"/>
						</xs:sequence>
						<xs:attribute name="ImmediateResponseRequired" type="xs:string"/>
						<xs:attribute name="OriginalBodyRequested" type="xs:string"/>
						<xs:attribute name="a-dtype" type="xs:NMTOKENS" default="texto"/>
					</xs:complexType>
				</xs:element>
				<xs:element name="Body">
					<xs:complexType>
						<xs:sequence>
							<xs:element ref="HITISOperationAbstract"/>
						</xs:sequence>
					</xs:complexType>
				</xs:element>
			</xs:sequence>
			<xs:attribute name="Version" type="xs:string"/>
		</xs:complexType>
	</xs:element>



	<!-- **************************** SolMelia_CommonTypes ************************************** -->
	<xs:element name="LanguageID" type="xs:language"/>
	<!--xs:element name="duration" type="xs:string"-->
	<xs:element name="Errors">
		<xs:complexType>
			<xs:sequence>
				<xs:element name="Error" maxOccurs="unbounded">
					<xs:complexType>
						<xs:simpleContent>
							<xs:extension base="xs:string">
								<xs:attribute name="HITISCode" type="xs:string" use="required"/>
							</xs:extension>
						</xs:simpleContent>
					</xs:complexType>
				</xs:element>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<xs:element name="duration">
		<xs:simpleType>
			<xs:annotation>
				<xs:documentation xml:lang="en">
					Duration of stay in the format YYYY-MM-ddTHH:mm:ss
					The maximum number of days for a stay is 999 days
				</xs:documentation>
			</xs:annotation>
			<xs:restriction base="xs:string">
				<xs:pattern value="\+0000-00-([0-9]{1,3})T00:00:00"/>
			</xs:restriction>
		</xs:simpleType>
	</xs:element>
	<xs:complexType name="TimeStampType">
		<xs:simpleContent>
			<xs:extension base="xs:string">
				<xs:attribute name="e-dtype" type="xs:NMTOKEN" fixed="timeInstant"/>
			</xs:extension>
		</xs:simpleContent>
	</xs:complexType>
	<xs:element name="startInstant" type="xs:dateTime"/>
	<xs:element name="TimeSpan">
		<xs:complexType>
			<xs:sequence>
				<xs:element ref="DateTimeSpan"/>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<xs:element name="DateTimeSpan">
		<xs:complexType>
			<xs:sequence>
				<xs:element ref="startInstant"/>
				<xs:element ref="duration"/>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<xs:element name="StayDateRange">
		<xs:complexType>
			<xs:sequence>
				<xs:element ref="DateTimeSpan"/>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<!-- ## HotelReference attributes ## -->
	<xs:element name="HotelCode" type="NumericStringLength4to9"/>
