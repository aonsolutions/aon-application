							<xs:element name="ExtraPackageSubType2" minOccurs="0"/>
							<xs:element name="ExtraPackageSubType3" minOccurs="0"/>
							<xs:element name="ExtraPackageSubType4" minOccurs="0"/>
							<xs:element name="ExtraPackageServices" minOccurs="0">
								<xs:complexType>
									<xs:sequence>
