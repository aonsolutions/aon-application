						<xs:sequence>
							<xs:element name="Offer" maxOccurs="unbounded">
								<xs:complexType>
									<xs:sequence>
										<xs:element name="OfferRPH"/>
										<xs:element name="ServiceCode"/>
										<xs:element name="OfferCode"/>
										<xs:element name="OfferDescription"/>
										<xs:element name="Amount" minOccurs="0">
											<xs:complexType/>
										</xs:element>
										<xs:element name="Percent" minOccurs="0"/>
										<xs:element name="CurrencyCode" minOccurs="0"/>
										<xs:element name="NumberOfNights" minOccurs="0"/>
										<xs:element name="NumberOfPaidNights" minOccurs="0"/>
										<xs:element name="NumberOfFreeNights" minOccurs="0"/>
										<xs:element name="ExtraType" minOccurs="0"/>
										<xs:element name="PAXType" minOccurs="0"/>
