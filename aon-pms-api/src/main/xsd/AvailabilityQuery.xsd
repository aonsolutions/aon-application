					<xs:restriction base="xs:NMTOKEN">
						<xs:enumeration value="None"/>
						<xs:enumeration value="GuaranteeRequired"/>
						<xs:enumeration value="DepositRequired"/>
						<xs:enumeration value="ImmediatePaymentRequired"/>
					</xs:restriction>
				</xs:simpleType>
			</xs:attribute>
		</xs:complexType>
	</xs:element>
	<xs:element name="RateDescriptions">
		<xs:complexType>
			<xs:sequence>
				<xs:element name="RateDescription" maxOccurs="unbounded">
					<xs:complexType>
						<xs:sequence>
							<xs:element name="RateDescriptionRPH" type="xs:string"/>
							<xs:element name="DetailDescription" type="xs:string"/>
						</xs:sequence>
						<xs:attribute name="AvailabilityDetailType" use="required">
							<xs:simpleType>
								<xs:restriction base="xs:NMTOKEN">
									<xs:enumeration value="RateText"/>
									<xs:enumeration value="DetailRateDescription"/>
									<xs:enumeration value="TaxesText"/>
									<xs:enumeration value="TaxesDescription"/>
									<xs:enumeration value="SpecialRequired"/>
								</xs:restriction>
							</xs:simpleType>
						</xs:attribute>
