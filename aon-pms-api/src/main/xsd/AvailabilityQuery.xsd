												<xs:sequence>
													<xs:element name="ServiceNumber"/>
													<xs:element name="ServiceCode"/>
													<xs:element name="ServiceDescription" minOccurs="0"/>
												</xs:sequence>
											</xs:complexType>
										</xs:element>
									</xs:sequence>
								</xs:complexType>
							</xs:element>
						</xs:sequence>
					</xs:complexType>
				</xs:element>
				<xs:element name="CancelPenalty" type="CancelPenaltyType" minOccurs="0"/>
				<xs:element name="Offers" minOccurs="0">
