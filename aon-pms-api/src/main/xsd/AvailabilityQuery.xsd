<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns="http://www.solmelia.com/namespaces/solres" xmlns:xs="http://www.w3.org/2001/XMLSchema" targetNamespace="http://www.solmelia.com/namespaces/solres" elementFormDefault="qualified">
	<!-- **************************** AvailabilityQueryRequest ************************************** -->
	<xs:element name="HITISOperation" type="HITISOperationType" substitutionGroup="HITISOperationAbstract"/>
	<xs:complexType name="HITISOperationType">
		<xs:complexContent>
			<xs:extension base="HITISOperationAbstractType">
				<xs:sequence>
					<xs:element ref="Errors" minOccurs="0"/>
					<xs:element ref="AvailabilityQuery"/>
					<xs:element name="RequestQueryDetail" type="xs:string" minOccurs="0"/>
					<xs:element ref="AvailabilitySummaryResponses" minOccurs="0"/>
					<xs:element ref="AvailabilityDetailResponses" minOccurs="0" maxOccurs="unbounded"/>
					<xs:element ref="AvailabilityOriginatorCode"/>
					<xs:element ref="Distributor" minOccurs="0"/>
				</xs:sequence>
				<xs:attribute name="HITISCode" type="xs:string"/>
				<xs:attribute name="OperationName" type="xs:string" use="required"/>
				<xs:attribute name="OperationType" use="required">
					<xs:simpleType>
						<xs:restriction base="xs:NMTOKEN">
							<xs:enumeration value="Availability"/>
							<xs:enumeration value="Rate"/>
						</xs:restriction>
					</xs:simpleType>
				</xs:attribute>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
	<xs:element name="AvailabilityQuery">
		<xs:complexType>
			<xs:sequence>
				<xs:element ref="HotelReference" minOccurs="0"/>
				<xs:element name="ReservationID" type="xs:string" minOccurs="0"/>
				<xs:element ref="LanguageID" minOccurs="0"/>
				<xs:element ref="RequestedCurrencyCode" minOccurs="0"/>
				<xs:element name="RateMinCurrency" type="RateCurrencyType" minOccurs="0"/>
				<xs:element name="RateMaxCurrency" type="RateCurrencyType" minOccurs="0"/>
				<xs:element ref="StayDateRange" minOccurs="0"/>
				<xs:element ref="Profiles" minOccurs="0"/>
				<xs:element ref="RoomStays" minOccurs="0"/>
				<xs:element ref="Services" minOccurs="0" maxOccurs="unbounded"/>
				<xs:element ref="PagingKey" minOccurs="0"/>
				<xs:element name="AgencyCode" type="AgencyCodeType" minOccurs="0"/>
				<xs:element name="ExternalWebCode" type="xs:string" minOccurs="0"/>
				<!--				<xs:element name="RatePlanCandidates" type="RatePlanCandidatesType" minOccurs="0"/>-->
				<!--				<xs:element name="SpecialRequests" type="SpecialRequestsType" minOccurs="0" maxOccurs="unbounded"/>-->
				<!--				<xs:element ref="AgencyCode" minOccurs="0"/>-->
				<xs:element name="BusinessOrigin" minOccurs="0">
					<xs:complexType>
						<xs:sequence>
							<xs:element name="CountryCode" type="xs:string"/>
							<xs:element name="ProvinceCode" type="xs:string" minOccurs="0"/>
						</xs:sequence>
						<xs:attribute name="Check" type="xs:string"/>
					</xs:complexType>
				</xs:element>
			</xs:sequence>
			<xs:attribute name="AvailRequestType">
				<xs:simpleType>
					<xs:restriction base="xs:NMTOKEN">
						<xs:enumeration value="Room"/>
						<xs:enumeration value="NonRoom"/>
						<xs:enumeration value="Both"/>
					</xs:restriction>
				</xs:simpleType>
			</xs:attribute>
			<xs:attribute name="ExactMatchOnly" type="xs:boolean" use="optional">
				<xs:annotation>
					<xs:documentation xml:lang="en">A boolean flag that indicates the response message should send back only those rates that are an exact match to the requested criteria.</xs:documentation>
				</xs:annotation>
			</xs:attribute>
			<xs:attribute name="SearchCacheLevel" type="xs:string" use="optional"/>
			<xs:attribute name="IncludePackages" type="xs:string" use="optional">
				<xs:annotation>
					<xs:documentation xml:lang="en">A=All Rates, Y=Include Just Package Rates, N=Don't include Package Rates</xs:documentation>
				</xs:annotation>
			</xs:attribute>
			<xs:attribute name="DetailPackages" type="xs:string">
				<xs:annotation>
					<xs:documentation>Empty, S=Short Detail, A= AllDetail</xs:documentation>
				</xs:annotation>
			</xs:attribute>
			<xs:attribute name="FilterPackagesByType" type="xs:string"/>
			<xs:attribute name="FilterPackagesBySubType1" type="xs:string"/>
			<xs:attribute name="FilterPackagesBySubType3" type="xs:string"/>
			<xs:attribute name="FilterPackagesBySubType2" type="xs:string"/>
			<xs:attribute name="FilterPackagesBySubType4" type="xs:string"/>
		</xs:complexType>
	</xs:element>
	<xs:element name="AvailabilitySummaryResponses">
		<xs:complexType>
			<xs:sequence>
				<xs:element ref="AvailabilitySummaryResponse"/>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<xs:element name="AvailabilitySummaryResponse">
		<xs:complexType>
			<xs:sequence>
				<xs:element ref="HotelReference"/>
				<xs:element ref="AvailabilitySummaryRecords"/>
				<xs:element ref="Taxes" minOccurs="0"/>
				<xs:element ref="ProfileReferences" minOccurs="0" maxOccurs="unbounded"/>
				<xs:element ref="PagingKey" minOccurs="0"/>
				<xs:element ref="RequestedCurrencyCode"/>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<xs:element name="AvailabilityDetailResponses">
		<xs:complexType>
			<xs:sequence>
				<xs:element ref="AvailabilityDetailResponse" maxOccurs="unbounded"/>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<xs:element name="AvailabilityDetailResponse">
		<xs:complexType>
			<xs:sequence>
				<xs:element name="AvailabilityDetailResponseRPH" type="xs:positiveInteger"/>
				<xs:element name="DetailDescription" type="xs:string"/>
			</xs:sequence>
			<xs:attribute name="AvailabilityDetailType" use="required">
				<xs:simpleType>
					<xs:restriction base="xs:NMTOKEN">
						<xs:enumeration value="RateDescription"/>
						<xs:enumeration value="RoomInformation"/>
						<xs:enumeration value="GuaranteeInformation"/>
						<xs:enumeration value="DepositInformation"/>
						<xs:enumeration value="CancellationInformation"/>
						<xs:enumeration value="CheckInCheckOutInformation"/>
						<xs:enumeration value="ExtraChargeInformation"/>
						<xs:enumeration value="PackageInformation"/>
						<xs:enumeration value="PropertyDescription"/>
						<xs:enumeration value="PropertyLocation"/>
						<xs:enumeration value="MiscellaneousInformation"/>
						<xs:enumeration value="PromotionalInformation"/>
						<xs:enumeration value="RoomRateInformation"/>
					</xs:restriction>
				</xs:simpleType>
			</xs:attribute>
		</xs:complexType>
	</xs:element>
	<xs:complexType name="RateCurrencyType">
		<xs:sequence>
			<xs:element ref="Currency"/>
		</xs:sequence>
	</xs:complexType>
	<xs:element name="HotelReference">
		<xs:complexType>
			<xs:sequence>
				<xs:element ref="ChainCode" minOccurs="0"/>
				<xs:element ref="HotelCode"/>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<xs:element name="Profiles">
		<xs:complexType>
			<xs:sequence>
				<xs:element ref="Profile"/>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<xs:element name="RoomStays">
		<xs:complexType>
			<xs:sequence>
				<xs:element name="RoomStay" maxOccurs="unbounded">
					<xs:complexType>
						<xs:sequence>
							<xs:element ref="RoomStayRPH"/>
							<xs:element ref="RoomInventoryCode" minOccurs="0"/>
							<xs:element ref="GuestCounts"/>
							<xs:element ref="RatePlans" minOccurs="0"/>
							<xs:element name="Amount" minOccurs="0"/>
							<xs:element name="RoomCodes" minOccurs="0">
								<xs:complexType>
									<xs:attribute name="Category" type="xs:string" use="required"/>
									<xs:attribute name="MealPlan" type="xs:string" use="required"/>
									<xs:attribute name="BaseRoomCode" type="xs:string" use="required"/>
								</xs:complexType>
							</xs:element>
							<xs:element ref="Services" minOccurs="0" maxOccurs="unbounded"/>
							<xs:element ref="RateQuotes"/>
							<xs:element ref="RoomInformations" minOccurs="0" maxOccurs="unbounded"/>
							<xs:element ref="LimitDates" minOccurs="0" maxOccurs="unbounded"/>
							<xs:element ref="BookingRules" minOccurs="0"/>
							<!--						<xs:element ref="RoomID" minOccurs="0"/>-->
							<!--						<xs:element name="TimeSpan" type="TimeSpanType" minOccurs="0"/>-->
							<!--						<xs:element name="AnticipatedSettlementRPHs" type="AnticipatedSettlementRPHsType" minOccurs="0" maxOccurs="unbounded"/>-->
							<!--						<xs:element ref="InventoryBlockCode" minOccurs="0"/>-->
							<!--						<xs:element ref="MarketSegmentCode" minOccurs="0"/>-->
							<!--						<xs:element ref="PromotionCode" minOccurs="0"/>-->
							<!--						<xs:element ref="TACommissionPlanCode" minOccurs="0"/>-->
							<!--						<xs:element name="ResGuestRPHs" type="ResGuestRPHsType" minOccurs="0" maxOccurs="unbounded"/>-->
							<!--						<xs:element name="SelectedMembershipRPHs" type="SelectedMembershipRPHsType" minOccurs="0" maxOccurs="unbounded"/>-->
							<!--						<xs:element name="ResCommentRPHs" type="ResCommentRPHsType" minOccurs="0" maxOccurs="unbounded"/>-->
							<!--						<xs:element name="SpecialRequestRPHs" type="SpecialRequestRPHsType" minOccurs="0" maxOccurs="unbounded"/>-->
							<!--						<xs:element name="ServiceRPHs" type="ServiceRPHsType" minOccurs="0" maxOccurs="unbounded"/>-->
							<!--						<xs:element name="GuaranteeInfo" type="GuaranteeInfoType" minOccurs="0"/>-->
							<!--						<xs:element name="CancelPenalties" type="CancelPenaltiesType" minOccurs="0"/>-->
							<!--						<xs:element name="PaymentInstructions" type="PaymentInstructionsType" minOccurs="0"/>-->
						</xs:sequence>
						<xs:attribute name="ReservationActionType">
							<xs:simpleType>
								<xs:restriction base="xs:NMTOKEN">
									<xs:enumeration value="DoesNotApply"/>
									<xs:enumeration value="New"/>
									<xs:enumeration value="Change"/>
									<xs:enumeration value="Delete"/>
								</xs:restriction>
							</xs:simpleType>
						</xs:attribute>
						<xs:attribute name="ReservationStatusType">
							<xs:simpleType>
								<xs:restriction base="xs:NMTOKEN">
									<xs:enumeration value="Reserved"/>
									<xs:enumeration value="Requested"/>
									<xs:enumeration value="RequestDenied"/>
									<xs:enumeration value="NoShow"/>
									<xs:enumeration value="Canceled"/>
									<xs:enumeration value="InHouse"/>
									<xs:enumeration value="CheckedOut"/>
									<xs:enumeration value="Waitlisted"/>
								</xs:restriction>
							</xs:simpleType>
						</xs:attribute>
					</xs:complexType>
				</xs:element>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<xs:element name="RatePlans">
		<xs:complexType>
			<xs:sequence>
				<xs:element name="RatePlan" maxOccurs="unbounded">
					<xs:complexType>
						<xs:sequence>
							<xs:element ref="RatePlanRPH"/>
							<xs:element ref="RatePlanCode"/>
							<!--							<xs:element name="TimeSpan" type="TimeSpanType" minOccurs="0"/>-->
							<!--							<xs:element name="Rates" type="RatesType" minOccurs="0" maxOccurs="unbounded"/>-->
						</xs:sequence>
						<xs:attribute name="ReservationActionType">
							<xs:simpleType>
								<xs:restriction base="xs:NMTOKEN">
									<xs:enumeration value="DoesNotApply"/>
									<xs:enumeration value="New"/>
									<xs:enumeration value="Change"/>
									<xs:enumeration value="Delete"/>
								</xs:restriction>
							</xs:simpleType>
						</xs:attribute>
					</xs:complexType>
				</xs:element>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<xs:element name="Services">
		<xs:complexType>
			<xs:sequence>
				<xs:element name="Service" maxOccurs="unbounded">
					<xs:complexType>
						<xs:sequence>
							<xs:element ref="ServiceRPH"/>
							<xs:element ref="ServiceInventoryCode"/>
							<!--							<xs:element name="AnticipatedSettlementRPHs" type="AnticipatedSettlementRPHsType" minOccurs="0" maxOccurs="unbounded"/>-->
							<!--							<xs:element name="ResCommentRPHs" type="ResCommentRPHsType" minOccurs="0" maxOccurs="unbounded"/>-->
							<!--							<xs:element name="SelectedMembershipRPHs" type="SelectedMembershipRPHsType" minOccurs="0" maxOccurs="unbounded"/>-->
							<!--							<xs:element ref="RatePlanCode" minOccurs="0"/>-->
							<!--							<xs:element ref="InventoryBlockCode" minOccurs="0"/>-->
							<!--							<xs:element name="TimeSpan" type="TimeSpanType" minOccurs="0"/>-->
							<!--							<xs:element name="Price" type="PriceType" minOccurs="0"/>-->
							<!--							<xs:element name="PriceGuaranteed" type="PriceGuaranteedType" minOccurs="0"/>-->
							<!--							<xs:element name="Inclusive" type="InclusiveType" minOccurs="0"/>-->
							<!--							<xs:element name="Quantity" type="QuantityType" minOccurs="0"/>-->
							<!--							<xs:element name="GuaranteeInfos" type="GuaranteeInfosType" minOccurs="0"/>-->
							<!--							<xs:element name="CancelPenalties" type="CancelPenaltiesType" minOccurs="0" maxOccurs="unbounded"/>-->
							<!--							<xs:element name="PaymentInstructions" type="PaymentInstructionsType" minOccurs="0" maxOccurs="unbounded"/>-->
							<!--							<xs:element name="GuestCounts" type="GuestCountsType" minOccurs="0" maxOccurs="unbounded"/>-->
						</xs:sequence>
						<xs:attribute name="ReservationStatusType">
							<xs:simpleType>
								<xs:restriction base="xs:NMTOKEN">
									<xs:enumeration value="Reserved"/>
									<xs:enumeration value="Requested"/>
									<xs:enumeration value="RequestDenied"/>
									<xs:enumeration value="NoShow"/>
									<xs:enumeration value="Canceled"/>
									<xs:enumeration value="InHouse"/>
									<xs:enumeration value="CheckedOut"/>
									<xs:enumeration value="Waitlisted"/>
								</xs:restriction>
							</xs:simpleType>
						</xs:attribute>
						<xs:attribute name="ServicePricingType">
							<xs:simpleType>
								<xs:restriction base="xs:NMTOKEN">
									<xs:enumeration value="PerStay"/>
									<xs:enumeration value="PerPerson"/>
									<xs:enumeration value="PerNight"/>
									<xs:enumeration value="PerPersonPerNight"/>
									<xs:enumeration value="PerUse"/>
								</xs:restriction>
							</xs:simpleType>
						</xs:attribute>
						<xs:attribute name="ReservationActionType">
							<xs:simpleType>
								<xs:restriction base="xs:NMTOKEN">
									<xs:enumeration value="DoesNotApply"/>
									<xs:enumeration value="New"/>
									<xs:enumeration value="Change"/>
									<xs:enumeration value="Delete"/>
								</xs:restriction>
							</xs:simpleType>
						</xs:attribute>
					</xs:complexType>
				</xs:element>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<xs:element name="RateQuotes">
		<xs:complexType>
			<xs:sequence>
				<xs:element name="RateQuote">
					<xs:complexType>
						<xs:sequence>
							<xs:element ref="DateRange" minOccurs="0"/>
							<xs:element ref="QuotedRateAmount"/>
							<xs:element name="QuotedLoyaltyRateAmount" minOccurs="0">
								<xs:complexType mixed="true">
									<xs:all minOccurs="0">
										<xs:element ref="Currency"/>
									</xs:all>
									<xs:attribute name="CurrencyCode" type="xs:string" use="optional"/>
								</xs:complexType>
							</xs:element>
							<xs:element name="QuotedOfferRateAmount" minOccurs="0">
								<xs:complexType mixed="true">
									<xs:all minOccurs="0">
										<xs:element ref="Currency"/>
									</xs:all>
									<xs:attribute name="CurrencyCode" type="xs:string" use="optional"/>
								</xs:complexType>
							</xs:element>
							<xs:element ref="RateBasisTimeUnitType"/>
							<xs:element name="RateBasisUnits" type="xs:positiveInteger" minOccurs="0"/>
							<xs:element name="IsChange" type="StringLength1YorN" minOccurs="0"/>
							<xs:element name="RateFlags" type="xs:string" minOccurs="0"/>
							<xs:element name="TotalTaxes" minOccurs="0">
								<xs:complexType>
									<xs:simpleContent>
										<xs:extension base="xs:string">
											<xs:attribute name="CurrencyCode" type="AlphaLength3to3" use="required"/>
										</xs:extension>
									</xs:simpleContent>
								</xs:complexType>
							</xs:element>
							<xs:element name="TotalLoyaltyTaxes" minOccurs="0">
								<xs:complexType>
									<xs:simpleContent>
										<xs:extension base="xs:string">
											<xs:attribute name="CurrencyCode" type="AlphaLength3to3" use="required"/>
										</xs:extension>
									</xs:simpleContent>
								</xs:complexType>
							</xs:element>
							<xs:element name="TotalOfferTaxes" minOccurs="0">
								<xs:complexType>
									<xs:simpleContent>
										<xs:extension base="xs:string">
											<xs:attribute name="CurrencyCode" type="AlphaLength3to3" use="required"/>
										</xs:extension>
									</xs:simpleContent>
								</xs:complexType>
							</xs:element>
							<xs:element name="TotalAmountWithoutTax" minOccurs="0">
								<xs:complexType>
									<xs:simpleContent>
										<xs:extension base="xs:string">
											<xs:attribute name="CurrencyCode" type="AlphaLength3to3" use="required"/>
										</xs:extension>
									</xs:simpleContent>
								</xs:complexType>
							</xs:element>
							<xs:element name="TotalLoyaltyAmountWithoutTax" minOccurs="0">
								<xs:complexType>
									<xs:simpleContent>
										<xs:extension base="xs:string">
											<xs:attribute name="CurrencyCode" type="AlphaLength3to3" use="required"/>
										</xs:extension>
									</xs:simpleContent>
								</xs:complexType>
							</xs:element>
							<xs:element name="TotalOfferAmountWithoutTax" minOccurs="0">
								<xs:complexType>
									<xs:simpleContent>
										<xs:extension base="xs:string">
											<xs:attribute name="CurrencyCode" type="AlphaLength3to3" use="required"/>
										</xs:extension>
									</xs:simpleContent>
								</xs:complexType>
							</xs:element>
							<xs:element name="TotalAmountWithTax" minOccurs="0">
								<xs:complexType>
									<xs:simpleContent>
										<xs:extension base="xs:string">
											<xs:attribute name="CurrencyCode" type="AlphaLength3to3" use="required"/>
										</xs:extension>
									</xs:simpleContent>
								</xs:complexType>
							</xs:element>
							<xs:element name="TotalLoyaltyAmountWithTax" minOccurs="0">
								<xs:complexType>
									<xs:simpleContent>
										<xs:extension base="xs:string">
											<xs:attribute name="CurrencyCode" type="AlphaLength3to3" use="required"/>
										</xs:extension>
									</xs:simpleContent>
								</xs:complexType>
							</xs:element>
							<xs:element name="TotalLoyaltyPoints" minOccurs="0"/>
							<xs:element name="TotalOfferAmountWithTax" minOccurs="0">
								<xs:complexType>
									<xs:simpleContent>
										<xs:extension base="xs:string">
											<xs:attribute name="CurrencyCode" type="AlphaLength3to3" use="required"/>
										</xs:extension>
									</xs:simpleContent>
								</xs:complexType>
							</xs:element>
						</xs:sequence>
					</xs:complexType>
				</xs:element>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<xs:element name="DateRange">
		<xs:complexType>
			<xs:sequence>
				<xs:element ref="DateTimeSpan"/>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<xs:element name="RoomInformations">
		<xs:complexType>
			<xs:sequence>
				<xs:element name="RoomInformation" maxOccurs="unbounded">
					<xs:complexType>
						<xs:sequence>
							<xs:element name="RoomInformationRPH" type="xs:positiveInteger"/>
							<xs:element name="DetailDescription" type="xs:string"/>
						</xs:sequence>
						<xs:attribute name="RoomInformationType" use="required">
							<xs:simpleType>
								<xs:restriction base="xs:NMTOKEN">
									<xs:enumeration value="RoomInformation"/>
									<xs:enumeration value="RoomRateInformation"/>
								</xs:restriction>
							</xs:simpleType>
						</xs:attribute>
					</xs:complexType>
				</xs:element>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<xs:element name="LimitDates">
		<xs:complexType>
			<xs:sequence>
				<xs:element name="Cancelation" type="xs:string" minOccurs="0"/>
				<xs:element name="HotelArrival" type="xs:string" minOccurs="0"/>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<xs:element name="Taxes">
		<xs:complexType>
			<xs:sequence>
				<xs:element ref="Tax" maxOccurs="unbounded"/>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<xs:element name="Tax">
		<xs:complexType>
			<xs:sequence>
				<xs:element ref="TaxDescription" minOccurs="0"/>
			</xs:sequence>
			<xs:attribute name="Percent" type="xs:string"/>
			<xs:attribute name="Type" use="required">
				<xs:simpleType>
					<xs:restriction base="xs:NMTOKEN">
						<xs:enumeration value="Inclusive"/>
						<xs:enumeration value="Exclusive"/>
					</xs:restriction>
				</xs:simpleType>
			</xs:attribute>
			<xs:attribute name="Code" type="xs:string" use="required"/>
			<xs:attribute name="ChargeUnit" type="xs:string" use="required"/>
			<xs:attribute name="Amount" type="xs:string"/>
			<xs:attribute name="CurrencyCode" type="xs:string"/>
		</xs:complexType>
	</xs:element>
	<xs:element name="TaxDescription">
		<xs:complexType>
			<xs:sequence>
				<xs:element ref="Text"/>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<xs:element name="Text">
		<xs:complexType>
			<xs:simpleContent>
				<xs:extension base="xs:string">
					<xs:attribute name="Language" type="xs:string" use="required"/>
				</xs:extension>
			</xs:simpleContent>
		</xs:complexType>
	</xs:element>
	<xs:element name="ProfileReferences">
		<xs:complexType>
			<xs:sequence>
				<xs:element name="Profiles">
					<xs:complexType>
						<xs:sequence>
							<xs:element ref="Profile"/>
						</xs:sequence>
					</xs:complexType>
				</xs:element>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<xs:element name="AvailabilitySummaryRecords">
		<xs:complexType>
			<xs:sequence>
				<xs:element ref="AvailabilitySummaryRecord" maxOccurs="unbounded"/>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<xs:element name="AvailabilitySummaryRecord">
		<xs:complexType>
			<xs:sequence>
				<xs:element name="AvailabilitySummaryRecordRPH" type="xs:positiveInteger"/>
				<xs:element name="IsRoom" type="xs:boolean" minOccurs="0"/>
				<xs:element name="IsConverted" type="xs:boolean" minOccurs="0"/>
