	</xs:element>
	<!-- ## RoomStay attributes ## -->
	<xs:element name="RoomStayRPH" type="xs:positiveInteger"/>
	<xs:element name="InventoryCode" type="xs:string"/>
	<xs:element name="ServiceCharges" type="xs:string"/>
	<xs:element name="RoomInventoryCode" type="xs:string"/>
	<!-- ## Service attributes ## -->
	<xs:element name="ServiceRPH" type="xs:positiveInteger"/>
	<xs:element name="ExtraServiceRPH" type="xs:positiveInteger"/>
	<xs:element name="ServiceInventoryCode" type="xs:string"/>
	<xs:element name="Quantity" type="xs:positiveInteger"/>
	<xs:element name="Price">
		<xs:complexType mixed="true">
			<xs:all minOccurs="0">
				<xs:element ref="Currency" minOccurs="0"/>
