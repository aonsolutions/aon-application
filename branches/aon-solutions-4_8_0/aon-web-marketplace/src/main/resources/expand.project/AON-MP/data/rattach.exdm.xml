<?xml version="1.0" encoding="UTF-8"?>
<table tableName="rattach">
    <columns>
        <column
            label="Identificador unico del Archivo Adjunto de la Persona o Empresa"
            name="id" sqlType="integer" type="integer"/>
        <column
            label="Identificador del Registro de la Persona o Empresa"
            name="registry" sqlType="integer" type="integer"/>
        <column label="Categoria del Archivo Adjunto" name="category"
            sqlType="integer" type="integer"/>
        <column label="Mime Type del Archivo Adjunto" length="2"
            name="mimeType" sqlType="tinyint" type="string"/>
        <column label="Descripcion del Archivo Adjunto" length="64"
            name="description" sqlType="varchar" type="string"/>
        <column label="Archivo Adjunto en binario" length="65535"
            name="data" sqlType="longvarbinary" type="string"/>
    </columns>
    <virtualColumns/>
    <primaryKey>
        <column name="id"/>
    </primaryKey>
    <joins>
        <join description="rattach_ibfk_1" foreignPath="data/category.exdm.xml">
            <sourceColumns>
                <column name="category"/>
            </sourceColumns>
        </join>
        <join description="rattach_ibfk_2" foreignPath="data/registry.exdm.xml">
            <sourceColumns>
                <column name="registry"/>
            </sourceColumns>
        </join>
    </joins>
    <descriptionColumns/>
</table>
