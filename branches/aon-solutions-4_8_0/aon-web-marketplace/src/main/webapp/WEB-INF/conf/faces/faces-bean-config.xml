<?xml version="1.0"?>
<!DOCTYPE faces-config PUBLIC
  "-//Sun Microsystems, Inc.//DTD JavaServer Faces Config 1.1//EN"
  "http://java.sun.com/dtd/web-facesconfig_1_1.dtd">

<faces-config>

	<!-- ************** COMMON ****************** -->
	<managed-bean>
		<managed-bean-name>enviroment</managed-bean-name>
		<managed-bean-class>
			com.code.aon.ui.form.EnviromentController
		</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
	</managed-bean>

	<managed-bean>
		<managed-bean-name>fileUpload</managed-bean-name>
		<managed-bean-class>
			com.code.aon.ui.fileupload.FileUpload
		</managed-bean-class>
		<managed-bean-scope>request</managed-bean-scope>
	</managed-bean>

	<managed-bean>
		<managed-bean-name>fileDownload</managed-bean-name>
		<managed-bean-class>
			com.code.aon.ui.form.FileDownloadBean
		</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
	</managed-bean>

	<managed-bean>
		<managed-bean-name>windowClose</managed-bean-name>
		<managed-bean-class>
			com.code.aon.ui.form.listener.WindowCloseListener
		</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
	</managed-bean>
	
	<managed-bean>
		<managed-bean-name>menuController</managed-bean-name>
		<managed-bean-class>
			com.code.aon.ui.marketplace.controller.MenuController
		</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
	</managed-bean>

	<!-- **************** REPORT *************** -->
	<managed-bean>
		<managed-bean-name>report</managed-bean-name>
		<managed-bean-class>
			com.code.aon.ui.report.controller.ReportManager
		</managed-bean-class>
		<managed-bean-scope>request</managed-bean-scope>
	</managed-bean>

	<managed-bean>
		<managed-bean-name>fopReport</managed-bean-name>
		<managed-bean-class>
			com.code.aon.ui.report.controller.FOPReportController
		</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
		<managed-property>
			<property-name>preferencesURL</property-name>
			<value>/facelet/report/fopPreferences.faces</value>
		</managed-property>
	</managed-bean>

	<!--  *************** 
		AON CONFIGURATION
		***************** -->
	<managed-bean>
		<managed-bean-name>aonConfiguration</managed-bean-name>
		<managed-bean-class>
			com.code.aon.ui.common.controller.ConfigurationController
		</managed-bean-class>
		<managed-bean-scope>application</managed-bean-scope>
		<managed-property>
			<property-name>
				applicationLogoContextRelativePath
			</property-name>
			<value>/images/logo.gif</value>
		</managed-property>
		<managed-property>
			<property-name>style</property-name>
			<value>blue</value>
		</managed-property>
		<managed-property>
			<property-name>userStyleSheets</property-name>
			<list-entries>
				<value>/css/hyperview.css</value>
				<value>/css/aon-solutions.css</value>
				<value>/css/layout.css</value>
			</list-entries>
		</managed-property>
		<managed-property>
			<property-name>applicationBundles</property-name>
			<map-entries>
				<map-entry>
					<key>bundle</key>
					<value>#{facesContext.application.messageBundle}</value>
				</map-entry>
				<map-entry>
					<key>appBundle</key>
					<value>com.code.aon.ui.marketplace.i18n.messages</value>
				</map-entry>
				<map-entry>
					<key>financeBundle</key>
                    <value>com.code.aon.ui.finance.i18n.messages</value>
				</map-entry>
				<map-entry>
					<key>compositionBundle</key>
                    <value>com.code.aon.ui.composition.i18n.messages</value>
				</map-entry>
				<map-entry>
					<key>productBundle</key>
                    <value>com.code.aon.ui.product.i18n.messages</value>
				</map-entry>
				<map-entry>
					<key>purchaseBundle</key>
                    <value>com.code.aon.ui.purchase.i18n.messages</value>
				</map-entry>
				<map-entry>
					<key>salesBundle</key>
                    <value>com.code.aon.ui.sales.i18n.messages</value>
				</map-entry>
				<map-entry>
					<key>customerBundle</key>
                    <value>com.code.aon.ui.customer.i18n.messages</value>
				</map-entry>
				<map-entry>
					<key>warehouseBundle</key>
                    <value>com.code.aon.ui.warehouse.i18n.messages</value>
				</map-entry>
				<map-entry>
					<key>registryBundle</key>
                    <value>com.code.aon.ui.registry.i18n.messages</value>
				</map-entry>
				<map-entry>
					<key>hyperviewBundle</key>
                    <value>com.code.aon.ui.hyperview.i18n.messages</value>
				</map-entry>
			</map-entries>
		</managed-property>
 	</managed-bean>


	<!-- ******************
		TIMEZONE CONTROLLER
		*******************  	 -->
	<managed-bean>
		<managed-bean-name>timeZoneController</managed-bean-name>
		<managed-bean-class>
			com.code.aon.ui.common.controller.TimeZoneController
		</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
	</managed-bean>


	<!-- *****************
		RUNNABLE HYPERVIEW
		******************  	 -->
	<managed-bean>
		<managed-bean-name>runnableTree</managed-bean-name>
		<managed-bean-class>
			com.code.aon.ui.hyperview.controller.HyperViewRunnableController
		</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
	</managed-bean>

	<!-- ********************
		HYPERVIEW RUNNER BEAN
		*********************  	 -->
	<managed-bean>
		<managed-bean-name>hyperviewRunner</managed-bean-name>
		<managed-bean-class>
			com.code.aon.ui.hyperview.controller.HyperviewRunnerController
		</managed-bean-class>
		<managed-bean-scope>request</managed-bean-scope>
	</managed-bean>

	<!-- ******************************
		WORKSTATION TREE EXPORT MANAGER
		*******************************  	 -->
	<managed-bean>
		<managed-bean-name>exportManager</managed-bean-name>
		<managed-bean-class>
			com.code.aon.ui.hyperview.controller.HyperViewExportManager
		</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
		<managed-property>
			<property-name>contextRelativeLogoPath</property-name>
			<value>/images/logo.gif</value>
		</managed-property>

	</managed-bean>

	<!-- ************** DUMPER ****************** -->
	<managed-bean>
		<managed-bean-name>dumper</managed-bean-name>
		<managed-bean-class>
			com.code.aon.dbdumper.controller.DumpController
		</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
	</managed-bean>

	<!-- ************** EXCEPTION HANDLER ****************** -->
	<managed-bean>
		<managed-bean-name>exceptionBean</managed-bean-name>
		<managed-bean-class>
			com.code.aon.ui.common.controller.ExceptionBean
		</managed-bean-class>
		<managed-bean-scope>request</managed-bean-scope>
	</managed-bean>
	
	<!-- ************** REQUEST HANDLER ****************** -->
	<managed-bean>
		<managed-bean-name>requestController</managed-bean-name>
		<managed-bean-class>
			com.code.aon.ui.form.RequestController
		</managed-bean-class>
		<managed-bean-scope>request</managed-bean-scope>
	</managed-bean>
	
	<!-- ************** TICKET ****************** -->
	<managed-bean>
		<managed-bean-name>trace</managed-bean-name>
		<managed-bean-class>com.code.aon.ui.marketplace.controller.TraceController</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
	</managed-bean>

	<managed-bean>
		<managed-bean-name>ticket</managed-bean-name>
		<managed-bean-class>com.code.aon.ui.marketplace.controller.TicketController</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
	</managed-bean>

	<managed-bean>
		<managed-bean-name>packingticket</managed-bean-name>
		<managed-bean-class>com.code.aon.ui.marketplace.controller.TicketController</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
	</managed-bean>

		<!--  **** ITEM PLU DUMP LIST **** 
	-->
	<managed-bean>
		<managed-bean-name>itemDump</managed-bean-name>
		<managed-bean-class>com.code.aon.ui.marketplace.controller.ItemDumpController</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
		<managed-property>
			<property-name>queryOnStartUP</property-name>
			<value>false</value>
		</managed-property>
		<managed-property>
			<property-name>pojo</property-name>
			<value>com.code.aon.product.Item</value>
		</managed-property>
	</managed-bean>

	<!-- ************** SCALE ****************** -->
	<managed-bean>
		<managed-bean-name>scale</managed-bean-name>
		<managed-bean-class>com.code.aon.ui.marketplace.controller.ScaleController</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
		<managed-property>
			<property-name>queryOnStartUP</property-name>
			<value>false</value>
		</managed-property>
		<managed-property>
			<property-name>pojo</property-name>
			<value>com.code.aon.marketplace.Scale</value>
		</managed-property>
	</managed-bean>

	<managed-bean>
		<managed-bean-name>scaleRelation</managed-bean-name>
		<managed-bean-class>com.code.aon.ui.marketplace.controller.ScaleRelationController</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
		<managed-property>
			<property-name>queryOnStartUP</property-name>
			<value>true</value>
		</managed-property>
		<managed-property>
			<property-name>pojo</property-name>
			<value>com.code.aon.marketplace.ScaleRelation</value>
		</managed-property>
	</managed-bean>
	
	<!-- ************** ITEM WITH ITEMPOS REPORT ****************** -->
	<managed-bean>
		<managed-bean-name>itemItemposPrinter</managed-bean-name>
		<managed-bean-class>
			com.code.aon.ui.marketplace.controller.ItemItemposPrinter
		</managed-bean-class>
		<managed-bean-scope>none</managed-bean-scope>
	</managed-bean>
	

</faces-config>