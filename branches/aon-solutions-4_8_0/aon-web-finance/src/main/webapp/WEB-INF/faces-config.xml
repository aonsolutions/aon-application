<faces-config version="1.2"
	xmlns="http://java.sun.com/xml/ns/javaee"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://java.sun.com/xml/ns/javaee http://java.sun.com/xml/ns/javaee/web-facesconfig_1_2.xsd">
	
	<application>
		<message-bundle>com.code.aon.ui.common.i18n.messages</message-bundle>
		<locale-config>
			<default-locale>es</default-locale>
			<supported-locale>en</supported-locale>
		</locale-config>
		<view-handler>com.sun.facelets.FaceletViewHandler</view-handler>  
		<resource-bundle>
			<base-name>com.code.aon.ui.web.finance.i18n.messages</base-name>
			<var>appBundle</var>
		</resource-bundle>
	</application>
	
    <!--  **** COLLECTIONS **** -->
	<managed-bean>
		<managed-bean-name>salesCollections</managed-bean-name>
		<managed-bean-class>
			com.code.aon.ui.sales.controller.SalesCollectionsController
		</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
	</managed-bean>

	<!-- ***************** FAILED LOGIN ******************** --> 
	<managed-bean>
		<managed-bean-name>failedLogin</managed-bean-name>
		<managed-bean-class>com.code.aon.bridge.session.FailedLogin</managed-bean-class>
		<managed-bean-scope>request</managed-bean-scope>
	</managed-bean>
	<!-- ***************** LOGGED USER ******************** --> 
	<managed-bean>
		<managed-bean-name>loggedUser</managed-bean-name>
		<managed-bean-class>com.code.aon.bridge.session.LoggedUser</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
	</managed-bean>

	<!-- *************** RESOURCE RESOLVER ***************** --> 
	<managed-bean>
		<managed-bean-name>aonResource</managed-bean-name>
		<managed-bean-class>
			com.code.aon.ui.resources.bean.ResourceResolver
		</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
		<managed-property>
			<property-name>resourceContextPath</property-name>
			<value>aon-finance</value>
		</managed-property>		
		<managed-property>
			<property-name>resourceURIPreffix</property-name>
			<value>/aonResource/3.2.0</value>
		</managed-property>		
	</managed-bean>

	<!--  *************** 
		AON CONFIGURATION
		***************** -->
	<managed-bean>
		<managed-bean-name>aonConfiguration</managed-bean-name>
		<managed-bean-class>
			com.code.aon.ui.common.controller.ConfigurationController
		</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
		<managed-property>
			<property-name>styleSheets</property-name>
			<list-entries>
				<value>/aonResource/aon-richCss.css</value>
				<value>#{aonResource.resolveLocal['/css/aon-finance.css']}</value>
			</list-entries>
		</managed-property>
	</managed-bean>

	<!--  **** CUSTOMER **** -->
	<managed-bean>
		<managed-bean-name>customerListeners</managed-bean-name>
	    <managed-bean-class>java.util.LinkedList</managed-bean-class>
		<managed-bean-scope>none</managed-bean-scope>
		<list-entries>
			<value-class>
				com.code.aon.ui.form.event.IControllerListener
			</value-class>
				<value>#{invoiceRegistryVetoListener}</value>
				<value>#{customerRBankChildListener}</value>
				<value>#{customerRPayMethodChildListener}</value>				
		</list-entries>
	</managed-bean>
	
	<!-- **** CUSTOMER RBANK **** -->
	<managed-bean>
		<managed-bean-name>customerRbank</managed-bean-name>
		<managed-bean-class>
			com.code.aon.ui.form.LinesController
		</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
		<managed-property>
			<property-name>pojo</property-name>
			<value>com.code.aon.finance.RegistryBank</value>
		</managed-property>
		<managed-property>
			<property-name>cascadeDelete</property-name>
			<value>true</value>
		</managed-property>
		<managed-property>
			<property-name>masterControllerName</property-name>
			<value>customer</value>
		</managed-property>
		<managed-property>
			<property-name>propertyMap</property-name>
			<map-entries>
				<map-entry>
					<key>id</key>
					<value>registry.id</value>
				</map-entry>
			</map-entries>
		</managed-property>
		<!-- 
		<managed-property>
			<property-name>listenerClasses</property-name>
			<list-entries>
				<value-class>com.code.aon.ui.form.event.IControllerListener</value-class>
				<value>#{rBankValidatorListener}</value>
				<value>#{rBankControllerListener}</value>
			</list-entries>
		</managed-property>
		-->
	</managed-bean>
	
	<managed-bean>
		<managed-bean-name>customerRBankChildListener</managed-bean-name>
		<managed-bean-class>
			com.code.aon.ui.form.listener.LinesControllerListener
		</managed-bean-class>
		<managed-bean-scope>none</managed-bean-scope>
		<managed-property>
			<property-name>childBean</property-name>
			<value>customerRbank</value>
		</managed-property>
		<managed-property>
			<property-name>aliasMap</property-name>
			<map-entries>
				<map-entry>
					<key>RegistryBank_registry_id</key>
                    <value>id</value>
				</map-entry>
			</map-entries>
		</managed-property>
	</managed-bean>

	<!-- **** CUSTOMER RPAYMETHOD **** -->
	<managed-bean>
		<managed-bean-name>customerRpayMethod</managed-bean-name>
		<managed-bean-class>
			com.code.aon.ui.finance.controller.RegistryRPayMethodController
		</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
		<managed-property>
			<property-name>pojo</property-name>
			<value>com.code.aon.finance.RegistryPayMethod</value>
		</managed-property>
		<managed-property>
			<property-name>cascadeDelete</property-name>
			<value>true</value>
		</managed-property>
		<managed-property>
			<property-name>masterControllerName</property-name>
			<value>customer</value>
		</managed-property>
		<managed-property>
			<property-name>propertyMap</property-name>
			<map-entries>
				<map-entry>
					<key>id</key>
					<value>registry.id</value>
				</map-entry>
			</map-entries>
		</managed-property>
		<managed-property>
			<property-name>listenerClasses</property-name>
			<list-entries>
				<value-class>com.code.aon.ui.form.event.IControllerListener</value-class>
				<value>#{rPayMethodControllerListener}</value>
			</list-entries>
		</managed-property>
	</managed-bean>
	
	<managed-bean>
		<managed-bean-name>customerRPayMethodChildListener</managed-bean-name>
		<managed-bean-class>
			com.code.aon.ui.form.listener.LinesControllerListener
		</managed-bean-class>
		<managed-bean-scope>none</managed-bean-scope>
		<managed-property>
			<property-name>childBean</property-name>
			<value>customerRpayMethod</value>
		</managed-property>
		<managed-property>
			<property-name>aliasMap</property-name>
			<map-entries>
				<map-entry>
					<key>RegistryPayMethod_registry_id</key>
                    <value>id</value>
				</map-entry>
			</map-entries>
		</managed-property>
	</managed-bean>	
	
	<managed-bean>
		<managed-bean-name>rPayMethodControllerListener</managed-bean-name>
		<managed-bean-class>
			com.code.aon.ui.finance.event.RegistryPayMethodControllerListener
		</managed-bean-class>
		<managed-bean-scope>none</managed-bean-scope>
	</managed-bean>

	<!-- ************* CUSTOMER FEE ***************** -->
	<managed-bean>
		<managed-bean-name>customerFee</managed-bean-name>
		<managed-bean-class>
			com.code.aon.ui.sales.controller.CustomerFeeController
		</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
		<managed-property>
			<property-name>queryOnStartUP</property-name>
			<value>true</value>
		</managed-property>
		<managed-property>
			<property-name>pojo</property-name>
			<value>com.code.aon.sales.CustomerFee</value>
		</managed-property>
		<managed-property>
			<property-name>listenerClasses</property-name>
			<list-entries>
				<value-class>com.code.aon.ui.form.event.IControllerListener</value-class>
				<value>#{customerFeeControllerListener}</value>
			</list-entries>
		</managed-property>
	</managed-bean>
	
	<managed-bean>
		<managed-bean-name>customerFeeControllerListener</managed-bean-name>
		<managed-bean-class>
			com.code.aon.ui.sales.event.CustomerFeeControllerListener
		</managed-bean-class>
		<managed-bean-scope>none</managed-bean-scope>
	</managed-bean>

	<!-- ************ FEEPREINVOICING ************* -->
	<managed-bean>
		<managed-bean-name>preInvoicing</managed-bean-name>
		<managed-bean-class>
			com.code.aon.ui.sales.controller.PreinvoicingController
		</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
	</managed-bean>
	

	<!--  **** SUPPLIER **** -->
	<managed-bean>
		<managed-bean-name>supplierListeners</managed-bean-name>
	    <managed-bean-class>java.util.LinkedList</managed-bean-class>
		<managed-bean-scope>none</managed-bean-scope>
		<list-entries>
			<value-class>
				com.code.aon.ui.form.event.IControllerListener
			</value-class>
			<value>#{supplierAddressListener}</value>
			<value>#{supplierMediaListener}</value>
			<value>#{supplierRBankChildListener}</value>
		</list-entries>
	</managed-bean>
	
	<!-- **** SUPPLIER RBANK **** -->
	<managed-bean>
		<managed-bean-name>supplierRbank</managed-bean-name>
		<managed-bean-class>
			com.code.aon.ui.form.LinesController
		</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
		<managed-property>
			<property-name>pojo</property-name>
			<value>com.code.aon.finance.RegistryBank</value>
		</managed-property>
		<managed-property>
			<property-name>cascadeDelete</property-name>
			<value>true</value>
		</managed-property>
		<managed-property>
			<property-name>masterControllerName</property-name>
			<value>supplier</value>
		</managed-property>
		<managed-property>
			<property-name>propertyMap</property-name>
			<map-entries>
				<map-entry>
					<key>id</key>
					<value>registry.id</value>
				</map-entry>
			</map-entries>
		</managed-property>
		<!-- 
		<managed-property>
			<property-name>listenerClasses</property-name>
			<list-entries>
				<value-class>com.code.aon.ui.form.event.IControllerListener</value-class>
				<value>#{rBankValidatorListener}</value>
				<value>#{rBankControllerListener}</value>
			</list-entries>
		</managed-property>
		-->
	</managed-bean>
	
	<!-- 
	<managed-bean>
		<managed-bean-name>rBankValidatorListener</managed-bean-name>
		<managed-bean-class>com.code.aon.ui.finance.event.RegistryBankValidationListener</managed-bean-class>
		<managed-bean-scope>none</managed-bean-scope>
	</managed-bean>
	
	<managed-bean>
		<managed-bean-name>rBankControllerListener</managed-bean-name>
		<managed-bean-class>com.code.aon.ui.finance.event.RegistryBankControllerListener</managed-bean-class>
		<managed-bean-scope>none</managed-bean-scope>
	</managed-bean>
	-->
	
	<managed-bean>
		<managed-bean-name>supplierRBankChildListener</managed-bean-name>
		<managed-bean-class>
			com.code.aon.ui.form.listener.LinesControllerListener
		</managed-bean-class>
		<managed-bean-scope>none</managed-bean-scope>
		<managed-property>
			<property-name>childBean</property-name>
			<value>supplierRbank</value>
		</managed-property>
		<managed-property>
			<property-name>aliasMap</property-name>
			<map-entries>
				<map-entry>
					<key>RegistryBank_registry_id</key>
                    <value>id</value>
				</map-entry>
			</map-entries>
		</managed-property>
	</managed-bean>	

	<!-- ************* MAILING ***************** -->
	<managed-bean>
		<managed-bean-name>mailing</managed-bean-name>
		<managed-bean-class>com.code.aon.ui.finance.mailing.MailingController</managed-bean-class>
		<managed-bean-scope>none</managed-bean-scope>
	</managed-bean>
	
	<!-- =================== Navigation Rules ================= -->
	
	<!-- =================== HOME ================= -->
	<navigation-rule>
		<navigation-case>
			<from-outcome>home</from-outcome>
			<to-view-id>/homepage.xhtml</to-view-id>
		</navigation-case>
	</navigation-rule>
	
	<navigation-rule>
		<navigation-case>
			<from-outcome>logout</from-outcome>
			<to-view-id>/home.jsf</to-view-id> 
			<redirect/>
		</navigation-case>
	</navigation-rule>
	
  <!-- =================== Fee Invoicing ========================== -->
  <navigation-rule>
    <navigation-case>
      <from-outcome>fee_invoicing_list</from-outcome>
      <to-view-id>/facelet/finance/fee_invoicing/list.xhtml</to-view-id>
    </navigation-case>
    <navigation-case>
      <from-outcome>fee_invoicing_search</from-outcome>
      <to-view-id>/facelet/finance/fee_invoicing/search.xhtml</to-view-id>
    </navigation-case>
    <navigation-case>
      <from-outcome>fee_invoicing_form</from-outcome>
      <to-view-id>/facelet/finance/fee_invoicing/form.xhtml</to-view-id>
    </navigation-case>
    <navigation-case>
      <from-outcome>fee_invoicing_fee_search</from-outcome>
      <to-view-id>/facelet/finance/fee_invoicing/fee_search.xhtml</to-view-id>
    </navigation-case>
    <navigation-case>
      <from-outcome>fee_invoice_address_data</from-outcome>
      <to-view-id>/facelet/finance/fee_invoicing/address/form.xhtml</to-view-id>
    </navigation-case>
   </navigation-rule> 

  <!-- =================== Account ================= -->
	<navigation-rule>
	  <navigation-case>
		<from-outcome>account_sw</from-outcome>
		<to-view-id>/facelet/account/sw/account.xhtml</to-view-id>
	  </navigation-case>
	  <navigation-case>
		<from-outcome>account_sw_search</from-outcome>
		<to-view-id>/facelet/account/sw/accountSearch.xhtml</to-view-id>
	  </navigation-case>
	</navigation-rule>

  <!-- ********************************* -->
  <!-- ************ MENU *************** -->
  <!-- ********************************* -->
  
  <navigation-rule>
    <navigation-case>
      <from-outcome>feePreInvoicing</from-outcome>
      <to-view-id>/facelet/finance/fee_pre_invoicing/search.xhtml</to-view-id>
    </navigation-case>
    <navigation-case>
      <from-outcome>feeInvoicing</from-outcome>
      <to-view-id>/facelet/finance/fee_invoicing/fee_search.xhtml</to-view-id>
    </navigation-case>
    <navigation-case>
      <from-outcome>invoiceManagement</from-outcome>
      <to-view-id>/facelet/finance/fee_invoicing/search.xhtml</to-view-id>
    </navigation-case>
  </navigation-rule>

</faces-config>