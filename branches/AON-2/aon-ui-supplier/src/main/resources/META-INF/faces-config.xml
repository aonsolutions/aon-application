<?xml version="1.0"?>
<!DOCTYPE faces-config PUBLIC
  "-//Sun Microsystems, Inc.//DTD JavaServer Faces Config 1.1//EN"
  "http://java.sun.com/dtd/web-facesconfig_1_1.dtd">

<faces-config>

	<managed-bean>
		<managed-bean-name>supplierLookup</managed-bean-name>
		<managed-bean-class>
			com.code.aon.ui.supplier.controller.SupplierLookupController
		</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
		<managed-property>
			<property-name>queryOnStartUP</property-name>
			<value>true</value>
		</managed-property>
		<managed-property>
			<property-name>foreignPojo</property-name>
			<value>com.code.aon.supplier.Supplier</value>
		</managed-property>
		<managed-property>
			<property-name>aliasPrefix</property-name>
			<value>Supplier</value>
		</managed-property>
		<managed-property>
			<property-name>foreignJoinProperties</property-name>
			<list-entries>
				<value>id</value>
			</list-entries>
		</managed-property>
		<managed-property>
			<property-name>foreignDisplayProperties</property-name>
			<list-entries>
				<value>id</value>
				<value>registry.document</value>
			</list-entries>
		</managed-property>
		<managed-property>
			<description>Needed for Search Select Window</description>
			<property-name>searchPagePath</property-name>
			<value>/facelet/sw/supplierSearch.faces</value>
		</managed-property>
		<managed-property>
			<description>Needed for New Window</description>
			<property-name>newPagePath</property-name>
			<value>/facelet/sw/supplierNew.faces</value>
		</managed-property>
		<managed-property>
			<property-name>listenerClasses</property-name>
			<list-entries>
				<value-class>com.code.aon.ui.form.event.IControllerListener</value-class>
				<value>#{supplierScopeListener}</value>
			</list-entries>
		</managed-property>
	</managed-bean>

	<managed-bean>
		<managed-bean-name>supplierScopeListener</managed-bean-name>
		<managed-bean-class>com.code.aon.ui.config.event.ScopeFilterListener</managed-bean-class>
		<managed-bean-scope>none</managed-bean-scope>
		<managed-property>
			<property-name>aliasName</property-name>
			<value>Supplier_scope_id</value>
		</managed-property>
	</managed-bean>

	<navigation-rule>
		<navigation-case>
			<from-outcome>supplier_sw</from-outcome>
			<to-view-id>/facelet/sw/supplier.faces</to-view-id>
		</navigation-case>
		<navigation-case>
			<from-outcome>supplier_sw_search</from-outcome>
			<to-view-id>/facelet/sw/supplierSearch.faces</to-view-id>
		</navigation-case>
	</navigation-rule>
	
</faces-config>