<?xml version="1.0" encoding="ISO-8859-1"?>
<dao>
	<bean class="com.code.aon.finance.Creditor">
		<alias names="id,registry_id,status,registry_name,registry_surname,registry_alias,registry_document,withholding,scope_id"/>
		<hibernate names="id,registry.id,status,registry.name,registry.surname,registry.alias,registry.document,withholding,scope.id"/>
	</bean>
	
	<bean class="com.code.aon.finance.Invoice" sqlName="invoice">
		<alias names="id,series,number,referenceCode,registry_id,registryAddress_id,issueDate,securityLevel,status,registryName,registryDocument,type,taxFree,surcharge,withholding,comments" />
		<hibernate names="id,series,number,referenceCode,registry.id,registryAddress.id,issueDate,securityLevel,status,registryName,registryDocument,type,taxFree,surcharge,withholding,comments" />
	</bean>
	
	<bean class="com.code.aon.finance.InvoiceDetail" sqlName="invoice_detail">
		<alias names="sourceId,description,discountExpression,id,invoice_id,invoice_type,item_id,line,price,quantity,source,item_product_type,taxableBase,taxes,,workPlace_id" />
		<hibernate names="sourceId,description,discountExpression,id,invoice.id,invoice.type,item.id,line,price,quantity,source,item.product.type,taxableBase,taxes,workPlace.id" />
	</bean>
	
	<bean class="com.code.aon.finance.InvoicingGroup" sqlName="invoicing_group">
		<alias names="id,parent_id,parent_surname,parent_name" />
		<hibernate names="id,parent.id,parent.surname,parent.name" />
	</bean>
	
	<bean class="com.code.aon.finance.Finance" sqlName="finance">
		<alias names="amount,bankAccount,bank_id,concept,dueDate,expenses,financeStatus,id,invoice_id,payMethod_id,payMethod_type,payment,registry_id,securityLevel,invoice_series,invoice_number,invoice_issueDate" />
		<hibernate names="amount,bankAccount,bank.id,concept,dueDate,expenses,financeStatus,id,invoice.id,payMethod.id,payMethod.type,payment,registry.id,securityLevel,invoice.series,invoice.number,invoice.issueDate" />
	</bean>
	
	<bean class="com.code.aon.finance.FinanceTracking" sqlName="finance_tracking">
		<alias names="amount,description,finance_id,id,trackingDate,type,finance_invoice_id" />
		<hibernate names="amount,description,finance.id,id,trackingDate,type,finance.invoice.id" />
	</bean>

	<bean class="com.code.aon.finance.FinanceBatchDetail" sqlName="fbatch_detail">
		<alias names="amount,financeBatch_id,finance_id,id,status,finance_invoice_series,finance_invoice_number,finance_dueDate" />
		<hibernate names="amount,financeBatch.id,finance.id,id,status,finance.invoice.series,finance.invoice.number,finance.dueDate" />
	</bean>
</dao>