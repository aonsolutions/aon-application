<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Tema personalizado para la Splash Screen -->
    <style name="Theme.AonApp.Splash" parent="Theme.SplashScreen">
        <!-- Fondo de la Splash Screen: debe ser un COLOR, no un drawable. -->
        <item name="windowSplashScreenBackground">@color/splash_background</item>
        <!-- Icono transparente: el splash del sistema queda en color plano. Su icono
             siempre se recorta a un círculo, así que la imagen a pantalla completa
             la pinta la app sobre el WebView (ver MainActivity). -->
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon_empty</item>
        <!-- Duración de la animación (0 para quitar animaciones) -->
        <item name="windowSplashScreenAnimationDuration">0</item>
        <!-- El tema que se aplica después de la Splash Screen -->
        <item name="postSplashScreenTheme">@style/Theme.Camara2</item>
    </style>

    <!-- Tema principal de la aplicación después de la Splash Screen -->
    <style name="Theme.Camara2" parent="android:Theme.Material.Light.NoActionBar" />
</resources>
