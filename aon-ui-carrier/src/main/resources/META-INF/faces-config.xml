<faces-config version="1.2"
	xmlns="http://java.sun.com/xml/ns/javaee"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://java.sun.com/xml/ns/javaee http://java.sun.com/xml/ns/javaee/web-facesconfig_1_2.xsd">

	<!--  *************** COLLECTIONS ***************** -->
	<managed-bean>
		<managed-bean-name>carrierCollections</managed-bean-name>
		<managed-bean-class>
			com.esferalia.aon.ui.carrier.controller.CarrierCollectionsController
		</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
	</managed-bean>

	<!-- ************ CARRIER ************** -->
	<managed-bean>
		<managed-bean-name>carrier</managed-bean-name>
		<managed-bean-class>com.esferalia.aon.ui.carrier.controller.CarrierController</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
		<managed-property>
			<property-name>pojo</property-name>
			<value>com.esferalia.aon.carrier.Carrier</value>
		</managed-property>
		<managed-property>
			<property-name>beanName</property-name>
			<value>carrier</value>
		</managed-property>
		<managed-property>
			<property-name>queryOnStartUP</property-name>
			<value>true</value>
		</managed-property>
		<managed-property>
			<property-name>defaultOrder</property-name>
			<value>Carrier_registry_name</value>
		</managed-property>
		<managed-property>
			<property-name>listenerClasses</property-name>
			<list-entries>
				<value-class>com.code.aon.ui.form.event.IControllerListener</value-class>
				<value>#{carrierSearch}</value>
				<value>#{carrierControllerListener}</value>
				<value>#{carrierAddressListener}</value>
				<value>#{carrierScopeListener}</value>
				<value>#{carrierMediaListener}</value>
				<value>#{carrierRBankChildListener}</value>
				<value>#{carrierRPayMethodChildListener}</value>
			</list-entries>
		</managed-property>		
	</managed-bean>

	<managed-bean>
		<managed-bean-name>carrierSearch</managed-bean-name>
		<managed-bean-class>com.code.aon.ui.registry.controller.event.RegistrySearchListener</managed-bean-class>		
		<managed-bean-scope>session</managed-bean-scope>
	</managed-bean>

	<managed-bean>
		<managed-bean-name>carrierControllerListener</managed-bean-name>
		<managed-bean-class>com.esferalia.aon.ui.carrier.event.CarrierControllerListener</managed-bean-class>		
		<managed-bean-scope>session</managed-bean-scope>
	</managed-bean>
	
	<managed-bean>
		<managed-bean-name>carrierAddressListener</managed-bean-name>
		<managed-bean-class>com.code.aon.ui.form.listener.LinesControllerListener</managed-bean-class>
		<managed-bean-scope>none</managed-bean-scope>
		<managed-property>
			<property-name>childBean</property-name>
			<value>carrierAddress</value>
		</managed-property>
		<managed-property>
			<property-name>aliasMap</property-name>
			<map-entries>
				<map-entry>
					<key>RegistryAddress_registry_id</key>
					<value>id</value>
				</map-entry>
			</map-entries>
		</managed-property>
	</managed-bean>
	
	<managed-bean>
		<managed-bean-name>carrierScopeListener</managed-bean-name>
		<managed-bean-class>com.code.aon.ui.config.event.ScopeFilterListener</managed-bean-class>
		<managed-bean-scope>none</managed-bean-scope>
		<managed-property>
			<property-name>aliasName</property-name>
			<value>Carrier_scope_id</value>
		</managed-property>
	</managed-bean>
	
	<managed-bean>
		<managed-bean-name>carrierMediaListener</managed-bean-name>
		<managed-bean-class>com.code.aon.ui.form.listener.LinesControllerListener</managed-bean-class>
		<managed-bean-scope>none</managed-bean-scope>
		<managed-property>
			<property-name>childBean</property-name>
			<value>carrierMedia</value>
		</managed-property>
		<managed-property>
			<property-name>aliasMap</property-name>
			<map-entries>
				<map-entry>
					<key>RegistryMedia_registry_id</key>
					<value>id</value>
				</map-entry>
			</map-entries>
		</managed-property>
	</managed-bean>
	
	<managed-bean>
		<managed-bean-name>carrierRBankChildListener</managed-bean-name>
		<managed-bean-class>com.code.aon.ui.form.listener.LinesControllerListener</managed-bean-class>
		<managed-bean-scope>none</managed-bean-scope>
		<managed-property>
			<property-name>childBean</property-name>
			<value>carrierRbank</value>
		</managed-property>
		<managed-property>
			<property-name>aliasMap</property-name>
			<map-entries>
				<map-entry>
					<key>RegistryBank_registry_id</key>
					<value>id</value>
				</map-entry>
			</map-entries>
		</managed-property>
	</managed-bean>
	
	<managed-bean>
		<managed-bean-name>carrierRPayMethodChildListener</managed-bean-name>
		<managed-bean-class>com.code.aon.ui.form.listener.LinesControllerListener</managed-bean-class>
		<managed-bean-scope>none</managed-bean-scope>
		<managed-property>
			<property-name>childBean</property-name>
			<value>carrierRPayMethod</value>
		</managed-property>
		<managed-property>
			<property-name>aliasMap</property-name>
			<map-entries>
				<map-entry>
					<key>RegistryPayMethod_registry_id</key>
					<value>id</value>
				</map-entry>
			</map-entries>
		</managed-property>
	</managed-bean>
	
	<!--  **** CARRIER ADDRESS **** -->
	<managed-bean>
		<managed-bean-name>carrierAddress</managed-bean-name>
		<managed-bean-class>com.code.aon.ui.form.LinesController</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
		<managed-property>
			<property-name>pojo</property-name>
			<value>com.code.aon.registry.RegistryAddress</value>
		</managed-property>
		<managed-property>
			<property-name>beanName</property-name>
			<value>carrierAddress</value>
		</managed-property>
		<managed-property>
			<property-name>cascadeDelete</property-name>
			<value>true</value>
		</managed-property>
		<managed-property>
			<property-name>masterControllerName</property-name>
			<value>carrier</value>
		</managed-property>
		<managed-property>
			<property-name>propertyMap</property-name>
			<map-entries>
				<map-entry>
					<key>id</key>
					<value>registry.id</value>
				</map-entry>
			</map-entries>
		</managed-property>		
		<managed-property>
			<property-name>listenerClasses</property-name>
			<list-entries>
				<value-class>com.code.aon.ui.form.event.IControllerListener</value-class>
				<value>#{carrierAddressControllerListener}</value>
			</list-entries>
		</managed-property>
	</managed-bean>
	
	<managed-bean>
		<managed-bean-name>carrierAddressControllerListener</managed-bean-name>
		<managed-bean-class> com.code.aon.ui.registry.controller.event.RegistryAddressControllerListener</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
	</managed-bean>
	
	<!--  **** CARRIER MEDIA **** -->
	<managed-bean>
		<managed-bean-name>carrierMedia</managed-bean-name>
		<managed-bean-class>com.code.aon.ui.registry.controller.RegistryMediaController</managed-bean-class> 
		<managed-bean-scope>session</managed-bean-scope>
		<managed-property>
			<property-name>pojo</property-name>
			<value>com.code.aon.registry.RegistryMedia</value>
		</managed-property>
		<managed-property>
			<property-name>beanName</property-name>
			<value>carrierMedia</value>
		</managed-property>
		<managed-property>
			<property-name>defaultOrder</property-name>
			<value>RegistryMedia_mediaType,RegistryMedia_administrative desc,RegistryMedia_commercial desc,RegistryMedia_technical desc</value>
		</managed-property>
		<managed-property>
			<property-name>cascadeDelete</property-name>
			<value>true</value>
		</managed-property>
		<managed-property>
			<property-name>masterControllerName</property-name>
			<value>carrier</value>
		</managed-property>
		<managed-property>
			<property-name>propertyMap</property-name>
			<map-entries>
				<map-entry>
					<key>id</key>
					<value>registry.id</value>
				</map-entry>
			</map-entries>
		</managed-property>		
	</managed-bean>
	
	<!-- **** CARRIER RBANK **** -->
	<managed-bean>
		<managed-bean-name>carrierRbank</managed-bean-name>
		<managed-bean-class>com.code.aon.ui.registry.controller.RegistryBankLinesController</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
		<managed-property>
			<property-name>pojo</property-name>
			<value>com.code.aon.registry.RegistryBank</value>
		</managed-property>
		<managed-property>
			<property-name>beanName</property-name>
			<value>carrierRbank</value>
		</managed-property>		
		<managed-property>
			<property-name>cascadeDelete</property-name>
			<value>true</value>
		</managed-property>
		<managed-property>
			<property-name>masterControllerName</property-name>
			<value>carrier</value>
		</managed-property>
		<managed-property>
			<property-name>propertyMap</property-name>
			<map-entries>
				<map-entry>
					<key>id</key>
					<value>registry.id</value>
				</map-entry>
			</map-entries>
		</managed-property>
		<managed-property>
			<property-name>listenerClasses</property-name>
			<list-entries>
				<value-class>com.code.aon.ui.form.event.IControllerListener 
				</value-class>
				<value>#{bankAccountValidatorListener}</value>
			</list-entries>
		</managed-property>
	</managed-bean>
	
	<!-- **** CARRIER RPAYMETHOD **** -->
	<managed-bean>
		<managed-bean-name>carrierRPayMethod</managed-bean-name>
		<managed-bean-class>com.esferalia.aon.ui.carrier.controller.CarrierRPayMethodController</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
		<managed-property>
			<property-name>pojo</property-name>
			<value>com.code.aon.registry.RegistryPayMethod</value>
		</managed-property>
		<managed-property>
			<property-name>beanName</property-name>
			<value>carrierRPayMethod</value>
		</managed-property>		
		<managed-property>
			<property-name>cascadeDelete</property-name>
			<value>true</value>
		</managed-property>
		<managed-property>
			<property-name>masterControllerName</property-name>
			<value>carrier</value>
		</managed-property>
		<managed-property>
			<property-name>propertyMap</property-name>
			<map-entries>
				<map-entry>
					<key>id</key>
					<value>registry.id</value>
				</map-entry>
			</map-entries>
		</managed-property>
		<managed-property>
			<property-name>listenerClasses</property-name>
			<list-entries>
				<value-class>com.code.aon.ui.form.event.IControllerListener 
				</value-class>
				<value>#{rPayMethodControllerListener}</value>
			</list-entries>
		</managed-property>
	</managed-bean>

   	<!-- ************************************************ -->
   	<!-- ************* NAVIGATION RULES ***************** -->
   	<!-- ************************************************ -->
	<!-- ************* CARRIER *************************** -->	
	<navigation-rule>
		<navigation-case>
			<from-outcome>carrier_search</from-outcome>
			<to-view-id>/com/esferalia/aon/ui/carrier/facelet/carrier/search.xhtml</to-view-id>
		</navigation-case>
		<navigation-case>
			<from-outcome>carrier_list</from-outcome>
			<to-view-id>/com/esferalia/aon/ui/carrier/facelet/carrier/list.xhtml</to-view-id>
		</navigation-case>
		<navigation-case>
			<from-outcome>carrier_form</from-outcome>
			<to-view-id>/com/esferalia/aon/ui/carrier/facelet/carrier/form.xhtml</to-view-id>
		</navigation-case>
	</navigation-rule>		
	
</faces-config>