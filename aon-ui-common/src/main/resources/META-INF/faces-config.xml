<faces-config version="1.2"
	xmlns="http://java.sun.com/xml/ns/javaee"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://java.sun.com/xml/ns/javaee http://java.sun.com/xml/ns/javaee/web-facesconfig_1_2.xsd">

	<application>
		<resource-bundle>
			<base-name>com.code.aon.common.i18n.messages</base-name>
			<var>bundle</var>
		</resource-bundle>
	</application>

	<!-- ********* ITransferObject CONVERTER ************* -->
	<converter>
	 <converter-for-class>com.code.aon.common.ITransferObject</converter-for-class>
	 <converter-class>com.code.aon.ui.common.converter.TransferObjectConverter</converter-class>
	</converter>

   	<!-- ************* ENUM CONVERTER ***************** -->
	<converter>
		<description>Conversor para intenacionalizar las opciones de los enumerados.</description>
		<converter-for-class>com.code.aon.common.enumeration.IResourceable</converter-for-class>
		<converter-class>com.code.aon.ui.common.converter.EnumLocaleConverter</converter-class>
	</converter>

   	<!-- ************* EMPTY STRING CONVERTER ***************** -->
	<converter>
		<description>Conversor para convertir String vacios en null.</description>
		<converter-id>aon.EmptyStringConverter</converter-id>
		<converter-class>com.code.aon.ui.common.converter.EmptyStringConverter</converter-class>
	</converter>
	
   	<!-- ************* TRIM STRING CONVERTER ***************** -->
	<converter>
		<description>Conversor para eliminar espacios en blanco sobrantes.</description>
		<converter-id>aon.TrimStringConverter</converter-id>
		<converter-class>com.code.aon.ui.common.converter.TrimStringConverter</converter-class>
	</converter>
	
   	<!-- ************* BIC CONVERTER ***************** -->	
	<validator>
		<validator-id>BICValidator</validator-id>	
		<validator-class>com.code.aon.ui.common.validator.BICValidator</validator-class>
	</validator>	
	
   	<!-- ************* BYTE ARRAY CONVERTER ***************** -->	
	<converter>
		<description>Conversor para convertir String a un byte array.</description>
		<converter-id>aon.ByteArrayConverter</converter-id>
		<converter-class>com.code.aon.ui.common.converter.ByteArrayConverter</converter-class>
	</converter>
	
   	<!-- ************* DATE CONVERTER ***************** -->	
	<converter>
		<description>Conversor para convertir String a un Date.</description>
		<converter-id>aon.DateConverter</converter-id>
		<converter-class>com.code.aon.ui.common.converter.DateConverter</converter-class>
	</converter>
	
	<!-- ************ TIMEZONE CONTROLLER	************** -->
	<managed-bean>
		<managed-bean-name>timeZoneController</managed-bean-name>
		<managed-bean-class> com.code.aon.ui.common.controller.TimeZoneController</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
	</managed-bean>

	<!--  *************** COLLECTIONS ***************** -->
	<managed-bean>
		<managed-bean-name>commonCollections</managed-bean-name>
		<managed-bean-class>com.code.aon.ui.common.controller.CommonCollections</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
	</managed-bean>

	<!--  **** ROLE MANAGER **** -->
	<managed-bean>
		<managed-bean-name>aonRole</managed-bean-name>
		<managed-bean-class>
			com.code.aon.ui.common.role.RoleManager
		</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
	</managed-bean>
		
	<!-- ***************** LOGGED USER ******************** --> 
	<managed-bean>
		<managed-bean-name>loggedUser</managed-bean-name>
		<managed-bean-class>com.code.aon.ui.common.controller.LoggedUser</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
	</managed-bean>

	<!-- ***************** DOMAIN RESOLVER ******************** --> 
	<managed-bean>
		<managed-bean-name>domainResolver</managed-bean-name>
		<managed-bean-class>com.code.aon.ui.common.controller.DomainResolver</managed-bean-class>
		<managed-bean-scope>request</managed-bean-scope>
	</managed-bean>
	
	<!-- ***************** FAILED LOGIN ******************** --> 
	<managed-bean>
		<managed-bean-name>failedLogin</managed-bean-name>
		<managed-bean-class>com.code.aon.ui.common.controller.FailedLogin</managed-bean-class>
		<managed-bean-scope>request</managed-bean-scope>
	</managed-bean>

	<!-- ***************** CUSTOMIZE ******************** --> 
	<managed-bean>
		<managed-bean-name>customize</managed-bean-name>
		<managed-bean-class>com.code.aon.ui.resources.bean.CustomizeController</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
	</managed-bean>

	<!-- ***************** BEAN CONFIGURATION ******************** --> 
	<managed-bean>
		<managed-bean-name>beanConfig</managed-bean-name>
		<managed-bean-class>com.code.aon.ui.common.controller.BeanConfiguration</managed-bean-class>
		<managed-bean-scope>application</managed-bean-scope>
	</managed-bean>
	
	<!-- ***************** AUDITABLE SEARCH ******************** --> 
	<managed-bean>
		<managed-bean-name>auditableSearch</managed-bean-name>
		<managed-bean-class>com.code.aon.ui.common.controller.AuditableSearchController</managed-bean-class>
		<managed-bean-scope>request</managed-bean-scope>
	</managed-bean>

	<!-- *************************************** -->
	<!-- ************ NAVIGATION *************** -->
	<!-- *************************************** -->

	<navigation-rule>
		<navigation-case>
			<from-outcome>logout</from-outcome>
			<to-view-id>/</to-view-id>
			<redirect />
		</navigation-case>
		<navigation-case>
			<from-outcome>start</from-outcome>
			<to-view-id>/</to-view-id>
			<redirect />
		</navigation-case>
		<navigation-case>
			<from-outcome>index</from-outcome>
			<to-view-id>/home.xhtml</to-view-id>
		</navigation-case>
		<navigation-case>
			<from-outcome>home</from-outcome>
			<to-view-id>/homepage.xhtml</to-view-id>
		</navigation-case>
		<navigation-case>
			<from-outcome>concurrentAccessError</from-outcome>
			<to-view-id>/concurrentAccessError.xhtml</to-view-id>
			<redirect />
		</navigation-case>		
	</navigation-rule>	
	
</faces-config>
