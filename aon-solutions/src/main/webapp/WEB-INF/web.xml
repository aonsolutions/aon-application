<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="http://xmlns.jcp.org/xml/ns/javaee" xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee http://xmlns.jcp.org/xml/ns/javaee/web-app_4_0.xsd" id="WebApp_ID" version="4.0">
  <display-name>aon-solutions</display-name>
  <welcome-file-list>
    <welcome-file>index.html</welcome-file>
    <welcome-file>index.htm</welcome-file>
    <welcome-file>index.jsp</welcome-file>
    <welcome-file>default.html</welcome-file>
    <welcome-file>default.htm</welcome-file>
    <welcome-file>default.jsp</welcome-file>
  </welcome-file-list>
  <servlet>
    <servlet-name>Resource Servlet</servlet-name>
    <servlet-class>net.aonsolutions.aon.gwt.aio.server.ResourceServlet</servlet-class>
    <init-param>
      <param-name>debug</param-name>
      <param-value>true</param-value>
    </init-param>
  </servlet>
  
  <servlet-mapping>
    <servlet-name>Resource Servlet</servlet-name>
    <url-pattern>/aon_gwt_aio/*</url-pattern>
  </servlet-mapping>
  
  	<!-- Aon GWT Template -->

	<servlet>
		<servlet-name>TemplateGwtServlet</servlet-name>
		<servlet-class>com.esferalia.aon.gwt.template.server.TemplatesServlet</servlet-class>
	</servlet>
	<servlet-mapping>
		<servlet-name>TemplateGwtServlet</servlet-name>
		<url-pattern>/aon_gwt_aio/gwt_template</url-pattern>
	</servlet-mapping>

	<servlet>
		<servlet-name>UploadProducts</servlet-name>
		<servlet-class>com.esferalia.aon.gwt.template.server.UploadProductsServlet</servlet-class>
	</servlet>
	<servlet-mapping>
		<servlet-name>UploadProducts</servlet-name>
		<url-pattern>/aon_gwt_aio/gwt_upload</url-pattern>
	</servlet-mapping>
</web-app>