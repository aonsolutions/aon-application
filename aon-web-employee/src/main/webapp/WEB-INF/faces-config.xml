<faces-config version="1.2"
	xmlns="http://java.sun.com/xml/ns/javaee"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://java.sun.com/xml/ns/javaee http://java.sun.com/xml/ns/javaee/web-facesconfig_1_2.xsd">
	
	<application>
		<message-bundle>com.code.aon.ui.common.i18n.messages</message-bundle>
		<locale-config>
			<default-locale>es</default-locale>
			<supported-locale>en</supported-locale>
		</locale-config> 
		<resource-bundle>
			<base-name>com.esferalia.aon.web.employee.i18n.application</base-name>
			<var>appBundle</var>
		</resource-bundle>
	</application>

	<!-- *************** RESOURCE RESOLVER ***************** --> 
	<managed-bean>
		<managed-bean-name>aonResource</managed-bean-name>
		<managed-bean-class>
			com.code.aon.ui.resources.bean.ResourceResolver
		</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
		<!-- 
		<managed-property>
			<property-name>resourceContextPath</property-name>
			<value>aon-desktop</value>
		</managed-property>
		-->
	</managed-bean>

	<!--  **** AON CONFIGURATION **** -->
	<managed-bean>
		<managed-bean-name>aonConfiguration</managed-bean-name>
		<managed-bean-class>
			com.code.aon.ui.common.controller.ConfigurationController
		</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
		<managed-property>
			<property-name>styleSheets</property-name>
			<list-entries>
				<value>#{aonResource.resolve['/aon-richCss.css']}</value>
				<value>#{aonResource.resolveLocal['/css/employee.css']}</value>
			</list-entries>
		</managed-property>
	</managed-bean>

	<!-- ************* MANAGER ***************** -->
	<managed-bean>
		<managed-bean-name>manager</managed-bean-name>
		<managed-bean-class>
			com.esferalia.aon.web.employee.controller.ManagerController
		</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
	</managed-bean>	

	<!-- ************* PASSWORD ***************** -->
	<managed-bean>
		<managed-bean-name>password</managed-bean-name>
		<managed-bean-class>
			com.esferalia.aon.web.employee.controller.PasswordController
		</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
	</managed-bean>	
		
	<!-- =================== Application Menu Navigation Rules ================= -->	

	<navigation-rule>
		<navigation-case>
			<from-outcome>changePassword</from-outcome>
			<to-view-id>/facelet/homepage/changePassword.xhtml</to-view-id> 
		</navigation-case>
	</navigation-rule>
	
   	<!-- ************************************************** -->
   	<!-- ************* OPTIONAL LISTENERS ***************** -->
   	<!-- ************************************************** -->

	<!-- ************ ENTERPRISE LISTENERS ******************* -->
	<managed-bean>
		<managed-bean-name>enterpriseOptionalListeners</managed-bean-name>
	    <managed-bean-class>java.util.LinkedList</managed-bean-class>
		<managed-bean-scope>none</managed-bean-scope>
		<list-entries>
			<value-class>com.code.aon.ui.form.event.IControllerListener</value-class>
			<!--  aon.ui.company -->
			<value>#{enterpriseTreeControllerListener}</value>
		</list-entries>
	</managed-bean>
</faces-config>