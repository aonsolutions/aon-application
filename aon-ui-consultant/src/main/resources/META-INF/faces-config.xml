<?xml version="1.0"?>
<!DOCTYPE faces-config PUBLIC
  "-//Sun Microsystems, Inc.//DTD JavaServer Faces Config 1.1//EN"
  "http://java.sun.com/dtd/web-facesconfig_1_1.dtd">

<faces-config>

	<!-- =================== Mailing ========================== -->
	<managed-bean>
		<managed-bean-name>mailing</managed-bean-name>
		<managed-bean-class>com.code.aon.ui.consultant.controller.MailingController</managed-bean-class>
		<managed-bean-scope>none</managed-bean-scope>
	</managed-bean>
	
  <!-- =================== Application Menu Navigation Rules ================= -->	
  <navigation-rule>
	<navigation-case>
		<from-outcome>content</from-outcome>
		<to-view-id>/facelet/homepage/content.faces</to-view-id>
	</navigation-case>
	<navigation-case>
        <from-outcome>firstContent</from-outcome>
        <to-view-id>/facelet/homepage/firstContent.faces</to-view-id>
    </navigation-case>
    <navigation-case>
        <from-outcome>inbox</from-outcome>
        <to-view-id>/facelet/inbox/inbox.faces</to-view-id>
    </navigation-case>
  </navigation-rule>
</faces-config>