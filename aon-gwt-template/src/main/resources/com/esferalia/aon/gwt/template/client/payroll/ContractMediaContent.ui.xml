<ui:UiBinder xmlns:ui='urn:ui:com.google.gwt.uibinder'
	xmlns:doc='urn:import:com.esferalia.aon.gwt.template.client' 
	xmlns:g='urn:import:com.google.gwt.user.client.ui'
	xmlns:aon='urn:import:com.esferalia.aon.gwt.common.client.widget'
	xmlns:c="urn:import:com.google.gwt.user.cellview.client"
	xmlns:d="urn:import:com.google.gwt.user.datepicker.client"
	 xmlns:b="http://java.sun.com/jstl/core">

	<ui:with type="com.esferalia.aon.gwt.common.client.i18n.CommonMessages"
		field="msg"></ui:with>
	
	<ui:with type="com.esferalia.aon.gwt.common.client.css.AonResources" field="aonResources"></ui:with>
		
	<ui:style>
	.aon-search-label-template{
		padding-top:3px;
	}
	
	.margin-top-left-right{
		margin-top: 2.5em;
		margin-left:10px;
		margin-right:10px;
	}
	
	@external .gwt-MenuBarPopup;
	.gwt-MenuBarPopup {
		margin: 0px !important;
		background: none repeat scroll 0% 0% #FFF !important;
		border: 1px solid #DDDDDD !important;
		padding: 4px 0px !important;
		box-shadow: 2px 2px 5px 1px #EBEBEF !important;
	}
	</ui:style>



	<g:DockLayoutPanel unit="EM"
		styleName="aondockLayoutPanel-template">
		<!-- Search & Options -->
		<g:north size="30">
			<g:HTMLPanel styleName="aon-panelGrid-search searchPanel-template {style.margin-top-left-right}">
				<div class="aon-panelGrid-search-info">
					<span class="aon-panelGrid-search-info-internal">
						<g:InlineLabel styleName="aon-outputLabel" text="{msg.search2Templates}" />
					</span>
					<g:InlineHTML visible="false">
					</g:InlineHTML>
				</div>
				<table class="aon-panelGrid">
					<tr>
						<td>
							<g:HorizontalPanel styleName="{aonResources.css.aonMarginLeft10}">
								<g:Label text="Ejercicio" styleName="{aonResources.css.aonPaddingRight}"></g:Label>
								<g:ListBox ui:field="yearList"></g:ListBox>
							</g:HorizontalPanel>
						</td>
					</tr>
					<tr>
						<td>
							<g:HorizontalPanel styleName="{aonResources.css.aonMarginLeft10}">
								<g:Label text="Detallado" styleName="{aonResources.css.aonPaddingRight}"></g:Label>
								<g:CheckBox ui:field="detailCheckBox"></g:CheckBox>
							</g:HorizontalPanel>
						</td>
					</tr>	
					<tr>
						<td>
							<g:HorizontalPanel styleName="{aonResources.css.aonMarginLeft10}">
								<g:Label text="Resumen" styleName="{aonResources.css.aonPaddingRight}"></g:Label>
								<g:CheckBox ui:field="resumeCheckBox"></g:CheckBox>
							</g:HorizontalPanel>
						</td>
					</tr>
				</table>
				
				<table>
					<tr>
						<td></td>
						<td></td>
						<td>
							<div class="aon-search-lookup-button" style="display: inline-block;">
								<g:Button ui:field="downloadButton" text="Informe"
									styleName="aon-icon-commandButton aon-icon-pdf">
								</g:Button>
							</div>
						</td>
					</tr>
				</table>
			</g:HTMLPanel>
		</g:north>
		<g:center>
			<g:Label text=""></g:Label>
		</g:center>

	</g:DockLayoutPanel>

</ui:UiBinder>
