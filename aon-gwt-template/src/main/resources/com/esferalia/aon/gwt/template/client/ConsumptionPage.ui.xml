<ui:UiBinder xmlns:ui='urn:ui:com.google.gwt.uibinder'
	xmlns:doc='urn:import:com.esferalia.aon.gwt.template.client' 
	xmlns:g='urn:import:com.google.gwt.user.client.ui'
	xmlns:aon='urn:import:com.esferalia.aon.gwt.common.client.widget'
	xmlns:c="urn:import:com.google.gwt.user.cellview.client"
	xmlns:d="urn:import:com.google.gwt.user.datepicker.client"
	 xmlns:b="http://java.sun.com/jstl/core">

	<ui:with type="com.esferalia.aon.gwt.common.client.i18n.CommonMessages"
		field="msg"></ui:with>

	<ui:style>
	.aon-search-label-template{
		padding-top:3px;
	}
	
	.padding_left_template{
		padding-left:20px;
	}
	
	@external .gwt-MenuBarPopup;
	.gwt-MenuBarPopup {
		margin: 0px !important;
		background: none repeat scroll 0% 0% #FFF !important;
		border: 1px solid #DDDDDD !important;
		padding: 4px 0px !important;
		box-shadow: 2px 2px 5px 1px #EBEBEF !important;
	}
	</ui:style>

	<g:DockLayoutPanel unit="EM" styleName="aondockLayoutPanel-template">
		<g:north size="2">
			<g:FlowPanel styleName="aon-finding-title-toolbar">
				<g:HorizontalPanel visible="true">
					<g:HTMLPanel styleName="aon-finding-title">
						<g:HTMLPanel styleName="aon-finding-title-internal">
							<g:Label ui:field="titleLabel" styleName="aon-outputText" text="{msg.aggregateConsumptionTemplates}" />
						</g:HTMLPanel>
					</g:HTMLPanel>
					<g:HTMLPanel styleName="aon-finding-subtitle">
						<g:HTMLPanel styleName="aon-finding-aubtitle-internal">
							<g:Label styleName="aon-outputText {style.aon-search-label-template}" text="{msg.searchTemplates}" />
						</g:HTMLPanel>
					</g:HTMLPanel>
					<g:HorizontalPanel styleName="aon-finding-toolbar">
						<g:HTMLPanel styleName="aon-finding-toolbar-item-group">
							<g:Button ui:field="cleanButton" visible="true"
								styleName='aon-finding-toolbar-item aon-icon-rubber' text="{msg.cleanTemplates}" />
						</g:HTMLPanel>
					</g:HorizontalPanel>
				</g:HorizontalPanel>
			</g:FlowPanel>
		</g:north>
		<g:center>
			<g:DockLayoutPanel unit="EM"
				styleName="aondockLayoutPanel-template">
				<!-- Search & Options -->
				<g:north size="30">
					<g:HTMLPanel styleName="aon-panelGrid-search searchPanel-template">
						<div class="aon-panelGrid-search-info">
							<span class="aon-panelGrid-search-info-internal">
								<g:InlineLabel styleName="aon-outputLabel" text="{msg.search2Templates}" />
							</span>
							<g:InlineHTML visible="false">
							</g:InlineHTML>
						</div>
						<table class="aon-panelGrid">
							<tr>
								<td>
									<span class="aon-panelGrid-search-info-internal2-template">
										<g:InlineLabel styleName="aon-outputLabel" text="{msg.workplace}" />
									</span>
								</td>
								<td>
									<g:VerticalPanel ui:field="hotelBoxPanel" >
									</g:VerticalPanel>
								</td>
						
								<td>
									<span class="aon-panelGrid-search-info-internal2-template">
										<g:InlineLabel styleName="aon-outputLabel" text="{msg.warehouseTemplates}" />
									</span>
								</td>
								<td>
									<g:VerticalPanel ui:field="warehouseBoxPanel" >
									</g:VerticalPanel>
								</td>
								
								<td>
									<span class="aon-panelGrid-search-info-internal2-template">
										<g:InlineLabel styleName="aon-outputLabel" text="{msg.selectedTemplates}" />
									</span>
								</td>
								<td>
									<g:VerticalPanel ui:field="selectedBoxPanel" >
									</g:VerticalPanel>
								</td>
							</tr>
							<tr>
								<td></td>
								<td></td>
								<td></td>
								<td>
									<g:HorizontalPanel>
										<g:CheckBox ui:field="warehouseCheckBox"></g:CheckBox>
										<g:InlineLabel text="Seleccionar todos"></g:InlineLabel>
									</g:HorizontalPanel>
								</td>
								<td></td>
								<td></td>
							</tr>
						</table>
						<g:HTMLPanel ui:field="datePanel">
							<table>	
								<tr>
									<td>
										<span class="aon-panelGrid-search-info-internal2-template">
											<g:InlineLabel styleName="aon-outputLabel" text="{msg.category}" />
										</span>
									</td>
									<td>
										<g:ListBox ui:field="categoryListBox"></g:ListBox>
									</td>
								
								</tr>
								<tr>
									<td>
										<span class="aon-panelGrid-search-info-internal2-template">
											<g:InlineLabel styleName="aon-outputLabel" text="Fecha Inicio" />
										</span>
									</td>
									<td>
										<d:DateBox ui:field="startDate" styleName="aon-inputText"></d:DateBox>
									</td>
									<td>
										<span class="aon-panelGrid-search-info-internal2-template">
											<g:InlineLabel styleName="aon-outputLabel" text="Fecha Fin" />
										</span>
									</td>
									<td>
										<d:DateBox ui:field="endDate" styleName="aon-inputText"></d:DateBox>
									</td>
									<td>
										<g:HorizontalPanel>
											<g:CheckBox ui:field="twoLastCheckBox"></g:CheckBox>
											<g:InlineLabel text="Últimos inventarios"></g:InlineLabel>
											<g:CheckBox ui:field="withoutInvCheckBox"></g:CheckBox>
											<g:InlineLabel text="Sin inventarios"></g:InlineLabel>
										</g:HorizontalPanel>
									</td>
								</tr>
							</table>
						</g:HTMLPanel>
						<table>	
							<tr>
								<td>
									<span class="aon-panelGrid-search-info-internal2-template">
										<g:InlineLabel styleName="aon-outputLabel" text="Detallado" />
									</span>
								</td>
								<td >
									<g:CheckBox ui:field="detailCheckBox"></g:CheckBox> 
								</td>
								<td>
									<span class="aon-panelGrid-search-info-internal2-template">
										<g:InlineLabel styleName="aon-outputLabel" text="Añadir Información del envasado" />
									</span>
								</td>
								<td>
									<g:CheckBox ui:field="packagedCheckBox"></g:CheckBox> 
								</td>
								<td>
									<span class="aon-panelGrid-search-info-internal2-template">
										<g:InlineLabel styleName="aon-outputLabel" text="Recuento de errores" />
									</span>
								</td>
								<td>
									<g:CheckBox ui:field="errorCheckBox"></g:CheckBox> 
								</td>
								
								<td>
									<span class="aon-panelGrid-search-info-internal2-template">
										<g:InlineLabel styleName="aon-outputLabel" text="Consumo con diferencias" />
									</span>
								</td>
								<td>
									<g:CheckBox ui:field="difCheckBox"></g:CheckBox> 
								</td>
							</tr>
						</table>
						<table>
							<tr>
								<td></td>
								<td>
									<!-- <div class="aon-search-lookup-button" style="display: inline-block;">
										<g:Button ui:field="pdfButton" text="{msg.listTemplates}" 
											styleName="aon-icon-commandButton aon-icon-pdf">
										</g:Button>
									</div>
									 -->
								</td>
								<td>
									<div class="aon-search-lookup-button" style="display: inline-block;">
										<g:Button ui:field="excelButton" text="{msg.listTemplates}" enabled="false"
											styleName="aon-icon-commandButton aon-icon-excel">
										</g:Button>
									</div>
								</td>
							</tr>
						</table>
					</g:HTMLPanel>
				</g:north>
				<g:center>
					<g:Label text=""></g:Label>
				</g:center>

			</g:DockLayoutPanel>
		</g:center>
	</g:DockLayoutPanel>
</ui:UiBinder>
