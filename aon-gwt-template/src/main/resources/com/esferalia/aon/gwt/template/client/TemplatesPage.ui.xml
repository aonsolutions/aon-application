<ui:UiBinder xmlns:ui='urn:ui:com.google.gwt.uibinder' xmlns:doc='urn:import:com.esferalia.aon.gwt.template.client'
	xmlns:g='urn:import:com.google.gwt.user.client.ui' xmlns:aon='urn:import:com.esferalia.aon.gwt.common.client.widget'
	xmlns:c="urn:import:com.google.gwt.user.cellview.client" xmlns:b="http://java.sun.com/jstl/core"
	>

	<ui:style>

		@external .gwt-MenuBarPopup;

		.gwt-MenuBarPopup {
    		margin: 0px !important;
    		background: none repeat scroll 0% 0% #FFF !important;
    		border: 1px solid #DDDDDD !important;
    		padding: 4px 0px !important;
    		box-shadow: 2px 2px 5px 1px #EBEBEF !important;
		}
	
	</ui:style>
		<g:DockLayoutPanel unit="EM" styleName="aondockLayoutPanel-template">
			<g:north size="2">
				<g:FlowPanel styleName="aon-finding-title-toolbar">
					<g:HorizontalPanel  visible="true">
						<g:HTMLPanel styleName="aon-finding-title">
							<g:HTMLPanel styleName="aon-finding-title-internal">
								<g:Label styleName="aon-outputText">Plantillas</g:Label>
							</g:HTMLPanel>
						</g:HTMLPanel>
						<g:HTMLPanel styleName="aon-finding-subtitle">
							<g:HTMLPanel styleName="aon-finding-aubtitle-internal">
								<g:Label styleName="aon-outputText" text=" " />
							</g:HTMLPanel>
						</g:HTMLPanel>
						<g:HorizontalPanel  styleName="aon-finding-toolbar">
							<g:HTMLPanel styleName="aon-finding-toolbar-item-group">
								<g:Button ui:field="new_button" visible="true" styleName='aon-finding-toolbar-item aon-icon-new'
									text="Nuevo" />
							</g:HTMLPanel>
							<g:HTMLPanel styleName="aon-finding-toolbar-item-group">
								<g:Button ui:field="edit_button" visible="false" styleName='aon-finding-toolbar-item aon-icon-edit'
									text="Editar" />
							</g:HTMLPanel>
							<g:HTMLPanel styleName="aon-finding-toolbar-item-group">
								<g:Button ui:field="delete_button" visible="false" styleName='aon-finding-toolbar-item aon-icon-delete'
									text="Borrar" />
							</g:HTMLPanel>
							<g:HTMLPanel styleName="aon-finding-toolbar-item-group">
								<g:Button ui:field="import_button" visible="false" styleName='aon-finding-toolbar-item aon-icon-import-excel-trans'
									text="Importar"/>
							</g:HTMLPanel>	
							<g:HTMLPanel styleName="aon-finding-toolbar-item-group">
								<g:Button ui:field="export_button" visible="false" styleName='aon-finding-toolbar-item aon-icon-export-excel-trans'
									text="Exportar"/>
							</g:HTMLPanel>						
						</g:HorizontalPanel>		
					</g:HorizontalPanel>
				</g:FlowPanel>
			</g:north>
			<g:center >
				<g:DockLayoutPanel unit="EM" styleName="aondockLayoutPanel-template">
					<!-- Search & Options -->
					<g:north size="8">
						<g:HTMLPanel  styleName="aon-panelGrid-search searchPanel-template">
							<div class="aon-panelGrid-search-info">
								<span class="aon-panelGrid-search-info-internal">Filtrar:</span>
							<g:InlineHTML  visible="false">			
							</g:InlineHTML>
							</div>
							<table class="aon-panelGrid">
								<tr>
									<td>
										<span class="aon-panelGrid-search-info-internal2-template">Nombre:</span>
									</td>
									<td style="width:550px">
										<g:TextBox ui:field="nameSearchBox"  styleName="aon-search-box-template">
										</g:TextBox>
									</td>
									<td>
										<span class="aon-panelGrid-search-info-internal2-template">Tipo:</span>
									</td>
									<td style="width:550px">
										<g:TextBox ui:field="typeSearchBox" styleName="aon-search-box-template">
										</g:TextBox>
									</td>
									<td><g:Button ui:field="nameSearchButton" visible="false" styleName="aon-editDataTable-button"> </g:Button> 
									</td>
									<td><g:Button ui:field="typeSearchButton" visible="false" styleName="aon-editDataTable-button"> </g:Button> 
									</td>
								</tr>
							</table>
						</g:HTMLPanel>
					</g:north>
					<g:center>
						<c:DataGrid ui:field='dataGrid' visible="true" styleName="aon_dataGrid-template">
							    
						</c:DataGrid>		
					</g:center>

				</g:DockLayoutPanel>
			</g:center>
		</g:DockLayoutPanel>
</ui:UiBinder>
