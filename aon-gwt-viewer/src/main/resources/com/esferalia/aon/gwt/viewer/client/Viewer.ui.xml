<ui:UiBinder xmlns:ui='urn:ui:com.google.gwt.uibinder'
	xmlns:g='urn:import:com.google.gwt.user.client.ui' >

	<ui:style>
	
		*:focus  {  outline: none;  }
	
		@sprite .button {
			gwt-image: 'viewer';
		}
	
		@sprite .loading {
			gwt-image: 'loading';
			color: #FFF;
			font-weight: bold;
			position: absolute;
			top: 50%;
			left: 50%;
			overflow: visible;
			padding-left: 25px;
			background-color: transparent;
		}

		@external .page;
		.page {
			background: white;
		}
	
	</ui:style>
	
	<ui:with type="com.esferalia.aon.gwt.common.client.css.ViewerResources" field="viewerResources"></ui:with>

	<ui:image field='viewer' src='viewer.png' />
	<ui:image field='loading' src='loading.gif' />

	<g:FocusPanel ui:field="focusPanel">
		<g:FlowPanel >
			<g:ScrollPanel styleName="{viewerResources.css.editorViewer}" ui:field="scrollPanel">
				<g:VerticalPanel styleName="{viewerResources.css.documentViewer}">
					<g:HTML ui:field='html' styleName="reset" wordWrap='true' >
					</g:HTML>
				</g:VerticalPanel>
			</g:ScrollPanel>
			<g:Grid styleName="{viewerResources.css.toolbarViewer}" ui:field="menu" visible="false" >
				<g:row>
	
					<g:customCell styleName="{viewerResources.css.toolbarLeftViewer}">
						<g:HorizontalPanel>
							<g:Label ui:field="title" styleName="{viewerResources.css.labelViewer}"></g:Label>
						</g:HorizontalPanel>
					</g:customCell>
	
					<g:customCell styleName="{viewerResources.css.toolbarCenterViewer}">
						<g:HorizontalPanel>
							<g:Button ui:field="print"
								styleName="{style.button} {viewerResources.css.toolbarButtonViewer} {viewerResources.css.printButtonViewer}"></g:Button>
							<g:Button ui:field="share"
								styleName="{style.button} {viewerResources.css.toolbarButtonViewer} {viewerResources.css.shareButtonViewer}"></g:Button>
							<g:Button ui:field="download"
								styleName="{style.button} {viewerResources.css.toolbarButtonViewer} {viewerResources.css.downloadButtonViewer}"></g:Button>
						</g:HorizontalPanel>
					</g:customCell>
	
					<g:customCell styleName="{viewerResources.css.toolbarRightViewer}">
						<g:HorizontalPanel>
							<g:Button ui:field="zoom_plus"
								styleName="{style.button} {viewerResources.css.toolbarButtonViewer} {viewerResources.css.zoomInButtonViewer}"></g:Button>
							<g:Button ui:field="zoom_minus"
								styleName="{style.button} {viewerResources.css.toolbarButtonViewer} {viewerResources.css.zoomOutButtonViewer}"></g:Button>
							<g:Button ui:field="close"
								styleName="{style.button} {viewerResources.css.toolbarButtonViewer} {viewerResources.css.closeButtonViewer}"></g:Button>
						</g:HorizontalPanel>
					</g:customCell>
	
				</g:row>
			</g:Grid>
	
			<g:Label styleName="{style.loading}" ui:field="load"  visible="false" >Cargando</g:Label>
			
			<g:Button ui:field="next"
				styleName="{style.button} {viewerResources.css.sidebarButtonViewer} {viewerResources.css.nextButtonViewer}" visible="false" enabled="false"></g:Button>
			<g:Button ui:field="prev"
				styleName="{style.button} {viewerResources.css.sidebarButtonViewer} {viewerResources.css.prevButtonViewer}" visible="false" enabled="false"></g:Button>
	
	
		</g:FlowPanel>
	</g:FocusPanel>


</ui:UiBinder>