<ui:UiBinder xmlns:ui='urn:ui:com.google.gwt.uibinder'
	xmlns:g='urn:import:com.google.gwt.user.client.ui' >

	<ui:style>
	
	*:focus  {  outline: none;  }
	
	.label {
		color: #FFF;
		min-height: 22px;
		padding-left: 25px;
		padding-top: 10px;
	}
	
	.editor {
		background: rgba(0, 0, 0, 0.9);
	}
	
	.document {
		margin-top: 120px;
		margin-left: auto;
		margin-right: auto;
		margin-bottom: 15px;
	}
	
	.panel {
		width:400px;
		height:200px;
		background-color:white;
	}
	
	.hpanel{
		background-color:gainsboro;
		padding-right: 100%;
	}
	
	.button-style{
		font-weight: bold;
		padding-left: 30px;
   	 	color: #000;
    	padding-top: 5px;
    	text-transform: uppercase;
    	font-size: 1em;
    	margin: 0 0 0 0px;
    	border: 0;
    	border-right: #bbb 1px solid;
    	text-align: left;
    	cursor: pointer;
    	width: auto;
    	overflow: visible;
    	height: 26px;
    	background-position-x: 10px;
	}
	
	@external .gwt-Button;
	.gwt-Button {
	    padding: 1px 5px !important;
		border-radius: 0px !important;
    	-moz-border-radius: 0px !important;
	}

	</ui:style>
	
	<ui:with type="com.esferalia.aon.gwt.common.client.css.AonResources"
		field="aonResources"></ui:with>
		
	<g:FocusPanel ui:field="focusPanel">
		<g:FlowPanel >
			<g:ScrollPanel styleName="{style.editor}" ui:field="scrollPanel">
				<g:DockLayoutPanel styleName="{style.document} {style.panel}" unit="PX" ui:field="dockLayoutPanel">
					<g:north size="26" >
						<g:HorizontalPanel styleName="{style.hpanel}">
							<g:Button ui:field="driveButton" visible="false" styleName="{style.button-style} aon-icon-google-drive" text="Drive"> </g:Button>
							<g:Button ui:field="gmailButton" visible="false" styleName="{style.button-style} aon-icon-google-gmail" text="Gmail"> </g:Button>
							<g:Button ui:field="emailButton" visible="true" styleName="{style.button-style} aon-icon-webmail2" text="Email"> </g:Button>
						</g:HorizontalPanel>
					</g:north>
		
					<g:center>
						<g:HTMLPanel styleName="form-document">
							<div style="height:120px;padding-left:20px;">
								<g:FlexTable ui:field="content"></g:FlexTable>
							</div>
							<div class="buttons-document">
								<g:Button ui:field="cancelButton"></g:Button>
								<g:Button ui:field="acceptButton"></g:Button>
							</div>
						</g:HTMLPanel>
					</g:center>
				
				</g:DockLayoutPanel>
			</g:ScrollPanel>
		</g:FlowPanel>
		
		
	</g:FocusPanel>


</ui:UiBinder>