<faces-config version="1.2"
	xmlns="http://java.sun.com/xml/ns/javaee"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://java.sun.com/xml/ns/javaee http://java.sun.com/xml/ns/javaee/web-facesconfig_1_2.xsd">

	<!--  *************** COLLECTIONS ***************** -->
	<managed-bean>
		<managed-bean-name>tasCollections</managed-bean-name>
		<managed-bean-class>
			com.code.aon.ui.tas.controller.TasCollectionsController
		</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
	</managed-bean>	

	<!--  *************** MAKE ***************** -->
	<managed-bean>
		<managed-bean-name>make</managed-bean-name>
		<managed-bean-class>
			com.code.aon.ui.form.BasicController
		</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
		<managed-property>
			<property-name>queryOnStartUP</property-name>
			<value>true</value>
		</managed-property>
		<managed-property>
			<property-name>pojo</property-name>
			<value>com.code.aon.tas.Make</value>
		</managed-property>
		<managed-property>
			<property-name>beanName</property-name>
			<value>make</value>
		</managed-property>
		<managed-property>
			<property-name>defaultOrder</property-name>
			<value>Make_name</value>
		</managed-property>
		<managed-property>
			<property-name>listenerClasses</property-name>
			<list-entries>
				<value-class>com.code.aon.ui.form.event.IControllerListener</value-class>
				<value>#{makeCollectionInitializer}</value>
			</list-entries>
		</managed-property>				
	</managed-bean>
	
	<managed-bean>
		<managed-bean-name>makeCollectionInitializer</managed-bean-name>
		<managed-bean-class>com.code.aon.ui.tas.event.MakeCollectionInitializer</managed-bean-class>
		<managed-bean-scope>none</managed-bean-scope>
	</managed-bean>	

	<!--  *************** MODEL ***************** -->
	<managed-bean>
		<managed-bean-name>model</managed-bean-name>
		<managed-bean-class>
			com.code.aon.ui.form.BasicController
		</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
		<managed-property>
			<property-name>queryOnStartUP</property-name>
			<value>true</value>
		</managed-property>
		<managed-property>
			<property-name>pojo</property-name>
			<value>com.code.aon.tas.Model</value>
		</managed-property>
		<managed-property>
			<property-name>beanName</property-name>
			<value>model</value>
		</managed-property>
		<managed-property>
			<property-name>defaultOrder</property-name>
			<value>Model_make_name,Model_name</value>
		</managed-property>
	</managed-bean>

	<!-- ************ MODEL LOOKUP ************** -->
	<managed-bean>
		<managed-bean-name>modelLookup</managed-bean-name>
		<managed-bean-class>com.code.aon.faces.controller.RichLookupBean</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
		<managed-property>
			<property-name>beanName</property-name>
			<value>modelLookup</value>
		</managed-property>
		<managed-property>
			<property-name>foreignPojo</property-name>
			<value>com.code.aon.tas.Model</value>
		</managed-property>
		<managed-property>
			<property-name>defaultOrder</property-name>
			<value>Model_make_name,Model_name</value>
		</managed-property>		
		<managed-property>
			<property-name>suggestAlias</property-name>
			<value>Model_name</value>
		</managed-property>		
		<managed-property>
			<property-name>listPagePath</property-name>
			<value>/com/code/aon/ui/tas/facelet/lookup/model/list.xhtml</value>
		</managed-property>
		<managed-property>
			<property-name>searchPagePath</property-name>
			<value>/com/code/aon/ui/tas/facelet/lookup/model/search.xhtml</value>
		</managed-property>				
	</managed-bean>

	<!--  *************** TAS ITEM ***************** -->
	<managed-bean>
		<managed-bean-name>tasItem</managed-bean-name>
		<managed-bean-class>
			com.code.aon.ui.form.BasicController
		</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
		<managed-property>
			<property-name>queryOnStartUP</property-name>
			<value>false</value>
		</managed-property>
		<managed-property>
			<property-name>pojo</property-name>
			<value>com.code.aon.tas.TasItem</value>
		</managed-property>
		<managed-property>
			<property-name>beanName</property-name>
			<value>tasItem</value>
		</managed-property>
		<managed-property>
			<property-name>defaultOrder</property-name>
			<value>TasItem_model_make_name,TasItem_model_name,TasItem_publicCode</value>
		</managed-property>
		<managed-property>
			<property-name>listenerClasses</property-name>
			<list-entries>
				<value-class>
					com.code.aon.ui.form.event.IControllerListener
				</value-class>
				<value>#{tasItemSearch}</value>
			</list-entries>
		</managed-property>
	</managed-bean>

	<managed-bean>
		<managed-bean-name>tasItemSearch</managed-bean-name>
		<managed-bean-class>
			com.code.aon.ui.tas.event.TasItemSearchListener
		</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
	</managed-bean>
	
	<!-- ************ TAS ITEM LOOKUP ************** -->
	<managed-bean>
		<managed-bean-name>tasItemLookup</managed-bean-name>
		<managed-bean-class>com.code.aon.faces.controller.RichLookupBean</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
		<managed-property>
			<property-name>beanName</property-name>
			<value>tasItemLookup</value>
		</managed-property>
		<managed-property>
			<property-name>foreignPojo</property-name>
			<value>com.code.aon.tas.TasItem</value>
		</managed-property>
		<managed-property>
			<property-name>defaultOrder</property-name>
			<value>TasItem_model_make_name,TasItem_model_name,TasItem_publicCode</value>
		</managed-property>		
		<managed-property>
			<property-name>suggestAlias</property-name>
			<value>TasItem_model_name</value>
		</managed-property>		
		<managed-property>
			<property-name>listPagePath</property-name>
			<value>/com/code/aon/ui/tas/facelet/lookup/tasItem/list.xhtml</value>
		</managed-property>
		<managed-property>
			<property-name>searchPagePath</property-name>
			<value>/com/code/aon/ui/tas/facelet/lookup/tasItem/search.xhtml</value>
		</managed-property>				
		<managed-property>
			<property-name>newPagePath</property-name>
			<value>/com/code/aon/ui/tas/facelet/tasItem/formNewContent.xhtml</value>
		</managed-property>
		<managed-property>
			<property-name>listenerClasses</property-name>
			<list-entries>
				<value-class>
					com.code.aon.ui.form.event.IControllerListener
				</value-class>
				<value>#{tasItemSearch}</value>
			</list-entries>
		</managed-property>
	</managed-bean>

	<!-- ************ PROJECT TAS ************** -->
	<managed-bean>
		<managed-bean-name>projectTas</managed-bean-name>
		<managed-bean-class>
			com.code.aon.ui.tas.controller.ProjectTasController
		</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
		<managed-property>
			<property-name>queryOnStartUP</property-name>
			<value>true</value>
		</managed-property>
		<managed-property>
			<property-name>pojo</property-name>
			<value>com.code.aon.tas.ProjectTas</value>
		</managed-property>
		<managed-property>
			<property-name>beanName</property-name>
			<value>projectTas</value>
		</managed-property>
		<managed-property>
			<property-name>defaultExpressions</property-name>
			<map-entries>
				<map-entry>
					<key>ProjectTas_project_tas</key>
					<value>true</value>
				</map-entry>
			</map-entries>
		</managed-property>		
		<managed-property>
			<property-name>defaultOrder</property-name>
			<value>ProjectTas_project_date desc,ProjectTas_series desc,ProjectTas_number desc</value>
		</managed-property>
		<managed-property>
			<property-name>listenerClasses</property-name>
			<list-entries>
				<value-class>
					com.code.aon.ui.form.event.IControllerListener
				</value-class>
				<value>#{projectTasSearch}</value>
				<value>#{projectTasController}</value>
				<value>#{projectTasHeaderControllerListener}</value>
			</list-entries>
		</managed-property>
	</managed-bean>

	<managed-bean>
		<managed-bean-name>projectTasSearch</managed-bean-name>
		<managed-bean-class>
			com.code.aon.ui.tas.event.ProjectTasSearchListener
		</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
	</managed-bean>
	
	<managed-bean>
		<managed-bean-name>projectTasController</managed-bean-name>
		<managed-bean-class>
			com.code.aon.ui.tas.event.ProjectTasControllerListener
		</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
	</managed-bean>
	
 	<managed-bean>
		<managed-bean-name>projectTasHeaderControllerListener</managed-bean-name>
		<managed-bean-class>com.code.aon.ui.config.event.HeaderControllerListener</managed-bean-class>
		<managed-bean-scope>none</managed-bean-scope>
	</managed-bean>

	<!--  **** TAS PRINTERS **** -->
	<managed-bean>
		<managed-bean-name>tasDeliveryDetailPrinter</managed-bean-name>
		<managed-bean-class>
			com.code.aon.ui.tas.print.TasDeliveryDetailPrinter
		</managed-bean-class>
		<managed-bean-scope>none</managed-bean-scope>
	</managed-bean>

   	<!-- ************* NAVIGATION RULES ***************** -->

   	<!-- ************* MAKE ***************** -->
	<navigation-rule>
		<navigation-case>
			<from-outcome>make_form</from-outcome>
			<to-view-id>/com/code/aon/ui/tas/facelet/make/grid.xhtml</to-view-id>
		</navigation-case>
	</navigation-rule>
   	<!-- ************* MODEL ***************** -->
	<navigation-rule>
		<navigation-case>
			<from-outcome>model_form</from-outcome>
			<to-view-id>/com/code/aon/ui/tas/facelet/model/grid.xhtml</to-view-id>
		</navigation-case>
	</navigation-rule>
   	<!-- ************* TAS ITEM ***************** -->
	<navigation-rule>
		<navigation-case>
			<from-outcome>tasItem_search</from-outcome>
			<to-view-id>/com/code/aon/ui/tas/facelet/tasItem/search.xhtml</to-view-id>
		</navigation-case>
		<navigation-case>
			<from-outcome>tasItem_list</from-outcome>
			<to-view-id>/com/code/aon/ui/tas/facelet/tasItem/list.xhtml</to-view-id>
		</navigation-case>
		<navigation-case>
			<from-outcome>tasItem_form</from-outcome>
			<to-view-id>/com/code/aon/ui/tas/facelet/tasItem/form.xhtml</to-view-id>
		</navigation-case>
	</navigation-rule>
   	<!-- ************* PROJECT TAS ***************** -->
	<navigation-rule>
		<navigation-case>
			<from-outcome>projectTas_list</from-outcome>
			<to-view-id>/com/code/aon/ui/tas/facelet/projectTas/list.xhtml</to-view-id>
		</navigation-case>
		<navigation-case>
			<from-outcome>projectTas_form</from-outcome>
			<to-view-id>/com/code/aon/ui/tas/facelet/projectTas/form.xhtml</to-view-id>
		</navigation-case>
		<navigation-case>
			<from-outcome>projectTas_search</from-outcome>
			<to-view-id>/com/code/aon/ui/tas/facelet/projectTas/search.xhtml</to-view-id>
		</navigation-case>
	</navigation-rule>

</faces-config>