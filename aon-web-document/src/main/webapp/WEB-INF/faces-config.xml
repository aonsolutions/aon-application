<faces-config version="1.2"
	xmlns="http://java.sun.com/xml/ns/javaee"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://java.sun.com/xml/ns/javaee http://java.sun.com/xml/ns/javaee/web-facesconfig_1_2.xsd">
	
	<application>
		<message-bundle>com.code.aon.ui.common.i18n.messages</message-bundle>
		<locale-config>
			<default-locale>es</default-locale>
			<supported-locale>en</supported-locale>
		</locale-config> 
		<navigation-handler>com.code.aon.ui.audit.AuditNavigationHandler</navigation-handler>
		<resource-bundle>
			<base-name>com.code.aon.ui.document.i18n.application</base-name>
			<var>appBundle</var>
		</resource-bundle>
	</application>

	<!-- *************** RESOURCE RESOLVER ***************** --> 
	<managed-bean>
		<managed-bean-name>aonResource</managed-bean-name>
		<managed-bean-class>
			com.code.aon.ui.resources.bean.ResourceResolver
		</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
		<!--
		<managed-property>
			<property-name>resourceContextPath</property-name>
			<value>aon-desktop</value>
		</managed-property>
		-->
	</managed-bean>

	<!--  **** AON CONFIGURATION **** -->
	<managed-bean>
		<managed-bean-name>aonConfiguration</managed-bean-name>
		<managed-bean-class>
			com.code.aon.ui.common.controller.ConfigurationController
		</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
		<managed-property>
			<property-name>styleSheets</property-name>
			<list-entries>
				<value>#{aonResource.resolve['/aon-richCss.css']}</value>
			</list-entries>
		</managed-property>
	</managed-bean>

	<!-- =================== Application Menu Navigation Rules ================= -->	

	<navigation-rule>
		<navigation-case>
			<from-outcome>menu_document</from-outcome>
			<to-view-id>/facelet/menu/document.xhtml</to-view-id> 
		</navigation-case>
	</navigation-rule>
		
	<!-- ************ DOCUMENT MANAGER ************** -->
	<managed-bean>
		<managed-bean-name>documentManager</managed-bean-name>
		<managed-bean-class>com.code.aon.ui.registry.controller.DocumentManager</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
		<managed-property>
			<property-name>formTemplate</property-name>
			<value>/com/code/aon/ui/document/facelet/enterpriseDocument/tab_grid.xhtml</value>
		</managed-property>
		<managed-property>
			<property-name>showSearch</property-name>
			<value>#{false}</value>
		</managed-property>
	</managed-bean>	
	
	<managed-bean>
		<managed-bean-name>enterpriseRAttachChildListener</managed-bean-name>
		<managed-bean-class>
			com.code.aon.ui.form.listener.LinesControllerListener
		</managed-bean-class>
		<managed-bean-scope>none</managed-bean-scope>
		<managed-property>
			<property-name>childBean</property-name>
			<value>enterpriseDocument</value>
		</managed-property>
		<managed-property>
			<property-name>aliasMap</property-name>
			<map-entries>
				<map-entry>
					<key>aon:enterpriseId</key>
					<value>id</value>
				</map-entry>
			</map-entries>
		</managed-property>		
	</managed-bean>		

</faces-config>