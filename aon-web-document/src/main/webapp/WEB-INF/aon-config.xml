<?xml version="1.0" encoding="UTF-8" ?>
<config
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xmlns="http://www.esferalia.com/common" >

	<registry:config version="1.0" xmlns:registry="http://www.esferalia.com/registry">
		<registry:rmedia 
			showSendEmail="true" 
		/>
	</registry:config>

	<company:config version="1.4" xmlns:company="http://www.esferalia.com/company">
		<company:company 
			showRegistryBank="true" 
			showCompanyOtherData="true"
			showPanelTabSet="true" 
			showEInvoice="true"
			showDigitalCertificate="true"
			showDirStaff="false"
		/>
		<company:enterprise 
			showFinanceData="false" 
			showAddInfo="true"
			showDirStaff="false"
			standalone="false"
			showEnterpriseParams="false"
			showPayrollData="false"
			showPersonInSearch="false"
		/>				
	</company:config>

	<webmail:config version="1.2" xmlns:webmail="http://www.esferalia.com/webmail" >
		<webmail:webmail
			connect="true"
			showDomainMailAccounts="true"			
		/>
	</webmail:config>	
		
</config>
