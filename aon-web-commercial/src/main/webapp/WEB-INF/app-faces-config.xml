<faces-config version="1.2"
	xmlns="http://java.sun.com/xml/ns/javaee"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://java.sun.com/xml/ns/javaee http://java.sun.com/xml/ns/javaee/web-facesconfig_1_2.xsd">

	<managed-bean>
		<managed-bean-name>targetOptionalListeners</managed-bean-name>
	    <managed-bean-class>java.util.LinkedList</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
		<list-entries>
			<value-class>com.code.aon.ui.form.event.IControllerListener</value-class>
			<value>#{targetItemListener}</value>
			<value>#{targetTrackingListener}</value>
			<value>#{targetSellerListener}</value>
			<value>#{targetProfileListener}</value>
			<value>#{targetThirdPartyListener}</value>
		</list-entries>		
	</managed-bean>

	<!-- Managed Bean que sustituyen a target y targetSearch -->
	<!-- Hacen falta para se hagan busquedas avanzadas -->
	<managed-bean>
		<managed-bean-name>target</managed-bean-name>
		<managed-bean-class>
			com.code.aon.ui.marketing.controller.MarketingTargetController
		</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
		<managed-property>
			<property-name>pojo</property-name>
			<value>com.code.aon.marketing.MarketingTarget</value>
		</managed-property>
		<managed-property>
			<property-name>beanName</property-name>
			<value>target</value>
		</managed-property>
		<managed-property>
			<property-name>defaultOrder</property-name>
			<value>Target_registry_surname,Target_registry_name</value>
		</managed-property>				
		<managed-property>
			<property-name>listenerClasses</property-name>
			<list-entries>
				<value-class>
					com.code.aon.ui.form.event.IControllerListener
				</value-class>
				<value>#{targetControllerListener}</value>
				<value>#{targetSearch}</value>
				<value>#{targetForm}</value>
				<value>#{targetAddressListener}</value>
				<value>#{targetMediaListener}</value>
				<value>#{targetSegmentListener}</value>
				<value>#{targetAddInfoListener}</value>				
			</list-entries>
		</managed-property>
		<managed-property>
			<property-name>optionalListenerClasses</property-name>
			<value>#{targetOptionalListeners}</value>
		</managed-property>	
	</managed-bean>
	
	<managed-bean>
		<managed-bean-name>targetSearch</managed-bean-name>
		<managed-bean-class>
			com.code.aon.ui.marketing.event.MarketingTargetSearchListener
		</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
	</managed-bean>
   
</faces-config>
