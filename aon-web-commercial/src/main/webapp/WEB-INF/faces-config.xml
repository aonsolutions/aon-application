<faces-config version="1.2"
	xmlns="http://java.sun.com/xml/ns/javaee"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://java.sun.com/xml/ns/javaee http://java.sun.com/xml/ns/javaee/web-facesconfig_1_2.xsd">

	<application>
		<message-bundle>
			com.code.aon.ui.common.i18n.messages
		</message-bundle>
		<locale-config>
			<default-locale>es</default-locale>
		</locale-config>
		<view-handler>com.sun.facelets.FaceletViewHandler</view-handler>  
		<navigation-handler>com.code.aon.ui.audit.AuditNavigationHandler</navigation-handler>		
		<resource-bundle>
			<base-name>com.code.aon.ui.commercial.i18n.application</base-name>
			<var>appBundle</var>
		</resource-bundle>				
	</application>

	<!-- *************** RESOURCE RESOLVER ***************** --> 
	<managed-bean>
		<managed-bean-name>aonResource</managed-bean-name>
		<managed-bean-class>
			com.code.aon.ui.resources.bean.ResourceResolver
		</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
		<managed-property>
			<property-name>resourceContextPath</property-name>
			<value>aon-desktop</value>
		</managed-property>
	</managed-bean>

	<!--  *************** 
		AON CONFIGURATION
		***************** -->
	<managed-bean>
		<managed-bean-name>aonConfiguration</managed-bean-name>
		<managed-bean-class>
			com.code.aon.ui.common.controller.ConfigurationController
		</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
		<managed-property>
			<property-name>styleSheets</property-name>
			<list-entries>
				<value>#{aonResource.resolve['/aon-richCss.css']}</value>
				<value>#{aonResource.resolveLocal['/css/commercial.css']}</value>
			</list-entries>
		</managed-property>
	</managed-bean>
   
	<!-- *************************************** -->
	<!-- ************ NAVIGATION *************** -->
	<!-- *************************************** -->

	<!-- =================== HOME ================= -->
	<navigation-rule>
		<navigation-case>
			<from-outcome>home</from-outcome>
			<to-view-id>/homepage.xhtml</to-view-id>
		</navigation-case>
	</navigation-rule>
	
	<navigation-rule>
		<navigation-case>
			<from-outcome>logout</from-outcome>
			<to-view-id>/</to-view-id> 
			<redirect/>
		</navigation-case>
	</navigation-rule>
	
	<!-- =================== Application Menu Navigation Rules ================= -->	

	<navigation-rule>
		<navigation-case>
			<from-outcome>menu_statistics</from-outcome>
			<to-view-id>/facelet/menu/statistics.xhtml</to-view-id> 
		</navigation-case>
		<navigation-case>
			<from-outcome>menu_agent</from-outcome>
			<to-view-id>/facelet/menu/agent.xhtml</to-view-id> 
		</navigation-case>
		<navigation-case>
			<from-outcome>menu_commercial</from-outcome>
			<to-view-id>/facelet/menu/commercial.xhtml</to-view-id> 
		</navigation-case>
		<navigation-case>
			<from-outcome>menu_marketing</from-outcome>
			<to-view-id>/facelet/menu/marketing.xhtml</to-view-id> 
		</navigation-case>
		<navigation-case>
			<from-outcome>menu_config</from-outcome>
			<to-view-id>/facelet/menu/config.xhtml</to-view-id> 
		</navigation-case>
	</navigation-rule>	
   
</faces-config>
