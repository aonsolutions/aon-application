<?xml version="1.0" encoding="UTF-8" ?>
<config
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xmlns="http://www.esferalia.com/common" >

	<registry:config version="1.0" xmlns:registry="http://www.esferalia.com/registry">
		<registry:rmedia 
			showSendEmail="true" 
		/>
	</registry:config>
	
	<webmail:config version="1.2" xmlns:webmail="http://www.esferalia.com/webmail" >
		<webmail:webmail
			connect="true"
			showDomainMailAccounts="true"
		/>
	</webmail:config>
		
	<config:config version="1.0" xmlns:config="http://www.esferalia.com/config" >
		<config:series
			showOfferData="true"
			showSalesData="false"
			showDeliveryData="false"
			showInvoiceData="false"
		/>
	</config:config>	

	<company:config version="1.2" xmlns:company="http://www.esferalia.com/company">
		<company:company 
			showRegistryBank="true" 
			showCompanyOtherData="true"
			showPanelTabSet="true"
			showEInvoice="true" 
			showDigitalCertificate="true"
			showDirStaff="false"
		/>
		<company:enterprise 
			showFinanceData="false" 
			showAddInfo="true"
			showDirStaff="false"
			standalone="false"
		/>				
	</company:config>

	<customer:config version="1.1" xmlns:customer="http://www.esferalia.com/customer">
		<customer:customer
			showOfferData="false"
			showSalesData="false"
			showDeliveryData="false" 
			showFinanceData="true" 
			showProjectData="false"
			showFinanceFeeData="true" 
			showTaxInfoData="false"
			showAccount="true"
			showTariff="true" 
			showSegment="true"
			showNote="false"
			showRelationship="false"
			showRecordData="false"
			showAddInfo="true"
			showDirStaff="false"
			showHistory="false"
		/>
	</customer:config>

	<product:config version="1.1" xmlns:product="http://www.esferalia.com/product">
		<product:catalogue
			showEcommerceData="false"
		/>	
		<product:product
			showBarcode="true"
			showType="false"
			showBrand="true"
			showStock="false"
			showTariff="false"
			showComposition="false"
			showAlternatives="true"
			showSuppliers="true"
			showAccount="false"
			showAttachment="true"
			showEcommerceData="false"
			showHistory="false"
		/>
 		<product:productCategory
 			showCategoryGroup="false"
 		/>
	</product:config>

	<marketing:config version="1.2" xmlns:marketing="http://www.esferalia.com/marketing">
		<marketing:campaign
			showSurvey="true"
			showPhoneActionMediaType="true"
		/>
	</marketing:config>
	
	<commercial:config version="1.2" xmlns:commercial="http://www.esferalia.com/commercial">
		<commercial:offer
			showInvoicing="false"
			showSalesOrder="false"
			showSeller="true"
		/>
		<commercial:target
			showTaxInfoData="false"
			showEcommerceTab="false"
			showProfile="true"
			showSearchOnlyCustomers="true"
			showCommercialTracking="true"
			showProduct="true"
			showSeller="true"
			showAddInfo="true"
			showSupplier="true"
			showTariff="true"
			showFinanceData="true"
			showNote="true"
		/>
	</commercial:config>
		
</config>