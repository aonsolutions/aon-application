<?xml version="1.0" encoding="ISO-8859-1"?>

<!DOCTYPE report-config 
	PUBLIC "-//CODE-AON//DTD Report Config//EN" 
	"http://co-de.com/aon/report-config.dtd">

<report-config>

	<!--  **********************************************************
						TARGET
		  **********************************************************-->
		  
	<report id="targetList" description="Targets List">
		<template path="/com/code/aon/ui/commercial/report/target.jasper"/>
		<bean key="com.code.aon.commercial.Target" />
		<collection provider="#{target}" forceRefresh="true"/>
		<params>
			<param id="REPORT_RESOURCE_BUNDLE" value="com.code.aon.common.i18n.messages" />
			<param id="company" value="#{company.obtainCompany}" />
		</params>
	</report>
	<!--  **********************************************************
						OFFER 
		  **********************************************************-->
	<report id="offer" description="Offers's Report">
		<template path="/com/code/aon/ui/commercial/report/offer.jasper"/>
		<collection provider="#{offer}" forceRefresh="true"/>
		<params>
			<param id="REPORT_RESOURCE_BUNDLE" value="com.code.aon.common.i18n.messages" />
			<param id="PriceStrategy" value="#{offerDetail.getPriceStrategy}" />
			<param id="TotalPrice" value="#{offer.getTotalPrice}" />
			<param id="company" value="#{company.obtainCompany}" />
			<param id="logoImageFile" value="#{company.getAttachAsInputStream}" />
			<param id="recordData" value="#{company.getCompanyRecordData}" />
			<param id="address" value="#{company.obtainAddress}" />
			<param id="phone" value="#{company.obtainPhone}" />
			<param id="fax" value="#{company.obtainFax}" />
			<param id="email" value="#{company.obtainEmail}" />
			<param id="web" value="#{company.obtainWeb}" />
			<param id="printHeader" value="#{company.isPrintHeader}" />
			<param id="printRecordData" value="#{company.isPrintRecordData}" />
			<param id="targetPhone" value="#{offer.getTargetPhone}" />
			<param id="targetCellular" value="#{offer.getTargetCellularPhone}" />
			<param id="targetFax" value="#{offer.getTargetFax}" />
			<param id="targetEmail" value="#{offer.getTargetEmail}" />
			<param id="targetPayMethod" value="#{offer.getTargetPayMethod}" />
			<param id="defaultPayMethod" value="#{offer.getDefaultPayMethod}" />			
		</params>
		<nested-report report="offerDetail"/>
	</report>
	<report id="offerDetail" description="Offer Detail">
		<template path="/com/code/aon/ui/commercial/report/offerDetail.jasper"/>
	</report>

	<report id="offerGta" description="Offers's Report">
		<template path="/com/code/aon/ui/commercial/report/offerGta.jasper"/>
		<collection provider="#{offer}" forceRefresh="true"/>
		<params>
			<param id="REPORT_RESOURCE_BUNDLE" value="com.code.aon.common.i18n.messages" />
			<param id="PriceStrategy" value="#{offerDetail.getPriceStrategy}" />
			<param id="TotalPrice" value="#{offer.getTotalPrice}" />
			<param id="company" value="#{company.obtainCompany}" />
			<param id="logoImageFile" value="#{company.getAttachAsInputStream}" />
			<param id="recordData" value="#{company.getCompanyRecordData}" />
			<param id="address" value="#{company.obtainAddress}" />
			<param id="phone" value="#{company.obtainPhone}" />
			<param id="fax" value="#{company.obtainFax}" />
			<param id="email" value="#{company.obtainEmail}" />
			<param id="web" value="#{company.obtainWeb}" />
			<param id="printHeader" value="#{company.isPrintHeader}" />
			<param id="printRecordData" value="#{company.isPrintRecordData}" />
			<param id="targetPhone" value="#{offer.getTargetPhone}" />
			<param id="targetCellular" value="#{offer.getTargetCellularPhone}" />
			<param id="targetFax" value="#{offer.getTargetFax}" />
			<param id="targetEmail" value="#{offer.getTargetEmail}" />
			<param id="targetPayMethod" value="#{offer.getTargetPayMethod}" />
			<param id="defaultPayMethod" value="#{offer.getDefaultPayMethod}" />					
		</params>
	</report>	
	<!--
	    ********************************************************** 
								COMMERCIAL TRACKING
		**********************************************************
	-->
	<report id="commercialTrackingFileList" description="Commercial Tracking File Report">
		<template path="/com/code/aon/ui/commercial/report/commercialTrackingFile.jasper" />
		<collection provider="#{commercialTracking}" forceRefresh="true"/>
		<params>
			<param id="REPORT_RESOURCE_BUNDLE" value="com.code.aon.common.i18n.messages" />
			<param id="company" value="#{company.obtainCompany}" />
			<param id="printHeader" value="#{company.isPrintHeader}" />
		</params>
	</report>		
	<report id="commercialTracking" description="Commercial Tracking Report">
		<template path="/com/code/aon/ui/commercial/report/commercialTracking.jasper" />
		<bean key="com.code.aon.commercial.CommercialTracking" />
		<criteria provider="#{commercialTracking}" />
		<params>
			<param id="REPORT_RESOURCE_BUNDLE" value="com.code.aon.common.i18n.messages" />
			<param id="company" value="#{company.obtainCompany}" />
			<param id="printHeader" value="#{company.isPrintHeader}" />
		</params>
	</report>		
	<report id="commercialTrackingDetail" description="Commercial Tracking Report">
		<template path="/com/code/aon/ui/commercial/report/commercialTrackingDetail.jasper" />
		<bean key="com.code.aon.commercial.CommercialTracking" />
		<criteria provider="#{commercialTracking}" />
		<params>
			<param id="REPORT_RESOURCE_BUNDLE" value="com.code.aon.common.i18n.messages" />
			<param id="company" value="#{company.obtainCompany}" />
			<param id="printHeader" value="#{company.isPrintHeader}" />
		</params>
	</report>		
	<report id="commercialTrackingDetailExcel" description="Commercial Tracking Excel Report">
		<template path="/com/code/aon/ui/commercial/report/commercialTrackingDetailExcel.jasper" />
		<bean key="com.code.aon.commercial.CommercialTracking" />
		<criteria provider="#{commercialTracking}" />
		<params>
			<param id="REPORT_RESOURCE_BUNDLE" value="com.code.aon.common.i18n.messages" />
			<param id="company" value="#{company.obtainCompany}" />
			<param id="printHeader" value="#{company.isPrintHeader}" />
		</params>
	</report>		
	
	
	<report id="projectCommercial" description="Project Commercial Report">
		<template path="/com/code/aon/ui/commercial/report/projectCommercial.jasper" />
		<bean key="com.code.aon.commercial.ProjectCommercial" />
		<criteria provider="#{projectCommercial}" />
		<params>
			<param id="REPORT_RESOURCE_BUNDLE" value="com.code.aon.common.i18n.messages" />
			<param id="company" value="#{company.obtainCompany}" />
			<param id="printHeader" value="#{company.isPrintHeader}" />
		</params>
	</report>
	
</report-config>