<faces-config version="1.2"
	xmlns="http://java.sun.com/xml/ns/javaee"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://java.sun.com/xml/ns/javaee http://java.sun.com/xml/ns/javaee/web-facesconfig_1_2.xsd">

	<application>
		<resource-bundle>
			<base-name>com.esferalia.aon.ui.calendar.i18n.messages</base-name>
			<var>calendarBundle</var>
		</resource-bundle>
	</application>
	
	<!-- ************ CALENDAR ************* -->
	<managed-bean>
		<managed-bean-name>calendar</managed-bean-name>
		<managed-bean-class>
			com.esferalia.aon.ui.calendar.controller.CalendarController
		</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
		<managed-property>
			<property-name>pojo</property-name>
			<value>com.esferalia.aon.calendar.Calendar</value>
		</managed-property>
		<managed-property>
			<property-name>beanName</property-name>
			<value>calendar</value>
		</managed-property>
		<managed-property>
			<property-name>defaultOrder</property-name>
			<value>Calendar_id</value>
		</managed-property>			
		<managed-property>
			<property-name>listenerClasses</property-name>
			<list-entries>
				<value-class>com.code.aon.ui.form.event.IControllerListener</value-class>
				<value>#{calendarHolidayListener}</value>
				<value>#{calendarPeriodListener}</value>
			</list-entries>
		</managed-property>
	</managed-bean>
	
	
	<managed-bean>
		<managed-bean-name>calendarHolidayListener</managed-bean-name>
		<managed-bean-class>
			com.code.aon.ui.form.listener.LinesControllerListener
		</managed-bean-class>
		<managed-bean-scope>none</managed-bean-scope>
		<managed-property>
			<property-name>childBean</property-name>
			<value>calendarHoliday</value>
		</managed-property>
		<managed-property>
			<property-name>aliasMap</property-name>
			<map-entries>
				<map-entry>
					<key>CalendarHoliday_calendar_id</key>
                    <value>id</value>
				</map-entry>
			</map-entries>
		</managed-property>
	</managed-bean>
	
	<managed-bean>
		<managed-bean-name>calendarPeriodListener</managed-bean-name>
		<managed-bean-class>
			com.code.aon.ui.form.listener.LinesControllerListener
		</managed-bean-class>
		<managed-bean-scope>none</managed-bean-scope>
		<managed-property>
			<property-name>childBean</property-name>
			<value>calendarPeriod</value>
		</managed-property>
		<managed-property>
			<property-name>aliasMap</property-name>
			<map-entries>
				<map-entry>
					<key>CalendarPeriod_calendar_id</key>
                    <value>id</value>
				</map-entry>
			</map-entries>
		</managed-property>
	</managed-bean>
	
	<!-- ************CALENDAR HOLIDAY************* -->
	<managed-bean>
		<managed-bean-name>calendarHoliday</managed-bean-name>
		<managed-bean-class>
			com.code.aon.ui.form.LinesController
		</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
		<managed-property>
			<property-name>pageLimit</property-name>
			<value>-1</value>
		</managed-property>
		<managed-property>
			<property-name>pojo</property-name>
			<value>com.esferalia.aon.calendar.CalendarHoliday</value>
		</managed-property>
		<managed-property>
			<property-name>beanName</property-name>
			<value>calendarHoliday</value>
		</managed-property>
			<managed-property>
			<property-name>defaultOrder</property-name>
			<value>CalendarHoliday_date</value>
		</managed-property>	
		<managed-property>
			<property-name>masterControllerName</property-name>
			<value>calendar</value>
		</managed-property>
		<managed-property>
			<property-name>cascadeDelete</property-name>
			<value>true</value>
		</managed-property>
		<managed-property>
			<property-name>propertyMap</property-name>
			<map-entries>
				<map-entry>
					<key>id</key>
					<value>calendar.id</value>
				</map-entry>
			</map-entries>
		</managed-property>		
	</managed-bean>
	
	<!-- ************CALENDAR PERIOD************* -->
	<managed-bean>
		<managed-bean-name>calendarPeriod</managed-bean-name>
		<managed-bean-class>
			com.code.aon.ui.form.LinesController
		</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
		<managed-property>
			<property-name>pageLimit</property-name>
			<value>-1</value>
		</managed-property>
		<managed-property>
			<property-name>pojo</property-name>
			<value>com.esferalia.aon.calendar.CalendarPeriod</value>
		</managed-property>
		<managed-property>
			<property-name>beanName</property-name>
			<value>calendarPeriod</value>
		</managed-property>
			<managed-property>
			<property-name>defaultOrder</property-name>
			<value>CalendarPeriod_fromDate</value>
		</managed-property>	
		<managed-property>
			<property-name>masterControllerName</property-name>
			<value>calendar</value>
		</managed-property>
		<managed-property>
			<property-name>cascadeDelete</property-name>
			<value>true</value>
		</managed-property>
		<managed-property>
			<property-name>propertyMap</property-name>
			<map-entries>
				<map-entry>
					<key>id</key>
					<value>calendar.id</value>
				</map-entry>
			</map-entries>
		</managed-property>		
	</managed-bean>
	
		<!-- =================== Calendar ========================== -->
	<navigation-rule>
	    <navigation-case>
    	  	<from-outcome>calendar_search</from-outcome>
    		<to-view-id>/com/esferalia/aon/ui/calendar/facelet/calendar/search.xhtml</to-view-id>
	    </navigation-case>
	    <navigation-case>
    	  	<from-outcome>calendar_list</from-outcome>
    		<to-view-id>/com/esferalia/aon/ui/calendar/facelet/calendar/list.xhtml</to-view-id>
	    </navigation-case>
	    <navigation-case>
    	  	<from-outcome>calendar_form</from-outcome>
    		<to-view-id>/com/esferalia/aon/ui/calendar/facelet/calendar/form.xhtml</to-view-id>
	    </navigation-case>
	</navigation-rule>
	
</faces-config>
