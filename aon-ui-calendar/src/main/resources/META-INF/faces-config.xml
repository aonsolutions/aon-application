<faces-config version="1.2" xmlns="http://java.sun.com/xml/ns/javaee"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://java.sun.com/xml/ns/javaee http://java.sun.com/xml/ns/javaee/web-facesconfig_1_2.xsd">

	<application>
		<resource-bundle>
			<base-name>com.esferalia.aon.ui.calendar.i18n.messages</base-name>
			<var>calendarBundle</var>
		</resource-bundle>
	</application>
	
	<!--  *************** COLLECTIONS ***************** -->
	<managed-bean>
		<managed-bean-name>calendarCollections</managed-bean-name>
		<managed-bean-class>com.esferalia.aon.ui.calendar.controller.CalendarCollections</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
	</managed-bean>

	<!-- ************ CALENDAR ************* -->
	<managed-bean>
		<managed-bean-name>calendar</managed-bean-name>
		<managed-bean-class>
			com.esferalia.aon.ui.calendar.controller.CalendarController
		</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
		<managed-property>
			<property-name>queryOnStartUP</property-name>
			<value>true</value>
		</managed-property>
		<managed-property>
			<property-name>pojo</property-name>
			<value>com.esferalia.aon.calendar.Calendar</value>
		</managed-property>
		<managed-property>
			<property-name>beanName</property-name>
			<value>calendar</value>
		</managed-property>
		<managed-property>
			<property-name>defaultOrder</property-name>
			<value>Calendar_id</value>
		</managed-property>
		<managed-property>
			<property-name>listenerClasses</property-name>
			<list-entries>
				<value-class>com.code.aon.ui.form.event.IControllerListener</value-class>
				<value>#{calendarControllerListener}</value>
				<value>#{calendarHolidayListener}</value>
				<value>#{calendarPeriodListener}</value>
			</list-entries>
		</managed-property>
	</managed-bean>

	<managed-bean>
		<managed-bean-name>calendarControllerListener</managed-bean-name>
		<managed-bean-class>
			com.esferalia.aon.ui.calendar.event.CalendarControllerListener</managed-bean-class>
		<managed-bean-scope>none</managed-bean-scope>
	</managed-bean>
	
	<managed-bean>
		<managed-bean-name>calendarHolidayListener</managed-bean-name>
		<managed-bean-class>
			com.code.aon.ui.form.listener.LinesControllerListener</managed-bean-class>
		<managed-bean-scope>none</managed-bean-scope>
		<managed-property>
			<property-name>childBean</property-name>
			<value>calendarHoliday</value>
		</managed-property>
		<managed-property>
			<property-name>aliasMap</property-name>
			<map-entries>
				<map-entry>
					<key>CalendarHoliday_calendar_id</key>
					<value>id</value>
				</map-entry>
			</map-entries>
		</managed-property>
	</managed-bean>

	<managed-bean>
		<managed-bean-name>calendarPeriodListener</managed-bean-name>
		<managed-bean-class>
			com.code.aon.ui.form.listener.LinesControllerListener</managed-bean-class>
		<managed-bean-scope>none</managed-bean-scope>
		<managed-property>
			<property-name>childBean</property-name>
			<value>calendarPeriod</value>
		</managed-property>
		<managed-property>
			<property-name>aliasMap</property-name>
			<map-entries>
				<map-entry>
					<key>CalendarPeriod_calendar_id</key>
					<value>id</value>
				</map-entry>
			</map-entries>
		</managed-property>
	</managed-bean>

	<!-- ************CALENDAR HOLIDAY************* -->
	<managed-bean>
		<managed-bean-name>calendarHoliday</managed-bean-name>
		<managed-bean-class>com.code.aon.ui.form.LinesController</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
		<managed-property>
			<property-name>pageLimit</property-name>
			<value>-1</value>
		</managed-property>
		<managed-property>
			<property-name>pojo</property-name>
			<value>com.esferalia.aon.calendar.CalendarHoliday</value>
		</managed-property>
		<managed-property>
			<property-name>beanName</property-name>
			<value>calendarHoliday</value>
		</managed-property>
		<managed-property>
			<property-name>defaultOrder</property-name>
			<value>CalendarHoliday_date</value>
		</managed-property>
		<managed-property>
			<property-name>masterControllerName</property-name>
			<value>calendar</value>
		</managed-property>
		<managed-property>
			<property-name>cascadeDelete</property-name>
			<value>true</value>
		</managed-property>
		<managed-property>
			<property-name>propertyMap</property-name>
			<map-entries>
				<map-entry>
					<key>id</key>
					<value>calendar.id</value>
				</map-entry>
			</map-entries>
		</managed-property>
		<managed-property>
			<property-name>listenerClasses</property-name>
			<list-entries>
				<value-class>com.code.aon.ui.form.event.IControllerListener</value-class>
				<value>#{calendarHolidayControllerListener}</value>
			</list-entries>
		</managed-property>
	</managed-bean>
	
	<managed-bean>
		<managed-bean-name>calendarHolidayControllerListener</managed-bean-name>
		<managed-bean-class>
			com.esferalia.aon.ui.calendar.event.CalendarHolidayControllerListener</managed-bean-class>
		<managed-bean-scope>none</managed-bean-scope>
	</managed-bean>

	<!-- ************CALENDAR PERIOD************* -->
	<managed-bean>
		<managed-bean-name>calendarPeriod</managed-bean-name>
		<managed-bean-class>
			com.esferalia.aon.ui.calendar.controller.CalendarPeriodController
		</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
		<managed-property>
			<property-name>pageLimit</property-name>
			<value>-1</value>
		</managed-property>
		<managed-property>
			<property-name>pojo</property-name>
			<value>com.esferalia.aon.calendar.CalendarPeriod</value>
		</managed-property>
		<managed-property>
			<property-name>beanName</property-name>
			<value>calendarPeriod</value>
		</managed-property>
		<managed-property>
			<property-name>defaultOrder</property-name>
			<value>CalendarPeriod_month</value>
		</managed-property>
		<managed-property>
			<property-name>masterControllerName</property-name>
			<value>calendar</value>
		</managed-property>
		<managed-property>
			<property-name>cascadeDelete</property-name>
			<value>true</value>
		</managed-property>
		<managed-property>
			<property-name>propertyMap</property-name>
			<map-entries>
				<map-entry>
					<key>id</key>
					<value>calendar.id</value>
				</map-entry>
			</map-entries>
		</managed-property>
		<managed-property>
			<property-name>listenerClasses</property-name>
			<list-entries>
				<value-class>com.code.aon.ui.form.event.IControllerListener</value-class>
				<value>#{calendarPeriodControllerListener}</value>
			</list-entries>
		</managed-property>
	</managed-bean>

	<managed-bean>
		<managed-bean-name>calendarPeriodControllerListener</managed-bean-name>
		<managed-bean-class>
			com.esferalia.aon.ui.calendar.event.CalendarPeriodControllerListener</managed-bean-class>
		<managed-bean-scope>none</managed-bean-scope>
	</managed-bean>

	<!-- ************ HOLIDAY ************* -->
	<managed-bean>
		<managed-bean-name>holiday</managed-bean-name>
		<managed-bean-class>
			com.esferalia.aon.ui.calendar.controller.HolidayController</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
		<managed-property>
			<property-name>pojo</property-name>
			<value>com.esferalia.aon.calendar.Holiday</value>
		</managed-property>
		<managed-property>
			<property-name>beanName</property-name>
			<value>holiday</value>
		</managed-property>
		<managed-property>
			<property-name>defaultOrder</property-name>
			<value>Holiday_description</value>
		</managed-property>
		<managed-property>
			<property-name>listenerClasses</property-name>
			<list-entries>
				<value-class>com.code.aon.ui.form.event.IControllerListener</value-class>
					<value>#{holidayControllerListener}</value>
					<value>#{holidayDetailListener}</value>
			</list-entries>
		</managed-property>
	</managed-bean>
	
	<managed-bean>
		<managed-bean-name>holidayControllerListener</managed-bean-name>
		<managed-bean-class>
			com.esferalia.aon.ui.calendar.event.HolidayControllerListener</managed-bean-class>
		<managed-bean-scope>none</managed-bean-scope>
	</managed-bean>
	
	<managed-bean>
		<managed-bean-name>holidayDetailListener</managed-bean-name>
		<managed-bean-class>
			com.code.aon.ui.form.listener.LinesControllerListener</managed-bean-class>
		<managed-bean-scope>none</managed-bean-scope>
		<managed-property>
			<property-name>childBean</property-name>
			<value>holidayDetail</value>
		</managed-property>
		<managed-property>
			<property-name>aliasMap</property-name>
			<map-entries>
				<map-entry>
					<key>HolidayDetail_holiday_id</key>
					<value>id</value>
				</map-entry>
			</map-entries>
		</managed-property>
	</managed-bean>
	
	<!-- ************HOLIDAY DETAIL************* -->
	<managed-bean>
		<managed-bean-name>holidayDetail</managed-bean-name>
		<managed-bean-class>com.code.aon.ui.form.LinesController</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
		<managed-property>
			<property-name>pageLimit</property-name>
			<value>-1</value>
		</managed-property>
		<managed-property>
			<property-name>pojo</property-name>
			<value>com.esferalia.aon.calendar.HolidayDetail</value>
		</managed-property>
		<managed-property>
			<property-name>beanName</property-name>
			<value>holidayDetail</value>
		</managed-property>
		<managed-property>
			<property-name>defaultOrder</property-name>
			<value>HolidayDetail_date </value>
		</managed-property>
		<managed-property>
			<property-name>masterControllerName</property-name>
			<value>holiday</value>
		</managed-property>
		<managed-property>
			<property-name>cascadeDelete</property-name>
			<value>true</value>
		</managed-property>
		<managed-property>
			<property-name>propertyMap</property-name>
			<map-entries>
				<map-entry>
					<key>id</key>
					<value>holiday.id</value>
				</map-entry>
			</map-entries>
		</managed-property>
		<managed-property>
			<property-name>listenerClasses</property-name>
			<list-entries>
				<value-class>com.code.aon.ui.form.event.IControllerListener</value-class>
				<value>#{holidayDetailControllerListener}</value>
			</list-entries>
		</managed-property>
	</managed-bean>
	
	<managed-bean>
		<managed-bean-name>holidayDetailControllerListener</managed-bean-name>
		<managed-bean-class>
			com.esferalia.aon.ui.calendar.event.HolidayDetailControllerListener</managed-bean-class>
		<managed-bean-scope>none</managed-bean-scope>
	</managed-bean>
	
	<!-- ************ CALENDAR HOLIDAY DATA ************* -->
	<managed-bean>
		<managed-bean-name>calendarHolidayData</managed-bean-name>
		<managed-bean-class>
			com.esferalia.aon.ui.calendar.controller.CalendarHolidayDataController
		</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
	</managed-bean>
	
	<!-- ************ CALENDAR PRINT ************* -->
	<managed-bean>
		<managed-bean-name>calendarPrint</managed-bean-name>
		<managed-bean-class>
			com.esferalia.aon.ui.calendar.print.CalendarPrintController
		</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
	</managed-bean>
	
	<!-- ************ HOLIDAY LOOKUP ************** -->
	<managed-bean>
		<managed-bean-name>holidayLookup</managed-bean-name>
		<managed-bean-class>com.code.aon.ui.registry.controller.RegistryRichLookupBean</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
		<managed-property>
			<property-name>beanName</property-name>
			<value>holidayLookup</value>
		</managed-property>
		<managed-property>
			<property-name>foreignPojo</property-name>
			<value>com.esferalia.aon.calendar.Holiday</value>
		</managed-property>
		<managed-property>
			<property-name>defaultOrder</property-name>
			<value>Holiday_description</value>
		</managed-property>
		<managed-property>
			<property-name>listPagePath</property-name>
			<value>/com/esferalia/aon/ui/calendar/facelet/lookup/holiday/list.xhtml</value>
		</managed-property>
		<managed-property>
			<property-name>searchPagePath</property-name>
			<value>/com/esferalia/aon/ui/calendar/facelet/lookup/holiday/search.xhtml</value>
		</managed-property>
	</managed-bean>
	
	<!-- ************ CALENDAR LOOKUP ************** -->
	<managed-bean>
		<managed-bean-name>calendarLookup</managed-bean-name>
		<managed-bean-class>com.code.aon.ui.registry.controller.RegistryRichLookupBean</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
		<managed-property>
			<property-name>beanName</property-name>
			<value>calendarLookup</value>
		</managed-property>
		<managed-property>
			<property-name>foreignPojo</property-name>
			<value>com.esferalia.aon.calendar.Calendar</value>
		</managed-property>
		<managed-property>
			<property-name>defaultOrder</property-name>
			<value>Calendar_description</value>
		</managed-property>
		<managed-property>
			<property-name>listPagePath</property-name>
			<value>/com/esferalia/aon/ui/calendar/facelet/lookup/calendar/list.xhtml</value>
		</managed-property>
		<managed-property>
			<property-name>searchPagePath</property-name>
			<value>/com/esferalia/aon/ui/calendar/facelet/lookup/calendar/search.xhtml</value>
		</managed-property>
		<managed-property>
			<property-name>listenerClasses</property-name>
			<list-entries>
				<value-class>com.code.aon.ui.form.event.IControllerListener</value-class>
				<value>#{calendarLookupListener}</value>
			</list-entries>
		</managed-property>
<!--  
-->		
	</managed-bean>

	<managed-bean>
		<managed-bean-name>calendarLookupListener</managed-bean-name>
		<managed-bean-class>com.esferalia.aon.ui.calendar.event.CalendarLookupListener</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
	</managed-bean>
<!--  
-->	
	


	<!-- =================== Calendar ========================== -->
	<navigation-rule>
		<navigation-case>
			<from-outcome>calendar_search</from-outcome>
			<to-view-id>/com/esferalia/aon/ui/calendar/facelet/calendar/search.xhtml</to-view-id>
		</navigation-case>
		<navigation-case>
			<from-outcome>calendar_list</from-outcome>
			<to-view-id>/com/esferalia/aon/ui/calendar/facelet/calendar/list.xhtml</to-view-id>
		</navigation-case>
		<navigation-case>
			<from-outcome>calendar_form</from-outcome>
			<to-view-id>/com/esferalia/aon/ui/calendar/facelet/calendar/form.xhtml</to-view-id>
		</navigation-case>
	</navigation-rule>

	<navigation-rule>
		<navigation-case>
			<from-outcome>holiday_search</from-outcome>
			<to-view-id>/com/esferalia/aon/ui/calendar/facelet/holiday/search.xhtml</to-view-id>
		</navigation-case>
		<navigation-case>
			<from-outcome>holiday_list</from-outcome>
			<to-view-id>/com/esferalia/aon/ui/calendar/facelet/holiday/list.xhtml</to-view-id>
		</navigation-case>
		<navigation-case>
			<from-outcome>holiday_form</from-outcome>
			<to-view-id>/com/esferalia/aon/ui/calendar/facelet/holiday/form.xhtml</to-view-id>
		</navigation-case>
	</navigation-rule>


</faces-config>
