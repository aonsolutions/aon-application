<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<ui:UiBinder xmlns:ui='urn:ui:com.google.gwt.uibinder'
	xmlns:g='urn:import:com.google.gwt.user.client.ui' 
	xmlns:aon='urn:import:com.esferalia.aon.gwt.common.client.widget'
	xmlns:mod200='urn:import:com.esferalia.aon.gwt.fiscal.client.tree.content.mod200_2014'
	>

	<ui:with type="com.esferalia.aon.gwt.common.client.i18n.CommonMessages" field="msg"></ui:with>
	<ui:with type="com.esferalia.aon.gwt.common.client.css.AonResources" field="aonResources"></ui:with>

	<g:DockLayoutPanel unit="PX" ui:field="dockLayoutPanel">
		<g:north size="26">
			<g:FlowPanel styleName="aon-finding-title-toolbar">
				<g:HorizontalPanel>
					<g:HTMLPanel styleName="aon-finding-title">
						<g:HTMLPanel styleName="aon-finding-title-internal">
							<g:Label styleName="aon-outputText" text="{msg.mod200}" />
						</g:HTMLPanel>
					</g:HTMLPanel>
					<g:HTMLPanel styleName="aon-finding-subtitle">
						<g:HTMLPanel styleName="aon-finding-subtitle-internal">
							<g:Label styleName="aon-outputText"></g:Label>
						</g:HTMLPanel>
					</g:HTMLPanel>
					<g:HorizontalPanel styleName="aon-finding-toolbar">
						<g:HTMLPanel styleName="aon-finding-toolbar-item-group">
							<g:Button ui:field='initializeButton'
								styleName='aon-finding-toolbar-item aon-icon-accept' text="{msg.continueAction}" />
							<g:Button ui:field='importButton'
								styleName='aon-finding-toolbar-item aon-icon-upload' text="{msg.continueAction}" />
							<g:Button ui:field='saveButton'
								styleName='aon-finding-toolbar-item aon-icon-accept' text="{msg.saveAction}" />
							<g:Button ui:field='removeButton'
								styleName='aon-finding-toolbar-item aon-icon-delete' text="{msg.deleteAction}" />
							<g:Button ui:field='validateButton'
								styleName='aon-finding-toolbar-item aon-icon-project-ok' text="{msg.validateAction}" />
							<g:Button ui:field='calculateButton'
								styleName='aon-finding-toolbar-item aon-icon-calc' text="{msg.calculateAction}" />
							<g:CheckBox ui:field='calculateCheck' text="{msg.authomaticCalculation}"/>
							<g:Button ui:field='aeatFileButton'
								styleName='aon-finding-toolbar-item aon-icon-aeat' text="{msg.generateFile}" />
							<g:Button ui:field='aeatPrintButton'
								styleName='aon-finding-toolbar-item aon-icon-aeat' text="{msg.printViaAeat}" />
							<g:Button ui:field='aeatAccountingFileButton'
								styleName='aon-finding-toolbar-item aon-icon-aeat-bw' text="{msg.aeatAccountingFile}" />
						</g:HTMLPanel>
						<g:FlowPanel ui:field="formContainer" />
					</g:HorizontalPanel>
				</g:HorizontalPanel>
			</g:FlowPanel>
		</g:north>
		<g:center>
			<g:SplitLayoutPanel ui:field="splitLayoutPanel">
				<g:center>
					<g:DockLayoutPanel unit="PX">
						<g:north size="55">
							<g:SimplePanel ui:field="headerPanel"/>
						</g:north>
						<g:center>
							<g:DeckLayoutPanel ui:field="deckPanel">
								<g:SimplePanel ui:field="page"/>
								<mod200:Page00 ui:field="page00"/>
								<mod200:Page01 ui:field="page01"/>
								<mod200:Page02 ui:field="page02"/>
								<mod200:Page03 ui:field="page03"/>
								<mod200:Page04 ui:field="page04"/>
								<mod200:Page05 ui:field="page05"/>
								<mod200:Page06 ui:field="page06"/>
								<mod200:Page07 ui:field="page07"/>
								<mod200:Page08 ui:field="page08"/>
								<mod200:Page09 ui:field="page09"/>
								<mod200:Page10 ui:field="page10"/>
								<mod200:Page11 ui:field="page11"/>
								<mod200:Page12 ui:field="page12"/>
								<mod200:Page13 ui:field="page13"/>
								<mod200:Page14 ui:field="page14"/>
							</g:DeckLayoutPanel>
						</g:center>
					</g:DockLayoutPanel>
				</g:center>
				<g:south size="0">
					<aon:MinimizePanel ui:field="footPanel" styleName="{aonResources.css.aonNoPrint}">
						<g:TabLayoutPanel styleName="gwt-Selector" barHeight="26" barUnit="PX" width="100%">
							<g:tab>
								<g:header>
									<span class="aon-icon-time aon-icon-commandButton" style="padding-left: 20px;">
										Notificaciones
									</span>
								</g:header>
								<aon:ResultsPanel ui:field="resultsPanel" />
							</g:tab>
						</g:TabLayoutPanel>
					</aon:MinimizePanel>
				</g:south>
			</g:SplitLayoutPanel>
		</g:center>
	</g:DockLayoutPanel>
</ui:UiBinder>
