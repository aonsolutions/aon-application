<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
	xmlns:g="urn:import:com.google.gwt.user.client.ui" 
	xmlns:aon="urn:import:com.esferalia.aon.gwt.common.client.widget"
	xmlns:cell="urn:import:com.google.gwt.user.cellview.client"
	xmlns:m184="urn:import:com.esferalia.aon.gwt.fiscal.client.mod184">
	
	<ui:with type="com.esferalia.aon.gwt.common.client.i18n.CommonMessages" field="msg"></ui:with>
	<ui:with type="com.esferalia.aon.gwt.common.client.css.AonResources" field="aonResources"></ui:with>
	
	<g:DockLayoutPanel>
		<g:west size="300">
			<g:DockLayoutPanel>
				<g:north size="20">
					<g:FlowPanel height="100%" styleName="{aonResources.css.aonTextRight} {aonResources.css.aonWidthAll}">
						<g:FlowPanel styleName="{aonResources.css.aonMarginLeft} {aonResources.css.aonBorderBottom} {aonResources.css.aonPadding2}">
							<g:Button ui:field="deleteDetailButton" title="{msg.deleteAction}" 
								styleName="{aonResources.css.aonIconCommandButton} {aonResources.css.aonIconDelete}  {aonResources.css.aonMarginRight}"/>
							<g:Button ui:field="restoreDeletedButton" title="{msg.restoreAction}"
								styleName="{aonResources.css.aonIconCommandButton} {aonResources.css.aonIconRedo} {aonResources.css.aonMarginRight}"/>
							<g:Button ui:field="newDetailButton" title="{msg.newPerceptor}"
								styleName="{aonResources.css.aonIconCommandButton} {aonResources.css.aonIconReset}  {aonResources.css.aonMarginRight}"/>
						</g:FlowPanel>
					</g:FlowPanel>
				</g:north>
				<g:center>
					<g:ScrollPanel ui:field="detailListPanel" styleName="{aonResources.css.aonScrollArea} {aonResources.css.aonBorderRight}">
						<cell:CellList ui:field="partnersList" styleName="{aonResources.css.aonWidthAll}"/>
					</g:ScrollPanel>
				</g:center>
			</g:DockLayoutPanel>
		</g:west>
		<g:center>
			<g:ScrollPanel styleName="{aonResources.css.aonWidthAll}">
				<g:FlowPanel styleName="{aonResources.css.aonScrollArea}">
					<g:HTMLPanel>
						<table class="{aonResources.css.aonWidthAll} {aonResources.css.aonNowrap}">
							<tr>
								<td class="{aonResources.css.aonBorderBottom} {aonResources.css.aonBold}" colspan="5">
									<g:InlineLabel text="{msg.entityPartners}" />
								</td>
							</tr>
							<tr>
								<td class="{aonResources.css.aonFontMedium} {aonResources.css.aonWidth40}">
									<g:InlineLabel text="{msg.key}" />
								</td>
								<td class="{aonResources.css.aonFontMedium} {aonResources.css.aonWidth50}">
									<g:InlineLabel text="{msg.subkey}" />
								</td>
								<td class="{aonResources.css.aonFontMedium} {aonResources.css.aonWidth200}">
									<g:InlineLabel text="{msg.partType}" />
								</td>
								<td class="{aonResources.css.aonFontMedium} {aonResources.css.aonWidth130}">
									<g:InlineLabel text="{msg.province}" />
								</td>
								<td class="{aonResources.css.aonFontMedium} {aonResources.css.aonWidthAuto}">
									<g:InlineLabel text="{msg.country}" />
								</td>
							</tr>
							<tr>
								<td>
									<m184:Model184Partner2016.PartnerKeyListBox ui:field="key" styleName="aon-inputText"/>
								</td>
								<td>
									<g:ListBox ui:field="subKey"/>
								</td>
								<td>
									<g:ListBox ui:field="partType"/>
								</td>
								<td>
									<aon:ProvinceListBox ui:field="province"/>
								</td>
								<td>
									<aon:CountryListBox ui:field="country"/>
								</td>
								
							</tr>
						</table>
	
						<table class="{aonResources.css.aonWidthAll} {aonResources.css.aonNowrap}">
							<tr>
								<td class="{aonResources.css.aonFontMedium} {aonResources.css.aonWidth100}">
									<g:InlineLabel text="{msg.document}" />
								</td>
								<td class="{aonResources.css.aonFontMedium} {aonResources.css.aonWidth100}">
									<g:InlineLabel text="{msg.representativeDocument}" />
								</td>
								<td class="{aonResources.css.aonFontMedium} {aonResources.css.aonWidthAuto}">
									<g:InlineLabel text="{msg.name}" />
								</td>
							</tr>
							<tr>
								<td>
									<aon:DocumentTextBox ui:field="document"/>
								</td>
								<td>
									<aon:DocumentTextBox ui:field="representativeDocument"/>
								</td>
								<td>
									<g:TextBox ui:field="name" maxLength="40" visibleLength="30"
										styleName="{aonResources.css.aonInputText}"/>
								</td>
							</tr>
						</table>
	
						<table class="{aonResources.css.aonWidthAll} {aonResources.css.aonNowrap}">
							<tr>
								<td class="{aonResources.css.aonFontMedium} {aonResources.css.aonWidth150}">
								</td>
								<td class="{aonResources.css.aonFontMedium} {aonResources.css.aonWidth150}">
									<g:InlineLabel text="{msg.memberDays}" />
								</td>
								<td class="{aonResources.css.aonFontMedium} {aonResources.css.aonWidth150}">
									<g:InlineLabel text="{msg.partPercent}" />
								</td>
								<td class="{aonResources.css.aonFontMedium} {aonResources.css.aonWidthAuto}">
									<g:InlineLabel text="{msg.expenses184}" />
								</td>
							</tr>
							<tr>
								<td class="{aonResources.css.aonTextCenter}">
									<g:CheckBox styleName="{aonResources.css.aonFontMedium}"
										ui:field="memberEndOfYear" text="{msg.memberEndOfYear}" />
								</td>
								<td>
									<aon:IntegerBox ui:field="memberDays" maxLength="3" visibleLength="4" />
								</td>
								<td>
									<aon:DoubleBox ui:field="partPercent"/>
								</td>
								<td>
									<aon:DoubleBox ui:field="expenses"/>
								</td>
							</tr>
						</table>		
								
						<table class="{aonResources.css.aonWidthAll} {aonResources.css.aonNowrap}">
							<tr>
								<td class="{aonResources.css.aonFontMedium} {aonResources.css.aonWidthAuto}">
									<g:InlineLabel text="{msg.address}" />
								</td>
							</tr>
							<tr>
								<td>
									<g:TextBox ui:field="address" maxLength="40" visibleLength="40"
										styleName="{aonResources.css.aonInputText}"/>
								</td>
							</tr>
						</table>		
	
						<table class="{aonResources.css.aonWidthAll} {aonResources.css.aonNowrap}">
							<tr>
								<td class="{aonResources.css.aonFontMedium} {aonResources.css.aonWidth120}">
									<g:InlineLabel text="{msg.amount}" />
								</td>
								<td class="{aonResources.css.aonFontMedium} {aonResources.css.aonWidthAuto}">
									<g:InlineLabel text="{msg.reduction}" />
								</td>
							</tr>
							<tr>
								<td>
									<aon:DoubleBox ui:field="amount"/>
								</td>
								<td>
									<aon:DoubleBox ui:field="reduction"/>
								</td>
							</tr>
						</table>
	
						<table class="{aonResources.css.aonWidthAll} {aonResources.css.aonNowrap}">
							<tr>
								<td class="{aonResources.css.aonFontMedium} {aonResources.css.aonWidth120}">
									<g:InlineLabel text="{msg.nature}" />
								</td>
								<td class="{aonResources.css.aonFontMedium} {aonResources.css.aonWidth300}">
									<g:Label text="{msg.buildingLocation}" />
								</td>
								<td class="{aonResources.css.aonFontMedium} {aonResources.css.aonWidthAuto}">
									<g:Label text="{msg.cadasdralReference}" />
								</td>
							</tr>
							<tr>
								<td>
									<g:ListBox ui:field="nature"/>
								</td>
								<td>
									<g:ListBox ui:field="location" styleName="{aonResources.css.aonInputText}"/>
								</td>
								<td>
									<g:TextBox ui:field="cadasdralReference" maxLength="20" visibleLength="23" 
										styleName="{aonResources.css.aonInputText}"/>
								</td>
							</tr>
						</table>
						<table class="{aonResources.css.aonWidthAll} {aonResources.css.aonNowrap}">
							<tr>
								<td class="{aonResources.css.aonFontMedium} {aonResources.css.aonWidth120}">
									<g:Label text="{msg.declaredKey}" />
								</td>
								<td class="{aonResources.css.aonFontMedium} {aonResources.css.aonWidthAuto}">
									<g:Label text="{msg.assetPercent}" />
								</td>
							</tr>
							<tr>
								<td>
									<g:ListBox ui:field="declaredKey" styleName="{aonResources.css.aonInputText}"/>
								</td>
								<td>
									<aon:DoubleBox ui:field="assetPercent"/>
								</td>
							</tr>
						</table>
					</g:HTMLPanel>
				</g:FlowPanel>
			</g:ScrollPanel>
		</g:center>
		
	</g:DockLayoutPanel>
</ui:UiBinder>
					