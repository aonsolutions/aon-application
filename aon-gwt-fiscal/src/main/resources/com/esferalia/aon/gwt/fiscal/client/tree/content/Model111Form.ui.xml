<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<ui:UiBinder xmlns:ui='urn:ui:com.google.gwt.uibinder'
	xmlns:g='urn:import:com.google.gwt.user.client.ui' xmlns:aon='urn:import:com.esferalia.aon.gwt.common.client.widget'
	xmlns:fiscal='urn:import:com.esferalia.aon.gwt.fiscal.client.widget'
	xmlns:cell='urn:import:com.google.gwt.user.cellview.client'>

	<ui:with type="com.esferalia.aon.gwt.common.client.i18n.CommonMessages"
		field="msg"></ui:with>
	<ui:with type="com.esferalia.aon.gwt.common.client.css.AonResources"
		field="aonResources"></ui:with>

	<g:DockLayoutPanel unit="PX">
		<g:north size="26">
			<g:FlowPanel styleName="aon-finding-title-toolbar {aonResources.css.aonNoPrint}">
				<g:HorizontalPanel>
					<g:HTMLPanel styleName="aon-finding-title">
						<g:HTMLPanel styleName="aon-finding-title-internal">
							<g:Label styleName="aon-outputText" text="{msg.mod111}" />
						</g:HTMLPanel>
					</g:HTMLPanel>
					<g:HTMLPanel styleName="aon-finding-subtitle">
						<g:HTMLPanel styleName="aon-finding-subtitle-internal">
							<span>&#160;</span>
						</g:HTMLPanel>
					</g:HTMLPanel>
					<g:HorizontalPanel styleName="aon-finding-toolbar">
						<g:HTMLPanel styleName="aon-finding-toolbar-item-group">
							<g:Button ui:field='printButton'
								styleName='aon-finding-toolbar-item aon-icon-printer' text="{msg.printViaAeat}" />
						</g:HTMLPanel>
					</g:HorizontalPanel>
				</g:HorizontalPanel>
			</g:FlowPanel>
		</g:north>
		<g:north size="130">
			<g:HTMLPanel styleName="{aonResources.css.aonScrollArea}">
				<g:SimplePanel ui:field="headerPanel"/>
				<table class="{aonResources.css.aonFiscalModelDataTable} ">
					<tr>
						<td styleName="{aonResources.css.aonWidth120}">
							<g:Label text="{msg.document}" styleName="{aonResources.css.aonItalic}"/>
							<g:TextBox ui:field="document" visibleLength="10" maxLength="9" 
								styleName="{aonResources.css.aonInputText}"/>
						</td>
						<td>
							<g:Label text="{msg.companyName}" styleName="{aonResources.css.aonItalic}"/>
							<g:TextBox ui:field="name" visibleLength="30" maxLength="45" 
								styleName="{aonResources.css.aonInputText}"/>
							<g:TextBox ui:field="surname" visibleLength="30" maxLength="30"
								styleName="{aonResources.css.aonInputText}"/>
						</td>
						<td styleName="{aonResources.css.aonWidthAuto}">
							<g:Label ui:field="status" styleName="{aonResources.css.aonItalic}"/>
						</td>
						<td styleName="{aonResources.css.aonWidth50}">
							<g:ListBox ui:field="period" 
								styleName="{aonResources.css.aonFontBig} {aonResources.css.aonTextCenter} {aonResources.css.aonInputText}"/>
						</td>
						<td styleName="{aonResources.css.aonWidth70}">
							<g:Label ui:field="year" 
								styleName="{aonResources.css.aonFontBig} {aonResources.css.aonTextCenter}"/>
						</td>
					</tr>
				</table>
			</g:HTMLPanel>
		</g:north>
		<g:center>
			<g:ScrollPanel styleName="{aonResources.css.aonScrollArea}">
				<g:SimplePanel ui:field="tablePanel"/>
			</g:ScrollPanel>
		</g:center>
	</g:DockLayoutPanel>
</ui:UiBinder>
