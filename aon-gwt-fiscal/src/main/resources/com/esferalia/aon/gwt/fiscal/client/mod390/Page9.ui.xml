<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<ui:UiBinder xmlns:ui='urn:ui:com.google.gwt.uibinder'
	xmlns:g='urn:import:com.google.gwt.user.client.ui' 
	xmlns:aon='urn:import:com.esferalia.aon.gwt.common.client.widget'
	xmlns:fiscal='urn:import:com.esferalia.aon.gwt.fiscal.client.widget'>

	<ui:with type="com.esferalia.aon.gwt.common.client.i18n.CommonMessages" field="msg"></ui:with>
	<ui:with type="com.esferalia.aon.gwt.common.client.css.AonResources" field="aonResources"></ui:with>

	<ui:style>
		.table {
			width: 90%;
			border-collapse: collapse;
		}
		.table td:first-child {
			border-bottom:#ccc 1px solid;
			padding-left: 5px;
		}
		
	</ui:style>
	<g:HTMLPanel>
		<g:Label text="{msg.commonRegimePeriods}" styleName="{aonResources.css.aonPageHeader}"/>

		<table class="{style.table}">
			<colgroup>
				<col style="width: auto;" />
				<col style="width: 120px;"/>
				<col style="width: 40px;" />
				<col style="width: 120px;"/>
			</colgroup>
			<tr>
				<td colspan="2">
					<g:Label text="{msg.depositDeclarationsResult}" />
				</td>
				<td class="{aonResources.css.aonTextCenter}">
					<g:Label text="95" styleName="{aonResources.css.aonSimpleBorder} {aonResources.css.aonFontSmall} {aonResources.css.aonPadding2}" />
				</td>
				<td>
					<aon:DoubleTextBox ui:field="box95" />
				</td>
			</tr>
			
			<tr>
				<td colspan="2"> 
					<g:Label text="{msg.paybacksTotal}" />
				</td>
				<td class="{aonResources.css.aonTextCenter}">
					<g:Label text="96"  styleName="{aonResources.css.aonSimpleBorder} {aonResources.css.aonFontSmall} {aonResources.css.aonPadding2}" />
				</td>
				<td>
					<aon:DoubleTextBox ui:field="box96" />
				</td>
			</tr>
			
			<tr>
				<td colspan="2"> 
					<g:Label text="{msg.paybackTransportTotal}" />
				</td>
				<td class="{aonResources.css.aonTextCenter}">
					<g:Label text="524"  styleName="{aonResources.css.aonSimpleBorder} {aonResources.css.aonFontSmall} {aonResources.css.aonPadding2}" />
				</td>
				<td>
					<aon:DoubleTextBox ui:field="box524" />
				</td>
			</tr>
			
			<tr>
				<td rowspan="2">
					<g:Label text="{msg.lastDeclarationResult}" />
				</td>
				<td class="{aonResources.css.aonTextRight}" style="padding-right:5px;">
					<g:Label text="{msg.toCompensate}" />
				</td>
				<td class="{aonResources.css.aonTextCenter}">
					<g:Label text="97"  styleName="{aonResources.css.aonSimpleBorder} {aonResources.css.aonFontSmall} {aonResources.css.aonPadding2}" />
				</td>
				<td>
					<aon:DoubleTextBox ui:field="box97" />
				</td>
			</tr>

			<tr>
				<td class="{aonResources.css.aonTextRight}" style="padding-right:5px;">
					<g:Label text="{msg.toPayback}" />
				</td>
				<td class="{aonResources.css.aonTextCenter}">
					<g:Label text="98"  styleName="{aonResources.css.aonSimpleBorder} {aonResources.css.aonFontSmall} {aonResources.css.aonPadding2}" />
				</td>
				<td>
					<aon:DoubleTextBox ui:field="box98" />
				</td>
			</tr>
		</table>

		<g:Label text="{msg.entityGroupRegimePeriods}" styleName="{aonResources.css.aonPageHeader}"/>
		<table class="{style.table}">
			<colgroup>
				<col style="width: auto;" />
				<col style="width: 40px;" />
				<col style="width: 120px;"/>
			</colgroup>
			<tr>
				<td>
					<g:Label text="{msg.mod322PositiveResults}" />
				</td>
				<td class="{aonResources.css.aonTextCenter}">
					<g:Label text="525"  styleName="{aonResources.css.aonSimpleBorder} {aonResources.css.aonFontSmall} {aonResources.css.aonPadding2}" />
				</td>
				<td>
					<aon:DoubleTextBox ui:field="box525" />
				</td>
			</tr>
			<tr>
				<td>
					<g:Label text="{msg.mod322NegativeResults}" />
				</td>
				<td class="{aonResources.css.aonTextCenter}">
					<g:Label text="526"  styleName="{aonResources.css.aonSimpleBorder} {aonResources.css.aonFontSmall} {aonResources.css.aonPadding2}" />
				</td>
				<td>
					<aon:DoubleTextBox ui:field="box526" />
				</td>
			</tr>
		</table>
	</g:HTMLPanel>
	
</ui:UiBinder>
