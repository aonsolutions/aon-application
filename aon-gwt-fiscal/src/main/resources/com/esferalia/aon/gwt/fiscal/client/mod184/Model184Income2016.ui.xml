<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
	xmlns:g="urn:import:com.google.gwt.user.client.ui" 
	xmlns:aon="urn:import:com.esferalia.aon.gwt.common.client.widget"
	xmlns:cell="urn:import:com.google.gwt.user.cellview.client"
	xmlns:m184="urn:import:com.esferalia.aon.gwt.fiscal.client.mod184">
	
	<ui:with type="com.esferalia.aon.gwt.common.client.i18n.CommonMessages" field="msg"></ui:with>
	<ui:with type="com.esferalia.aon.gwt.common.client.css.AonResources" field="aonResources"></ui:with>
	
	<g:DockLayoutPanel>
		<g:west size="300">
			<g:DockLayoutPanel>
				<g:north size="20">
					<g:FlowPanel height="100%" styleName="{aonResources.css.aonTextRight} {aonResources.css.aonWidthAll}">
						<g:FlowPanel styleName="{aonResources.css.aonMarginLeft} {aonResources.css.aonBorderBottom} {aonResources.css.aonPadding2}">
							<g:Button ui:field="deleteDetailButton" title="{msg.deleteAction}" 
								styleName="{aonResources.css.aonIconCommandButton} {aonResources.css.aonIconDelete}  {aonResources.css.aonMarginRight}"/>
							<g:Button ui:field="restoreDeletedButton" title="{msg.restoreAction}"
								styleName="{aonResources.css.aonIconCommandButton} {aonResources.css.aonIconRedo} {aonResources.css.aonMarginRight}"/>
							<g:Button ui:field="newDetailButton" title="{msg.newPerceptor}"
								styleName="{aonResources.css.aonIconCommandButton} {aonResources.css.aonIconReset}  {aonResources.css.aonMarginRight}"/>
						</g:FlowPanel>
					</g:FlowPanel>
				</g:north>
				<g:center>
					<g:ScrollPanel ui:field="detailListPanel" styleName="{aonResources.css.aonScrollArea} {aonResources.css.aonBorderRight}">
						<cell:CellList ui:field="incomesList" styleName="{aonResources.css.aonWidthAll}"/>
					</g:ScrollPanel>
				</g:center>
			</g:DockLayoutPanel>
		</g:west>
		<g:center>
			<g:ScrollPanel styleName="{aonResources.css.aonWidthAll}">
				<g:FlowPanel styleName="{aonResources.css.aonScrollArea}">
					<g:HTMLPanel>
						<table class="{aonResources.css.aonWidthAll} {aonResources.css.aonNowrap}">
							<tr>
								<td class="{aonResources.css.aonBorderBottom} {aonResources.css.aonBold}" colspan="3">
									<g:InlineLabel text="{msg.entityIncomes}" />
								</td>
							</tr>
							<tr>
								<td class="{aonResources.css.aonFontMedium} {aonResources.css.aonWidth40}">
									<g:InlineLabel text="{msg.key}" />
								</td>
								<td class="{aonResources.css.aonFontMedium} {aonResources.css.aonWidth50}">
									<g:InlineLabel text="{msg.subkey}" />
								</td>
								<td class="{aonResources.css.aonFontMedium} {aonResources.css.aonWidthAuto}">
									<g:InlineLabel text="{msg.country}" />
								</td>
							</tr>
							<tr>
								<td>
									<m184:Model184Income2016.IncomeKeyListBox ui:field="key"/>
								</td>
								<td>
									<g:ListBox ui:field="subKey"/>
								</td>
								<td>
									<aon:CountryListBox ui:field="country"/>
								</td>
							</tr>
						</table>
	
						<table class="{aonResources.css.aonWidthAll} {aonResources.css.aonNowrap}">
							<tr>
								<td class="{aonResources.css.aonFontMedium} {aonResources.css.aonWidth200}">
									<g:InlineLabel text="{msg.granteeDocument}" />
								</td>
								<td class="{aonResources.css.aonFontMedium} {aonResources.css.aonWidth300}">
									<g:InlineLabel text="{msg.granteeName}" />
								</td>
								<td class="{aonResources.css.aonFontMedium} {aonResources.css.aonWidthAuto}">
									<g:InlineLabel text="{msg.adqDate}" />
								</td>
							</tr>
							<tr>
								<td>
									<aon:DocumentTextBox ui:field="granteeDocument"/>
								</td>
								<td>
									<g:TextBox ui:field="granteeName" maxLength="20" visibleLength="20" 
										styleName="{aonResources.css.aonInputText}"/>
								</td>
								<td>
									<aon:DateBoxEx ui:field="adqDate"/>
								</td>
							</tr>
						</table>
	
						<table class="{aonResources.css.aonWidthAll} {aonResources.css.aonNowrap}">
							<tr>
								<td class="{aonResources.css.aonFontMedium} {aonResources.css.aonWidth150}">
									<g:InlineLabel text="{msg.activityType}" />
								</td>
								<td class="{aonResources.css.aonFontMedium} {aonResources.css.aonWidth80}">
									<g:InlineLabel text="{msg.epigraph}" />
								</td>
								<td class="{aonResources.css.aonFontMedium} {aonResources.css.aonWidthAuto}">
									<g:InlineLabel text="{msg.regime}" />
								</td>
							</tr>
							<tr>
								<td>
									<g:ListBox ui:field="activityType"/>
								</td>
								<td>
									<g:TextBox ui:field="epigraph" maxLength="3" visibleLength="3"
										styleName="{aonResources.css.aonInputText}"/>
								</td>
								<td>
									<g:ListBox ui:field="regime"/>
								</td>
							</tr>
						</table>
	
						<table class="{aonResources.css.aonWidthAll} {aonResources.css.aonNowrap}">
							<tr>
								<td class="{aonResources.css.aonFontMedium} {aonResources.css.aonWidth120}">
									<g:InlineLabel text="{msg.accountingResult}" />
								</td>
								<td class="{aonResources.css.aonFontMedium} {aonResources.css.aonWidth120}">
									<g:InlineLabel text="{msg.expenses}" />
								</td>
								<td class="{aonResources.css.aonFontMedium} {aonResources.css.aonWidthAuto}">
									<g:InlineLabel text="{msg.netYieldExt}" />
								</td>
							</tr>
							<tr>
								<td>
									<aon:DoubleBox ui:field="accountingResult"/>
								</td>
								<td>
									<aon:DoubleBox ui:field="expenses"/>
								</td>
								<td>
									<aon:DoubleBox ui:field="netYield"/>
								</td>
							</tr>
						</table>
	
						<table class="{aonResources.css.aonWidthAll} {aonResources.css.aonNowrap}">
							<tr>
								<td class="{aonResources.css.aonFontMedium} {aonResources.css.aonWidth120}">
									<g:InlineLabel text="{msg.reductionPercent}" />
								</td>
								<td class="{aonResources.css.aonFontMedium} {aonResources.css.aonWidth190}">
									<g:InlineLabel text="{msg.deductionRightRent}" />
								</td>
								<td class="{aonResources.css.aonFontMedium} {aonResources.css.aonWidthAuto}">
									<g:InlineLabel text="{msg.profitLoss}" />
								</td>
							</tr>
							<tr>
								<td>
									<aon:DoubleBox ui:field="reductionPercent"/>
								</td>
								<td>
									<aon:DoubleBox ui:field="deductionRightRent"/>
								</td>
								<td>
									<aon:DoubleBox ui:field="result"/>
								</td>
							</tr>
						</table>
	
						<table class="{aonResources.css.aonWidthAll} {aonResources.css.aonNowrap}">
							<tr>
								<td class="{aonResources.css.aonFontMedium} {aonResources.css.aonWidth140}">
									<g:InlineLabel text="{msg.adjustDecrease}" />
								</td>
								<td class="{aonResources.css.aonFontMedium} {aonResources.css.aonWidth120}">
									<g:InlineLabel text="{msg.adjustIncrease}" />
								</td>
								<td class="{aonResources.css.aonFontMedium} {aonResources.css.aonWidth150}">
									<g:InlineLabel text="{msg.deductionBase}" />
								</td>
								<td class="{aonResources.css.aonFontMedium} {aonResources.css.aonWidthAuto}">
									<g:InlineLabel text="{msg.retentionAccountDeposit}" />
								</td>
							</tr>
							<tr>
								<td>
									<aon:DoubleBox ui:field="decrease"/>
								</td>
								<td>
									<aon:DoubleBox ui:field="increase"/>
								</td>
								<td>
									<aon:DoubleBox ui:field="deductionBase"/>
								</td>
								<td>
									<aon:DoubleBox ui:field="retention"/>
								</td>
							</tr>
						</table>
						<table class="{aonResources.css.aonWidthAll} {aonResources.css.aonNowrap}">
							<tr>
								<td class="{aonResources.css.aonBorderBottom} {aonResources.css.aonBold}" colspan="2">
									<g:InlineLabel text="{msg.buildingData}" />
								</td>
							</tr>
							<tr>
								<td class="{aonResources.css.aonFontMedium} {aonResources.css.aonWidth300}">
									<g:Label text="{msg.buildingLocation}" />
								</td>
								<td class="{aonResources.css.aonFontMedium} {aonResources.css.aonWidthAuto}">
									<g:Label text="{msg.cadasdralReference}" />
								</td>
							</tr>
							<tr>
								<td>
									<g:ListBox ui:field="location" styleName="{aonResources.css.aonInputText}"/>
								</td>
								<td>
									<g:TextBox ui:field="cadasdralReference" maxLength="20" visibleLength="23" 
										styleName="{aonResources.css.aonInputText}"/>
								</td>
							</tr>
						</table>
						<table class="{aonResources.css.aonWidthAll} {aonResources.css.aonNowrap}">
							<tr>
								<td class="{aonResources.css.aonBorderBottom} {aonResources.css.aonBold}" colspan="2">
									<g:InlineLabel text="{msg.expenseDetail}" />
								</td>
							</tr>
							<tr>
								<td class="{aonResources.css.aonFontMedium} {aonResources.css.aonWidth300}">
									<g:Label text="{msg.staffExpenses}" />
								</td>
								<td class="{aonResources.css.aonFontMedium} {aonResources.css.aonWidthAuto}">
									<g:Label text="{msg.assetAcquisition}" />
								</td>
							</tr>
							<tr>
								<td>
									<aon:DoubleBox ui:field="staffExpenses"/>
								</td>
								<td>
									<aon:DoubleBox ui:field="assetAcquisition"/>
								</td>
							</tr>
							<tr>
								<td class="{aonResources.css.aonFontMedium} {aonResources.css.aonWidth300}">
									<g:Label text="{msg.taxDeduction}" />
								</td>
								<td class="{aonResources.css.aonFontMedium} {aonResources.css.aonWidthAuto}">
									<g:Label text="{msg.otherTaxDeduction}" />
								</td>
								<td></td>
							</tr>
							<tr>
								<td>
									<aon:DoubleBox ui:field="taxDeduction"/>
								</td>
								<td>
									<aon:DoubleBox ui:field="otherTaxDeduction"/>
								</td>
								<td class="{aonResources.css.aonFontMedium}">
									<g:CheckBox ui:field="vatAccrualPayment" text="{msg.vatAccrualPayment184}"/>
								</td>
							</tr>
						</table>
					</g:HTMLPanel>
				</g:FlowPanel>
			</g:ScrollPanel>
		</g:center>
		
	</g:DockLayoutPanel>
</ui:UiBinder>
