<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
	xmlns:g="urn:import:com.google.gwt.user.client.ui" 
	xmlns:aon="urn:import:com.esferalia.aon.gwt.common.client.widget"
	xmlns:mod200="urn:import:com.esferalia.aon.gwt.fiscal.client.mod200.e2016">

	<ui:with type="com.esferalia.aon.gwt.common.client.i18n.CommonMessages" field="msg"></ui:with>
	<ui:with type="com.esferalia.aon.gwt.common.client.css.AonResources" field="aonResources"></ui:with>

	<g:DockLayoutPanel unit="PX" ui:field="dockLayoutPanel">
		<g:north size="26">
			<g:FlowPanel styleName="{aonResources.css.aonFindingTitleToolbar}">
				<g:HorizontalPanel>
					<g:HTMLPanel styleName="{aonResources.css.aonFindingTitle}">
						<g:HTMLPanel styleName="{aonResources.css.aonFindingTitleInternal}">
							<g:Label text="{msg.mod200}" />
						</g:HTMLPanel>
					</g:HTMLPanel>
					<g:HTMLPanel>
						<g:HTMLPanel styleName="{aonResources.css.aonFindingSubtitleIternal}">
							<g:Label></g:Label>
						</g:HTMLPanel>
					</g:HTMLPanel>
					<g:HorizontalPanel styleName="{aonResources.css.aonFindingToolbar}">
						<g:HTMLPanel styleName="{aonResources.css.aonFindingToolbarItemGroup} {aonResources.css.aonNowrap}">
							<g:Button ui:field="initializeButton"
								styleName="{aonResources.css.aonFindingToolbarItem} {aonResources.css.aonIconSave}" 
								text="{msg.continueAction}" />
							<g:Button ui:field="saveButton"
								styleName="{aonResources.css.aonFindingToolbarItem} {aonResources.css.aonIconSave}" 
								text="{msg.saveAction}" />
							<g:Button ui:field="cancelButton"
								styleName="{aonResources.css.aonFindingToolbarItem} {aonResources.css.aonIconCancel}" 
								text="{msg.cancelAction}" />
							<g:Button ui:field="removeButton"
								styleName="{aonResources.css.aonFindingToolbarItem} {aonResources.css.aonIconDelete}" 
								text="{msg.deleteAction}" />
							<g:Button ui:field="validateButton"
								styleName="{aonResources.css.aonFindingToolbarItem} {aonResources.css.aonIconValidate}" 
								text="{msg.validateAction}" />
							<g:Button ui:field="calculateButton"
								styleName="{aonResources.css.aonFindingToolbarItem} {aonResources.css.aonIconCalculator}" 
								text="{msg.calculateAction}" />
							<g:CheckBox ui:field="calculateCheck" text="{msg.authomaticCalculation}"/>
							<g:Button ui:field="aeatFileButton"
								styleName="{aonResources.css.aonFindingToolbarItem} {aonResources.css.aonIconAeat}" 
								text="{msg.generateFile}"
								title="{msg.generateFileAbr}" />
							<g:Button ui:field="aeatPrintButton"
								styleName="{aonResources.css.aonFindingToolbarItem} {aonResources.css.aonIconAeat}"
								text="{msg.print}" 
								title="{msg.printViaAeat}" />
							<g:Button ui:field="importAccountingButton"
								styleName="{aonResources.css.aonFindingToolbarItem} {aonResources.css.aonIconMoveUp}"
								text="{msg.importAccountingAbr}" 
								title="{msg.importAccounting}" />
							<g:Button ui:field="aeatAccountingFileButton"
								styleName="{aonResources.css.aonFindingToolbarItem} {aonResources.css.aonIconAeatBW}"
								title="{msg.aeatAccountingFile}" 
								text="{msg.aeatAccountingFileAbr}" />
						</g:HTMLPanel>
						<g:FlowPanel ui:field="formContainer" />
					</g:HorizontalPanel>
				</g:HorizontalPanel>
			</g:FlowPanel>
		</g:north>
		<g:north size="55">
			<g:SimplePanel ui:field="headerPanel"/>
		</g:north>
		<g:center>
			<g:SplitLayoutPanel ui:field="splitLayoutPanel">
				<g:south size="30">
					<aon:MinimizePanel ui:field="footPanel" styleName="{aonResources.css.aonSelector}">
						<g:TabLayoutPanel ui:field="tabLayout" barHeight="26" barUnit="PX" width="100%">
							<g:tab>
								<g:customHeader>
									<g:Label
										styleName="{aonResources.css.aonIconJournalLog} {aonResources.css.aonPaddingRight}"  
										text="Notificaciones" />
								</g:customHeader>
								<aon:ResultsPanel ui:field="resultsPanel" />
							</g:tab>
							<g:tab>
								<g:customHeader>
									<g:Label ui:field="fiscalInformationLabel" text="{msg.fiscalInformation}" />
								</g:customHeader>
								<g:ScrollPanel ui:field="infoContainer" styleName="{aonResources.css.aonScrollArea}"/>
							</g:tab>
						</g:TabLayoutPanel>
					</aon:MinimizePanel>
				</g:south>
				<g:west size="200">
					<g:ScrollPanel styleName="{aonResources.css.aonLinkPanel}">
						<g:FlowPanel ui:field='linkContainer' styleName="{aonResources.css.aonLinkContainer}" />
					</g:ScrollPanel>
				</g:west>
				<g:center>
					<g:DeckLayoutPanel ui:field="deckPanel">
						<g:SimplePanel ui:field="page"/>
						<mod200:Page00 ui:field="page00"/>
						<mod200:Page01 ui:field="page01"/>
						<mod200:Page02 ui:field="page02"/>
						<mod200:Page03 ui:field="page03"/>
						<mod200:Page04 ui:field="page04"/>
						<mod200:Page05 ui:field="page05"/>
						<mod200:Page06 ui:field="page06"/>
						<mod200:Page07 ui:field="page07"/>
						<mod200:Page08 ui:field="page08"/>
						<mod200:Page09 ui:field="page09"/>
						<mod200:Page10 ui:field="page10"/>
						<mod200:Page11 ui:field="page11"/>
						<mod200:Page12 ui:field="page12"/>
						<mod200:Page13 ui:field="page13"/>
						<mod200:Page14 ui:field="page14"/>
					</g:DeckLayoutPanel>
				</g:center>
			</g:SplitLayoutPanel>
		</g:center>
	</g:DockLayoutPanel>
</ui:UiBinder>
