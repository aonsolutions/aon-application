<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<ui:UiBinder xmlns:ui='urn:ui:com.google.gwt.uibinder'
	xmlns:g='urn:import:com.google.gwt.user.client.ui' 
	xmlns:cell='urn:import:com.google.gwt.user.cellview.client'
	xmlns:aon='urn:import:com.esferalia.aon.gwt.common.client.widget'
	xmlns:fiscal='urn:import:com.esferalia.aon.gwt.fiscal.client.widget'
	xmlns:m184='urn:import:com.esferalia.aon.gwt.fiscal.client.mod184'>

	<ui:with type="com.esferalia.aon.gwt.common.client.i18n.CommonMessages" field="msg"></ui:with>
	<ui:with type="com.esferalia.aon.gwt.common.client.css.AonResources" field="aonResources"></ui:with>

	<ui:style>
		.scrollable {
			height: 100%;
			width: 100%;
			border: 1px solid #ccc;
			text-align: left;
		}
		.newDetailButton {
			background-color: rgba(0, 0, 0, 0);
			border: 0 none;
			cursor: pointer;
			min-height: 16px;
		}
	</ui:style>

	<g:SplitLayoutPanel ui:field="splitLayoutPanel">
		<g:north size="26">
			<g:FlowPanel ui:field="toolbarPanel" height="100%"
				styleName="aon-finding-title-toolbar aon-width-all">
				<g:HorizontalPanel>
					<g:HTMLPanel styleName="aon-finding-title">
						<g:HTMLPanel styleName="aon-finding-title-internal">
							<g:Label styleName="aon-outputText" text="{msg.mod184}" />
						</g:HTMLPanel>
					</g:HTMLPanel>
					<g:HTMLPanel styleName="aon-finding-subtitle">
						<g:HTMLPanel styleName="aon-finding-subtitle-internal">
							<g:Label styleName="aon-outputText"></g:Label>
						</g:HTMLPanel>
					</g:HTMLPanel>
					<g:HTMLPanel styleName="aon-finding-toolbar">
						<g:HTMLPanel styleName="aon-finding-toolbar-item-group">
							<g:Button ui:field='newButton'
								styleName='aon-finding-toolbar-item aon-icon-reset' text="{msg.newAction}" />
							<g:Button ui:field='saveButton'
								styleName='aon-finding-toolbar-item aon-icon-accept' text="{msg.saveAction}" />
							<g:Button ui:field='cancelButton'
								styleName='aon-finding-toolbar-item aon-icon-cancel' text="{msg.cancelAction}" />
							<g:Button ui:field='deleteButton'
								styleName='aon-finding-toolbar-item aon-icon-delete' text="{msg.deleteAction}" />
							<g:Button ui:field='printButton'
								styleName='aon-finding-toolbar-item aon-icon-printer' text="{msg.printViaAeat}" />
							<g:Button ui:field='generateFileButton'
								styleName="aon-finding-toolbar-item aon-icon-aeat" text="{msg.generateFile}" />
							<g:Anchor ui:field="download" visible="false"/>							
							<g:FlowPanel ui:field="formContainer">
							</g:FlowPanel>
						</g:HTMLPanel>
					</g:HTMLPanel>
				</g:HorizontalPanel>
			</g:FlowPanel>
		</g:north>
		<g:center>
			<g:DeckLayoutPanel ui:field="deckPanel">
				<g:DockLayoutPanel ui:field="formPanel" unit="PX">
					<g:north size="140">
						<g:HTMLPanel styleName="aon-scroll-area">
							<g:HorizontalPanel ui:field='messagesPanel'/>
							<table class="aon-panelGrid aon-margin-top aon-width-all">
								<colgroup>
									<col style="width: 120px;" />
									<col style="width: 180px;" />
									<col style="width: 120px;" />
									<col style="width: 110px;" />
									<col style="width: 120px;" />
									<col style="width: auto; white-space: nowrap;" />
								</colgroup>
								<tr>
									<td class="aon-panelGrid-odd">
										<g:Label text="{msg.deponentData}" />
									</td>
									<td class="aon-panelGrid-even" colspan="5">
										<fiscal:EnterpriseSuggestBox ui:field="enterpriseSuggest" />
									</td>
								</tr>
								
								<tr>
									<td class="aon-panelGrid-odd">
										<g:Label text="{msg.fiscalYear}" />
									</td>
									<td class="aon-panelGrid-even aon-nowrap">
										<g:TextBox maxLength="4" visibleLength="4" ui:field="year" styleName="aon-inputText"/>
										<g:CheckBox ui:field="confidential" text="{msg.confidential}" />
									</td>
<!--									
									<td class="aon-panelGrid-odd">
										<g:Label text="{msg.administration}" />
									</td>
-->
									<td class="aon-panelGrid-even">
										<aon:AdministrationListBox ui:field="administration" />
									</td>
									<td class="aon-panelGrid-odd">
										<g:Label text="{msg.receipt}" />
									</td>
									<td class="aon-panelGrid-even">
										<g:TextBox visibleLength="13" maxLength="13" ui:field="receipt" styleName="aon-inputText"/>
									</td>
									<td class="aon-panelGrid-even aon-nowrap">
										<g:HorizontalPanel>
											<g:CheckBox ui:field="replacement" text="{msg.replacement}" />
											<g:FlowPanel ui:field="replacementPanel">
												<g:InlineLabel text="{msg.replacedReceipt}" styleName="{aonResources.css.aonInnerLabel}"/>
												<g:TextBox visibleLength="13" maxLength="13" ui:field="replacedReceipt" styleName="aon-inputText"/>
											</g:FlowPanel>
										</g:HorizontalPanel>
									</td>
								</tr>
								
								<tr>
									<td class="aon-panelGrid-odd">
										<g:Label text="{msg.contactPerson}" />
									</td>
									<td class="aon-panelGrid-even aon-nowrap" colspan="5">
										<g:InlineLabel text="{msg.phone}"  styleName="{aonResources.css.aonInnerLabel}" />
										<g:TextBox visibleLength="10" maxLength="9" ui:field="contactPhone" styleName="aon-inputText"/>
										<g:InlineLabel text="{msg.contactPerson}" styleName="{aonResources.css.aonInnerLabel}" />
										<g:TextBox visibleLength="30" maxLength="40" ui:field="contactPerson" styleName="aon-inputText"/>
									</td>
								</tr>
								<tr>
									<td class="aon-panelGrid-odd">
										<g:Label text="{msg.comments}" />
									</td>
									<td class="aon-panelGrid-even" colspan="5">
										<g:TextArea visibleLines="1" characterWidth="80"
											ui:field="comments" styleName="aon-inputText"/>
									</td>
								</tr>
							</table>
						</g:HTMLPanel>
					</g:north>
					<g:center>
						<g:TabLayoutPanel ui:field="tabPanel" barUnit='PX' barHeight='30'>
							<g:tab>
								<g:customHeader>
									<g:Label text="Entidad" />
								</g:customHeader>
								<g:HTMLPanel styleName="aon-scroll-area">
								 	<div class="{aonResources.css.aonGroup}">
										<div class="{aonResources.css.aonGroupTitle}">
											<g:InlineLabel text="{msg.localEntities}" />
										</div>
										<div class="{aonResources.css.aonGroupBody}">
											<table>
												<tr>
													<td>
														<g:InlineLabel text="{msg.entityType}" />
													</td>
													<td>
														<g:InlineLabel text="{msg.mainActivity}" />
													</td>
												</tr>
												<tr>
													<td>
														<g:ListBox ui:field="entityType" styleName="aon-inputText"/> 
													</td>
													<td>
														<g:ListBox ui:field="mainActivity" styleName="aon-inputText"/>
													</td>
												</tr>
											</table>
										</div>
									</div>
								
								 	<div class="{aonResources.css.aonGroup}">
										<div class="{aonResources.css.aonGroupTitle}">
											<g:InlineLabel text="{msg.foreignEntities}" />
										</div>
										<div class="{aonResources.css.aonGroupBody}">
											<table>
												<tr>
													<td>
														<g:InlineLabel text="{msg.entityType}" />
													</td>
													<td>
														<g:InlineLabel text="{msg.object}" />
													</td>
													<td>
														<g:InlineLabel text="{msg.country}" />
													</td>
													<td>
														<g:InlineLabel text="{msg.residentPercent}" />
													</td>
												</tr>
												
												<tr>
													<td>
														<g:ListBox ui:field="foreignEntityType" styleName="aon-inputText"/>
													</td>
													<td>
														<g:ListBox ui:field="foreignObject" styleName="aon-inputText"/>
													</td>
													<td>
														<aon:CountryListBox ui:field="country" styleName="aon-inputText"/>
													</td>
													<td>
														<aon:DoubleTextBox ui:field="residentPercent" styleName="aon-inputText"/>
													</td>
												</tr>
											</table>
										</div>
									</div>
								
									<table>
										<tr>
											<td>
												<g:InlineLabel text="{msg.isTax}" />
											</td>
											<td>
												<g:InlineLabel text="{msg.netAmount}" />
											</td>
										</tr>
										<tr>
											<td class="{aonResources.css.aonTextCenter}">
												<g:CheckBox ui:field="taxIS"/>
											</td>
											<td>
												<aon:DoubleTextBox ui:field="netSalesAmount" styleName="aon-inputText"/>
											</td>
										</tr>
										<tr>
											<td>
												<g:InlineLabel text="{msg.lrDocument}" />
											</td>
											<td>
												<g:InlineLabel text="{msg.lrName}" />
											</td>
										</tr>
										<tr>
											<td>
												<aon:DocumentTextBox ui:field="lrDocument" styleName="aon-inputText"/>
											</td>
											<td>
												<g:TextBox ui:field="lrName" maxLength="40" visibleLength="40" styleName="aon-inputText"/>
											</td>
										</tr>
									</table>
								</g:HTMLPanel>
							</g:tab>
							
							<g:tab>
								<g:customHeader>
									<g:Label text="{msg.entityIncomes}" />
								</g:customHeader>
								<g:SplitLayoutPanel>
									<g:west size="300">
										<g:HTMLPanel styleName="aon-scroll-area">
											<div class="{aonResources.css.aonTextRight}">
												<g:Button ui:field='newIncomeButton' title="{msg.newPerceptor}"
													styleName='{style.newDetailButton} aon-icon-reset' />
											</div>
											<aon:ShowMorePagerPanel addStyleNames="{style.scrollable}" ui:field="incomesPagerPanel" />
										</g:HTMLPanel>
									</g:west>
									<g:center>
										<g:HTMLPanel styleName="aon-scroll-area">
											<m184:Model184Income2014 ui:field="incomesPanel"/>
										</g:HTMLPanel>
									</g:center>
								</g:SplitLayoutPanel>
							</g:tab>
							
							<g:tab>
								<g:customHeader>
									<g:Label text="{msg.entityPartners}" />
								</g:customHeader>
								<g:SplitLayoutPanel>
									<g:west size="300">
										<g:HTMLPanel styleName="aon-scroll-area">
											<div class="{aonResources.css.aonTextRight}">
												<g:Button ui:field='newPartnerButton' title="{msg.newPerceptor}"
													styleName='{style.newDetailButton} aon-icon-reset' />
											</div>
											<aon:ShowMorePagerPanel addStyleNames="{style.scrollable}" ui:field="partnersPagerPanel" />
										</g:HTMLPanel>
									</g:west>
									<g:center>
										<g:HTMLPanel styleName="aon-scroll-area">
											<m184:Model184Partner2014 ui:field="partnersPanel" />
										</g:HTMLPanel>
									</g:center>
								</g:SplitLayoutPanel>
							</g:tab>
						</g:TabLayoutPanel>
					</g:center>
				</g:DockLayoutPanel>

				<g:ScrollPanel ui:field="listPanel" styleName="aon-scroll-area">
					<m184:Model184Table ui:field="table" />
				</g:ScrollPanel>
				
			</g:DeckLayoutPanel>
		</g:center>
		<g:south size="0">
			<aon:MinimizePanel ui:field="footPanel">
				<g:TabLayoutPanel barHeight="26" barUnit="PX">
					<g:tab>
						<g:header>
							<span class="aon-icon-time aon-icon-commandButton" style="padding-left: 20px;">
								Notificaciones
							</span>
						</g:header>
						<aon:ResultsPanel ui:field="resultsPanel" />
					</g:tab>
				</g:TabLayoutPanel>
			</aon:MinimizePanel>
		</g:south>
	</g:SplitLayoutPanel>
</ui:UiBinder>
