									</td>
									<td class="gwt-MenuBar-horizontal"
										style="width: auto;font-weight:bold; padding-left: 15px;vertical-align:top;">
										<g:Label text="{msg.receiverList}" />
									</td>
								</tr>
							</table>
						</g:HTMLPanel>
