<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<ui:UiBinder xmlns:ui='urn:ui:com.google.gwt.uibinder'
	xmlns:g='urn:import:com.google.gwt.user.client.ui' 
	xmlns:aon='urn:import:com.esferalia.aon.gwt.common.client.widget'
	xmlns:fiscal='urn:import:com.esferalia.aon.gwt.fiscal.client.widget'
	xmlns:m193='urn:import:com.esferalia.aon.gwt.fiscal.client.mod193'
	xmlns:cell='urn:import:com.google.gwt.user.cellview.client'>

	<ui:with type="com.esferalia.aon.gwt.common.client.i18n.CommonMessages" field="msg"></ui:with>
	<ui:with type="com.esferalia.aon.gwt.common.client.css.AonResources" field="aonResources"></ui:with>
	
	<g:DockLayoutPanel>
		<g:north size="26">
			<g:HTMLPanel height="100%" 
				styleName="{aonResources.css.aonFindingTitleToolbar} {aonResources.css.aonWidthAll}">
				<table cellpadding="0" cellspacing="0" class="{aonResources.css.aonWidthAll}">				
					<tr>
						<td class="{aonResources.css.aonFindingTitle}">
							<g:FlowPanel styleName="{aonResources.css.aonFindingTitleInternal}">
								<g:Label text="{msg.mod193}" />
							</g:FlowPanel>
						</td>
						<td>
							<g:HTMLPanel styleName="{aonResources.css.aonFindingSubtitleIternal}">
								<g:Label/>
							</g:HTMLPanel>
						</td>
						<td class="{aonResources.css.aonFindingToolbar}">
							<g:FlowPanel styleName="{aonResources.css.aonFindingToolbarItemGroup}">
								<g:Button ui:field="newButton" text="{msg.newAction}" 
									styleName="{aonResources.css.aonFindingToolbarItem} {aonResources.css.aonIconReset}"/>
								<g:Button ui:field="saveButton"  text="{msg.saveAction}" 
									styleName="{aonResources.css.aonFindingToolbarItem} {aonResources.css.aonIconSave}"/>
								<g:Button ui:field="cancelButton" text="{msg.cancelAction}" 
									styleName="{aonResources.css.aonFindingToolbarItem} {aonResources.css.aonIconCancel}" />
								<g:Button ui:field="deleteButton" text="{msg.deleteAction}" 
									styleName="{aonResources.css.aonFindingToolbarItem} {aonResources.css.aonIconDelete}" />
								<g:Button ui:field="printButton" text="{msg.printViaAeat}"
									styleName="{aonResources.css.aonFindingToolbarItem} {aonResources.css.aonIconPdfPreview}" />
								<g:Button ui:field="generateFileButton" text="{msg.generateFile}"
									styleName="{aonResources.css.aonFindingToolbarItem} {aonResources.css.aonIconAeat}"  />
								<g:Anchor ui:field="download" visible="false"/>							
								<g:FlowPanel ui:field="formContainer">
								</g:FlowPanel>
							</g:FlowPanel>
						</td>
					</tr>
				</table>
			</g:HTMLPanel>
		</g:north>
		
		<g:center>
			<g:SplitLayoutPanel ui:field="splitLayoutPanel">
				<g:center>
					<g:DeckLayoutPanel ui:field="deckPanel">
						<g:DockLayoutPanel ui:field="formPanel" unit="PX">
							<g:north size="65">
								<g:SimplePanel ui:field="headerPanel"/>
							</g:north>
							<g:north size="100">
								<g:HTMLPanel styleName="{aonResources.css.aonScrollArea}">
									<table class="{aonResources.css.aonPanelGrid} {aonResources.css.aonWidthAll}">
										<colgroup>
											<col style="width: 120px;" />
											<col style="width: 180px;" />
											<col style="width: 110px;" />
											<col style="width: 120px;" />
											<col style="width: 110px;" />
											<col style="width: 120px;" />
											<col style="width: auto; white-space: nowrap;" />
										</colgroup>
										<tr>
											<td class="{aonResources.css.aonPanelGridOdd}">
												<g:Label text="{msg.deponentData}" />
											</td>
											<td class="{aonResources.css.aonPanelGridEven}" colspan="6">
												<fiscal:EnterpriseSuggestBox ui:field="enterpriseSuggest" />
											</td>
										</tr>
										
										<tr>
											<td class="{aonResources.css.aonPanelGridOdd}">
												<g:Label text="{msg.fiscalYear}" />
											</td>
											<td class="{aonResources.css.aonPanelGridEven} {aonResources.css.aonNowrap}">
												<aon:IntegerBox maxLength="4" visibleLength="4" ui:field="year"/>
												<g:CheckBox ui:field="confidential" text="{msg.confidential}" />
											</td>
											<td class="{aonResources.css.aonPanelGridOdd}">
												<g:Label text="{msg.administration}" />
											</td>
											<td class="{aonResources.css.aonPanelGridEven}">
												<aon:AdministrationListBox ui:field="administration" />
											</td>
											<td class="{aonResources.css.aonPanelGridOdd}">
												<g:Label text="{msg.receipt}" />
											</td>
											<td class="{aonResources.css.aonPanelGridEven}">
												<g:TextBox visibleLength="13" maxLength="13" ui:field="receipt" 
													styleName="{aonResources.css.aonInputText}"/>
											</td>
											<td class="{aonResources.css.aonPanelGridEven} {aonResources.css.aonNowrap}">
												<g:HorizontalPanel>
													<g:CheckBox ui:field="replacement" text="{msg.replacement}" />
													<g:FlowPanel ui:field="replacementPanel">
														<g:InlineLabel text="{msg.replacedReceipt}" styleName="{aonResources.css.aonInnerLabel}"/>
														<g:TextBox visibleLength="13" maxLength="13" ui:field="replacedReceipt" 
															styleName="{aonResources.css.aonInputText}"/>
													</g:FlowPanel>
												</g:HorizontalPanel>
											</td>
										</tr>
										
										<tr>
											<td class="{aonResources.css.aonPanelGridOdd}">
												<g:Label text="{msg.contactPerson}" />
											</td>
											<td class="{aonResources.css.aonPanelGridEven} {aonResources.css.aonNowrap}" colspan="6">
											 	<g:InlineLabel text="{msg.phone}"  styleName="{aonResources.css.aonInnerLabel}" />
												<g:TextBox visibleLength="10" maxLength="9" ui:field="contactPhone" 
													styleName="{aonResources.css.aonInputText}"/>
												<g:InlineLabel text="{msg.contactPerson}" styleName="{aonResources.css.aonInnerLabel}" />
												<g:TextBox visibleLength="30" maxLength="40" ui:field="contactPerson" 
													styleName="{aonResources.css.aonInputText}"/>
											</td>
										</tr>
									</table>
								</g:HTMLPanel>
							</g:north>
							<g:center>
								<g:SimpleLayoutPanel  ui:field="perceptorPanel" />
							</g:center>
						</g:DockLayoutPanel>
		
						<g:ScrollPanel ui:field="listPanel" styleName="{aonResources.css.aonScrollArea}">
							<m193:Model193Table ui:field="table" />
						</g:ScrollPanel>
					</g:DeckLayoutPanel>
				</g:center>
				<g:south size="0">
					<aon:MinimizePanel ui:field="footPanel" styleName="{aonResources.css.aonSelector}">
						<g:TabLayoutPanel barHeight="26" barUnit="PX">
							<g:tab>
								<g:header>
									<span class="aon-icon-time aon-icon-commandButton" style="padding-left: 20px;">
										Notificaciones
									</span>
								</g:header>
								<aon:ResultsPanel ui:field="resultsPanel" />
							</g:tab>
						</g:TabLayoutPanel>
					</aon:MinimizePanel>
				</g:south>
			</g:SplitLayoutPanel>
		</g:center>
	</g:DockLayoutPanel>
</ui:UiBinder>
