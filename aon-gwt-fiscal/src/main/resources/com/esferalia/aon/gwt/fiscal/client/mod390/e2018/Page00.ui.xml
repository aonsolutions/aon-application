<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<ui:UiBinder xmlns:ui='urn:ui:com.google.gwt.uibinder'
	xmlns:g='urn:import:com.google.gwt.user.client.ui' 
	xmlns:aon='urn:import:com.esferalia.aon.gwt.common.client.widget'>

	<ui:with type="com.esferalia.aon.gwt.common.client.i18n.CommonMessages" field="msg"></ui:with>
	<ui:with type="com.esferalia.aon.gwt.common.client.css.AonResources" field="aonResources"></ui:with>

	<g:HTMLPanel styleName="{aonResources.css.aonMarginTop}">
		<table class="{aonResources.css.aonWidthAll}">
			<tr>
				<td colspan="2" class="{aonResources.css.aonPageHeader}">
					<g:Label text="{msg.deponentData}"/>
				</td>
			</tr>
			<tr>
				<td class="{aonResources.css.aonBorderBottom} {aonResources.css.aonBold}" colspan="2">
					<g:InlineLabel text="{msg.identification}"/>
				</td>
			</tr>
			<tr>
				<td>
					<g:Label text="{msg.document}" />
				</td>
				<td>
					<aon:DocumentTextBox ui:field="document"/>
				</td>
			</tr>
			<tr>
				<td>
					<g:Label text="{msg.name}" />
				</td>
				<td>
					<g:TextBox ui:field="name" visibleLength="25" styleName="{aonResources.css.aonInputText}"/>
				</td>
			</tr>
			<tr>
				<td>
					<g:Label text="{msg.surname}" />
				</td>
				<td>
					<g:TextBox ui:field="firstSurname" maxLength="15" visibleLength="16" styleName="{aonResources.css.aonInputText}"/>
					<g:TextBox ui:field="secondSurname" maxLength="15" visibleLength="16" styleName="{aonResources.css.aonInputText}"/>
				</td>
			</tr>
			<tr>
				<td>
					<g:Label text="{msg.phone}" />
				</td>
				<td>
					<g:TextBox ui:field="phone" styleName="{aonResources.css.aonInputText}"/>
				</td>
			</tr>
			<tr>
				<td></td>
				<td>
					<g:CheckBox ui:field="replacement" text="{msg.replacement}" />
				</td>
			</tr>
			<tr>
				<td></td>
				<td>
					<g:CheckBox ui:field="replacementDueInsolvencyState" text="{msg.replacementDueInsolvencyState}" />
				</td>
			</tr>
			<tr>
				<td></td>
				<td>
					<g:Label text="{msg.replacedReceipt}" styleName="{aonResources.css.aonInnerLabel}" />
					<g:TextBox visibleLength="13" ui:field="replacedReceipt" styleName="{aonResources.css.aonInputText}"/>
				</td>
			</tr>
			
			<tr>
				<td colspan="2">
					<g:CheckBox ui:field="taxRefund" text="{msg.taxRefund}" />
				</td>
			</tr>
			
			<tr>
				<td colspan="2">
					<g:CheckBox ui:field="specialGroupRegime" text="{msg.specialGroupRegime}" />
					<div style="margin-left: 15px; padding-left: 5px; padding-right: 5px">
						<g:Label text="{msg.groupNumber}" styleName="{aonResources.css.aonInnerLabel}" />
						<g:TextBox maxLength="5" visibleLength="5" ui:field="groupNumber" styleName="{aonResources.css.aonInputText}"/>
						<g:CheckBox ui:field="groupDependent" text="{msg.groupDependent}" />
					</div>
					<div style="margin-left: 15px; padding-left: 5px; padding-right: 5px">
						<g:CheckBox ui:field="groupRegimeType" text="{msg.groupRegimeType}" />
						<g:Label text="{msg.groupDocument}" styleName="{aonResources.css.aonInnerLabel}" />
						<aon:DocumentTextBox ui:field="groupDocument"/>
					</div>
					<div style="margin-left: 15px; padding-left: 5px; padding-right: 5px">
						<g:CheckBox ui:field="groupDeclarations" text="{msg.groupDeclarations}" />
					</div>
				</td>
			</tr>
			<tr>
				<td colspan="2">
					<g:DeckPanel ui:field="page0Panel">
					
						<g:FlowPanel ui:field="panel0">
								<g:CheckBox ui:field="insolvencyDeclarations" text="{msg.insolvencyDeclarations}" />
						</g:FlowPanel>
			
						<g:FlowPanel ui:field="panel1">
							<g:HTMLPanel>
								<table class="{aonResources.css.aonWidthAll}">
									<tr>
										<td class="{aonResources.css.aonBorderBottom} {aonResources.css.aonBold}">
											<g:InlineLabel text="{msg.insolvencyState}"/>
										</td>	
									</tr>
									<tr>
										<td>
											<g:CheckBox ui:field="insolvencyStateThisYear" text="{msg.insolvencyStateThisYear}" />
										</td>
									</tr>
									<tr>
										<td class="{aonResources.css.aonBorderBottom} {aonResources.css.aonBold}">
											<g:InlineLabel text="{msg.cashAccrualRegime}"/>
										</td>
									</tr>
									<tr>
										<td>
											<g:CheckBox ui:field="accrualRegime" text="{msg.accrualRegime}" />
										</td>
									</tr>
									<tr>
										<td>
											<g:CheckBox ui:field="accrualRegimeTarget" text="{msg.accrualRegimeTarget}" />
										</td>
									</tr>
								</table>
							</g:HTMLPanel>
						</g:FlowPanel>
					</g:DeckPanel>
				</td>
			</tr>
		</table>
 	</g:HTMLPanel>
</ui:UiBinder>
