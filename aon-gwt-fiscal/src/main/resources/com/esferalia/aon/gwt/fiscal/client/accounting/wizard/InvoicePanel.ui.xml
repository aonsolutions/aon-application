<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
	xmlns:g="urn:import:com.google.gwt.user.client.ui" 
	xmlns:aon="urn:import:com.esferalia.aon.gwt.common.client.widget"
	xmlns:acc="urn:import:com.esferalia.aon.gwt.fiscal.client.accounting"
	xmlns:accInvoice="urn:import:com.esferalia.aon.gwt.fiscal.client.accounting.wizard"
	xmlns:accPanel='urn:import:com.esferalia.aon.gwt.fiscal.client.accounting.panel'>

	<ui:with type="com.esferalia.aon.gwt.common.client.i18n.CommonMessages" field="msg"></ui:with>
	<ui:with type="com.esferalia.aon.gwt.common.client.css.AonResources" field="aonResources"></ui:with>

	<g:SplitLayoutPanel styleName="{aonResources.css.aonScrollArea}">
		<g:south size="150">
			<accPanel:SessionLog ui:field="workingLog"/>
		</g:south>
		<g:east size="400">
			<accInvoice:InvoiceExtraPanel ui:field="extraPanel"/>
		</g:east>
		<g:center>
			<g:SimpleLayoutPanel styleName="{aonResources.css.aonWizardPanel}">
				<g:DockLayoutPanel styleName="{aonResources.css.aonFlexContainer} {aonResources.css.aonPadding2Top}">
					<g:north size="50">
						<g:FlowPanel>
							<g:FlexTable ui:field="regTable"/>
							<g:FlexTable ui:field="flexTable"/>
						</g:FlowPanel>
					</g:north>
					<g:center>
						<g:ScrollPanel>
							<g:FlowPanel>
								<accInvoice:InvoiceVATPanel ui:field="vatPanel"/>
								<g:HTMLPanel ui:field="withholdingPanel" styleName="{aonResources.css.aonWidthAll}">
									<table>
										<tr>
											<td>
												<g:Label ui:field="withholdingLabel" text="I.R.P.F." styleName="{aonResources.css.aonInnerLabel}"/>
											</td>
											<td>
												<g:ListBox ui:field="withholdingTaxs"/>
											</td>
											<td>
												<aon:DoubleBox ui:field="withholdingBase" visibleLength="12" 
													styleName="{aonResources.css.aonInputText} {aonResources.css.aonMarginRight5} {aonResources.css.aonWidth80}"/>
											</td>
											<td>
												<aon:DoubleBox ui:field="withholdingPercent" visibleLength="6" maxLength="6"
													styleName="{aonResources.css.aonInputText} {aonResources.css.aonMarginRight5} {aonResources.css.aonWidth40}"/>
											</td>
											<td>
												<aon:DoubleBox ui:field="withholdingQuota" visibleLength="12"
													styleName="{aonResources.css.aonInputText} {aonResources.css.aonMarginRight5} {aonResources.css.aonWidth80}"/>
											</td>
											<td>
												<aon:AccountBox ui:field="withholdingAccount"/>
											</td>
											<td>
												<aon:WithholdingTypeListBox ui:field="withholdingType"/>
											</td>
										</tr>
									</table>
								</g:HTMLPanel>
							</g:FlowPanel>
						</g:ScrollPanel>
					</g:center>
					<g:south size="50">
						<g:FlexTable ui:field="payTable"/>
					</g:south>
				</g:DockLayoutPanel>
			</g:SimpleLayoutPanel>
		</g:center>	
	</g:SplitLayoutPanel>
</ui:UiBinder>
