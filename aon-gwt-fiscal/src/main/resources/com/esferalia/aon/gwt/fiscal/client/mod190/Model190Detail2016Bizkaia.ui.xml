<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<ui:UiBinder xmlns:ui='urn:ui:com.google.gwt.uibinder'
	xmlns:g='urn:import:com.google.gwt.user.client.ui' 
	xmlns:aon='urn:import:com.esferalia.aon.gwt.common.client.widget'
	xmlns:m190='urn:import:com.esferalia.aon.gwt.fiscal.client.mod190'
	xmlns:cell="urn:import:com.google.gwt.user.cellview.client">
	
	<ui:with type="com.esferalia.aon.gwt.common.client.i18n.CommonMessages" field="msg"></ui:with>
	<ui:with type="com.esferalia.aon.gwt.common.client.css.AonResources" field="aonResources"></ui:with>
	
	<g:DockLayoutPanel>
		<g:west size="300">
			<g:DockLayoutPanel>
				<g:north size="20">
					<g:FlowPanel height="100%" styleName="{aonResources.css.aonTextRight} {aonResources.css.aonWidthAll}">
						<g:FlowPanel styleName="{aonResources.css.aonMarginLeft} {aonResources.css.aonBorderBottom} {aonResources.css.aonPadding2}">
							<g:Button ui:field="deleteDetailButton" title="{msg.deleteAction}" 
								styleName="{aonResources.css.aonIconCommandButton} {aonResources.css.aonIconDelete}  {aonResources.css.aonMarginRight}"/>
							<g:Button ui:field="restoreDeletedButton" title="{msg.restoreAction}"
								styleName="{aonResources.css.aonIconCommandButton} {aonResources.css.aonIconRedo} {aonResources.css.aonMarginRight}"/>
							<g:Button ui:field="newDetailButton" title="{msg.newPerceptor}"
								styleName="{aonResources.css.aonIconCommandButton} {aonResources.css.aonIconReset}  {aonResources.css.aonMarginRight}"/>
						</g:FlowPanel>
					</g:FlowPanel>
				</g:north>
				<g:center>
					<g:ScrollPanel ui:field="detailListPanel" styleName="{aonResources.css.aonScrollArea} {aonResources.css.aonBorderRight}">
						<cell:CellList ui:field="detailList" styleName="{aonResources.css.aonWidthAll}"/>
					</g:ScrollPanel>
				</g:center>
			</g:DockLayoutPanel>
		</g:west>
		<g:center>
			<g:ScrollPanel styleName="{aonResources.css.aonWidthAll}">
				<g:FlowPanel styleName="{aonResources.css.aonScrollArea}">
				<g:HTMLPanel>
					<table class="{aonResources.css.aonWidthAll} {aonResources.css.aonNowrap}">
						<tr>
							<td class="{aonResources.css.aonBorderBottom} {aonResources.css.aonBold}" colspan="4">
								<g:InlineLabel text="{msg.perceptionData}" />
							</td>
						</tr>
						<tr>
							<td class="{aonResources.css.aonFontMedium} {aonResources.css.aonWidth100}">
								<g:InlineLabel text="{msg.receiverDocument}" />
							</td>
							<td class="{aonResources.css.aonFontMedium} {aonResources.css.aonWidth100}">
								<g:InlineLabel text="{msg.representativeDocument}" />
							</td>
							<td class="{aonResources.css.aonFontMedium} {aonResources.css.aonWidth300}">
								<g:InlineLabel text="{msg.fullName}" />
							</td>
							<td class="{aonResources.css.aonFontMedium} {aonResources.css.aonWidthAuto}">
								<g:InlineLabel text="{msg.province}" />
							</td>
						</tr>
						<tr>
							<td>
								<aon:DocumentTextBox ui:field="receiverDocument"/>
							</td>
							<td>
								<aon:DocumentTextBox ui:field="representativeDocument"/>
							</td>
							<td>
								<g:TextBox ui:field="fullName" maxLength="40" visibleLength="40"
									styleName="{aonResources.css.aonInputText}"/>
							</td>
							<td>
								<aon:ProvinceListBox ui:field="province"/>
							</td>
						</tr>
					</table>
					<table class="{aonResources.css.aonWidthAll} {aonResources.css.aonNowrap}">
						<tr>
							<td class="{aonResources.css.aonFontMedium} {aonResources.css.aonWidth40}" rowspan="4">
								<g:Label text="{msg.key}" />
							</td>
							<td class=" {aonResources.css.aonWidth40}" rowspan="4">
								<m190:Model190Detail2016Bizkaia.KeyListBox ui:field="key"/>
							</td>
							<td class="{aonResources.css.aonFontMedium} {aonResources.css.aonWidth40}" rowspan="4">
								<g:Label text="{msg.subkey}" />
							</td>
							<td class="{aonResources.css.aonWidth40}" rowspan="4">
								<g:ListBox ui:field="subkey"/>
							</td>
							<td class="{aonResources.css.aonFontMedium} {aonResources.css.aonItalic} {aonResources.css.aonWidth90}"
								rowspan="2">
								<g:Label text="{msg.money}" />
							</td>
							<td class="{aonResources.css.aonFontMedium}">
								<g:Label text="{msg.perception}" />
							</td>
							<td class="{aonResources.css.aonFontMedium}">
								<g:Label text="{msg.retention}" />
							</td>
							<td class="{aonResources.css.aonFontMedium}">
								<g:Label text="{msg.accrualYear}" />
							</td>
						</tr>
						<tr>
							<td class="{aonResources.css.aonWidth150}">
								<aon:DoubleBox ui:field="perception"/>
							</td>
							<td class="{aonResources.css.aonWidth150}">
								<aon:DoubleBox ui:field="retention"/>
							</td>
							<td class="{aonResources.css.aonWidthAuto}">
								<aon:IntegerBox maxLength="4" visibleLength="4" ui:field="accrualYear"/>
							</td>
						</tr>
						<tr>
							<td class="{aonResources.css.aonFontMedium} {aonResources.css.aonItalic}" rowspan="2">
								<g:Label text="{msg.inKind}" />
							</td>
							<td class="{aonResources.css.aonFontMedium}">
								<g:Label text="{msg.inKindPerception}" />
							</td>
							<td class="{aonResources.css.aonFontMedium}">
								<g:Label text="{msg.inKindDeposit}" />
							</td>
							<td class="{aonResources.css.aonFontMedium}">
								<g:Label text="{msg.inKindOutputDeposit}" />
							</td>
						</tr>
						<tr>
							<td>
								<aon:DoubleBox ui:field="inKindPerception"/>
							</td>
							<td>
								<aon:DoubleBox ui:field="inKindDeposit"/>
							</td>
							<td>
								<aon:DoubleBox ui:field="inKindOutputDeposit"/>
							</td>
						</tr>
						<tr>
							<td class="{aonResources.css.aonFontMedium} {aonResources.css.aonItalic}" rowspan="2" colspan ="5">
								<g:Label text="Percepciones derivadas de incapacidad laboral" />
							</td>
							<td class="{aonResources.css.aonFontMedium} {aonResources.css.aonWidth150}">
								<g:Label text="{msg.perceptionValoration}" />
							</td>
							<td class="{aonResources.css.aonFontMedium} {aonResources.css.aonWidth150}">
								<g:Label text="{msg.retentionIncome}" />
							</td>
							<td class="{aonResources.css.aonFontMedium} {aonResources.css.aonWidth150}">
								<g:Label text="{msg.inKindOutputDeposit}" />
							</td>
						</tr>
						<tr>
							<td>
								<aon:DoubleBox ui:field="perceptionIL"/>
							</td>
							<td>
								<aon:DoubleBox ui:field="retentionIL"/>
							</td>
							<td>
								<aon:DoubleBox ui:field="outputRetentionIL"/>
							</td>
						</tr>
					</table>
					
					
				</g:HTMLPanel>
				
				<g:HTMLPanel ui:field="additionalDataPanel" styleName="{aonResources.css.aonMarginTop}">
					<table class="{aonResources.css.aonWidthAll} {aonResources.css.aonNowrap}">
						<tr>
							<td class="{aonResources.css.aonBorderBottom} {aonResources.css.aonBold}" colspan="5">
								<g:InlineLabel text="{msg.additionalData}" />
							</td>
						</tr>
						<tr>
							<td class="{aonResources.css.aonFontMedium} {aonResources.css.aonWidth90}">
								<g:Label text="{msg.disability}" />
							</td>
							<td class="{aonResources.css.aonFontMedium} {aonResources.css.aonWidth150}">
								<g:Label text="{msg.applicableReduction}" />
							</td>
							<td class="{aonResources.css.aonFontMedium} {aonResources.css.aonWidth150}">
								<g:Label text="{msg.deducibleExpense}" />
							</td>
							<td class="{aonResources.css.aonFontMedium} {aonResources.css.aonWidth150}">
								<g:Label text="{msg.compensatoryPension}" />
							</td>
							<td class="{aonResources.css.aonFontMedium} {aonResources.css.aonWidthAuto}">
								<g:InlineLabel text="{msg.descendant}"/>
							</td>
						</tr>
						<tr>
							<td class="{aonResources.css.aonWidth50}">
								<g:ListBox width="40px" ui:field="disability"/>
							</td>
							<td>
								<aon:DoubleBox ui:field="applicableReduction"/>
							</td>
							<td>
								<aon:DoubleBox ui:field="deducibleExpense"/>
							</td>
							<td>
								<aon:DoubleBox ui:field="compensatoryPension"/>
							</td>
							<td>
								<aon:IntegerBox maxLength="2" visibleLength="2" ui:field="otherDescendent" />
							</td>
						</tr>
					</table>
					
				</g:HTMLPanel>
				</g:FlowPanel>
			</g:ScrollPanel>
		</g:center>
		
	</g:DockLayoutPanel>
</ui:UiBinder>
