<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<ui:UiBinder xmlns:ui='urn:ui:com.google.gwt.uibinder'
	xmlns:g='urn:import:com.google.gwt.user.client.ui' 
	xmlns:aon='urn:import:com.esferalia.aon.gwt.common.client.widget'
	xmlns:fiscal='urn:import:com.esferalia.aon.gwt.fiscal.client.widget'>

	<ui:with type="com.esferalia.aon.gwt.common.client.i18n.CommonMessages" field="msg"></ui:with>
	<ui:with type="com.esferalia.aon.gwt.common.client.css.AonResources" field="aonResources"></ui:with>

	<g:HTMLPanel>
		<g:Label text="{msg.annualLiquidationResult}" styleName="{aonResources.css.aonPageHeader}" />

		<g:Label text="{msg.page7HelpText}" styleName="{aonResources.css.aonInfoMessageBlock}"/>
		
		<table class="{aonResources.css.aonFiscalTable}">
			<colgroup>
				<col style="width: auto;" />
				<col style="width: 40px;" />
				<col style="width: 120px;" class="{aonResources.css.aonTextCenter}" />
			</colgroup>
			<tr>
				<td>
					<g:Label text="{msg.resultSum}" />
				</td>
				<td class="{aonResources.css.aonTextCenter}">
					<g:Label text="84"  styleName="{aonResources.css.aonSimpleBorder} {aonResources.css.aonFontSmall} {aonResources.css.aonPadding2}" />
				</td>
				<td>
					<aon:DoubleTextBox ui:field="box84" styleName="aon-inputText aon-text-right"/>
				</td>
			</tr>
			<tr>
				<td>
					<g:Label text="{msg.previousYearCompensation}" />
				</td>
				<td class="{aonResources.css.aonTextCenter}">
					<g:Label text="85"  styleName="{aonResources.css.aonSimpleBorder} {aonResources.css.aonFontSmall} {aonResources.css.aonPadding2}" />
				</td>
				<td>
					<aon:DoubleTextBox ui:field="box85" styleName="aon-inputText aon-text-right"/>
				</td>
			</tr>
			<tr>
				<td>
					<g:Label text="{msg.liquidationResult}" />
				</td>
				<td class="{aonResources.css.aonTextCenter}">
					<g:Label text="86"  styleName="{aonResources.css.aonSimpleBorder} {aonResources.css.aonFontSmall} {aonResources.css.aonPadding2}" />
				</td>
				<td>
					<aon:DoubleTextBox ui:field="box86" styleName="aon-inputText aon-text-right"/>
				</td>
			</tr>
		</table>
	</g:HTMLPanel>

</ui:UiBinder>
