<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
	xmlns:g="urn:import:com.google.gwt.user.client.ui" 
	xmlns:aon="urn:import:com.esferalia.aon.gwt.common.client.widget"
	xmlns:fiscal="urn:import:com.esferalia.aon.gwt.fiscal.client.widget">

	<ui:with type="com.esferalia.aon.gwt.common.client.i18n.CommonMessages" field="msg"></ui:with>
	<ui:with type="com.esferalia.aon.gwt.common.client.css.AonResources" field="aonResources"></ui:with>

	<g:SplitLayoutPanel styleName="{aonResources.css.aonScrollArea}">
		<g:center>
			<g:ScrollPanel styleName="{aonResources.css.aonWizardPanel}">
				<g:FlowPanel styleName="{aonResources.css.aonFlexContainer}">
					<g:FlowPanel styleName="{aonResources.css.aonWizardPanelInner}">
						<g:Label text="{msg.titular}" styleName="{aonResources.css.aonInnerLabel}"/>
						<aon:AccountingRegistryBox ui:field="registryBox"/>
					</g:FlowPanel>
					
					<g:FlowPanel ui:field="invoiceDataPanel" styleName="{aonResources.css.aonWizardPanelInner}">	
						<g:Label text="{msg.invoiceNumber}" styleName="{aonResources.css.aonInnerLabel} {aonResources.css.aonWidth110}"/>
						<g:ListBox ui:field="series" styleName="{aonResources.css.aonMarginRight5}"/>
						<g:TextBox ui:field="number" styleName="{aonResources.css.aonInputText} {aonResources.css.aonMarginRight5}" 
							visibleLength="8" maxLength="8"/>
						<g:TextBox ui:field="referenceCode" styleName="{aonResources.css.aonInputText} {aonResources.css.aonMarginRight5}" 
							visibleLength="15" maxLength="32"/>
							
						<g:Label text="{msg.total}" styleName="{aonResources.css.aonInnerLabel}"/>	
						<aon:DoubleBox ui:field="invoiceTotal" visibleLength="12" 
							styleName="{aonResources.css.aonInputText} {aonResources.css.aonMarginRight5}"/>
					</g:FlowPanel>
					
					<g:FlowPanel ui:field="expAccountPanel" styleName="{aonResources.css.aonWizardPanelInner}">
						<g:Label text="{msg.account}" styleName="{aonResources.css.aonInnerLabel} {aonResources.css.aonWidth110}"/>
						<aon:AccountBox ui:field="expAccount"/>
					</g:FlowPanel>
					
					<g:FlowPanel ui:field="withholdingPanel" styleName="{aonResources.css.aonWizardPanelInner}">
						<g:Label text="I.R.P.F." styleName="{aonResources.css.aonInnerLabel} {aonResources.css.aonWidth110}"/>
						<g:ListBox ui:field="withholdingTaxs" styleName="{aonResources.css.aonMarginRight5}"/>
						<aon:DoubleBox ui:field="withholdingPercent" visibleLength="6" maxLength="6" 
							styleName="{aonResources.css.aonInputText} {aonResources.css.aonMarginRight5}"/>
						<aon:DoubleBox ui:field="withholdingQuota" 
							styleName="{aonResources.css.aonInputText} {aonResources.css.aonMarginRight5}"/>
						<aon:WithholdingTypeListBox ui:field="withholdingType" tabIndex="500000"  
							styleName="{aonResources.css.aonMarginRight5}"/>
						<aon:AccountBox ui:field="withholdingAccount" tabIndex="500000"  
							styleName="{aonResources.css.aonMarginRight5}"/>
					</g:FlowPanel>
					
					<g:FlowPanel ui:field="vatPanel" styleName="{aonResources.css.aonWizardPanelInner}">
						<g:Label text="I.V.A." styleName="{aonResources.css.aonInnerLabel} {aonResources.css.aonWidth110}"/>
						<aon:DoubleBox ui:field="taxableBase" visibleLength="12"  
							styleName="{aonResources.css.aonInputText} {aonResources.css.aonMarginRight5}"/>
						<g:ListBox ui:field="vatTaxs" styleName="{aonResources.css.aonMarginRight5}"/>
						<aon:DoubleBox ui:field="vatPercent" visibleLength="6" maxLength="6" 
							styleName="{aonResources.css.aonInputText} {aonResources.css.aonMarginRight5}"/>
						<aon:DoubleBox ui:field="vatQuota" visibleLength="12" 
							styleName="{aonResources.css.aonInputText} {aonResources.css.aonMarginRight5}"/>
						<aon:DoubleBox ui:field="surchargePercent" visibleLength="6" maxLength="6" 
							styleName="{aonResources.css.aonInputText} {aonResources.css.aonMarginRight5}"/>
						<aon:DoubleBox ui:field="surchargeQuota" visibleLength="12"
							styleName="{aonResources.css.aonInputText} {aonResources.css.aonMarginRight5}"/>
						<aon:VatDeductionTypeListBox ui:field="vatDeductionType" tabIndex="500000" 
							styleName="{aonResources.css.aonMarginRight5}"/>
						<aon:AccountBox ui:field="vatAccount" tabIndex="500000" />
					</g:FlowPanel> 
				</g:FlowPanel> 
			</g:ScrollPanel>
		</g:center>	
		<g:east size="450">
			<g:ScrollPanel ui:field="eastPanel" styleName="{aonResources.css.aonWizardPanelEast}">
				<g:FlowPanel styleName="{aonResources.css.aonFlexContainer}">
					<g:FlowPanel ui:field="eastPanelInner" styleName="{aonResources.css.aonWizardPanelInner}">
						<g:InlineLabel ui:field="invoiceTypeLabel" 
							styleName="{aonResources.css.aonWidthAll} {aonResources.css.aonMarginAuto} {aonResources.css.aonWizardLabel} {aonResources.css.aonTextCenter}"/>
					</g:FlowPanel>
					<g:FlowPanel styleName="{aonResources.css.aonWizardPanelInner}">
						<g:InlineLabel text="{msg.document}" styleName="{aonResources.css.aonInnerLabel} {aonResources.css.aonWidth70}"/>
						<aon:DocumentTypeListBox ui:field="rDocumenType" tabIndex="500000" 
							styleName="{aonResources.css.aonMarginRight5}"/>
						<aon:Country2ListBox ui:field="rDocumenCountry" tabIndex="500001"
							styleName="{aonResources.css.aonMarginRight5}"/>
						<aon:DocumentTextBox ui:field="rDocument" tabIndex="500002"
							styleName="{aonResources.css.aonInputText} {aonResources.css.aonMarginRight5}"/>
					</g:FlowPanel>
					<g:FlowPanel styleName="{aonResources.css.aonWizardPanelInner}">
						<g:InlineLabel text="{msg.name}" styleName="{aonResources.css.aonInnerLabel} {aonResources.css.aonWidth70}"/>
						<g:TextBox ui:field="rName" styleName="{aonResources.css.aonInputText}"
							tabIndex="500003" visibleLength="40" maxLength="40"/>
					</g:FlowPanel>		 
					<g:FlowPanel styleName="{aonResources.css.aonWizardPanelInner}">							
						<g:InlineLabel text="{msg.taxDate}" styleName="{aonResources.css.aonInnerLabel} {aonResources.css.aonWidth70}"/>
						<aon:DateBoxEx ui:field="taxDate" tabIndex="500004" />
					</g:FlowPanel>		 
					<g:FlowPanel styleName="{aonResources.css.aonWizardPanelInner}">
						<g:InlineLabel text="{msg.transaction}" styleName="{aonResources.css.aonInnerLabel} {aonResources.css.aonWidth70}"/>
						<aon:InvoiceTransactionListBox ui:field="transactionBox" tabIndex="500008"/>
					</g:FlowPanel>		 
					<g:FlowPanel styleName="{aonResources.css.aonWizardPanelInner}">
						<g:CheckBox ui:field="service" tabIndex="500004" text="{msg.service}" styleName="{aonResources.css.aonInline} {aonResources.css.aonWidth150}"/>
						<g:CheckBox ui:field="investment" tabIndex="500004" text="{msg.investAsset}" styleName="{aonResources.css.aonInline} {aonResources.css.aonWidth150}"/>
					</g:FlowPanel>		 
					<g:FlowPanel styleName="{aonResources.css.aonWizardPanelInner}">
						<g:CheckBox ui:field="surcharge" tabIndex="500004" text="{msg.surcharge}" styleName="{aonResources.css.aonInline} {aonResources.css.aonWidth150}"/>
						<g:CheckBox ui:field="vatAccrualPayment" tabIndex="500007" text="{msg.vatAccrualPayment}" styleName="{aonResources.css.aonInline} {aonResources.css.aonWidthAuto}"/>
					</g:FlowPanel>		 
					<g:FlowPanel styleName="{aonResources.css.aonWizardPanelInner}">
						<g:CheckBox ui:field="withholding" tabIndex="500005" text="{msg.witholding}" styleName="{aonResources.css.aonInline} {aonResources.css.aonWidth150}"/>
						<g:CheckBox ui:field="withholdingFarmer" tabIndex="500006" text="{msg.withholdingFarmer}" styleName="{aonResources.css.aonInline} {aonResources.css.aonWidthAuto}"/>
					</g:FlowPanel>		 
				</g:FlowPanel>
			</g:ScrollPanel>
		</g:east>
	</g:SplitLayoutPanel>
</ui:UiBinder>
