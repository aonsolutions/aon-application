<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<ui:UiBinder xmlns:ui='urn:ui:com.google.gwt.uibinder'
	xmlns:g='urn:import:com.google.gwt.user.client.ui' xmlns:aon='urn:import:com.esferalia.aon.gwt.common.client.widget'
	xmlns:fiscal='urn:import:com.esferalia.aon.gwt.fiscal.client.widget'
	xmlns:cell='urn:import:com.google.gwt.user.cellview.client'>

	<ui:with type="com.esferalia.aon.gwt.common.client.i18n.CommonMessages"
		field="msg"></ui:with>
	<ui:with type="com.esferalia.aon.gwt.common.client.css.AonResources"
		field="aonResources"></ui:with>

	<g:DockLayoutPanel unit="PX">
		<g:north size="26">
			<g:FlowPanel styleName="aon-finding-title-toolbar">
				<g:HorizontalPanel>
					<g:HTMLPanel styleName="aon-finding-title">
						<g:HTMLPanel styleName="aon-finding-title-internal">
							<g:Label styleName="aon-outputText" text="{msg.mod131}" />
						</g:HTMLPanel>
					</g:HTMLPanel>
					<g:HTMLPanel styleName="aon-finding-subtitle">
						<g:HTMLPanel styleName="aon-finding-subtitle-internal">
							<g:Label styleName="aon-outputText"></g:Label>
						</g:HTMLPanel>
					</g:HTMLPanel>
					<g:HorizontalPanel styleName="aon-finding-toolbar">
						<g:HTMLPanel styleName="aon-finding-toolbar-item-group">
							<g:Button ui:field='saveButton'
								styleName='aon-finding-toolbar-item aon-icon-accept' text="{msg.saveAction}" />
							<g:Button ui:field='calculateButton'
								styleName='aon-finding-toolbar-item aon-icon-refresh' text="{msg.calculateAction}" />
						</g:HTMLPanel>
					</g:HorizontalPanel>
				</g:HorizontalPanel>
			</g:FlowPanel>
		</g:north>
		<g:center>
			<g:ScrollPanel styleName="{aonResources.css.aonScrollArea}">
				<g:HTMLPanel>
					<table class="{aonResources.css.aonFiscalModelTable}">
						<tr>
							<td class="{aonResources.css.aonFiscalModelTableHeaderImage}">
								<g:Label text="&#160;" styleName="{aonResources.css.aonAeatHeaderImage}"/>
							</td>
							<td class="{aonResources.css.aonFiscalModelTableHeaderTitle}">
								<g:Label text="{msg.mod131Long}"/>
							</td>
							<td class="{aonResources.css.aonFiscalModelTableHeaderModel}">
								<g:Label text="{msg.mod131}"/>
							</td>
						</tr>
					</table>
					<table>
						<tr>
							<td>
								<g:TextBox ui:field="document" styleName="{aonResources.css.aonInputText}"/>
							</td>
							<td>
								<g:TextBox ui:field="name" styleName="{aonResources.css.aonInputText}"/>
								<g:TextBox ui:field="surname" styleName="{aonResources.css.aonInputText}"/>
							</td>
							<td>
								<g:TextBox ui:field="period" styleName="{aonResources.css.aonInputText}"/>
								<g:TextBox ui:field="year" styleName="{aonResources.css.aonInputText}"/>
							</td>
						</tr>
					</table>
					<table class="{aonResources.css.aonWidthAll}">
						<tr>
							<td colspan="4">
								<g:Label text="{msg.mod131Activities}"/>
							</td>
						</tr>
						<tr>
							<td class="{aonResources.css.aonWidthAuto}"><g:Label text="{msg.mod131Epigraph}"/></td>
							<td class="{aonResources.css.aonWidth150}"><g:Label text="{msg.mod131NetYield}"/></td>
							<td class="{aonResources.css.aonWidth70}"><g:Label text="{msg.mod131Percent}"/></td>
							<td class="{aonResources.css.aonWidth150}"><g:Label text="{msg.mod131Result}"/></td>
						</tr>
						<tr>
							<td><g:TextBox ui:field="ep1" styleName="{aonResources.css.aonInputText}"/></td>
							<td><g:TextBox ui:field="ny1" styleName="{aonResources.css.aonInputText}"/></td>
							<td><g:TextBox ui:field="pr1" styleName="{aonResources.css.aonInputText}"/></td>
							<td><g:TextBox ui:field="rs1" styleName="{aonResources.css.aonInputText}"/></td>
						</tr>
						<tr>
							<td><g:TextBox ui:field="ep2" styleName="{aonResources.css.aonInputText}"/></td>
							<td><g:TextBox ui:field="ny2" styleName="{aonResources.css.aonInputText}"/></td>
							<td><g:TextBox ui:field="pr2" styleName="{aonResources.css.aonInputText}"/></td>
							<td><g:TextBox ui:field="rs2" styleName="{aonResources.css.aonInputText}"/></td>
						</tr>
						<tr>
							<td><g:TextBox ui:field="ep3" styleName="{aonResources.css.aonInputText}"/></td>
							<td><g:TextBox ui:field="ny3" styleName="{aonResources.css.aonInputText}"/></td>
							<td><g:TextBox ui:field="pr3" styleName="{aonResources.css.aonInputText}"/></td>
							<td><g:TextBox ui:field="rs3" styleName="{aonResources.css.aonInputText}"/></td>
						</tr>
						<tr>
							<td><g:TextBox ui:field="ep4" styleName="{aonResources.css.aonInputText}"/></td>
							<td><g:TextBox ui:field="ny4" styleName="{aonResources.css.aonInputText}"/></td>
							<td><g:TextBox ui:field="pr4" styleName="{aonResources.css.aonInputText}"/></td>
							<td><g:TextBox ui:field="rs4" styleName="{aonResources.css.aonInputText}"/></td>
						</tr>
						<tr>
							<td><g:TextBox ui:field="ep5" styleName="{aonResources.css.aonInputText}"/></td>
							<td><g:TextBox ui:field="ny5" styleName="{aonResources.css.aonInputText}"/></td>
							<td><g:TextBox ui:field="pr5" styleName="{aonResources.css.aonInputText}"/></td>
							<td><g:TextBox ui:field="rs5" styleName="{aonResources.css.aonInputText}"/></td>
						</tr>
					</table>
					
				</g:HTMLPanel>
			</g:ScrollPanel>
		</g:center>
	</g:DockLayoutPanel>
</ui:UiBinder>
