<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<ui:UiBinder xmlns:ui='urn:ui:com.google.gwt.uibinder'
	xmlns:g='urn:import:com.google.gwt.user.client.ui' 
	xmlns:aon='urn:import:com.esferalia.aon.gwt.common.client.widget'
	xmlns:fiscal='urn:import:com.esferalia.aon.gwt.fiscal.client.widget'
	xmlns:cell='urn:import:com.google.gwt.user.cellview.client'>
	
	<ui:with type="com.esferalia.aon.gwt.common.client.i18n.CommonMessages" field="msg"></ui:with>

	<ui:style>
		.inner-label {
			font-style: italic;
			margin-left: 5px;
			margin-right: 5px;
			display: inline;
		}
	</ui:style>

	<g:FlowPanel>
		<g:Label text="{msg.document}" styleName="{style.inner-label}"/>
		<g:SuggestBox ui:field="document"  limit="10" width="100px" />
		<g:Label text="{msg.companyName}" styleName="{style.inner-label}"/>
		<g:TextBox visibleLength="42" maxLength="40" ui:field="name" />
	</g:FlowPanel>
	
</ui:UiBinder>
