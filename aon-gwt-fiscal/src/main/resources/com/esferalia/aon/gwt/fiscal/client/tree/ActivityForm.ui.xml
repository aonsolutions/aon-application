<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<ui:UiBinder xmlns:ui='urn:ui:com.google.gwt.uibinder'
	xmlns:g='urn:import:com.google.gwt.user.client.ui' xmlns:aon='urn:import:com.esferalia.aon.gwt.common.client.widget'
	xmlns:fiscal='urn:import:com.esferalia.aon.gwt.fiscal.client.widget'
	xmlns:cell='urn:import:com.google.gwt.user.cellview.client'>

	<ui:with type="com.esferalia.aon.gwt.common.client.i18n.CommonMessages"
		field="msg"></ui:with>
	<ui:with type="com.esferalia.aon.gwt.common.client.css.AonResources"
		field="aonResources"></ui:with>

	<g:HTMLPanel styleName="aon-scroll-area">
		<g:FlowPanel height="20px"
			styleName="aon-finding-title-toolbar aon-width-all gwt-MenuBar-horizontal aon-margin-top">
			<g:Button ui:field='saveButton'
				styleName='aon-finding-toolbar-item aon-icon-delete' text="{msg.saveAction}" />
			<g:Button ui:field='calculateButton'
				styleName='aon-finding-toolbar-item aon-icon-refresh' text="{msg.calculateAction}" />
		</g:FlowPanel>
		
		<div class="{aonResources.css.aonGroup}">
			<div class="{aonResources.css.aonGroupTitle}">
				<g:InlineLabel text="{msg.moduleActivities}" />
			</div>
			<div class="{aonResources.css.aonGroupBody}">
				<div>
					<g:InlineLabel text="{msg.year}" styleName="{aonResources.css.aonItalic}"/>
					<g:InlineLabel ui:field="year" styleName="{aonResources.css.aonIconButton} {aonResources.css.aonBold}"/>
					
					<span styleName="{aonResources.css.aonMarginLeft} {aonResources.css.aonVerticalAlignMiddle}">
						<g:InlineLabel text="{msg.epigraph}" styleName="{aonResources.css.aonItalic}"/>
						<g:InlineLabel ui:field="epigraph" styleName="{aonResources.css.aonBold} {aonResources.css.aonMarginLeft}"/>
						<g:Button ui:field="epigraphButton" styleName="{aonResources.css.aonIconButton} {aonResources.css.aonIconLoupe}"
							title="{msg.pushToChange}"/>
					</span>
					
					<g:InlineLabel text="{msg.maxPerson}" styleName="{aonResources.css.aonMarginLeft} {aonResources.css.aonItalic}"/>
					<g:InlineLabel ui:field="maxPerson" styleName="{aonResources.css.aonMarginLeft}"/>
					<g:InlineLabel text="{msg.maxImport}" styleName="{aonResources.css.aonMarginLeft} {aonResources.css.aonItalic}"/>
					<g:InlineLabel ui:field="maxImport" styleName="{aonResources.css.aonMarginLeft}"/>
					<g:InlineLabel text="{msg.vatPercent}" styleName="{aonResources.css.aonMarginLeft} {aonResources.css.aonItalic}"/>
					<g:InlineLabel ui:field="vatPercent" styleName="{aonResources.css.aonMarginLeft}"/>
					<div>
						<g:InlineLabel ui:field="description"/>
					</div>
				</div>
			</div>
		</div>
		<g:TabPanel ui:field="tab" styleName="gwt-Selector">
			<g:Tab text="{msg.epigraphAdditionalInfo}">
				<g:SimplePanel ui:field="infoContainer"/>
			</g:Tab>
			<g:Tab text="{msg.irpfModules}">
				<g:HTMLPanel>
					<g:SimplePanel ui:field="moduleIRPFContainer"/>
					<g:SimplePanel ui:field="infoIRPFContainer"/>
				</g:HTMLPanel>
			</g:Tab>
			<g:Tab text="{msg.vatModules}">
				<g:HTMLPanel>
					<g:SimplePanel ui:field="moduleIVAContainer"/>
					<g:SimplePanel ui:field="infoIVAContainer"/>
				</g:HTMLPanel>
			</g:Tab>
		</g:TabPanel>
	</g:HTMLPanel>

</ui:UiBinder>
