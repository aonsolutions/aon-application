<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<ui:UiBinder xmlns:ui='urn:ui:com.google.gwt.uibinder'
	xmlns:g='urn:import:com.google.gwt.user.client.ui' 
	xmlns:aon='urn:import:com.esferalia.aon.gwt.fiscal.client.widget'
	xmlns:m390='urn:import:com.esferalia.aon.gwt.fiscal.client.mod390'
	xmlns:cell='urn:import:com.google.gwt.user.cellview.client'>

	<ui:with type="com.esferalia.aon.gwt.common.client.i18n.CommonMessages" field="msg"></ui:with>
	<ui:with type="com.esferalia.aon.gwt.common.client.css.AonResources" field="aonResources"></ui:with>

	<ui:style>
		.linkPanel {
			padding: 0px 0px 1.5em 0;
			margin-left: 1.5em;
			border: solid #CCC 1px;
			background-color: #EEE;
		}
		.linkSubPanel {
			padding: 0px 0px 0px 3em;
		}
		.linkContainer {
			width: 100%;
			height: 100%;
		}
		.linkItemHeader{
			padding-top: 5px;
			cursor: pointer;
			border: none;
		}
		.linkItem{
			padding-top: 5px;
			cursor: pointer;
			border: none;
		}
		.linkItem:hover{
			background-color: #DDD;
		}
		.linkItemSelected {
			background-color: #CCC;
			font-weight: bold;
		}
		.linkHeader{
			/*width: 100%;*/
			margin-left: 15px;
			/*white-space: nowrap;*/
			border: solid #BBB 2px;
			/*background-color: #CCC;*/
		}
		.linkNumber{
			border-top: solid #CCC .5px;
			border-left: solid #BBB 2px;
			border-bottom: solid #BBB 2px;
			width: 20px;
			margin-left: 10px;
			text-align: center;
		}
		.linkDescription{
			padding-left: 15px;
			/*white-space: nowrap;*/
		}
		
		.excelButton{
			position: relative;
			top: 3px;
		}
		
	</ui:style>

	<g:DockLayoutPanel ui:field="dockLayoutPanel">
		<g:north size="23">
			<g:FlowPanel ui:field="toolbarPanel" styleName="aon-finding-title-toolbar aon-width-all">
				<g:HorizontalPanel >
					<g:HTMLPanel styleName="aon-finding-title">
						<g:HTMLPanel styleName="aon-finding-title-internal">
							<g:Label  ui:field="depositType" styleName="aon-outputText" text="(-)" />
						</g:HTMLPanel>
					</g:HTMLPanel>
					<g:HTMLPanel styleName="aon-finding-subtitle">
						<g:HTMLPanel styleName="aon-finding-subtitle-internal">
							<g:Label styleName="aon-outputText"></g:Label>
						</g:HTMLPanel>
					</g:HTMLPanel>
					<g:HorizontalPanel styleName="aon-finding-toolbar">
						<g:HTMLPanel styleName="aon-finding-toolbar-item-group">
							<g:Button ui:field='newButton'
								styleName='aon-finding-toolbar-item aon-icon-reset' text="{msg.newAction}" visible="false"/>
							<g:Button ui:field='saveButton'
								styleName='aon-finding-toolbar-item aon-icon-accept' text="{msg.saveAction}" visible="true"/>
							<g:Button ui:field='cancelButton'
								styleName='aon-finding-toolbar-item aon-icon-cancel' text="{msg.cancelAction}" visible="false"/>
							<g:Button ui:field='deleteButton'
								styleName='aon-finding-toolbar-item aon-icon-delete' text="{msg.deleteAction}" visible="false"/>
							<g:Button ui:field='importButton'
								styleName='aon-finding-toolbar-item aon-icon-file-upload' text="Importar" visible="true"/>
							
							<g:Button ui:field='generateFileButton'
								styleName='aon-finding-toolbar-item aon-icon-aeat' text="Exportar" visible="true"/>
						
							<g:Button ui:field='importTextButton'
								styleName='aon-finding-toolbar-item aon-icon-copy' text="Importar Memoria" visible="true"/>
							
							<!--g:Button ui:field='importSocietyButton'
								styleName='aon-finding-toolbar-item aon-icon-copy' text="Importar de Sociedades" visible="false"/-->
							
							<g:Button ui:field='importAllButton'
								styleName='aon-finding-toolbar-item aon-icon-file-upload' text="Importar" visible="true"/>
							
							<g:Button ui:field='downloadButton'
								styleName='{style.excelButton} aon-finding-toolbar-item aon-finding-toolbar-item-no-border aon-icon-excel' text="DESCARGAR" visible="true"/>
							<g:Button ui:field='downloadButtonPdf'
								styleName='aon-finding-toolbar-item aon-icon-pdf' text="DESCARGAR" visible="true"/>
									
								
							<g:Anchor ui:field="download" visible="false"/>							
						</g:HTMLPanel>
					</g:HorizontalPanel>
				</g:HorizontalPanel>
			</g:FlowPanel>
		</g:north>
		
		<g:center>
			<g:DockLayoutPanel unit="PX">
				<g:north size="55">
					<g:SimplePanel ui:field="headerPanel"/>
				</g:north>
				<g:center>

				
					<g:ScrollPanel styleName="aon-scroll-area">
						<g:FlowPanel ui:field="pagesPanel" />
					</g:ScrollPanel>
				</g:center>
			</g:DockLayoutPanel>
		</g:center>
		
	
	</g:DockLayoutPanel>
	
</ui:UiBinder>
