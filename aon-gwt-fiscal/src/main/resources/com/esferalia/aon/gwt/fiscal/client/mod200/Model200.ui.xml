<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<ui:UiBinder xmlns:ui='urn:ui:com.google.gwt.uibinder'
	xmlns:g='urn:import:com.google.gwt.user.client.ui' 
	xmlns:aon='urn:import:com.esferalia.aon.gwt.common.client.widget'
	xmlns:fiscal='urn:import:com.esferalia.aon.gwt.fiscal.client.widget'
	xmlns:soci='urn:import:com.esferalia.aon.gwt.fiscal.client.mod200'
	xmlns:cell='urn:import:com.google.gwt.user.cellview.client'>

	<ui:with type="com.esferalia.aon.gwt.common.client.i18n.CommonMessages" field="msg"></ui:with>
	<ui:with type="com.esferalia.aon.gwt.common.client.css.AonResources" field="aonResources"></ui:with>

	<g:DockLayoutPanel ui:field="dockLayoutPanel">
		<g:north size="26">
			<g:FlowPanel ui:field="toolbarPanel" height="100%"
				styleName="aon-finding-title-toolbar aon-width-all">
				<g:HorizontalPanel>
					<g:HTMLPanel styleName="aon-finding-title">
						<g:HTMLPanel styleName="aon-finding-title-internal">
							<g:Label styleName="aon-outputText" text="{msg.mod200}" />
						</g:HTMLPanel>
					</g:HTMLPanel>
					<g:HTMLPanel styleName="aon-finding-subtitle">
						<g:HTMLPanel styleName="aon-finding-subtitle-internal">
							<g:Label styleName="aon-outputText" text="{msg.mod200Desc}"/>
						</g:HTMLPanel>
					</g:HTMLPanel>
					<g:HorizontalPanel styleName="aon-finding-toolbar">
						<g:HTMLPanel styleName="aon-finding-toolbar-item-group">
							<g:Button ui:field='initializeButton'
								styleName='aon-finding-toolbar-item aon-icon-accept' text="{msg.saveAction}" />
							<g:Button ui:field='saveButton'
								styleName='aon-finding-toolbar-item aon-icon-accept' text="{msg.saveAction}" />
							<g:Button ui:field='removeButton'
								styleName='aon-finding-toolbar-item aon-icon-delete' text="{msg.deleteAction}" />
							<g:Button ui:field='validateButton'
								styleName='aon-finding-toolbar-item aon-icon-project-ok' text="{msg.validateAction}" />
							<g:Button ui:field='calculateButton'
								styleName='aon-finding-toolbar-item aon-icon-calc' text="{msg.calculateAction}" />
							<g:CheckBox ui:field='calculateCheck' text="{msg.authomaticCalculation}"/>
							<g:Button ui:field='aeatFileButton'
								styleName='aon-finding-toolbar-item aon-icon-aeat' text="{msg.generateFile}" />
							<g:Button ui:field='aeatAccountingFileButton'
								styleName='aon-finding-toolbar-item aon-icon-aeat-bw' text="{msg.aeatAccountingFile}" />
							<g:FlowPanel ui:field="formContainer"/>
						</g:HTMLPanel>
					</g:HorizontalPanel>
				</g:HorizontalPanel>
			</g:FlowPanel>
		</g:north>
		<g:center>
			<g:DockLayoutPanel ui:field="formPanel" unit="PX">
				<g:north size="64">
					<g:HTMLPanel styleName="aon-scroll-area">
						<g:HorizontalPanel ui:field='messagesPanel'/>
						<table class="aon-width-all" style="text-align: center;font-weight:bold;">
							<tr>
								<td rowspan="2" class="{aonResources.css.aonMod200Title}">
									<span style=" font-size: 1.2em; font-weight: bold;">
										<g:Label text="{msg.mod200Desc}"/>
									</span>
									<span style="font-weight: bold;">
										<g:Label text="{msg.mod200Desc2}"/>
									</span>
									<span style="font-size: 0.8em;">
										<g:Label text="{msg.mod200Desc3}"/>
									</span>
								</td>
								<td class="{aonResources.css.aonMod200Year}">
									<g:Label text="2013" />
								</td>
							</tr>
							<tr>
								<td class="{aonResources.css.aonMod200Model}">
									<g:Label text="{msg.mod200}" />
								</td>
							</tr>
						</table>
					</g:HTMLPanel>
				</g:north>
				<g:west size="200">
					<soci:Model200Sidebar ui:field="sidebar"/>
				</g:west>
				<g:center>
					<soci:Model200Deck ui:field="deckPanel"/>
				</g:center>
			</g:DockLayoutPanel>
		</g:center>
	</g:DockLayoutPanel>
</ui:UiBinder>
