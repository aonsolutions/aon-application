<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<ui:UiBinder xmlns:ui='urn:ui:com.google.gwt.uibinder'
	xmlns:g='urn:import:com.google.gwt.user.client.ui' 
	xmlns:aon='urn:import:com.esferalia.aon.gwt.common.client.widget'
	xmlns:fiscal='urn:import:com.esferalia.aon.gwt.fiscal.client.widget'
	xmlns:cell='urn:import:com.google.gwt.user.cellview.client'>
	
	<ui:with type="com.esferalia.aon.gwt.common.client.i18n.CommonMessages" field="msg"></ui:with>

	<ui:style>
		.inner-label {
			font-style: italic;
			margin-left: 5px;
			margin-right: 5px;
			display: inline;
		}
	</ui:style>
	<g:DockLayoutPanel unit="PX" width="550px" height="500px">
		<g:north size="30">
			<g:HTMLPanel>
				<div style="margin-top: 5px;">
					<g:Label text="{msg.activity}" styleName="{style.inner-label}"/>
					<g:ListBox ui:field="activityGroup" width="400px" />
				</div>
			</g:HTMLPanel>
		</g:north>
		<g:center>
			<g:DeckLayoutPanel ui:field="deckPanel">
				<g:ScrollPanel ui:field="tablePanel">
					<cell:CellTable ui:field="table" width="100%"/>
				</g:ScrollPanel>
				<g:HTMLPanel ui:field="descriptionPanel">
					<g:Label text="{msg.activityDescription}" styleName="{style.inner-label}"/>
					<g:TextBox ui:field="description" maxLength="40" visibleLength="40" />
					<div style="margin-top: 10px; text-align: center;">
						<g:Button ui:field="acceptDescription" text="{msg.accept}"></g:Button>
					</div>
				</g:HTMLPanel>
			</g:DeckLayoutPanel>
		</g:center>
	</g:DockLayoutPanel>
	
</ui:UiBinder>
