<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
	xmlns:g="urn:import:com.google.gwt.user.client.ui" 
	xmlns:aon="urn:import:com.esferalia.aon.gwt.common.client.widget">

	<ui:with type="com.esferalia.aon.gwt.common.client.i18n.CommonMessages" field="msg"></ui:with>
	<ui:with type="com.esferalia.aon.gwt.common.client.css.AonResources" field="aonResources"></ui:with>

	<g:SplitLayoutPanel ui:field="splitLayoutPanel">
		<g:center>
			<g:SimpleLayoutPanel ui:field="declarationContainer"/>
		</g:center>
		<g:south size="30">
			<aon:MinimizePanel ui:field="footPanel" styleName="{aonResources.css.aonSelector}">
				<g:TabLayoutPanel ui:field="tabLayout" barHeight="26" barUnit="PX" width="100%">
					<g:tab>
						<g:customHeader>
							<g:Label
								styleName="{aonResources.css.aonIconJournalLog} {aonResources.css.aonPaddingRight}"  
								text="{msg.notifications}" />
						</g:customHeader>
						<aon:ResultsPanel ui:field="notificationsPanel" />
					</g:tab>
					<g:tab>
						<g:customHeader>
							<g:Label
								styleName="{aonResources.css.aonIconInfo} {aonResources.css.aonPaddingRight} {aonResources.css.aonPaddingLeft20}"  
								text="{msg.informationBreakdown}" />
						</g:customHeader>
						<g:ScrollPanel ui:field="breakdownPanel" styleName="{aonResources.css.aonTextCenter}"/>
					</g:tab>
				</g:TabLayoutPanel>
			</aon:MinimizePanel>
		</g:south>
	</g:SplitLayoutPanel>
</ui:UiBinder>
