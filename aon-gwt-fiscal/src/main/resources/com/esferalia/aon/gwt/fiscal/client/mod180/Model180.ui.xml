<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<ui:UiBinder xmlns:ui='urn:ui:com.google.gwt.uibinder'
	xmlns:g='urn:import:com.google.gwt.user.client.ui' 
	xmlns:aon='urn:import:com.esferalia.aon.gwt.common.client.widget'
	xmlns:fiscal='urn:import:com.esferalia.aon.gwt.fiscal.client.widget'
	xmlns:cell='urn:import:com.google.gwt.user.cellview.client'>

	<ui:with type="com.esferalia.aon.gwt.common.client.i18n.CommonMessages" field="msg"></ui:with>

	<ui:style>
		.inner-label {
			font-style: italic;
			margin-left: 5px;
			margin-right: 5px;
			display: inline;
		}
		
		.scrollable {
			height: 100%;
			width: 100%;
			border: 1px solid #ccc;
			text-align: left;
		}
		
		.perception-label {
			font-weight: bold;
			text-decoration: underline;
		}
		
		.perceptor-group-label {
			font-weight: bold;
			font-size: 0.9em;
			border-bottom: 1px solid #CCCCCC;
		}
		
		.perceptor-label {
			padding-right: 2px;
			font-size: 0.9em;
			text-align: center;
		}
		
		.div-amounts-caption {
			font-size: 0.9em;
			padding-left: 2px;
			font-weight: bold;
		}
		
		.newDetailButton {
			background-color: rgba(0, 0, 0, 0);
			border: 0 none;
			cursor: pointer;
			min-height: 16px;
		}
		
		.detailToolbar {
			height: 20px;
		}
	</ui:style>

	<g:DockLayoutPanel ui:field="dockLayoutPanel">
		<g:north size="26">
			<g:FlowPanel ui:field="toolbarPanel" height="100%"
				styleName="aon-finding-title-toolbar aon-width-all">
				<g:HorizontalPanel>
					<g:HTMLPanel styleName="aon-finding-title">
						<g:HTMLPanel styleName="aon-finding-title-internal">
							<g:Label styleName="aon-outputText" text="{msg.mod180}" />
						</g:HTMLPanel>
					</g:HTMLPanel>
					<g:HTMLPanel styleName="aon-finding-subtitle">
						<g:HTMLPanel styleName="aon-finding-subtitle-internal">
							<g:Label styleName="aon-outputText"></g:Label>
						</g:HTMLPanel>
					</g:HTMLPanel>
					<g:HorizontalPanel styleName="aon-finding-toolbar">
						<g:HTMLPanel styleName="aon-finding-toolbar-item-group">
							<g:Button ui:field='newButton'
								styleName='aon-finding-toolbar-item aon-icon-reset' text="{msg.newAction}" />
							<g:Button ui:field='saveButton'
								styleName='aon-finding-toolbar-item aon-icon-accept' text="{msg.saveAction}" />
							<g:Button ui:field='cancelButton'
								styleName='aon-finding-toolbar-item aon-icon-cancel' text="{msg.cancelAction}" />
							<g:Button ui:field='deleteButton'
								styleName='aon-finding-toolbar-item aon-icon-delete' text="{msg.deleteAction}" />
							<g:Button ui:field='printButton'
								styleName='aon-finding-toolbar-item aon-icon-printer' text="{msg.printViaAeat}" />
							<g:Button ui:field='generateFileButton'
								styleName='aon-finding-toolbar-item aon-icon-aeat' text="{msg.generateFile}" />
							<g:Anchor ui:field="download" visible="false"/>							
						</g:HTMLPanel>
						<g:FlowPanel ui:field="formContainer">
						</g:FlowPanel>
					</g:HorizontalPanel>
				</g:HorizontalPanel>
			</g:FlowPanel>
		</g:north>
		<g:center>
			<g:DeckLayoutPanel ui:field="deckPanel">
				<g:DockLayoutPanel ui:field="formPanel" unit="PX">
					<g:north size="125">
						<g:HTMLPanel styleName="aon-scroll-area">
							<g:HorizontalPanel ui:field='messagesPanel'/>
							<table class="aon-panelGrid aon-margin-top aon-width-all">
								<colgroup>
									<col style="width: 100px;" />
									<col style="width: auto;" />
								</colgroup>
								<tr>
									<td class="aon-panelGrid-odd">
										<g:Label text="{msg.deponentData}" />
									</td>
									<td class="aon-panelGrid-even">
										<fiscal:EnterpriseSuggestBox ui:field="enterpriseSuggest" />
									</td>
								</tr>
							</table>
							<table class="aon-panelGrid aon-width-all">
								<colgroup>
									<col style="width: 100px;" />
									<col style="width: 75px;" />
									<col style="width: 100px;" />
									<col style="width: 150px;" />
									<col style="width: 100px;" />
									<col style="width: 100px;" />
									<col style="width: auto; white-space: nowrap;" />
								</colgroup>
								<tr>
									<td class="aon-panelGrid-odd">
										<g:Label text="{msg.fiscalYear}" />
									</td>
									<td class="aon-panelGrid-even">
										<g:TextBox maxLength="4" visibleLength="4" ui:field="year"></g:TextBox>
									</td>
									<td class="aon-panelGrid-odd">
										<g:Label text="{msg.administration}" />
									</td>
									<td class="aon-panelGrid-even aon-nowrap">
										<aon:AdministrationListBox ui:field="administration" />
									</td>
									<td class="aon-panelGrid-even aon-nowrap">
										<g:CheckBox ui:field="confidential" text="{msg.confidential}" />
										<g:CheckBox ui:field="replacement" text="{msg.replacement}" />
									</td>
									<td class="aon-panelGrid-odd">
										<g:Label text="{msg.contactPerson}" />
									</td>
									<td class="aon-panelGrid-even aon-nowrap">
										<g:Label text="{msg.phone}" styleName="{style.inner-label}" />
										<g:TextBox visibleLength="10" ui:field="contactPhone" />
										<g:Label text="{msg.contactPerson}" styleName="{style.inner-label}" />
										<g:TextBox visibleLength="30" ui:field="contactPerson" />
									</td>
								</tr>
								<tr>
									<td class="aon-panelGrid-odd">
										<g:Label text="{msg.receipt}" />
									</td>
									<td class="aon-panelGrid-even" colspan="2">
										<g:TextBox visibleLength="13" ui:field="receipt" />
									</td>
									<td class="aon-panelGrid-odd" rowspan="2">
										<g:Label text="{msg.comments}" />
									</td>
									<td class="aon-panelGrid-even" rowspan="2" colspan="3">
										<g:TextArea visibleLines="1" characterWidth="80"
											ui:field="comments"></g:TextArea>
									</td>
								</tr>
								<tr>
									<td class="aon-panelGrid-odd">
										<g:Label text="{msg.replacedReceipt}" />
									</td>
									<td class="aon-panelGrid-even" colspan="2">
										<g:TextBox visibleLength="13" ui:field="replacedReceipt" />
									</td>
								</tr>
							</table>
						</g:HTMLPanel>
					</g:north>
					<g:north size="30">
						<g:HTMLPanel ui:field='perceptorHeaderPanel'
							styleName="aon-scroll-area">
							<table class="aon-width-all">
								<tr>
									<td style="width: 260px; vertical-align:top;" class="gwt-MenuBar-horizontal aon-text-right">
										<g:Button ui:field='newDetailButton' title="{msg.newPerceptor}"
											styleName='{style.newDetailButton} aon-icon-reset' />
									</td>
									<td class="gwt-MenuBar-horizontal"
										style="width: auto;font-weight:bold; padding-left: 15px;vertical-align:top;">
										<g:Label text="{msg.receiverList}" />
									</td>
								</tr>
							</table>
						</g:HTMLPanel>
					</g:north>
					<g:west size="300">
						<g:HTMLPanel styleName="aon-scroll-area">
							<aon:ShowMorePagerPanel addStyleNames="{style.scrollable}"
								ui:field="pagerPanel" />
						</g:HTMLPanel>
					</g:west>
					<g:center>
						<g:ScrollPanel ui:field="perceptorPanel" styleName="aon-scroll-area">
							<g:VerticalPanel>
								<g:FlowPanel
									styleName="aon-finding-title-toolbar aon-width-all gwt-MenuBar-horizontal {style.detailToolbar}">
									<g:Button ui:field='deleteDetailButton'
										styleName='aon-finding-toolbar-item aon-icon-delete' text="{msg.deleteAction}" />
									<g:Button ui:field='restoreDeletedButton'
										styleName='aon-finding-toolbar-item aon-icon-refresh' text="{msg.restoreAction}" />
								</g:FlowPanel>
								<g:HTMLPanel>
									<table>
										<tr>
											<td class="{style.perceptor-label}">
												<g:Label text="{msg.receiverDocument}" />
											</td>
											<td class="{style.perceptor-label}">
												<g:Label text="{msg.representativeDocument}" />
											</td>
											<td class="{style.perceptor-label}">
												<g:Label text="{msg.fullName}" />
											</td>
											<td class="{style.perceptor-label}">
												<g:Label text="{msg.province}" />
											</td>
										</tr>
										<tr>
											<td>
												<aon:DocumentTextBox ui:field="receiverDocument" />
											</td>
											<td>
												<aon:DocumentTextBox ui:field="representativeDocument" />
											</td>
											<td>
												<g:TextBox maxLength="40" visibleLength="40"
													ui:field="fullName" />
											</td>
											<td>
												<aon:ProvinceListBox ui:field="province" />
											</td>
										</tr>
									</table>

									<table>
										<tr>
											<td>
											</td>
											<td class="{style.perceptor-label}">
												<g:Label text="{msg.perception}" />
											</td>
											<td class="{style.perceptor-label}">
												<g:Label text="{msg.percent}" />
											</td>
											<td class="{style.perceptor-label}">
												<g:Label text="{msg.retention}" />
											</td>
											<td class="{style.perceptor-label}">
												<g:Label text="{msg.accrualYear}" />
											</td>
										</tr>
										<tr>
											<td>
												<g:CheckBox ui:field="inKind" text="{msg.inKind}"/>
											</td>
											<td>
												<aon:DoubleTextBox ui:field="perception" />
											</td>
											<td>
												<aon:DoubleTextBox ui:field="percent" />
											</td>
											<td>
												<aon:DoubleTextBox ui:field="retention" />
											</td>
											<td>
												<aon:IntegerTextBox maxLength="4"
													visibleLength="4" ui:field="accrualYear" />
											</td>
										</tr>
									</table>
								</g:HTMLPanel>
							</g:VerticalPanel>
						</g:ScrollPanel>
					</g:center>
				</g:DockLayoutPanel>

				<g:ScrollPanel ui:field="listPanel" styleName="aon-scroll-area">
					<!-- here will be inserted de CellTable -->
					<cell:CellTable ui:field="table" />
				</g:ScrollPanel>
			</g:DeckLayoutPanel>
		</g:center>
	</g:DockLayoutPanel>
</ui:UiBinder>
