<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<ui:UiBinder xmlns:ui='urn:ui:com.google.gwt.uibinder'
	xmlns:g='urn:import:com.google.gwt.user.client.ui'
	xmlns:d="urn:import:com.google.gwt.user.datepicker.client"
	xmlns:aon='urn:import:com.esferalia.aon.gwt.common.client.widget'
	xmlns:cell='urn:import:com.google.gwt.user.cellview.client'>

	<ui:with type="com.esferalia.aon.gwt.common.client.i18n.CommonMessages"
		field="msg"></ui:with>
	<ui:with type="com.esferalia.aon.gwt.common.client.css.AonResources"
		field="aonResources"></ui:with>


	<g:ScrollPanel styleName="{aonResources.css.aonScrollArea}">
		<g:HTMLPanel styleName="{aonResources.css.aonFiscalContainer}">
			<g:HTMLPanel ui:field="basePanel" styleName="aon-width-all">
				<table class="{aonResources.css.aonWidthAll}">
					<tr>
						<td>
							<div class="{aonResources.css.aonGroup}">
								<div class="{aonResources.css.aonGroupTitle}">
									<g:InlineLabel text="{msg.identification}" />
								</div>
								<div class="{aonResources.css.aonGroupBody}">
									<table class="{aonResources.css.aonWidthAll}">
										<tr>
											<td>
												<g:Label text="{msg.nif}" styleName="{aonResources.css.aonInnerLabel}" />
												<aon:DocumentTextBox ui:field="IDA01010"
													visibleLength="9" maxLength="9" />
											</td>
											<td>
												<g:CheckBox ui:field="IDA01011" text="SA" value="false" />
												<g:CheckBox ui:field="IDA01012" text="SL" value="false" />
												<g:Label text="Otras" styleName="{aonResources.css.aonInnerLabel}" />
												<g:TextBox ui:field="IDA01013" styleName="aon-inputText" />
											</td>

										</tr>
										<tr>
											<td>
												<g:HorizontalPanel ui:field="LEIPanel">
													<g:Label text="LEI" styleName="{aonResources.css.aonInnerLabel}" />
													<g:TextBox ui:field="IDA01009" styleName="{aonResources.css.aonInputText}"/>
												</g:HorizontalPanel>
											</td>
											<td>
												<g:Label ui:field="LEILabel" text="Solo para las empresas que dispongan de código LEI (Legal Entity Identifier)"/>
											</td>
										</tr>
										<tr>
											<td>
												<g:Label text="{msg.companyName}" styleName="{aonResources.css.aonInnerLabel}" />
												<g:TextBox ui:field="IDA01020"
													styleName="{aonResources.css.aonInputText}" />
											</td>
											<td>
												<g:Label text="Domicilio Social" styleName="{aonResources.css.aonInnerLabel}" />
												<g:TextBox ui:field="IDA01022"
													styleName="{aonResources.css.aonInputText}" />
											</td>

										</tr>
									</table>
									
									<table style="margin-top: 10px;" class="{aonResources.css.aonWidthAll}">
										<tr>
											<td>
												<g:Label text="Municipio" styleName="{aonResources.css.aonInnerLabel}" />
												<g:TextBox ui:field="IDA01023"
													styleName="{aonResources.css.aonInputText}" />
											</td>
											<td>
												<g:Label text="Provincia" styleName="{aonResources.css.aonInnerLabel}" />
												<g:ListBox ui:field="IDA01025"
													styleName="{aonResources.css.aonInputText}" />
											</td>
										</tr>
										<tr>
											<td>
												<g:Label text="Código postal" styleName="{aonResources.css.aonInnerLabel}" />
												<g:TextBox ui:field="IDA01024"
													styleName="{aonResources.css.aonInputText}" />
											</td>
											<td>
												<g:Label text="Teléfono" styleName="{aonResources.css.aonInnerLabel}" />
												<g:TextBox ui:field="IDA01031"
													styleName="{aonResources.css.aonInputText}" />
											</td>
										</tr>
										<tr>
											<td>
												<g:Label text="Dirección de e-mail de contacto de la empresa"
													styleName="{aonResources.css.aonInnerLabel}" />
											</td>
											<td>
												<g:TextBox ui:field="IDA01037"
													styleName="{aonResources.css.aonInputText}" />
											</td>
										</tr>
									</table>
									<g:HTMLPanel ui:field="societyPanel">
										<table style="margin-top: 10px;" class="{aonResources.css.aonWidthAll}">
											<tr>
												<td>
													<g:Label text="Pertenencia a un grupo de sociedades"
														styleName="{aonResources.css.aonInnerLabel}" />
												</td>
												<td>
													<g:Label text="Denominación social" styleName="{aonResources.css.aonInnerLabel}" />
												</td>
												<td>
													<g:Label text="NIF" styleName="{aonResources.css.aonInnerLabel}" />
												</td>
											</tr>
											<tr>
												<td>
													<g:Label text="Sociedad dominante directa"
														styleName="{aonResources.css.aonInnerLabel}" />
												</td>
												<td>
													<g:TextBox ui:field="IDA01041"
														styleName="{aonResources.css.aonInputText}" />
												</td>
												<td>
													<g:TextBox ui:field="IDA01040"
														styleName="{aonResources.css.aonInputText}" />
												</td>
											</tr>
											<tr>
												<td>
													<g:Label text="Sociedad dominante última del grupo"
														styleName="{aonResources.css.aonInnerLabel}" />
												</td>
												<td>
													<g:TextBox ui:field="IDA01061"
														styleName="{aonResources.css.aonInputText}" />
												</td>
												<td>
													<g:TextBox ui:field="IDA01060"
														styleName="{aonResources.css.aonInputText}" />
												</td>
											</tr>
										</table>
									</g:HTMLPanel>
									<div class="{aonResources.css.aonGroup}">
										<div class="{aonResources.css.aonGroupTitle}">
											<g:InlineLabel text="Actividad" />
										</div>
										<div class="{aonResources.css.aonGroupBody}">
											<table style="margin-top: 10px;" class="{aonResources.css.aonWidthAll}">
											
												<tr>
													<td>
														<g:Label text="Código CNAE" styleName="{aonResources.css.aonInnerLabel}" />
														<g:TextBox visibleLength="42" maxLength="40"
															ui:field="IDA02001" styleName="{aonResources.css.aonInputText}" />
														<g:Button ui:field="showCnae"
															styleName="aon-icon-lookup {aonResources.css.aonBorderNone}">
															&#160;
														</g:Button>
														<g:InlineLabel ui:field="IDA02009" styleName="{aonResources.css.aonMarginLeft}"/>
													</td>
												</tr>
											</table>
										</div>

									</div>

									<div class="{aonResources.css.aonGroup}">
										<div class="{aonResources.css.aonGroupTitle}">
											<g:InlineLabel text="Personal asalariado" />
										</div>
										<div class="{aonResources.css.aonGroupBody}">
											<table style="margin-top: 10px;" class="{aonResources.css.aonWidthAll}">
												<tr>
													<td colspan="5">
														<g:Label
															text="a) Número medio de personas empleadas en el curso del ejercicio, por tipo de contrato y empleo con discapacidad"
															styleName="{aonResources.css.aonInnerLabel}" />
													</td>
												</tr>
												<tr>
													<td>
													</td>
													<td colspan="2">
														<g:Label ui:field="current1"  styleName="{aonResources.css.aonInnerLabel}" />
													</td>
													<td colspan="2">
														<g:Label ui:field="ant1"  styleName="{aonResources.css.aonInnerLabel}" />
													</td>
												</tr>
												<tr>
													<td>
														<g:Label text="FIJO" styleName="{aonResources.css.aonInnerLabel}" />
													</td>
													<td colspan="2">
														<aon:DoubleBox ui:field="IDA04001"  />
													</td>
													<td colspan="2">
														<aon:DoubleBox ui:field="IDA040019"  />
													</td>
												</tr>
												<tr>
													<td>
														<g:Label text="NO FIJO" styleName="{aonResources.css.aonInnerLabel}" />
													</td>
													<td colspan="2">
														<aon:DoubleBox ui:field="IDA04002" />
													</td>
													<td colspan="2">
														<aon:DoubleBox ui:field="IDA040029"  />
													</td>
												</tr>
												<tr>
													<td colspan="5">
														<g:Label
															text="Del cual: Personas empleadas con discapacidad mayor o igual al 33% (o calificación equivalente local):"
															styleName="{aonResources.css.aonInnerLabel}" />
													</td>
												</tr>
												<tr>
													<td>
													</td>
													<td colspan="2">
														<aon:DoubleBox ui:field="IDA04010"  />
													</td>
													<td colspan="2">
														<aon:DoubleBox ui:field="IDA040109"  />
													</td>
												</tr>
												<tr>
													<td colspan="5">
														<g:Label
															text="b) Personal asalariado al término del ejercicio, por tipo de contrato y por sexo"
															styleName="{aonResources.css.aonInnerLabel}" />
													</td>
												</tr>
												<tr>
													<td>
													</td>
													<td colspan="2">
														<g:Label ui:field="current2" styleName="{aonResources.css.aonInnerLabel}" />
													</td>
													<td colspan="2">
														<g:Label ui:field="ant2" styleName="{aonResources.css.aonInnerLabel}" />
													</td>
												</tr>
												<tr>
													<td>

													</td>
													<td>
														<g:Label text="Hombres" styleName="{aonResources.css.aonInnerLabel}" />
													</td>
													<td>
														<g:Label text="Mujeres" styleName="{aonResources.css.aonInnerLabel}" />
													</td>
													<td>
														<g:Label text="Hombres" styleName="{aonResources.css.aonInnerLabel}" />
													</td>
													<td>
														<g:Label text="Mujeres" styleName="{aonResources.css.aonInnerLabel}" />
													</td>
												</tr>
												<tr>
													<td>
														<g:Label text="FIJO" styleName="{aonResources.css.aonInnerLabel}" />
													</td>
													<td>
														<aon:DoubleBox ui:field="IDA04120" />
													</td>
													<td>
														<aon:DoubleBox ui:field="IDA04121" />
													</td>
													<td>
														<aon:DoubleBox ui:field="IDA041209"  />
													</td>
													<td>
														<aon:DoubleBox ui:field="IDA041219"  />
													</td>
												</tr>
												<tr>
													<td>
														<g:Label text="NO FIJO" styleName="{aonResources.css.aonInnerLabel}" />
													</td>
													<td>
														<aon:DoubleBox ui:field="IDA04122"  />
													</td>
													<td>
														<aon:DoubleBox ui:field="IDA04123"  />
													</td>
													<td>
														<aon:DoubleBox ui:field="IDA041229"  />
													</td>
													<td>
														<aon:DoubleBox ui:field="IDA041239" />
													</td>
												</tr>

											</table>
										</div>
									</div>

									<div class="{aonResources.css.aonGroup}">
										<div class="{aonResources.css.aonGroupTitle}">
											<g:InlineLabel text="Presentación de cuentas" />
										</div>
										<div class="{aonResources.css.aonGroupBody}">
											<table style="margin-top: 10px;" class="{aonResources.css.aonWidthAll}">
												<tr>
													<td>
													</td>
													<td>
														<g:Label ui:field="current3" styleName="{aonResources.css.aonInnerLabel}" />
													</td>
													<td>
														<g:Label ui:field="ant3" styleName="{aonResources.css.aonInnerLabel}" />
													</td>
												</tr>
												<tr>
													<td>
														<g:Label
															text="Fecha de inicio a la que van referidas las cuentas"
															styleName="{aonResources.css.aonInnerLabel}" />
													</td>
													<td>
														<d:DateBox ui:field="IDA01102" styleName="{aonResources.css.aonInputText}" />
													</td>
													<td>
														<d:DateBox ui:field="IDA011029" styleName="{aonResources.css.aonInputText}" />
													</td>
												</tr>
												<tr>
													<td>
														<g:Label
															text="Fecha de cierre a la que van referidas las cuentas"
															styleName="{aonResources.css.aonInnerLabel}" />
													</td>
													<td>
														<d:DateBox ui:field="IDA01101" styleName="{aonResources.css.aonInputText}" />
													</td>
													<td>
														<d:DateBox ui:field="IDA011019" styleName="{aonResources.css.aonInputText}" />
													</td>
												</tr>
												<tr>
													<td>
														<g:Label text="Número de páginas presentadas al depósito"
															styleName="{aonResources.css.aonInnerLabel}" />
													</td>
													<td colspan="2">
														<aon:DoubleBox ui:field="IDA01901" />
													</td>
												</tr>
												<tr>
													<td>
														<g:Label
															text="En caso de no figurar consignadas cifras en alguno de los ejercicios, indique la causa"
															styleName="{aonResources.css.aonInnerLabel}" />
													</td>
													<td colspan="2">
														<g:TextBox ui:field="IDA01903" styleName="{aonResources.css.aonInputText}"/>
													</td>
												</tr>

											</table>
										</div>
									</div>

									<div class="{aonResources.css.aonGroup}">
									<g:HTMLPanel>
									<g:HTMLPanel ui:field="unityPanel"> 
										<div class="{aonResources.css.aonGroupTitle}">
											<g:InlineLabel text="Unidades" />
										</div>
										<div class="{aonResources.css.aonGroupBody}">
											<table style="margin-top: 10px;" class="{aonResources.css.aonWidthAll}">
												<tr>
													<td>
														<g:CheckBox ui:field="IDA09001" text="Euros"
															value="false" />

														<g:CheckBox ui:field="IDA09002" text="Miles de euros"
															value="false" />

														<g:CheckBox ui:field="IDA09003" text="Millones de euros"
															value="false" />
													</td>
												</tr>
											</table>
										</div>
									</g:HTMLPanel>
									<g:HTMLPanel ui:field="micropymePanel"> 
										<div class="{aonResources.css.aonGroupTitle}">
											<g:InlineLabel text="Microempresas" />
										</div>
										<div class="{aonResources.css.aonGroupBody}">
											<table style="margin-top: 10px;" class="{aonResources.css.aonWidthAll}">
												<tr>
													<td>
														<g:Label text="Marque con una X si la empresa ha optado por la adopción conjunta de los criterios específicos,
																	aplicables por microempresas, previstos en el Plan General de Contabilidad de PYMES (6)"/>

														<g:CheckBox ui:field="IDA01902" value="false" />
													</td>
												</tr>
											</table>
										</div>
									</g:HTMLPanel>
									</g:HTMLPanel>
									</div>
								</div>
							</div>
						</td>
					</tr>

				</table>
				<g:FlexTable ui:field="table"
					styleName="{aonResources.css.aonWidthAll} {aonResources.css.aonMarginTop}" />
			</g:HTMLPanel>
		</g:HTMLPanel>
	</g:ScrollPanel>


</ui:UiBinder>
