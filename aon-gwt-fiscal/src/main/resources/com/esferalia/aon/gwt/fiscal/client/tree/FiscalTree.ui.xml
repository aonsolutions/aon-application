<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<ui:UiBinder xmlns:ui='urn:ui:com.google.gwt.uibinder'
	xmlns:g='urn:import:com.google.gwt.user.client.ui' 
	xmlns:cell='urn:import:com.google.gwt.user.cellview.client'
	xmlns:aon='urn:import:com.esferalia.aon.gwt.common.client.widget'
	xmlns:m180='urn:import:com.esferalia.aon.gwt.fiscal.client.mod180'>

	<ui:with type="com.esferalia.aon.gwt.common.client.i18n.CommonMessages" field="msg"></ui:with>
	<ui:with type="com.esferalia.aon.gwt.common.client.css.AonResources" field="aonResources"></ui:with>

	<g:SplitLayoutPanel ui:field="splitLayoutPanel">
		<g:north size="26">
			<g:FlowPanel ui:field="toolbarPanel" height="100%"
				styleName="aon-finding-title-toolbar aon-width-all">
				<g:HorizontalPanel>
					<g:HTMLPanel styleName="aon-finding-title">
						<g:HTMLPanel styleName="aon-finding-title-internal">
							<g:Label styleName="aon-outputText" text="{msg.fiscalPanel}" />
						</g:HTMLPanel>
					</g:HTMLPanel>
					<g:HTMLPanel styleName="aon-finding-subtitle">
						<g:HTMLPanel styleName="aon-finding-subtitle-internal">
							<g:Label ui:field="subtitle" styleName="aon-outputText"/>
						</g:HTMLPanel>
					</g:HTMLPanel>
					<g:HorizontalPanel styleName="aon-finding-toolbar">
						<g:HTMLPanel styleName="aon-finding-toolbar-item-group">
							<g:SuggestBox ui:field="enterpriseSuggest"/>
						</g:HTMLPanel>
					</g:HorizontalPanel>
				</g:HorizontalPanel>
			</g:FlowPanel>
		</g:north>
		
		<g:west size="300">
			<g:ScrollPanel ui:field="sidebar">
				<g:Tree ui:field="tree"/>
			</g:ScrollPanel>
		</g:west>

		<g:center>
			<g:ScrollPanel ui:field="content"/>
		</g:center>
		
		<g:south size="0">
			<aon:MinimizePanel ui:field="footPanel">
				<g:TabLayoutPanel styleName="gwt-Selector" barHeight="26" barUnit="PX" width="100%">
					<g:tab>
						<g:header>
							<span class="aon-icon-time aon-icon-commandButton" style="padding-left: 20px;">
								Notificaciones
							</span>
						</g:header>
						<aon:ResultsPanel ui:field="resultsPanel" />
					</g:tab>
				</g:TabLayoutPanel>
			</aon:MinimizePanel>
		</g:south>
	</g:SplitLayoutPanel>
</ui:UiBinder>
