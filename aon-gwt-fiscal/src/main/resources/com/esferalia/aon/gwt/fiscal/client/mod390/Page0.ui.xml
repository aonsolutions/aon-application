<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<ui:UiBinder xmlns:ui='urn:ui:com.google.gwt.uibinder'
	xmlns:g='urn:import:com.google.gwt.user.client.ui' 
	xmlns:aon='urn:import:com.esferalia.aon.gwt.common.client.widget'>

	<ui:with type="com.esferalia.aon.gwt.common.client.i18n.CommonMessages" field="msg"></ui:with>
	<ui:with type="com.esferalia.aon.gwt.common.client.css.AonResources" field="aonResources"></ui:with>

	<g:HTMLPanel>
		<g:Label text="{msg.deponentData}" styleName="{aonResources.css.aonPageHeader}"/>
		
		<div class="{aonResources.css.aonGroup}">
			<div class="{aonResources.css.aonGroupTitle}">
				<g:InlineLabel text="{msg.identification}"/>
			</div>
			<div class="{aonResources.css.aonGroupBody}">
				<table class="aon-width-all">
					<tr>
						<td>
							<g:Label text="{msg.document}" />
						</td>
						<td>
							<aon:DocumentTextBox ui:field="document" styleName="aon-inputText"/>
						</td>
					</tr>
					<tr>
						<td>
							<g:Label text="{msg.name}" />
						</td>
						<td>
							<g:TextBox ui:field="name" visibleLength="25" styleName="aon-inputText"/>
						</td>
					</tr>
					<tr>
						<td>
							<g:Label text="{msg.surname}" />
						</td>
						<td>
							<g:TextBox ui:field="firstSurname" maxLength="15" visibleLength="16" styleName="aon-inputText"/>
							<g:TextBox ui:field="secondSurname" maxLength="15" visibleLength="16" styleName="aon-inputText"/>
						</td>
					</tr>
					<tr>
						<td>
							<g:Label text="{msg.phone}" />
						</td>
						<td>
							<g:TextBox ui:field="phone" styleName="aon-inputText"/>
						</td>
					</tr>
					<tr>
						<td></td>
						<td>
							<g:CheckBox ui:field="replacement" text="{msg.replacement}" />
						</td>
					</tr>
					<tr>
						<td></td>
						<td>
							<g:CheckBox ui:field="replacementDueInsolvencyState" text="{msg.replacementDueInsolvencyState}" />
						</td>
					</tr>
					<tr>
						<td></td>
						<td>
							<g:Label text="{msg.replacedReceipt}" styleName="{aonResources.css.aonInnerLabel}" />
							<g:TextBox visibleLength="13" ui:field="replacedReceipt" styleName="aon-inputText"/>
						</td>
					</tr>
				</table>
			</div>
		</div>

		<div>
			<g:CheckBox ui:field="taxRefund" text="{msg.taxRefund}" />
		</div>

		<div class="{aonResources.css.aonGroup}">
			<div class="{aonResources.css.aonGroupTitle}">
			</div>
			<div class="{aonResources.css.aonGroupBody}">
				<g:CheckBox ui:field="specialGroupRegime" text="{msg.specialGroupRegime}" />
				<div style="margin-left: 15px; padding-left: 5px; padding-right: 5px">
					<g:Label text="{msg.groupNumber}" styleName="{aonResources.css.aonInnerLabel}" />
					<g:TextBox maxLength="5" visibleLength="5" ui:field="groupNumber" styleName="aon-inputText"/>
					<g:CheckBox ui:field="groupDependent" text="{msg.groupDependent}" />
				</div>
				<div style="margin-left: 15px; padding-left: 5px; padding-right: 5px">
					<g:CheckBox ui:field="groupRegimeType" text="{msg.groupRegimeType}" />
					<g:Label text="{msg.groupDocument}" styleName="{aonResources.css.aonInnerLabel}" />
					<aon:DocumentTextBox ui:field="groupDocument" styleName="aon-inputText"/>
				</div>
				<div style="margin-left: 15px; padding-left: 5px; padding-right: 5px">
					<g:CheckBox ui:field="groupDeclarations" text="{msg.groupDeclarations}" />
				</div>
			</div>
		</div>
		
		<g:DeckPanel ui:field="page0Panel">
		
			<g:FlowPanel ui:field="panel0">
					<g:CheckBox ui:field="insolvencyDeclarations" text="{msg.insolvencyDeclarations}" />
			</g:FlowPanel>

			<g:FlowPanel ui:field="panel1">
				<g:HTMLPanel>
					<div class="{aonResources.css.aonGroup}">
						<div class="{aonResources.css.aonGroupTitle}">
							<g:InlineLabel text="{msg.insolvencyState}"/>
						</div>
						<div class="{aonResources.css.aonGroupBody}">
							<div>
								<g:CheckBox ui:field="insolvencyStateThisYear" text="{msg.insolvencyStateThisYear}" />
							</div>
							<div>
								<g:CheckBox ui:field="insolvencyStateLastPeriod" text="{msg.insolvencyStateLastPeriod}" />
							</div>
						</div>
					</div>
					<div class="{aonResources.css.aonGroup}">
						<div class="{aonResources.css.aonGroupTitle}">
							<g:InlineLabel text="{msg.cashAccrualRegime}"/>
						</div>
						<div class="{aonResources.css.aonGroupBody}">
							<div>
								<g:CheckBox ui:field="accrualRegime" text="{msg.accrualRegime}" />
							</div>
							<div>
								<g:CheckBox ui:field="accrualRegimeTarget" text="{msg.accrualRegimeTarget}" />		
							</div>
						</div>
					</div>
				</g:HTMLPanel>
			</g:FlowPanel>
		</g:DeckPanel>
		
		
 	</g:HTMLPanel>
	
</ui:UiBinder>
