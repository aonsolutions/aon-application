<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<ui:UiBinder xmlns:ui='urn:ui:com.google.gwt.uibinder'
	xmlns:g='urn:import:com.google.gwt.user.client.ui' 
	xmlns:aon='urn:import:com.esferalia.aon.gwt.common.client.widget'>

	<ui:with type="com.esferalia.aon.gwt.common.client.i18n.CommonMessages" field="msg"></ui:with>
	<ui:with type="com.esferalia.aon.gwt.common.client.css.AonResources" field="aonResources"></ui:with>

	<ui:style>
		.table {
			width: 90%;
			border-collapse: collapse;
		}
		.table td:first-child {
			border-bottom:#ccc 1px solid;
			padding-left: 5px;
		}
		
	</ui:style>
	<g:HTMLPanel>
		<g:Label text="{msg.deponentData}" styleName="{aonResources.css.aonPageHeader}"/>
		
		<table class="{style.table}">
			<tr>
				<td>
					<g:Label text="{msg.document}" />
				</td>
				<td>
					<aon:DocumentTextBox ui:field="document" styleName="aon-inputText"/>
				</td>
			</tr>

			<tr>
				<td>
					<g:Label text="{msg.name}" />
				</td>
				<td>
					<g:TextBox ui:field="name" visibleLength="25" styleName="aon-inputText"/>
				</td>
			</tr>

			<tr>
				<td>
					<g:Label text="{msg.surname}" />
				</td>
				<td>
					<g:TextBox ui:field="firstSurname" maxLength="15" visibleLength="16" styleName="aon-inputText"/>
					<g:TextBox ui:field="secondSurname" maxLength="15" visibleLength="16" styleName="aon-inputText"/>
				</td>
			</tr>

			<tr>
				<td>
					<g:Label text="{msg.phone}" />
				</td>
				<td>
					<g:TextBox ui:field="phone" styleName="aon-inputText"/>
				</td>
			</tr>
		</table>
	</g:HTMLPanel>
	
</ui:UiBinder>
