<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<ui:UiBinder xmlns:ui='urn:ui:com.google.gwt.uibinder'
	xmlns:g='urn:import:com.google.gwt.user.client.ui' 
	xmlns:aon='urn:import:com.esferalia.aon.gwt.common.client.widget'
	xmlns:fiscal='urn:import:com.esferalia.aon.gwt.fiscal.client.widget'
	xmlns:cell='urn:import:com.google.gwt.user.cellview.client'>

	<ui:with type="com.esferalia.aon.gwt.common.client.i18n.CommonMessages" field="msg"></ui:with>
	<ui:with type="com.esferalia.aon.gwt.common.client.css.AonResources" field="aonResources"></ui:with>

	<ui:style>
	.inner-label {
		font-style: italic;
		margin-left: 5px;
		margin-right: 5px;
		display: inline;
	}
	
	.pageElement {
		margin-top: 10px;
		border: solid #CCC 1px;
		padding: 2px;
	}
	</ui:style>

	<g:HTMLPanel>
		<g:Label text="Datos generales de identificacion" styleName="{aonResources.css.aonPageHeader}"/>
		
		<table style="margin-top: 10px;" class="{aonResources.css.aonDataTable}">
			<tr>
				<td colspan="2">
					<g:Label text="Identificacion de la empresa" styleName="{aonResources.css.aonPageHeader}"/>
				</td>
			</tr>
			<tr>
				<td>
					<g:Label text="NIF" styleName="{style.inner-label}"/>
				</td>
				<td>
					<g:Label text="Forma juridica" styleName="{style.inner-label}"/>
				</td>
			</tr>
			<tr>
				<td>
					<aon:DocumentTextBox ui:field="rdocument" />
				</td>
				<td>
					<g:CheckBox ui:field="saType" text="SA" />
					<g:CheckBox ui:field="dlType" text="SL" />
					<g:Label text="Otras" styleName="{style.inner-label}"/>
					<g:TextBox visibleLength="42" maxLength="40" ui:field="otherType" />
				</td>
			</tr>
		</table>
		<table style="margin-top: 10px;" class="{aonResources.css.aonDataTable}">
			<tr>
				<td>
					<g:Label text="Denominacion social" styleName="{style.inner-label}"/>
				</td>
				<td>
					<g:TextBox visibleLength="42" maxLength="40" ui:field="enterpriseName" />
				</td>
			</tr>
			<tr>
				<td>
					<g:Label text="Domicilio social" styleName="{style.inner-label}"/>
				</td>
				<td>
					<g:TextBox visibleLength="42" maxLength="40" ui:field="enterpriseAddress" />
				</td>
			</tr>
		</table>
		<table style="margin-top: 10px;" class="{aonResources.css.aonDataTable}">
			<tr>
				<td>
					<g:Label text="Municipio" styleName="{style.inner-label}"/>
				</td>
				<td>
					<g:TextBox visibleLength="42" maxLength="40" ui:field="municipalityName" />
				</td>
				<td>
					<g:Label text="Provincia" styleName="{style.inner-label}"/>
				</td>
				<td>
					<g:TextBox visibleLength="42" maxLength="40" ui:field="provinceName" />
				</td>
			</tr>
			<tr>
				<td>
					<g:Label text="Codigo postal" styleName="{style.inner-label}"/>
				</td>
				<td>
					<g:TextBox visibleLength="42" maxLength="40" ui:field="zipCode" />
				</td>
				<td>
					<g:Label text="Telefono" styleName="{style.inner-label}"/>
				</td>
				<td>
					<g:TextBox visibleLength="42" maxLength="40" ui:field="phone" />
				</td>
			</tr>
		</table>
		<table style="margin-top: 10px;" class="{aonResources.css.aonDataTable}">
			<tr>
				<td colspan="3">
					<g:Label text="Pertenencia a un grupo de sociedades" styleName="{aonResources.css.aonPageHeader}"/>
				</td>
			</tr>
			<tr>
				<td>
				</td>
				<td>
					<g:Label text="Denominacion social" styleName="{style.inner-label}"/>
				</td>
				<td>
					<g:Label text="NIF" styleName="{style.inner-label}"/>
				</td>
			</tr>
			<tr>
				<td>
					<g:Label text="Sociedad dominante directa" styleName="{style.inner-label}"/>
				</td>
				<td>
					<g:TextBox visibleLength="42" maxLength="40" ui:field="groupMainEnterpriseName" />
				</td>
				<td>
					<g:TextBox visibleLength="42" maxLength="40" ui:field="groupMainEnterpriseDocument" />
				</td>
			</tr>
			<tr>
				<td>
					<g:Label text="Sociedad dominante ultima del grupo" styleName="{style.inner-label}"/>
				</td>
				<td>
					<g:TextBox visibleLength="42" maxLength="40" ui:field="groupLastEnterpriseName" />
				</td>
				<td>
					<g:TextBox visibleLength="42" maxLength="40" ui:field="groupLastEnterpriseDocument" />
				</td>
			</tr>
		</table>
		<table style="margin-top: 10px;" class="{aonResources.css.aonDataTable}">
			<tr>
				<td colspan="2">
					<g:Label text="Actividad" styleName="{aonResources.css.aonPageHeader}"/>
				</td>
			</tr>
			<tr>
				<td>
					<g:Label text="Actividad principal" styleName="{style.inner-label}"/>
				</td>
				<td>
					<g:TextBox visibleLength="42" maxLength="40" ui:field="enterpriseMainActivity" />
				</td>
			</tr>
			<tr>
				<td>
					<g:Label text="Codigo CNAE" styleName="{style.inner-label}"/>
				</td>
				<td>
					<g:TextBox visibleLength="42" maxLength="40" ui:field="cnaeCode" />
				</td>
			</tr>
		</table>
		<table style="margin-top: 10px;" class="{aonResources.css.aonDataTable}">
			<tr>
				<td colspan="3">
					<g:Label text="Personal asalariado" styleName="{aonResources.css.aonPageHeader}"/>
				</td>
			</tr>
			<tr>
				<td colspan="3">
					<g:Label text="a) Numero medio de personas empleadas en el curso del ejercicio, por tipo de contrato y empleo con discapacidad" styleName="{style.inner-label}"/>
				</td>
			</tr>
			<tr>
				<td>
				</td>
				<td>
					<g:Label text="current" styleName="{style.inner-label}"/>
				</td>
				<td>
					<g:Label text="previous" styleName="{style.inner-label}"/>
				</td>
			</tr>
			<tr>
				<td>
					<g:Label text="FIJO" styleName="{style.inner-label}"/>
				</td>
				<td>
					<g:TextBox visibleLength="42" maxLength="40" ui:field="fixedCurrentAvg" />
				</td>
				<td>
					<g:TextBox visibleLength="42" maxLength="40" ui:field="fixedPreviousAvg" />
				</td>
			</tr>
			<tr>
				<td>
					<g:Label text="FIJO" styleName="{style.inner-label}"/>
				</td>
				<td>
					<g:TextBox visibleLength="42" maxLength="40" ui:field="noFixedCurrentAvg" />
				</td>
				<td>
					<g:TextBox visibleLength="42" maxLength="40" ui:field="noFixedPreviousAvg" />
				</td>
			</tr>			
			<tr>
				<td colspan="3">
					<g:Label text="Del cual: Personas empleadas con discapacidad mayor o igual al 33% (o calificacion equivalente local):" styleName="{style.inner-label}"/>
				</td>
			</tr>
			<tr>
				<td>
				</td>
				<td>
					<g:TextBox visibleLength="42" maxLength="40" ui:field="disabilityCurrentAvg" />
				</td>
				<td>
					<g:TextBox visibleLength="42" maxLength="40" ui:field="disabilityPreviousAvg" />
				</td>
			</tr>
		</table>
		
	</g:HTMLPanel>

</ui:UiBinder>
