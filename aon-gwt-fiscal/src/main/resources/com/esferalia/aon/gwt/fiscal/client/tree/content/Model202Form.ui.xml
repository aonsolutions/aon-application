<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<ui:UiBinder xmlns:ui='urn:ui:com.google.gwt.uibinder'
	xmlns:g='urn:import:com.google.gwt.user.client.ui' xmlns:aon='urn:import:com.esferalia.aon.gwt.common.client.widget'
	xmlns:fiscal='urn:import:com.esferalia.aon.gwt.fiscal.client.widget'
	xmlns:cell='urn:import:com.google.gwt.user.cellview.client'>

	<ui:with type="com.esferalia.aon.gwt.common.client.i18n.CommonMessages"
		field="msg"></ui:with>
	<ui:with type="com.esferalia.aon.gwt.common.client.css.AonResources"
		field="aonResources"></ui:with>
	<ui:with type="com.esferalia.aon.gwt.common.client.css.AonCSS"
		field="css"></ui:with>

	<g:DockLayoutPanel unit="PX">
		<g:north size="26">
			<g:FlowPanel styleName="aon-finding-title-toolbar">
				<g:HorizontalPanel>
					<g:HTMLPanel styleName="aon-finding-title">
						<g:HTMLPanel styleName="aon-finding-title-internal">
							<g:Label styleName="aon-outputText" text="{msg.mod202}" />
						</g:HTMLPanel>
					</g:HTMLPanel>
					<g:HTMLPanel styleName="aon-finding-subtitle">
						<g:HTMLPanel styleName="aon-finding-subtitle-internal">
							<g:Label styleName="aon-outputText"></g:Label>
						</g:HTMLPanel>
					</g:HTMLPanel>
					<g:HorizontalPanel styleName="aon-finding-toolbar">
						<g:HTMLPanel styleName="aon-finding-toolbar-item-group">
							<g:Button ui:field='saveButton'
								styleName='aon-finding-toolbar-item aon-icon-accept' text="{msg.saveAction}" />
							<g:Button ui:field='deleteButton'
								styleName="aon-finding-toolbar-item {aonResources.css.aonIconDelete}" text="{msg.deleteAction}" />
							<g:Button ui:field='calculateButton'
								styleName='aon-finding-toolbar-item aon-icon-refresh' text="{msg.calculateAction}" />
							<g:Button ui:field='finishButton'
								styleName='aon-finding-toolbar-item aon-icon-lock' text="{msg.finish}" />
							<g:Button ui:field='reopenButton'
								styleName='aon-finding-toolbar-item aon-icon-unlock' text="{msg.reopen}" />
<!-- 
							<g:Button ui:field='printButton'
								styleName='aon-finding-toolbar-item aon-icon-printer' text="{msg.printViaAeat}" />
 -->
							<g:Button ui:field='generateFileButton'
								styleName='aon-finding-toolbar-item aon-icon-aeat' text="{msg.generateFile}" />
						</g:HTMLPanel>
						<g:FlowPanel ui:field="formContainer" />
					</g:HorizontalPanel>
				</g:HorizontalPanel>
			</g:FlowPanel>
		</g:north>
		<g:center>
			<g:ScrollPanel styleName="{aonResources.css.aonScrollArea}">
				<g:HTMLPanel>
					<g:SimplePanel ui:field="headerPanel"/>
					<table class="{aonResources.css.aonFiscalModelDataTable} ">
						<tr>
							<td styleName="{aonResources.css.aonWidth110}">
								<g:Label text="{msg.document}" styleName="{aonResources.css.aonItalic}"/>
								<g:TextBox ui:field="document" visibleLength="10" maxLength="9" 
									styleName="{aonResources.css.aonInputText}"/>
							</td>
							<td>
								<g:Label text="{msg.nameCompanyName}" styleName="{aonResources.css.aonItalic}"/>
								<g:TextBox ui:field="name" visibleLength="30" maxLength="45" 
									styleName="{aonResources.css.aonInputText}"/>
							</td>
							<td>
								<g:Label text="{msg.surname}" styleName="{aonResources.css.aonItalic}"/>
								<g:TextBox ui:field="surname" visibleLength="30" maxLength="30"
									styleName="{aonResources.css.aonInputText}"/>
							</td>
							<td styleName="{aonResources.css.aonWidthAuto}">
								<g:Label ui:field="status" styleName="{aonResources.css.aonItalic}"/>
							</td>
							<td styleName="{aonResources.css.aonWidth70}">
								<g:ListBox ui:field="period" 
									styleName="{aonResources.css.aonFontBig} {aonResources.css.aonTextCenter} {aonResources.css.aonInputText}"/>
							</td>
							<td styleName="{aonResources.css.aonWidth70}">
								<g:Label ui:field="year" 
									styleName="{aonResources.css.aonFontBig} {aonResources.css.aonTextCenter}"/>
							</td>
						</tr>
						<tr>
							<td styleName="{aonResources.css.aonWidthAuto} {aonResources.css.aonNowrap}" colspan="3">
								<g:Label text="{msg.mainActivityCNAE}" styleName="{aonResources.css.aonItalic}"/>
								<g:TextBox ui:field="cnae" visibleLength="4" maxLength="4" readOnly="true"
									styleName="{aonResources.css.aonMarginLeft} {aonResources.css.aonInputText}"/>
								<g:Button ui:field="cnaeButton" 
									styleName="{aonResources.css.aonIconCommandButton} {aonResources.css.aonIconLoupe}"
									title="{msg.mainActivityCNAE}"/>
								<g:InlineLabel ui:field="cnaeDescription" styleName="{aonResources.css.aonMarginLeft}"/>
							</td>
							<td styleName="{aonResources.css.aonWidth110}" colspan="3">
								<g:Label text="{msg.yearInitialDate}" styleName="{aonResources.css.aonItalic}"/>
								<aon:DateBoxEx ui:field="initialDate" 
									styleName="{aonResources.css.aonInputText}"/>
							</td>
						</tr>
					</table>
					<g:FlowPanel ui:field="tablePanel"/>
					<aon:Cnae2009Panel ui:field="cnaePanel" />
				</g:HTMLPanel>
			</g:ScrollPanel>
		</g:center>
	</g:DockLayoutPanel>
</ui:UiBinder>
