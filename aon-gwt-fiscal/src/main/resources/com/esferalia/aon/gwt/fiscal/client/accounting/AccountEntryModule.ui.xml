<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<ui:UiBinder xmlns:ui='urn:ui:com.google.gwt.uibinder'
	xmlns:g='urn:import:com.google.gwt.user.client.ui' 
	xmlns:cell='urn:import:com.google.gwt.user.cellview.client'
	xmlns:aon='urn:import:com.esferalia.aon.gwt.common.client.widget'
	xmlns:fiscal='urn:import:com.esferalia.aon.gwt.fiscal.client.widget'
	xmlns:m180='urn:import:com.esferalia.aon.gwt.fiscal.client.mod180'>

	<ui:with type="com.esferalia.aon.gwt.common.client.i18n.CommonMessages" field="msg"></ui:with>
	<ui:with type="com.esferalia.aon.gwt.common.client.css.AonResources" field="aonResources"></ui:with>

	<g:DockLayoutPanel ui:field="dockLayoutPanel" styleName="{aonResources.css.aonSelector}">
		<g:north size="26">
			<g:FlowPanel height="100%"
				styleName="{aonResources.css.aonFindingTitleToolbar} {aonResources.css.aonWidthAll}">
				<g:HorizontalPanel>
					<g:HTMLPanel styleName="{aonResources.css.aonFindingTitle}">
						<g:HTMLPanel styleName="{aonResources.css.aonFindingTitleInternal}">
							<g:Label text="{msg.accountEntries}" />
						</g:HTMLPanel>
					</g:HTMLPanel>
					<g:HTMLPanel styleName="aon-finding-subtitle">
						<g:HTMLPanel styleName="{aonResources.css.aonFindingSubtitleIternal}">
							<g:Label></g:Label>
						</g:HTMLPanel>
					</g:HTMLPanel>
					<g:HTMLPanel styleName="{aonResources.css.aonFindingToolbar}">
						<g:HTMLPanel styleName="{aonResources.css.aonFindingToolbarItemGroup}">
						</g:HTMLPanel>
					</g:HTMLPanel>
				</g:HorizontalPanel>
			</g:FlowPanel>
		</g:north>
		
		<g:center>
			<g:HTMLPanel styleName="{aonResources.css.aonScrollArea}">
			
				<aon:DateBoxEx ui:field="entryDate" styleName="{aonResources.css.aonInputText}"/>
				<hr/>
				<cell:CellTable ui:field="detailTable"/>
				<hr/>
				<table class="{aonResources.css.aonPanelGrid} {aonResources.css.aonWidthAll}">
					<tr>
						<td class="{aonResources.css.aonPanelGridEven} {aonResources.css.aonWidthAuto}">
							<aon:AccountBox ui:field="account" />
						</td>
						<td class="{aonResources.css.aonPanelGridEven} {aonResources.css.aonWidth200}">
							<g:TextBox ui:field="concept"
								maxLength="32" visibleLength="32" 
								styleName="{aonResources.css.aonInputText}"/>
						</td>
						<td class="{aonResources.css.aonPanelGridEven} {aonResources.css.aonWidth150}">
							<aon:DoubleBox ui:field="debit"/>
						</td>
						<td class="{aonResources.css.aonPanelGridEven} {aonResources.css.aonWidth150}">
							<aon:DoubleBox ui:field="credit"/>
						</td>
						<td class="{aonResources.css.aonPanelGridEven} {aonResources.css.aonWidth200}">
							<aon:AccountBox ui:field="balAccount"/>
						</td>
					</tr>
				</table>
				<hr/>
			</g:HTMLPanel>
		</g:center>
		
		<g:south size="0">
			<aon:MinimizePanel ui:field="footPanel" styleName="{aonResources.css.aonNoPrint}">
				<g:TabLayoutPanel styleName="gwt-Selector" barHeight="26" barUnit="PX" width="100%">
					<g:tab>
						<g:header>
							<span class="aon-icon-time aon-icon-commandButton" style="padding-left: 20px;">
								Notificaciones
							</span>
						</g:header>
						<aon:ResultsPanel ui:field="resultsPanel" />
					</g:tab>
				</g:TabLayoutPanel>
			</aon:MinimizePanel>
		</g:south>
	</g:DockLayoutPanel>
</ui:UiBinder>
