<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<ui:UiBinder xmlns:ui='urn:ui:com.google.gwt.uibinder'
	xmlns:g='urn:import:com.google.gwt.user.client.ui' 
	xmlns:cell='urn:import:com.google.gwt.user.cellview.client'
	xmlns:aon='urn:import:com.esferalia.aon.gwt.common.client.widget'
	xmlns:fiscal='urn:import:com.esferalia.aon.gwt.fiscal.client.widget'
	xmlns:acc='urn:import:com.esferalia.aon.gwt.fiscal.client.accounting'>

	<ui:with type="com.esferalia.aon.gwt.common.client.i18n.CommonMessages" field="msg"></ui:with>
	<ui:with type="com.esferalia.aon.gwt.common.client.css.AonResources" field="aonResources"></ui:with>

	<g:DockLayoutPanel ui:field="dockLayoutPanel" styleName="{aonResources.css.aonSelector}">
		<g:north size="26">
			<g:FlowPanel height="100%"
				styleName="{aonResources.css.aonFindingTitleToolbar} {aonResources.css.aonWidthAll}">
				<g:HorizontalPanel>
					<g:HTMLPanel styleName="{aonResources.css.aonFindingTitle}">
						<g:HTMLPanel styleName="{aonResources.css.aonFindingTitleInternal}">
							<g:Label text="{msg.accountEntries}" />
						</g:HTMLPanel>
					</g:HTMLPanel>
					<g:HTMLPanel styleName="aon-finding-subtitle">
						<g:HTMLPanel styleName="{aonResources.css.aonFindingSubtitleIternal}">
							<g:Label></g:Label>
						</g:HTMLPanel>
					</g:HTMLPanel>
					<g:HTMLPanel styleName="{aonResources.css.aonFindingToolbar}">
						<g:HTMLPanel styleName="{aonResources.css.aonFindingToolbarItemGroup}">
							<g:Button ui:field="search" text="{msg.searchAction}" 
								styleName="{aonResources.css.aonFindingToolbarItem} {aonResources.css.aonIconSearch}" />
							<g:Button ui:field="reset" text="{msg.newAction}" 
								styleName="{aonResources.css.aonFindingToolbarItem} {aonResources.css.aonIconReset}" />
							<g:Button ui:field="accept" text="{msg.saveAction}" 
								styleName="{aonResources.css.aonFindingToolbarItem} {aonResources.css.aonIconSave}" />
							<g:Button ui:field="remove" text="{msg.deleteAction}" 
								styleName="{aonResources.css.aonFindingToolbarItem} {aonResources.css.aonIconDelete}" />
							<g:Button ui:field="audit" text="{msg.audit}" 
								styleName="{aonResources.css.aonFindingToolbarItem} {aonResources.css.aonIconAudit}" />
						</g:HTMLPanel>
					</g:HTMLPanel>
				</g:HorizontalPanel>
			</g:FlowPanel>
		</g:north>
		
		<g:center>
			<g:DockLayoutPanel ui:field="centerDockLayoutPanel">
				<g:north size="50">
					<g:HTMLPanel ui:field="entryHeader" styleName="{aonResources.css.aonScrollArea}">
						<table class="{aonResources.css.aonPanelGrid} {aonResources.css.aonWidthAll}">
							<tr>
								<td style="width: 65px;" class="{aonResources.css.aonPanelGridOdd}">
									<g:InlineLabel text="{msg.fiscalYear}"/>
								</td>
								<td style="width: 65px;" class="{aonResources.css.aonPanelGridEven}">
									<acc:AccountPeriodBox ui:field="period"/>
								</td>
								<td style="width: 65px;" class="{aonResources.css.aonPanelGridOdd}">
									<g:InlineLabel text="{msg.date}"/>
								</td>
								<td style="width: 90px;" class="{aonResources.css.aonPanelGridEven}">
									<aon:DateBoxEx ui:field="entryDate"/>
								</td>
								<td style="width: auto;" class="{aonResources.css.aonPanelGridEven} {aonResources.css.aonTextCenter}">
									<g:CheckBox ui:field="invoice" text="{msg.invoice}"/>
								</td>
								<td style="width: 200px;" class="{aonResources.css.aonPanelGridEven} {aonResources.css.aonTextCenter}">
									<g:InlineLabel ui:field="journal"/>
									<g:InlineLabel ui:field="id" styleName="{aonResources.css.aonMarginLeft}"/>
								</td>
								<td style="width: 100px;" class="{aonResources.css.aonPanelGridEven}">
									<g:ListBox ui:field="activity" visible="false" width="120px"/>
								</td>
								<td style="width: 100px;" class="{aonResources.css.aonPanelGridEven}">
									<g:CheckBox ui:field="confidential" text="{msg.confidential}"/>
								</td>
								<td style="width: 100px; text-align: right;" class="{aonResources.css.aonPanelGridEven}">
									<g:Button ui:field="commentsButton" text="{msg.comments}" 
										styleName="{aonResources.css.aonIconCommandButton}"/>
								</td>
							</tr>
						</table>
						<g:FlowPanel styleName="{aonResources.css.aonTextRight}">
							<g:InlineLabel ui:field="statusMsg"/>
						</g:FlowPanel>
					</g:HTMLPanel> 
				</g:north>	
				<g:center>
					<g:SplitLayoutPanel ui:field="splitLayoutPanel">
						<g:north size="0">
							<g:SimpleLayoutPanel ui:field="wizardPanel">
							</g:SimpleLayoutPanel>
						</g:north>
							
						<g:center>
							<g:ScrollPanel ui:field="tableContainer" styleName="{aonResources.css.aonScrollArea}"/>  
						</g:center>
						
						<g:south size="30">
							<aon:MinimizePanel ui:field="footPanel" styleName="{aonResources.css.aonSelector}">
								<g:TabLayoutPanel ui:field="tabLayout" barHeight="26" barUnit="PX" width="100%">
									<g:tab>
										<g:customHeader>
											<g:Label
												styleName="{aonResources.css.aonIconJournalLog} {aonResources.css.aonPaddingRight}"  
												text="{msg.sessionLog}" />
										</g:customHeader>
										<acc:SessionLog ui:field="sessionLog"/>
									</g:tab>
									<g:tab>
										<g:customHeader>
											<g:Label
												styleName="{aonResources.css.aonIconEuro} {aonResources.css.aonPaddingRight}" 
												text="{msg.accountBalances}" />
										</g:customHeader>
										<acc:AccountBalancePanel ui:field="balancePanel"/>
									</g:tab>
									<g:tab>
										<g:customHeader>
											<g:Label
												styleName="{aonResources.css.aonIconStatement} {aonResources.css.aonPaddingRight}"  
												text="{msg.accountStatetement}" />
										</g:customHeader>
										<acc:AccountStatementPanel ui:field="statementPanel"/>
									</g:tab>
									<g:tab>
										<g:customHeader>
											<g:Label
												styleName="{aonResources.css.aonIconJournal} {aonResources.css.aonPaddingRight}"  
												text="{msg.journalBook}" />
										</g:customHeader>
										<acc:JournalPanel ui:field="journalPanel"/>
									</g:tab>
								</g:TabLayoutPanel>
							</aon:MinimizePanel>
						</g:south>
					</g:SplitLayoutPanel>
				</g:center>
			</g:DockLayoutPanel>
		</g:center>
	</g:DockLayoutPanel>
</ui:UiBinder>
