<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<ui:UiBinder xmlns:ui='urn:ui:com.google.gwt.uibinder'
	xmlns:g='urn:import:com.google.gwt.user.client.ui' 
	xmlns:cell='urn:import:com.google.gwt.user.cellview.client'
	xmlns:aon='urn:import:com.esferalia.aon.gwt.common.client.widget'
	xmlns:fiscal='urn:import:com.esferalia.aon.gwt.fiscal.client.widget'
	xmlns:m180='urn:import:com.esferalia.aon.gwt.fiscal.client.mod180'>

	<ui:with type="com.esferalia.aon.gwt.common.client.i18n.CommonMessages" field="msg"></ui:with>
	<ui:with type="com.esferalia.aon.gwt.common.client.css.AonResources" field="aonResources"></ui:with>

	<g:SplitLayoutPanel ui:field="splitLayoutPanel">
		<g:center>
			<g:DockLayoutPanel>
				
	
		<g:north size="26">
			<g:FlowPanel ui:field="toolbarPanel" height="100%"
				styleName="aon-finding-title-toolbar aon-width-all">
				<g:HorizontalPanel>
					<g:HTMLPanel styleName="aon-finding-title">
						<g:HTMLPanel styleName="aon-finding-title-internal">
							<g:Label styleName="aon-outputText" text="{msg.invoiceReport}" />
						</g:HTMLPanel>
					</g:HTMLPanel>
					<g:HTMLPanel styleName="aon-finding-subtitle">
						<g:HTMLPanel styleName="aon-finding-subtitle-internal">
							<g:Label styleName="aon-outputText"></g:Label>
						</g:HTMLPanel>
					</g:HTMLPanel>
					<g:HTMLPanel styleName="aon-finding-toolbar">
						<g:HTMLPanel styleName="aon-finding-toolbar-item-group">
							<g:Button ui:field='generateFileButton'
								styleName="aon-finding-toolbar-item aon-icon-excel" text="{msg.export}" />
							<g:Anchor ui:field="download" visible="false"/>							
							<g:FlowPanel ui:field="formContainer">
							</g:FlowPanel>
						</g:HTMLPanel>
					</g:HTMLPanel>
				</g:HorizontalPanel>
			</g:FlowPanel>
		</g:north>
		
		<g:center>
			<g:FormPanel ui:field="diskForm">
				<g:HTMLPanel styleName="aon-scroll-area">
				 	<div class="{aonResources.css.aonGroup}">
						<div class="{aonResources.css.aonGroupTitle}">
							<g:InlineLabel text="{msg.filter}" />
						</div>
						<div class="{aonResources.css.aonGroupBody}">
							<table class="aon-panelGrid aon-width-all">
								<tr>
									<td class="aon-panelGrid-odd aon-width-200">
										<g:InlineLabel text="{msg.download}" />
									</td>
									<td class="aon-panelGrid-even aon-width-auto">
										<g:ListBox ui:field="entity"/>
									</td>
								</tr>
								<tr>
									<td class="aon-panelGrid-odd aon-width-200">
										<g:InlineLabel text="{msg.type}" />
									</td>
									<td class="aon-panelGrid-even aon-width-auto">
										<g:CheckBox ui:field="invoiceTypeSales" text="{msg.sales}"/>
										<g:CheckBox ui:field="invoiceTypePurchases" text="{msg.purchases}"/>
										<g:CheckBox ui:field="invoiceTypeExpenses" text="{msg.expenses}"/>
										<g:CheckBox ui:field="invoiceTypeUndeductible" text="{msg.undeductibleExpenses}"/>
										
										<g:CheckBox ui:field="offerStatusPending" text="{msg.pending}"/>
										<g:CheckBox ui:field="offerStatusApproved" text="{msg.approved}"/>
										<g:CheckBox ui:field="offerStatusRefused" text="{msg.refused}"/>
										<g:CheckBox ui:field="offerStatusBlocked" text="{msg.blocked}"/>
										<g:CheckBox ui:field="offerStatusInvoiced" text="{msg.invoiced}"/>
										
										<g:CheckBox ui:field="orderStatusPending" text="{msg.pending}"/>
										<g:CheckBox ui:field="orderStatusBlocked" text="{msg.blocked}"/>
										<g:CheckBox ui:field="orderStatusServed" text="{msg.served}"/>
										<g:CheckBox ui:field="orderStatusClosed" text="{msg.closed}"/>
										<g:CheckBox ui:field="orderStatusInvoiced" text="{msg.invoiced}"/>

										<g:CheckBox ui:field="deliveryStatusPending" text="{msg.pending}"/>
										<g:CheckBox ui:field="deliveryStatusInvoiced" text="{msg.invoiced}"/>

									</td>
								</tr>
										
								<tr>
									<td class="aon-panelGrid-odd">
										<g:InlineLabel text="{msg.issueDate}" />
									</td>
									<td class="aon-panelGrid-even">
										<g:InlineLabel text="{msg.from}" />
										<aon:DateBoxEx ui:field="fromDate" styleName="aon-inputText"/>
										<g:InlineLabel text="{msg.to}" />
										<aon:DateBoxEx ui:field="toDate" styleName="aon-inputText"/>
									</td>
								</tr>
							</table>
						</div>
					</div>
					<g:Hidden ui:field="domainId"/>
					<g:Hidden ui:field="domainName"/>
				</g:HTMLPanel>
			</g:FormPanel>
		</g:center>


			</g:DockLayoutPanel>	
		</g:center>
		
		<g:south size="0">
			<aon:MinimizePanel ui:field="footPanel">
				<g:TabLayoutPanel barHeight="26" barUnit="PX">
					<g:tab>
						<g:header>
							<span class="aon-icon-time aon-icon-commandButton" style="padding-left: 20px;">
								Notificaciones
							</span>
						</g:header>
						<aon:ResultsPanel ui:field="resultsPanel" />
					</g:tab>
				</g:TabLayoutPanel>
			</aon:MinimizePanel>
		</g:south>
	</g:SplitLayoutPanel>
</ui:UiBinder>
