<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<ui:UiBinder xmlns:ui='urn:ui:com.google.gwt.uibinder'
	xmlns:g='urn:import:com.google.gwt.user.client.ui' 
	xmlns:aon='urn:import:com.esferalia.aon.gwt.common.client.widget'
	xmlns:fiscal='urn:import:com.esferalia.aon.gwt.fiscal.client.widget'
	xmlns:cell='urn:import:com.google.gwt.user.cellview.client'>

	<ui:with type="com.esferalia.aon.gwt.common.client.i18n.CommonMessages" field="msg"></ui:with>
	<ui:with type="com.esferalia.aon.gwt.common.client.css.AonResources" field="aonResources"></ui:with>

	<g:ScrollPanel styleName="{aonResources.css.aonScrollArea}">
		<g:HTMLPanel styleName="{aonResources.css.aonFiscalContainer}">
			<g:HTMLPanel ui:field="basePanel" styleName="aon-width-all">
				<table class="{aonResources.css.aonWidthAll}">
					<tr>
						<td>
							<div class="{aonResources.css.aonGroup}">
								<div class="{aonResources.css.aonGroupTitle}">
									<g:InlineLabel text="{msg.identification}"/>
								</div>
								<div class="{aonResources.css.aonGroupBody}">
									<table class="{aonResources.css.aonWidthAll}">
										<tr>
											<td>
												<g:Label text="{msg.nif}" styleName="{aonResources.css.aonInnerLabel}"/>
												<aon:DocumentTextBox ui:field="nif" visibleLength="9" maxLength="9"/>
											</td>
											<td>
												<g:CheckBox ui:field="IDA01011" text="SA" value="false"/>
												<g:CheckBox ui:field="IDA01012" text="SL" value="false"/>
												<g:Label text="Otras" styleName="{aonResources.css.aonInnerLabel}"/>
												<g:TextBox ui:field="IDA01013"  visibleLength="42" maxLength="40" styleName="aon-inputText"/>
											</td>
									
										</tr>
										<tr>
											<td>
												<g:Label text="{msg.companyName}" styleName="{aonResources.css.aonInnerLabel}"/>
												<g:TextBox ui:field="companyName" visibleLength="30" maxLength="55"
													styleName="{aonResources.css.aonInputText}" />
											</td>
											<td>
												<g:Label text="Domicilio Social" styleName="{aonResources.css.aonInnerLabel}"/>
												<g:TextBox ui:field="companyPlace" visibleLength="30" maxLength="55"
													styleName="{aonResources.css.aonInputText}" />
											</td>
											
										</tr>
									</table>
								</div>
							</div>
						</td>
					</tr>
					
				</table>
				<g:FlexTable ui:field="table" styleName="{aonResources.css.aonWidthAll} {aonResources.css.aonMarginTop}"/>
			</g:HTMLPanel>
		</g:HTMLPanel>
	</g:ScrollPanel>

</ui:UiBinder>
