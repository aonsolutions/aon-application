<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<ui:UiBinder xmlns:ui='urn:ui:com.google.gwt.uibinder'
	xmlns:g='urn:import:com.google.gwt.user.client.ui'
    xmlns:aon='urn:import:com.esferalia.aon.gwt.common.client.widget'>

	<ui:with type="com.esferalia.aon.gwt.common.client.i18n.CommonMessages" field="msg"></ui:with>
	<ui:with type="com.esferalia.aon.gwt.common.client.css.AonResources" field="aonResources"></ui:with>

	<ui:style>
	.inner-label {
		font-size: 1.5em;
		color: red;
		margin-left: 5px;
		margin-right: 5px;
		padding: 10px;
		border: solid red 1px;
		text-align: center;
	}
	.headerPanel {
		text-align: center;
		border: solid black 1px;
	}
	.header {
		font-size: 1.5em;
		margin-left: 5px;
		margin-right: 5px;
		padding: 2px;
		text-align: center;
	}
	.sub-header {
		font-size: 0.8em;
		margin-left: 5px;
		margin-right: 5px;
		padding: 2px;
		text-align: center;
	}
	.text-center {
		text-align: center;
	}
	</ui:style>
	
	<g:FlowPanel>
		<g:HTMLPanel styleName="{style.headerPanel}">
			<g:Label styleName="{style.header}" ui:field="title1" />
			<g:Label styleName="{style.sub-header}" ui:field="title2" />
		</g:HTMLPanel>
		<g:HTMLPanel styleName="{style.text-center}">
			<g:TextArea visibleLines="150" characterWidth="150" ui:field="value" />
		</g:HTMLPanel>
	</g:FlowPanel>
	
</ui:UiBinder>
