<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<ui:UiBinder xmlns:ui='urn:ui:com.google.gwt.uibinder'
	xmlns:g='urn:import:com.google.gwt.user.client.ui'
    xmlns:aon='urn:import:com.esferalia.aon.gwt.common.client.widget'>

	<ui:with type="com.esferalia.aon.gwt.common.client.i18n.CommonMessages" field="msg"></ui:with>
	<ui:with type="com.esferalia.aon.gwt.common.client.css.AonResources" field="aonResources"></ui:with>

	<ui:style>
	.inner-label {
		font-size: 1.5em;
		color: red;
		margin-left: 5px;
		margin-right: 5px;
		padding: 10px;
		border: solid red 1px;
		text-align: center;
	}
	.headerPanel {
		text-align: center;
		border: solid black 1px;
	}
	.header {
		font-size: 1.5em;
		margin-left: 5px;
		margin-right: 5px;
		padding: 2px;
		text-align: center;
	}
	.sub-header {
		font-size: 0.8em;
		margin-left: 5px;
		margin-right: 5px;
		padding: 2px;
		text-align: center;
	}
	.text-center {
		text-align: center;
	}
	.textArea-border{
		
		border: 0px !important;
	}
	</ui:style>
	
	<g:HTMLPanel>
		<g:Label ui:field="title2" styleName="{aonResources.css.aonPageHeader}"/>
		

		<table style="margin-top: 10px;" class="{aonResources.css.aonDataTable}">
			<tr>
				<td>
					<g:Label ui:field="title1" styleName="{aonResources.css.aonPageHeader}"/>
				</td>
			</tr>
			<tr>
				<td>
					<g:TextArea visibleLines="150" characterWidth="128" styleName="{style.textArea-border}" ui:field="value" />
				</td>
			</tr>
		</table>


	
	</g:HTMLPanel>
	
</ui:UiBinder>
