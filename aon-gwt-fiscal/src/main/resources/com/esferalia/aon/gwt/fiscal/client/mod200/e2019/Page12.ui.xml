<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
	xmlns:g="urn:import:com.google.gwt.user.client.ui">

	<ui:with type="com.esferalia.aon.gwt.common.client.i18n.CommonMessages" field="msg"></ui:with>
	<ui:with type="com.esferalia.aon.gwt.common.client.css.AonResources" field="aonResources"></ui:with>

	<g:ScrollPanel styleName="{aonResources.css.aonScrollArea}">
		<g:HTMLPanel ui:field="basePanel" styleName="{aonResources.css.aonFiscalContainer}">
			<g:SimplePanel ui:field="headerPanel"/>
		 	<div class="{aonResources.css.aonGroup}">
				<div class="{aonResources.css.aonGroupTitle}">
					<g:InlineLabel text="{msg.yearQuota}" />
				</div>
				<div class="{aonResources.css.aonGroupBody}">
					<g:FlexTable ui:field="table"/>
				</div>
			</div>
			
			<div>
			    <table class="{aonResources.css.aonWidthAll}">
					<tr>
						<td style="width:auto;">
						</td>
						<td style="width:190px;">
							<g:Label text="Total (Estado+DF/N)" styleName="{aonResources.css.aonTextCenter} {aonResources.css.aonBold} {aonResources.css.aonFiscalBorderBottom}"/>
						</td>
						<td style="width:190px;">
							<g:Label text="Estado" styleName="{aonResources.css.aonTextCenter} {aonResources.css.aonBold} {aonResources.css.aonFiscalBorderBottom}"/>
						</td>
						<td style="width:190px;">
							<g:Label text="D.Forales/Navarra (totales)" styleName="{aonResources.css.aonTextCenter} {aonResources.css.aonBold} {aonResources.css.aonFiscalBorderBottom}"/>
						</td>
					</tr>
				</table>					
			</div>
			
		 	<div class="{aonResources.css.aonGroup}">
				<div class="{aonResources.css.aonGroupTitle}">
					<g:InlineLabel text="{msg.splittedPayments}" />
				</div>
				<div class="{aonResources.css.aonGroupBody}">
					<g:FlexTable ui:field="table1"/>
				</div>
			</div>
		 	<div class="{aonResources.css.aonGroup}">
				<div class="{aonResources.css.aonGroupTitle}">
					<g:InlineLabel text="{msg.yearQuota}" />
				</div>
				<div class="{aonResources.css.aonGroupBody}">
					<g:FlexTable ui:field="table2"/>
				</div>
			</div>
		 	<div class="{aonResources.css.aonGroup}">
				<div class="{aonResources.css.aonGroupTitle}">
					<g:InlineLabel text="{msg.netQuota}" />
				</div>
				<div class="{aonResources.css.aonGroupBody}">
					<g:FlexTable ui:field="table3"/>
				</div>
				<div class="{aonResources.css.aonGroupBody}">
					<g:FlexTable ui:field="table4"/>
				</div>
			</div>
		</g:HTMLPanel>
	</g:ScrollPanel>
</ui:UiBinder>
