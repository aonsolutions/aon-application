<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
	xmlns:g="urn:import:com.google.gwt.user.client.ui" 
	xmlns:aon="urn:import:com.esferalia.aon.gwt.common.client.widget"
	xmlns:cell="urn:import:com.google.gwt.user.cellview.client">

	<ui:with type="com.esferalia.aon.gwt.common.client.i18n.CommonMessages" field="msg"></ui:with>
	<ui:with type="com.esferalia.aon.gwt.common.client.css.AonResources" field="aonResources"></ui:with>

	<g:ScrollPanel styleName="{aonResources.css.aonScrollArea}">
		<g:HTMLPanel styleName="{aonResources.css.aonFiscalContainer}">
			<g:SimplePanel ui:field="headerPanel"/>
			<g:HTMLPanel ui:field="basePanel" styleName="{aonResources.css.aonWidthAll}">
				<div class="{aonResources.css.aonGroup}">
					<div class="{aonResources.css.aonGroupTitle}">
						<g:InlineLabel text="{msg.participationsOut}" />
					</div>
					<div class="{aonResources.css.aonGroupBody}">
						<cell:CellTable ui:field="tableOut"/>
						<g:Button ui:field="newParticipationOut"
							styleName="{aonResources.css.aonIconReset} {aonResources.css.aonBorderNone} {aonResources.css.aonMarginTop}">
							&#160;
						</g:Button>
						<br/>
						<div class="{aonResources.css.aonGroup} {aonResources.css.aonMarginTop}">
							<div class="{aonResources.css.aonGroupTitle}">
								<g:InlineLabel text="{msg.totals}" />
							</div>
							<div class="{aonResources.css.aonGroupBody}">	
								<g:FlexTable ui:field="table" styleName="{aonResources.css.aonWidthAll}"/>
							</div>
						</div>
					</div> 
				</div>				
				<div class="{aonResources.css.aonGroup} {aonResources.css.aonMarginTop}">
					<div class="{aonResources.css.aonGroupTitle}">
						<g:InlineLabel text="{msg.participationsIn}" />
					</div>
					<div class="{aonResources.css.aonGroupBody}">
						<cell:CellTable ui:field="tableIn"/>
						<g:Button ui:field="newParticipationIn"
							styleName="{aonResources.css.aonIconReset} {aonResources.css.aonBorderNone} {aonResources.css.aonMarginTop}">
							&#160;
						</g:Button>
					</div>
				</div>
				<g:FlexTable ui:field="table1" styleName="{aonResources.css.aonWidthAll}"/>
				<br/>
				<div class="{aonResources.css.aonGroup} {aonResources.css.aonMarginTop}">
					<div class="{aonResources.css.aonGroupTitle}">
						<g:InlineLabel text="{msg.minorEntities}" />
					</div>
					<div class="{aonResources.css.aonGroupBody}">
						<cell:CellTable ui:field="tableMinor"/>
						<g:Button ui:field="newMinor"
							styleName="{aonResources.css.aonIconReset} {aonResources.css.aonBorderNone} {aonResources.css.aonMarginTop}">
							&#160;
						</g:Button>
					</div>
				</div>
			</g:HTMLPanel>
		</g:HTMLPanel>
	</g:ScrollPanel>
</ui:UiBinder>
