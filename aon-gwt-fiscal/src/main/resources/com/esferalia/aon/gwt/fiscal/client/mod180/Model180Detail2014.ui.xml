<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
	xmlns:g="urn:import:com.google.gwt.user.client.ui" 
	xmlns:aon="urn:import:com.esferalia.aon.gwt.common.client.widget"
	xmlns:cell="urn:import:com.google.gwt.user.cellview.client">
	
	<ui:with type="com.esferalia.aon.gwt.common.client.i18n.CommonMessages" field="msg"></ui:with>
	<ui:with type="com.esferalia.aon.gwt.common.client.css.AonResources" field="aonResources"></ui:with>
	
	<g:DockLayoutPanel>
		<g:north size="26">
			<g:FlowPanel height="100%" styleName="{aonResources.css.aonFindingTitleToolbar} {aonResources.css.aonWidthAll}">
				<g:HorizontalPanel>
					<g:HTMLPanel styleName="{aonResources.css.aonFindingTitle}">
						<g:HTMLPanel styleName="{aonResources.css.aonFindingTitleInternal}">
							<g:Label text="{msg.receiverList}" />
						</g:HTMLPanel>
					</g:HTMLPanel>
					<g:HTMLPanel>
						<g:HTMLPanel styleName="{aonResources.css.aonFindingSubtitleIternal}">
							<g:Label/>
						</g:HTMLPanel>
					</g:HTMLPanel>
					<g:HTMLPanel styleName="{aonResources.css.aonFindingToolbar}">
						<g:HTMLPanel styleName="{aonResources.css.aonFindingToolbarItemGroup}">
							<g:Button ui:field="newDetailButton" text="{msg.newPerceptor}"
								styleName="{aonResources.css.aonFindingToolbarItem} {aonResources.css.aonIconReset}"/>
							<g:Button ui:field="deleteDetailButton" text="{msg.deleteAction}" 
								styleName="{aonResources.css.aonFindingToolbarItem} {aonResources.css.aonIconDelete}"/>
							<g:Button ui:field="restoreDeletedButton" text="{msg.restoreAction}"
								styleName="{aonResources.css.aonFindingToolbarItem} {aonResources.css.aonIconRedo}"/>
						</g:HTMLPanel>
					</g:HTMLPanel>
				</g:HorizontalPanel>
			</g:FlowPanel>
		</g:north>
		<g:west size="300">
			<g:ScrollPanel ui:field="detailListPanel" styleName="{aonResources.css.aonScrollArea}">
				<cell:CellList ui:field="detailList" />
			</g:ScrollPanel>
				 <!-- 
			<g:SimpleLayoutPanel styleName="{aonResources.css.aonPadding}">
				<aon:ShowMorePagerPanel styleName="{aonResources.css.aonWidthAll} {aonResources.css.aonHeightAll}" 
					ui:field="pagerPanel" />
			</g:SimpleLayoutPanel>
				-->
		</g:west>
		<g:center>
			<g:ScrollPanel styleName="{aonResources.css.aonWidthAll}">
				<g:FlowPanel styleName="{aonResources.css.aonScrollArea}">
				<g:HTMLPanel styleName="{aonResources.css.aonMarginTop}">
					<table class="{aonResources.css.aonWidthAll} {aonResources.css.aonNowrap}">
						<tr>
							<td class="{aonResources.css.aonBorderBottom} {aonResources.css.aonBold}" colspan="4">
								<g:InlineLabel text="{msg.perceptionData}" />
							</td>
						</tr>
						<tr>
							<td class="{aonResources.css.aonFontMedium} {aonResources.css.aonWidth100}">
								<g:InlineLabel text="{msg.receiverDocument}" />
							</td>
							<td class="{aonResources.css.aonFontMedium} {aonResources.css.aonWidth100}">
								<g:InlineLabel text="{msg.representativeDocument}" />
							</td>
							<td class="{aonResources.css.aonFontMedium} {aonResources.css.aonWidth300}">
								<g:InlineLabel text="{msg.fullName}" />
							</td>
							<td class="{aonResources.css.aonFontMedium} {aonResources.css.aonWidthAuto}">
								<g:InlineLabel text="{msg.province}" />
							</td>
						</tr>
						<tr>
							<td>
								<aon:DocumentTextBox ui:field="receiverDocument"/>
							</td>
							<td>
								<aon:DocumentTextBox ui:field="representativeDocument"/>
							</td>
							<td>
								<g:TextBox ui:field="fullName" maxLength="40" visibleLength="40"
									styleName="{aonResources.css.aonInputText}"/>
							</td>
							<td>
								<aon:ProvinceListBox ui:field="province"/>
							</td>
						</tr>
					</table>
		
					<table class="{aonResources.css.aonWidthAll} {aonResources.css.aonNowrap}">
						<tr>
							<td class="{aonResources.css.aonFontMedium} {aonResources.css.aonWidth100}">
							</td>
							<td class="{aonResources.css.aonFontMedium} {aonResources.css.aonWidth100}">
								<g:InlineLabel text="{msg.perception}" />
							</td>
							<td class="{aonResources.css.aonFontMedium} {aonResources.css.aonWidth100}">
								<g:InlineLabel text="{msg.percent}" />
							</td>
							<td class="{aonResources.css.aonFontMedium} {aonResources.css.aonWidth100}">
							 	<g:InlineLabel text="{msg.retention}" />
							</td>
							<td class="{aonResources.css.aonFontMedium} {aonResources.css.aonWidthAuto}">
								<g:InlineLabel text="{msg.accrualYear}" />
							</td>
						</tr>
						<tr>
							<td>
								<g:CheckBox ui:field="inKind" text="{msg.inKind}" />
							</td>
							<td>
								<aon:DoubleBox ui:field="perception"/>
							</td>
							<td>
								<aon:DoubleBox ui:field="percent"/>
							</td>
							<td>
								<aon:DoubleBox ui:field="retention"/>
							</td>
							<td>
								<aon:IntegerBox maxLength="4" visibleLength="4" ui:field="accrualYear"/>
							</td>
						</tr>
					</table>
				</g:HTMLPanel>
				
				<g:HTMLPanel styleName="{aonResources.css.aonMarginTop}">
					<table class="{aonResources.css.aonWidthAll} {aonResources.css.aonNowrap}">
						<tr>
							<td class="{aonResources.css.aonBorderBottom} {aonResources.css.aonBold}" colspan="2">
								<g:InlineLabel text="{msg.buildingData}" />
							</td>
						</tr>
						<tr>
							<td class="{aonResources.css.aonFontMedium} {aonResources.css.aonWidth300}">
								<g:Label text="{msg.buildingLocation}" />
							</td>
							<td class="{aonResources.css.aonFontMedium} {aonResources.css.aonWidthAuto}">
								<g:Label text="{msg.cadasdralReference}" />
							</td>
						</tr>
						<tr>
							<td>
								<g:ListBox ui:field="location" styleName="{aonResources.css.aonInputText}"/>
							</td>
							<td>
								<g:TextBox ui:field="cadasdralReference" maxLength="20" visibleLength="23" 
									styleName="{aonResources.css.aonInputText}"/>
							</td>
						</tr>
					</table>
		
					<table class="{aonResources.css.aonWidthAll}">
						<tr>
							<td class="{aonResources.css.aonFontMedium} {aonResources.css.aonWidth150}">
								<g:Label text="{msg.streetType}" />
							</td>
							<td class="{aonResources.css.aonFontMedium} {aonResources.css.aonWidthAuto}">
								<g:Label text="{msg.streetName}" />
							</td>
						</tr>
						<tr>
							<td>
								<aon:StreetTypeListBox ui:field="streetType" 
									styleName="{aonResources.css.aonInputText}"/>
							</td>
							<td>
								<g:TextBox ui:field="streetName" maxLength="50" visibleLength="30" 
									styleName="{aonResources.css.aonInputText}"/>
							</td>
						</tr>
					</table>
		
					<table class="{aonResources.css.aonWidthAll}">
						<tr>
							<td class="{aonResources.css.aonFontMedium} {aonResources.css.aonWidth70}">
								<g:Label text="{msg.streetNumberType}" />
							</td>
							<td class="{aonResources.css.aonFontMedium} {aonResources.css.aonWidth60}">
								<g:Label text="{msg.streetNumber}" />
							</td>
							<td class="{aonResources.css.aonFontMedium} {aonResources.css.aonWidth60}">
								<g:Label text="{msg.streetNumberSuffix}" />
							</td>
							<td class="{aonResources.css.aonFontMedium} {aonResources.css.aonWidth60}">
								<g:Label text="{msg.streetBlock}" />
							</td>
							<td class="{aonResources.css.aonFontMedium} {aonResources.css.aonWidth60}">
								<g:Label text="{msg.streetHall}" />
							</td>
							<td class="{aonResources.css.aonFontMedium} {aonResources.css.aonWidth60}">
								<g:Label text="{msg.streetStair}" />
							</td>
							<td class="{aonResources.css.aonFontMedium} {aonResources.css.aonWidth60}">
								<g:Label text="{msg.streetFloor}" />
							</td>
							<td class="{aonResources.css.aonFontMedium} {aonResources.css.aonWidth60}">
								<g:Label text="{msg.streetDoor}" />
							</td>
							<td class="{aonResources.css.aonFontMedium} {aonResources.css.aonWidthAuto}">
								<g:Label text="{msg.streetComplement}" />
							</td>
						</tr>
						<tr>
							<td>
								<g:TextBox ui:field="numberType" maxLength="3" visibleLength="3" 
									styleName="{aonResources.css.aonInputText}"/>
							</td>
							<td>
								<g:TextBox ui:field="number" maxLength="5" visibleLength="5" 
									styleName="{aonResources.css.aonInputText}"/>
							</td>
							<td>
								<g:TextBox ui:field="numberSuffix" maxLength="3" visibleLength="3" 
									styleName="{aonResources.css.aonInputText}"/>
							</td>
							<td>
								<g:TextBox ui:field="block" maxLength="3" visibleLength="3" 
									styleName="{aonResources.css.aonInputText}"/>
							</td>
							<td>
								<g:TextBox ui:field="hall" maxLength="3" visibleLength="3" 
									styleName="{aonResources.css.aonInputText}"/>
							</td>
							<td>
								<g:TextBox ui:field="stair" maxLength="3" visibleLength="3" 
									styleName="{aonResources.css.aonInputText}"/>
							</td>
							<td>
								<g:TextBox ui:field="floor" maxLength="3" visibleLength="3" 
									styleName="{aonResources.css.aonInputText}"/>
							</td>
							<td>
								<g:TextBox ui:field="door" maxLength="3" visibleLength="3" 
									styleName="{aonResources.css.aonInputText}"/>
							</td>
							<td>
								<g:TextBox ui:field="complement" maxLength="40" visibleLength="20" 
									styleName="{aonResources.css.aonInputText}"/>
							</td>
						</tr>
					</table>
		
					<table class="{aonResources.css.aonWidthAll}">
						<tr>
							<td class="{aonResources.css.aonFontMedium} {aonResources.css.aonWidth150}">
								<g:Label text="{msg.city}" />
							</td>
							<td class="{aonResources.css.aonFontMedium} {aonResources.css.aonWidth150}">
								<g:Label text="{msg.town}" />
							</td>
							<td class="{aonResources.css.aonFontMedium} {aonResources.css.aonWidth100}">
								<g:Label text="{msg.townCode}" />
							</td>
							<td class="{aonResources.css.aonFontMedium} {aonResources.css.aonWidth150}">
								<g:Label text="{msg.province}" />
							</td>
							<td class="{aonResources.css.aonFontMedium} {aonResources.css.aonWidthAuto}">
								<g:Label text="{msg.zip}" />
							</td>
						</tr>
						<tr>
							<td>
								<g:TextBox ui:field="city" maxLength="30" visibleLength="20" 
									styleName="{aonResources.css.aonInputText}"/>
							</td>
							<td>
								<g:TextBox ui:field="town" maxLength="30" visibleLength="20" 
									styleName="{aonResources.css.aonInputText}"/>
							</td>
							<td>
								<g:TextBox ui:field="townCode" maxLength="5" visibleLength="5" 
									styleName="{aonResources.css.aonInputText}"/>
								<a href="http://www.ine.es/daco/daco42/codmun/codmunmapa.htm"
									target="_blank" style="padding-left: 18px;"
									class="aon-button-goto">&#160;
								</a>
							</td>
							<td>
								<aon:ProvinceListBox ui:field="provinceCode"/> 
							</td>
							<td>
								<g:TextBox ui:field="zip" maxLength="5" visibleLength="5" 
									styleName="{aonResources.css.aonInputText}"/>
							</td>
						</tr>
					</table>
				</g:HTMLPanel>
				</g:FlowPanel>
			</g:ScrollPanel>
		</g:center>
		
	</g:DockLayoutPanel>
</ui:UiBinder>
