<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<ui:UiBinder xmlns:ui='urn:ui:com.google.gwt.uibinder'
	xmlns:g='urn:import:com.google.gwt.user.client.ui' 
	xmlns:aon='urn:import:com.esferalia.aon.gwt.common.client.widget'>

	<ui:with type="com.esferalia.aon.gwt.common.client.i18n.CommonMessages" field="msg"></ui:with>
	<ui:with type="com.esferalia.aon.gwt.common.client.css.AonResources" field="aonResources"></ui:with>

	<g:HTMLPanel styleName="{aonResources.css.aonMod200Container}">
		<g:HTMLPanel ui:field="basePanel" styleName="aon-width-all">
			<table class="aon-width-all aon-margin-bottom">
				<tr>
					<td>
						<div class="{aonResources.css.aonGroup}">
							<div class="{aonResources.css.aonGroupTitle}">
								<g:InlineLabel text="{msg.identification}"/>
							</div>
							<div class="{aonResources.css.aonGroupBody}">
								<table class="aon-width-all">
									<colgroup>
										<col width="125px"/>
										<col width="150px"/>
										<col width="250px"/>
										<col width="auto"/>
										<col width="125px"/>
										<col width="150px"/>
										<col width="125px"/>
										<col width="150px"/>
									</colgroup>
									<tbody>
										<tr>
											<td>
												<g:Label text="{msg.nif}"/>
											</td>
											<td>
												<aon:DocumentTextBox ui:field="nif" visibleLength="9" maxLength="9"/>
											</td>
											<td>
												<g:Label text="{msg.companyName}"/>
											</td>
											<td>
												<g:TextBox ui:field="companyName" visibleLength="30" maxLength="55"/>
											</td>
											<td>
												<g:Label text="{msg.phone} 1"/>
											</td>
											<td>
												<g:TextBox ui:field="phone1" visibleLength="9" maxLength="9"/>
											</td>
											<td>
												<g:Label text="{msg.phone} 2"/>
											</td>
											<td>
												<g:TextBox ui:field="phone2" visibleLength="9" maxLength="9"/>
											</td>
										</tr>
									</tbody>								
								</table>
							</div>
						</div>
					</td>
				</tr>
				<tr>
					<td>
						<div class="{aonResources.css.aonGroup}">
							<div class="{aonResources.css.aonGroupTitle}">
								<g:InlineLabel text="{msg.declarationType}"/>
							</div>
							<div class="{aonResources.css.aonGroupBody}">
								<table class="aon-width-all">
									<colgroup>
										<col width="150px"/>
										<col width="250px"/>
										<col width="150px"/>
										<col width="auto"/>
									</colgroup>
									<tr>
										<td>
											<div>
												<g:InlineLabel text="{msg.periodType}"/>
											</div>
										</td>
										<td colspan="3">
											<g:ListBox ui:field="periodType"/>
										</td>
									</tr>
									<tr>
										<td>
										</td>
										<td colspan="3">
											<g:FlowPanel ui:field="periodPanel" styleName="{aonResources.css.aonMarginLeft}">
												<g:InlineLabel text="{msg.periodLabel}"/>
												<aon:DateBoxEx ui:field="periodStart"/>
												<g:InlineLabel text="{msg.to}"/>
												<aon:DateBoxEx ui:field="periodEnd"/>
											</g:FlowPanel>
										</td>
									</tr>
									<tr>
										<td>
											<g:InlineLabel text="{msg.mainActivityCNAE}"/>
										</td>
										<td colspan="3">
											<div>
												<g:TextBox ui:field="cnae" visibleLength="6" maxLength="6"/>
												<g:Button ui:field="showCnae"
													styleName="aon-icon-lookup {aonResources.css.aonBorderNone}">
													&#160;
												</g:Button>
												<g:InlineLabel ui:field="cnaeLabel" styleName="{aonResources.css.aonMarginLeft}"/>
											</div>
										</td>
									</tr>
									<tr>
										<td>
											<g:Label text="{msg.balanceSheet} {msg.ecpn}"/>
										</td>
										<td>
											<g:ListBox ui:field="balanceSheetType" visibleItemCount="1">
												<g:item value="0">Modalidad Normal</g:item>
												<g:item value="1">Modalidad Abreviada</g:item>
												<g:item value="2">Modalidad PYMES</g:item>
											</g:ListBox>
										</td>
										<td>
											<g:Label text="{msg.profitAndLoss}"/>
										</td>
										<td>
											<g:ListBox ui:field="profitAndLossType" visibleItemCount="1">
												<g:item value="0">Modalidad Normal</g:item>
												<g:item value="1">Modalidad Abreviada</g:item>
												<g:item value="2">Modalidad PYMES</g:item>
											</g:ListBox>
										</td>
									</tr>
									<tr>
										<td>
										</td>
										<td colspan="3">
											<g:CheckBox ui:field="c061"/>
										</td>
									</tr>
									<tr>
										<td>
											<g:Label text="{msg.fixedPersonal}"/>
										</td>
										<td>
											<aon:DoubleTextBox ui:field="c041"/>
										</td>
										<td>
											<g:Label text="{msg.nonFixedPersonal}"/>
										</td>
										<td>
											<aon:DoubleTextBox ui:field="c042"/>
										</td>
									</tr>
								</table>
							</div>
						</div>
					</td>
				</tr>
				<tr>
					<td>
						<div class="{aonResources.css.aonGroup}">
							<div class="{aonResources.css.aonGroupTitle}">
								<g:InlineLabel text="{msg.declarationType}"/>
							</div>
							<div class="{aonResources.css.aonGroupBody}">
								<g:FlexTable ui:field="charactersTable1" styleName="aon-width-all"/>
							</div>
						</div>
					</td>
				</tr>
				<tr>
					<td>
						<div class="{aonResources.css.aonGroup}">
							<div class="{aonResources.css.aonGroupTitle}">
								<g:InlineLabel text="{msg.availableRegimes}"/>
							</div>
							<div class="{aonResources.css.aonGroupBody}">
								<g:FlexTable ui:field="charactersTable2" styleName="aon-width-all"/>
							</div>
						</div>
					</td>
				</tr>
				<tr>
					<td>
						<div class="{aonResources.css.aonGroup}">
							<div class="{aonResources.css.aonGroupTitle}">
								<g:InlineLabel text="{msg.otherCharacters}"/>
							</div>
							<div class="{aonResources.css.aonGroupBody}">
								<g:FlexTable ui:field="charactersTable3" styleName="aon-width-all"/>
							</div>
						</div>
					</td>
				</tr>
			</table>
			<g:FlexTable ui:field="table" styleName="aon-width-all"/>
			<aon:CnaePanel ui:field="cnaePanel" />
		</g:HTMLPanel>
	</g:HTMLPanel>
</ui:UiBinder>
