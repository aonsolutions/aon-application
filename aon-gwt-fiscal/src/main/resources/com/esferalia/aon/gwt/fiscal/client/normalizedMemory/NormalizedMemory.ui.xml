<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<ui:UiBinder xmlns:ui='urn:ui:com.google.gwt.uibinder'
	xmlns:g='urn:import:com.google.gwt.user.client.ui' 
	xmlns:aon='urn:import:com.esferalia.aon.gwt.fiscal.client.widget'
	xmlns:m390='urn:import:com.esferalia.aon.gwt.fiscal.client.mod390'
	xmlns:cell='urn:import:com.google.gwt.user.cellview.client'>

	<ui:with type="com.esferalia.aon.gwt.common.client.i18n.CommonMessages" field="msg"></ui:with>
	<ui:with type="com.esferalia.aon.gwt.common.client.css.AonResources" field="aonResources"></ui:with>

	<ui:style>
		.linkPanel {
			padding: 0px 0px 1.5em 0;
			margin-left: 1.5em;
			border: solid #CCC 1px;
			background-color: #EEE;
		}
		.linkSubPanel {
			padding: 0px 0px 0px 3em;
		}
		.linkContainer {
			width: 100%;
			height: 100%;
		}
		.linkItemHeader{
			padding-top: 5px;
			cursor: pointer;
			border: none;
		}
		.linkItem{
			padding-top: 5px;
			cursor: pointer;
			border: none;
		}
		.linkItem:hover{
			background-color: #DDD;
		}
		.linkItemSelected {
			background-color: #CCC;
			font-weight: bold;
		}
		.linkHeader{
			/*width: 100%;*/
			margin-left: 15px;
			/*white-space: nowrap;*/
			border: solid #BBB 2px;
			/*background-color: #CCC;*/
		}
		.linkNumber{
			border-top: solid #CCC .5px;
			border-left: solid #BBB 2px;
			border-bottom: solid #BBB 2px;
			width: 20px;
			margin-left: 10px;
			text-align: center;
		}
		.linkDescription{
			padding-left: 15px;
			/*white-space: nowrap;*/
		}
		
	</ui:style>

	<g:DockLayoutPanel ui:field="dockLayoutPanel">
		<g:north size="26">
			<g:FlowPanel ui:field="toolbarPanel" height="100%"
				styleName="aon-finding-title-toolbar aon-width-all">
				<g:HorizontalPanel>
					<g:HTMLPanel styleName="aon-finding-title">
						<g:HTMLPanel styleName="aon-finding-title-internal">
							<g:Label styleName="aon-outputText" text="Memoria normalizada" />
						</g:HTMLPanel>
					</g:HTMLPanel>
					<g:HTMLPanel styleName="aon-finding-subtitle">
						<g:HTMLPanel styleName="aon-finding-subtitle-internal">
							<g:Label styleName="aon-outputText"></g:Label>
						</g:HTMLPanel>
					</g:HTMLPanel>
					<g:HorizontalPanel styleName="aon-finding-toolbar">
						<g:HTMLPanel styleName="aon-finding-toolbar-item-group">
							<g:Button ui:field='newButton'
								styleName='aon-finding-toolbar-item aon-icon-reset' text="{msg.newAction}" />
							<g:Button ui:field='saveButton'
								styleName='aon-finding-toolbar-item aon-icon-accept' text="{msg.saveAction}" />
							<g:Button ui:field='cancelButton'
								styleName='aon-finding-toolbar-item aon-icon-cancel' text="{msg.cancelAction}" />
							<g:Button ui:field='deleteButton'
								styleName='aon-finding-toolbar-item aon-icon-delete' text="{msg.deleteAction}" />
							<g:Button ui:field='generateFileButton'
								styleName='aon-finding-toolbar-item aon-icon-aeat' text="Exportar" />
							<g:Anchor ui:field="download" visible="false"/>							
						</g:HTMLPanel>
						<g:FlowPanel ui:field="formContainer">
						</g:FlowPanel>
					</g:HorizontalPanel>
				</g:HorizontalPanel>
			</g:FlowPanel>
		</g:north>
		
		<g:center>
			
			<g:DockLayoutPanel unit="PX">
				
				<g:north size="75">
					<g:HTMLPanel styleName="aon-scroll-area">
					
						<table class="aon-panelGrid aon-margin-top aon-width-all">
							<colgroup>
								<col style="width: 100px;" />
								<col style="width: 75px;" />
								<col style="width: 100px;" />
								<col style="width: 150px;" />
								<col style="width: auto;" />
							</colgroup>
							<tr>
								<td class="aon-panelGrid-odd">
									<g:Label text="Tipo de depósito" />
								</td>
								<td class="aon-panelGrid-even">
									<g:TextBox ui:field="type"></g:TextBox>
								</td>   
								<td class="aon-panelGrid-odd">
									<g:Label text="Cumplimentar memoria normalizada" />
								</td>
								<td class="aon-panelGrid-even">
									<g:CheckBox ui:field="normalizedCheck" />
								</td>  
								<td class="aon-panelGrid-odd">
									<g:Label text="Importar" />
								</td>
								<td class="aon-panelGrid-even">
									<!--  
									<g:FormPanel ui:field="fileUploadForm">
										<g:Button ui:field="uploadButton" />
									
										<g:FileUpload ui:field="fileUpload" name="file"/>
									</g:FormPanel>
									-->
										<g:FileUpload ui:field="fileUpload" name="file"/>
								</td>  
							</tr>
							<tr>
								<td class="aon-panelGrid-odd">
									<g:Label text="Nombre del depósito" />
								</td>
								<td class="aon-panelGrid-even">
									<g:TextBox ui:field="name"></g:TextBox>
								</td>   
								<td class="aon-panelGrid-odd">
									<g:Label text="CIF" />
								</td>
								<td class="aon-panelGrid-even">
									<g:TextBox ui:field="cif"></g:TextBox>
								</td>   
								<td class="aon-panelGrid-odd">
									<g:Label text="Ejercicio" />
								</td>
								<td class="aon-panelGrid-even">
									<g:TextBox ui:field="year"></g:TextBox>
								</td>   
							</tr>
							<tr>
								<td class="aon-panelGrid-odd">
									<g:Label text="Description" />
								</td>
								<td class="aon-panelGrid-even">
									<g:TextBox ui:field="description" />
								</td>
								<td class="aon-panelGrid-even">
								</td>
							</tr>
						</table> 
					</g:HTMLPanel>
				</g:north>
				
				<g:west size="300">
					<g:ScrollPanel styleName="{style.linkPanel}">
					
						<g:FlowPanel ui:field="menuPanel" styleName="{style.linkContainer}">
							
							<g:Tree ui:field="mainTree">
								<g:TreeItem ui:field="header1" styleName="{style.linkItem}" 
									text="Hoja identificativa de la sociedad">
								</g:TreeItem>
								<g:TreeItem ui:field="header2" styleName="{style.linkItem}" 
									text="Balance de situacion" >
								</g:TreeItem>
								<g:TreeItem ui:field="header3" styleName="{style.linkItem}"
									text="Cuenta de perdidas y ganancias">
								</g:TreeItem>
								<g:TreeItem ui:field="header4" styleName="{style.linkItem}"
									text="Estado de cambios en el patrimonio neto" >
								</g:TreeItem>
								<g:TreeItem ui:field="header5" styleName="{style.linkItem}"
									text="Declaración medioambiental" >
								</g:TreeItem>
							
								<g:TreeItem ui:field="memoryItem" styleName="{style.linkItemHeader}"
									text="Memoria" >
									<g:TreeItem ui:field="paragraph1" styleName="{style.linkItem}"
										text="Apartado 1: Actividad de la empresa" />
									<g:TreeItem ui:field="paragraph2" styleName="{style.linkItem}"
										text="Apartado 2: Bases de presentacion de las cuentas anuales" />
									
									<g:TreeItem ui:field="paragraph3" styleName="{style.linkItemHeader}" 
										text="Apartado 3: Aplicacion de resultados">
										<g:TreeItem ui:field="paragraph3_1" styleName="{style.linkItem}"
											text="Texto libre" />
										<g:TreeItem ui:field="paragraph3_2" styleName="{style.linkItem}"
											text="Cuadros normalizados" />
									</g:TreeItem>
									
									<g:TreeItem ui:field="paragraph4" styleName="{style.linkItem}"
										text="Apartado 4: Normas de registro y valoraci\u00F3n" >
									</g:TreeItem>
									
									<g:TreeItem ui:field="paragraph5" styleName="{style.linkItemHeader}"
										text="Apartado 5: Inmovilizado material, intangible, e inversiones inmobiliarias" >
										<g:TreeItem ui:field="paragraph5_1" styleName="{style.linkItem}"
											text="Texto libre" />
										<g:TreeItem ui:field="paragraph5_2" styleName="{style.linkItem}"
											text="Cuadros normalizados" />
									</g:TreeItem>
									
									<g:TreeItem ui:field="paragraph6" styleName="{style.linkItemHeader}"
										text="Apartado 6: Activos financieros" >
										<g:TreeItem ui:field="paragraph6_1" styleName="{style.linkItem}"
											text="Texto libre" />
										<g:TreeItem ui:field="paragraph6_2" styleName="{style.linkItem}"
											text="Cuadros normalizados" />
									</g:TreeItem>
									
									<g:TreeItem ui:field="paragraph7" styleName="{style.linkItemHeader}"
										text="Apartado 7: Pasivos financieros" >
										<g:TreeItem ui:field="paragraph7_1" styleName="{style.linkItem}"
											text="Texto libre" />
										<g:TreeItem ui:field="paragraph7_2" styleName="{style.linkItem}"
											text="Cuadros normalizados" />
									</g:TreeItem>
									
									<g:TreeItem ui:field="paragraph8" styleName="{style.linkItem}"
										text="Apartado 8: Fondos propios" />
									
									<g:TreeItem ui:field="paragraph9" styleName="{style.linkItem}"
										text="Apartado 9: Situacion fiscal" />
									
									<g:TreeItem ui:field="paragraph10" styleName="{style.linkItem}"
										text="Apartado 10: Ingresos y gastos" />
									
									<g:TreeItem ui:field="paragraph11" styleName="{style.linkItemHeader}"
										text="Apartado 11: Subvenciones, donaciones y legados" >
										<g:TreeItem ui:field="paragraph11_1" styleName="{style.linkItem}"
											text="Texto libre" />
										<g:TreeItem ui:field="paragraph11_2" styleName="{style.linkItem}"
											text="Cuadros normalizados" />
									</g:TreeItem>
									
									<g:TreeItem ui:field="paragraph12" styleName="{style.linkItemHeader}"
										text="Apartado 12: Operaciones con partes vinculadas" >
										<g:TreeItem ui:field="paragraph12_1" styleName="{style.linkItem}"
											text="Texto libre" />
										<g:TreeItem ui:field="paragraph12_2" styleName="{style.linkItem}"
											text="Cuadros normalizados" />
									</g:TreeItem>
									
									<g:TreeItem ui:field="paragraph13" styleName="{style.linkItemHeader}"
										text="Apartado 13: Otra informacion" >
										<g:TreeItem ui:field="paragraph13_1" styleName="{style.linkItem}"
											text="Texto libre" />
										<g:TreeItem ui:field="paragraph13_2" styleName="{style.linkItem}"
											text="Cuadros normalizados" />
									</g:TreeItem>
									
									<g:TreeItem ui:field="paragraph14" styleName="{style.linkItemHeader}"
										text="Apartado 14: Informacion sobre medio ambiente" >
										<g:TreeItem ui:field="paragraph14_1" styleName="{style.linkItem}"
											text="Texto libre" />
										<g:TreeItem ui:field="paragraph14_2" styleName="{style.linkItem}"
											text="Cuadros normalizados" />
									</g:TreeItem>

									<g:TreeItem ui:field="paragraph15" styleName="{style.linkItem}"
										text="Apartado 15: Informacion sobre los aplazamientos de pago efectuados a proveedores" />
								</g:TreeItem>
								
								<g:TreeItem ui:field="footer1" styleName="{style.linkItem}"
									text="Modelo de autocartera" />
								<g:TreeItem ui:field="footer2" styleName="{style.linkItem}"
									text="Instancia de presentacion" />
								<g:TreeItem ui:field="footer3" styleName="{style.linkItem}"
									text="Certificacion de la huella digital" />
								
							</g:Tree>
							
							
						</g:FlowPanel>
					</g:ScrollPanel>
				</g:west>
			
				<g:center>
					
					<g:ScrollPanel styleName="aon-scroll-area">
						<g:FlowPanel ui:field="pagesPanel" />
					</g:ScrollPanel>
				
				</g:center>
			</g:DockLayoutPanel>
			
			
		</g:center>
		
	
	</g:DockLayoutPanel>
	
</ui:UiBinder>
