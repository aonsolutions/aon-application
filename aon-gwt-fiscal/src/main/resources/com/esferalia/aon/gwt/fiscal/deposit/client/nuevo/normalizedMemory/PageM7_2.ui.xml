<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<ui:UiBinder xmlns:ui='urn:ui:com.google.gwt.uibinder'
	xmlns:g='urn:import:com.google.gwt.user.client.ui' xmlns:cell='urn:import:com.google.gwt.user.cellview.client'
	xmlns:aon='urn:import:com.esferalia.aon.gwt.common.client.widget'>

	<ui:with type="com.esferalia.aon.gwt.common.client.i18n.CommonMessages"
		field="msg"></ui:with>
	<ui:with type="com.esferalia.aon.gwt.common.client.css.AonResources"
		field="aonResources"></ui:with>

	<g:TabPanel ui:field="tabPanel" styleName="{aonResources.css.aonWidthAll}">
		<g:Tab text="{msg.memory7_2Title}">
			<g:ScrollPanel styleName="{aonResources.css.aonScrollArea}">
				<g:HTMLPanel ui:field="basePanel"
					styleName="{aonResources.css.aonFiscalContainer}">

					<div class="{aonResources.css.aonGroupBody}">

						<g:HTMLPanel ui:field="tablePanel">
							<div class="{aonResources.css.aonGroup}">
								<div class="{aonResources.css.aonGroupTitle}">
									<g:InlineLabel text="{msg.memory7_2Table1}" />
								</div>
								<div class="{aonResources.css.aonGroupBody}">
									<div
										class="{aonResources.css.aonBorderBottom} {aonResources.css.aonFiscalScrollTableWrapper}">
										<g:FlexTable ui:field="table" />
									</div>
								</div>
							</div>
						</g:HTMLPanel>

						<g:HTMLPanel ui:field="table1Panel">
							<div class="{aonResources.css.aonGroup}">
								<div class="{aonResources.css.aonGroupTitle}">
									<g:InlineLabel text="{msg.memory7_2Table2}" />
								</div>
								<div class="{aonResources.css.aonGroupBody}">
									<div
										class="{aonResources.css.aonBorderBottom} {aonResources.css.aonFiscalScrollTableWrapper}">
										<g:FlexTable ui:field="table1" />
									</div>
								</div>
							</div>
						</g:HTMLPanel>
						
						<g:HTMLPanel ui:field="table2Panel">
							<div class="{aonResources.css.aonGroup}">
								<div class="{aonResources.css.aonGroupTitle}">
									<g:InlineLabel text="{msg.memory7_2Table3}" ui:field="table2Label"/>
								</div>
								<div class="{aonResources.css.aonGroupBody}">
									<div
										class="{aonResources.css.aonBorderBottom} {aonResources.css.aonFiscalScrollTableWrapper}">
										<g:FlexTable ui:field="table2" />
									</div>
								</div>
							</div>
						</g:HTMLPanel>
						
						<g:HTMLPanel ui:field="table3Panel">
							<div class="{aonResources.css.aonGroup}">
								<div class="{aonResources.css.aonGroupTitle}">
									<g:InlineLabel text="{msg.memory7_2Table4}" ui:field="table4Label" />
								</div>
								<div class="{aonResources.css.aonGroupBody}">
									<div
										class="{aonResources.css.aonBorderBottom} {aonResources.css.aonFiscalScrollTableWrapper}">
										<g:FlexTable ui:field="table3" />
									</div>
								</div>
							</div>
						</g:HTMLPanel>
					</div>

				</g:HTMLPanel>
			</g:ScrollPanel>
		</g:Tab>
	</g:TabPanel>
</ui:UiBinder>
