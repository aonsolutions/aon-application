<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<ui:UiBinder xmlns:ui='urn:ui:com.google.gwt.uibinder'
	xmlns:g='urn:import:com.google.gwt.user.client.ui' xmlns:aon='urn:import:com.esferalia.aon.gwt.fiscal.client.widget'
	xmlns:m190='urn:import:com.esferalia.aon.gwt.fiscal.client.mod190'
	xmlns:cell='urn:import:com.google.gwt.user.cellview.client'>

	<ui:with type="com.esferalia.aon.gwt.fiscal.client.FiscalMessages"
		field="msg"></ui:with>

	<ui:style>
		.inner-label {
			font-style: italic;
			margin-left: 5px;
			margin-right: 5px;
			display: inline;
		}
		
		.linkPanel {
			padding: 0px 0px 1.5em 1.5em;
		}
		.linkContainer {
			width: 100%;
			height: 100%;
			border: solid #CCC 1px;
			background-color: #EEE;
		}
		.linkItem{
			padding-top: 5px;
			cursor: pointer;
		}
		.linkItem:hover{
			background-color: #DDD;
		}
		.linkItemSelected {
			background-color: #CCC;
			font-weight: bold;
		}
		.linkNumber{
			border-top: solid #CCC .5px;
			border-left: solid #BBB 2px;
			border-bottom: solid #BBB 2px;
			width: 20px;
			margin-left: 10px;
			text-align: center;
		}
		.linkDescription{
			text-align: right;
			font-size: 1.1em;
			padding-right: 20px;
			padding-left: 5px;
		}
		.pageHeader {
			background-color: #999;
			color: white;
			font-weight: bold;
			font-size: 1.2em;
			padding-left: 25px;
			margin-bottom: 10px;
		}
		.pageElement {
			margin-top: 10px;
			border: solid #CCC 1px;
			padding: 2px;
		}
	</ui:style>

	<g:DockLayoutPanel ui:field="dockLayoutPanel">
		<g:north size="26">
			<g:FlowPanel ui:field="toolbarPanel" height="100%"
				styleName="aon-finding-title-toolbar aon-width-all">
				<g:HorizontalPanel>
					<g:HTMLPanel styleName="aon-finding-title">
						<g:HTMLPanel styleName="aon-finding-title-internal">
							<g:Label styleName="aon-outputText" text="{msg.mod390}" />
						</g:HTMLPanel>
					</g:HTMLPanel>
					<g:HTMLPanel styleName="aon-finding-subtitle">
						<g:HTMLPanel styleName="aon-finding-subtitle-internal">
							<g:Label styleName="aon-outputText"></g:Label>
						</g:HTMLPanel>
					</g:HTMLPanel>
					<g:HorizontalPanel styleName="aon-finding-toolbar">
						<g:HTMLPanel styleName="aon-finding-toolbar-item-group">
							<g:Button ui:field='newButton'
								styleName='aon-finding-toolbar-item aon-icon-reset' text="{msg.newAction}" />
							<g:Button ui:field='saveButton'
								styleName='aon-finding-toolbar-item aon-icon-accept' text="{msg.saveAction}" />
							<g:Button ui:field='cancelButton'
								styleName='aon-finding-toolbar-item aon-icon-cancel' text="{msg.cancelAction}" />
							<g:Button ui:field='deleteButton'
								styleName='aon-finding-toolbar-item aon-icon-delete' text="{msg.deleteAction}" />
							<g:Button ui:field='printButton'
								styleName='aon-finding-toolbar-item aon-icon-printer' text="{msg.printViaAeat}" />
							<g:Button ui:field='generateFileButton'
								styleName='aon-finding-toolbar-item aon-icon-aeat' text="{msg.generateFile}" />
							<g:Anchor ui:field="download" visible="false"/>							
						</g:HTMLPanel>
						<g:FlowPanel ui:field="formContainer">
						</g:FlowPanel>
					</g:HorizontalPanel>
				</g:HorizontalPanel>
			</g:FlowPanel>
		</g:north>
		<g:center>
			<g:DeckLayoutPanel ui:field="deckPanel">
				<g:DockLayoutPanel ui:field="formPanel" unit="PX">
					<g:north size="75">
						<g:HTMLPanel styleName="aon-scroll-area">
							<g:HorizontalPanel ui:field='messagesPanel'/>
							
							<table class="aon-panelGrid aon-margin-top aon-width-all">
								<colgroup>
									<col style="width: 100px;" />
									<col style="width: 75px;" />
									<col style="width: 100px;" />
									<col style="width: auto;" />
								</colgroup>
								<tr>
									<td class="aon-panelGrid-odd">
										<g:Label text="{msg.fiscalYear}" />
									</td>
									<td class="aon-panelGrid-even">
										<g:TextBox maxLength="4" visibleLength="4" ui:field="year"></g:TextBox>
									</td>   
									<td class="aon-panelGrid-odd">
										<g:Label text="{msg.deponentData}" />
									</td>
									<td class="aon-panelGrid-even">
										<aon:EnterpriseSuggestBox ui:field="enterpriseSuggest" />
									</td>  
								</tr>
								<tr>
									<td class="aon-panelGrid-even" style="text-align: right;" colspan="2">
										<g:CheckBox ui:field="replacement" text="{msg.replacement}" />
									</td>
									<td class="aon-panelGrid-odd">
										<g:Label text="{msg.replacedReceipt}" />
									</td>
									<td class="aon-panelGrid-even">
										<g:TextBox visibleLength="13" ui:field="replacedReceipt" />
									</td>
								</tr>
							</table> 
						</g:HTMLPanel>
					</g:north>
					<g:west size="200">
						<g:ScrollPanel styleName="{style.linkPanel}">
							<g:FlowPanel styleName="{style.linkContainer}">
								<g:FocusPanel ui:field='linkPage1' styleName="{style.linkItem}">
									<g:FlowPanel>
										<g:FlowPanel styleName="{style.linkNumber}">
											<g:Label text="1" />
										</g:FlowPanel>
										<g:FlowPanel styleName="{style.linkDescription}">
											<g:Label text="{msg.pasiveSubject}" />
										</g:FlowPanel>
									</g:FlowPanel>
								</g:FocusPanel>
	
								<g:FocusPanel ui:field='linkPage3' styleName="{style.linkItem}">
									<g:FlowPanel>
										<g:FlowPanel styleName="{style.linkNumber}">
											<g:Label text="3" />
										</g:FlowPanel>
										<g:FlowPanel styleName="{style.linkDescription}">
											<g:Label text="{msg.stadisticalData}" />
										</g:FlowPanel>
									</g:FlowPanel>
								</g:FocusPanel>
	
								<g:FocusPanel ui:field='linkPage4' styleName="{style.linkItem}">
									<g:FlowPanel>
										<g:FlowPanel styleName="{style.linkNumber}">
											<g:Label text="4" />
										</g:FlowPanel>
										<g:FlowPanel styleName="{style.linkDescription}">
											<g:Label text="{msg.representativeData}" />
										</g:FlowPanel>
									</g:FlowPanel>
								</g:FocusPanel>
								
								<g:FocusPanel ui:field='linkPage5' styleName="{style.linkItem}">
									<g:FlowPanel>
										<g:FlowPanel styleName="{style.linkNumber}">
											<g:Label text="5" />
										</g:FlowPanel>
										<g:FlowPanel styleName="{style.linkDescription}">
											<g:Label text="{msg.generalRegimeOperations}" />
										</g:FlowPanel>
									</g:FlowPanel>
								</g:FocusPanel>
	
								<g:FocusPanel ui:field='linkPage6' styleName="{style.linkItem}">
									<g:FlowPanel>
										<g:FlowPanel styleName="{style.linkNumber}">
											<g:Label text="6" />
										</g:FlowPanel>
										<g:FlowPanel styleName="{style.linkDescription}">
											<g:Label text="{msg.simplifiedRegimeOperations}" />
										</g:FlowPanel>
									</g:FlowPanel>
								</g:FocusPanel>
	
								<g:FocusPanel ui:field='linkPage7' styleName="{style.linkItem}">
									<g:FlowPanel>
										<g:FlowPanel styleName="{style.linkNumber}">
											<g:Label text="7" />
										</g:FlowPanel>
										<g:FlowPanel styleName="{style.linkDescription}">
											<g:Label text="{msg.annualLiquidationResult}" />
										</g:FlowPanel>
									</g:FlowPanel>
								</g:FocusPanel>
								
								<g:FocusPanel ui:field='linkPage8' styleName="{style.linkItem}">
									<g:FlowPanel>
										<g:FlowPanel styleName="{style.linkNumber}">
											<g:Label text="8" />
										</g:FlowPanel>
										<g:FlowPanel styleName="{style.linkDescription}">
											<g:Label text="{msg.taxByTerritory}" />
										</g:FlowPanel>
									</g:FlowPanel>
								</g:FocusPanel>
										
								<g:FocusPanel ui:field='linkPage9' styleName="{style.linkItem}">
									<g:FlowPanel>
										<g:FlowPanel styleName="{style.linkNumber}">
											<g:Label text="9" />
										</g:FlowPanel>
										<g:FlowPanel styleName="{style.linkDescription}">
											<g:Label text="{msg.liquidationsResult}" />
										</g:FlowPanel>
									</g:FlowPanel>
								</g:FocusPanel>
	
								<g:FocusPanel ui:field='linkPage10' styleName="{style.linkItem}">
									<g:FlowPanel>
										<g:FlowPanel styleName="{style.linkNumber}">
											<g:Label text="10" />
										</g:FlowPanel>
										<g:FlowPanel styleName="{style.linkDescription}">
											<g:Label text="{msg.operationsVolume}" />
										</g:FlowPanel>
									</g:FlowPanel>
								</g:FocusPanel>
	
								<g:FocusPanel ui:field='linkPage11' styleName="{style.linkItem}">
									<g:FlowPanel>
										<g:FlowPanel styleName="{style.linkNumber}">
											<g:Label text="11" />
										</g:FlowPanel>
										<g:FlowPanel styleName="{style.linkDescription}">
											<g:Label text="{msg.specificOperations}" />
										</g:FlowPanel>
									</g:FlowPanel>
								</g:FocusPanel>
	
								<g:FocusPanel ui:field='linkPage12' styleName="{style.linkItem}">
									<g:FlowPanel>
										<g:FlowPanel styleName="{style.linkNumber}">
											<g:Label text="12" />
										</g:FlowPanel>
										<g:FlowPanel styleName="{style.linkDescription}">
											<g:Label text="{msg.prorrata}" />
										</g:FlowPanel>
									</g:FlowPanel>
								</g:FocusPanel>
	
								<g:FocusPanel ui:field='linkPage13' styleName="{style.linkItem}">
									<g:FlowPanel>
										<g:FlowPanel styleName="{style.linkNumber}">
											<g:Label text="13" />
										</g:FlowPanel>
										<g:FlowPanel styleName="{style.linkDescription}">
											<g:Label text="{msg.difActivitiesRegime}" />
										</g:FlowPanel>
									</g:FlowPanel>
								</g:FocusPanel>
							</g:FlowPanel>
						</g:ScrollPanel>
					</g:west>
					<g:center>
						<g:ScrollPanel styleName="aon-scroll-area">
							<g:DeckPanel ui:field="pagesPanel">
								<g:FlowPanel ui:field="panel1">
									<g:HTMLPanel>
										<g:Label text="{msg.pasiveSubject}" styleName="{style.pageHeader}" />
										
										<div class="{style.pageElement}">
											<g:CheckBox ui:field="taxRefund" text="{msg.taxRefund}" />
										</div>
										<div class="{style.pageElement}">
											<g:CheckBox ui:field="specialGroupRegime" text="{msg.specialGroupRegime}" />
											<div style="margin-left: 15px; padding-left: 5px; padding-right: 5px">
												<g:Label text="{msg.groupNumber}" styleName="{style.inner-label}" />
												<g:TextBox maxLength="5" visibleLength="5" ui:field="groupNumber"/>
												<g:CheckBox ui:field="groupDependent" text="{msg.groupDependent}" />
											</div>
										</div>
										<div class="{style.pageElement}">
											<g:CheckBox ui:field="groupDeclarations" text="{msg.groupDeclarations}" />
										</div>
									</g:HTMLPanel>
								</g:FlowPanel>
																		
								<g:FlowPanel ui:field="panel3">
									<g:Label text="{msg.stadisticalData}" styleName="{style.pageHeader}"/>
								</g:FlowPanel>
								<g:FlowPanel ui:field="panel4">
									<g:Label text="{msg.representativeData}" styleName="{style.pageHeader}"/>
								</g:FlowPanel>
								<g:FlowPanel ui:field="panel5">
									<g:Label text="{msg.generalRegimeOperations}" styleName="{style.pageHeader}"/>
								</g:FlowPanel>
								<g:FlowPanel ui:field="panel6">
									<g:Label text="{msg.simplifiedRegimeOperations}" styleName="{style.pageHeader}"/>
								</g:FlowPanel>
								<g:FlowPanel ui:field="panel7">
									<g:Label text="{msg.annualLiquidationResult}" styleName="{style.pageHeader}"/>
								</g:FlowPanel>
								<g:FlowPanel ui:field="panel8">
									<g:Label text="{msg.taxByTerritory}" styleName="{style.pageHeader}"/>
								</g:FlowPanel>
								<g:FlowPanel ui:field="panel9">
									<g:Label text="{msg.liquidationsResult}" styleName="{style.pageHeader}"/>
								</g:FlowPanel>
								<g:FlowPanel ui:field="panel10">
									<g:Label text="{msg.operationsVolume}" styleName="{style.pageHeader}"/>
								</g:FlowPanel>
								<g:FlowPanel ui:field="panel11">
									<g:Label text="{msg.specificOperations}" styleName="{style.pageHeader}"/>
								</g:FlowPanel>
								<g:FlowPanel ui:field="panel12">
									<g:Label text="{msg.prorrata}" styleName="{style.pageHeader}"/>
								</g:FlowPanel>
								<g:FlowPanel ui:field="panel13">
									<g:Label text="{msg.difActivitiesRegime}" styleName="{style.pageHeader}"/>
								</g:FlowPanel>
							</g:DeckPanel>
						</g:ScrollPanel>
					</g:center>
				</g:DockLayoutPanel>

				<g:ScrollPanel ui:field="listPanel" styleName="aon-scroll-area">
					<cell:CellTable ui:field="table" />
				</g:ScrollPanel>
			</g:DeckLayoutPanel>
		</g:center>
	</g:DockLayoutPanel>
</ui:UiBinder>
