<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<ui:UiBinder xmlns:ui='urn:ui:com.google.gwt.uibinder'
	xmlns:g='urn:import:com.google.gwt.user.client.ui' 
	xmlns:aon='urn:import:com.esferalia.aon.gwt.common.client.widget'
	xmlns:fiscal='urn:import:com.esferalia.aon.gwt.fiscal.client.widget'
	xmlns:m390='urn:import:com.esferalia.aon.gwt.fiscal.client.mod390'
	xmlns:cell='urn:import:com.google.gwt.user.cellview.client'>

	<ui:with type="com.esferalia.aon.gwt.common.client.i18n.CommonMessages" field="msg"></ui:with>
	<ui:with type="com.esferalia.aon.gwt.common.client.css.AonResources" field="aonResources"></ui:with>

	<g:DockLayoutPanel>
		<g:north size="26">
			<g:HTMLPanel height="100%" 
				styleName="{aonResources.css.aonFindingTitleToolbar} {aonResources.css.aonWidthAll}">
				<table cellpadding="0" cellspacing="0" class="{aonResources.css.aonWidthAll}">				
					<tr>
						<td class="{aonResources.css.aonFindingTitle}">
							<g:FlowPanel styleName="{aonResources.css.aonFindingTitleInternal}">
								<g:Label text="{msg.mod390}" />
							</g:FlowPanel>
						</td>
						<td>
							<g:HTMLPanel styleName="{aonResources.css.aonFindingSubtitleIternal}">
								<g:Label/>
							</g:HTMLPanel>
						</td>
						<td class="{aonResources.css.aonFindingToolbar}">
							<g:FlowPanel styleName="{aonResources.css.aonFindingToolbarItemGroup}">
								<g:Button ui:field="newButton" text="{msg.newAction}" 
									styleName="{aonResources.css.aonFindingToolbarItem} {aonResources.css.aonIconReset}"/>
								<g:Button ui:field="saveButton"  text="{msg.saveAction}" 
									styleName="{aonResources.css.aonFindingToolbarItem} {aonResources.css.aonIconSave}"/>
								<g:Button ui:field="cancelButton" text="{msg.cancelAction}" 
									styleName="{aonResources.css.aonFindingToolbarItem} {aonResources.css.aonIconCancel}" />
								<g:Button ui:field="deleteButton" text="{msg.deleteAction}" 
									styleName="{aonResources.css.aonFindingToolbarItem} {aonResources.css.aonIconDelete}" />
								<g:Button ui:field="printButton" text="{msg.printViaAeat}"
									styleName="{aonResources.css.aonFindingToolbarItem} {aonResources.css.aonIconPdfPreview}" />
								<g:Button ui:field="generateFileButton" text="{msg.generateFile}"
									styleName="{aonResources.css.aonFindingToolbarItem} {aonResources.css.aonIconAeat}"  />
								<g:Anchor ui:field="download" visible="false"/>							
								<g:FlowPanel ui:field="formContainer"/>
							</g:FlowPanel>
						</td>
					</tr>
				</table>
			</g:HTMLPanel>
		</g:north>

		<g:center>
			<g:SplitLayoutPanel ui:field="splitLayoutPanel">
				<g:center>
					<g:DeckLayoutPanel ui:field="deckPanel">
						<g:DockLayoutPanel ui:field="formPanel" unit="PX">
							<g:north size="65">
								<g:SimplePanel ui:field="headerPanel"/>
							</g:north>
							<g:north size="30">
								<g:HTMLPanel styleName="{aonResources.css.aonScrollArea}">
									<table class="{aonResources.css.aonPanelGrid} {aonResources.css.aonWidthAll}">
										<colgroup>
											<col style="width: 100px;" />
											<col style="width: 75px;" />
											<col style="width: 100px;" />
											<col style="width: auto;" />
											<col style="width: 120px;" />
										</colgroup>
										<tr>
											<td class="{aonResources.css.aonPanelGridOdd}">
												<g:Label text="{msg.fiscalYear}" />
											</td>
											<td class="aon-panelGrid-even">
												<aon:IntegerBox maxLength="4" visibleLength="4" ui:field="year"/>
											</td>   
											<td class="{aonResources.css.aonPanelGridOdd}">
												<g:Label text="{msg.deponentData}" />
											</td>
											<td class="{aonResources.css.aonPanelGridEven}">
												<fiscal:EnterpriseSuggestBox ui:field="enterpriseSuggest" />
											</td>  
											<td class="{aonResources.css.aonPanelGridEven}" 
												style="text-align: center; color: red; font-weight: bold;">
												<g:Label ui:field="simplifiedRegime"
													 text="{msg.simplifiedRegime}" />
											</td>
										</tr>
									</table> 
								</g:HTMLPanel>
							</g:north>
							<g:west size="200">
								<g:ScrollPanel styleName="{aonResources.css.aonLinkPanel}">
									<g:FlowPanel styleName="{aonResources.css.aonLinkContainer}">
										<g:FocusPanel ui:field='linkPage0' styleName="{aonResources.css.aonLinkItem}">
											<g:FlowPanel styleName="{aonResources.css.aonLinkListItem}">
												<g:InlineLabel text="{msg.pasiveSubjectAndAccrual}" />
											</g:FlowPanel>
										</g:FocusPanel>
		
										<g:FocusPanel ui:field='linkPage3' styleName="{aonResources.css.aonLinkItem}">
											<g:FlowPanel styleName="{aonResources.css.aonLinkListItem}">
												<g:InlineLabel text="{msg.stadisticalData}" />
											</g:FlowPanel>
										</g:FocusPanel>
			
										<g:FocusPanel ui:field='linkPage4' styleName="{aonResources.css.aonLinkItem}">
											<g:FlowPanel styleName="{aonResources.css.aonLinkListItem}">
												<g:InlineLabel text="{msg.representativeData}" />
											</g:FlowPanel>
										</g:FocusPanel>
										
										<g:FocusPanel ui:field='linkPage5' styleName="{aonResources.css.aonLinkItem}">
											<g:FlowPanel styleName="{aonResources.css.aonLinkListItem}">
												<g:InlineLabel text="{msg.generalRegimeOperations}" />
											</g:FlowPanel>
										</g:FocusPanel>
			
										<g:FocusPanel ui:field='linkPage6' styleName="{aonResources.css.aonLinkItem}">
											<g:FlowPanel styleName="{aonResources.css.aonLinkListItem}">
												<g:InlineLabel text="{msg.simplifiedRegimeOperations}" />
											</g:FlowPanel>
										</g:FocusPanel>
			
										<g:FocusPanel ui:field='linkPage7' styleName="{aonResources.css.aonLinkItem}">
											<g:FlowPanel styleName="{aonResources.css.aonLinkListItem}">
												<g:InlineLabel text="{msg.annualLiquidationResult}" />
											</g:FlowPanel>
										</g:FocusPanel>
										
										<g:FocusPanel ui:field='linkPage8' styleName="{aonResources.css.aonLinkItem}">
											<g:FlowPanel styleName="{aonResources.css.aonLinkListItem}">
												<g:InlineLabel text="{msg.taxByTerritory}" />
											</g:FlowPanel>
										</g:FocusPanel>
												
										<g:FocusPanel ui:field='linkPage9' styleName="{aonResources.css.aonLinkItem}">
											<g:FlowPanel styleName="{aonResources.css.aonLinkListItem}">
												<g:InlineLabel text="{msg.liquidationsResult}" />
											</g:FlowPanel>
										</g:FocusPanel>
			
										<g:FocusPanel ui:field='linkPage10' styleName="{aonResources.css.aonLinkItem}">
											<g:FlowPanel styleName="{aonResources.css.aonLinkListItem}">
												<g:InlineLabel text="{msg.operationsVolume}" />
											</g:FlowPanel>
										</g:FocusPanel>
			
										<g:FocusPanel ui:field='linkPage11' styleName="{aonResources.css.aonLinkItem}">
											<g:FlowPanel styleName="{aonResources.css.aonLinkListItem}">
												<g:InlineLabel text="{msg.specificOperations}" />
											</g:FlowPanel>
										</g:FocusPanel>
			
										<g:FocusPanel ui:field='linkPage12' styleName="{aonResources.css.aonLinkItem}">
											<g:FlowPanel styleName="{aonResources.css.aonLinkListItem}">
												<g:InlineLabel text="{msg.prorrata}" />
											</g:FlowPanel>
										</g:FocusPanel>
			
										<g:FocusPanel ui:field='linkPage13' styleName="{aonResources.css.aonLinkItem}">
											<g:FlowPanel styleName="{aonResources.css.aonLinkListItem}">
												<g:InlineLabel text="{msg.difActivitiesRegime}" />
											</g:FlowPanel>
										</g:FocusPanel>
									</g:FlowPanel>
								</g:ScrollPanel>
							</g:west>
							<g:center>
								<g:ScrollPanel styleName="{aonResources.css.aonScrollArea}">
									<g:DeckPanel ui:field="pagesPanel">
										<g:FlowPanel ui:field="panel0">
											<m390:Page00 ui:field="page0"/>
										</g:FlowPanel>
										<g:FlowPanel ui:field="panel3">
											<m390:Page03 ui:field="page3"/>
										</g:FlowPanel>
										<g:FlowPanel ui:field="panel4">
											<m390:Page04 ui:field="page4"/>
										</g:FlowPanel>
										<g:FlowPanel ui:field="panel5">
											<m390:Page05 ui:field="page5"/>
										</g:FlowPanel>
										<g:FlowPanel ui:field="panel6">
											<m390:Page06 ui:field="page6"/>
										</g:FlowPanel>
										<g:FlowPanel ui:field="panel7">
											<m390:Page07 ui:field="page7"/>
										</g:FlowPanel>
										<g:FlowPanel ui:field="panel8">
											<m390:Page08 ui:field="page8"/>
										</g:FlowPanel>
										<g:FlowPanel ui:field="panel9">
											<m390:Page09 ui:field="page9"/>
										</g:FlowPanel>
										<g:FlowPanel ui:field="panel10">
											<m390:Page10 ui:field="page10"/>
										</g:FlowPanel>
										<g:FlowPanel ui:field="panel11">
											<m390:Page11 ui:field="page11"/>
										</g:FlowPanel>
										<g:FlowPanel ui:field="panel12">
											<m390:Page12 ui:field="page12"/>
										</g:FlowPanel>
										<g:FlowPanel ui:field="panel13">
											<m390:Page13 ui:field="page13"/>
										</g:FlowPanel>
									</g:DeckPanel>
								</g:ScrollPanel>
							</g:center>
						</g:DockLayoutPanel>

						<g:ScrollPanel ui:field="listPanel" styleName="{aonResources.css.aonScrollArea}">
							<m390:Model390Table ui:field="table" />
						</g:ScrollPanel>
					</g:DeckLayoutPanel>
				</g:center>
				
				<g:south size="0">
					<aon:MinimizePanel ui:field="footPanel" styleName="{aonResources.css.aonSelector}">
						<g:TabLayoutPanel barHeight="26" barUnit="PX">
							<g:tab>
								<g:header>
									<span class="aon-icon-time aon-icon-commandButton" style="padding-left: 20px;">
										Notificaciones
									</span>
								</g:header>
								<aon:ResultsPanel ui:field="resultsPanel" />
							</g:tab>
						</g:TabLayoutPanel>
					</aon:MinimizePanel>
				</g:south>
			</g:SplitLayoutPanel>
		</g:center>
	</g:DockLayoutPanel>
</ui:UiBinder>
