<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<ui:UiBinder xmlns:ui='urn:ui:com.google.gwt.uibinder'
	xmlns:g='urn:import:com.google.gwt.user.client.ui' 
	xmlns:aon='urn:import:com.esferalia.aon.gwt.common.client.widget'
	xmlns:fiscal='urn:import:com.esferalia.aon.gwt.fiscal.client.widget'
	xmlns:m390='urn:import:com.esferalia.aon.gwt.fiscal.client.mod390'
	xmlns:cell='urn:import:com.google.gwt.user.cellview.client'>

	<ui:with type="com.esferalia.aon.gwt.common.client.i18n.CommonMessages" field="msg"></ui:with>
	<ui:with type="com.esferalia.aon.gwt.common.client.css.AonResources" field="aonResources"></ui:with>

	<g:SplitLayoutPanel ui:field="splitLayoutPanel">
		<g:north size="26">
			<g:FlowPanel ui:field="toolbarPanel" height="100%"
				styleName="aon-finding-title-toolbar aon-width-all">
				<g:HorizontalPanel>
					<g:HTMLPanel styleName="aon-finding-title">
						<g:HTMLPanel styleName="aon-finding-title-internal">
							<g:Label styleName="aon-outputText" text="{msg.mod390}" />
						</g:HTMLPanel>
					</g:HTMLPanel>
					<g:HTMLPanel styleName="aon-finding-subtitle">
						<g:HTMLPanel styleName="aon-finding-subtitle-internal">
							<g:Label styleName="aon-outputText"></g:Label>
						</g:HTMLPanel>
					</g:HTMLPanel>
					<g:HorizontalPanel styleName="aon-finding-toolbar">
						<g:HTMLPanel styleName="aon-finding-toolbar-item-group">
							<g:Button ui:field='newButton'
								styleName='aon-finding-toolbar-item aon-icon-reset' text="{msg.newAction}" />
							<g:Button ui:field='saveButton'
								styleName='aon-finding-toolbar-item aon-icon-accept' text="{msg.saveAction}" />
							<g:Button ui:field='cancelButton'
								styleName='aon-finding-toolbar-item aon-icon-cancel' text="{msg.cancelAction}" />
							<g:Button ui:field='deleteButton'
								styleName='aon-finding-toolbar-item aon-icon-delete' text="{msg.deleteAction}" />
<!-- 							
							<g:Button ui:field='printButton'
								styleName='aon-finding-toolbar-item aon-icon-printer' text="{msg.printViaAeat}" />
 -->
							<g:Button ui:field='generateFileButton'
								styleName='aon-finding-toolbar-item aon-icon-aeat' text="{msg.generateFile}" />
							<g:Anchor ui:field="download" visible="false"/>							
						</g:HTMLPanel>
						<g:FlowPanel ui:field="formContainer">
						</g:FlowPanel>
					</g:HorizontalPanel>
				</g:HorizontalPanel>
			</g:FlowPanel>
		</g:north>
		<g:center>
			<g:DeckLayoutPanel ui:field="deckPanel">
				<g:DockLayoutPanel ui:field="formPanel" unit="PX">
					<g:north size="100">
						<g:HTMLPanel styleName="aon-scroll-area">
							<table class="aon-width-all" style="text-align: center;font-weight:bold;">
								<tr>
									<td class="{aonResources.css.aonFiscalTitle}">
										<span style=" font-size: 1.2em; font-weight: bold;">
											<g:Label text="{msg.mod390Desc}"/>
										</span>
										<span style="font-weight: bold;">
											<g:Label text="{msg.mod390Desc2}"/>
										</span>
									</td>
									<td class="{aonResources.css.aonFiscalYear}">
										<g:Label text="2014" />
									</td>
								</tr>
							</table>
							<table class="aon-panelGrid aon-margin-top aon-width-all">
								<colgroup>
									<col style="width: 100px;" />
									<col style="width: 75px;" />
									<col style="width: 100px;" />
									<col style="width: auto;" />
									<col style="width: 120px;" />
								</colgroup>
								<tr>
									<td class="aon-panelGrid-odd">
										<g:Label text="{msg.fiscalYear}" />
									</td>
									<td class="aon-panelGrid-even">
										<aon:IntegerTextBox maxLength="4" visibleLength="4" ui:field="year" styleName="aon-inputText"/>
									</td>   
									<td class="aon-panelGrid-odd">
										<g:Label text="{msg.deponentData}" />
									</td>
									<td class="aon-panelGrid-even">
										<fiscal:EnterpriseSuggestBox ui:field="enterpriseSuggest" />
									</td>  
									<td class="aon-panelGrid-even" style="text-align: center; color: red; font-weight: bold;">
										<g:Label ui:field="simplifiedRegime"
											 text="{msg.simplifiedRegime}" />
									</td>
								</tr>
							</table> 
						</g:HTMLPanel>
					</g:north>
					<g:west size="200">
						<g:ScrollPanel styleName="{aonResources.css.aonLinkPanel}">
							<g:FlowPanel styleName="{aonResources.css.aonLinkContainer}">
								<g:FocusPanel ui:field='linkPage0' styleName="{aonResources.css.aonLinkItem}">
									<g:FlowPanel styleName="{aonResources.css.aonLinkListItem}">
										<g:InlineLabel text="{msg.pasiveSubjectAndAccrual}" />
									</g:FlowPanel>
								</g:FocusPanel>

								<g:FocusPanel ui:field='linkPage3' styleName="{aonResources.css.aonLinkItem}">
									<g:FlowPanel styleName="{aonResources.css.aonLinkListItem}">
										<g:InlineLabel text="{msg.stadisticalData}" />
									</g:FlowPanel>
								</g:FocusPanel>
	
								<g:FocusPanel ui:field='linkPage4' styleName="{aonResources.css.aonLinkItem}">
									<g:FlowPanel styleName="{aonResources.css.aonLinkListItem}">
										<g:InlineLabel text="{msg.representativeData}" />
									</g:FlowPanel>
								</g:FocusPanel>
								
								<g:FocusPanel ui:field='linkPage5' styleName="{aonResources.css.aonLinkItem}">
									<g:FlowPanel styleName="{aonResources.css.aonLinkListItem}">
										<g:InlineLabel text="{msg.generalRegimeOperations}" />
									</g:FlowPanel>
								</g:FocusPanel>
	
								<g:FocusPanel ui:field='linkPage6' styleName="{aonResources.css.aonLinkItem}">
									<g:FlowPanel styleName="{aonResources.css.aonLinkListItem}">
										<g:InlineLabel text="{msg.simplifiedRegimeOperations}" />
									</g:FlowPanel>
								</g:FocusPanel>
	
								<g:FocusPanel ui:field='linkPage7' styleName="{aonResources.css.aonLinkItem}">
									<g:FlowPanel styleName="{aonResources.css.aonLinkListItem}">
										<g:InlineLabel text="{msg.annualLiquidationResult}" />
									</g:FlowPanel>
								</g:FocusPanel>
								
								<g:FocusPanel ui:field='linkPage8' styleName="{aonResources.css.aonLinkItem}">
									<g:FlowPanel styleName="{aonResources.css.aonLinkListItem}">
										<g:InlineLabel text="{msg.taxByTerritory}" />
									</g:FlowPanel>
								</g:FocusPanel>
										
								<g:FocusPanel ui:field='linkPage9' styleName="{aonResources.css.aonLinkItem}">
									<g:FlowPanel styleName="{aonResources.css.aonLinkListItem}">
										<g:InlineLabel text="{msg.liquidationsResult}" />
									</g:FlowPanel>
								</g:FocusPanel>
	
								<g:FocusPanel ui:field='linkPage10' styleName="{aonResources.css.aonLinkItem}">
									<g:FlowPanel styleName="{aonResources.css.aonLinkListItem}">
										<g:InlineLabel text="{msg.operationsVolume}" />
									</g:FlowPanel>
								</g:FocusPanel>
	
								<g:FocusPanel ui:field='linkPage11' styleName="{aonResources.css.aonLinkItem}">
									<g:FlowPanel styleName="{aonResources.css.aonLinkListItem}">
										<g:InlineLabel text="{msg.specificOperations}" />
									</g:FlowPanel>
								</g:FocusPanel>
	
								<g:FocusPanel ui:field='linkPage12' styleName="{aonResources.css.aonLinkItem}">
									<g:FlowPanel styleName="{aonResources.css.aonLinkListItem}">
										<g:InlineLabel text="{msg.prorrata}" />
									</g:FlowPanel>
								</g:FocusPanel>
	
								<g:FocusPanel ui:field='linkPage13' styleName="{aonResources.css.aonLinkItem}">
									<g:FlowPanel styleName="{aonResources.css.aonLinkListItem}">
										<g:InlineLabel text="{msg.difActivitiesRegime}" />
									</g:FlowPanel>
								</g:FocusPanel>
							</g:FlowPanel>
						</g:ScrollPanel>
					</g:west>
					<g:center>
						<g:ScrollPanel styleName="aon-scroll-area">
							<g:DeckPanel ui:field="pagesPanel">
								<g:FlowPanel ui:field="panel0">
									<m390:Page0 ui:field="page0"/>
								</g:FlowPanel>
								<g:FlowPanel ui:field="panel3">
									<m390:Page3 ui:field="page3"/>
								</g:FlowPanel>
								<g:FlowPanel ui:field="panel4">
									<m390:Page4 ui:field="page4"/>
								</g:FlowPanel>
								<g:FlowPanel ui:field="panel5">
									<m390:Page5 ui:field="page5"/>
								</g:FlowPanel>
								<g:FlowPanel ui:field="panel6">
									<m390:Page6 ui:field="page6"/>
								</g:FlowPanel>
								<g:FlowPanel ui:field="panel7">
									<m390:Page7 ui:field="page7"/>
								</g:FlowPanel>
								<g:FlowPanel ui:field="panel8">
									<m390:Page8 ui:field="page8"/>
								</g:FlowPanel>
								<g:FlowPanel ui:field="panel9">
									<m390:Page9 ui:field="page9"/>
								</g:FlowPanel>
								<g:FlowPanel ui:field="panel10">
									<m390:Page10 ui:field="page10"/>
								</g:FlowPanel>
								<g:FlowPanel ui:field="panel11">
									<m390:Page11 ui:field="page11"/>
								</g:FlowPanel>
								<g:FlowPanel ui:field="panel12">
									<m390:Page12 ui:field="page12"/>
								</g:FlowPanel>
								<g:FlowPanel ui:field="panel13">
									<m390:Page13 ui:field="page13"/>
								</g:FlowPanel>
							</g:DeckPanel>
						</g:ScrollPanel>
					</g:center>
				</g:DockLayoutPanel>

				<g:ScrollPanel ui:field="listPanel" styleName="aon-scroll-area">
					<cell:CellTable ui:field="table" />
				</g:ScrollPanel>
			</g:DeckLayoutPanel>
		</g:center>
		<g:south size="0">
			<aon:MinimizePanel ui:field="footPanel">
				<g:TabLayoutPanel barHeight="26" barUnit="PX">
					<g:tab>
						<g:header>
							<span class="aon-icon-time aon-icon-commandButton" style="padding-left: 20px;">
								Notificaciones
							</span>
						</g:header>
						<aon:ResultsPanel ui:field="resultsPanel" />
					</g:tab>
				</g:TabLayoutPanel>
			</aon:MinimizePanel>
		</g:south>
	</g:SplitLayoutPanel>
</ui:UiBinder>
