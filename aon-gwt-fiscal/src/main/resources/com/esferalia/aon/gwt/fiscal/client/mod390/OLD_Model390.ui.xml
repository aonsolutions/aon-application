<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
	xmlns:g="urn:import:com.google.gwt.user.client.ui" 
	xmlns:aon="urn:import:com.esferalia.aon.gwt.common.client.widget"
	xmlns:fiscal="urn:import:com.esferalia.aon.gwt.fiscal.client.widget"
	xmlns:m390="urn:import:com.esferalia.aon.gwt.fiscal.client.mod390">

	<ui:with type="com.esferalia.aon.gwt.common.client.i18n.CommonMessages" field="msg"></ui:with>
	<ui:with type="com.esferalia.aon.gwt.common.client.css.AonResources" field="aonResources"></ui:with>
	
	<g:DeckLayoutPanel ui:field="deckPanel" styleName="{aonResources.css.aonSelector}">
		<g:DockLayoutPanel ui:field="listPanel">
			<g:north size="26">
				<g:HTMLPanel height="100%" 
					styleName="{aonResources.css.aonFindingTitleToolbar} {aonResources.css.aonWidthAll}">
					<table cellpadding="0" cellspacing="0" class="{aonResources.css.aonWidthAll}">				
						<tr>
							<td class="{aonResources.css.aonFindingTitle}">
								<g:FlowPanel styleName="{aonResources.css.aonFindingTitleInternal}">
									<g:Label text="{msg.mod390}" />
								</g:FlowPanel>
							</td>
							<td>
								<g:HTMLPanel styleName="{aonResources.css.aonFindingSubtitleIternal}">
									<g:Label/>
								</g:HTMLPanel>
							</td>
							<td class="{aonResources.css.aonFindingToolbar}">
								<g:FlowPanel styleName="{aonResources.css.aonFindingToolbarItemGroup}">
									<g:Button text="{msg.newAction}" ui:field="newButton"
										styleName="{aonResources.css.aonFindingToolbarItem} {aonResources.css.aonIconReset}"/>
								</g:FlowPanel>
							</td>
						</tr>
					</table>
				</g:HTMLPanel>
			</g:north>
			<g:center>
				<g:ScrollPanel styleName="{aonResources.css.aonScrollArea}">
					<m390:OLD_Model390Table ui:field="table" />
				</g:ScrollPanel>
			</g:center>
		</g:DockLayoutPanel>
		
		<g:SimpleLayoutPanel ui:field="formPanel" />
		
	</g:DeckLayoutPanel>
	
</ui:UiBinder>
