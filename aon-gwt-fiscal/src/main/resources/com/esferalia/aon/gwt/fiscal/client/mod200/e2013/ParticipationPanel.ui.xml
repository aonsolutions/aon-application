<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<ui:UiBinder xmlns:ui='urn:ui:com.google.gwt.uibinder'
	xmlns:g='urn:import:com.google.gwt.user.client.ui' 
	xmlns:aon='urn:import:com.esferalia.aon.gwt.common.client.widget'>
	
	<ui:with type="com.esferalia.aon.gwt.common.client.i18n.CommonMessages" field="msg"></ui:with>
	<ui:with type="com.esferalia.aon.gwt.common.client.css.AonResources" field="aonResources"></ui:with>
	
	<g:HTMLPanel styleName="{aonResources.css.aonPadding2}">
		<g:Label text="{msg.partMsg1}"/>
		
		<div class="{aonResources.css.aonGroup}">
			<div class="{aonResources.css.aonGroupTitle}">
				<g:InlineLabel text="{msg.partMsg2}"/>
			</div>
			<div class="{aonResources.css.aonGroupBody}">
				<table class="aon-width-all">
					<tr>
						<td class="{aonResources.css.aonFiscalBorderBottom}">
							<g:Label text="{msg.nif}"/>
						</td>
						<td style="width: 250px;">
							<g:TextBox ui:field="document" visibleLength="9"
								styleName="{aonResources.css.aonInputText}"/>
						</td>
					</tr>
					<tr>
						<td class="{aonResources.css.aonFiscalBorderBottom}">
							<g:Label text="{msg.companyName}"/>
						</td>
						<td>
							<g:TextBox ui:field="name" visibleLength="40" maxLength="55"
								styleName="{aonResources.css.aonInputText}"/>
						</td>
					</tr>
					<tr>
						<td class="{aonResources.css.aonFiscalBorderBottom}">
							<g:Label text="{msg.province}/{msg.country}"/>
						</td>
						<td>
							<aon:ProvinceCountryListBox ui:field="province"/>
						</td>
					</tr>
				</table>
			</div>
		</div>				
		
		<div class="{aonResources.css.aonGroup}">
			<div class="{aonResources.css.aonGroupTitle}">
				<g:InlineLabel text="{msg.partMsg3}"/>
			</div>
			<div class="{aonResources.css.aonGroupBody}">
				<table class="aon-width-all">
					<tr>
						<td class="{aonResources.css.aonFiscalBorderBottom}">
							<g:Label text="{msg.partMsg4}"/>
						</td>
						<td style="width: 150px;">
							<aon:DoubleBox ui:field="percent"
								styleName="{aonResources.css.aonInputText}"/>
						</td>
					</tr>
					<tr>
						<td class="{aonResources.css.aonFiscalBorderBottom}">
							<g:Label text="{msg.partMsg5}"/>
						</td>
						<td>
							<aon:DoubleBox ui:field="nominalValue"
								styleName="{aonResources.css.aonInputText}"/>
						</td>
					</tr>
					<tr>
						<td class="{aonResources.css.aonFiscalBorderBottom}">
							<g:Label text="{msg.partMsg6}"/>
						</td>
						<td>
							<aon:DoubleBox ui:field="bookValue"
								styleName="{aonResources.css.aonInputText}"/>
						</td>
					</tr>
					<tr>
						<td class="{aonResources.css.aonFiscalBorderBottom}">
							<g:Label text="{msg.partMsg7}"/>
						</td>
						<td>
							<aon:DoubleBox ui:field="incomes"
								styleName="{aonResources.css.aonInputText}"/>
						</td>
					</tr>
				</table>
			</div>
		</div>				
			
		<div class="{aonResources.css.aonGroup}">
			<div class="{aonResources.css.aonGroupTitle}">
				<g:InlineLabel text="{msg.partMsg8}"/>
			</div>
			<div class="{aonResources.css.aonGroupBody}">
				<table class="aon-width-all">
					<tr>
						<td class="{aonResources.css.aonFiscalBorderBottom}">
							<g:Label text="{msg.partMsg9}"/>
						</td>
						<td style="width: 150px;">
							<aon:DoubleBox ui:field="aValue"
								styleName="{aonResources.css.aonInputText}"/>
						</td>
					</tr>
					<tr>
						<td class="{aonResources.css.aonFiscalBorderBottom}">
							<g:Label text="{msg.partMsg10}"/>
						</td>
						<td>
							<aon:DoubleBox ui:field="bValue"
								styleName="{aonResources.css.aonInputText}"/>
						</td>
					</tr>
					<tr>
						<td class="{aonResources.css.aonFiscalBorderBottom}">
							<g:Label text="{msg.partMsg11}"/>
						</td>
						<td>
							<aon:DoubleBox ui:field="cValue"
								styleName="{aonResources.css.aonInputText}"/>
						</td>
					</tr>
					<tr>
						<td class="{aonResources.css.aonFiscalBorderBottom}">
							<g:Label text="{msg.partMsg12}"/>
						</td>
						<td>
							<aon:DoubleBox ui:field="dValue"
								styleName="{aonResources.css.aonInputText}"/>
						</td>
					</tr>
				</table>
			</div>
		</div>				

		<div class="{aonResources.css.aonGroup}">
			<div class="{aonResources.css.aonGroupTitle}">
				<g:InlineLabel text="{msg.partMsg13}"/>
			</div>
			<div class="{aonResources.css.aonGroupBody}">
				<table class="aon-width-all">
					<tr>
						<td class="{aonResources.css.aonFiscalBorderBottom}">
							<g:Label text="{msg.partMsg14}"/>
						</td>
						<td style="width: 150px;">
							<aon:DoubleBox ui:field="capital"
								styleName="{aonResources.css.aonInputText}"/>
						</td>
					</tr>
					<tr>
						<td class="{aonResources.css.aonFiscalBorderBottom}">
							<g:Label text="{msg.partMsg15}"/>
						</td>
						<td>
							<aon:DoubleBox ui:field="reserve"
								styleName="{aonResources.css.aonInputText}"/>
						</td>
					</tr>
					<tr>
						<td class="{aonResources.css.aonFiscalBorderBottom}">
							<g:Label text="{msg.partMsg16}"/>
						</td>
						<td>
							<aon:DoubleBox ui:field="otherAmounts"
								styleName="{aonResources.css.aonInputText}"/>
						</td>
					</tr>
					<tr>
						<td class="{aonResources.css.aonFiscalBorderBottom}">
							<g:Label text="{msg.partMsg17}"/>
						</td>
						<td>
							<aon:DoubleBox ui:field="result"
								styleName="{aonResources.css.aonInputText}"/>
						</td>
					</tr>
				</table>
			</div>
		</div>				
	</g:HTMLPanel>
</ui:UiBinder>
