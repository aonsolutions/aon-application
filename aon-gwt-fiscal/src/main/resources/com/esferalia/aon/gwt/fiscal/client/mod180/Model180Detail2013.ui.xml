<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<ui:UiBinder xmlns:ui='urn:ui:com.google.gwt.uibinder'
	xmlns:g='urn:import:com.google.gwt.user.client.ui' 
	xmlns:aon='urn:import:com.esferalia.aon.gwt.common.client.widget'>
	
	<ui:with type="com.esferalia.aon.gwt.common.client.i18n.CommonMessages" field="msg"></ui:with>
	
	<ui:style>
		.perceptor-label {
			padding-right: 2px;
			font-size: 0.9em;
			text-align: center;
		}
		.detailToolbar {
			height: 20px;
		}
	</ui:style>
	
	<g:VerticalPanel>
		<g:FlowPanel
			styleName="aon-finding-title-toolbar aon-width-all gwt-MenuBar-horizontal {style.detailToolbar}">
			<g:Button ui:field='deleteDetailButton'
				styleName='aon-finding-toolbar-item aon-icon-delete' text="{msg.deleteAction}" />
			<g:Button ui:field='restoreDeletedButton'
				styleName='aon-finding-toolbar-item aon-icon-refresh' text="{msg.restoreAction}" />
		</g:FlowPanel>
		<g:HTMLPanel>
			<table>
				<tr>
					<td class="{style.perceptor-label}">
						<g:Label text="{msg.receiverDocument}" />
					</td>
					<td class="{style.perceptor-label}">
						<g:Label text="{msg.representativeDocument}" />
					</td>
					<td class="{style.perceptor-label}">
						<g:Label text="{msg.fullName}" />
					</td>
					<td class="{style.perceptor-label}">
						<g:Label text="{msg.province}" />
					</td>
				</tr>
				<tr>
					<td>
						<aon:DocumentTextBox ui:field="receiverDocument" styleName="aon-inputText"/>
					</td>
					<td>
						<aon:DocumentTextBox ui:field="representativeDocument" styleName="aon-inputText"/>
					</td>
					<td>
						<g:TextBox maxLength="40" visibleLength="40"
							ui:field="fullName" styleName="aon-inputText"/>
					</td>
					<td>
						<aon:ProvinceListBox ui:field="province" />
					</td>
				</tr>
			</table>

			<table>
				<tr>
					<td>
					</td>
					<td class="{style.perceptor-label}">
						<g:Label text="{msg.perception}" />
					</td>
					<td class="{style.perceptor-label}">
						<g:Label text="{msg.percent}" />
					</td>
					<td class="{style.perceptor-label}">
						<g:Label text="{msg.retention}" />
					</td>
					<td class="{style.perceptor-label}">
						<g:Label text="{msg.accrualYear}" />
					</td>
				</tr>
				<tr>
					<td>
						<g:CheckBox ui:field="inKind" text="{msg.inKind}"/>
					</td>
					<td>
						<aon:DoubleTextBox ui:field="perception" styleName="aon-inputText"/>
					</td>
					<td>
						<aon:DoubleTextBox ui:field="percent" styleName="aon-inputText"/>
					</td>
					<td>
						<aon:DoubleTextBox ui:field="retention" styleName="aon-inputText"/>
					</td>
					<td>
						<aon:IntegerTextBox maxLength="4"
							visibleLength="4" ui:field="accrualYear" styleName="aon-inputText"/>
					</td>
				</tr>
			</table>
		</g:HTMLPanel>
	</g:VerticalPanel>
	
</ui:UiBinder>
