	<groupId>com.esferalia.aon</groupId>
	<artifactId>aon.gwt.fiscal</artifactId>
	<packaging>jar</packaging>
	<description>AON GWT FISCAL</description>
	<name>AON GWT FISCAL</name>
 	
	<build>
		<plugins>
			<plugin>
				<groupId>org.codehaus.mojo</groupId>
				<artifactId>gwt-maven-plugin</artifactId>
				<version>2.8.0</version>
				<configuration>
					<deploy>${project.build.directory}/extra</deploy>
					<extra>${project.build.directory}/extra</extra>
					<modules>
          				<module>com.esferalia.aon.gwt.fiscal.Fiscal</module>
          				<module>com.esferalia.aon.gwt.fiscal.deposit.Deposit</module>
					</modules>
					<webappDirectory>${project.build.outputDirectory}</webappDirectory>
					<compileSourcesArtifacts>
					  <compileSourcesArtifact>com.esferalia.aon:aon.gwt.common</compileSourcesArtifact>  
					  <compileSourcesArtifact>com.esferalia.aon:aon.gwt.viewer</compileSourcesArtifact>  
					  <compileSourcesArtifact>com.esferalia.aon:aon.occam</compileSourcesArtifact>
					</compileSourcesArtifacts>
					<extraJvmArgs>-Xmx3072M</extraJvmArgs>
					<localWorkers>4</localWorkers>
				</configuration>
				<executions>
					<execution>
						<phase>prepare-package</phase>
						<goals>
							<goal>compile</goal>
						</goals>
					</execution>
				</executions>
			</plugin>
			<plugin>
				<groupId>com.google.code.maven-replacer-plugin</groupId>
				<artifactId>replacer</artifactId>
				<version>1.5.3</version>
				<executions>
					<execution>
						<phase>prepare-package</phase>
						<goals>
							<goal>replace</goal>
						</goals>                   
					</execution>
				</executions>
				<configuration>
					<basedir>${project.basedir}/target/classes</basedir>
					<includes>
						<include>**/gwt/clean/clean.css</include>
					</includes>
					<regexFlags>
					    <regexFlag>MULTILINE</regexFlag>
					    <regexFlag>CASE_INSENSITIVE</regexFlag>
					</regexFlags>
					<replacements>
						<replacement>
							<token>^([a-z: \t,]*)\{$</token>
							<value>/** $1 */
.disabled-by-aon {</value>
						</replacement>         
					</replacements>
				</configuration>
			</plugin>
		</plugins>
	</build>

