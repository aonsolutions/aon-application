			<version>7.0.42</version>
			<scope>provided</scope>
		</dependency>
		
		<dependency>
    		<groupId>com.sun.xml.bind</groupId>
    		<artifactId>jaxb-impl</artifactId>
	    	<version>2.2.5-2</version>
			<scope>compile</scope>
		</dependency>

