<faces-config version="1.2"
	xmlns="http://java.sun.com/xml/ns/javaee"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://java.sun.com/xml/ns/javaee http://java.sun.com/xml/ns/javaee/web-facesconfig_1_2.xsd">

	<!--  *************** COLLECTIONS ***************** -->
	<managed-bean>
		<managed-bean-name>sellerCollections</managed-bean-name>
		<managed-bean-class>
			com.code.aon.ui.seller.controller.SellerCollectionsController
		</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
	</managed-bean>

	<!-- ************ SELLER ************** -->
	<managed-bean>
		<managed-bean-name>seller</managed-bean-name>
		<managed-bean-class>
			com.code.aon.ui.seller.controller.SellerController
		</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
		<managed-property>
			<property-name>pojo</property-name>
			<value>com.code.aon.seller.Seller</value>
		</managed-property>
		<managed-property>
			<property-name>beanName</property-name>
			<value>seller</value>
		</managed-property>
		<managed-property>
			<property-name>defaultOrder</property-name>
			<value>Seller_registry_name</value>
		</managed-property>
		<managed-property>
			<property-name>listenerClasses</property-name>
			<list-entries>
				<value-class>
					com.code.aon.ui.form.event.IControllerListener
				</value-class>
				<value>#{sellerSearch}</value>
				<value>#{sellerForm}</value>
				<value>#{sellerScopeListener}</value>
				<value>#{sellerMediaListener}</value>
				<value>#{sellerAddressListener}</value>
				<value>#{sellerAddInfoListener}</value>
				<value>#{sellerRAttachChildListener}</value>
			</list-entries>
		</managed-property>
	</managed-bean>
	
	<managed-bean>
		<managed-bean-name>sellerSearch</managed-bean-name>
		<managed-bean-class>
			com.code.aon.ui.seller.event.SellerSearchListener
		</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
	</managed-bean>	

	<managed-bean>
		<managed-bean-name>sellerScopeListener</managed-bean-name>
		<managed-bean-class>com.code.aon.ui.config.event.ScopeFilterListener</managed-bean-class>
		<managed-bean-scope>none</managed-bean-scope>
		<managed-property>
			<property-name>aliasName</property-name>
			<value>Seller_scope_id</value>
		</managed-property>
	</managed-bean>

	<managed-bean>
		<managed-bean-name>sellerAddressListener</managed-bean-name>
		<managed-bean-class>com.code.aon.ui.form.listener.LinesControllerListener</managed-bean-class>		
		<managed-bean-scope>none</managed-bean-scope>
		<managed-property>
			<property-name>childBean</property-name>
			<value>sellerAddress</value>
		</managed-property>
		<managed-property>
			<property-name>aliasMap</property-name>
			<map-entries>
				<map-entry>
					<key>RegistryAddress_registry_id</key>
					<value>id</value>
				</map-entry>
			</map-entries>
		</managed-property>
	</managed-bean>

	<managed-bean>
		<managed-bean-name>sellerMediaListener</managed-bean-name>
		<managed-bean-class>com.code.aon.ui.form.listener.LinesControllerListener</managed-bean-class>
		<managed-bean-scope>none</managed-bean-scope>
		<managed-property>
			<property-name>childBean</property-name>
			<value>sellerMedia</value>
		</managed-property>
		<managed-property>
			<property-name>aliasMap</property-name>
			<map-entries>
				<map-entry>
					<key>RegistryMedia_registry_id</key>
					<value>id</value>
				</map-entry>
			</map-entries>
		</managed-property>
	</managed-bean>

	<!--  **** SELLER ADDRESS **** -->

	<managed-bean>
		<managed-bean-name>sellerAddress</managed-bean-name>
		<managed-bean-class>com.code.aon.ui.registry.controller.RegistryAddressLinesController</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
		<managed-property>
			<property-name>pojo</property-name>
			<value>com.code.aon.registry.RegistryAddress</value>
		</managed-property>
		<managed-property>
			<property-name>beanName</property-name>
			<value>sellerAddress</value>
		</managed-property>
		<managed-property>
			<property-name>cascadeDelete</property-name>
			<value>true</value>
		</managed-property>
		<managed-property>
			<property-name>masterControllerName</property-name>
			<value>seller</value>
		</managed-property>
		<managed-property>
			<property-name>propertyMap</property-name>
			<map-entries>
				<map-entry>
					<key>id</key>
					<value>registry.id</value>
				</map-entry>
			</map-entries>
		</managed-property>		
		<managed-property>
			<property-name>listenerClasses</property-name>
			<list-entries>
				<value-class>com.code.aon.ui.form.event.IControllerListener</value-class>
				<value>#{sellerAddressControllerListener}</value>
			</list-entries>
		</managed-property>
	</managed-bean>
	
	<managed-bean>
		<managed-bean-name>sellerAddressControllerListener</managed-bean-name>
		<managed-bean-class> com.code.aon.ui.registry.controller.event.RegistryAddressControllerListener</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
	</managed-bean>

	<!--  **** SELLER MEDIA **** -->

	<managed-bean>
		<managed-bean-name>sellerMedia</managed-bean-name>
		<managed-bean-class>com.code.aon.ui.registry.controller.RegistryMediaController</managed-bean-class>		
		<managed-bean-scope>session</managed-bean-scope>
		<managed-property>
			<property-name>pojo</property-name>
			<value>com.code.aon.registry.RegistryMedia</value>
		</managed-property>
		<managed-property>
			<property-name>beanName</property-name>
			<value>sellerMedia</value>
		</managed-property>
		<managed-property>
			<property-name>cascadeDelete</property-name>
			<value>true</value>
		</managed-property>
		<managed-property>
			<property-name>masterControllerName</property-name>
			<value>seller</value>
		</managed-property>
		<managed-property>
			<property-name>propertyMap</property-name>
			<map-entries>
				<map-entry>
					<key>id</key>
					<value>registry.id</value>
				</map-entry>
			</map-entries>
		</managed-property>		
	</managed-bean>
	
	<!--  **** SELLER ADDINFO **** -->
	<managed-bean>
		<managed-bean-name>sellerAddInfo</managed-bean-name>
		<managed-bean-class>com.code.aon.ui.form.LinesController</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
		<managed-property>
			<property-name>pojo</property-name>
			<value>com.code.aon.registry.RegistryAddInfo</value>
		</managed-property>
		<managed-property>
			<property-name>beanName</property-name>
			<value>sellerAddInfo</value>
		</managed-property>
		<managed-property>
			<property-name>defaultOrder</property-name>
			<value>RegistryAddInfo_attribute,RegistryAddInfo_value</value>
		</managed-property>
		<managed-property>
			<property-name>cascadeDelete</property-name>
			<value>true</value>
		</managed-property>
		<managed-property>
			<property-name>masterControllerName</property-name>
			<value>seller</value>
		</managed-property>
		<managed-property>
			<property-name>propertyMap</property-name>
			<map-entries>
				<map-entry>
					<key>id</key>
					<value>registry.id</value>
				</map-entry>
			</map-entries>
		</managed-property>		
	</managed-bean>

	<managed-bean>
		<managed-bean-name>sellerAddInfoListener</managed-bean-name>
		<managed-bean-class>com.code.aon.ui.form.listener.LinesControllerListener</managed-bean-class>		
		<managed-bean-scope>none</managed-bean-scope>
		<managed-property>
			<property-name>childBean</property-name>
			<value>sellerAddInfo</value>
		</managed-property>
		<managed-property>
			<property-name>aliasMap</property-name>
			<map-entries>
				<map-entry>
					<key>RegistryAddInfo_registry_id</key>
					<value>id</value>
				</map-entry>
			</map-entries>
		</managed-property>
	</managed-bean>

	<!-- **** SELLER DOCUMENTS **** --> 
	<managed-bean>
		<managed-bean-name>sellerRAttach</managed-bean-name>
		<managed-bean-class>
			com.code.aon.ui.registry.controller.RegistryAttachController
		</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
		<managed-property>
			<property-name>queryOnStartUP</property-name>
			<value>true</value>
		</managed-property>
		<managed-property>
			<property-name>pojo</property-name>
			<value>com.code.aon.registry.RegistryAttachment</value>
		</managed-property>
		<managed-property>
			<property-name>beanName</property-name>
			<value>sellerRAttach</value>
		</managed-property>
		<managed-property>
			<property-name>defaultOrder</property-name>
			<value>RegistryAttachment_category&lt;name,RegistryAttachment_description</value>
		</managed-property>
		<managed-property>
			<property-name>type</property-name>
			<value>#{registryCollections.registryAttachmentTypes[5].value}</value>
		</managed-property>
		<managed-property>
			<property-name>cascadeDelete</property-name>
			<value>true</value>
		</managed-property>
		<managed-property>
			<property-name>masterControllerName</property-name>
			<value>seller</value>
		</managed-property>
		<managed-property>
			<property-name>propertyMap</property-name>
			<map-entries>
				<map-entry>
					<key>id</key>
					<value>registry.id</value>
				</map-entry>
			</map-entries>
		</managed-property>				
		<managed-property>
			<property-name>listenerClasses</property-name>
			<list-entries>
				<value-class>com.code.aon.ui.form.event.IControllerListener</value-class>
				<value>#{sellerRAttachControllerListener}</value> 
				<value>#{sellerRAttachScopeListener}</value>
			</list-entries>
		</managed-property>
	</managed-bean>
	
	<managed-bean>
		<managed-bean-name>sellerRAttachControllerListener</managed-bean-name>
		<managed-bean-class>
			com.code.aon.ui.registry.controller.event.RegistryAttachControllerListener
		</managed-bean-class>
		<managed-bean-scope>none</managed-bean-scope>
	</managed-bean>
	
	<managed-bean>
		<managed-bean-name>sellerRAttachScopeListener</managed-bean-name>
		<managed-bean-class>com.code.aon.ui.config.event.ScopeFilterListener</managed-bean-class>
		<managed-bean-scope>none</managed-bean-scope>
		<managed-property>
			<property-name>aliasName</property-name>
			<value>RegistryAttachment_scope_id</value>
		</managed-property>
	</managed-bean>
	
	<managed-bean>
		<managed-bean-name>sellerRAttachChildListener</managed-bean-name>
		<managed-bean-class>
			com.code.aon.ui.form.listener.LinesControllerListener
		</managed-bean-class>
		<managed-bean-scope>none</managed-bean-scope>
		<managed-property>
			<property-name>childBean</property-name>
			<value>sellerRAttach</value>
		</managed-property>
		<managed-property>
			<property-name>aliasMap</property-name>
			<map-entries>
				<map-entry>
					<key>RegistryAttachment_registry_id</key>
					<value>id</value>
				</map-entry>
			</map-entries>
		</managed-property>
	</managed-bean>
		
	<!-- ************ SELLER LOOKUP ************** -->
	<managed-bean>
		<managed-bean-name>sellerLookup</managed-bean-name>
		<managed-bean-class>com.code.aon.ui.registry.controller.RegistryRichLookupBean</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
		<managed-property>
			<property-name>beanName</property-name>
			<value>sellerLookup</value>
		</managed-property>
		<managed-property>
			<property-name>foreignPojo</property-name>
			<value>com.code.aon.seller.Seller</value>
		</managed-property>
		<managed-property>
			<property-name>defaultOrder</property-name>
			<value>Seller_registry_name</value>
		</managed-property>
		<managed-property>
			<property-name>suggestAlias</property-name>
			<value>Seller_registry_name,Seller_registry_document</value>
		</managed-property>			
		<managed-property>
			<property-name>listPagePath</property-name>
			<value>/com/code/aon/ui/seller/facelet/seller/listBasic.xhtml</value>
		</managed-property>
		<managed-property>
			<property-name>searchPagePath</property-name>
			<value>/com/code/aon/ui/seller/facelet/seller/searchBasicContent.xhtml</value>
		</managed-property>		
		<managed-property>
			<property-name>newPagePath</property-name>
			<value>/com/code/aon/ui/seller/facelet/seller/formNewContent.xhtml</value>
		</managed-property>
		<managed-property>
			<property-name>listenerClasses</property-name>
			<list-entries>
				<value-class>com.code.aon.ui.form.event.IControllerListener</value-class>
				<value>#{sellerSearch}</value>
				<value>#{sellerForm}</value>
				<value>#{sellerScopeListener}</value>				
			</list-entries>
		</managed-property>				
	</managed-bean>
	
	<managed-bean>
		<managed-bean-name>sellerForm</managed-bean-name>
		<managed-bean-class>com.code.aon.ui.registry.controller.event.RegistryFormListener</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
	</managed-bean>	

   	<!-- ************* NAVIGATION RULES ***************** -->
	<navigation-rule>
		<navigation-case>
			<from-outcome>seller_list</from-outcome>
			<to-view-id>/com/code/aon/ui/seller/facelet/seller/list.xhtml</to-view-id>
		</navigation-case>
		<navigation-case>
			<from-outcome>seller_form</from-outcome>
			<to-view-id>/com/code/aon/ui/seller/facelet/seller/form.xhtml</to-view-id>
		</navigation-case>
		<navigation-case>
			<from-outcome>seller_search</from-outcome>
			<to-view-id>/com/code/aon/ui/seller/facelet/seller/search.xhtml</to-view-id>
		</navigation-case>
	</navigation-rule>		
	
</faces-config>