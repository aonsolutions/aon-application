<?xml version="1.0" encoding="ISO-8859-1"?>
<!DOCTYPE report-config 
	PUBLIC "-//CODE-AON//DTD Report Config//EN" 
	"http://co-de.com/aon/report-config.dtd">

<report-config>
	<default-config>
		<fetch-mode paginated="false" />
	</default-config>

	<!--  **********************************************************
						      DailyTracking
		  ********************************************************** -->
	<report id="dailyTrackingExcel" description="DailyTracking report To Excel">
		<template path="/com/code/aon/ui/groupware/report/dailyTrackingExcel.jasper" />
		<collection provider="#{dailyTrackingReport}"/>
		<params>
			<param id="REPORT_RESOURCE_BUNDLE" value="com.code.aon.common.i18n.messages" />
		</params>
	</report>

