	<!--  **********************************************************
						      TASK INBOX
		  ********************************************************** -->
	<report id="taskInbox" description="Task Inbox List">
		<template path="/com/code/aon/ui/groupware/report/taskInbox.jasper"/>
		<bean key="com.code.aon.groupware.Task" />
		<criteria provider="#{task}"/>
		<params>
			<param id="REPORT_RESOURCE_BUNDLE" value="com.code.aon.common.i18n.messages" />
			<param id="company" value="#{company.obtainCompany}" />
