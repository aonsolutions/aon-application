<faces-config version="1.2"
	xmlns="http://java.sun.com/xml/ns/javaee"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://java.sun.com/xml/ns/javaee http://java.sun.com/xml/ns/javaee/web-facesconfig_1_2.xsd">

	<application>
		<resource-bundle>
		   <base-name>com.code.aon.ui.groupware.i18n.messages</base-name>
		   <var>groupwareBundle</var>
		</resource-bundle>
	</application>

	<!--  *************** COLLECTIONS ***************** -->
	<managed-bean>
		<managed-bean-name>groupWareCollections</managed-bean-name>
		<managed-bean-class>
			com.code.aon.ui.groupware.controller.GroupWareCollectionsController
		</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
	</managed-bean>

	
	<!-- ************* ALARM ***************** -->
	<managed-bean>
		<managed-bean-name>alarm</managed-bean-name>
		<managed-bean-class>
			com.code.aon.ui.groupware.controller.AlarmController
		</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
		<managed-property>
			<property-name>queryOnStartUP</property-name>
			<value>true</value>
		</managed-property>
		<managed-property>
			<property-name>pojo</property-name>
			<value>com.code.aon.groupware.Alarm</value>
		</managed-property>
		<managed-property>
			<property-name>beanName</property-name>
			<value>alarm</value>
		</managed-property>		
	</managed-bean>

	
	<!-- ************* NOTE ***************** -->
	<managed-bean>
		<managed-bean-name>note</managed-bean-name>
		<managed-bean-class>
			com.code.aon.ui.groupware.controller.NoteController
		</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
		<managed-property>
			<property-name>queryOnStartUP</property-name>
			<value>true</value>
		</managed-property>
		<managed-property>
			<property-name>pojo</property-name>
			<value>com.code.aon.groupware.Note</value>
		</managed-property>
		<managed-property>
			<property-name>beanName</property-name>
			<value>note</value>
		</managed-property>				
		<managed-property>
			<property-name>defaultOrder</property-name>
			<value>Note_date</value>
		</managed-property>		
		<managed-property>
			<property-name>defaultExpressions</property-name>
			<map-entries>
				<map-entry>
					<key>Note_owner_id</key>
					<value>#{userUtils.loggedUser.id}</value>
				</map-entry>
			</map-entries>
		</managed-property>		
		<managed-property>
			<property-name>listenerClasses</property-name>
			<list-entries>
				<value-class>com.code.aon.ui.form.event.IControllerListener</value-class>
				<value>#{noteControllerListener}</value>
			</list-entries>
		</managed-property>
	</managed-bean>
	
	<managed-bean>
		<managed-bean-name>noteControllerListener</managed-bean-name>
		<managed-bean-class>
			com.code.aon.ui.groupware.event.NoteControllerListener
		</managed-bean-class>
		<managed-bean-scope>none</managed-bean-scope>
	</managed-bean>
	
	<!-- ************* NOTICE ***************** -->
	<managed-bean>
		<managed-bean-name>notice</managed-bean-name>
		<managed-bean-class>
			com.code.aon.ui.groupware.controller.NoticeController
		</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
		<managed-property>
			<property-name>queryOnStartUP</property-name>
			<value>true</value>
		</managed-property>
		<managed-property>
			<property-name>pojo</property-name>
			<value>com.code.aon.groupware.Notice</value>
		</managed-property>
		<managed-property>
			<property-name>beanName</property-name>
			<value>notice</value>
		</managed-property>						
		<managed-property>
			<property-name>defaultOrder</property-name>
			<value>Notice_date DESC</value>
		</managed-property>		
		<managed-property>
			<property-name>defaultExpressions</property-name>
			<map-entries>
				<map-entry>
					<key>Notice_sender_id</key>
					<value>#{userUtils.loggedUser.id}</value>
				</map-entry>
			</map-entries>
		</managed-property>				
		<managed-property>
			<property-name>listenerClasses</property-name>
			<list-entries>
				<value-class>com.code.aon.ui.form.event.IControllerListener</value-class>
				<value>#{noticeControllerListener}</value>
			</list-entries>
		</managed-property>
	</managed-bean>
	
	<managed-bean>
		<managed-bean-name>noticeControllerListener</managed-bean-name>
		<managed-bean-class>
			com.code.aon.ui.groupware.event.NoticeControllerListener
		</managed-bean-class>
		<managed-bean-scope>none</managed-bean-scope>
	</managed-bean>
	
	<!-- ************* CONTACT ***************** -->
	<managed-bean>
		<managed-bean-name>contact</managed-bean-name>
		<managed-bean-class>
			com.code.aon.ui.groupware.controller.ContactController
		</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
		<managed-property>
			<property-name>queryOnStartUP</property-name>
			<value>true</value>
		</managed-property>
		<managed-property>
			<property-name>pojo</property-name>
			<value>com.code.aon.groupware.Contact</value>
		</managed-property>
		<managed-property>
			<property-name>beanName</property-name>
			<value>contact</value>
		</managed-property>								
		<managed-property>
			<property-name>defaultOrder</property-name>
			<value>Contact_displayName</value>
		</managed-property>
	</managed-bean>
	
	
	<!-- ************* FAVORITE ***************** -->
	<managed-bean>
		<managed-bean-name>favorite</managed-bean-name>
		<managed-bean-class>
			com.code.aon.ui.form.BasicController
		</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
		<managed-property>
			<property-name>queryOnStartUP</property-name>
			<value>true</value>
		</managed-property>
		<managed-property>
			<property-name>pojo</property-name>
			<value>com.code.aon.groupware.Favorite</value>
		</managed-property>
		<managed-property>
			<property-name>beanName</property-name>
			<value>favorite</value>
		</managed-property>										
		<managed-property>
			<property-name>defaultOrder</property-name>
			<value>Favorite_favoriteCategory_id,Favorite_description</value>
		</managed-property>		
		<managed-property>
			<property-name>defaultExpressions</property-name>
			<map-entries>
				<map-entry>
					<key>Favorite_user_id</key>
					<value>#{userUtils.loggedUser.id}</value>
				</map-entry>
			</map-entries>
		</managed-property>								
		<managed-property>
			<property-name>listenerClasses</property-name>
			<list-entries>
				<value-class>com.code.aon.ui.form.event.IControllerListener</value-class>
				<value>#{favoriteControllerListener}</value>
			</list-entries>
		</managed-property>
	</managed-bean>
	
	<managed-bean>
		<managed-bean-name>favoriteControllerListener</managed-bean-name>
		<managed-bean-class>
			com.code.aon.ui.groupware.event.FavoriteControllerListener
		</managed-bean-class>
		<managed-bean-scope>none</managed-bean-scope>
	</managed-bean>

	<!-- ************* FAVORITE CATEGORY ***************** -->
	<managed-bean>
		<managed-bean-name>favoriteCategory</managed-bean-name>
		<managed-bean-class>
			com.code.aon.ui.form.BasicController
		</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
		<managed-property>
			<property-name>queryOnStartUP</property-name>
			<value>true</value>
		</managed-property>
		<managed-property>
			<property-name>pojo</property-name>
			<value>com.code.aon.groupware.FavoriteCategory</value>
		</managed-property>
		<managed-property>
			<property-name>beanName</property-name>
			<value>favoriteCategory</value>
		</managed-property>												
		<managed-property>
			<property-name>defaultOrder</property-name>
			<value>FavoriteCategory_description</value>
		</managed-property>		
		<managed-property>
			<property-name>defaultExpressions</property-name>
			<map-entries>
				<map-entry>
					<key>FavoriteCategory_user_id</key>
					<value>#{userUtils.loggedUser.id}</value>
				</map-entry>
			</map-entries>
		</managed-property>						
		<managed-property>
			<property-name>listenerClasses</property-name>
			<list-entries>
				<value-class>com.code.aon.ui.form.event.IControllerListener</value-class>
				<value>#{favoriteCategoryControllerListener}</value>
			</list-entries>
		</managed-property>
	</managed-bean>
	
	<managed-bean>
		<managed-bean-name>favoriteCategoryControllerListener</managed-bean-name>
		<managed-bean-class>
			com.code.aon.ui.groupware.event.FavoriteCategoryControllerListener
		</managed-bean-class>
		<managed-bean-scope>none</managed-bean-scope>
	</managed-bean>
	
	<!-- =================== Note ================= -->	
	<navigation-rule>
		<navigation-case>
			<from-outcome>note_form</from-outcome>
			<to-view-id>/com/code/aon/ui/groupware/facelet/note/form.xhtml</to-view-id>
		</navigation-case>
		<navigation-case>
			<from-outcome>note_list</from-outcome>
			<to-view-id>/com/code/aon/ui/groupware/facelet/note/list.xhtml</to-view-id>
		</navigation-case>
		<navigation-case>
	        <from-outcome>note_search</from-outcome>
	        <to-view-id>/com/code/aon/ui/groupware/facelet/note/search.xhtml</to-view-id>
	    </navigation-case>
	</navigation-rule>

	<!-- =================== Notice ================= -->	
	<navigation-rule>
		<navigation-case>
			<from-outcome>notice_form</from-outcome>
			<to-view-id>/com/code/aon/ui/groupware/facelet/notice/form.xhtml</to-view-id>
		</navigation-case>
		<navigation-case>
			<from-outcome>notice_list</from-outcome>
			<to-view-id>/com/code/aon/ui/groupware/facelet/notice/list.xhtml</to-view-id>
		</navigation-case>
		<navigation-case>
			<from-outcome>notice_search</from-outcome>
			<to-view-id>/com/code/aon/ui/groupware/facelet/notice/search.xhtml</to-view-id>
		</navigation-case>
	</navigation-rule>
	
	<!-- =================== Alarm ================= -->	
	<navigation-rule>
		<navigation-case>
			<from-outcome>alarm_list</from-outcome>
			<to-view-id>/com/code/aon/ui/groupware/facelet/alarm/list.xhtml</to-view-id>
		</navigation-case>
	 	<navigation-case>
	        <from-outcome>alarm_form</from-outcome>
	        <to-view-id>/com/code/aon/ui/groupware/facelet/alarm/form.xhtml</to-view-id>
	    </navigation-case>
	</navigation-rule>
	
	<!-- =================== Contact ================= -->	
	<navigation-rule>
		<navigation-case>
			<from-outcome>contact_form</from-outcome>
			<to-view-id>/com/code/aon/ui/groupware/facelet/contact/form.xhtml</to-view-id>
		</navigation-case>
		<navigation-case>
			<from-outcome>contact_list</from-outcome>
			<to-view-id>/com/code/aon/ui/groupware/facelet/contact/list.xhtml</to-view-id>
		</navigation-case>
		<navigation-case>
	        <from-outcome>contact_search</from-outcome>
	        <to-view-id>/com/code/aon/ui/groupware/facelet/contact/search.xhtml</to-view-id>
	    </navigation-case>
	</navigation-rule>
	
	<!-- =================== Favorite ================= -->	
	<navigation-rule>
		<navigation-case>
			<from-outcome>favorite_form</from-outcome>
			<to-view-id>/com/code/aon/ui/groupware/facelet/favorite/form.xhtml</to-view-id>
		</navigation-case>
		<navigation-case>
			<from-outcome>favorite_list</from-outcome>
			<to-view-id>/com/code/aon/ui/groupware/facelet/favorite/list.xhtml</to-view-id>
		</navigation-case>
		<navigation-case>
	        <from-outcome>favorite_search</from-outcome>
	        <to-view-id>/com/code/aon/ui/groupware/facelet/favorite/search.xhtml</to-view-id>
	    </navigation-case>
	</navigation-rule>

  <!-- =================== Application Menu Navigation Rules ================= -->	
  <navigation-rule>
    <navigation-case>
        <from-outcome>note</from-outcome>
        <to-view-id>/com/code/aon/ui/groupware/facelet/note/list.xhtml</to-view-id>
    </navigation-case>
    <navigation-case>
        <from-outcome>notice</from-outcome>
        <to-view-id>/com/code/aon/ui/groupware/facelet/notice/list.xhtml</to-view-id>
    </navigation-case>
 	<navigation-case>
        <from-outcome>alarm</from-outcome>
        <to-view-id>/com/code/aon/ui/groupware/facelet/alarm/list.xhtml</to-view-id>
    </navigation-case>
    <navigation-case>
        <from-outcome>contact</from-outcome>
        <to-view-id>/com/code/aon/ui/groupware/facelet/contact/list.xhtml</to-view-id>
    </navigation-case>
    <navigation-case>
        <from-outcome>favorite</from-outcome>
        <to-view-id>/com/code/aon/ui/groupware/facelet/favorite/list.xhtml</to-view-id>
    </navigation-case>
    <navigation-case>
        <from-outcome>favorite_category</from-outcome>
        <to-view-id>/com/code/aon/ui/groupware/facelet/favorite/category/grid.xhtml</to-view-id>
    </navigation-case>
  </navigation-rule>
</faces-config>