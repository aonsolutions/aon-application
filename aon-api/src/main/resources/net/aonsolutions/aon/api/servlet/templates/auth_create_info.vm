<html>
<head></head>
<body style="font-family: Arial, sans-serif; margin: 0; padding: 10px 0; color: #333;">
    <table align="center" width="100%"; padding: 20px;">
        <tr>
            <td align="center">
                <table style="max-width: 650px; width: 100%; background-color: rgba(241, 240, 232, 0.1); border: 1px solid rgba(0, 0, 0, 0.1); border-radius: 10px; padding: 10px 15px;" cellpadding="0" cellspacing="0">
                    <!-- Header -->
                    <tr>
                        <td align="center" style="padding: 20px;">
                            <img src="$logo" alt="$parentName" style="max-width: 200px; border-radius: 10px;">
                        </td>
                    </tr>
                    <!-- Title -->
                    <tr>
                        <td align="center" style="padding: 0 20px;">
                            <h2 style="color: #333; font-size: 18px; margin: 0 0 10px;">Creación/Actualización de cuenta</h2>
                            <h3 style="color: #555; font-size: 16px; margin: 0;">$fullName</h3>
                        </td>
                    </tr>
                    <!-- Body -->
                    <tr>
                        <td style="font-size: 14px; color: #555; line-height: 1.6; padding: 20px;">
                            <p style="margin: 0 0 10px;">¡Enhorabuena! Acabamos de crear o actualizar la cuenta de acceso:</p>
                            <p style="margin: 0 0 10px;">
                                <strong style="color: #333;">Web:</strong> 
                                <a href="$enterpriseUrl" style="color: #007bff; text-decoration: none;">$enterpriseName</a>
                            </p>
                            <p style="margin: 0 0 10px;">
                                <strong style="color: #333;">Usuario:</strong> <span><a style="color: #007bff; text-decoration: none;" href="mailto:$email">$email</a></span>
                            </p>
                            <p style="margin: 0 0 10px;">
                                <strong style="color: #333;">Contraseña:</strong> 
                                <span>$password</span>
                            </p>
                        </td>
                    </tr>
                    <!-- Footer -->
                    <tr>
                        <td align="center" style="font-size: 12px; color: #888; padding: 20px;">
                            <p style="margin: 0;">Si tienes alguna duda, por favor contacta con soporte: 
                            	<a style="color: #007bff; text-decoration: none;" href="mailto:$contact">$contact</a>.
                            </p>
                        </td>
                    </tr>
                </table>
            </td>
        </tr>
    </table>
</body>
</html>
