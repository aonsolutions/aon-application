<html>
<head>
	<style>
	</style>
</head>
<body>

	<div style="background-color: #f9f9f9; padding: 20px; border-radius: 10px; max-width: 600px; margin: 0 auto; box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);">
  
	  <!-- Imagen del logo al principio -->
	  <div style="text-align: center; margin-bottom: 20px;">
	    <img src="$logo" alt="$parentName" style="max-width: 200px; border-radius: 10px;">
	  </div>
	
	  <h2 style="text-align: center; color: #333;">Confirmación Creación de Empresa: <strong>$name</strong></h2>
	
	  <p style="font-size: 14px; color: #555; margin-top: 20px;">
	    ¡Enhorabuena!, Acabamos de crear su empresa para que pueda emitir y registrar facturas gratuitamente con un límite de 50 documentos.
	  </p>
	
	  <p style="font-size: 14px; color: #555; margin-top: 20px;">
	    A continuación le detallamos los datos de acceso:
	  </p>
	
	  <p style="font-size: 16px; color: #333;">
	    <strong>Link Web:</strong>
	    <a href="$url" 
	       id="url-empresa" 
	       style="color: #007bff;">
	      $domainName
	    </a>
	  </p>
	
	  <p style="font-size: 16px; color: #333;">
	    <strong>Usuario:</strong> <span id="usuario">$user</span>
	  </p>
	
	  <!-- Contraseña dependiendo de authExisted -->
	  <p style="font-size: 16px; color: #333;">
	    <strong>Contraseña:</strong> 
	    <span id="contraseña">$password</span>
	  </p>
	
	  <p style="font-size: 12px; color: #666; text-align: center; margin-top: 20px;">
	    Si tienes alguna duda, por favor contacta con soporte ($contact).
	  </p>
	</div>




</body>
</html>