<?xml version="1.0" encoding="ISO-8859-1"?>

<!DOCTYPE report-config 
	PUBLIC "-//CODE-AON//DTD Report Config//EN" 
	"http://co-de.com/aon/report-config.dtd">

<report-config>
	<!--  ********* Product list ********* -->
	<report id="productList" description="Product's List">
		<template path="/com/code/aon/ui/product/report/productList.jasper"/>
		<bean key="com.code.aon.product.Product" />
		<criteria provider="#{product}"/>
		<fetch-mode paginated="true" page-count="500" virtualizer-max-size="50"/>
		<params>
			<param id="REPORT_RESOURCE_BUNDLE" value="com.code.aon.common.i18n.messages" />
			<param id="company" value="#{company.obtainCompany}" />
			<param id="logoImageFile" value="#{company.getAttachAsInputStream}" />
		</params>
	</report>

	<!--  *********  Listado de Catalogos ********* -->
	<report id="catalogueItemList" description="Catalogue items List">
		<template path="/com/code/aon/ui/product/report/catalogueItem.jasper"/>
		<bean key="com.code.aon.product.CatalogueItem" />
		<criteria provider="#{catalogueItem}"/>
		<fetch-mode paginated="true" page-count="500" virtualizer-max-size="50"/>
		<params>
			<param id="REPORT_RESOURCE_BUNDLE" value="com.code.aon.common.i18n.messages" />
			<param id="company" value="#{company.obtainCompany}" />
			<param id="logoImageFile" value="#{company.getAttachAsInputStream}" />
		</params>
	</report>
	
	<!--  *********  Listado de Tarifas ********* -->
	<report id="tariffList" description="Tariff List">
		<template path="/com/code/aon/ui/product/report/tariffList.jasper"/>
		<bean key="com.code.aon.config.Tariff" />
		<criteria provider="#{tariff}"/>
		<params>
			<param id="REPORT_RESOURCE_BUNDLE" value="com.code.aon.common.i18n.messages" />
			<param id="company" value="#{company.obtainCompany}" />
			<param id="logoImageFile" value="#{company.getAttachAsInputStream}" />
		</params>
	</report>
	
	<!--  *********  Listado de productos de catalogo ********* -->
	<report id="itemCatalogueReport" description="Catalogue items List">
		<template path="/com/code/aon/ui/product/report/itemCatalogueReport.jasper"/>
		<collection provider="#{itemCatalogueReport}"/>
		<params>
			<param id="REPORT_RESOURCE_BUNDLE" value="com.code.aon.common.i18n.messages" />
			<param id="company" value="#{company.obtainCompany}" />
			<param id="logoImageFile" value="#{company.getAttachAsInputStream}" />
		</params>
	</report>
	
	<!--  *********  Listado de etiquetas********* -->
	<report id="itemTag_525x297" description="Product Tag (525x297) item List">
		<template path="/com/code/aon/ui/product/report/itemTag_525x297.jasper"/>
		<collection provider="#{itemTagPrint}"/>
		<params>
			<param id="REPORT_RESOURCE_BUNDLE" value="com.code.aon.common.i18n.messages" />
			<param id="freeText" value="#{itemTagPrint.getFreeTextAll}" />
		</params>
	</report>
	<report id="itemTag_505x255_1_column" description="Product Tag (Zebra 505x255) item List">
		<template path="/com/code/aon/ui/product/report/itemTag_505x255_1_column.jasper"/>
		<collection provider="#{itemTagPrint}"/>
		<params>
			<param id="REPORT_RESOURCE_BUNDLE" value="com.code.aon.common.i18n.messages" />
			<param id="freeText" value="#{itemTagPrint.getFreeTextAll}" />
		</params>
	</report>
	<report id="itemTag_1016x762_1_column" description="Product Tag (Zebra 1016x762) item List">
		<template path="/com/code/aon/ui/product/report/itemTag_1016x762_1_column.jasper"/>
		<collection provider="#{itemTagPrint}"/>
		<params>
			<param id="REPORT_RESOURCE_BUNDLE" value="com.code.aon.common.i18n.messages" />
			<param id="barcodePattern" value="#{company.getItemTagBarcodePattern}" />
			<param id="freeText" value="#{itemTagPrint.getFreeTextAll}" />
		</params>
	</report>
	
</report-config>