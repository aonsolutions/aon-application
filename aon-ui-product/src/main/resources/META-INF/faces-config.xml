<faces-config version="1.2" xmlns="http://java.sun.com/xml/ns/javaee" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://java.sun.com/xml/ns/javaee http://java.sun.com/xml/ns/javaee/web-facesconfig_1_2.xsd">

	<!--  **** PRODUCT COLLECTIONS ****	-->
	<managed-bean>
		<managed-bean-name>productCollections</managed-bean-name>
		<managed-bean-class>
			com.code.aon.ui.product.controller.ProductCollectionsController
		</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
	</managed-bean>

	<!--  **** TAX ****	-->
	<managed-bean>
		<managed-bean-name>tax</managed-bean-name>
		<managed-bean-class>com.code.aon.ui.product.controller.TaxController 
		</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
		<managed-property>
			<property-name>queryOnStartUP</property-name>
			<value>true</value>
		</managed-property>
		<managed-property>
			<property-name>pojo</property-name>
			<value>com.code.aon.product.Tax</value>
		</managed-property>
		<managed-property>
			<property-name>listenerClasses</property-name>
			<list-entries>
				<value-class>com.code.aon.ui.form.event.IControllerListener 
				</value-class>
				<value>#{taxDetailListener}</value>
			</list-entries>
		</managed-property>
	</managed-bean>
	<managed-bean>
		<managed-bean-name>taxDetailListener</managed-bean-name>
		<managed-bean-class> com.code.aon.ui.form.listener.LinesControllerListener</managed-bean-class>
		<managed-bean-scope>none</managed-bean-scope>
		<managed-property>
			<property-name>childBean</property-name>
			<value>taxDetail</value>
		</managed-property>
		<managed-property>
			<property-name>aliasMap</property-name>
			<map-entries>
				<map-entry>
					<key>TaxDetail_tax_id</key>
					<value>id</value>
				</map-entry>
			</map-entries>
		</managed-property>
	</managed-bean>
	<managed-bean>
		<managed-bean-name>taxDetail</managed-bean-name>
		<managed-bean-class>com.code.aon.ui.form.LinesController 
		</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
		<managed-property>
			<property-name>queryOnStartUP</property-name>
			<value>true</value>
		</managed-property>
		<managed-property>
			<property-name>pojo</property-name>
			<value>com.code.aon.product.TaxDetail</value>
		</managed-property>
		<managed-property>
			<property-name>masterControllerName</property-name>
			<value>tax</value>
		</managed-property>
		<managed-property>
			<property-name>propertyMap</property-name>
			<map-entries>
				<map-entry>
					<key>id</key>
					<value>tax.id</value>
				</map-entry>
			</map-entries>
		</managed-property>
		<managed-property>
			<property-name>cascadeDelete</property-name>
			<value>true</value>
		</managed-property>
	</managed-bean>

   	<!-- ************* NAVIGATION RULES ***************** -->
	<navigation-rule>
      <navigation-case>
         <from-outcome>tax</from-outcome>
         <to-view-id>/com/code/aon/ui/product/facelet/tax/grid.xhtml</to-view-id>
      </navigation-case>
   </navigation-rule>
</faces-config>