
<faces-config version="1.2"
	xmlns="http://java.sun.com/xml/ns/javaee"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://java.sun.com/xml/ns/javaee http://java.sun.com/xml/ns/javaee/web-facesconfig_1_2.xsd">

	<!-- ********* ITransferObject CONVERTER ************* -->
	<converter>
	 <converter-for-class>com.code.aon.common.ITransferObject</converter-for-class>
	 <converter-class>com.code.aon.ui.common.converter.TransferObjectConverter</converter-class>
	</converter>

   	<!-- ************* ENUM CONVERTER ***************** -->
	<converter>
		<description>Conversor para intenacionalizar las opciones de los enumerados.</description>
		<converter-for-class>com.code.aon.common.enumeration.IResourceable</converter-for-class>
		<converter-class>com.code.aon.ui.common.converter.EnumLocaleConverter</converter-class>
	</converter>
	
	<!-- ************ TIMEZONE CONTROLLER	************** -->
	<managed-bean>
		<managed-bean-name>timeZoneController</managed-bean-name>
		<managed-bean-class> com.code.aon.ui.common.controller.TimeZoneController</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
	</managed-bean>

	<!-- ************** EXCEPTION HANDLER ****************** -->
	<managed-bean>
		<managed-bean-name>exceptionBean</managed-bean-name>
		<managed-bean-class>com.code.aon.ui.common.controller.ExceptionBean
		</managed-bean-class>
		<managed-bean-scope>request</managed-bean-scope>
	</managed-bean>

	<!--  *************** COLLECTIONS ***************** -->
	<managed-bean>
		<managed-bean-name>commonCollections</managed-bean-name>
		<managed-bean-class>com.code.aon.ui.common.controller.CommonCollections</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
	</managed-bean>

	<!--  *************** NULL ITEM ***************** -->
	<managed-bean>
		<managed-bean-name>nullItem</managed-bean-name>
		<managed-bean-class> com.code.aon.ui.common.controller.NullSelectItemController 
		</managed-bean-class>
		<managed-bean-scope>application</managed-bean-scope>
	</managed-bean>

</faces-config>