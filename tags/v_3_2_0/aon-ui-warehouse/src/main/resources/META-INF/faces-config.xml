<faces-config version="1.2"
	xmlns="http://java.sun.com/xml/ns/javaee"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://java.sun.com/xml/ns/javaee http://java.sun.com/xml/ns/javaee/web-facesconfig_1_2.xsd">

	<application>
		<resource-bundle>
			<base-name>com.code.aon.ui.warehouse.i18n.messages</base-name>
			<var>warehouseBundle</var>
		</resource-bundle>
	</application>

	<!-- ************ COLLECTIONS **************** -->
	<managed-bean>
		<managed-bean-name>warehouseCollections</managed-bean-name>
		<managed-bean-class>
			com.code.aon.ui.warehouse.controller.WarehouseCollectionsController
		</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
	</managed-bean>

	<!-- *********** WAREHOUSE ************ -->
	<managed-bean>
		<managed-bean-name>warehouse</managed-bean-name>
		<managed-bean-class>com.code.aon.ui.form.BasicController</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
		<managed-property>
			<property-name>queryOnStartUP</property-name>
			<value>true</value>
		</managed-property>
		<managed-property>
			<property-name>pojo</property-name>
			<value>com.code.aon.warehouse.Warehouse</value>
		</managed-property>
		<managed-property>
			<property-name>beanName</property-name>
			<value>warehouse</value>
		</managed-property>		
	</managed-bean>

	<!--  **** INVENTORY **** -->
	<managed-bean>
		<managed-bean-name>inventory</managed-bean-name>
		<managed-bean-class>com.code.aon.ui.warehouse.controller.InventoryController</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
		<managed-property>
			<property-name>queryOnStartUP</property-name>
			<value>true</value>
		</managed-property>
		<managed-property>
			<property-name>pojo</property-name>
			<value>com.code.aon.warehouse.Inventory</value>
		</managed-property>
		<managed-property>
			<property-name>beanName</property-name>
			<value>inventory</value>
		</managed-property>				
		<managed-property>
			<property-name>listenerClasses</property-name>
			<list-entries>
				<value-class>com.code.aon.ui.form.event.IControllerListener</value-class>
				<value>#{inventoryDetailListener}</value>
			</list-entries>
		</managed-property>
	</managed-bean>

	<managed-bean>
		<managed-bean-name>inventoryDetailListener</managed-bean-name>
		<managed-bean-class>com.code.aon.ui.form.listener.LinesControllerListener</managed-bean-class>		
		<managed-bean-scope>none</managed-bean-scope>
		<managed-property>
			<property-name>childBean</property-name>
			<value>inventoryDetail</value>
		</managed-property>
		<managed-property>
			<property-name>aliasMap</property-name>
			<map-entries>
				<map-entry>
					<key>InventoryDetail_inventory_id</key>
                    <value>id</value>
				</map-entry>
			</map-entries>
		</managed-property>
	</managed-bean>

	<!--  **** INVENTORYDETAIL **** -->

	<managed-bean>
		<managed-bean-name>inventoryDetail</managed-bean-name>
		<managed-bean-class>
			com.code.aon.ui.warehouse.controller.InventoryDetailController
		</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
		<managed-property>
			<property-name>pojo</property-name>
			<value>com.code.aon.warehouse.InventoryDetail</value>
		</managed-property>
		<managed-property>
			<property-name>beanName</property-name>
			<value>inventoryDetail</value>
		</managed-property>
		<managed-property>
			<property-name>defaultOrder</property-name>
			<value>InventoryDetail_item_product_name</value>
		</managed-property>
		<managed-property>
			<property-name>masterControllerName</property-name>
			<value>inventory</value>
		</managed-property>
		<managed-property>
			<property-name>propertyMap</property-name>
			<map-entries>
				<map-entry>
					<key>id</key>
					<value>inventory.id</value>
				</map-entry>
			</map-entries>
		</managed-property>		
		<managed-property>
			<property-name>listenerClasses</property-name>
			<list-entries>
				<value-class>com.code.aon.ui.form.event.IControllerListener</value-class>
				<value>#{inventoryDetailControllerListener}</value>
			</list-entries>
		</managed-property>
	</managed-bean>

	<managed-bean>
		<managed-bean-name>inventoryDetailControllerListener</managed-bean-name>
		<managed-bean-class>com.code.aon.ui.warehouse.event.InventoryDetailControllerListener</managed-bean-class>
		<managed-bean-scope>none</managed-bean-scope>
	</managed-bean>

	<!-- ************ STOCK ************* -->
	<managed-bean>
		<managed-bean-name>stock</managed-bean-name>
		<managed-bean-class>
			com.code.aon.ui.warehouse.controller.StockController
		</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
		<managed-property>
			<property-name>queryOnStartUP</property-name>
			<value>false</value>
		</managed-property>
		<managed-property>
			<property-name>pojo</property-name>
			<value>com.code.aon.warehouse.Stock</value>
		</managed-property>
		<managed-property>
			<property-name>beanName</property-name>
			<value>stock</value>
		</managed-property>		
		<managed-property>
			<property-name>defaultOrder</property-name>
			<value>Stock_warehouse_id,Stock_item_id</value>
		</managed-property>
		<managed-property>
			<property-name>listenerClasses</property-name>
			<list-entries>
				<value-class>com.code.aon.ui.form.event.IControllerListener</value-class>
				<value>#{stockControllerListener}</value>
				<value>#{stockSearch}</value>
			</list-entries>
		</managed-property>
	</managed-bean>

	<managed-bean>
		<managed-bean-name>stockControllerListener</managed-bean-name>
		<managed-bean-class>com.code.aon.ui.warehouse.event.StockControllerListener</managed-bean-class>
		<managed-bean-scope>none</managed-bean-scope>
	</managed-bean>

	<managed-bean>
		<managed-bean-name>stockSearch</managed-bean-name>
		<managed-bean-class>com.code.aon.ui.warehouse.event.StockSearchListener</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
	</managed-bean>

	<!-- ****** DELIVERY ****** -->
	<managed-bean>
		<managed-bean-name>delivery</managed-bean-name>
		<managed-bean-class>
			com.code.aon.ui.warehouse.controller.DeliveryController
		</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
		<managed-property>
			<property-name>queryOnStartUP</property-name>
			<value>false</value>
		</managed-property>
		<managed-property>
			<property-name>pojo</property-name>
			<value>com.code.aon.warehouse.Delivery</value>
		</managed-property>
		<managed-property>
			<property-name>beanName</property-name>
			<value>delivery</value>
		</managed-property>
		<managed-property>
			<property-name>defaultOrder</property-name>
			<value>Delivery_issueTime,Delivery_series,Delivery_number</value>
		</managed-property>
		<managed-property>
			<property-name>listenerClasses</property-name>
			<list-entries>
				<value-class>
					com.code.aon.ui.form.event.IControllerListener
				</value-class>
				<value>#{deliveryHeaderControllerListener}</value>
				<value>#{deliveryControllerListener}</value>
				<value>#{deliveryDetailChildListener}</value>
			</list-entries>
		</managed-property>
	</managed-bean>

 	<managed-bean>
		<managed-bean-name>deliveryHeaderControllerListener</managed-bean-name>
		<managed-bean-class>com.code.aon.ui.config.event.HeaderControllerListener</managed-bean-class>
		<managed-bean-scope>none</managed-bean-scope>
		<managed-property>
			<property-name>table</property-name>
			<value>Delivery</value>
		</managed-property>
	</managed-bean>

	<managed-bean>
		<managed-bean-name>deliveryControllerListener</managed-bean-name>
		<managed-bean-class>
			com.code.aon.ui.warehouse.event.DeliveryControllerListener
		</managed-bean-class>
		<managed-bean-scope>none</managed-bean-scope>
	</managed-bean>

	<managed-bean>
		<managed-bean-name>deliveryDetailChildListener</managed-bean-name>
		<managed-bean-class>
			com.code.aon.ui.form.listener.LinesControllerListener
		</managed-bean-class>
		<managed-bean-scope>none</managed-bean-scope>
		<managed-property>
			<property-name>childBean</property-name>
			<value>deliveryDetail</value>
		</managed-property>
		<managed-property>
			<property-name>aliasMap</property-name>
			<map-entries>
				<map-entry>
					<key>DeliveryDetail_delivery_id</key>
                    <value>id</value>
				</map-entry>
			</map-entries>
		</managed-property>
	</managed-bean>

	<!-- ****** DELIVERY DETAIL ****** -->
	<managed-bean>
		<managed-bean-name>deliveryDetail</managed-bean-name>
		<managed-bean-class>
			com.code.aon.ui.warehouse.controller.DeliveryDetailController
		</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
		<managed-property>
			<property-name>queryOnStartUP</property-name>
			<value>true</value>
		</managed-property>
		<managed-property>
			<property-name>pojo</property-name>
			<value>com.code.aon.warehouse.DeliveryDetail</value>
		</managed-property>
		<managed-property>
			<property-name>beanName</property-name>
			<value>deliveryDetail</value>
		</managed-property>
		<managed-property>
			<property-name>masterControllerName</property-name>
			<value>delivery</value>
		</managed-property>
		<managed-property>
			<property-name>propertyMap</property-name>
			<map-entries>
				<map-entry>
					<key>id</key>
					<value>delivery.id</value>
				</map-entry>
			</map-entries>
		</managed-property>
		<managed-property>
			<property-name>cascadeDelete</property-name>
			<value>true</value>
		</managed-property>
	</managed-bean>
	
   	<!-- ************* NAVIGATION RULES ***************** -->
	<navigation-rule>
		<navigation-case>
			<from-outcome>warehouse</from-outcome>
			<to-view-id>/com/code/aon/ui/warehouse/facelet/warehouse/grid.xhtml</to-view-id>
		</navigation-case>
		<navigation-case>
			<from-outcome>inventory_search</from-outcome>
			<to-view-id>/com/code/aon/ui/warehouse/facelet/inventory/search.xhtml</to-view-id>
		</navigation-case>
		<navigation-case>
			<from-outcome>inventory_list</from-outcome>
			<to-view-id>/com/code/aon/ui/warehouse/facelet/inventory/list.xhtml</to-view-id>
		</navigation-case>
		<navigation-case>
			<from-outcome>inventory_form</from-outcome>
			<to-view-id>/com/code/aon/ui/warehouse/facelet/inventory/form.xhtml</to-view-id>
		</navigation-case>
		<navigation-case>
			<from-outcome>inventoryClose</from-outcome>
			<to-view-id>/com/code/aon/ui/warehouse/facelet/inventory/close.xhtml</to-view-id>
		</navigation-case>
		<navigation-case>
			<from-outcome>stock_search</from-outcome>
			<to-view-id>/com/code/aon/ui/warehouse/facelet/stock/search.xhtml</to-view-id>
		</navigation-case>
		<navigation-case>
			<from-outcome>stock_list</from-outcome>
			<to-view-id>/com/code/aon/ui/warehouse/facelet/stock/list.xhtml</to-view-id>
		</navigation-case>
		<navigation-case>
			<from-outcome>stock_form</from-outcome>
			<to-view-id>/com/code/aon/ui/warehouse/facelet/stock/form.xhtml</to-view-id>
		</navigation-case>
		<navigation-case>
			<from-outcome>delivery_list</from-outcome>
			<to-view-id>/com/code/aon/ui/warehouse/facelet/delivery/list.xhtml</to-view-id>
		</navigation-case>
		<navigation-case>
			<from-outcome>delivery_form</from-outcome>
			<to-view-id>/com/code/aon/ui/warehouse/facelet/delivery/form.xhtml</to-view-id>
		</navigation-case>
		<navigation-case>
			<from-outcome>delivery_search</from-outcome>
			<to-view-id>/com/code/aon/ui/warehouse/facelet/delivery/search.xhtml</to-view-id>
		</navigation-case>
	</navigation-rule>

</faces-config>
