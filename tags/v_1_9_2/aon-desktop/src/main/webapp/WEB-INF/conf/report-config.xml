<?xml version="1.0" encoding="ISO-8859-1"?>

<!DOCTYPE report-config 
	PUBLIC "-//CODE-AON//DTD Report Config//EN" 
	"http://co-de.com/aon/report-config.dtd">

<report-config>
	<default-config>
		<fetch-mode paginated="false" />
	</default-config>

	<!--  *********  LETTER  ********* -->
	<report id="letter_to" description="Letter report">
		<template path="/com/code/aon/ui/desktop/report/letter_to.jasper" />
		<collection provider="#{corporateIdentity}"/>
		<params>
			<param id="REPORT_RESOURCE_BUNDLE" value="com.code.aon.desktop.i18n.messages" />
			<param id="logoImageFile" value="#{corporateIdentity.getAttachAsInputStream}" />
		</params>
	</report>
	
	<!--  *********  LABEL  ********* -->
	<report id="label_to" description="Label report">
		<template path="/com/code/aon/ui/desktop/report/label_to.jasper" />
		<collection provider="#{corporateIdentity}"/>
		<params>
			<param id="REPORT_RESOURCE_BUNDLE" value="com.code.aon.desktop.i18n.messages" />
			<param id="logoImageFile" value="#{corporateIdentity.getAttachAsInputStream}" />
		</params>
	</report>
	
	<!--  *********  RECIBI  ********* -->
	<report id="recibi_to" description="Recibi report">
		<template path="/com/code/aon/ui/desktop/report/recibi_to.jasper" />
		<collection provider="#{corporateIdentity}"/>
		<params>
			<param id="REPORT_RESOURCE_BUNDLE" value="com.code.aon.desktop.i18n.messages" />
			<param id="logoImageFile" value="#{corporateIdentity.getAttachAsInputStream}" />
		</params>
	</report>
	
	<!--  *********  ABONARE  ********* -->
	<report id="abonare_to" description="Abonare report">
		<template path="/com/code/aon/ui/desktop/report/abonare_to.jasper" />
		<collection provider="#{corporateIdentity}"/>
		<params>
			<param id="REPORT_RESOURCE_BUNDLE" value="com.code.aon.desktop.i18n.messages" />
			<param id="logoImageFile" value="#{corporateIdentity.getAttachAsInputStream}" />
		</params>
	</report>
	
</report-config>