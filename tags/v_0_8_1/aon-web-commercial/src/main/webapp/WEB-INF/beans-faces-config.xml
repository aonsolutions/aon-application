		<managed-property>
			<property-name>masterBean</property-name>
			<value>target.registry</value>
		</managed-property>
		<managed-property>
			<property-name>masterPropertyName</property-name>
			<value>registry</value>
		</managed-property>
	</managed-bean>	

	<managed-bean>
