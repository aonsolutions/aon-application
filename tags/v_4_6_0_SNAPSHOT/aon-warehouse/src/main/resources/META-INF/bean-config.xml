<?xml version="1.0" encoding="UTF-8"?>

<!DOCTYPE bean-config 
	PUBLIC "-//CODE-AON//DTD Bean Config//EN" 
	"http://co-de.com/aon/bean-config.dtd">

<bean-config>

	<bean description="">
		<pojo>com.code.aon.warehouse.Delivery</pojo>
		<vetoListeners>
	        <vetoListener>com.code.aon.warehouse.event.DeliveryBeanVetoListener</vetoListener>
		</vetoListeners>
	</bean>

	<bean description="">
		<pojo>com.code.aon.warehouse.DeliveryDetail</pojo>
		<listeners>
	        <listener>com.code.aon.warehouse.event.DeliveryDetailBeanListener</listener>
	        <listener>com.code.aon.warehouse.event.StockableBeanListener</listener>
		</listeners>
		<vetoListeners>
	        <vetoListener>com.code.aon.warehouse.event.StockableBeanVetoListener</vetoListener>
		</vetoListeners>
	</bean>
	
	<bean description="">
		<pojo>com.code.aon.warehouse.Income</pojo>
		<vetoListeners>
	        <vetoListener>com.code.aon.warehouse.event.IncomeBeanVetoListener</vetoListener>
		</vetoListeners>
	</bean>

	<bean description="">
		<pojo>com.code.aon.warehouse.IncomeDetail</pojo>
		<listeners>
	        <listener>com.code.aon.warehouse.event.IncomeDetailBeanListener</listener>
	        <listener>com.code.aon.warehouse.event.StockableBeanListener</listener>
		</listeners>
		<vetoListeners>
	        <vetoListener>com.code.aon.warehouse.event.StockableBeanVetoListener</vetoListener>
		</vetoListeners>
	</bean>
	
</bean-config>