<?xml version="1.0"?>
<!DOCTYPE faces-config PUBLIC
  "-//Sun Microsystems, Inc.//DTD JavaServer Faces Config 1.1//EN"
  "http://java.sun.com/dtd/web-facesconfig_1_1.dtd">

<faces-config>

	<application>
		<message-bundle>com.code.aon.ui.common.i18n.messages</message-bundle>
		<locale-config>
			<default-locale>es</default-locale>
		</locale-config>
	</application>

	<!-- *************** RESOURCE RESOLVER ***************** --> 
	<managed-bean>
		<managed-bean-name>aonResource</managed-bean-name>
		<managed-bean-class>
			com.code.aon.ui.resources.bean.ResourceResolver
		</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
		<managed-property>
			<property-name>resourceContextPath</property-name>
			<value>aon-desktop</value>
		</managed-property>		
		<managed-property>
			<property-name>resourceURIPreffix</property-name>
			<value>/aonResource/3.3.0</value>
		</managed-property>		
	</managed-bean>
	
	<!--  *************** 
		AON CONFIGURATION
		***************** -->
	<managed-bean>
		<managed-bean-name>aonConfiguration</managed-bean-name>
		<managed-bean-class>com.code.aon.ui.common.controller.ConfigurationController</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
	    <managed-property>
	      <property-name>styleSheets</property-name>
			<list-entries>
				<value>#{aonResource.resolveLocal['/aon-richCss.css']}</value>
			    <value>/css/colorpicker.css</value>
			    <value>/css/aon-infoweb.css</value>
			</list-entries>
	    </managed-property>
		<managed-property>
			<property-name>applicationBundles</property-name>
			<map-entries>
				<map-entry>
					<key>bundle</key>
					<value>com.code.aon.ui.common.i18n.messages</value>
				</map-entry>
				<map-entry>
					<key>appBundle</key>
					<value>com.code.aon.ui.infoweb.i18n.messages</value>
				</map-entry>
				<map-entry>
					<key>registryBundle</key>
					<value>com.code.aon.ui.registry.i18n.messages</value>
				</map-entry>
		        <map-entry>
		          <key>configBundle</key>
		          <value>com.code.aon.ui.config.i18n.messages</value>
		        </map-entry>
				<map-entry>
					<key>securityBundle</key>
					<value>com.code.aon.bridge.i18n.messages</value>
				</map-entry>
		        <map-entry>
		          <key>companyBundle</key>
		          <value>com.code.aon.ui.company.i18n.messages</value>
		        </map-entry>
			</map-entries>
		</managed-property>		
	</managed-bean>

	<managed-bean>
		<managed-bean-name>companyListeners</managed-bean-name>
	    <managed-bean-class>java.util.LinkedList</managed-bean-class>
		<managed-bean-scope>none</managed-bean-scope>
		<list-entries>
			<value-class>
				com.code.aon.ui.form.event.IControllerListener
			</value-class>
			<value>#{webInfoControllerListener}</value>
			<value>#{companyControllerImagesListener}</value>
		</list-entries>
	</managed-bean>
		
	<managed-bean>
		<managed-bean-name>webInfoControllerListener</managed-bean-name>
		<managed-bean-class>
			com.code.aon.ui.infoweb.event.WebInfoControllerListener
		</managed-bean-class>
		<managed-bean-scope>none</managed-bean-scope>
	</managed-bean>
	
	<managed-bean>
		<managed-bean-name>companyControllerImagesListener</managed-bean-name>
		<managed-bean-class>
			com.code.aon.ui.infoweb.event.CompanyControllerImagesListener
		</managed-bean-class>
		<managed-bean-scope>none</managed-bean-scope>
	</managed-bean>
	
	<!-- **** COMPANY WEB INFO **** --> 
	<managed-bean>
		<managed-bean-name>companyWebInfo</managed-bean-name>
		<managed-bean-class>
			com.code.aon.ui.infoweb.controller.CompanyWebInfoController
		</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
		<managed-property>
			<property-name>pojo</property-name>
			<value>com.code.aon.infoweb.WebInfo</value>
		</managed-property>
		<managed-property>
			<property-name>listenerClasses</property-name>
			<list-entries>
				<value-class>com.code.aon.ui.form.event.IControllerListener</value-class>
				<value>#{webInfoControllerListener}</value>
			</list-entries>
		</managed-property>
	</managed-bean>


	<!-- **** COMPANY IMAGES **** --> 
	<managed-bean>
		<managed-bean-name>companyImages</managed-bean-name>
		<managed-bean-class>
			com.code.aon.ui.infoweb.controller.FileController
		</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
		<managed-property>
			<property-name>pojo</property-name>
			<value>com.code.aon.registry.RegistryAttachment</value>
		</managed-property>
		<managed-property>
			<property-name>maximumSize</property-name>
			<value>65535</value>
		</managed-property>
		<managed-property>
			<property-name>listenerClasses</property-name>
			<list-entries>
				<value-class>com.code.aon.ui.form.event.IControllerListener</value-class>
				<value>#{companyImagesControllerListener}</value>
			</list-entries>
		</managed-property>
	</managed-bean>
	
	<managed-bean>
		<managed-bean-name>companyImagesControllerListener</managed-bean-name>
		<managed-bean-class>
			com.code.aon.ui.infoweb.event.CompanyImagesControllerListener
		</managed-bean-class>
		<managed-bean-scope>none</managed-bean-scope>
	</managed-bean>

	<managed-bean>
		<managed-bean-name>webPage</managed-bean-name>
		<managed-bean-class>com.code.aon.ui.infoweb.controller.CompanyWebInfoPageController</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
		<managed-property>
			<property-name>queryOnStartUP</property-name>
			<value>true</value>
		</managed-property>
		<managed-property>
			<property-name>pojo</property-name>
			<value>com.code.aon.infoweb.WebInfoPage</value>
		</managed-property>
		<managed-property>
			<property-name>listenerClasses</property-name>
			<list-entries>
				<value-class>com.code.aon.ui.form.event.IControllerListener</value-class>
				<value>#{webPageControllerListener}</value>
			</list-entries>
		</managed-property>
	</managed-bean>

	<managed-bean>
		<managed-bean-name>webPageControllerListener</managed-bean-name>
		<managed-bean-class>com.code.aon.ui.infoweb.event.CompanyWebInfoPageControllerListener</managed-bean-class>
		<managed-bean-scope>none</managed-bean-scope>
	</managed-bean>

	<managed-bean>
		<managed-bean-name>webPageStyle</managed-bean-name>
		<managed-bean-class>com.code.aon.ui.infoweb.controller.CompanyWebInfoStyleController</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
		<managed-property>
			<property-name>pojo</property-name>
			<value>com.code.aon.infoweb.WebInfoStyle</value>
		</managed-property>
	</managed-bean>

	<!-- ******************
		COLLECTIONS CONTROLLER
		*******************  	 -->
	<managed-bean>
		<managed-bean-name>webinfoCollections</managed-bean-name>
		<managed-bean-class>com.code.aon.ui.infoweb.controller.CollectionsController</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
	</managed-bean>

	<managed-bean>
		<managed-bean-name>generator</managed-bean-name>
		<managed-bean-class>
			com.code.aon.ui.infoweb.controller.GeneratorController
		</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
	</managed-bean>

	<navigation-rule>
		<navigation-case>
			<from-outcome>otherdata</from-outcome>
			<to-view-id>/facelet/registry/company/tabs/web-info.xhtml</to-view-id>
		</navigation-case>
		<navigation-case>
			<from-outcome>images</from-outcome>
			<to-view-id>/facelet/registry/company/tabs/images.xhtml</to-view-id>
		</navigation-case>
		<navigation-case>
			<from-outcome>pages</from-outcome>
			<to-view-id>/facelet/registry/company/tabs/pages.xhtml</to-view-id>
		</navigation-case>
		<navigation-case>
			<from-outcome>templates</from-outcome>
			<to-view-id>/facelet/registry/company/tabs/templates.xhtml</to-view-id>
		</navigation-case>
		<navigation-case>
			<from-outcome>generate</from-outcome>
			<to-view-id>/facelet/registry/company/form.xhtml</to-view-id>
		</navigation-case>
	</navigation-rule>

   <navigation-rule>
      <navigation-case>
         <from-outcome>logout</from-outcome>
         <to-view-id>/home.jsf</to-view-id> 
         <redirect/>
      </navigation-case>
   </navigation-rule>
   
</faces-config>
