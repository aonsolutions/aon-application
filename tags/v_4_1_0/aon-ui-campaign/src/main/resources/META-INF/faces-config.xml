<faces-config version="1.2"
	xmlns="http://java.sun.com/xml/ns/javaee"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://java.sun.com/xml/ns/javaee http://java.sun.com/xml/ns/javaee/web-facesconfig_1_2.xsd">

	<application>
		<resource-bundle>
		   <base-name>com.code.aon.ui.campaign.i18n.messages</base-name>
		   <var>campaignBundle</var>
		</resource-bundle>
	</application>

	<!--  *************** COLLECTIONS ***************** -->
	<managed-bean>
		<managed-bean-name>campaignCollections</managed-bean-name>
		<managed-bean-class>
			com.code.aon.ui.campaign.controller.CampaignCollectionsController
		</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
	</managed-bean>

	<!-- ************* PROCESS ***************** -->
	<managed-bean>
		<managed-bean-name>process</managed-bean-name>
		<managed-bean-class>com.code.aon.ui.form.BasicController</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
		<managed-property>
			<property-name>queryOnStartUP</property-name>
			<value>true</value>
		</managed-property>
		<managed-property>
			<property-name>pojo</property-name>
			<value>com.code.aon.campaign.Process</value>
		</managed-property>
		<managed-property>
			<property-name>beanName</property-name>
			<value>process</value>
		</managed-property>
		<managed-property>
			<property-name>listenerClasses</property-name>
			<list-entries>
				<value-class>com.code.aon.ui.form.event.IControllerListener</value-class>
				<value>#{processDetailListener}</value>
			</list-entries>
		</managed-property>
	</managed-bean>

	<managed-bean>
		<managed-bean-name>processDetailListener</managed-bean-name>
		<managed-bean-class>
			com.code.aon.ui.form.listener.LinesControllerListener
		</managed-bean-class>
		<managed-bean-scope>none</managed-bean-scope>
		<managed-property>
			<property-name>childBean</property-name>
			<value>processDetail</value>
		</managed-property>
		<managed-property>
			<property-name>aliasMap</property-name>
			<map-entries>
				<map-entry>
					<key>ProcessDetail_process_id</key>
					<value>id</value>
				</map-entry>
			</map-entries>
		</managed-property>
	</managed-bean>

	<!-- ************* PROCESS DETAIL ***************** -->
	<managed-bean>
		<managed-bean-name>processDetail</managed-bean-name>
		<managed-bean-class>
			com.code.aon.ui.campaign.controller.ProcessDetailController
		</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
		<managed-property>
			<property-name>queryOnStartUP</property-name>
			<value>true</value>
		</managed-property>
		<managed-property>
			<property-name>pojo</property-name>
			<value>com.code.aon.campaign.ProcessDetail</value>
		</managed-property>
		<managed-property>
			<property-name>cascadeDelete</property-name>
			<value>true</value>
		</managed-property>
		<managed-property>
			<property-name>masterControllerName</property-name>
			<value>process</value>
		</managed-property>
		<managed-property>
			<property-name>propertyMap</property-name>
			<map-entries>
				<map-entry>
					<key>id</key>
					<value>process.id</value>
				</map-entry>
			</map-entries>
		</managed-property>
		<managed-property>
			<property-name>listenerClasses</property-name>
			<list-entries>
				<value-class>com.code.aon.ui.form.event.IControllerListener</value-class>
				<value>#{processDetailTransitionListener}</value>
				<value>#{processDetailControllerListener}</value>
			</list-entries>
		</managed-property>
	</managed-bean>

	<managed-bean>
		<managed-bean-name>processDetailControllerListener</managed-bean-name>
		<managed-bean-class>
			com.code.aon.ui.campaign.event.ProcessDetailControllerListener
		</managed-bean-class>
		<managed-bean-scope>none</managed-bean-scope>
	</managed-bean>

	<managed-bean>
		<managed-bean-name>processDetailTransitionListener</managed-bean-name>
		<managed-bean-class>
			com.code.aon.ui.form.listener.LinesControllerListener
		</managed-bean-class>
		<managed-bean-scope>none</managed-bean-scope>
		<managed-property>
			<property-name>childBean</property-name>
			<value>processDetailTransition</value>
		</managed-property>
		<managed-property>
			<property-name>aliasMap</property-name>
			<map-entries>
				<map-entry>
					<key>ProcessDetailTransition_processDetail_id</key>
					<value>id</value>
				</map-entry>
			</map-entries>
		</managed-property>
	</managed-bean>

	<!-- ************* PROCESS DETAIL TRANSITION ***************** -->
	<managed-bean>
		<managed-bean-name>processDetailTransition</managed-bean-name>
		<managed-bean-class>
			com.code.aon.ui.campaign.controller.ProcessDetailTransitionController
		</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
		<managed-property>
			<property-name>queryOnStartUP</property-name>
			<value>true</value>
		</managed-property>
		<managed-property>
			<property-name>pojo</property-name>
			<value>com.code.aon.campaign.ProcessDetailTransition</value>
		</managed-property>
		<managed-property>
			<property-name>cascadeDelete</property-name>
			<value>true</value>
		</managed-property>
		<managed-property>
			<property-name>masterControllerName</property-name>
			<value>processDetail</value>
		</managed-property>
		<managed-property>
			<property-name>propertyMap</property-name>
			<map-entries>
				<map-entry>
					<key>id</key>
					<value>processDetail.id</value>
				</map-entry>
			</map-entries>
		</managed-property>
	</managed-bean>

	<!-- ************* CAMPAIGN ***************** -->
	<managed-bean>
		<managed-bean-name>campaign</managed-bean-name>
		<managed-bean-class>
			com.code.aon.ui.campaign.controller.CampaignController
		</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
		<managed-property>
			<property-name>queryOnStartUP</property-name>
			<value>true</value>
		</managed-property>
		<managed-property>
			<property-name>beanName</property-name>
			<value>campaign</value>
		</managed-property>
		<managed-property>
			<property-name>pojo</property-name>
			<value>com.code.aon.campaign.Campaign</value>
		</managed-property>
		<managed-property>
			<property-name>listenerClasses</property-name>
			<list-entries>
				<value-class>com.code.aon.ui.form.event.IControllerListener</value-class>
				<value>#{campaignDossierListener}</value>
				<value>#{campaignControllerListener}</value>
			</list-entries>
		</managed-property>
	</managed-bean>

	<managed-bean>
		<managed-bean-name>campaignDossierListener</managed-bean-name>
		<managed-bean-class>
			com.code.aon.ui.form.listener.LinesControllerListener
		</managed-bean-class>
		<managed-bean-scope>none</managed-bean-scope>
		<managed-property>
			<property-name>childBean</property-name>
			<value>campaignDossier</value>
		</managed-property>
		<managed-property>
			<property-name>aliasMap</property-name>
			<map-entries>
				<map-entry>
					<key>CampaignDossier_campaign_id</key>
					<value>id</value>
				</map-entry>
			</map-entries>
		</managed-property>
	</managed-bean>

	<managed-bean>
		<managed-bean-name>campaignControllerListener</managed-bean-name>
		<managed-bean-class>
			com.code.aon.ui.campaign.event.CampaignControllerListener
		</managed-bean-class>
		<managed-bean-scope>none</managed-bean-scope>
	</managed-bean>

	<!-- ************* CAMPAIGN DOSSIER ***************** -->
	<managed-bean>
		<managed-bean-name>campaignDossier</managed-bean-name>
		<managed-bean-class>
			com.code.aon.ui.campaign.controller.CampaignDossierController
		</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
		<managed-property>
			<property-name>queryOnStartUP</property-name>
			<value>true</value>
		</managed-property>
		<managed-property>
			<property-name>pageLimit</property-name>
			<value>999999</value>
		</managed-property>
		<managed-property>
			<property-name>pojo</property-name>
			<value>com.code.aon.campaign.CampaignDossier</value>
		</managed-property>
		<managed-property>
			<property-name>masterControllerName</property-name>
			<value>campaign</value>
		</managed-property>
		<managed-property>
			<property-name>propertyMap</property-name>
			<map-entries>
				<map-entry>
					<key>id</key>
					<value>campaign.id</value>
				</map-entry>
			</map-entries>
		</managed-property>
		<managed-property>
			<property-name>listenerClasses</property-name>
			<list-entries>
				<value-class>com.code.aon.ui.form.event.IControllerListener</value-class>
				<value>#{campaignDossierControllerListener}</value>
			</list-entries>
		</managed-property>
	</managed-bean>

	<managed-bean>
		<managed-bean-name>campaignDossierControllerListener</managed-bean-name>
		<managed-bean-class>
			com.code.aon.ui.campaign.event.CampaignDossierControllerListener
		</managed-bean-class>
		<managed-bean-scope>none</managed-bean-scope>
	</managed-bean>

	<!-- ************* ADD CAMPAIGN DOSSIER ***************** -->
	<managed-bean>
		<managed-bean-name>addCampaignDossier</managed-bean-name>
		<managed-bean-class>
			com.code.aon.ui.campaign.controller.AddCampaignDossierController
		</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
		<managed-property>
			<property-name>queryOnStartUP</property-name>
			<value>true</value>
		</managed-property>
		<managed-property>
			<property-name>pojo</property-name>
			<value>com.code.aon.project.Activity</value>
		</managed-property>
	</managed-bean>

	<!-- ************* ACTIVITY PROCESS ***************** -->
	<managed-bean>
		<managed-bean-name>activityProcess</managed-bean-name>
		<managed-bean-class>
			com.code.aon.ui.campaign.controller.ActivityProcessController
		</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
		<managed-property>
			<property-name>queryOnStartUP</property-name>
			<value>true</value>
		</managed-property>
		<managed-property>
			<property-name>pojo</property-name>
			<value>com.code.aon.campaign.ActivityProcess</value>
		</managed-property>
	</managed-bean>

	<!-- ************* PROCESS TRANSITION TYPE ***************** -->
	<managed-bean>
		<managed-bean-name>processTransitionType</managed-bean-name>
		<managed-bean-class>com.code.aon.ui.form.BasicController</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
		<managed-property>
			<property-name>queryOnStartUP</property-name>
			<value>true</value>
		</managed-property>
		<managed-property>
			<property-name>pojo</property-name>
			<value>com.code.aon.campaign.ProcessTransitionType</value>
		</managed-property>
		<managed-property>
	         <property-name>defaultOrder</property-name>
    	     <value>ProcessTransitionType_description</value>
      	</managed-property>
	</managed-bean>

	<!-- ************* PROCESS LAUNCHER ***************** -->
	<managed-bean>
		<managed-bean-name>processWizard</managed-bean-name>
		<managed-bean-class>
			com.code.aon.ui.campaign.controller.ProcessLauncherWizard
		</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
	</managed-bean>

	<!-- ================================================ -->
	<!-- =================== NAVIGATION ================= -->
	<!-- ================================================ -->

	<!-- =================== Process ================= -->
	<navigation-rule>
		<navigation-case>
			<from-outcome>process_list</from-outcome>
			<to-view-id>/com/code/aon/ui/campaign/facelet/process/list.xhtml</to-view-id>
		</navigation-case>
		<navigation-case>
			<from-outcome>process_form</from-outcome>
			<to-view-id>/com/code/aon/ui/campaign/facelet/process/form.xhtml</to-view-id>
		</navigation-case>
		<navigation-case>
			<from-outcome>process_search</from-outcome>
			<to-view-id>/com/code/aon/ui/campaign/facelet/process/search.xhtml</to-view-id>
		</navigation-case>
	</navigation-rule>

	<!-- ============ Process transition Type ============ -->
	<navigation-rule>
	    <navigation-case>
	        <from-outcome>process_transition_type</from-outcome>
	        <to-view-id>/com/code/aon/ui/campaign/facelet/processTransitionType/grid.xhtml</to-view-id>
	    </navigation-case>    
	</navigation-rule>

	<!-- =================== Process Launcher ================= -->
	<navigation-rule>
		<navigation-case>
			<from-outcome>process_wizard_step0</from-outcome>
			<to-view-id>/com/code/aon/ui/campaign/facelet/processLauncher/step0.xhtml</to-view-id>
		</navigation-case>
		<navigation-case>
			<from-outcome>process_wizard_step1</from-outcome>
			<to-view-id>/com/code/aon/ui/campaign/facelet/processLauncher/step1.xhtml</to-view-id>
		</navigation-case>
		<navigation-case>
			<from-outcome>process_wizard_step2</from-outcome>
			<to-view-id>/com/code/aon/ui/campaign/facelet/processLauncher/step2.xhtml</to-view-id>
		</navigation-case>
		<navigation-case>
			<from-outcome>process_wizard_step3</from-outcome>
			<to-view-id>/com/code/aon/ui/campaign/facelet/processLauncher/step3.xhtml</to-view-id>
		</navigation-case>
		<navigation-case>
			<from-outcome>process_wizard_step4</from-outcome>
			<to-view-id>/com/code/aon/ui/campaign/facelet/processLauncher/step4.xhtml</to-view-id>
		</navigation-case>
	</navigation-rule>

	<!-- =================== Campaign ================= --> 
	<navigation-rule>
		<navigation-case>
			<from-outcome>campaign_list</from-outcome>
			<to-view-id>/com/code/aon/ui/campaign/facelet/campaign/list.xhtml</to-view-id>
		</navigation-case>
		<navigation-case>
			<from-outcome>campaign_form</from-outcome>
			<to-view-id>/com/code/aon/ui/campaign/facelet/campaign/form.xhtml</to-view-id>
		</navigation-case>
		<navigation-case>
			<from-outcome>campaign_search</from-outcome>
			<to-view-id>/com/code/aon/ui/campaign/facelet/campaign/search.xhtml</to-view-id>
		</navigation-case>
		<navigation-case>
			<from-outcome>campaign_view_task</from-outcome>
			<to-view-id>/com/code/aon/ui/campaign/facelet/campaign/viewTask/form.xhtml</to-view-id>
		</navigation-case>
	</navigation-rule>

</faces-config>