	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://java.sun.com/xml/ns/javaee http://java.sun.com/xml/ns/javaee/web-facesconfig_1_2.xsd">

	<!--  *************** COLLECTIONS ***************** -->

	<managed-bean>
		<managed-bean-name>marketingCollections</managed-bean-name>
		<managed-bean-class>
			com.code.aon.ui.marketing.controller.MarketingCollectionsController
		</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
	</managed-bean>

	<!-- ************ COMMUNICATION CENTER ************** -->
	<managed-bean>
		<managed-bean-name>communicationCenter</managed-bean-name>
		<managed-bean-class>
			com.code.aon.ui.marketing.controller.CommunicationCenterController
		</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
	</managed-bean>

	<!-- ************ QUESTION ************** -->
	<managed-bean>
		<managed-bean-name>question</managed-bean-name>
		<managed-bean-class>
			com.code.aon.ui.marketing.controller.QuestionController
		</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
		<managed-property>
			<property-name>queryOnStartUP</property-name>
			<value>true</value>
		</managed-property>
		<managed-property>
			<property-name>pojo</property-name>
			<value>com.code.aon.marketing.Question</value>
		</managed-property>
		<managed-property>
			<property-name>beanName</property-name>
			<value>question</value>
		</managed-property>
		<managed-property>
			<property-name>listenerClasses</property-name>
			<list-entries>
				<value-class>
					com.code.aon.ui.form.event.IControllerListener
				</value-class>
				<value>#{questionValueListener}</value>
			</list-entries>
		</managed-property>
	</managed-bean>

	<managed-bean>
		<managed-bean-name>questionValueListener</managed-bean-name>
		<managed-bean-class>
			com.code.aon.ui.form.listener.MasterControllerListener
		</managed-bean-class>
		<managed-bean-scope>none</managed-bean-scope>
		<managed-property>
			<property-name>childBean</property-name>
			<value>questionValue</value>
		</managed-property>
		<managed-property>
			<property-name>aliasMap</property-name>
			<map-entries>
				<map-entry>
					<key>QuestionValue_question_id</key>
					<value>id</value>
				</map-entry>
			</map-entries>
		</managed-property>
	</managed-bean>

	<managed-bean>
		<managed-bean-name>questionChildListener</managed-bean-name>
		<managed-bean-class>
			com.code.aon.ui.form.listener.ChildControllerListener
		</managed-bean-class>
		<managed-bean-scope>none</managed-bean-scope>
		<managed-property>
			<property-name>masterBean</property-name>
			<value>question</value>
		</managed-property>
		<managed-property>
			<property-name>masterPropertyName</property-name>
			<value>question</value>
		</managed-property>
	</managed-bean>

