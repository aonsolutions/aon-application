	<parameter name="company" isForPrompting="false" class="com.code.aon.company.Company"/>
	<parameter name="fromDate" isForPrompting="false" class="java.util.Date"/>
	<parameter name="toDate" isForPrompting="false" class="java.util.Date"/>
	<queryString><![CDATA[select 
  dailytrack0_.id as id
, user1_.id as userId
, user1_.name as userName
, dailytrack0_.tracking_date as date
, dailytrack0_.tracking_duration as duration
, jobtype2_.id as jobTypeId
, jobtype2_.description as jobTypeDescription
, customer3_.registry as customerId
, registry5_.name as customerName
, dossier6_.id as dossierId
, dossier6_.number as dossierNumber
, activity9_.id as activityId
, activityty11_.description as activityDescription
, dossiertyp8_.id as dossierTypeId
, dossiertyp8_.description as dossierTypeDescription 
from daily_tracking dailytrack0_ 
inner join user user1_ on dailytrack0_.user=user1_.id 
inner join job_type jobtype2_ on dailytrack0_.job_type=jobtype2_.id 
left outer join customer customer3_ on dailytrack0_.customer=customer3_.registry 
left outer join registry registry5_ on customer3_.registry=registry5_.id 
left outer join dossier dossier6_ on dailytrack0_.dossier=dossier6_.id 
left outer join dossier_type dossiertyp8_ on dossier6_.dossier_type=dossiertyp8_.id 
left outer join activity activity9_ on dailytrack0_.activity=activity9_.id 
left outer join activity_type activityty11_ on activity9_.activity_type=activityty11_.id]]></queryString>

