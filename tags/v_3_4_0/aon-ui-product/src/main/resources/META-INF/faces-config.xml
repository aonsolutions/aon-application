<faces-config version="1.2"
	xmlns="http://java.sun.com/xml/ns/javaee"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://java.sun.com/xml/ns/javaee http://java.sun.com/xml/ns/javaee/web-facesconfig_1_2.xsd">

	<application>
		<resource-bundle>
			<base-name>com.code.aon.ui.product.i18n.messages</base-name>
			<var>productBundle</var>
		</resource-bundle>
	</application>
	
	<!--  **** PRODUCT COLLECTIONS ****	-->
	<managed-bean>
		<managed-bean-name>productCollections</managed-bean-name>
		<managed-bean-class>
			com.code.aon.ui.product.controller.ProductCollectionsController
		</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
	</managed-bean>

	<!-- ****** BRAND ****** -->
	<managed-bean>
		<managed-bean-name>brand</managed-bean-name>
		<managed-bean-class>com.code.aon.ui.form.BasicController</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
		<managed-property>
			<property-name>queryOnStartUP</property-name>
			<value>true</value>
		</managed-property>
		<managed-property>
			<property-name>pojo</property-name>
			<value>com.code.aon.product.Brand</value>
		</managed-property>
		<managed-property>
			<property-name>beanName</property-name>
			<value>brand</value>
		</managed-property>
		<managed-property>
			<property-name>defaultOrder</property-name>
			<value>Brand_name</value>
		</managed-property>
	</managed-bean>
	
	<!-- ****** PRODUCT CATEGORY ****** -->
	<managed-bean>
		<managed-bean-name>productCategory</managed-bean-name>
		<managed-bean-class>com.code.aon.ui.form.BasicController</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
		<managed-property>
			<property-name>queryOnStartUP</property-name>
			<value>true</value>
		</managed-property>
		<managed-property>
			<property-name>pojo</property-name>
			<value>com.code.aon.product.ProductCategory</value>
		</managed-property>
		<managed-property>
			<property-name>beanName</property-name>
			<value>productCategory</value>
		</managed-property>
		<managed-property>
			<property-name>defaultOrder</property-name>
			<value>ProductCategory_name</value>
		</managed-property>
	</managed-bean>
	
	<!-- ****** ITEM ****** -->
	<managed-bean>
		<managed-bean-name>item</managed-bean-name>
		<managed-bean-class>com.code.aon.ui.product.controller.ItemController</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
		<managed-property>
			<property-name>queryOnStartUP</property-name>
			<value>false</value>
		</managed-property>
		<managed-property>
			<property-name>pojo</property-name>
			<value>com.code.aon.product.Item</value>
		</managed-property>
		<managed-property>
			<property-name>beanName</property-name>
			<value>item</value>
		</managed-property>
		<managed-property>
			<property-name>defaultOrder</property-name>
			<value>Item_product_name</value>
		</managed-property>
		<managed-property>
			<property-name>listenerClasses</property-name>
			<list-entries>
				<value-class>com.code.aon.ui.form.event.IControllerListener</value-class>
				<value>#{itemControllerListener}</value>
			</list-entries>
		</managed-property>
		<managed-property>
			<property-name>optionalListenerClasses</property-name>
			<value>#{itemOptionalListeners}</value>
		</managed-property>		
	</managed-bean>

	<managed-bean>
		<managed-bean-name>itemOptionalListeners</managed-bean-name>
	    <managed-bean-class>java.util.LinkedList</managed-bean-class>
		<managed-bean-scope>none</managed-bean-scope>
	</managed-bean>

	<managed-bean>
		<managed-bean-name>itemControllerListener</managed-bean-name>
		<managed-bean-class>
			com.code.aon.ui.product.event.ItemControllerListener
		</managed-bean-class>
		<managed-bean-scope>none</managed-bean-scope>
	</managed-bean>

	<!-- ************ ITEM LOOKUP ************** -->
	<managed-bean>
		<managed-bean-name>itemLookup</managed-bean-name>
		<managed-bean-class>com.code.aon.faces.controller.RichLookupBean</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
		<managed-property>
			<property-name>beanName</property-name>
			<value>itemLookup</value>
		</managed-property>
		<managed-property>
			<property-name>foreignPojo</property-name>
			<value>com.code.aon.product.Item</value>
		</managed-property>
		<managed-property>
			<property-name>defaultOrder</property-name>
			<value>Item_product_code</value>
		</managed-property>		
		<managed-property>
			<property-name>listPagePath</property-name>
			<value>/com/code/aon/ui/product/facelet/lookup/item/list.xhtml</value>
		</managed-property>
		<managed-property>
			<property-name>searchPagePath</property-name>
			<value>/com/code/aon/ui/product/facelet/lookup/item/search.xhtml</value>
		</managed-property>
	</managed-bean>

	<!-- ****** CATALOGUE ****** -->
	<managed-bean>
		<managed-bean-name>catalogue</managed-bean-name>
		<managed-bean-class>com.code.aon.ui.form.BasicController</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
		<managed-property>
			<property-name>queryOnStartUP</property-name>
			<value>false</value>
		</managed-property>
		<managed-property>
			<property-name>pojo</property-name>
			<value>com.code.aon.product.Catalogue</value>
		</managed-property>
		<managed-property>
			<property-name>beanName</property-name>
			<value>catalogue</value>
		</managed-property>
		<managed-property>
			<property-name>defaultOrder</property-name>
			<value>Catalogue_name</value>
		</managed-property>
		<managed-property>
			<property-name>listenerClasses</property-name>
			<list-entries>
				<value-class>com.code.aon.ui.form.event.IControllerListener</value-class>
				<value>#{catalogueSearch}</value>
				<value>#{catalogueItemChildListener}</value>
				<value>#{catalogueCategoryChildListener}</value>
			</list-entries>
		</managed-property>
	</managed-bean>
	
	<managed-bean>
		<managed-bean-name>catalogueSearch</managed-bean-name>
		<managed-bean-class>
			com.code.aon.ui.product.event.CatalogueSearchListener
		</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
	</managed-bean>

	<managed-bean>
		<managed-bean-name>catalogueItemChildListener</managed-bean-name>
		<managed-bean-class>
			com.code.aon.ui.form.listener.LinesControllerListener
		</managed-bean-class>
		<managed-bean-scope>none</managed-bean-scope>
		<managed-property>
			<property-name>childBean</property-name>
			<value>catalogueItem</value>
		</managed-property>
		<managed-property>
			<property-name>aliasMap</property-name>
			<map-entries>
				<map-entry>
					<key>CatalogueItem_catalogue_id</key>
                    <value>id</value>
				</map-entry>
			</map-entries>
		</managed-property>
	</managed-bean>

	<managed-bean>
		<managed-bean-name>catalogueCategoryChildListener</managed-bean-name>
		<managed-bean-class>
			com.code.aon.ui.form.listener.LinesControllerListener
		</managed-bean-class>
		<managed-bean-scope>none</managed-bean-scope>
		<managed-property>
			<property-name>childBean</property-name>
			<value>catalogueCategory</value>
		</managed-property>
		<managed-property>
			<property-name>aliasMap</property-name>
			<map-entries>
				<map-entry>
					<key>CatalogueCategory_catalogue_id</key>
                    <value>id</value>
				</map-entry>
			</map-entries>
		</managed-property>
	</managed-bean>

	<!-- ****** CATALOGUE ITEM ****** -->
	<managed-bean>
		<managed-bean-name>catalogueItem</managed-bean-name>
		<managed-bean-class>
			com.code.aon.ui.product.controller.CatalogueItemController
		</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
		<managed-property>
			<property-name>queryOnStartUP</property-name>
			<value>true</value>
		</managed-property>
		<managed-property>
			<property-name>pojo</property-name>
			<value>com.code.aon.product.CatalogueItem</value>
		</managed-property>
		<managed-property>
			<property-name>beanName</property-name>
			<value>catalogueItem</value>
		</managed-property>
		<managed-property>
			<property-name>masterControllerName</property-name>
			<value>catalogue</value>
		</managed-property>
		<managed-property>
			<property-name>propertyMap</property-name>
			<map-entries>
				<map-entry>
					<key>id</key>
					<value>catalogue.id</value>
				</map-entry>
			</map-entries>
		</managed-property>
		<managed-property>
			<property-name>defaultOrder</property-name>
			<value>CatalogueItem_item_product_name,CatalogueItem_quantity</value>
		</managed-property>
		<managed-property>
			<property-name>cascadeDelete</property-name>
			<value>true</value>
		</managed-property>
	</managed-bean>

	<!-- ****** CATALOGUE CATEGORY ****** -->
	<managed-bean>
		<managed-bean-name>catalogueCategory</managed-bean-name>
		<managed-bean-class>
			com.code.aon.ui.form.LinesController
		</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
		<managed-property>
			<property-name>queryOnStartUP</property-name>
			<value>true</value>
		</managed-property>
		<managed-property>
			<property-name>pojo</property-name>
			<value>com.code.aon.product.CatalogueCategory</value>
		</managed-property>
		<managed-property>
			<property-name>beanName</property-name>
			<value>catalogueCategory</value>
		</managed-property>
		<managed-property>
			<property-name>masterControllerName</property-name>
			<value>catalogue</value>
		</managed-property>
		<managed-property>
			<property-name>propertyMap</property-name>
			<map-entries>
				<map-entry>
					<key>id</key>
					<value>catalogue.id</value>
				</map-entry>
			</map-entries>
		</managed-property>
		<managed-property>
			<property-name>defaultOrder</property-name>
			<value>CatalogueCategory_category_name,CatalogueCategory_quantity</value>
		</managed-property>
		<managed-property>
			<property-name>cascadeDelete</property-name>
			<value>true</value>
		</managed-property>
	</managed-bean>
	
	<!-- ****** TARIFF ****** -->
	<managed-bean>
		<managed-bean-name>tariff</managed-bean-name>
		<managed-bean-class>com.code.aon.ui.form.BasicController</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
		<managed-property>
			<property-name>queryOnStartUP</property-name>
			<value>true</value>
		</managed-property>
		<managed-property>
			<property-name>pojo</property-name>
			<value>com.code.aon.config.Tariff</value>
		</managed-property>
		<managed-property>
			<property-name>beanName</property-name>
			<value>tariff</value>
		</managed-property>
		<managed-property>
			<property-name>defaultOrder</property-name>
			<value>Tariff_name</value>
		</managed-property>
		<managed-property>
			<property-name>listenerClasses</property-name>
			<list-entries>
				<value-class>
					com.code.aon.ui.form.event.IControllerListener
				</value-class>
				<value>#{tariffCatalogueChildListener}</value>
			</list-entries>
		</managed-property>
	</managed-bean>
	
	<managed-bean>
		<managed-bean-name>tariffCatalogueChildListener</managed-bean-name>
		<managed-bean-class>
			com.code.aon.ui.form.listener.LinesControllerListener
		</managed-bean-class>
		<managed-bean-scope>none</managed-bean-scope>
		<managed-property>
			<property-name>childBean</property-name>
			<value>tariffCatalogue</value>
		</managed-property>
		<managed-property>
			<property-name>aliasMap</property-name>
			<map-entries>
				<map-entry>
					<key>TariffCatalogue_tariff_id</key>
                    <value>id</value>
				</map-entry>
			</map-entries>
		</managed-property>
	</managed-bean>

	<!-- ****** TARIFF CATALOGUE ****** -->
	<managed-bean>
		<managed-bean-name>tariffCatalogue</managed-bean-name>
		<managed-bean-class>
			com.code.aon.ui.form.LinesController
		</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
		<managed-property>
			<property-name>queryOnStartUP</property-name>
			<value>true</value>
		</managed-property>
		<managed-property>
			<property-name>pojo</property-name>
			<value>com.code.aon.product.TariffCatalogue</value>
		</managed-property>
		<managed-property>
			<property-name>beanName</property-name>
			<value>tariffCatalogue</value>
		</managed-property>
		<managed-property>
			<property-name>masterControllerName</property-name>
			<value>tariff</value>
		</managed-property>
		<managed-property>
			<property-name>propertyMap</property-name>
			<map-entries>
				<map-entry>
					<key>id</key>
					<value>tariff.id</value>
				</map-entry>
			</map-entries>
		</managed-property>
		<managed-property>
			<property-name>defaultOrder</property-name>
			<value>TariffCatalogue_catalogue_name</value>
		</managed-property>
		<managed-property>
			<property-name>cascadeDelete</property-name>
			<value>true</value>
		</managed-property>
	</managed-bean>
	
   	<!-- ************* NAVIGATION RULES ***************** -->
	<navigation-rule>
	    <navigation-case>
	      <from-outcome>productCategory</from-outcome>
	      <to-view-id>/com/code/aon/ui/product/facelet/category/grid.xhtml</to-view-id>
	    </navigation-case>
	    <navigation-case>
	      <from-outcome>brand</from-outcome>
	      <to-view-id>/com/code/aon/ui/product/facelet/brand/grid.xhtml</to-view-id>
	    </navigation-case>
		<navigation-case>
		  <from-outcome>item_form</from-outcome>
		  <to-view-id>/com/code/aon/ui/product/facelet/item/form.xhtml</to-view-id>
      	</navigation-case>
		<navigation-case>
		  <from-outcome>item_list</from-outcome>
		  <to-view-id>/com/code/aon/ui/product/facelet/item/list.xhtml</to-view-id>
      	</navigation-case>
      	<navigation-case>
		  <from-outcome>item_search</from-outcome>
		  <to-view-id>/com/code/aon/ui/product/facelet/item/search.xhtml</to-view-id>
		</navigation-case>
	    <navigation-case>
	      <from-outcome>catalogue_form</from-outcome>
	      <to-view-id>/com/code/aon/ui/product/facelet/catalogue/form.xhtml</to-view-id>
	    </navigation-case>
	    <navigation-case>
	      <from-outcome>catalogue_list</from-outcome>
	      <to-view-id>/com/code/aon/ui/product/facelet/catalogue/list.xhtml</to-view-id>
	    </navigation-case>
	    <navigation-case>
	      <from-outcome>catalogue_search</from-outcome>
	      <to-view-id>/com/code/aon/ui/product/facelet/catalogue/search.xhtml</to-view-id>
	    </navigation-case>
	    <navigation-case>
	      <from-outcome>tariff_form</from-outcome>
	      <to-view-id>/com/code/aon/ui/product/facelet/tariff/form.xhtml</to-view-id>
	    </navigation-case>
	    <navigation-case>
	      <from-outcome>tariff_list</from-outcome>
	      <to-view-id>/com/code/aon/ui/product/facelet/tariff/list.xhtml</to-view-id>
	    </navigation-case>
   </navigation-rule>
</faces-config>