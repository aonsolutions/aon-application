<?xml version="1.0" encoding="ISO-8859-1"?>

<!DOCTYPE report-config 
	PUBLIC "-//CODE-AON//DTD Report Config//EN" 
	"http://co-de.com/aon/report-config.dtd">

<report-config>
	<default-config>
		<fetch-mode paginated="false" />
	</default-config>

	<!-- *********** PROOF *************** -->
	<report id="proof" description="Proof report">
		<template path="/com/code/ui/gbp/report/proof.jasper" />
		<collection provider="#{frontProof}"/>
		<params>
			<param id="REPORT_RESOURCE_BUNDLE" value="com.code.ui.gbp.i18n.messages" />
			<param id="signatures" value="#{frontProof.getSignatures}" />
		</params>
		<nested-report report="proofSignatures"/>
	</report>
	
	<report id="proofSignatures" description="proofSignatures">
		<template path="/com/code/ui/gbp/report/proofSignatures.jasper"/>
	</report>

	<!-- *********** PRO FORMA INVOICE ************* -->
	<report id="proforma" description="Proforma report">
		<template path="/com/code/ui/gbp/report/proof.jasper" />
		<collection provider="#{proForma}"/>
		<params>
			<param id="REPORT_RESOURCE_BUNDLE" value="com.code.ui.gbp.i18n.messages" />
			<param id="signatures" value="#{proForma.getSignatures}" />
		</params>
		<nested-report report="proFormaSignatures"/>
	</report>
	
	<report id="proFormaSignatures" description="proFormaSignatures">
		<template path="/com/code/ui/gbp/report/proofSignatures.jasper"/>
	</report>
	
</report-config>