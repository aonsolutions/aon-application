<faces-config version="1.2"
	xmlns="http://java.sun.com/xml/ns/javaee"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://java.sun.com/xml/ns/javaee http://java.sun.com/xml/ns/javaee/web-facesconfig_1_2.xsd">

	<application>
		<resource-bundle>
			<base-name>com.code.aon.ui.sales.i18n.messages</base-name>
			<var>salesBundle</var>
		</resource-bundle>
	</application>
	
	<!--  *************** COLLECTIONS ***************** -->
	<managed-bean>
		<managed-bean-name>salesCollections</managed-bean-name>
		<managed-bean-class>
			com.code.aon.ui.sales.controller.SalesCollectionsController
		</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
	</managed-bean>

	<!-- ************ SELLER ************** -->
	<managed-bean>
		<managed-bean-name>seller</managed-bean-name>
		<managed-bean-class>
			com.code.aon.ui.sales.controller.SellerController
		</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
		<managed-property>
			<property-name>queryOnStartUP</property-name>
			<value>false</value>
		</managed-property>
		<managed-property>
			<property-name>pojo</property-name>
			<value>com.code.aon.seller.Seller</value>
		</managed-property>
		<managed-property>
			<property-name>beanName</property-name>
			<value>seller</value>
		</managed-property>
		<managed-property>
			<property-name>listenerClasses</property-name>
			<list-entries>
				<value-class>
					com.code.aon.ui.form.event.IControllerListener
				</value-class>
				<value>#{sellerAddressListener}</value>
				<value>#{sellerMediaListener}</value>
			</list-entries>
		</managed-property>
	</managed-bean>

	<managed-bean>
		<managed-bean-name>sellerAddressListener</managed-bean-name>
		<managed-bean-class>com.code.aon.ui.form.listener.LinesControllerListener</managed-bean-class>		
		<managed-bean-scope>none</managed-bean-scope>
		<managed-property>
			<property-name>childBean</property-name>
			<value>sellerAddress</value>
		</managed-property>
		<managed-property>
			<property-name>aliasMap</property-name>
			<map-entries>
				<map-entry>
					<key>RegistryAddress_registry_id</key>
					<value>id</value>
				</map-entry>
			</map-entries>
		</managed-property>
	</managed-bean>

	<managed-bean>
		<managed-bean-name>sellerMediaListener</managed-bean-name>
		<managed-bean-class>com.code.aon.ui.form.listener.LinesControllerListener</managed-bean-class>
		<managed-bean-scope>none</managed-bean-scope>
		<managed-property>
			<property-name>childBean</property-name>
			<value>sellerMedia</value>
		</managed-property>
		<managed-property>
			<property-name>aliasMap</property-name>
			<map-entries>
				<map-entry>
					<key>RegistryMedia_registry_id</key>
					<value>id</value>
				</map-entry>
			</map-entries>
		</managed-property>
	</managed-bean>

	<!--  **** SELLER ADDRESS **** -->

	<managed-bean>
		<managed-bean-name>sellerAddress</managed-bean-name>
		<managed-bean-class>com.code.aon.ui.form.LinesController</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
		<managed-property>
			<property-name>pojo</property-name>
			<value>com.code.aon.registry.RegistryAddress</value>
		</managed-property>
		<managed-property>
			<property-name>beanName</property-name>
			<value>sellerAddress</value>
		</managed-property>
		<managed-property>
			<property-name>cascadeDelete</property-name>
			<value>true</value>
		</managed-property>
		<managed-property>
			<property-name>masterControllerName</property-name>
			<value>seller</value>
		</managed-property>
		<managed-property>
			<property-name>propertyMap</property-name>
			<map-entries>
				<map-entry>
					<key>id</key>
					<value>registry.id</value>
				</map-entry>
			</map-entries>
		</managed-property>		
	</managed-bean>

	<!--  **** SELLER MEDIA **** -->

	<managed-bean>
		<managed-bean-name>sellerMedia</managed-bean-name>
		<managed-bean-class>com.code.aon.ui.form.LinesController</managed-bean-class>		
		<managed-bean-scope>session</managed-bean-scope>
		<managed-property>
			<property-name>pojo</property-name>
			<value>com.code.aon.registry.RegistryMedia</value>
		</managed-property>
		<managed-property>
			<property-name>beanName</property-name>
			<value>sellerMedia</value>
		</managed-property>
		<managed-property>
			<property-name>cascadeDelete</property-name>
			<value>true</value>
		</managed-property>
		<managed-property>
			<property-name>masterControllerName</property-name>
			<value>seller</value>
		</managed-property>
		<managed-property>
			<property-name>propertyMap</property-name>
			<map-entries>
				<map-entry>
					<key>id</key>
					<value>registry.id</value>
				</map-entry>
			</map-entries>
		</managed-property>		
	</managed-bean>
	
	<!-- ************ SELLER LOOKUP ************** -->
	<managed-bean>
		<managed-bean-name>sellerLookup</managed-bean-name>
		<managed-bean-class>com.code.aon.faces.controller.RichLookupBean</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
		<managed-property>
			<property-name>beanName</property-name>
			<value>sellerLookup</value>
		</managed-property>
		<managed-property>
			<property-name>foreignPojo</property-name>
			<value>com.code.aon.seller.Seller</value>
		</managed-property>
		<managed-property>
			<property-name>listPagePath</property-name>
			<value>/com/code/aon/ui/sales/facelet/lookup/seller/list.xhtml</value>
		</managed-property>
		<managed-property>
			<property-name>searchPagePath</property-name>
			<value>/com/code/aon/ui/sales/facelet/lookup/seller/search.xhtml</value>
		</managed-property>		
	</managed-bean>

	<!-- ****** SALES ****** -->
	<managed-bean>
		<managed-bean-name>sales</managed-bean-name>
		<managed-bean-class>
			com.code.aon.ui.sales.controller.SalesController
		</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
		<managed-property>
			<property-name>queryOnStartUP</property-name>
			<value>false</value>
		</managed-property>
		<managed-property>
			<property-name>pojo</property-name>
			<value>com.code.aon.sales.Sales</value>
		</managed-property>
		<managed-property>
			<property-name>beanName</property-name>
			<value>sales</value>
		</managed-property>
		<managed-property>
			<property-name>defaultOrder</property-name>
			<value>Sales_issueDate,Sales_series,Sales_number</value>
		</managed-property>
		<managed-property>
			<property-name>listenerClasses</property-name>
			<list-entries>
				<value-class>
					com.code.aon.ui.form.event.IControllerListener
				</value-class>
				<value>#{salesSearch}</value>
				<value>#{salesHeaderControllerListener}</value>
				<value>#{salesControllerListener}</value>
				<value>#{salesDetailChildListener}</value>
			</list-entries>
		</managed-property>
	</managed-bean>

	<managed-bean>
		<managed-bean-name>salesSearch</managed-bean-name>
		<managed-bean-class>
			com.code.aon.ui.sales.event.SalesSearchListener
		</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
	</managed-bean>

 	<managed-bean>
		<managed-bean-name>salesHeaderControllerListener</managed-bean-name>
		<managed-bean-class>com.code.aon.ui.config.event.HeaderControllerListener</managed-bean-class>
		<managed-bean-scope>none</managed-bean-scope>
		<managed-property>
			<property-name>table</property-name>
			<value>Sales</value>
		</managed-property>
	</managed-bean>

	<managed-bean>
		<managed-bean-name>salesControllerListener</managed-bean-name>
		<managed-bean-class>
			com.code.aon.ui.sales.event.SalesControllerListener
		</managed-bean-class>
		<managed-bean-scope>none</managed-bean-scope>
	</managed-bean>

	<managed-bean>
		<managed-bean-name>salesDetailChildListener</managed-bean-name>
		<managed-bean-class>
			com.code.aon.ui.form.listener.LinesControllerListener
		</managed-bean-class>
		<managed-bean-scope>none</managed-bean-scope>
		<managed-property>
			<property-name>childBean</property-name>
			<value>salesDetail</value>
		</managed-property>
		<managed-property>
			<property-name>aliasMap</property-name>
			<map-entries>
				<map-entry>
					<key>SalesDetail_sales_id</key>
                    <value>id</value>
				</map-entry>
			</map-entries>
		</managed-property>
	</managed-bean>

	<!-- ****** SALES DETAIL ****** -->
	<managed-bean>
		<managed-bean-name>salesDetail</managed-bean-name>
		<managed-bean-class>
			com.code.aon.ui.sales.controller.SalesDetailController
		</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
		<managed-property>
			<property-name>queryOnStartUP</property-name>
			<value>true</value>
		</managed-property>
		<managed-property>
			<property-name>pojo</property-name>
			<value>com.code.aon.sales.SalesDetail</value>
		</managed-property>
		<managed-property>
			<property-name>beanName</property-name>
			<value>salesDetail</value>
		</managed-property>
		<managed-property>
			<property-name>masterControllerName</property-name>
			<value>sales</value>
		</managed-property>
		<managed-property>
			<property-name>propertyMap</property-name>
			<map-entries>
				<map-entry>
					<key>id</key>
					<value>sales.id</value>
				</map-entry>
			</map-entries>
		</managed-property>
		<managed-property>
			<property-name>cascadeDelete</property-name>
			<value>true</value>
		</managed-property>
	</managed-bean>
	
   	<!-- ************* NAVIGATION RULES ***************** -->
	<navigation-rule>
		<navigation-case>
			<from-outcome>seller_list</from-outcome>
			<to-view-id>/com/code/aon/ui/sales/facelet/seller/list.xhtml</to-view-id>
		</navigation-case>
		<navigation-case>
			<from-outcome>seller_form</from-outcome>
			<to-view-id>/com/code/aon/ui/sales/facelet/seller/form.xhtml</to-view-id>
		</navigation-case>
		<navigation-case>
			<from-outcome>seller_search</from-outcome>
			<to-view-id>/com/code/aon/ui/sales/facelet/seller/search.xhtml</to-view-id>
		</navigation-case>
		<navigation-case>
			<from-outcome>sales_list</from-outcome>
			<to-view-id>/com/code/aon/ui/sales/facelet/sales/list.xhtml</to-view-id>
		</navigation-case>
		<navigation-case>
			<from-outcome>sales_form</from-outcome>
			<to-view-id>/com/code/aon/ui/sales/facelet/sales/form.xhtml</to-view-id>
		</navigation-case>
		<navigation-case>
			<from-outcome>sales_search</from-outcome>
			<to-view-id>/com/code/aon/ui/sales/facelet/sales/search.xhtml</to-view-id>
		</navigation-case>
	</navigation-rule>		
	
</faces-config>