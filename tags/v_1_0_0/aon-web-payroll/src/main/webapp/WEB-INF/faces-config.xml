<faces-config version="1.2"
	xmlns="http://java.sun.com/xml/ns/javaee"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://java.sun.com/xml/ns/javaee http://java.sun.com/xml/ns/javaee/web-facesconfig_1_2.xsd">

	<application>
		<message-bundle>
			com.code.aon.ui.payroll.i18n.messages
		</message-bundle>
		<locale-config>
			<default-locale>es</default-locale>
		</locale-config>
		<navigation-handler>com.code.aon.ui.audit.AuditNavigationHandler</navigation-handler>
		<resource-bundle>
			<base-name>com.code.aon.ui.payroll.i18n.messages</base-name>
			<var>appBundle</var>
		</resource-bundle>		
		<resource-bundle>
			<base-name>com.code.aon.ui.payroll.i18n.menu</base-name>
			<var>menuBundle</var>
		</resource-bundle>		
	</application>

	<!--  *************** CONVERTERS ***************** -->
	<converter>
    	<converter-id>toConverter</converter-id>
    	<converter-class>com.code.aon.ui.payroll.converter.ITransferObjectConverter</converter-class>
	</converter>

	<!-- **************** VALIDATORS ********************** -->
	<validator>
		<description>Validador para los porcentajes</description>
		<validator-id>porcentajeValidator</validator-id>
		<validator-class>com.code.aon.ui.payroll.validator.PorcentajeValidator</validator-class>
	</validator>
	<!-- 
	<validator>
		<description>Validador para los solapes</description>
		<validator-id>overlapValidator</validator-id>
		<validator-class>com.code.aon.ui.payroll.validator.overlapValidator</validator-class>
	</validator>
	 -->	
	<validator>
		<description>Validador para la letra de los DNI</description>
		<validator-id>letraDniValidator</validator-id>
		<validator-class>com.code.aon.ui.payroll.validator.LetraDniValidator</validator-class>
	</validator>
	<validator>
		<description>Validador para el rango de trimestre</description>
		<validator-id>trimestreValidator</validator-id>
		<validator-class>com.code.aon.ui.payroll.validator.TrimestreValidator</validator-class>
	</validator>
	<validator>
		<description>Validador para el rango del valor del mes</description>
		<validator-id>monthValidator</validator-id>
		<validator-class>com.code.aon.ui.payroll.validator.MonthValidator</validator-class>
	</validator>

	<!-- *************** RESOURCE RESOLVER ***************** --> 
	<managed-bean>
		<managed-bean-name>aonResource</managed-bean-name>
		<managed-bean-class>
			com.code.aon.ui.resources.bean.ResourceResolver
		</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
		<managed-property>
			<property-name>resourceURIPreffix</property-name>
			<value>/aonResource/3.5.1</value>
		</managed-property>		
	</managed-bean>
	
	<!--  *************** 
		AON CONFIGURATION
		***************** -->
	<managed-bean>
		<managed-bean-name>aonConfiguration</managed-bean-name>
		<managed-bean-class>
			com.code.aon.ui.common.controller.ConfigurationController
		</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
		<managed-property>
			<property-name>styleSheets</property-name>
			<list-entries>
				<value>#{aonResource.resolveLocal['/aon-richCss.css']}</value>
				<value>#{aonResource.resolveLocal['/css/payroll.css']}</value>
			</list-entries>
		</managed-property>
	</managed-bean>
	
	<!--  *************** 
		PAYROLL CONFIGURATION
		***************** -->
	<managed-bean>
		<managed-bean-name>payrollConfiguration</managed-bean-name>
		<managed-bean-class>
			com.code.aon.ui.payroll.controller.PayrollConfigurationController
		</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
		<!--  
		<managed-property>
			<property-name>styleSheets</property-name>
			<list-entries>
				<value>#{aonResource.resolveLocal['/aon-richCss.css']}</value>
				<value>#{aonResource.resolveLocal['/css/payroll.css']}</value>
			</list-entries>
		</managed-property>
		-->
	</managed-bean>

</faces-config>
