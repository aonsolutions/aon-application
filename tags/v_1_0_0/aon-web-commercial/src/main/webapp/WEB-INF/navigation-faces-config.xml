			<to-view-id>/marketing/surveyResponse/list.xhtml</to-view-id>
		</navigation-case>
		<navigation-case>
			<from-outcome>question</from-outcome>
			<to-view-id>/marketing/question/list.xhtml</to-view-id>
		</navigation-case>
		<navigation-case>
			<from-outcome>communicationCenter</from-outcome>
			<to-view-id>marketing/communicationCenter/formSurvey.xhtml</to-view-id>
		</navigation-case>
	</navigation-rule>
	
</faces-config>
