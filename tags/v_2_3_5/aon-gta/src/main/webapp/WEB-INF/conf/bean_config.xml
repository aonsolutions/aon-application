<?xml version="1.0" encoding="UTF-8"?>

<!DOCTYPE bean-config 
	PUBLIC "-//CODE-AON//DTD Bean Config//EN" 
	"http://co-de.com/aon/bean-config.dtd">

<bean-config>
	
	<bean description="Listener para controlar el check de permite apuntes de cuentas">
		<pojo>com.code.aon.account.Account</pojo>
		<listeners>
	        <listener>com.code.aon.account.event.AccountBeanListener</listener>
		</listeners>
		<vetoListeners>
	        <vetoListener>com.code.aon.account.event.AccountBeanVetoListener</vetoListener>
		</vetoListeners>
	</bean>

	<bean description="Listener para escribir los acumulados por cuenta">
		<pojo>com.code.aon.account.AccountEntry</pojo>
		<listeners>
	        <listener>com.code.aon.account.event.AccountEntrySummaryBeanListener</listener>
		</listeners>
		<vetoListeners>
	        <vetoListener>com.code.aon.account.event.AccountEntrySummaryBeanVetoListener</vetoListener>
		</vetoListeners>
	</bean>

	<bean description="Listener para escribir los acumulados por cuenta">
		<pojo>com.code.aon.account.AccountEntryDetail</pojo>
		<listeners>
	        <listener>com.code.aon.account.event.AccountEntryDetailSummaryBeanListener</listener>
		</listeners>
		<vetoListeners>
	        <vetoListener>com.code.aon.account.event.AccountEntryDetailSummaryBeanVetoListener</vetoListener>
		</vetoListeners>
	</bean>

	<bean description="">
		<pojo>com.code.aon.finance.Invoice</pojo>
		<listeners>
	        <listener>com.code.aon.finance.event.InvoiceBeanListener</listener>
		</listeners>
		<vetoListeners>
	        <vetoListener>com.code.aon.finance.event.InvoiceBeanVetoListener</vetoListener>
		</vetoListeners>
	</bean>
	
	<bean description="">
		<pojo>com.code.aon.finance.InvoiceDetail</pojo>
		<listeners>
	        <listener>com.code.aon.finance.event.InvoiceDetailBeanListener</listener>
		</listeners>
		<vetoListeners>
	        <vetoListener>com.code.aon.finance.event.InvoiceDetailBeanVetoListener</vetoListener>
		</vetoListeners>
	</bean>

	<bean description="">
		<pojo>com.code.aon.finance.Finance</pojo>
		<vetoListeners>
	        <vetoListener>com.code.aon.finance.event.FinanceBeanVetoListener</vetoListener>
		</vetoListeners>
	</bean>
	
	<bean description="">
		<pojo>com.code.aon.tas.TasItem</pojo>
		<vetoListeners>
	        <vetoListener>com.code.aon.ui.tas.event.TasItemBeanVetoListener</vetoListener>
		</vetoListeners>
	</bean>
	
	<bean description="">
		<pojo>com.code.aon.customer.Customer</pojo>
		<listeners>
	        <listener>com.code.aon.commercial.event.TargetFromCustomerBeanListener</listener>
		</listeners>
	</bean>
	
	<bean description="Listener para controlar el stock al haber movientos en albaranes de compra">
		<pojo>com.code.aon.warehouse.IncomeDetail</pojo>
		<listeners>
	        <listener>com.code.aon.warehouse.event.StockableBeanListener</listener>
		</listeners>
		<vetoListeners>
	        <vetoListener>com.code.aon.warehouse.event.StockableBeanVetoListener</vetoListener>
		</vetoListeners>
	</bean>
	
	<bean description="Listener para controlar el stock al haber movientos en albaranes de venta">
		<pojo>com.code.aon.warehouse.DeliveryDetail</pojo>
		<listeners>
	        <listener>com.code.aon.warehouse.event.StockableBeanListener</listener>
		</listeners>
		<vetoListeners>
	        <vetoListener>com.code.aon.warehouse.event.StockableBeanVetoListener</vetoListener>
		</vetoListeners>
	</bean>

</bean-config>