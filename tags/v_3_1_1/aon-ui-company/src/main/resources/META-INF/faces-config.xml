<faces-config xmlns="http://java.sun.com/xml/ns/javaee"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://java.sun.com/xml/ns/j2ee http://java.sun.com/xml/ns/j2ee/web-facesconfig_1_2.xsd"
	version="1.2">

	<!-- ************** EXTERNAL COLLECTIONS (RELOCATE) ****************** -->
	<managed-bean>
		<managed-bean-name>companyCollections</managed-bean-name>
		<managed-bean-class>
			com.code.aon.ui.company.controller.CompanyCollectionsController
		</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
	</managed-bean>

	<!--  **** COMPANY **** -->
	<managed-bean>
		<managed-bean-name>company</managed-bean-name>
		<managed-bean-class>
			com.code.aon.ui.company.controller.CompanyController
		</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
		<managed-property>
			<property-name>queryOnStartUP</property-name>
			<value>true</value>
		</managed-property>
		<managed-property>
			<property-name>pojo</property-name>
			<value>com.code.aon.company.Company</value>
		</managed-property>
		<managed-property>
			<property-name>beanName</property-name>
			<value>company</value>
		</managed-property>
		<managed-property>
			<property-name>listenerClasses</property-name>
			<value>#{companyListeners}</value>
		</managed-property>
	</managed-bean>
	
	<managed-bean>
		<managed-bean-name>companyListeners</managed-bean-name>
	    <managed-bean-class>java.util.LinkedList</managed-bean-class>
		<managed-bean-scope>none</managed-bean-scope>
		<list-entries>
			<value-class>
				com.code.aon.ui.form.event.IControllerListener
			</value-class>
			<value>#{companyControllerListener}</value>
			<value>#{companyLogoControllerListener}</value>
			<value>#{companyAppParamControllerListener}</value>
			<value>#{companyAddressListener}</value>
			<value>#{companyRecordDataChildListener}</value>
		</list-entries>
	</managed-bean>
	
	<managed-bean>
		<managed-bean-name>
			companyLogoControllerListener
		</managed-bean-name>
		<managed-bean-class>
			com.code.aon.ui.company.event.CompanyLogoControllerListener
		</managed-bean-class>
		<managed-bean-scope>none</managed-bean-scope>
	</managed-bean>
	
	<managed-bean>
		<managed-bean-name>
			companyAppParamControllerListener
		</managed-bean-name>
		<managed-bean-class>
			com.code.aon.ui.company.event.CompanyAppParamControllerListener
		</managed-bean-class>
		<managed-bean-scope>none</managed-bean-scope>
	</managed-bean>
	<managed-bean>
		<managed-bean-name>companyControllerListener</managed-bean-name>
		<managed-bean-class>
			com.code.aon.ui.company.event.CompanyControllerListener
		</managed-bean-class>
		<managed-bean-scope>none</managed-bean-scope>
	</managed-bean>
	<managed-bean>
		<managed-bean-name>companyAddress</managed-bean-name>
		<managed-bean-class>
			com.code.aon.ui.form.BasicController
		</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
		<managed-property>
			<property-name>pojo</property-name>
			<value>com.code.aon.registry.RegistryAddress</value>
		</managed-property>
		<managed-property>
			<property-name>beanName</property-name>
			<value>companyAddress</value>
		</managed-property>
		<managed-property>
			<property-name>listenerClasses</property-name>
			<list-entries>
				<value-class>
					com.code.aon.ui.form.event.IControllerListener
				</value-class>
				<value>#{companyAddressPosListener}</value>
				<value>#{companyRegistryChildListener}</value>
				<value>#{companyAddressListener}</value>
			</list-entries>
		</managed-property>
	</managed-bean>
	<managed-bean>
		<managed-bean-name>companyAddressPosListener</managed-bean-name>
		<managed-bean-class>
			com.code.aon.ui.company.event.CompanyAddressPosListener
		</managed-bean-class>
		<managed-bean-scope>none</managed-bean-scope>
	</managed-bean>
	<managed-bean>
		<managed-bean-name>
			companyRegistryChildListener
		</managed-bean-name>
		<managed-bean-class>
			com.code.aon.ui.form.listener.ChildControllerListener
		</managed-bean-class>
		<managed-bean-scope>none</managed-bean-scope>
		<managed-property>
			<property-name>masterBean</property-name>
			<value>company</value>
		</managed-property>
		<managed-property>
			<property-name>masterPropertyName</property-name>
			<value>registry</value>
		</managed-property>
	</managed-bean>
	<managed-bean>
		<managed-bean-name>companyAddressListener</managed-bean-name>
		<managed-bean-class>
			com.code.aon.ui.company.event.CompanyAddressListener
		</managed-bean-class>
		<managed-bean-scope>none</managed-bean-scope>
	</managed-bean>


	<!-- **** COMPANY RECORD DATA **** -->
	<managed-bean>
		<managed-bean-name>companyRecordData</managed-bean-name>
		<managed-bean-class>
			com.code.aon.ui.registry.controller.RecordDataController
		</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
		<managed-property>
			<property-name>queryOnStartUP</property-name>
			<value>true</value>
		</managed-property>
		<managed-property>
			<property-name>pojo</property-name>
			<value>com.code.aon.registry.RecordData</value>
		</managed-property>
		<managed-property>
			<property-name>beanName</property-name>
			<value>companyRecordData</value>
		</managed-property>
		<managed-property>
			<property-name>cascadeDelete</property-name>
			<value>true</value>
		</managed-property>
		<managed-property>
			<property-name>masterControllerName</property-name>
			<value>company</value>
		</managed-property>
		<managed-property>
			<property-name>listNavigation</property-name>
			<value>company_record_data_list</value>
		</managed-property>
		<managed-property>
			<property-name>formNavigation</property-name>
			<value>company_record_data_form</value>
		</managed-property>
		<managed-property>
			<property-name>propertyMap</property-name>
			<map-entries>
				<map-entry>
					<key>id</key>
					<value>registry.id</value>
				</map-entry>
			</map-entries>
		</managed-property>
		<managed-property>
			<property-name>listenerClasses</property-name>
			<list-entries>
				<value-class>
					com.code.aon.ui.form.event.IControllerListener
				</value-class>
				<value>#{recordDataAttachControllerListener}</value>
			</list-entries>
		</managed-property>
	</managed-bean>
	<managed-bean>
		<managed-bean-name>
			recordDataAttachControllerListener
		</managed-bean-name>
		<managed-bean-class>
			com.code.aon.ui.registry.controller.event.RecordDataAttachControllerListener
		</managed-bean-class>
		<managed-bean-scope>none</managed-bean-scope>
	</managed-bean>
	<managed-bean>
		<managed-bean-name>
			companyRecordDataChildListener
		</managed-bean-name>
		<managed-bean-class>
			com.code.aon.ui.form.listener.LinesControllerListener
		</managed-bean-class>
		<managed-bean-scope>none</managed-bean-scope>
		<managed-property>
			<property-name>childBean</property-name>
			<value>companyRecordData</value>
		</managed-property>
		<managed-property>
			<property-name>aliasMap</property-name>
			<map-entries>
				<map-entry>
					<key>RecordData_registry_id</key>
					<value>id</value>
				</map-entry>
			</map-entries>
		</managed-property>
	</managed-bean>

	<!--  **** WORKPLACE **** -->
	<managed-bean>
		<managed-bean-name>workplace</managed-bean-name>
		<managed-bean-class>
			com.code.aon.ui.form.BasicController
		</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
		<managed-property>
			<property-name>queryOnStartUP</property-name>
			<value>true</value>
		</managed-property>
		<managed-property>
			<property-name>pojo</property-name>
			<value>com.code.aon.company.WorkPlace</value>
		</managed-property>
		<managed-property>
			<property-name>beanName</property-name>
			<value>workplace</value>
		</managed-property>
	</managed-bean>


	<!-- =================== Company ========================== -->
	<navigation-rule>
		<navigation-case>
			<from-outcome>company</from-outcome>
			<to-view-id>
				/com/code/aon/ui/company/facelet/company/form.xhtml
			</to-view-id>
		</navigation-case>
		<navigation-case>
			<from-outcome>workplace</from-outcome>
			<to-view-id>
				/com/code/aon/ui/company/facelet/workplace/grid.xhtml
			</to-view-id>
		</navigation-case>
	</navigation-rule>

</faces-config>