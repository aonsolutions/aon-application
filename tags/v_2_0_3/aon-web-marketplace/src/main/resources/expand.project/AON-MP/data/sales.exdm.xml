<?xml version="1.0" encoding="UTF-8"?>
<table tableName="sales">
    <columns>
        <column label="Identificador unico del Pedido de Venta"
            name="id" sqlType="integer" type="integer"/>
        <column label="Identificador del Cliente" name="customer"
            sqlType="integer" type="integer"/>
        <column label="Serie del Pedido" length="3" name="series"
            sqlType="char" type="string"/>
        <column label="Numero del Pedido" name="number"
            sqlType="integer" type="integer"/>
        <column
            label="Identificador de la Direccion de envio del Pedido"
            name="shipping_address" sqlType="integer" type="integer"/>
        <column label="Identificador del Agente Comercial" name="seller"
            sqlType="integer" type="integer"/>
        <column label="Descuentos del Pedido" length="32"
            name="discount_expr" sqlType="varchar" type="string"/>
        <column label="Fecha de emision del Pedido" name="issue_date"
            sqlType="date" type="date"/>
        <column label="Identificador de la Forma de Pago"
            name="pay_method" sqlType="integer" type="integer"/>
        <column label="Tipo de Pedido" length="2" name="document_type"
            sqlType="tinyint" type="string"/>
        <column label="Nivel de seguridad del Pedido" length="2"
            name="security_level" sqlType="tinyint" type="string"/>
        <column label="Estado del Pedido" length="2" name="status"
            sqlType="tinyint" type="string"/>
        <column
            label="Identificador del Centro de Venta que realizo el Pedido"
            name="pos" sqlType="integer" type="integer"/>
    </columns>
    <virtualColumns/>
    <primaryKey>
        <column name="id"/>
    </primaryKey>
    <joins>
        <join description="sales_ibfk_1" foreignPath="data/seller.exdm.xml">
            <sourceColumns>
                <column name="seller"/>
            </sourceColumns>
        </join>
        <join description="sales_ibfk_2" foreignPath="data/customer.exdm.xml">
            <sourceColumns>
                <column name="customer"/>
            </sourceColumns>
        </join>
        <join description="sales_ibfk_3" foreignPath="data/raddress.exdm.xml">
            <sourceColumns>
                <column name="shipping_address"/>
            </sourceColumns>
        </join>
        <join description="sales_ibfk_4" foreignPath="data/pay_method.exdm.xml">
            <sourceColumns>
                <column name="pay_method"/>
            </sourceColumns>
        </join>
        <join description="sales_ibfk_5" foreignPath="data/pos.exdm.xml">
            <sourceColumns>
                <column name="pos"/>
            </sourceColumns>
        </join>
    </joins>
    <descriptionColumns/>
</table>
