<?xml version="1.0" encoding="UTF-8"?>
<table tableName="finance_tracking">
    <columns>
        <column label="Identificador unico" name="id" sqlType="integer" type="integer"/>
        <column label="Identificador de Vencimiento" name="finance"
            sqlType="integer" type="integer"/>
        <column label="Fecha de Seguimiento" name="tracking_date"
            sqlType="date" type="date"/>
        <column label="Tipo de Seguimiento" length="4" name="type"
            sqlType="tinyint" type="string"/>
        <column label="Descripcion de Seguimiento" length="128"
            name="description" sqlType="varchar" type="string"/>
        <column label="Importe" name="amount" sqlType="double" type="double"/>
    </columns>
    <virtualColumns/>
    <primaryKey>
        <column name="id"/>
    </primaryKey>
    <joins>
        <join description="finance_tracking_fk" foreignPath="data/finance.exdm.xml">
            <sourceColumns>
                <column name="finance"/>
            </sourceColumns>
        </join>
    </joins>
    <descriptionColumns/>
</table>
