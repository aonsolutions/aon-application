<?xml version="1.0" encoding="UTF-8"?>
<view description="Productos por proveedor" sqlSentence="SELECT invoice_detail.item, product.name description, &#xd;&#xa;&#x9;SUM(invoice_detail.quantity), &#xd;&#xa;&#x9;SUM(TRUNCATE(invoice_detail.taxable_base * ((invoice_tax.percentage + invoice.surcharge + 100) / 100), 2))&#xd;&#xa;  FROM invoice_detail, invoice, registry, item, product, invoice_tax&#xd;&#xa; WHERE product.id = item.product &#xd;&#xa;   AND invoice_detail.item = item.id &#xd;&#xa;   AND invoice_detail.invoice = invoice.id &#xd;&#xa;   AND invoice.registry = registry.id &#xd;&#xa;   AND invoice_tax.invoice_detail = invoice_detail.id&#xd;&#xa;   AND invoice.type = ?&#xd;&#xa;   AND registry.id = ? &#xd;&#xa;   AND invoice.issue_date BETWEEN ? AND ?&#xd;&#xa; GROUP BY invoice_detail.item">
    <parameters>
        <parameter name="type" type="INTEGER"/>
        <parameter columnReference="data/registry.exdm.xml/id"
            label="Proveedor" name="registry" type="INTEGER"/>
        <parameter name="iniDate" type="DATE"/>
        <parameter name="endDate" type="DATE"/>
    </parameters>
    <results>
        <result accessName="item" columnId="item"
            columnReference="data/invoice_detail.exdm.xml/item"
            label="Codigo" tableId="invoice_detail" type="INTEGER"/>
        <result accessName="name" columnId="name"
            columnReference="data/product.exdm.xml/name"
            label="Articulo" tableId="product" type="STRING"/>
        <result accessName="quantity" columnId="" label="Cantidad" type="DOUBLE"/>
        <result accessName="total" columnId="" label="Total" type="DOUBLE"/>
    </results>
    <dataModelReferences>
        <dataModelReference id="data/invoice.exdm.xml"/>
        <dataModelReference id="data/invoice_detail.exdm.xml"/>
        <dataModelReference id="data/item.exdm.xml"/>
        <dataModelReference id="data/product.exdm.xml"/>
        <dataModelReference id="data/registry.exdm.xml"/>
    </dataModelReferences>
</view>
