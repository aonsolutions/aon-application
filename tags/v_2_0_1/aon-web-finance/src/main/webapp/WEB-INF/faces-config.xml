	</converter>
	<converter>
		<description>Conversor Vacío para Integer</description>
		<converter-id>IntegerEmptyConverter</converter-id>
		<converter-class>com.code.aon.ui.finance.converter.IntegerEmptyConverter</converter-class>
	</converter>	
	<converter>
