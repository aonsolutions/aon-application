		<converter-id>aonProductStatusConverter</converter-id>
		<converter-class>com.code.aon.ui.product.converter.ProductStatusConverter</converter-class>
	</converter>
	<converter>
		<description>Conversor for report's OutputFormat Enumeration class</description>
