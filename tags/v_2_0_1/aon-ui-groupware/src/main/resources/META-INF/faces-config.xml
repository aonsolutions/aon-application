<?xml version="1.0"?>
<!DOCTYPE faces-config PUBLIC
  "-//Sun Microsystems, Inc.//DTD JavaServer Faces Config 1.1//EN"
  "http://java.sun.com/dtd/web-facesconfig_1_1.dtd">

<faces-config>

	<!--  *************** COLLECTIONS ***************** -->
	<managed-bean>
		<managed-bean-name>groupWareCollections</managed-bean-name>
		<managed-bean-class>
			com.code.aon.ui.groupware.controller.GroupWareCollectionsController
		</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
	</managed-bean>

	
	<!-- ************* ALARM ***************** -->
	<managed-bean>
		<managed-bean-name>alarm</managed-bean-name>
		<managed-bean-class>
			com.code.aon.ice.groupware.ICEAlarmController
		</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
		<managed-property>
			<property-name>queryOnStartUP</property-name>
			<value>true</value>
		</managed-property>
		<managed-property>
			<property-name>pojo</property-name>
			<value>com.code.aon.groupware.Alarm</value>
		</managed-property>
	</managed-bean>

	
	<!-- ************* NOTE ***************** -->
	<managed-bean>
		<managed-bean-name>note</managed-bean-name>
		<managed-bean-class>
			com.code.aon.ice.groupware.ICENoteController
		</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
		<managed-property>
			<property-name>queryOnStartUP</property-name>
			<value>true</value>
		</managed-property>
		<managed-property>
			<property-name>pojo</property-name>
			<value>com.code.aon.groupware.Note</value>
		</managed-property>
		<managed-property>
			<property-name>listenerClasses</property-name>
			<list-entries>
				<value-class>com.code.aon.ui.form.event.IControllerListener</value-class>
				<value>#{noteControllerListener}</value>
			</list-entries>
		</managed-property>
	</managed-bean>
	
	<managed-bean>
		<managed-bean-name>noteControllerListener</managed-bean-name>
		<managed-bean-class>
			com.code.aon.ui.groupware.event.NoteControllerListener
		</managed-bean-class>
		<managed-bean-scope>none</managed-bean-scope>
	</managed-bean>
	
	<!-- ************* NOTICE ***************** -->
	<managed-bean>
		<managed-bean-name>notice</managed-bean-name>
		<managed-bean-class>
			com.code.aon.ice.groupware.ICENoticeController
		</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
		<managed-property>
			<property-name>queryOnStartUP</property-name>
			<value>true</value>
		</managed-property>
		<managed-property>
			<property-name>pojo</property-name>
			<value>com.code.aon.groupware.Notice</value>
		</managed-property>
		<managed-property>
			<property-name>listenerClasses</property-name>
			<list-entries>
				<value-class>com.code.aon.ui.form.event.IControllerListener</value-class>
				<value>#{noticeControllerListener}</value>
			</list-entries>
		</managed-property>
	</managed-bean>
	
	<managed-bean>
		<managed-bean-name>noticeControllerListener</managed-bean-name>
		<managed-bean-class>
			com.code.aon.ui.groupware.event.NoticeControllerListener
		</managed-bean-class>
		<managed-bean-scope>none</managed-bean-scope>
	</managed-bean>
	
	<!-- ************* CONTACT ***************** -->
	<managed-bean>
		<managed-bean-name>contact</managed-bean-name>
		<managed-bean-class>
			com.code.aon.ice.groupware.ICEContactController
		</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
		<managed-property>
			<property-name>queryOnStartUP</property-name>
			<value>true</value>
		</managed-property>
		<managed-property>
			<property-name>pojo</property-name>
			<value>com.code.aon.groupware.Contact</value>
		</managed-property>
		<managed-property>
			<property-name>listenerClasses</property-name>
			<list-entries>
				<value-class>com.code.aon.ui.form.event.IControllerListener</value-class>
				<value>#{contactControllerListener}</value>
			</list-entries>
		</managed-property>
	</managed-bean>
	
	<managed-bean>
		<managed-bean-name>contactControllerListener</managed-bean-name>
		<managed-bean-class>
			com.code.aon.ui.groupware.event.ContactControllerListener
		</managed-bean-class>
		<managed-bean-scope>none</managed-bean-scope>
	</managed-bean>
	
	
	<!-- ************* FAVORITE ***************** -->
	<managed-bean>
		<managed-bean-name>favorite</managed-bean-name>
		<managed-bean-class>
			com.code.aon.ice.groupware.ICEFavoriteController
		</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
		<managed-property>
			<property-name>queryOnStartUP</property-name>
			<value>true</value>
		</managed-property>
		<managed-property>
			<property-name>pojo</property-name>
			<value>com.code.aon.groupware.Favorite</value>
		</managed-property>
		<managed-property>
			<property-name>listenerClasses</property-name>
			<list-entries>
				<value-class>com.code.aon.ui.form.event.IControllerListener</value-class>
				<value>#{favoriteControllerListener}</value>
			</list-entries>
		</managed-property>
	</managed-bean>
	
	<managed-bean>
		<managed-bean-name>favoriteControllerListener</managed-bean-name>
		<managed-bean-class>
			com.code.aon.ui.groupware.event.FavoriteControllerListener
		</managed-bean-class>
		<managed-bean-scope>none</managed-bean-scope>
	</managed-bean>

	<!-- ************* FAVORITE CATEGORY ***************** -->
	<managed-bean>
		<managed-bean-name>favoriteCategory</managed-bean-name>
		<managed-bean-class>
			com.code.aon.ice.controller.ICEController
		</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
		<managed-property>
			<property-name>queryOnStartUP</property-name>
			<value>true</value>
		</managed-property>
		<managed-property>
			<property-name>pojo</property-name>
			<value>com.code.aon.groupware.FavoriteCategory</value>
		</managed-property>
		<managed-property>
			<property-name>listenerClasses</property-name>
			<list-entries>
				<value-class>com.code.aon.ui.form.event.IControllerListener</value-class>
				<value>#{favoriteCategoryControllerListener}</value>
			</list-entries>
		</managed-property>
	</managed-bean>
	
	<managed-bean>
		<managed-bean-name>favoriteCategoryControllerListener</managed-bean-name>
		<managed-bean-class>
			com.code.aon.ui.groupware.event.FavoriteCategoryControllerListener
		</managed-bean-class>
		<managed-bean-scope>none</managed-bean-scope>
	</managed-bean>
	
	<!-- =================== Note ================= -->	
	<navigation-rule>
		<navigation-case>
			<from-outcome>note_form</from-outcome>
			<to-view-id>/groupware/facelet/note/form.faces</to-view-id>
		</navigation-case>
		<navigation-case>
			<from-outcome>note_list</from-outcome>
			<to-view-id>/groupware/facelet/note/list.faces</to-view-id>
		</navigation-case>
		<navigation-case>
	        <from-outcome>note_search</from-outcome>
	        <to-view-id>/groupware/facelet/note/search.faces</to-view-id>
	    </navigation-case>
	</navigation-rule>

	<!-- =================== Notice ================= -->	
	<navigation-rule>
		<navigation-case>
			<from-outcome>notice_form</from-outcome>
			<to-view-id>/groupware/facelet/notice/form.faces</to-view-id>
		</navigation-case>
		<navigation-case>
			<from-outcome>notice_list</from-outcome>
			<to-view-id>/groupware/facelet/notice/list.faces</to-view-id>
		</navigation-case>
		<navigation-case>
			<from-outcome>notice_search</from-outcome>
			<to-view-id>/groupware/facelet/notice/search.faces</to-view-id>
		</navigation-case>
	</navigation-rule>
	
	<!-- =================== Alarm ================= -->	
	<navigation-rule>
		<navigation-case>
			<from-outcome>alarm_list</from-outcome>
			<to-view-id>/groupware/facelet/alarm/list.faces</to-view-id>
		</navigation-case>
		<navigation-case>
	        <from-outcome>alarm_form</from-outcome>
	        <to-view-id>/groupware/facelet/alarm/form.faces</to-view-id>
	    </navigation-case>
	</navigation-rule>
	
	<!-- =================== Contact ================= -->	
	<navigation-rule>
		<navigation-case>
			<from-outcome>contact_form</from-outcome>
			<to-view-id>/groupware/facelet/contact/form.faces</to-view-id>
		</navigation-case>
		<navigation-case>
			<from-outcome>contact_list</from-outcome>
			<to-view-id>/groupware/facelet/contact/list.faces</to-view-id>
		</navigation-case>
		<navigation-case>
	        <from-outcome>contact_search</from-outcome>
	        <to-view-id>/groupware/facelet/contact/search.faces</to-view-id>
	    </navigation-case>
	</navigation-rule>
	
	<!-- =================== Favorite ================= -->	
	<navigation-rule>
		<navigation-case>
			<from-outcome>favorite_form</from-outcome>
			<to-view-id>/groupware/facelet/favorite/form.faces</to-view-id>
		</navigation-case>
		<navigation-case>
			<from-outcome>favorite_list</from-outcome>
			<to-view-id>/groupware/facelet/favorite/list.faces</to-view-id>
		</navigation-case>
		<navigation-case>
	        <from-outcome>favorite_search</from-outcome>
	        <to-view-id>/groupware/facelet/favorite/search.faces</to-view-id>
	    </navigation-case>
	</navigation-rule>

  <!-- =================== Application Menu Navigation Rules ================= -->	
  <navigation-rule>
    <navigation-case>
        <from-outcome>note</from-outcome>
        <to-view-id>/groupware/facelet/note/list.faces</to-view-id>
    </navigation-case>
    <navigation-case>
        <from-outcome>notice</from-outcome>
        <to-view-id>/groupware/facelet/notice/list.faces</to-view-id>
    </navigation-case>
 	<navigation-case>
        <from-outcome>alarm</from-outcome>
        <to-view-id>/groupware/facelet/alarm/list.faces</to-view-id>
    </navigation-case>
    <navigation-case>
        <from-outcome>contact</from-outcome>
        <to-view-id>/groupware/facelet/contact/list.faces</to-view-id>
    </navigation-case>
    <navigation-case>
        <from-outcome>favorite</from-outcome>
        <to-view-id>/groupware/facelet/favorite/list.faces</to-view-id>
    </navigation-case>
    <navigation-case>
        <from-outcome>favorite_category</from-outcome>
        <to-view-id>/groupware/facelet/favorite/category/grid.faces</to-view-id>
    </navigation-case>
  </navigation-rule>
</faces-config>