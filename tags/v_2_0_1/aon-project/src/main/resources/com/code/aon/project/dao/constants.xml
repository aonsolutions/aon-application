<?xml version="1.0" encoding="ISO-8859-1"?>
<dao>
	<bean class="com.code.aon.project.Activity" sqlName="activity">
		<alias names="id,dossier_id,activityType_id,workgroup_id,dossier_number,customer_document,customer_name,customer_surname,dossier_status" />
		<hibernate names="id,dossier.id,activityType.id,workgroup.id,dossier.number,dossier.customer.registry.document,dossier.customer.registry.name,dossier.customer.registry.surname,dossier.status" />
	</bean>

	<bean class="com.code.aon.project.Task" sqlName="task">
		<alias names="id,description,startDate,endDate,dueDate,priority,status,percent,user_id,workGroup_id,source,dossier_id,activity_id,sender_id,comments,customer_id" />
		<hibernate names="id,description,startDate,endDate,dueDate,priority,status,percent,user&lt;id,workGroup.id,source,dossier.id,activity.id,sender.id,comments,dossier.customer.id" />
	</bean>
	
	<bean class="com.code.aon.project.DailyTracking" sqlName="daily_tracking">
		<alias names="id,user_id,trackingDate,trackingDuration,jobType_id,customer_id,dossier_id,activity_id,comments" />
		<hibernate names="id,user.id,trackingDate,trackingDuration,jobType.id,customer&lt;id,dossier.id,activity.id,comments" />
	</bean>
	
</dao>