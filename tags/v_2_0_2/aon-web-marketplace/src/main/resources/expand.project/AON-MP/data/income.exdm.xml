<?xml version="1.0" encoding="UTF-8"?>
<table tableName="income">
    <columns>
        <column label="Identificador unico del Albaran de Compra"
            name="id" sqlType="integer" type="integer"/>
        <column label="Serie del Albaran" length="3" name="series"
            sqlType="char" type="string"/>
        <column label="Numero del Albaran" name="number"
            sqlType="integer" type="integer"/>
        <column label="Identificador del Proveedor" name="supplier"
            sqlType="integer" type="integer"/>
        <column
            label="Identificador de la Direccion de envio del Albaran"
            name="address" sqlType="integer" type="integer"/>
        <column label="Fecha de emision del Albaran" name="issue_time"
            sqlType="date" type="date"/>
        <column label="Nivel de seguridad del Albaran" length="2"
            name="security_level" sqlType="tinyint" type="string"/>
        <column label="Estado del Albaran" length="2" name="status"
            sqlType="tinyint" type="string"/>
    </columns>
    <virtualColumns/>
    <primaryKey>
        <column name="id"/>
    </primaryKey>
    <joins>
        <join description="income_ibfk_1" foreignPath="data/supplier.exdm.xml">
            <sourceColumns>
                <column name="supplier"/>
            </sourceColumns>
        </join>
        <join description="income_ibfk_2" foreignPath="data/raddress.exdm.xml">
            <sourceColumns>
                <column name="address"/>
            </sourceColumns>
        </join>
    </joins>
    <descriptionColumns/>
</table>
