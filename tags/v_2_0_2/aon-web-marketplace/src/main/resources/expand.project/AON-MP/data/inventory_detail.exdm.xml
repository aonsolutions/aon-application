<?xml version="1.0" encoding="UTF-8"?>
<table tableName="inventory_detail">
    <columns>
        <column label="Identificador unico del Detalle del Inventario"
            name="id" sqlType="integer" type="integer"/>
        <column label="Identificador de Inventario" name="inventory"
            sqlType="integer" type="integer"/>
        <column label="Articulo Inventariado" name="item"
            sqlType="integer" type="integer"/>
        <column label="Cantidad actual del Articulo Inventariado"
            name="actual_quantity" sqlType="double" type="double"/>
        <column label="Cantidad real del Articulo Inventariado"
            name="real_quantity" sqlType="double" type="double"/>
        <column label="Coste del Articulo Inventariado" name="cost"
            sqlType="double" type="double"/>
    </columns>
    <virtualColumns/>
    <primaryKey>
        <column name="id"/>
    </primaryKey>
    <joins>
        <join description="inventory_detail_ibfk_1" foreignPath="data/inventory.exdm.xml">
            <sourceColumns>
                <column name="inventory"/>
            </sourceColumns>
        </join>
        <join description="inventory_detail_ibfk_2" foreignPath="data/item.exdm.xml">
            <sourceColumns>
                <column name="item"/>
            </sourceColumns>
        </join>
    </joins>
    <descriptionColumns/>
</table>
