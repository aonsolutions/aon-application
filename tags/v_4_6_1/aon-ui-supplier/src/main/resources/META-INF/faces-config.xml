	<!-- ************ SUPPLIER LOOKUP ************** -->
	<managed-bean>
		<managed-bean-name>supplierLookup</managed-bean-name>
		<managed-bean-class>com.code.aon.ui.registry.controller.RegistryRichLookupBean</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
		<managed-property>
			<property-name>beanName</property-name>
			<value>supplierLookup</value>
		</managed-property>
		<managed-property>
			<property-name>foreignPojo</property-name>
			<value>com.code.aon.supplier.Supplier</value>
		</managed-property>
		<managed-property>
			<property-name>defaultOrder</property-name>
			<value>Supplier_registry_surname,Supplier_registry_name</value>
		</managed-property>
		<managed-property>
			<property-name>listPagePath</property-name>
			<value>/com/code/aon/ui/supplier/facelet/supplier/listBasic.xhtml</value>
		</managed-property>
		<managed-property>
			<property-name>searchPagePath</property-name>
			<value>/com/code/aon/ui/supplier/facelet/lookup/supplier/search.xhtml</value>
		</managed-property>
		<managed-property>
			<property-name>newPagePath</property-name>
			<value>/com/code/aon/ui/supplier/facelet/supplier/formNewContent.xhtml</value>
		</managed-property>
		<managed-property>
			<property-name>listenerClasses</property-name>
			<list-entries>
				<value-class>com.code.aon.ui.form.event.IControllerListener</value-class>
				<value>#{supplierLookupListener}</value>
				<value>#{supplierScopeListener}</value>
			</list-entries>
		</managed-property>
	</managed-bean>

