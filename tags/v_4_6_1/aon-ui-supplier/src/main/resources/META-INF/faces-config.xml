<faces-config version="1.2" xmlns="http://java.sun.com/xml/ns/javaee" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://java.sun.com/xml/ns/javaee http://java.sun.com/xml/ns/javaee/web-facesconfig_1_2.xsd">

	<application>
		<resource-bundle>
			<base-name>com.code.aon.ui.supplier.i18n.messages</base-name>
			<var>supplierBundle</var>
		</resource-bundle>
	</application>

	<!--  ********* SUPPLIER COLLECTIONS ***************** -->
	<managed-bean>
		<managed-bean-name>supplierCollections</managed-bean-name>
		<managed-bean-class>com.code.aon.ui.supplier.controller.SupplierCollectionsController</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
	</managed-bean>

	<!-- ************ ITEM SUPPLIER ************* -->
	<managed-bean>
		<managed-bean-name>itemSupplier</managed-bean-name>
		<managed-bean-class>com.code.aon.ui.supplier.controller.ItemSupplierController</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
		<managed-property>
			<property-name>pojo</property-name>
			<value>com.code.aon.supplier.ItemSupplier</value>
		</managed-property>
		<managed-property>
			<property-name>beanName</property-name>
			<value>itemSupplier</value>
		</managed-property>
		<managed-property>
			<property-name>defaultOrder</property-name>
			<value>ItemSupplier_priority</value>
		</managed-property>
		<managed-property>
			<property-name>masterControllerName</property-name>
			<value>item</value>
		</managed-property>
		<managed-property>
			<property-name>propertyMap</property-name>
			<map-entries>
				<map-entry>
					<key>id</key>
					<value>item.id</value>
				</map-entry>
			</map-entries>
		</managed-property>		
		<managed-property>
			<property-name>cascadeDelete</property-name>
			<value>true</value>
		</managed-property>
		<managed-property>
			<property-name>listenerClasses</property-name>
			<list-entries>
				<value-class>
					com.code.aon.ui.form.event.IControllerListener
				</value-class>
				<value>#{itemSupplierControllerListener}</value>
			</list-entries>
		</managed-property>
	</managed-bean>

	<managed-bean>
		<managed-bean-name>itemSupplierControllerListener</managed-bean-name>
		<managed-bean-class>
			com.code.aon.ui.supplier.event.ItemSupplierControllerListener
		</managed-bean-class>
		<managed-bean-scope>none</managed-bean-scope>
	</managed-bean>
	
	<managed-bean>
		<managed-bean-name>itemSupplierChildListener</managed-bean-name>
		<managed-bean-class>
			com.code.aon.ui.form.listener.LinesControllerListener
		</managed-bean-class>
		<managed-bean-scope>none</managed-bean-scope>
		<managed-property>
			<property-name>childBean</property-name>
			<value>itemSupplier</value>
		</managed-property>
		<managed-property>
			<property-name>aliasMap</property-name>
			<map-entries>
				<map-entry>
					<key>ItemSupplier_item_id</key>
                    <value>id</value>
				</map-entry>
			</map-entries>
		</managed-property>
	</managed-bean>

	<!--  ********* SUPPLIER ***************** -->
	<managed-bean>
		<managed-bean-name>supplier</managed-bean-name>
		<managed-bean-class>com.code.aon.ui.supplier.controller.SupplierController</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
		<managed-property>
			<property-name>queryOnStartUP</property-name>
			<value>false</value>
		</managed-property>
		<managed-property>
			<property-name>pojo</property-name>
			<value>com.code.aon.supplier.Supplier</value>
		</managed-property>
		<managed-property>
			<property-name>beanName</property-name>
			<value>supplier</value>
		</managed-property>
		<managed-property>
			<property-name>defaultOrder</property-name>
			<value>Supplier_registry_surname,Supplier_registry_name</value>
		</managed-property>
		<managed-property>
			<property-name>listenerClasses</property-name>
			<list-entries>
				<value-class>com.code.aon.ui.form.event.IControllerListener</value-class>
				<value>#{supplierSearch}</value>
				<value>#{supplierScopeListener}</value>
				<value>#{supplierAddressListener}</value>
				<value>#{supplierMediaListener}</value>
				<value>#{supplierRBankChildListener}</value>
				<value>#{supplierRPayMethodChildListener}</value>
				<value>#{supplierSegmentListener}</value>
				<value>#{supplierAddInfoListener}</value>
			</list-entries>
		</managed-property>
		<managed-property>
			<property-name>optionalListenerClasses</property-name>
			<value>#{supplierOptionalListeners}</value>
		</managed-property>
	</managed-bean>

	<managed-bean>
		<managed-bean-name>supplierOptionalListeners</managed-bean-name>
		<managed-bean-class>java.util.LinkedList</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
	</managed-bean>  

	<managed-bean>
		<managed-bean-name>supplierSearch</managed-bean-name>
		<managed-bean-class>com.code.aon.ui.supplier.event.SupplierSearchListener</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
	</managed-bean>

	<managed-bean>
		<managed-bean-name>supplierScopeListener</managed-bean-name>
		<managed-bean-class>com.code.aon.ui.config.event.ScopeFilterListener</managed-bean-class>
		<managed-bean-scope>none</managed-bean-scope>
		<managed-property>
			<property-name>aliasName</property-name>
			<value>Supplier_scope_id</value>
		</managed-property>
	</managed-bean>

