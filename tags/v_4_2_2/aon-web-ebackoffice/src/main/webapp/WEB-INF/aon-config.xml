<?xml version="1.0" encoding="UTF-8" ?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xmlns="http://www.esferalia.com/config">

	<product:config version="1.0"
		xmlns:product="http://www.esferalia.com/product">
		<product:product
		 showStock="true"
		 showAccount="false"
		 showAttachment="true"
		 showEcommerceDataTab="true" />
	</product:config>

	<commercial:config version="1.1"
		xmlns:commercial="http://www.esferalia.com/commercial">
		<commercial:offer
			showInvoicing="false"
			showSalesOrder="true"
		/>
		<commercial:target
			showTaxInfoData="true"
			showEcommerceTab="true"
			showProfile="false"
			showSearchOnlyCustomers="false"
			showCommercialTracking="false"
			showProduct="true"
			showSeller="true"
			showAddInfo="true"
		/>
		
	</commercial:config>


</config>
