<faces-config version="1.2"
	xmlns="http://java.sun.com/xml/ns/javaee"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://java.sun.com/xml/ns/javaee http://java.sun.com/xml/ns/javaee/web-facesconfig_1_2.xsd">

	<application>
		<resource-bundle>
			<base-name>com.code.aon.ui.messaging.i18n.messages</base-name>
			<var>smsBundle</var>
		</resource-bundle>
	</application>

	<managed-bean>
		<managed-bean-name>sms</managed-bean-name>
		<managed-bean-class>com.code.aon.ui.messaging.controller.SMSController</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
	</managed-bean>

	<managed-bean>
		<managed-bean-name>smsContact</managed-bean-name>
		<managed-bean-class>com.code.aon.ui.messaging.controller.SMSContactController</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
	</managed-bean>

	<navigation-rule>
	    <navigation-case>
	        <from-outcome>sms</from-outcome>
	        <to-view-id>/com/code/aon/ui/messaging/facelet/sms/form.xhtml</to-view-id>
	    </navigation-case>
	</navigation-rule>
	
</faces-config>