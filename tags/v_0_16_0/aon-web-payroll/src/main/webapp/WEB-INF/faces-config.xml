<?xml version="1.0"?>
<!DOCTYPE faces-config PUBLIC
  "-//Sun Microsystems, Inc.//DTD JavaServer Faces Config 1.1//EN"
  "http://java.sun.com/dtd/web-facesconfig_1_1.dtd">

<faces-config>
	<application>
		<message-bundle>
			com.code.aon.ui.payroll.i18n.messages
		</message-bundle>
		<locale-config>
			<default-locale>es</default-locale>
		</locale-config>
		<navigation-handler>com.code.aon.ui.audit.AuditNavigationHandler</navigation-handler>
	</application>

	<lifecycle>
		<phase-listener>
			com.code.aon.faces.component.sandbox.ValueChangePhaseListener
		</phase-listener>
	</lifecycle>

	<!--  *************** CONVERTERS ***************** -->
	<converter>
		<description>Conversor para los Enum</description>
		<converter-for-class>java.lang.Enum</converter-for-class>
		<converter-class>com.code.aon.ui.converter.EnumLocaleConverter</converter-class>
	</converter>
	<converter>
    	<converter-id>toConverter</converter-id>
    	<converter-class>com.code.aon.ui.payroll.converter.ITransferObjectConverter</converter-class>
	</converter>

	<!-- **************** VALIDATORS ********************** -->
	<validator>
		<description>Validador para los porcentajes</description>
		<validator-id>porcentajeValidator</validator-id>
		<validator-class>com.code.aon.ui.payroll.validator.PorcentajeValidator</validator-class>
	</validator>
	<validator>
		<description>Validador para los solapes</description>
		<validator-id>overlapValidator</validator-id>
		<validator-class>com.code.aon.ui.payroll.validator.overlapValidator</validator-class>
	</validator>

	<!-- *************** RESOURCE RESOLVER ***************** --> 
	<managed-bean>
		<managed-bean-name>aonResource</managed-bean-name>
		<managed-bean-class>
			com.code.aon.ui.resources.bean.ResourceResolver
		</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
		<managed-property>
			<property-name>resourceURIPreffix</property-name>
			<value>/aonResource/3.2.0</value>
		</managed-property>		
	</managed-bean>
	
	<!--  *************** 
		AON CONFIGURATION
		***************** -->
	<managed-bean>
		<managed-bean-name>aonConfiguration</managed-bean-name>
		<managed-bean-class>
			com.code.aon.ui.common.controller.ConfigurationController
		</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
		<managed-property>
			<property-name>styleSheets</property-name>
			<list-entries>
				<value>#{aonResource.resolveLocal['/aon-richCss.css']}</value>
				<value>#{aonResource.resolveLocal['/css/payroll.css']}</value>
			</list-entries>
		</managed-property>
		<managed-property>
			<property-name>applicationBundles</property-name>
			<map-entries>
				<map-entry>
					<key>bundle</key>
					<value>com.code.aon.ui.common.i18n.messages</value>
				</map-entry>
				<map-entry>
					<key>appBundle</key>
					<value>com.code.aon.ui.payroll.i18n.messages</value>
				</map-entry>
				<map-entry>
					<key>menuBundle</key>
					<value>com.code.aon.ui.payroll.i18n.menu</value>
				</map-entry>
				<map-entry>
					<key>securityBundle</key>
					<value>com.code.aon.bridge.i18n.messages</value>
				</map-entry>
			</map-entries>
		</managed-property>
	</managed-bean>

	<!-- **************** TIMEZONE CONTROLLER ************* -->
	<managed-bean>
		<managed-bean-name>timeZoneController</managed-bean-name>
		<managed-bean-class>com.code.aon.ui.common.controller.TimeZoneController</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
	</managed-bean>

	<!-- ***************** LOGGED USER ******************** --> 
	<managed-bean>
		<managed-bean-name>loggedUser</managed-bean-name>
		<managed-bean-class>com.code.aon.bridge.session.LoggedUser</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
	</managed-bean>
	
	<!-- **************** FAILED LOGIN ******************** --> 
	<managed-bean>
		<managed-bean-name>failedLogin</managed-bean-name>
		<managed-bean-class>com.code.aon.bridge.session.FailedLogin</managed-bean-class>
		<managed-bean-scope>request</managed-bean-scope>
	</managed-bean>

   	<!-- **************** REPORT ************************** -->
	<managed-bean>
		<managed-bean-name>report</managed-bean-name>
		<managed-bean-class>com.code.aon.ui.report.controller.ReportManager</managed-bean-class>
		<managed-bean-scope>request</managed-bean-scope>
	</managed-bean>

</faces-config>
