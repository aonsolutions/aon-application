<!DOCTYPE hibernate-configuration PUBLIC
	"-//Hibernate/Hibernate Configuration DTD 3.0//EN"
	"http://hibernate.sourceforge.net/hibernate-configuration-3.0.dtd">

<hibernate-configuration>

	<session-factory>

		<property name="connection.provider_class">com.code.aon.common.dao.hibernate.DBCPConnectionProvider</property>
		<property name="connection.service">jboss.admin:service=AonSecurity</property>
		<!-- 
		<property name="connection.service">Catalina:type=Security,name=AonSecurity</property>
		 -->
		<property name="connection.datasource">java:comp/env/jdbc/GBP</property>		
		<property name="dialect">org.hibernate.dialect.MySQLDialect</property>

		<!-- Mapping files -->
		<!-- Mapping files -->
		<mapping class="com.code.gbp.Campaign"/>
		<mapping class="com.code.gbp.CampaignSupplier"/>
		<mapping class="com.code.gbp.GeoZone"/>
		<mapping class="com.code.gbp.Incidence"/>
		<mapping class="com.code.gbp.IncidenceType"/>
		<mapping class="com.code.gbp.OfferSignature"/>
		<mapping class="com.code.gbp.Offer"/>
		<mapping class="com.code.gbp.Office"/>
		<mapping class="com.code.gbp.ProFormaInvoice"/>
		<mapping class="com.code.gbp.ProFormaSignature"/>
		<mapping class="com.code.gbp.Requirement"/>
		<mapping class="com.code.gbp.Supplier"/>
		<mapping class="com.code.gbp.SupplierAddInfo"/>
		<mapping class="com.code.gbp.SupplierContact"/>
		<mapping class="com.code.gbp.SupplierEconomicData"/>
		<mapping class="com.code.gbp.SupplierObservation"/>
	</session-factory>

</hibernate-configuration>