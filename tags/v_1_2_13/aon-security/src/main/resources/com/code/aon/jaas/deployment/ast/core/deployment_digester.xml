<?xml version="1.0" encoding="ISO-8859-1"?>
<digester-rules>

	<object-create-rule pattern="application" classname="com.code.aon.jaas.deployment.ast.core.ApplicationDescriptor"/>

	<call-method-rule pattern="*/ejb" methodname="addJAR" paramcount="0" />
	<call-method-rule pattern="*/web-uri" methodname="addWAR" paramcount="0" />

	<object-create-rule pattern="ejb-jar/assembly-descriptor" classname="com.code.aon.jaas.deployment.ast.core.AssemblyDescriptor"/>

	<pattern value="*/method-permission" >
		<object-create-rule classname="com.code.aon.jaas.deployment.ast.core.MethodPermission" />
		<call-method-rule pattern="role-name" methodname="addRole" paramcount="0" />
		<call-method-rule pattern="unchecked" methodname="addRole" paramcount="0" />
		<call-method-rule pattern="description" methodname="setDescription" paramcount="0" />
		<pattern value="method">
			<object-create-rule classname="com.code.aon.jaas.deployment.ast.core.Method" />
			<call-method-rule pattern="description" methodname="setDescription" paramcount="0" />
			<call-method-rule pattern="ejb-name" methodname="setName" paramcount="0" />
			<call-method-rule pattern="method-intf" methodname="setMethodIntf" paramcount="0" />
			<call-method-rule pattern="method-name" methodname="setMethod" paramcount="0" />
			<call-method-rule pattern="method-params" methodname="addMethodParam" paramcount="0" />
			
			<set-next-rule methodname="addMethod"/>
		</pattern>

		<set-next-rule methodname="add"/>
	</pattern>

	<object-create-rule pattern="web-app" classname="com.code.aon.jaas.deployment.ast.core.WebDescriptor"/>

	<pattern value="*/security-constraint" >
		<object-create-rule classname="com.code.aon.jaas.deployment.ast.core.SecurityConstraint" />
		<call-method-rule pattern="auth-constraint/role-name" methodname="addRole" paramcount="0" />
		<pattern value="web-resource-collection">
			<object-create-rule classname="com.code.aon.jaas.deployment.ast.core.ResourceCollection" />
			<call-method-rule pattern="web-resource-name" methodname="setName" paramcount="0" />
			<call-method-rule pattern="description" methodname="setDescription" paramcount="0" />
			<call-method-rule pattern="url-pattern" methodname="addPattern" paramcount="0" />
			<call-method-rule pattern="http-method" methodname="addMethod" paramcount="0" />

			<set-next-rule methodname="addMethod"/>
		</pattern>

		<set-next-rule methodname="add"/>
	</pattern>

	<pattern value="*/security-role" >
		<object-create-rule classname="com.code.aon.jaas.deployment.ast.core.SecurityRole"/>
		<call-method-rule pattern="role-name" methodname="setName" paramcount="0" />
		<call-method-rule pattern="description" methodname="setDescription" paramcount="0" />
		<set-next-rule methodname="add"/>
	</pattern>

</digester-rules>