<?xml version="1.0"?>
<!DOCTYPE faces-config PUBLIC
  "-//Sun Microsystems, Inc.//DTD JavaServer Faces Config 1.1//EN"
  "http://java.sun.com/dtd/web-facesconfig_1_1.dtd">

<faces-config>

	<!-- =================== HOME ================= -->
	<navigation-rule>
		<navigation-case>
			<from-outcome>home</from-outcome>
			<to-view-id>/homepage.xhtml</to-view-id>
		</navigation-case>
	</navigation-rule>
	
	<navigation-rule>
		<navigation-case>
			<from-outcome>logout</from-outcome>
			<to-view-id>/home.jsf</to-view-id> 
			<redirect/>
		</navigation-case>
	</navigation-rule>
	
	<!-- =================== Commercial Tracking ================= -->	
	<navigation-rule>
		<navigation-case>
			<from-outcome>commercialTracking_list</from-outcome>
			<to-view-id>/commercial/commercialTracking/list.xhtml</to-view-id>
		</navigation-case>
		<navigation-case>
			<from-outcome>commercialTracking_form</from-outcome>
			<to-view-id>/commercial/commercialTracking/form.xhtml</to-view-id>
		</navigation-case>
		<navigation-case>
			<from-outcome>commercialTracking_search</from-outcome>
			<to-view-id>/commercial/commercialTracking/search.xhtml</to-view-id>
		</navigation-case>
	</navigation-rule>		

	<!-- =================== Target ================= -->	
	<navigation-rule>
		<navigation-case>
			<from-outcome>target_list</from-outcome>
			<to-view-id>/commercial/target/list.xhtml</to-view-id>
		</navigation-case>
		<navigation-case>
			<from-outcome>target_form</from-outcome>
			<to-view-id>/commercial/target/form.xhtml</to-view-id>
		</navigation-case>
		<navigation-case>
			<from-outcome>target_search</from-outcome>
			<to-view-id>/commercial/target/search.xhtml</to-view-id>
		</navigation-case>
	</navigation-rule>		

	<!-- =================== Seller ================= -->	
	<navigation-rule>
		<navigation-case>
			<from-outcome>seller_list</from-outcome>
			<to-view-id>/commercial/seller/list.xhtml</to-view-id>
		</navigation-case>
		<navigation-case>
			<from-outcome>seller_form</from-outcome>
			<to-view-id>/commercial/seller/form.xhtml</to-view-id>
		</navigation-case>
		<navigation-case>
			<from-outcome>seller_search</from-outcome>
			<to-view-id>/commercial/seller/search.xhtml</to-view-id>
		</navigation-case>
	</navigation-rule>		

	<!-- =================== Application Menu Navigation Rules ================= -->
	<navigation-rule>
		<navigation-case>
			<from-outcome>commercialSegment</from-outcome>
			<to-view-id>/commercial/commercialSegment/grid.xhtml</to-view-id>
		</navigation-case>
		<navigation-case>
			<from-outcome>commercialActivity</from-outcome>
			<to-view-id>/commercial/commercialActivity/grid.xhtml</to-view-id>
		</navigation-case>
		<navigation-case>
			<from-outcome>commercialTracking</from-outcome>
			<to-view-id>/commercial/commercialTracking/form.xhtml</to-view-id>
		</navigation-case>
		<navigation-case>
			<from-outcome>target</from-outcome>
			<to-view-id>/commercial/target/search.xhtml</to-view-id>
		</navigation-case>
		<navigation-case>
			<from-outcome>seller</from-outcome>
			<to-view-id>/commercial/seller/search.xhtml</to-view-id>
		</navigation-case>
	</navigation-rule>
	
</faces-config>
