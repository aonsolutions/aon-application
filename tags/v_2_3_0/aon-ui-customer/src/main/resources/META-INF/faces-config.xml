<?xml version="1.0"?>
<!DOCTYPE faces-config PUBLIC
  "-//Sun Microsystems, Inc.//DTD JavaServer Faces Config 1.1//EN"
  "http://java.sun.com/dtd/web-facesconfig_1_1.dtd">

<faces-config>
	<managed-bean>
		<managed-bean-name>customerLookup</managed-bean-name>
		<managed-bean-class>
			com.code.aon.ui.customer.controller.CustomerLookupController
		</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
		<managed-property>
			<property-name>queryOnStartUP</property-name>
			<value>true</value>
		</managed-property>
		<managed-property>
			<property-name>foreignPojo</property-name>
			<value>com.code.aon.customer.Customer</value>
		</managed-property>
		<managed-property>
			<property-name>aliasPrefix</property-name>
			<value>Customer</value>
		</managed-property>
		<managed-property>
			<property-name>foreignJoinProperties</property-name>
			<list-entries>
				<value>id</value>
			</list-entries>
		</managed-property>
		<managed-property>
			<property-name>foreignDisplayProperties</property-name>
			<list-entries>
				<value>id</value>
				<value>registry.document</value>
			</list-entries>
		</managed-property>
		<managed-property>
			<description>Needed for Search Select Window</description>
			<property-name>searchPagePath</property-name>
			<value>/facelet/sw/customerSearch.faces</value>
		</managed-property>
		<managed-property>
			<description>Needed for New Window</description>
			<property-name>newPagePath</property-name>
			<value>/facelet/sw/customerNew.faces</value>
		</managed-property>
		<managed-property>
			<property-name>listenerClasses</property-name>
			<list-entries>
				<value-class>com.code.aon.ui.form.event.IControllerListener</value-class>
				<value>#{customerScopeListener}</value>
			</list-entries>
		</managed-property>
	</managed-bean>

	<managed-bean>
		<managed-bean-name>customerScopeListener</managed-bean-name>
		<managed-bean-class>com.code.aon.ui.config.event.ScopeFilterListener</managed-bean-class>
		<managed-bean-scope>none</managed-bean-scope>
		<managed-property>
			<property-name>aliasName</property-name>
			<value>Customer_scope_id</value>
		</managed-property>
	</managed-bean>

	<navigation-rule>
		<navigation-case>
			<from-outcome>customer_sw</from-outcome>
			<to-view-id>/facelet/sw/customer.faces</to-view-id>
		</navigation-case>
		<navigation-case>
			<from-outcome>customer_sw_search</from-outcome>
			<to-view-id>/facelet/sw/customerSearch.faces</to-view-id>
		</navigation-case>
	</navigation-rule>
	
	<!--  ********* CUSTOMER WIZARD  ***************** -->
	<managed-bean>
		<managed-bean-name>customerWizard</managed-bean-name>
		<managed-bean-class>
			com.code.aon.ui.customer.controller.CustomerWizard
		</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
	</managed-bean>
	<!--  ********* CUSTOMER CONVERTER ***************** -->
	<converter>
		<converter-for-class>com.code.aon.customer.Customer</converter-for-class>
		<converter-class>com.code.aon.ui.customer.converter.CustomerConverter</converter-class>
	</converter>
	<converter>
		<converter-id>CustomerRegistryConverter</converter-id>
		<converter-class>com.code.aon.ui.customer.converter.CustomerRegistryConverter</converter-class>
	</converter>
	
	
</faces-config>
