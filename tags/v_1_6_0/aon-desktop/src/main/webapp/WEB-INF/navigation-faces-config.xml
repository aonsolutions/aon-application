<?xml version="1.0"?>
<!DOCTYPE faces-config PUBLIC
  "-//Sun Microsystems, Inc.//DTD JavaServer Faces Config 1.1//EN"
  "http://java.sun.com/dtd/web-facesconfig_1_1.dtd">

<faces-config>

	<!-- =================== HOME ================= -->
	<navigation-rule>
		<navigation-case>
			<from-outcome>home</from-outcome>
			<to-view-id>/homepage.xhtml</to-view-id>
		</navigation-case>
	</navigation-rule>

	<!-- =================== HOME ================= -->
	<navigation-rule>
		<navigation-case>
			<from-outcome>index</from-outcome>
			<to-view-id>/index.xhtml</to-view-id>
		</navigation-case>
	</navigation-rule>

	<!-- =================== User ================= -->
	<navigation-rule>
		<navigation-case>
			<from-outcome>user_list</from-outcome>
			<to-view-id>/facelet/user/list.xhtml</to-view-id>
		</navigation-case>
		<navigation-case>
			<from-outcome>user_form</from-outcome>
			<to-view-id>/facelet/user/form.xhtml</to-view-id>
		</navigation-case>
		<navigation-case>
			<from-outcome>user_search</from-outcome>
			<to-view-id>/facelet/user/search.xhtml</to-view-id>
		</navigation-case>
		<navigation-case>
			<from-outcome>user_changepassword_form</from-outcome>
			<to-view-id>/facelet/user/changePassword.xhtml</to-view-id>
		</navigation-case>
		<navigation-case>
			<from-outcome>changepassword_form</from-outcome>
			<to-view-id>/facelet/user/changePasswordContent.xhtml</to-view-id>
		</navigation-case>
	</navigation-rule>
	
	<!-- =================== Application Menu Navigation Rules ================= -->
	<navigation-rule>
		<navigation-case>
			<from-outcome>user</from-outcome>
			<to-view-id>/facelet/user/list.xhtml</to-view-id>
		</navigation-case>
		<navigation-case>
			<from-outcome>work_group</from-outcome>
			<to-view-id>/facelet/workGroup/grid.xhtml</to-view-id>
		</navigation-case>
		<navigation-case>
			<from-outcome>scope</from-outcome>
			<to-view-id>/facelet/scope/grid.xhtml</to-view-id>
		</navigation-case>
		<navigation-case>
			<from-outcome>application_list</from-outcome>
			<to-view-id>/facelet/profile/application/list.xhtml</to-view-id>
		</navigation-case>
		<navigation-case>
			<from-outcome>profile_list</from-outcome>
			<to-view-id>/facelet/profile/list.xhtml</to-view-id>
		</navigation-case>
		<navigation-case>
			<from-outcome>profile_form</from-outcome>
			<to-view-id>/facelet/profile/form.xhtml</to-view-id>
		</navigation-case>
		<navigation-case>
			<from-outcome>user_profile_form</from-outcome>
			<to-view-id>/facelet/profile/user/form.xhtml</to-view-id>
		</navigation-case>
	    <navigation-case>
	        <from-outcome>sms</from-outcome>
	        <to-view-id>/facelet/messaging/sms/form.xhtml</to-view-id>
	    </navigation-case>
	    <navigation-case>
	        <from-outcome>fax</from-outcome>
	        <to-view-id>/facelet/messaging/fax/form.xhtml</to-view-id>
	    </navigation-case>
	</navigation-rule>
	
</faces-config>
