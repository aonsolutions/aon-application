<?xml version="1.0" encoding="UTF-8"?>

<!DOCTYPE bean-config 
	PUBLIC "-//CODE-AON//DTD Bean Config//EN" 
	"http://co-de.com/aon/bean-config.dtd">

<bean-config>

	<bean description="Listener para escribir los acumulados por cuenta">
		<pojo>com.code.aon.accounting.AccountEntry</pojo>
		<listeners>
	        <listener>com.code.aon.accounting.event.AccountEntrySummaryBeanListener</listener>
		</listeners>
		<vetoListeners>
	        <vetoListener>com.code.aon.accounting.event.AccountEntrySummaryBeanVetoListener</vetoListener>
		</vetoListeners>
	</bean>

	<bean description="Listener para escribir los acumulados por cuenta">
		<pojo>com.code.aon.accounting.AccountEntryDetail</pojo>
		<listeners>
	        <listener>com.code.aon.accounting.event.AccountEntryDetailSummaryBeanListener</listener>
		</listeners>
		<vetoListeners>
	        <vetoListener>com.code.aon.accounting.event.AccountEntryDetailBeanVetoListener</vetoListener>
	        <vetoListener>com.code.aon.accounting.event.AccountEntryDetailSummaryBeanVetoListener</vetoListener>
		</vetoListeners>
	</bean>
	
	<bean description="Listener que se encarga de recalcular las dotaciones.">
		<pojo>com.code.aon.accounting.Amortization</pojo>
		<vetoListeners>
	        <vetoListener>com.code.aon.accounting.event.AmortizationVetoableBeanListener</vetoListener>
		</vetoListeners>
	</bean>

	<bean description="Listener para controlar el solape entre fechas de diferentes periodos.">
		<pojo>com.code.aon.accounting.Period</pojo>
		<vetoListeners>
	        <vetoListener>com.code.aon.accounting.event.PeriodBeanVetoListener</vetoListener>
		</vetoListeners>
	</bean>
	
	<bean description="Listener para controlar que la fecha de nuevo apunte este dentro del periodo.">
		<pojo>com.code.aon.accounting.AccountEntry</pojo>
		<vetoListeners>
	        <vetoListener>com.code.aon.accounting.event.AccountEntryBeanVetoListener</vetoListener>
		</vetoListeners>
	</bean>
	
	<bean description="Listener para controlar que la cuenta de nuevo presupuesto permita apuntes.">
		<pojo>com.code.aon.accounting.AccountBudget</pojo>
		<vetoListeners>
	        <vetoListener>com.code.aon.accounting.event.AccountBudgetBeanVetoListener</vetoListener>
		</vetoListeners>
	</bean>

	<bean description="Listener para inicializar campos en Balance.">
		<pojo>com.code.aon.accounting.Balance</pojo>
		<vetoListeners>
	        <vetoListener>com.code.aon.accounting.event.BalanceBeanVetoListener</vetoListener>
		</vetoListeners>
	</bean>

	<bean description="Listener para controlar los datos del prestamo.">
		<pojo>com.code.aon.accounting.Loan</pojo>
		<vetoListeners>
	        <vetoListener>com.code.aon.accounting.event.LoanBeanVetoListener</vetoListener>
		</vetoListeners>
	</bean>
</bean-config>