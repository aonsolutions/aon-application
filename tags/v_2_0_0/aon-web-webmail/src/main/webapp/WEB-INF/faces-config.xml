<?xml version="1.0"?>
<!DOCTYPE faces-config PUBLIC
  "-//Sun Microsystems, Inc.//DTD JavaServer Faces Config 1.1//EN"
  "http://java.sun.com/dtd/web-facesconfig_1_1.dtd">

<faces-config>
	<application>
		<message-bundle>com.code.aon.ui.common.i18n.messages</message-bundle>
		<locale-config>
			<default-locale>es</default-locale>
		</locale-config>
        <view-handler>
            com.icesoft.faces.facelets.D2DFaceletViewHandler
        </view-handler>
	</application>

	<!--  *************** CONVERTERS ***************** -->
	<converter>
		<description>Conversor para los Enum</description>
		<converter-for-class>java.lang.Enum</converter-for-class>
		<converter-class>com.code.aon.ui.converter.EnumLocaleConverter</converter-class>
	</converter>
	
	<!--  *************** 
		COMMON
		***************** -->
	<managed-bean>
		<managed-bean-name>enviroment</managed-bean-name>
		<managed-bean-class>
			com.code.aon.ui.form.EnviromentController
		</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
	</managed-bean>

	<!--  *************** 
		AON CONFIGURATION
		***************** -->
	<managed-bean>
		<managed-bean-name>aonConfiguration</managed-bean-name>
		<managed-bean-class>com.code.aon.ui.common.controller.ConfigurationController</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
		<managed-property>
			<property-name>applicationLogoContextRelativePath</property-name>
			<value>/__theme_images/html/logo.gif</value>
		</managed-property>
		<managed-property>
			<property-name>applicationWelcomeContextRelativePath</property-name>
			<value>/__theme_images/html/aon-home.jpg</value>
		</managed-property>
		<managed-property>
			<property-name>style</property-name>
			<value>iceCss</value>
		</managed-property>
		<managed-property>
			<property-name>userStyleSheets</property-name>
			<list-entries>
				<value>/css/panelPopup.css</value>
				<value>/css/panelTabSet.css</value>
				<value>/css/selectInputDate.css</value>			
				<value>/css/outputConnectionStatus.css</value>							
				<value>/css/hyperview.css</value>
			</list-entries>
		</managed-property>		
		<managed-property>
			<property-name>applicationBundles</property-name>
			<map-entries>
				<map-entry>
					<key>bundle</key>
					<value>com.code.aon.ui.common.i18n.messages</value>
				</map-entry>
				<map-entry>
					<key>appBundle</key>
					<value>com.code.aon.ui.webmail.i18n.messages</value>
				</map-entry>
				<map-entry>
					<key>menuBundle</key>
					<value>com.code.aon.ui.webmail.i18n.menu</value>
				</map-entry>
				<map-entry>
					<key>securityBundle</key>
					<value>com.code.aon.bridge.i18n.messages</value>
				</map-entry>
			</map-entries>
		</managed-property>		
	</managed-bean>

	<!-- ******************
		TIMEZONE CONTROLLER
		*******************  	 -->
	<managed-bean>
		<managed-bean-name>timeZoneController</managed-bean-name>
		<managed-bean-class>com.code.aon.ui.common.controller.TimeZoneController</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
	</managed-bean>
	
	<!-- ************** EXCEPTION HANDLER ****************** -->
	<managed-bean>
		<managed-bean-name>exceptionBean</managed-bean-name>
		<managed-bean-class>
			com.code.aon.ui.common.controller.ExceptionBean
		</managed-bean-class>
		<managed-bean-scope>request</managed-bean-scope>
	</managed-bean>

	<!-- ************** REQUEST HANDLER ****************** -->
	<managed-bean>
		<managed-bean-name>requestController</managed-bean-name>
		<managed-bean-class>
			com.code.aon.ui.form.RequestController
		</managed-bean-class>
		<managed-bean-scope>request</managed-bean-scope>
	</managed-bean>

   <!-- ***************************************** -->
   <!-- ************ MANAGED BEANS ************** -->
   <!-- ***************************************** -->

	<!-- OutputProgress Render Manager-->
	<managed-bean>
		<managed-bean-name>renderManager</managed-bean-name>
		<managed-bean-class>
			com.icesoft.faces.async.render.RenderManager</managed-bean-class>
		<managed-bean-scope>application</managed-bean-scope>
	</managed-bean>

  <!-- ======================================================================= -->	
  <!-- =========================== Navigation Rules ========================== -->	
  <!-- ======================================================================= -->
  
  <!-- ======================================================================= -->	
  <!-- =================== Application Menu Navigation Rules ================= -->	
  <!-- ======================================================================= -->	

</faces-config>
