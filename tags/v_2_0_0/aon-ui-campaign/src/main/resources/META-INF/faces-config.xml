<?xml version="1.0"?>
<!DOCTYPE faces-config PUBLIC
  "-//Sun Microsystems, Inc.//DTD JavaServer Faces Config 1.1//EN"
  "http://java.sun.com/dtd/web-facesconfig_1_1.dtd">

<faces-config>

	<!--  *************** CONVERTERS ***************** -->
	<converter>
		<description>Conversor para los CampaignTypes</description>
		<converter-id>aonCampaignTypeConverter</converter-id>
		<converter-class>com.code.aon.ui.campaign.converter.CampaignTypeConverter</converter-class>
	</converter>

	<converter>
		<description>Conversor para los CampaignStatus</description>
		<converter-id>aonCampaignStatusConverter</converter-id>
		<converter-class>com.code.aon.ui.campaign.converter.CampaignStatusConverter</converter-class>
	</converter>

	<!--  *************** COLLECTIONS ***************** -->
	<managed-bean>
		<managed-bean-name>campaignCollections</managed-bean-name>
		<managed-bean-class>
			com.code.aon.ui.campaign.controller.CampaignCollectionsController
		</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
	</managed-bean>

	<!-- ************* PROCESS ***************** -->
	<managed-bean>
		<managed-bean-name>process</managed-bean-name>
		<managed-bean-class>
			com.code.aon.ui.form.BasicController
		</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
		<managed-property>
			<property-name>queryOnStartUP</property-name>
			<value>true</value>
		</managed-property>
		<managed-property>
			<property-name>pojo</property-name>
			<value>com.code.aon.campaign.Process</value>
		</managed-property>
		<managed-property>
			<property-name>listenerClasses</property-name>
			<list-entries>
				<value-class>com.code.aon.ui.form.event.IControllerListener</value-class>
				<value>#{processDetailListener}</value>
			</list-entries>
		</managed-property>
	</managed-bean>
	
	<managed-bean>
		<managed-bean-name>processDetailListener</managed-bean-name>
		<managed-bean-class>
			com.code.aon.ui.form.listener.LinesControllerListener
		</managed-bean-class>
		<managed-bean-scope>none</managed-bean-scope>
		<managed-property>
			<property-name>childBean</property-name>
			<value>processDetail</value>
		</managed-property>
		<managed-property>
			<property-name>aliasMap</property-name>
			<map-entries>
				<map-entry>
					<key>ProcessDetail_process_id</key>
                    <value>id</value>
				</map-entry>
			</map-entries>
		</managed-property>
	</managed-bean>
	
	<!-- ************* PROCESS DETAIL ***************** -->
	<managed-bean>
		<managed-bean-name>processDetail</managed-bean-name>
		<managed-bean-class>com.code.aon.ui.campaign.controller.ProcessDetailController</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
		<managed-property>
			<property-name>queryOnStartUP</property-name>
			<value>true</value>
		</managed-property>
		<managed-property>
			<property-name>pojo</property-name>
			<value>com.code.aon.campaign.ProcessDetail</value>
		</managed-property>
		<managed-property>
			<property-name>cascadeDelete</property-name>
			<value>true</value>
		</managed-property>
		<managed-property>
			<property-name>masterControllerName</property-name>
			<value>process</value>
		</managed-property>
		<managed-property>
			<property-name>propertyMap</property-name>
			<map-entries>
				<map-entry>
					<key>id</key>
					<value>process.id</value>
				</map-entry>
			</map-entries>
		</managed-property>
		<managed-property>
			<property-name>listenerClasses</property-name>
			<list-entries>
				<value-class>com.code.aon.ui.form.event.IControllerListener</value-class>
				<value>#{processDetailControllerListener}</value>
			</list-entries>
		</managed-property>
	</managed-bean>
	
	<managed-bean>
		<managed-bean-name>processDetailControllerListener</managed-bean-name>
		<managed-bean-class>
			com.code.aon.ui.campaign.event.ProcessDetailControllerListener
		</managed-bean-class>
		<managed-bean-scope>none</managed-bean-scope>
	</managed-bean>
	
	<!-- ************* CAMPAIGN ***************** -->
	<managed-bean>
		<managed-bean-name>campaign</managed-bean-name>
		<managed-bean-class>
			com.code.aon.ui.campaign.controller.CampaignController
		</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
		<managed-property>
			<property-name>queryOnStartUP</property-name>
			<value>true</value>
		</managed-property>
		<managed-property>
			<property-name>pojo</property-name>
			<value>com.code.aon.campaign.Campaign</value>
		</managed-property>
		<managed-property>
			<property-name>listenerClasses</property-name>
			<list-entries>
				<value-class>com.code.aon.ui.form.event.IControllerListener</value-class>
				<value>#{campaignDossierListener}</value>
				<value>#{campaignControllerListener}</value>
			</list-entries>
		</managed-property>
	</managed-bean>
	
	<managed-bean>
		<managed-bean-name>campaignDossierListener</managed-bean-name>
		<managed-bean-class>
			com.code.aon.ui.form.listener.LinesControllerListener
		</managed-bean-class>
		<managed-bean-scope>none</managed-bean-scope>
		<managed-property>
			<property-name>childBean</property-name>
			<value>campaignDossier</value>
		</managed-property>
		<managed-property>
			<property-name>aliasMap</property-name>
			<map-entries>
				<map-entry>
					<key>CampaignDossier_campaign_id</key>
                    <value>id</value>
				</map-entry>
			</map-entries>
		</managed-property>
	</managed-bean>
	
	<managed-bean>
		<managed-bean-name>campaignControllerListener</managed-bean-name>
		<managed-bean-class>
			com.code.aon.ui.campaign.event.CampaignControllerListener
		</managed-bean-class>
		<managed-bean-scope>none</managed-bean-scope>
	</managed-bean>
	
	<!-- ************* CAMPAIGN DOSSIER ***************** -->
	<managed-bean>
		<managed-bean-name>campaignDossier</managed-bean-name>
		<managed-bean-class>
			com.code.aon.ui.campaign.controller.CampaignDossierController
		</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
		<managed-property>
			<property-name>queryOnStartUP</property-name>
			<value>true</value>
		</managed-property>
		<managed-property>
			<property-name>pojo</property-name>
			<value>com.code.aon.campaign.CampaignDossier</value>
		</managed-property>
		<managed-property>
			<property-name>masterControllerName</property-name>
			<value>campaign</value>
		</managed-property>
		<managed-property>
			<property-name>propertyMap</property-name>
			<map-entries>
				<map-entry>
					<key>id</key>
					<value>campaign.id</value>
				</map-entry>
			</map-entries>
		</managed-property>
		<managed-property>
			<property-name>listenerClasses</property-name>
			<list-entries>
				<value-class>com.code.aon.ui.form.event.IControllerListener</value-class>
				<value>#{campaignDossierControllerListener}</value>
			</list-entries>
		</managed-property>
	</managed-bean>
	
	<managed-bean>
		<managed-bean-name>campaignDossierControllerListener</managed-bean-name>
		<managed-bean-class>
			com.code.aon.ui.campaign.event.CampaignDossierControllerListener
		</managed-bean-class>
		<managed-bean-scope>none</managed-bean-scope>
	</managed-bean>
	
	<!-- ************* ADD CAMPAIGN DOSSIER ***************** -->
	<managed-bean>
		<managed-bean-name>addCampaignDossier</managed-bean-name>
		<managed-bean-class>
			com.code.aon.ui.campaign.controller.AddCampaignDossierController
		</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
		<managed-property>
			<property-name>queryOnStartUP</property-name>
			<value>true</value>
		</managed-property>
		<managed-property>
			<property-name>pojo</property-name>
			<value>com.code.aon.project.Activity</value>
		</managed-property>
	</managed-bean>
	
	<!-- ************* ACTIVITY PROCESS ***************** -->
	<managed-bean>
		<managed-bean-name>activityProcess</managed-bean-name>
		<managed-bean-class>
			com.code.aon.ui.campaign.controller.ActivityProcessController
		</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
		<managed-property>
			<property-name>queryOnStartUP</property-name>
			<value>true</value>
		</managed-property>
		<managed-property>
			<property-name>pojo</property-name>
			<value>com.code.aon.campaign.ActivityProcess</value>
		</managed-property>
	</managed-bean>
	
	<!-- =================== Process ================= -->	
	<navigation-rule>
		<navigation-case>
			<from-outcome>process_list</from-outcome>
			<to-view-id>/facelet/process/list.faces</to-view-id>
		</navigation-case>
		<navigation-case>
	        <from-outcome>process_form</from-outcome>
	        <to-view-id>/facelet/process/form.faces</to-view-id>
	    </navigation-case>
		<navigation-case>
	        <from-outcome>process_search</from-outcome>
	        <to-view-id>/facelet/process/search.faces</to-view-id>
	    </navigation-case>
	</navigation-rule>
	
	<!-- =================== Campaign ================= -->	
	<navigation-rule>
		<navigation-case>
			<from-outcome>campaign_list</from-outcome>
			<to-view-id>/facelet/campaign/list.faces</to-view-id>
		</navigation-case>
		<navigation-case>
	        <from-outcome>campaign_form</from-outcome>
	        <to-view-id>/facelet/campaign/form.faces</to-view-id>
	    </navigation-case>
		<navigation-case>
	        <from-outcome>campaign_search</from-outcome>
	        <to-view-id>/facelet/campaign/search.faces</to-view-id>
	    </navigation-case>
		<navigation-case>
	        <from-outcome>campaign_add_dossier</from-outcome>
	        <to-view-id>/facelet/campaign/addCampaignDossier/form.faces</to-view-id>
	    </navigation-case>
		<navigation-case>
	        <from-outcome>campaign_view_task</from-outcome>
	        <to-view-id>/facelet/campaign/viewCampaignTask/form.faces</to-view-id>
	    </navigation-case>
	</navigation-rule>

  <!-- =================== Application Menu Navigation Rules ================= -->	
  <navigation-rule>
	<navigation-case>
		<from-outcome>content</from-outcome>
		<to-view-id>/facelet/homepage/content.faces</to-view-id>
	</navigation-case>
	<navigation-case>
        <from-outcome>firstContent</from-outcome>
        <to-view-id>/facelet/homepage/firstContent.faces</to-view-id>
    </navigation-case>
   	<navigation-case>
        <from-outcome>process</from-outcome>
        <to-view-id>/facelet/process/list.faces</to-view-id>
    </navigation-case>
 	<navigation-case>
        <from-outcome>campaign</from-outcome>
        <to-view-id>/facelet/campaign/list.faces</to-view-id>
    </navigation-case>
  </navigation-rule>
</faces-config>