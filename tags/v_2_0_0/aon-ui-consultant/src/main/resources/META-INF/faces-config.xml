<?xml version="1.0"?>
<!DOCTYPE faces-config PUBLIC
  "-//Sun Microsystems, Inc.//DTD JavaServer Faces Config 1.1//EN"
  "http://java.sun.com/dtd/web-facesconfig_1_1.dtd">

<faces-config>

	<!--  *************** COLLECTIONS ***************** -->
	<managed-bean>
		<managed-bean-name>consultantCollections</managed-bean-name>
		<managed-bean-class>
			com.code.aon.ui.consultant.controller.ConsultantCollectionsController
		</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
	</managed-bean>

	<!-- ************* REGISTRY DIR STAFF ***************** -->
	<managed-bean>
		<managed-bean-name>rdirStaff</managed-bean-name>
		<managed-bean-class>
			com.code.aon.ui.consultant.controller.RegistryDirStaffController
		</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
		<managed-property>
			<property-name>queryOnStartUP</property-name>
			<value>true</value>
		</managed-property>
		<managed-property>
			<property-name>pojo</property-name>
			<value>com.code.aon.consultant.RegistryDirStaff</value>
		</managed-property>
		<managed-property>
			<property-name>listenerClasses</property-name>
			<list-entries>
				<value-class>com.code.aon.ui.form.event.IControllerListener</value-class>
				<value>#{registryDirStaffControllerListener}</value>
			</list-entries>
		</managed-property>
	</managed-bean>
	
	<managed-bean>
		<managed-bean-name>registryDirStaffControllerListener</managed-bean-name>
		<managed-bean-class>
			com.code.aon.ui.consultant.event.RegistryDirStaffControllerListener
		</managed-bean-class>
		<managed-bean-scope>none</managed-bean-scope>
	</managed-bean>
	
	<!-- ************* RECORD DATA ***************** -->
	<managed-bean>
		<managed-bean-name>recordData</managed-bean-name>
		<managed-bean-class>
			com.code.aon.ui.consultant.controller.RecordDataController
		</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
		<managed-property>
			<property-name>queryOnStartUP</property-name>
			<value>true</value>
		</managed-property>
		<managed-property>
			<property-name>pojo</property-name>
			<value>com.code.aon.consultant.RecordData</value>
		</managed-property>
		<managed-property>
			<property-name>listenerClasses</property-name>
			<list-entries>
				<value-class>com.code.aon.ui.form.event.IControllerListener</value-class>
				<value>#{recordDataControllerListener}</value>
				<value>#{recordDataAttachControllerListener}</value>
			</list-entries>
		</managed-property>
	</managed-bean>

	<managed-bean>
		<managed-bean-name>recordDataControllerListener</managed-bean-name>
		<managed-bean-class>
			com.code.aon.ui.consultant.event.RecordDataControllerListener
		</managed-bean-class>
		<managed-bean-scope>none</managed-bean-scope>
	</managed-bean>

	<managed-bean>
		<managed-bean-name>recordDataAttachControllerListener</managed-bean-name>
		<managed-bean-class>
			com.code.aon.ui.consultant.event.RecordDataAttachControllerListener
		</managed-bean-class>
		<managed-bean-scope>none</managed-bean-scope>
	</managed-bean>
	
	<!-- =================== Registry Dir Staff ================= -->	
	<navigation-rule>
		<navigation-case>
			<from-outcome>rdir_staff</from-outcome>
			<to-view-id>/facelet/rdir_staff/grid.faces</to-view-id>
		</navigation-case>
	</navigation-rule>	
	
	<!-- =================== Record Data ================= -->	
	<navigation-rule>
		<navigation-case>
			<from-outcome>record_data_list</from-outcome>
			<to-view-id>/facelet/record_data/list.faces</to-view-id>
		</navigation-case>
		<navigation-case>
			<from-outcome>record_data_form</from-outcome>
			<to-view-id>/facelet/record_data/form.faces</to-view-id>
		</navigation-case>
	</navigation-rule>	
	
  <!-- =================== Application Menu Navigation Rules ================= -->	
  <navigation-rule>
	<navigation-case>
		<from-outcome>content</from-outcome>
		<to-view-id>/facelet/homepage/content.faces</to-view-id>
	</navigation-case>
	<navigation-case>
        <from-outcome>firstContent</from-outcome>
        <to-view-id>/facelet/homepage/firstContent.faces</to-view-id>
    </navigation-case>
    <navigation-case>
        <from-outcome>inbox</from-outcome>
        <to-view-id>/facelet/inbox/inbox.faces</to-view-id>
    </navigation-case>
  </navigation-rule>
</faces-config>