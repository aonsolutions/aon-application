<?xml version="1.0" encoding="ISO-8859-1"?>

<!DOCTYPE report-config 
	PUBLIC "-//CODE-AON//DTD Report Config//EN" 
	"http://co-de.com/aon/report-config.dtd">

<report-config>
	
	<!--  **********************************************************
						INVENTORY 
		  ********************************************************** -->

	<report id="inventory" description="Inventory Report">
		<template path="/com/code/aon/ui/warehouse/report/inventory.jasper" />
		<bean key="com.code.aon.warehouse.Inventory" />
		<criteria provider="#{inventory}" />
		<params>
			<param id="REPORT_RESOURCE_BUNDLE" value="com.code.aon.ui.warehouse.i18n.report" />
			<param id="logoImageFile" value="#{company.getAttachAsInputStream}" />
			<param id="company" value="#{company.obtainCompany}" />
		</params>
	</report>
	
	<report id="inventory_close" description="Inventory Count report">
		<template path="/com/code/aon/ui/warehouse/report/count.jasper" />
		<collection provider="#{inventoryDetail}" />
		<params>
			<param id="REPORT_RESOURCE_BUNDLE" value="com.code.aon.ui.warehouse.i18n.report" />
			<param id="logoImageFile" value="#{company.getAttachAsInputStream}" />
			<param id="company" value="#{company.obtainCompany}" />
		</params>
	</report>
	
	<report id="inventory_valued" description="Valued Inventory report">
		<template path="/com/code/aon/ui/warehouse/report/valued.jasper" />
		<collection provider="#{inventoryDetail}" />
		<params>
			<param id="REPORT_RESOURCE_BUNDLE" value="com.code.aon.ui.warehouse.i18n.report" />
			<param id="logoImageFile" value="#{company.getAttachAsInputStream}" />
			<param id="company" value="#{company.obtainCompany}" />			
		</params>
	</report>

	<!--  **********************************************************
						      STOCK
		  ********************************************************** -->
	<report id="stockWarehouseList" description="Stock report By Warehouse">
		<template path="/com/code/aon/ui/warehouse/report/stockWarehouseList.jasper" />
		<bean key="com.code.aon.warehouse.Stock" />
		<criteria provider="#{stock}" />
		<params>
			<param id="REPORT_RESOURCE_BUNDLE" value="com.code.aon.ui.warehouse.i18n.report" />
			<param id="logoImageFile" value="#{company.getAttachAsInputStream}" />
			<param id="company" value="#{company.obtainCompany}" />
		</params>
	</report>	  

	<report id="stockItemList" description="Stock report By Item">
		<template path="/com/code/aon/ui/warehouse/report/stockItemList.jasper" />
		<bean key="com.code.aon.warehouse.Stock" />
		<criteria provider="#{stock}" />
		<params>
			<param id="REPORT_RESOURCE_BUNDLE" value="com.code.aon.ui.warehouse.i18n.report" />
			<param id="logoImageFile" value="#{company.getAttachAsInputStream}" />
			<param id="company" value="#{company.obtainCompany}" />
		</params>
	</report>
	
		<!--  **********************************************************
						      DELIVERY
		  ********************************************************** -->
	<report id="delivery" description="Delivery report ">
		<template path="/com/code/aon/ui/warehouse/report/delivery.jasper" />
		<collection provider="#{delivery}" forceRefresh="true"/>
		<params>
			<param id="REPORT_RESOURCE_BUNDLE" value="com.code.aon.ui.warehouse.i18n.report" />
			<param id="logoImageFile" value="#{company.getAttachAsInputStream}" />
			<param id="company" value="#{company.obtainCompany}" />
			<param id="logoImageFile" value="#{company.getAttachAsInputStream}" />
			<param id="recordData" value="#{company.getCompanyRecordData}" />
			<param id="company" value="#{company.obtainCompany}" />
			<param id="phone" value="#{company.obtainPhone}" />
			<param id="fax" value="#{company.obtainFax}" />
			<param id="email" value="#{company.obtainEmail}" />
			<param id="web" value="#{company.obtainWeb}" />
			<param id="address" value="#{company.obtainAddress}" />
			<param id="printRecordData" value="#{company.isPrintRecordData}"/>
			<param id="printHeader" value="#{company.isPrintHeader}" />
			<param id="PriceStrategy" value="#{deliveryDetail.getPriceStrategy}" />
			<param id="TotalPrice" value="#{delivery.getTotalPrice}" />
			<param id="warehouse" value="#{delivery.getWarehouse}" />
			<param id="defaultPayMethod" value="#{delivery.getDefaultPayMethod}" />
		</params>
		
		<nested-report report="deliveryDetail"/>
	 	<nested-report report="deliveryVatBreakDown"/>	
	</report>
		
	<report id="deliveryDetail" description="Delivery's Subreport">
		<template path="/com/code/aon/ui/warehouse/report/deliveryDetail.jasper" />	
	</report>
	
	<report id="deliveryVatBreakDown" description="VatBreakDown's Subreport">
		<template path="/com/code/aon/ui/warehouse/report/deliveryVatBreakDown.jasper"/>
	</report>
	
