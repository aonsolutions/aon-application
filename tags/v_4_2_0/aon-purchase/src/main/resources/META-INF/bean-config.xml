<?xml version="1.0" encoding="UTF-8"?>

<!DOCTYPE bean-config 
	PUBLIC "-//CODE-AON//DTD Bean Config//EN" 
	"http://co-de.com/aon/bean-config.dtd">

<bean-config>

	<bean description="">
		<pojo>com.code.aon.purchase.Purchase</pojo>
		<vetoListeners>
	        <vetoListener>com.code.aon.purchase.event.PurchaseBeanVetoListener</vetoListener>
		</vetoListeners>
	</bean>

	<bean description="">
		<pojo>com.code.aon.purchase.PurchaseDetail</pojo>
		<listeners>
	        <listener>com.code.aon.purchase.event.PurchaseDetailBeanListener</listener>
		</listeners>
	</bean>
	
</bean-config>