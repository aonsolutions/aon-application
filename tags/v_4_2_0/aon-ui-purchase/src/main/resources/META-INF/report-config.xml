<?xml version="1.0" encoding="ISO-8859-1"?>

<!DOCTYPE report-config 
	PUBLIC "-//CODE-AON//DTD Report Config//EN" 
	"http://co-de.com/aon/report-config.dtd">

<report-config>
	
	<!--  *********  Listado Detallado Pedido de Compras  ********* -->

	<report id="purchaseList" description="Listado de purchase">
		<template path="/com/code/aon/ui/purchase/report/purchaseList.jasper" />
		<bean key="com.code.aon.purchase.Purchase" />
		<criteria provider="#{purchase}"/>
		<params>
			<param id="REPORT_RESOURCE_BUNDLE" value="com.code.aon.ui.purchase.i18n.report" />
			<param id="company" value="#{company.obtainCompany}" />
			<param id="logoImageFile" value="#{company.getAttachAsInputStream}" />
			<param id="recordData" value="#{company.getCompanyRecordData}" />
			<param id="phone" value="#{company.obtainPhone}" />
			<param id="fax" value="#{company.obtainFax}" />
			<param id="email" value="#{company.obtainEmail}" />
			<param id="web" value="#{company.obtainWeb}" />
			<param id="address" value="#{company.obtainAddress}" />
			<param id="printRecordData" value="#{company.isPrintRecordData}"/>
			<param id="printHeader" value="#{company.isPrintHeader}" />
			<param id="PriceStrategy" value="#{purchaseDetail.getPriceStrategy}" />
			<param id="TotalPrice" value="#{purchase.getTotalPrice}" />
			<param id="defaultPayMethod" value="#{purchase.getDefaultPayMethod}" />
		</params>
	</report>

	<report id="purchaseDetailledList" description="Listado Detallado de purchase">
		<template path="/com/code/aon/ui/purchase/report/purchaseDetailledList.jasper" />
		<bean key="com.code.aon.purchase.Purchase" />
		<criteria provider="#{purchase}"/>
		<params>
			<param id="REPORT_RESOURCE_BUNDLE" value="com.code.aon.ui.purchase.i18n.report" />
			<param id="company" value="#{company.obtainCompany}" />
			<param id="logoImageFile" value="#{company.getAttachAsInputStream}" />
			<param id="recordData" value="#{company.getCompanyRecordData}" />
			<param id="phone" value="#{company.obtainPhone}" />
			<param id="fax" value="#{company.obtainFax}" />
			<param id="email" value="#{company.obtainEmail}" />
			<param id="web" value="#{company.obtainWeb}" />
			<param id="address" value="#{company.obtainAddress}" />
			<param id="printRecordData" value="#{company.isPrintRecordData}"/>
			<param id="printHeader" value="#{company.isPrintHeader}" />
			<param id="PriceStrategy" value="#{purchaseDetail.getPriceStrategy}" />
			<param id="TotalPrice" value="#{purchase.getTotalPrice}" />
			<param id="defaultPayMethod" value="#{purchase.getDefaultPayMethod}" />
		</params>
		<nested-report report="purchaseListDetail"/>
		<nested-report report="purchaseListTaxBreakDown"/>
	</report>
	
	<report id="purchaseListDetail" description="purchase Details">
		<template path="/com/code/aon/ui/purchase/report/purchaseListDetail.jasper" />
	</report>
	<report id="purchaseListTaxBreakDown" description="taxBreakDown">
		<template path="/com/code/aon/ui/purchase/report/purchaseListTaxBreakDown.jasper"/>
	</report>
</report-config>