<?xml version="1.0" encoding="UTF-8" ?>
<config
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xmlns="http://www.esferalia.com/config" >

	<registry:config version="1.0" xmlns:registry="http://www.esferalia.com/registry">
		<registry:rmedia 
			showSendEmail="true" 
		/>
	</registry:config>
		
	<company:config version="1.1" xmlns:company="http://www.esferalia.com/company">
		<company:company 
			showRegistryBank="true" 
			showCompanyOtherData="true"
			showPanelTabSet="true" 
			showEInvoice="false"
			showDigitalCertificate="false"
		/>
		<company:enterprise 
			showFinanceData="true" 
			showAddInfo="true"
			showDirStaff="true"
		/>
	</company:config>
	
	<webmail:config version="1.1" xmlns:webmail="http://www.esferalia.com/webmail" >
		<webmail:webmail
			connect="true"
		/>
	</webmail:config>		
	
</config>
