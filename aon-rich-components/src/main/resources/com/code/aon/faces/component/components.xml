<?xml version="1.0"?>
<components>

	<!-- Basic input controls -->

	<component localName="div" namespace="http://www.code.es/aon-rich-components">
    	<attribute name="layout" value="block" force="true"/>			
	</component>

	<component localName="panelGrid" namespace="http://www.code.es/aon-rich-components">
    	<attribute name="styleClass" value="aon-panelGrid" />			
	</component>

	<component localName="graphicImage" namespace="http://www.code.es/aon-rich-components">
    	<attribute name="styleClass" value="aon-graphicImage" />			
	</component>

	<component localName="outputText" namespace="http://www.code.es/aon-rich-components">
    	<attribute name="styleClass" value="aon-outputText" />			
	</component>

	<component localName="outputLabel" namespace="http://www.code.es/aon-rich-components">
    	<attribute name="styleClass" value="aon-outputLabel" />			
	</component>

	<component localName="form" namespace="http://www.code.es/aon-rich-components">
    	<attribute name="styleClass" value="aon-form-input-text" />			
	</component>

	<component localName="messages" namespace="http://www.code.es/aon-rich-components">
    	<attribute name="showSummary" value="false" type="1" />			
    	<attribute name="showDetail" value="true" type="1" />
    	<attribute name="errorClass" value="aon-error-message" />
    	<attribute name="fatalClass" value="aon-fatal-error-message" />
    	<attribute name="infoClass" value="aon-info-message" />
	</component>

	<component localName="commandButton" namespace="http://www.code.es/aon-rich-components">
    	<attribute name="styleClass" value="aon-form-input-text" />			
	</component>

	<component localName="commandLink" namespace="http://www.code.es/aon-rich-components">
    	<attribute name="styleClass" value="aon-navigation-link" />			
	</component>

	<component localName="panelTabSet" namespace="http://www.code.es/aon-rich-components">
    	<attribute name="switchType" value="ajax" />			
	</component>

	<component localName="inputText" namespace="http://www.code.es/aon-rich-components">
    	<attribute name="styleClass" value="aon-form-input-text" />			
	</component>

	<component localName="inputTextarea" namespace="http://www.code.es/aon-rich-components">
    	<attribute name="styleClass" value="aon-form-input-text" />			
	</component>

	<component localName="inputRichText" namespace="http://www.code.es/aon-rich-components">
    	<attribute name="styleClass" value="aon-form-input-text" />			
	</component>

	<component localName="inputSecret" namespace="http://www.code.es/aon-rich-components">
    	<attribute name="styleClass" value="aon-inputSecret" />			
	</component>

	<component localName="selectOneMenu" namespace="http://www.code.es/aon-rich-components">
    	<attribute name="styleClass" value="aon-selectOneMenu" />			
	</component>

	<component localName="selectOneRadio" namespace="http://www.code.es/aon-rich-components">
    	<attribute name="styleClass" value="aon-selectOneRadio" />			
	</component>

	<component localName="selectBooleanCheckbox" namespace="http://www.code.es/aon-rich-components">
    	<attribute name="styleClass" value="aon-selectBooleanCheckbox" />			
	</component>

	<component localName="selectManyCheckbox" namespace="http://www.code.es/aon-rich-components">
    	<attribute name="styleClass" value="aon-selectManyCheckbox" />			
	</component>

	<component localName="dataTable" namespace="http://www.code.es/aon-rich-components">
    	<attribute name="styleClass" value="aon-table" />			
    	<attribute name="headerClass" value="aon-table-header" />
    	<attribute name="footerClass" value="aon-table-footer" />
    	<attribute name="rowClasses" value="aon-table-row-odd, aon-table-row-even" />
	</component>

	<component localName="editDataTable" namespace="http://www.code.es/aon-rich-components">
    	<attribute name="styleClass" value="aon-edit-table" />			
    	<attribute name="headerClass" value="aon-edit-table-header" />
    	<attribute name="footerClass" value="aon-edit-table-footer" />
    	<attribute name="rowClasses" value="aon-edit-table-row-odd, aon-edit-table-row-even" />
	</component>

	<component localName="dataPaginator" namespace="http://www.code.es/aon-rich-components">
    	<attribute name="maxPages" alias="paginatorMaxPages" />			
    	<attribute name="pagesVar" alias="pageCountVar" />
    	<attribute name="paginator" ignore="true" />
	</component>

</components>
