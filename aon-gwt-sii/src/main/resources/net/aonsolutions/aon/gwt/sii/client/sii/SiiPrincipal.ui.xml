<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<ui:UiBinder xmlns:ui='urn:ui:com.google.gwt.uibinder'
	xmlns:g='urn:import:com.google.gwt.user.client.ui' 
	xmlns:cell='urn:import:com.google.gwt.user.cellview.client'
	xmlns:aon='urn:import:com.esferalia.aon.gwt.common.client.widget' >

	<ui:with type="com.esferalia.aon.gwt.common.client.i18n.CommonMessages" field="msg"></ui:with>
	<ui:with type="com.esferalia.aon.gwt.common.client.css.AonResources" field="aonResources"></ui:with>
	<ui:style>
		
	</ui:style>
	
	<g:DockLayoutPanel ui:field="contentDockLayoutPanel">
			<g:north size="85">
				<g:SimpleLayoutPanel styleName="aon-margin-left10 aon-margin-right10" ui:field="northContent" />
			</g:north>
			<g:center>
				<g:SplitLayoutPanel ui:field="splitLayoutPanel">
					<g:center>
						<g:SimpleLayoutPanel styleName="aon-margin-left10 aon-margin-right10" ui:field="content" />
					</g:center>
					<g:south size="30">
						<aon:MinimizePanel ui:field="footPanel"
								styleName="{aonResources.css.aonSelector}">
							<g:TabLayoutPanel ui:field="tabLayout" barHeight="26"
									barUnit="PX" width="100%">

							    <g:tab>
									<g:customHeader >
										<g:HTMLPanel>
											<g:InlineLabel text="Errores" />
										</g:HTMLPanel>
									</g:customHeader>
									<g:ScrollPanel ui:field="errorPanel" styleName="{aonResources.css.aonTextCenter}" />
								</g:tab>
							<!-- TODO  	
								<g:tab>
									<g:customHeader >
										<g:HTMLPanel>
											<g:InlineLabel text="Historial" />
										</g:HTMLPanel>
									</g:customHeader>
									<g:ScrollPanel ui:field="historyPanel" styleName="{aonResources.css.aonTextCenter}" />
								</g:tab>
							-->
							</g:TabLayoutPanel>
						</aon:MinimizePanel>
					</g:south>
				</g:SplitLayoutPanel>
						
			</g:center>
	</g:DockLayoutPanel>
</ui:UiBinder>
