			public Repository</name> <url>http://archiva.fdvs.com.ar/repository/public1/</url> 
			<releases> <enabled>true</enabled> <updatePolicy>never</updatePolicy> </releases> 
			<snapshots> <enabled>false</enabled> <updatePolicy>never</updatePolicy> </snapshots> 
			</repository> -->
	</repositories>



	<build>
		<plugins>
			<!-- Instala en el repositorio local los JAR no disponibles en ningun 
				repositorio MAVEN --> 
			<plugin>
				<groupId>org.codehaus.mojo</groupId>
				<artifactId>exec-maven-plugin</artifactId>
				<version>1.2.1</version>
				<inherited>false</inherited>
				<executions>
					<execution>
						<id>install-ubmmatrix</id>
						<phase>validate</phase>
						<goals>
							<goal>exec</goal>
						</goals>
						<configuration>
							<executable>mvn</executable>
							<arguments>
								<argument>install:install-file</argument>
								<argument>-Dfile=non-maven-libs/XBRLProcessorSDK.jar</argument>
								<argument>-DgroupId=ubmmatrix.xbrl</argument>
								<argument>-DartifactId=XBRLProcessorSDK</argument>
								<argument>-Dversion=1.0.0</argument>
								<argument>-Dpackaging=jar</argument>
							</arguments>
						</configuration>
					</execution>

					<execution>
						<id>install-saxon</id>
						<phase>validate</phase>
						<goals>
							<goal>exec</goal>
						</goals>
						<configuration>
							<executable>mvn</executable>
							<arguments>
								<argument>install:install-file</argument>
								<argument>-Dfile=non-maven-libs/saxon.jar</argument>
								<argument>-DgroupId=xbrl.saxon</argument>
								<argument>-DartifactId=saxon</argument>
								<argument>-Dversion=8.2</argument>
								<argument>-Dpackaging=jar</argument>
							</arguments>
						</configuration>
					</execution>
					
					<execution>
						<id>install-Struts-Layout</id>
						<phase>validate</phase>
						<goals>
							<goal>exec</goal>
						</goals>
						<configuration>
							<executable>mvn</executable>
							<arguments>
								<argument>install:install-file</argument>
								<argument>-Dfile=non-maven-libs/Struts-Layout.jar</argument>
								<argument>-DgroupId=xbrl.Struts-Layout</argument>
								<argument>-DartifactId=Struts-Layout</argument>
								<argument>-Dversion=1.0.0</argument>
								<argument>-Dpackaging=jar</argument>
							</arguments>
						</configuration>
					</execution>
				</executions>
			</plugin>

			<!-- Especifcaciones de compilacion -->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-compiler-plugin</artifactId>
				<version>2.5.1</version>
				<configuration>
					<source>1.6</source>
					<target>1.6</target>
					<encoding>ISO-8859-1</encoding>
				</configuration>
			</plugin>

			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-surefire-plugin</artifactId>
				<version>2.10</version>
				<!-- Cuando los TESTs esten listos, eliminar esta configuration -->
				<configuration>
					<skipTests>true</skipTests>
				</configuration>
				<!-- <configuration> <workingDirectory>target</workingDirectory> </configuration> -->
			</plugin>

			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-jar-plugin</artifactId>
				<version>2.4</version>
				<configuration>
					<archive>
						<manifest>
							<addDefaultSpecificationEntries>true</addDefaultSpecificationEntries>
							<addDefaultImplementationEntries>true</addDefaultImplementationEntries>
						</manifest>
					</archive>
				</configuration>
			</plugin>

			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-source-plugin</artifactId>
				<version>2.2</version>
				<executions>
					<execution>
						<goals>
							<goal>jar-no-fork</goal>
						</goals>
					</execution>
				</executions>
			</plugin>

			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-javadoc-plugin</artifactId>
				<version>2.9</version>
				<configuration>
					<skip>true</skip>
				</configuration>
			</plugin>

			<!-- Para añadir la carpeta de los fuentes generados como source folder. -->
			<plugin>
				<groupId>org.codehaus.mojo</groupId>
				<artifactId>build-helper-maven-plugin</artifactId>
				<version>1.7</version>
				<executions>
					<execution>
						<id>add-source</id>
						<phase>process-sources</phase>
						<goals>
							<goal>add-source</goal>
						</goals>
						<configuration>
							<sources>
								<source>
									${project.build.directory}/generated-sources
								</source>
							</sources>
						</configuration>
					</execution>
				</executions>
			</plugin>


		</plugins>
	</build>
</project>