			Repository for Maven 2</name> <url>http://download.java.net/maven/2</url> 
			<releases> <enabled>true</enabled> <updatePolicy>never</updatePolicy> </releases> 
			<snapshots> <enabled>false</enabled> <updatePolicy>never</updatePolicy> </snapshots> 
			</repository> <repository> <id>jasperForge</id> <name>Jasper Forge Repository</name> 
			<layout>default</layout> <url>http://jasperreports.sourceforge.net/maven2</url> 
