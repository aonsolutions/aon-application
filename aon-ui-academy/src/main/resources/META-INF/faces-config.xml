		</managed-property>
		<managed-property>
			<property-name>beanName</property-name>
			<value>qualification</value>
		</managed-property>
		<managed-property>
			<property-name>defaultOrder</property-name>
			<value>Qualification_code</value>
		</managed-property>										
	</managed-bean>

	<!-- ************* OBSERVATION ***************** -->
	<managed-bean>
		<managed-bean-name>observation</managed-bean-name>
		<managed-bean-class>com.code.aon.ui.form.BasicController</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
		<managed-property>
			<property-name>queryOnStartUP</property-name>
			<value>true</value>
		</managed-property>
		<managed-property>
			<property-name>pojo</property-name>
			<value>com.code.aon.academy.Observation</value>
		</managed-property>
		<managed-property>
			<property-name>beanName</property-name>
			<value>observation</value>
		</managed-property>
		<managed-property>
			<property-name>defaultOrder</property-name>
			<value>Observation_description</value>
		</managed-property>										
	</managed-bean>
	
	<!-- ************* QUALITY SKILL ***************** -->
	<managed-bean>
		<managed-bean-name>qualitySkill</managed-bean-name>
		<managed-bean-class>com.code.aon.ui.form.BasicController</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
		<managed-property>
			<property-name>queryOnStartUP</property-name>
			<value>true</value>
		</managed-property>
		<managed-property>
			<property-name>pojo</property-name>
			<value>com.code.aon.academy.QualitySkill</value>
		</managed-property>
		<managed-property>
			<property-name>beanName</property-name>
			<value>qualitySkill</value>
		</managed-property>
		<managed-property>
			<property-name>defaultOrder</property-name>
			<value>QualitySkill_code</value>
		</managed-property>										
	</managed-bean>	
	
	<!-- ======================= NAVIGATION ========================== -->
	<navigation-rule>
		<navigation-case>
			<from-outcome>academicYear_form</from-outcome>
			<to-view-id>/com/code/aon/ui/academy/facelet/academicYear/grid.xhtml</to-view-id>
		</navigation-case>
		<navigation-case>
			<from-outcome>courseSubject_form</from-outcome>
			<to-view-id>/com/code/aon/ui/academy/facelet/courseSubject/grid.xhtml</to-view-id>
		</navigation-case>
		<navigation-case>
			<from-outcome>courseLevel_form</from-outcome>
			<to-view-id>/com/code/aon/ui/academy/facelet/courseLevel/grid.xhtml</to-view-id>
		</navigation-case>
		<navigation-case>
			<from-outcome>academicSkill_form</from-outcome>
			<to-view-id>/com/code/aon/ui/academy/facelet/academicSkill/grid.xhtml</to-view-id>
		</navigation-case>
		<navigation-case>
			<from-outcome>qualification_form</from-outcome>
			<to-view-id>/com/code/aon/ui/academy/facelet/qualification/grid.xhtml</to-view-id>
		</navigation-case>
		<navigation-case>
			<from-outcome>observation_form</from-outcome>
			<to-view-id>/com/code/aon/ui/academy/facelet/observation/grid.xhtml</to-view-id>
		</navigation-case>
		<navigation-case>
			<from-outcome>qualitySkill_form</from-outcome>
			<to-view-id>/com/code/aon/ui/academy/facelet/qualitySkill/grid.xhtml</to-view-id>
		</navigation-case>
	</navigation-rule>

</faces-config>