				<textFieldExpression><![CDATA[$R{course_academic_year}]]></textFieldExpression>
			</textField>
			<textField pattern="dd/MM/yyyy" isBlankWhenNull="true">
				<reportElement key="textField-14" x="98" y="10" width="411" height="12"/>
