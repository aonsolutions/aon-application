.inicio a{
	font-family: ${font_fuente_texto_pagina} ;
	font-size: ${size_tamano_texto_pagina};
	color:${color_color_texto_pagina};
	text-decoration:none;
	}
body {
	margin: 0 auto;
	width: 750px;
	margin-top:100px;
	background-color: ${bgcolor_color_fondo_pagina}
}
#logo{
	margin-bottom:30px;
}
#
}
.header{
	padding:50px; 
	margin-bottom:20px;

}
#toplinks{
	position:absolute; 
	right:10px; 
	top:10px;
}
#menu{
	float:right; 
	height:24px;
	width:750px; 
	background-image: url(images/bg_menu.gif);
	background-repeat:repeat-x;
	color:${color_color_texto_menu};
	font-size:12px;
	text-transform:uppercase;
	font-weight:bold;
}
#menu a{
	text-decoration:none;
	float:right;
	color:${color_color_texto_menu};
	font-size:12px;
	text-transform:uppercase;
	font-weight:bold;
	padding-right:10px;
	padding-left:10px;
	padding-top:5px;
	height:24px;
}
#menu a:hover{
	text-decoration:none;
	background-image: url(images/bg_submenu.gif) ;
	color:${color_color_texto_menu_hover};
	font-size:12px;
	text-transform:uppercase;
	font-weight:bold;
}
#contenttext{
	float:right; 
	width:650px;
	background-color:${bgcolor_color_fondo_contenido};
}
#footer{
	float:left; 
	width:750px; 
	background-color: ${bgcolor_color_fondo_pie};
	padding-top:10px;
	padding-bottom:20px;
	color:${color_color_texto_pie};
	font-size:9px;
	text-align:center;
}
.graypanel{
	border:solid 1px #666666; 
	background-color:#F7F7F7; 
	margin-top:10px;
}
.bodytext {
	font: ${size_tamano_texto_pagina} ${font_fuente_texto_pagina};
	color: ${color_color_texto_pagina};
	background-color:${bgcolor_color_fondo_contenido};
	padding:100px 25px 80px;
	
}

h1 {
	color: ${color_color_texto_titulo};
	}

.box{
	text-align:center; 
	padding-top:10px;
}
.texto{
	text-align:right;
}
.infoHelp{
	width:335px; 
	padding:5px;
	background-color:#dddddd;
	margin-left:325px;
	text-align:justify;
	font-size:9px;
}
.gallery-navigation{
	text-align:center;
	color:&{color_color_texto_contenido};
}
.gallery-navigation a{
	color:&{color_color_texto_contenido};
	text-decoration:none;
	text-align:center;
}
.album-block{ 
	text-align:center;
}
.formulario{
	float: left;
	line-height:15px;
}
.copiesferalia {
	font-family: ${font_fuente_texto_pie} ;
	font-size:9px;
	color:${color_color_texto_pie};
	text-decoration:none;
	}
.copiesferalia a{
	font-family: ${font_fuente_texto_pie} ;
	font-size:9px;
	color:${color_color_texto_pie};
	text-decoration:none;
	}
.copiesferalia a:hover{
	font-family: ${font_fuente_texto_pie} ;
	font-size: 9px;
	color:${color_color_texto_pie};
	text-decoration:underline;
	}
.album {
	height:400px;
	text-align:center;
}
.album a{
	text-decoration:none;
	color:&{color_color_texto_contenido};
}
.objeto {
	float:left;
	padding:10px;
}
.objeto a{
	text-decoration:none;
	color:&{color_color_texto_contenido};
}
.bold {
	float:left;
	padding:10px;
}
.bold a{
	text-decoration:none;
	color:&{color_color_texto_contenido};
}
