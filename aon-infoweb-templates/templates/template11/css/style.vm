body {
	margin: 0 auto;
	background-image: url(images/bgrepeat.jpg) repeat-y center;
	background-color: ${bgcolor_color_fondo_pagina};
	width: 750px;
	margin-top:100px;
	
}
.canvas{
	width:750px;
	margin:0 auto;
	background: ${bgcolor_color_fondo_contenido};
}
.navbg {
	background: url(images/navbg_02.gif) repeat-x;
	width:750px;
	height:54px;
}
#menu ul {
	margin:0px;
	padding-top: 0px;
	list-style-type: none;
	text-align: center;
	font-family: ${font_fuente_texto_pagina};
	font-size: ${size_tamano_texto_menu};
	font-weight:bold;
	padding-top:12px;
	/*padding-bottom:22px;*/
	display:block;
	width:100%;
        float:right;
}
#menu ul li { 
	display: inline; 
}
#menu ul li a {
	text-decoration: none;
	font-size: ${size_tamano_texto_menu};
	font-weight:bold;
	padding-right: 10px;
	padding-top:19px;
	padding-bottom:21px;
	padding-left: 10px;
	color: ${color_color_texto_menu};
	width: 100%;
	/*border-right: 1px  ${color_color_borde_pagina} solid;*/
}
#menu ul li a:hover {
	color: ${color_color_texto_menu_hover};
	/*background: url(images/navhover_02.gif) repeat-x top;*/
	font-size: ${size_tamano_texto_menu};
	font-weight:bold;
	text-decoration:none;
	margin-top:8px;
	width: 100%;
	height:28px;
}
body,td,th {
	font-family: ${font_fuente_texto_pagina};
	font-size: ${size_tamano_fuente_contenido};
	color: ${color_color_texto_contenido};
}
.header{
	height:110px;
	width:100%;
	
}
.headerontop{
	background: url(images/bannerontop.jpg) no-repeat center;
	height:90px;
	width:720px;
	pdding-bottom:20px;
	padding-top:35px;
	padding-left:30px;
	text-align:center;
}
.header_img {
	border:medium none;
	float:left;
}
#content{
	padding-top:10px;
	padding-bottom:10px;
	padding:20px;
	padding-left:20px;
}
.content{
	padding-top:10px;
	padding-bottom:10px;
	padding:20px;
	padding-left:20px;
}
#content p{
	padding-top:10px;
	padding-bottom:10px;
	padding:20px;
	padding-left:20px;
}
#content h1{
	padding-top:10px;
	padding-bottom:10px;
	padding:20px;
	padding-left:20px;}

.rightcolumn{
	width:590px;
	float:right;
	text-align:left;
}
h2{
	background:url(images/leftcolumnheader_21.gif) center no-repeat;
	font-weight:bold;
