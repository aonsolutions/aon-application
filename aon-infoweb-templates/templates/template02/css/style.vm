body {
	background-color:${bgcolor_color_fondo_pagina};
	font-family: ${font_fuente_texto_pagina} ;
	font-size: ${size_tamano_texto_pagina};
	font-style: normal;
	color:${color_color_texto_pagina};
	text-indent: 5px;
	height:450px;
	margin:0 auto;
	text-align:left;
	width:750px;
	text-decoration: none;
	margin-top:100px;
	}
dd{
	margin-left:-4px;
	}
.fButtons{
	margin-left:-4px;
	}
#header{
	background-repeat: no-repeat;
	text-decoration: none;
	color:${color_color_texto_pagina};
	background-color:${bgcolor_color_fondo_pagina};
	}
#header img {
	float:right;
	text-decoration: none;
	padding:20px;
	padding-bottom:50px;
	}
#header .inicio{
	padding-left: 700px;
	color:${color_color_texto_pagina};
	background-color:${bgcolor_color_fondo_pagina};
	text-decoration: none;
 
	}
#header .inicio{
	text-decoration: none;
	}
#header .inicio a {
	text-decoration: none;
	padding-right:5px;
	font-variant: small-caps;	
	}
.menu{
	clear:both;
	overflow:auto;
	width: 750px;
	background-repeat: repeat-x;
	background-position: left top; 
	background-color:${bgcolor_color_fondo_menu};
	border-bottom-width: 1px;
	border-bottom-style: solid;
	border-bottom-color: ${color_color_borde_menu};
	text-decoration:none;
	padding-bottom:5px;
	}
.menu ul{

	}
.menu li{
	display:inline;
	border-right:${color_color_borde_menu} 1px solid;
	padding:2px;
	
	

float:left;

	}
.menu li a{
	text-decoration: none;
	color:#f70e76;
	text-transform:uppercase;
	font-size:${size_tamano_texto_menu};
	font-weight: bold;
	margin-left:10px;
	margin-right:10px;
	}
.menu ul a:link {
	font-family: ${font_fuente_texto_menu} ;
	font-size: ${size_tamano_texto_menu};
	color: ${color_color_texto_menu};
	}
.menu ul a:visited {
	font-family:${font_fuente_texto_menu};
	font-size: ${size_tamano_texto_menu};
	color: ${color_color_texto_menu};
	}
.menu ul a:hover {
	font-family: ${font_fuente_texto_menu} ;
	font-size: ${size_tamano_texto_menu};
	color:${color_color_texto_hover};
	}
#ft{
	overflow:auto;
	height:60px; 
	width:750px;
	line-height:12px;
	color: ${color_color_texto_pie};
	padding-top: 4px; 
	background-color:${bgcolor_color_fondo_pie};
	background-repeat: repeat-x;
	background-position: left top;
	border-top-width: 1px;
	border-top-style: solid;
	border-top-color: ${color_color_borde_pie};
	text-align: center;
	font-size: 9px;
	}
a, img, a:hover, a:visited{
	text-decoration:none;
	}
.content-text{
	color:${color_color_texto_pagina}; 
	font-family:${font_fuente_texto_pagina}; 
	font-size:${size_tamano_texto_pagina};
	background-color:${bgcolor_color_fondo_contenido};
	padding-bottom:15px;
	padding:6px 15px 0px;
	padding:20px;
	
	}
.box{
	text-align:center; 
	padding-top:10px;
	float:left;
	}
#body-content{
	text-align:left;  
	background-color:${bgcolor_color_fondo_pagina};
	}
.texto{
	text-align:right;
	}
.infoHelp{
	font-size:9px; 
	padding:15px;
	margin-top:65px;
	background-color:#dddddd;
	margin-left:255px;
	text-align:justify;
	}
.element.style {
	background-color:#DDDDDD;
	margin-left:150px;
	padding-bottom:10px;
	padding-left:10px;
	padding-right:10px;
	padding-top:10px;
	}
.gallery-navigation{
	text-align:center;}
.bold{
	text-align:right;
	margin-left:350px;
	}
.album-block{ 
	text-align:center;}
.formulario{
	margin-left:45px;
	float: left;
	margin-top:27px;
	}
.Formpedidos{
	width: 150px;
	float: left;
	}
#formpedidos{
	margin:150px;
	}
.copiesferalia {
	font-family: ${font_fuente_texto_pie} ;
	font-size:9px;
	color:${color_color_texto_pie};
	text-decoration:none;
	}
.copiesferalia a{
	font-family: ${font_fuente_texto_pie} ;
	font-size:9px;
	color:${color_color_texto_pie};
	text-decoration:none;
	}
.copiesferalia a:hover{
	font-family: ${font_fuente_texto_pie} ;
	font-size: 9px;
	color:${color_color_texto_pie};
	text-decoration:underline;
	}
h1{
	margin-top:20px;
	font-family: ${font_fuente_texto_pagina} ;
	font-size: 18px;
	color:${color_color_texto_titulo};
	padding-left:20px ;
	font-weight: bold;
	text-align: center;
	}
	td img{
	padding:20px;}