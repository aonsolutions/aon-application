  <profiles>
		<profile>
			<id>rpm-release</id>
			<activation>
				<property>
					<name>rpm.release</name>
					<value>true</value>
				</property>
			</activation>
			<dependencies>
				<dependency>
					<groupId>com.code.aon</groupId>
					<artifactId>aon.pool</artifactId>
					<version>${project.version}</version>
				</dependency>
				<dependency>
					<groupId>com.mchange</groupId>
					<artifactId>c3p0</artifactId>
					<version>0.9.2</version>
				</dependency>
				<dependency>
					<groupId>com.mchange</groupId>
					<artifactId>mchange-commons-java</artifactId>
					<version>0.2.3.3</version>
				</dependency>
							<dependency>
					<groupId>commons-lang</groupId>
					<artifactId>commons-lang</artifactId>
					<version>2.5</version>
				</dependency>

				<dependency>
					<groupId>commons-io</groupId>
					<artifactId>commons-io</artifactId>
					<version>1.4</version>
				</dependency>

				<dependency>
					<groupId>org.jooq</groupId>
					<artifactId>jooq</artifactId>
					<version>3.5.2</version>
				</dependency>

				<dependency>
					<groupId>commons-net</groupId>
					<artifactId>commons-net</artifactId>
					<version>3.3</version>
				</dependency>
			</dependencies>
			<build>
				<plugins>
					<!-- Para construir el RPM -->
					<plugin>

						<groupId>org.codehaus.mojo</groupId>
						<artifactId>rpm-maven-plugin</artifactId>
						<version>2.0.1</version>
						<extensions>true</extensions>

						<executions>
							<execution>
								<id>rpm-build</id>
								<goals>
									<goal>attached-rpm</goal>
								</goals>
							</execution>
						</executions>

						<configuration>
							<group>Applications/Aon</group>
							<release>${buildNumber}</release>
							<copyright>2014, esferalia Networks S.A</copyright>
							<requires>
								<require>slf4j</require>
								<require>aon-dbutils</require>
								<require>mysql-connector-java</require>
							</requires>

							<mappings>

								<mapping>
									<filemode>755</filemode>
									<username>root</username>
									<groupname>root</groupname>

									<directory>/usr/share/java/aon-ui-warehouse</directory>
									<dependency>
										<includes>
											<!-- ext -->
											<include>com.mchange:c3p0:0.9.2</include>
											<include>javax.mail:mail:1.4</include>
											<include>org.jooq:jooq:3.5.2</include>
											<include>com.mchange:c3p0:0.9.2</include>
											<include>com.mchange:mchange-commons-java:0.2.3.3</include>
											<include>commons-io:commons-io:1.4</include>
											<include>commons-cli:commons-cli:1.2</include>
											<include>commons-lang:commons-lang:2.5</include>
											<include>commons-net:commons-net:3.3</include>
											
											<!-- aon -->
											<include>com.code.aon:aon.pool:${project.version}</include>
											<include>com.code.aon:aon.common:${project.version}</include>
											<include>com.esferalia.aon:aon.entity:${project.version}</include>
											<include>com.esferalia.aon:aon.master.jooq:${project.version}</include>
											<include>com.esferalia.aon:aon.entity.common:${project.version}</include>
											<include>com.esferalia.aon:aon.occam:${project.version}</include>
											<include>com.esferalia.aon:aon.watson:${project.version}</include>
										</includes>
									</dependency>
									<sources>

										<source>
											<location>target</location>
											<includes>
												<include>${project.artifactId}-${project.version}.jar</include>
											</includes>
										</source>

									</sources>
								</mapping>

								<mapping>
									<filemode>755</filemode>
									<username>root</username>
									<groupname>root</groupname>
									<directory>/usr/share/aon-ui-warehouse/bin</directory>
									<sources>
										<source>
											<location>src/main/scripts</location>
											<includes>
												<include>aon-warehouse.sh</include>
											</includes>
										</source>
									</sources>
								</mapping>
							</mappings>
						</configuration>

					</plugin>
				</plugins>
			</build>
