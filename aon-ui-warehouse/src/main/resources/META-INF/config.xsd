<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
	<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
		xmlns="http://www.esferalia.com/warehouse" targetNamespace="http://www.esferalia.com/warehouse"
		elementFormDefault="qualified">
	<xs:element name="config">	
		<xs:complexType>
		    <xs:sequence>
		      <xs:element ref="delivery" />
		      <xs:element ref="income" />
		    </xs:sequence>		
			<xs:attribute name="version" type="xs:string" use="required" fixed="1.0"/>		    
		</xs:complexType>
	</xs:element>
	<xs:element name="delivery">
		<xs:complexType>
			<xs:attribute name="showTasData" type="xs:boolean" use="required"/>
		</xs:complexType>
	</xs:element>
	<xs:element name="income">
		<xs:complexType>
			<xs:attribute name="showTasData" type="xs:boolean" use="required"/>
		</xs:complexType>
	</xs:element>
</xs:schema>