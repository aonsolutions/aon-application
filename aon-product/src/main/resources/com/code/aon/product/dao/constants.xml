<?xml version="1.0" encoding="ISO-8859-1"?>
<dao>
	<bean class="com.code.aon.product.Item" sqlName="item">
		<alias names="id,product_id,detail,price,status,expenses_percent,expenses_fixed,profit_percent,purchase_price,product_name,product_code,product_brand,product_category_id,product_category_name,product_inventoriable,product_composition" />
		<sql names="id,product.id,detail,price,status,expenses_percent,expenses_fixed,profit_percent,purchase_price,product.name,product.code,product.brand.name,product.category.id,product.category.name,product.inventoriable,product.composition" />
		<hibernate names="id,product.id,detail,price,status,expensesPercent,expensesFixed,profitPercent,purchasePrice,product.name,product.code,product.brand.name,product.category.id,product.category.name,product.inventoriable,product.composition" />
	</bean>

	<bean class="com.code.aon.product.Product" sqlName="product">
		<alias names="brand_id,product_category_id,code,composition,id,inventoriable,name,retention_id,status,type,vat_id" />
		<hibernate names="brand.id,category.id,code,composition,id,inventoriable,name,retention.id,status,type,vat.id" />
	</bean>
	
	<bean class="com.code.aon.product.ProductCategory" sqlName="pcategory">
		<alias names="category_group_id,id,itemPattern,name" />
		<hibernate names="group.id,id,itemPattern,name" />
	</bean>
</dao>