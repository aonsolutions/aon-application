<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<ui:UiBinder xmlns:ui='urn:ui:com.google.gwt.uibinder'
	xmlns:g='urn:import:com.google.gwt.user.client.ui' 
	xmlns:aon='urn:import:com.esferalia.aon.gwt.common.client.widget'
	xmlns:cell='urn:import:com.google.gwt.user.cellview.client'
	xmlns:dump='urn:import:com.esferalia.aon.gwt.dump.client'
	xmlns:datepicker='urn:import:com.google.gwt.user.datepicker.client' 
	xmlns:s="urn:import:com.esferalia.aon.gwt.dump.shared" 
	xmlns:c="urn:import:com.esferalia.aon.gwt.common.client" 
	xmlns:a="urn:import:bsh.org.objectweb.asm" 
	xmlns:collect="urn:import:com.google.common.collect">

	<ui:style>
	
	
	.options-scroll-panel>div {
		height: 99%;
	}
	
	.simple-panel {
		background: #FFFFFF;
	}
	
	.simple-marginBottom {
		margin-bottom: 5px;
	}
	
	.simple-marginTop{
		margin-top: 5px;
	}
	
	.simple-labelStyle{
		padding: 2px;
		border: 1px solid #ccc;
		border-top: 1px solid #999;
		font-family: Arial Unicode MS, Arial, sans-serif;
		font-size: 1em;
		margin: 0px;
	}
	
	.simple-labelMargin{
		margin-left: 12px;
	}
	
	.simple-labelErrMargin{
		color:transparent;
		margin-left: 5px;
		padding-bottom: 10px;
	}
	
	.simple-labelSufixMargin{
		margin-top: 6px;
	}
	
	</ui:style>

	<g:SplitLayoutPanel ui:field="splitLayoutPanel">
		<g:center>
			<g:HTMLPanel>
				<g:ScrollPanel styleName="aon-scroll-area {style.options-scroll-panel}">

					<g:HTMLPanel styleName="aon-panelGrid-search">
						<div class="aon-panelGrid-search-info ">
							<span class="aon-panelGrid-search-info-internal">Seleccione la Empresa: </span>
						</div>

						<div class="aon-scroll-area">
							<table class="aon-panelGrid" cellspacing="0" cellpadding="0">
								<tr>
									<td colspan="2">
								 		<g:Label styleName="{style.simple-labelErrMargin}" ui:field="errorString" >OK</g:Label>
									</td>
								</tr>
								<tr>
									<td class="aon-panelGrid-odd">
										<g:Label styleName="aon-outputLabel">Nombre Empresa a Descargar</g:Label>
									</td>
									<td class="aon-panelGrid-even">
										<g:SuggestBox  styleName="{style.simple-labelStyle} {style.simple-labelMargin}" ui:field="suggestBox" width="100"/>
									</td>
								</tr>
								<tr>
									<td class="aon-panelGrid-odd">
										<g:Label styleName="aon-outputLabel">Tipo de Copia</g:Label>
									</td>
									<td class="aon-panelGrid-even">
										<g:ListBox styleName="{style.simple-labelStyle} {style.simple-labelMargin}" ui:field="downloadListBox" name="downloadType"/>
									</td>
								</tr>
								<tr>
									<td class="aon-panelGrid-odd">
										<g:Label styleName="aon-outputLabel">Nuevo Nombre Empresa</g:Label>
									</td>
									<td class="aon-panelGrid-even">
										<g:TextBox ui:field="nombreEmpresa" styleName="{style.simple-labelStyle} {style.simple-labelMargin}"/>
									</td>
									<td class="aon-panelGrid-odd">
										<g:Label ui:field="sufijoEmpresa" styleName="{style.simple-labelSufixMargin}"/>
									</td>
								</tr>
								<tr>
									<td colspan="2">
										<g:DisclosurePanel styleName="{style.simple-marginBottom} {style.simple-marginTop}" animationEnabled="true">
											<g:header>Avanzado</g:header>
											<g:HTMLPanel>
												<table cellspacing="0" cellpadding="0">
													<tr>
														<td class="aon-panelGrid-odd">
															<g:Label styleName="aon-outputLabel">Añadir Comentarios</g:Label>
														</td>
														<td class="aon-panelGrid-even">
															<g:CheckBox ui:field="checkComment" styleName="aon-selectBooleanCheckbox"></g:CheckBox>
														</td>
													</tr>
													<tr>
														<td class="aon-panelGrid-odd">
															<g:Label styleName="aon-outputLabel">Bloquear Tablas Descarga (Locks)</g:Label>
														</td>
														<td class="aon-panelGrid-even">
															<g:CheckBox ui:field="checkLocks" styleName="aon-selectBooleanCheckbox"></g:CheckBox>
														</td>
													</tr>
													<tr>
														<td class="aon-panelGrid-odd">
															<g:Label styleName="aon-outputLabel">Deshabilitar ForeignKeys</g:Label>
														</td>
														<td class="aon-panelGrid-even">
															<g:CheckBox ui:field="checkFK" styleName="aon-selectBooleanCheckbox"></g:CheckBox>
														</td>
													</tr>
													<tr>
														<td class="aon-panelGrid-odd">
															<g:Label styleName="aon-outputLabel">Eliminar Usuarios</g:Label>
														</td>
														<td class="aon-panelGrid-even">
															<g:CheckBox ui:field="checkErase" styleName="aon-selectBooleanCheckbox"></g:CheckBox>
														</td>
													</tr>
													<tr>
														<td class="aon-panelGrid-odd">
														</td>
														<td class="aon-panelGrid-even">
															<g:TextBox ui:field="nombreUsuario" styleName="{style.simple-labelStyle}"/>
														</td>
													</tr>
													<tr>
														<td class="aon-panelGrid-odd">
														</td>
														<td class="aon-panelGrid-even">
															<g:TextBox ui:field="nuevaContrasena" styleName="{style.simple-labelStyle}" />
														</td>
													</tr>
												</table>
											</g:HTMLPanel>
										</g:DisclosurePanel>
									</td>
								</tr>								
								<tr>
									<td>
										<g:Button visible="true" ui:field="sendButton" styleName="aon-search-lookup-button">Descargar</g:Button>
									</td>
									<td>
										<g:HorizontalPanel ui:field="barPanel"></g:HorizontalPanel>
									</td>
								</tr>
							</table>
						</div>
					</g:HTMLPanel>
				</g:ScrollPanel>
			</g:HTMLPanel>
		</g:center>

		<g:south size="370">
			<aon:MinimizePanel height="300" ui:field="footPanel">
				<g:TabLayoutPanel addStyleNames="aon-pointer-events-auto" barHeight="26" barUnit="PX"
					ui:field="footTabPanel" visible="true" height="300" >
					
					<!-- TABS DINAMICOS -->
					
				</g:TabLayoutPanel>
			</aon:MinimizePanel>
		</g:south>
	</g:SplitLayoutPanel>
</ui:UiBinder>
