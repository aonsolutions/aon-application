<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
	<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
		xmlns="http://www.esferalia.com/marketing" targetNamespace="http://www.esferalia.com/marketing"
		elementFormDefault="qualified">
	<xs:element name="config">	
		<xs:complexType>
		    <xs:sequence>
		      <xs:element ref="campaign" />
		      <xs:element ref="communicationCenter" />
		    </xs:sequence>		
			<xs:attribute name="version" type="xs:string" use="required" fixed="1.1"/>		    
		</xs:complexType>
	</xs:element>
	<xs:element name="campaign">
		<xs:complexType>
			<xs:attribute name="showSurvey" type="xs:boolean" use="required"/>
			<xs:attribute name="showPhoneActionMediaType" type="xs:boolean" use="required"/>
		</xs:complexType>
	</xs:element>
	<xs:element name="communicationCenter">
		<xs:complexType>
			<xs:attribute name="showTarget" type="xs:boolean" use="required"/>
		</xs:complexType>
	</xs:element>
</xs:schema>