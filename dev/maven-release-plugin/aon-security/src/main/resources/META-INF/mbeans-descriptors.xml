<mbeans-descriptors>

  <mbean name="AonSecurity"
         description="Custom AonSecurity"
         className="org.apache.catalina.mbeans.ClassNameMBean"
         domain="Catalina"
         type="com.code.aon.jaas.vendor.tomcat.StandardSecurity">

    <operation name="init" description="Init" impact="ACTION" returnType="void" />
    <operation name="start" description="Start" impact="ACTION" returnType="void" />
    <operation name="stop" description="Stop" impact="ACTION" returnType="void" />

	<operation name="applications" description="" impact="ACTION" returnType="java.util.List" >
		<parameter name="host" description="" type="java.lang.String"/>
		<parameter name="domain" description="" type="java.lang.String"/>
    </operation>

  </mbean>

  <mbean name="AonMainDeployer"
         description="Custom AonMainDeployer"
         className="org.apache.catalina.mbeans.ClassNameMBean"
         domain="Catalina"
         type="com.code.aon.jaas.vendor.tomcat.TomcatMainDeployer">

	<attribute name="ConfigResource">aon.workspace/deployed.xml</attribute>

    <operation name="init" description="Init" impact="ACTION" returnType="void" />
    <operation name="start" description="Start" impact="ACTION" returnType="void" />
    <operation name="stop" description="Stop" impact="ACTION" returnType="void" />

  </mbean>

  <mbean name="AonSessionManager"
         description="Custom AonSessionManager"
         className="org.apache.catalina.mbeans.ClassNameMBean"
         domain="Catalina"
         type="com.code.aon.jaas.vendor.tomcat.TomcatSessionManager">

    <operation name="init" description="Init" impact="ACTION" returnType="void" />
    <operation name="start" description="Start" impact="ACTION" returnType="void" />
    <operation name="stop" description="Stop" impact="ACTION" returnType="void" />

  </mbean>

</mbeans-descriptors>