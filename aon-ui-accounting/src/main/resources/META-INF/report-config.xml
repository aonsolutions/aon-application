<?xml version="1.0" encoding="ISO-8859-1"?>

<!DOCTYPE report-config 
	PUBLIC "-//CODE-AON//DTD Report Config//EN" 
	"http://co-de.com/aon/report-config.dtd">

<report-config>

	<!--  PORTADA DEPOSITO CUENTAS  -->
	<report id="cover" description="PORTADA DEPOSITO CUENTAS">
		<template path="/com/code/aon/ui/accounting/report/cover.jasper"/>
		<collection provider="#{accountingBook}"/>
		<params>
			<param id="REPORT_RESOURCE_BUNDLE" value="com.code.aon.common.i18n.messages" />
			<param id="company" value="#{company.obtainCompany}" />
			<param id="period" value="#{accountingBook.getPeriod}" />
			<param id="title" value="#{accountingBook.getCoverTitle}" />
			<param id="subTitle" value="#{accountingBook.getCoverSubTitle}" />
			<param id="constitutionDate" value="#{accountingBook.getConstitutionDate}" />
		</params>
	</report>

	<!--  **********************************************************
						      ACCOUNTING
		  ********************************************************** -->
	<!--  BALANCE DE PERDIDAS Y GANACIAS -->
	<report id="profitAndLoss" description="ProfitAndLoss">
		<template path="/com/code/aon/ui/accounting/report/profitAndLoss.jasper"/>
		<collection provider="#{profitAndLossReport}"/>
		<params>
			<param id="REPORT_RESOURCE_BUNDLE" value="com.code.aon.common.i18n.messages" />
			<param id="company" value="#{company.obtainCompany}" />
			<param id="params" value="#{profitAndLossReport.getParameters}" />
			<param id="reportTitle" value="#{profitAndLossReport.getReportTitle}" />
		</params>
	</report>
	
		<!--  BALANCE DE PERDIDAS Y GANACIAS GRÁFICOS GASTOS -->
	<report id="profitAndLossTotalExpenses" description="ProfitAndLoss graphics">
		<template path="/com/code/aon/ui/accounting/report/profitAndLossGraph.jasper"/>
		<collection provider="#{profitAndLossReport.sortedTotalExpenses}"/>
		<params>
			<param id="REPORT_RESOURCE_BUNDLE" value="com.code.aon.common.i18n.messages" />
			<param id="company" value="#{company.obtainCompany}" />
			<param id="params" value="#{profitAndLossReport.getParameters}" />	
			<param id="title" value="#{profitAndLossReport.getGraphName}" />

		</params>
	</report>
	
		<!--  BALANCE DE PERDIDAS Y GANACIAS GRÁFICOS INGRESOS -->
	<report id="profitAndLossGrossMargin" description="ProfitAndLoss graphics">
		<template path="/com/code/aon/ui/accounting/report/profitAndLossGraphGrossMargin.jasper"/>
		<collection provider="#{profitAndLossReport.salesList}" forceRefresh="true"/>
		<params>
			<param id="REPORT_RESOURCE_BUNDLE" value="com.code.aon.common.i18n.messages" />
			<param id="company" value="#{company.obtainCompany}" />
			<param id="params" value="#{profitAndLossReport.getParameters}" />
			<param id="title" value="#{profitAndLossReport.getGraphName}" />
			<param id="purchasesList" value="#{profitAndLossReport.getPurchaseList}" />
			<param id="grossMarginList" value="#{profitAndLossReport.getGrossMarginList}" />
	 	</params>
	
		<nested-report report="purchases"/>
		<nested-report report="grossMargin"/>		
	</report>

	<report id="purchases" description="Purchases List">
		<template path="/com/code/aon/ui/accounting/report/purchasesGraph.jasper"/>
	</report>

	<report id="grossMargin" description="Gross Margin List">
		<template path="/com/code/aon/ui/accounting/report/grossMarginGraph.jasper"/>
	</report>
	
	<!--  BALANCE DE PERDIDAS Y GANACIAS GRÁFICOS GASTOS NETOS -->
	<report id="profitAndLossNetExpenses" description="ProfitAndLoss graphics">
		<template path="/com/code/aon/ui/accounting/report/profitAndLossGraph.jasper"/>
		<collection provider="#{profitAndLossReport.netExpenses}"/>
		<params>
			<param id="REPORT_RESOURCE_BUNDLE" value="com.code.aon.common.i18n.messages" />
			<param id="company" value="#{company.obtainCompany}" />
			<param id="params" value="#{profitAndLossReport.getParameters}" />
			<param id="title" value="#{profitAndLossReport.getGraphName}" />
	 	</params>
	</report>
	

	<!--  BALANCE MESUAL DE PERDIDAS Y GANACIAS -->
	<report id="profitAndLossMonthly" description="ProfitAndLossMonthly">
		<template path="/com/code/aon/ui/accounting/report/profitAndLossMonthly.jasper"/>
		<collection provider="#{profitAndLossMonthly}"/>
		<params>
			<param id="REPORT_RESOURCE_BUNDLE" value="com.code.aon.common.i18n.messages" />
			<param id="company" value="#{company.obtainCompany}" />
			<param id="params" value="#{profitAndLossReport.getParameters}" />
		</params>
	</report>
	
<!--  	  BALANCE MESUAL DE PERDIDAS Y GANACIAS GRAFICO -->
	<report id="profitAndLossMonthlyGraph" description="ProfitAndLossMonthlyGraph">
		<template path="/com/code/aon/ui/accounting/report/profitAndLossMonthlyGraph.jasper"/>
		<collection provider="#{profitAndLossMonthly}"/>
		<params>
			<param id="REPORT_RESOURCE_BUNDLE" value="com.code.aon.common.i18n.messages" />
			<param id="company" value="#{company.obtainCompany}" />
			<param id="params" value="#{profitAndLossReport.getParameters}" />
		</params>
	</report>

	
	<!--  EXTRACTO DE CUENTA -->
	<report id="statement" description="Account Statement">
		<template path="/com/code/aon/ui/accounting/report/statement.jasper"/>
		<collection provider="#{statement.detail}"/>
		<params>
			<param id="REPORT_RESOURCE_BUNDLE" value="com.code.aon.common.i18n.messages" />
			<param id="company" value="#{company.obtainCompany}" />
			<param id="account" value="#{statement.getAccount}" />
			<param id="previousBalance" value="#{statement.getPreviousBalance}" />
			<param id="periodBalance" value="#{statement.getPeriodBalance}" />
			<param id="params" value="#{statement.getParams}" />
		</params>
	</report>

	<!--  BALANCE DE SUMAS Y SALDOS -->
	<report id="trialBalance" description="trialBalance">
		<template path="/com/code/aon/ui/accounting/report/trialBalance.jasper"/>
		<collection provider="#{trialBalance}"/>
		<params>
			<param id="REPORT_RESOURCE_BUNDLE" value="com.code.aon.common.i18n.messages" />
			<param id="company" value="#{company.obtainCompany}" />
			<param id="summaryCollection" value="#{trialBalance.getSummaryCollection}" />
			<param id="params" value="#{trialBalance.getParameters}" />
		</params>
	</report>

	<!--  BALANCE DE SUMAS Y SALDOS OFICIAL-->
	<report id="officialTrialBalance" description="officialTrialBalance">
		<template path="/com/code/aon/ui/accounting/report/officialTrialBalance.jasper"/>
		<collection provider="#{officialTrialBalance}"/>
		<params>
			<param id="REPORT_RESOURCE_BUNDLE" value="com.code.aon.common.i18n.messages" />
			<param id="company" value="#{company.obtainCompany}" />
			<param id="summaryCollection" value="#{officialTrialBalance.getSummaryCollection}" />
			<param id="params" value="#{officialTrialBalance.getParameters}" />
		</params>
	</report>

	<!--  LISTADO DIARIO DE APUNTES -->
	<report id="journalBook" description="Listado Diario de Apuntes">
		<template path="/com/code/aon/ui/accounting/report/journalBook.jasper"/>
		<bean key="com.code.aon.accounting.AccountEntryDetail" />
		<criteria provider="#{journalReport}"/>
		<fetch-mode paginated="true" page-count="5000" virtualizer-max-size="1000" />
		<params>
			<param id="REPORT_RESOURCE_BUNDLE" value="com.code.aon.common.i18n.messages" />
			<param id="company" value="#{company.obtainCompany}" />
			<param id="fromDate" value="#{journalReport.getFromDate}" />
			<param id="toDate" value="#{journalReport.getToDate}" />
			<param id="date" value="#{journalReport.getDate}" />
			<param id="period" value="#{journalReport.getPeriod}" />
			<param id="journal" value="#{journalReport.isJournal}" />
			<param id="showCover" value="#{journalReport.isCoverVisible}" />
			<param id="showCounter" value="#{journalReport.isCounterVisible}" />
			<param id="pageCounter" value="#{journalReport.getPageCounter}" />
		</params>
	</report>
	<report id="journalBookXls" description="Listado Diario para Excel de Apuntes">
		<template path="/com/code/aon/ui/accounting/report/journalBookXls.jasper"/>
		<bean key="com.code.aon.accounting.AccountEntryDetail" />
		<criteria provider="#{journalReport}"/>
		<fetch-mode paginated="true" page-count="5000" virtualizer-max-size="1000" />
		<params>
			<param id="REPORT_RESOURCE_BUNDLE" value="com.code.aon.common.i18n.messages" />
			<param id="company" value="#{company.obtainCompany}" />
			<param id="fromDate" value="#{journalReport.getFromDate}" />
			<param id="toDate" value="#{journalReport.getToDate}" />
			<param id="date" value="#{journalReport.getDate}" />
			<param id="period" value="#{journalReport.getPeriod}" />
			<param id="journal" value="#{journalReport.isJournal}" />
		</params>
	</report>
	
	<!--  LISTADO MAYOR -->
	<report id="ledgerBook" description="Listado Mayor">
		<template path="/com/code/aon/ui/accounting/report/ledgerBook.jasper"/>
		<bean key="com.code.aon.accounting.AccountEntryDetail" />
		<criteria provider="#{ledgerReport}"/>
		<fetch-mode paginated="true" page-count="5000" virtualizer-max-size="1000" />
		<params>
			<param id="REPORT_RESOURCE_BUNDLE" value="com.code.aon.common.i18n.messages" />
			<param id="company" value="#{company.obtainCompany}" />
			<param id="fromDate" value="#{ledgerReport.getFromDate}" />
			<param id="toDate" value="#{ledgerReport.getToDate}" />
			<param id="date" value="#{ledgerReport.getDate}" />
			<param id="period" value="#{ledgerReport.getPeriod}" />
			<param id="journalOrdered" value="#{ledgerReport.isJournalOrdered}" />
			<param id="showCover" value="#{ledgerReport.isCoverVisible}" />
			<param id="showCounter" value="#{ledgerReport.isCounterVisible}" />
			<param id="pageCounter" value="#{ledgerReport.getPageCounter}" />
		</params>
	</report>

	<!--  BALANCES OFICIALES  -->
	<report id="officialBalance" description="Official Balance Report">
		<template path="/com/code/aon/ui/accounting/report/officialBalanceSheet.jasper" />
	  	<collection provider="#{balanceSheet}" />
		<params>
			<param id="REPORT_RESOURCE_BUNDLE" value="com.code.aon.common.i18n.messages" />
			<param id="company" value="#{company.obtainCompany}" />
			<param id="balance" value="#{balanceSheet.getBalance}" />
			<param id="params" value="#{balanceSheet.getParameters}" />
			<param id="previousPeriod" value="#{balanceSheet.getPreviousPeriodName}" />
			<param id="flagAccounts" value="#{balanceSheet.getFlagAccounts}" />
		</params>
	</report>
	
		<!--  MANTENIMIENTO DE BALANCES -->
	<report id="balanceDetailList" description="balance Detail List">
		<template path="/com/code/aon/ui/accounting/report/balanceDetailList.jasper" />
		<bean key="com.code.aon.accounting.BalanceDetail" />
		<criteria provider="#{balanceDetail}"/>	
		<params>
			<param id="REPORT_RESOURCE_BUNDLE" value="com.code.aon.common.i18n.messages" />
			<param id="company" value="#{company.obtainCompany}" />
		</params>
	</report>
	
	<!--  *********  FICHAS DE AMORTIZACION LISTADO ********* -->
	<report id="amortizationList" description="Amortization List">
		<template path="/com/code/aon/ui/accounting/report/amortizationList.jasper"/>
		<bean key="com.code.aon.accounting.Amortization" />
		<criteria provider="#{amortization}"/>
		<params>
			<param id="REPORT_RESOURCE_BUNDLE" value="com.code.aon.common.i18n.messages" />
			<param id="company" value="#{company.obtainCompany}" />
		</params>
	</report>
	
	<!--  *********  FICHAS DE AMORTIZACION ANUAL FORMULARIO  ********* -->
	<report id="amortizationFormAnnual" description="Amortization Form">
		<template path="/com/code/aon/ui/accounting/report/amortizationForm.jasper" />
		<collection provider="#{amortizationDetail.amortizationSummaryList}" />  
		<params>
			<param id="REPORT_RESOURCE_BUNDLE" value="com.code.aon.common.i18n.messages" />
			<param id="company" value="#{company.obtainCompany}" />
		</params>
	</report>	  

	<!--  *********  FICHAS DE AMORTIZACION FORMULARIO  ********* -->
	<report id="amortizationForm" description="Amortization Form">
		<template path="/com/code/aon/ui/accounting/report/amortizationForm.jasper" />
		<collection provider="#{amortizationDetail.amortizationList}" />  
		<params>
			<param id="REPORT_RESOURCE_BUNDLE" value="com.code.aon.common.i18n.messages" />
			<param id="company" value="#{company.obtainCompany}" />
		</params>
	</report>	  
		
	<!--  *********  FICHAS DE AMORTIZACION FORMULARIO DESDE LA LISTA ********* -->
	<report id="amortizationFormFromList" description="Amortization Form">
		<template path="/com/code/aon/ui/accounting/report/amortizationForm.jasper" />
		<collection provider="#{amortizationDetail.amortizationListComplete}" />  
		<params>
			<param id="REPORT_RESOURCE_BUNDLE" value="com.code.aon.common.i18n.messages" />
			<param id="company" value="#{company.obtainCompany}" />
		</params>
	</report>	  

	<!--  *********  PERIODOS DE AMORTIZACION LISTADO ********* -->
	<report id="amortizationPeriod" description="Amortization Period List">
		<template path="/com/code/aon/ui/accounting/report/amortizationPeriod.jasper"/>
		<collection provider="#{periodAmortization.amortizationList}" />  
		<params>
			<param id="REPORT_RESOURCE_BUNDLE" value="com.code.aon.common.i18n.messages" />
			<param id="company" value="#{company.obtainCompany}" />
			<param id="period" value="#{periodAmortization.getPeriod}" />
			<param id="controller" value="#{periodAmortization.getController}" />
		</params>
	</report>
	<report id="amortizationPeriodXLS" description="Amortization Period List">
		<template path="/com/code/aon/ui/accounting/report/amortizationPeriodXLS.jasper"/>
		<collection provider="#{periodAmortization.amortizationList}" />  
		<params>
			<param id="REPORT_RESOURCE_BUNDLE" value="com.code.aon.common.i18n.messages" />
			<param id="company" value="#{company.obtainCompany}" />
			<param id="period" value="#{periodAmortization.getPeriod}" />
		</params>
	</report>

	<!--  OPERATION REPORT -->
	<report id="operationReport" description="Listado de Gastos-Compras/Ingresos-Ventas">
		<template path="/com/code/aon/ui/accounting/report/operationReport.jasper"/>
		<collection provider="#{operationReport.pdfReport}" />
		<params>
			<param id="REPORT_RESOURCE_BUNDLE" value="com.code.aon.common.i18n.messages" />
			<param id="company" value="#{company.obtainCompany}" />
			<param id="params" value="#{operationReport.getParams}" />
			<param id="showCover" value="#{operationReport.isCoverVisible}" />
			<param id="showCounter" value="#{operationReport.isCounterVisible}" />
			<param id="pageCounter" value="#{operationReport.getPageCounter}" />
		</params>
	</report>
</report-config>