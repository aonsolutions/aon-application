<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
	xmlns:office='urn:import:com.esferalia.aon.gwt.office.client' xmlns:g="urn:import:com.google.gwt.user.client.ui">

	<ui:with type="com.esferalia.aon.gwt.common.client.i18n.AonHubMessages"
		field="msg"></ui:with>
	<ui:with type="com.esferalia.aon.gwt.common.client.css.AonResources"
		field="aonResources"></ui:with>

	<ui:style>
	.buttons {
		padding-top: 10px;
		text-align: right;
	}
	</ui:style>

	<g:HTMLPanel width="100%" height="100%" ui:field="principalPanel">
		<g:HTMLPanel height="100%" width="100%">
			<g:HTMLPanel width="100%" height="100%" styleName="aon-scroll-area">
				<office:DuplicatedDataGrid height="400px"
					width="690px" ui:field="dataGrid" />
			</g:HTMLPanel>
			<g:HTMLPanel height="100%" width="100%">
				<table width="100%">
					<tr>
						<td>
							<div class="aon-scroll-area">

								<g:Label styleName="{aonResources.css.aonBold}" text="Mostrar: " />
								<g:Button ui:field="faqsButton" text="" title="Cargar las FAQs"
									styleName="{aonResources.css.aonFindingToolbarItem} aon-icon-menu-help" />

								<g:Button ui:field="duplicatedButton" text=""
									title="Cargar las incidencias duplicadas"
									styleName="{aonResources.css.aonFindingToolbarItem} {aonResources.css.aonIconIssueDuplicated}" />
							</div>
						</td>
						<td>
							<div class="{style.buttons} aon-scroll-area">
								<g:Button ui:field="cancelButton" styleName="{aonResources.css.aonBold}"
									text="{msg.cancel}" />
								<g:Button ui:field="newButton" styleName="{aonResources.css.aonBold}"
									text="{msg.createNew}" />
								<g:Button ui:field="acceptButton" styleName="{aonResources.css.aonBold}"
									text="{msg.toAssign}" enabled="false" />
							</div>
						</td>
					</tr>
				</table>
			</g:HTMLPanel>
		</g:HTMLPanel>
	</g:HTMLPanel>
</ui:UiBinder> 