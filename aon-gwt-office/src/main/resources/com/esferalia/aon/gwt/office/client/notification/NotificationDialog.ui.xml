<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<ui:UiBinder xmlns:ui='urn:ui:com.google.gwt.uibinder'
	xmlns:g='urn:import:com.google.gwt.user.client.ui' 
	xmlns:es3='urn:import:com.google.gwt.user.client.ui'
	xmlns:datepicker='urn:import:com.google.gwt.user.datepicker.client'>

	<ui:with type="com.esferalia.aon.gwt.common.client.css.AonGwtTemplateResources" field="templates"></ui:with>
	
	<g:HTMLPanel styleName="{templates.css.formTemplate}">
		<div>
			<g:FlexTable ui:field="flex_table">
			
			</g:FlexTable>
		</div>
		<div class="buttons-template">
			<g:Button ui:field="cancel_button"></g:Button>
			<g:Button ui:field="accept_button"></g:Button>
		</div>
	
	</g:HTMLPanel>

</ui:UiBinder>