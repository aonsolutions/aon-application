<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
	xmlns:g="urn:import:com.google.gwt.user.client.ui" xmlns:datepicker='urn:import:com.google.gwt.user.datepicker.client'>
	<ui:style>
	.form {
		padding: 10px;
	}
	
	.field {
		padding: 1px 0.5em;
	}
	
	.buttons {
		padding-top: 10px;
		text-align: right;
	}
	</ui:style>
	
		<g:DockLayoutPanel unit="PX" height="100%" width="100%">
		<g:north size="60">
			<g:FlowPanel>
				<g:FlowPanel styleName="aon-finding-title-toolbar">
					<g:HorizontalPanel>
						<g:HTMLPanel styleName="aon-finding-title">
							<g:HTMLPanel styleName="aon-finding-title-internal">
								<g:Label styleName="aon-outputText" ui:field="titleLabel"
									text="Hola prueba 1" />
							</g:HTMLPanel>
						</g:HTMLPanel>
						<g:HTMLPanel styleName="aon-finding-subtitle">
							<g:HTMLPanel styleName="aon-finding-subtitle-internal">
								<g:Label styleName="aon-outputText"></g:Label>
							</g:HTMLPanel>
						</g:HTMLPanel>
						<g:HorizontalPanel styleName="aon-finding-toolbar">
							<g:HTMLPanel styleName="aon-finding-toolbar-item-group">
								<g:InlineLabel
									styleName="aon-finding-toolbar-item aon-finding-toolbar-item-no-border"
									text="Hola prueba 2" />
								<g:ListBox ui:field='repoListBox' />
							</g:HTMLPanel>
							<g:HTMLPanel styleName="aon-finding-toolbar-item-group">
								<g:InlineLabel
									styleName="aon-finding-toolbar-item aon-finding-toolbar-item-no-border"
									text="Hola prueba 3" />
								<g:SuggestBox ui:field='nameEmployee' styleName="aon-inputText"
									width="300px" enabled="false" />
							</g:HTMLPanel>
						</g:HorizontalPanel>
					</g:HorizontalPanel>
				</g:FlowPanel>
			</g:FlowPanel>
		</g:north>

		<g:west size="120">

			<g:ScrollPanel>
				<g:Grid>
					<g:row>
						<g:customCell horizontalAlignment="ALIGN_CENTER"
							verticalAlignment="ALIGN_MIDDLE">
							<g:Button
								styleName="aon-bold aon-icon-commandButton aon-icon-new"
								text="Boton 1" ui:field="newIssue" />
						</g:customCell>
					</g:row>
					<g:row />
					<g:row>
						<g:customCell>
							<g:Button styleName="aon-direct-access-list-element"
								text="Boton 2" ui:field="openIssues" />
						</g:customCell>
					</g:row>

					<g:row>
						<g:customCell>
							<g:Button styleName="aon-direct-access-list-element"
								text="Boton 3" ui:field="closedIssues" />
						</g:customCell>
					</g:row>
					<g:row>
						<g:customCell>
							<g:Button styleName="aon-direct-access-list-element"
								text="Boton 4" ui:field="allIssues" />
						</g:customCell>
					</g:row>
					<g:row>
						<g:customCell>
							<g:Button styleName="aon-direct-access-list-element" text="Boton 5"
								ui:field="deletedIssues" />
						</g:customCell>
					</g:row>
					<g:row>
					</g:row>
				</g:Grid>

			</g:ScrollPanel>
		</g:west>

		<g:center>
			<g:ResizeLayoutPanel ui:field="dockPanel">
				<g:HTMLPanel styleName="aon-scroll-area">
					<g:SimpleLayoutPanel ui:field="resultsPanel"
						styleName="aon-panelGrid-search">
						<g:Grid ui:field="dataGrid" />
					</g:SimpleLayoutPanel>
				</g:HTMLPanel>
			</g:ResizeLayoutPanel>
		</g:center>

		<g:south size="40">
			<g:FlowPanel>
				<g:Grid>
					<g:row>
						<g:customCell>
							<g:Label ui:field='pager' />
						</g:customCell>
					</g:row>
				</g:Grid>
			</g:FlowPanel>
		</g:south>

	</g:DockLayoutPanel>
</ui:UiBinder> 