<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
	xmlns:g="urn:import:com.google.gwt.user.client.ui"
	xmlns:datepicker='urn:import:com.google.gwt.user.datepicker.client'>
	<ui:style>
	
		.form {
		padding: 10px;
	}
	
	.field {
		padding: 1px 0.5em;
	}
	
	.buttons {
		padding-top: 10px;
		text-align: right;
	}
	
	</ui:style>
	<g:HTMLPanel styleName="{style.form}">

		<g:Grid width="100%">
			<g:row>
				<g:customCell>
					<g:Label text="Titulo" />
				</g:customCell>
				<g:customCell styleName="{style.field}">
					<g:TextBox ui:field="titleTextBox" styleName="aon-inputText"
						width="280px" />
				</g:customCell>
			</g:row>

		</g:Grid>
		
		<g:TextArea ui:field="bodyTextArea" width="100%"/>

		<div class="{style.buttons}">
			<g:Button ui:field="cancelButton">Cancelar</g:Button>
			<g:Button ui:field="acceptButton">Aceptar</g:Button>
		</div>

	</g:HTMLPanel>
</ui:UiBinder> 