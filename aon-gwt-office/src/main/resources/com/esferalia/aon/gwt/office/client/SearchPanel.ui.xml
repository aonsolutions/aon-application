<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
	xmlns:g="urn:import:com.google.gwt.user.client.ui" xmlns:c="urn:import:com.google.gwt.user.cellview.client">

	<ui:with type="com.esferalia.aon.gwt.common.client.i18n.AonHubMessages"
		field="msg"></ui:with>
	<ui:with type="com.esferalia.aon.gwt.common.client.css.AonResources"
		field="aonResources"></ui:with>

	<ui:style>
	
	</ui:style>

	<g:VerticalPanel spacing="5">
		<g:HTMLPanel>
			<table class="{aonResources.css.aonGroupBody}">
				<tr>
					<td>
						<g:Label text="ID:" styleName="{aonResources.css.aonBold}" />
					</td>
					<td>
						<td>
							<g:TextBox ui:field="idNoticeTb"
								styleName="{aonResources.css.aonWidth70} {aonResources.css.aonInputText}" />
						</td>
					</td>
					<td>
						<g:Button ui:field="searchIdButton"
							styleName="{aonResources.css.aonIconSearch} {aonResources.css.aonIconCommandButton}"
							enabled="false" />
					</td>
				</tr>

			</table>
			<table class="{aonResources.css.aonGroupBody}">
				<tr>
					<td>
						<g:Label styleName="{aonResources.css.aonIconCompany}" />
					</td>
					<td>
						<g:SuggestBox styleName="{aonResources.css.aonInputText}"
							width="300px" ui:field="registrySuggest" />
					</td>
					<td></td>
					<td></td>
					<td>
						<g:Label styleName="{aonResources.css.aonBold}" text="Asunto" />
					</td>
					<td>
						<g:TextBox
							styleName="{aonResources.css.aonInputText} {aonResources.css.aonWidth300}"
							ui:field="subjectTextBox" />
					</td>
				</tr>
			</table>
		</g:HTMLPanel>
		<g:HTMLPanel>
			<table class="{aonResources.css.aonGroupBody}">
				<tr>
					<td></td>

					<td>
						<g:HorizontalPanel spacing="5">
							<g:Label text="Tipo" styleName="{aonResources.css.aonItalic}" />
							<g:Button ui:field="typeButton" text="Tipo"
								styleName="{aonResources.css.aonIconView} {aonResources.css.aonIconCommandButton}" />
						</g:HorizontalPanel>
					</td>
					<td>
						<g:HorizontalPanel spacing="5">
							<g:Label text="Prioridad" styleName="{aonResources.css.aonItalic}" />
							<g:Button ui:field="priorityButton" text="Prioridad"
								styleName="{aonResources.css.aonIconView} {aonResources.css.aonIconCommandButton}" />
						</g:HorizontalPanel>
					</td>
					<td>
						<g:HorizontalPanel spacing="5">
							<g:Label text="Etiquetas" styleName="{aonResources.css.aonItalic}" />
							<g:Button ui:field="noticeTagButton" text="Etiqueta"
								styleName="{aonResources.css.aonIconView} {aonResources.css.aonIconCommandButton}" />
						</g:HorizontalPanel>
					</td>
					<td>
						<g:HorizontalPanel spacing="5">
							<g:Label text="Usuario" styleName="{aonResources.css.aonItalic}" />
							<g:Button ui:field="ownerButton" text="Usuario"
								styleName="{aonResources.css.aonIconView} {aonResources.css.aonIconCommandButton}" />
						</g:HorizontalPanel>
					</td>
					<td>
						<g:HorizontalPanel spacing="5">
							<g:Label text="a partir de " styleName="{aonResources.css.aonItalic}" />
							<g:ListBox ui:field="fromListBox" />
						</g:HorizontalPanel>
					</td>
				</tr>
			</table>
		</g:HTMLPanel>
	</g:VerticalPanel>
</ui:UiBinder> 