<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
	xmlns:g="urn:import:com.google.gwt.user.client.ui" xmlns:cell='urn:import:com.google.gwt.user.cellview.client'
	xmlns:office='urn:import:com.esferalia.aon.gwt.office.client'
	xmlns:aon='urn:import:com.esferalia.aon.gwt.common.client.widget'>

	<ui:with type="com.esferalia.aon.gwt.common.client.i18n.AonHubMessages"
		field="msg"></ui:with>
	<ui:with type="com.esferalia.aon.gwt.common.client.css.AonResources"
		field="aonResources"></ui:with>

	<ui:style>
	.stackHeader {
		padding: 0.7em 0.5em 0.7em 0.6em;
	}
	
	.searchPanel {
		left: 1em !important;
		right: 2em !important;
		bottom: 0.5em !important;
		border-bottom: 1px solid #D8D27A !important;
	}
	
	.aon-editDataTable-buttonWest {
		min-height: 22px;
		border: 0;
		cursor: pointer;
		padding-left: 15px;
		padding-top: 0px;
		padding-bottom: 0px;
		padding-right: 0px;
		background-color: transparent;
		margin-right: 5px;
	}
	
	.vpanel-notices {
		border: 0px !important;
		margin-left: 5px !important;
	}
	
	.stackBorder-notices {
		border-left: 1px solid #BBB;
		border-top: 1px solid #BBB;
		border-bottom: 1px solid #BBB;
		border-right: 0px !important;
	}
	</ui:style>

	<g:DockLayoutPanel unit="PX" ui:field="dockLayoutPanel">
		<g:north size="25">


			<g:FlowPanel styleName="aon-finding-title-toolbar">
				<g:HorizontalPanel>
					<g:HTMLPanel styleName="aon-finding-title">
						<g:HTMLPanel styleName="aon-finding-title-internal">
							<g:Label styleName="aon-outputText" text="Incidencias" />
						</g:HTMLPanel>
					</g:HTMLPanel>
					<g:HTMLPanel styleName="aon-finding-subtitle">
						<g:HTMLPanel styleName="aon-finding-subtitle-internal">
							<g:Label styleName="aon-outputText"></g:Label>
						</g:HTMLPanel>
					</g:HTMLPanel>
					<g:HTMLPanel styleName="aon-finding-toolbar-item-group">
						<g:Button ui:field='newIssueButton'
							styleName='aon-finding-toolbar-item {aonResources.css.aonIconReset}'
							text="AVISO" />
						<g:Button ui:field='tagButton'
							styleName='aon-finding-toolbar-item {aonResources.css.aonIconReset}'
							text="ETIQUETAS" />
						<g:Button ui:field='returnButton'
							styleName='aon-finding-toolbar-item {aonResources.css.aonIconCancel}'
							text="VOLVER" enabled="false" />
					</g:HTMLPanel>
				</g:HorizontalPanel>
			</g:FlowPanel>

		</g:north>

		<g:center>
			<g:DeckLayoutPanel ui:field="deckPanel">

				<g:DockLayoutPanel ui:field="dockOfficePanel"
					unit="PX">
					<g:north size="90">
						<g:HTMLPanel styleName="aon-panelGrid-search {style.searchPanel}">
							<div class="aon-panelGrid-search-info">
								<g:Label styleName="aon-panelGrid-search-info-internal"
									text="Criterio de búsqueda" />
							</div>

							<g:Grid>
								<g:row>
									<g:customCell>
										<g:Label text="Mostrar a partir de " styleName="{aonResources.css.aonBold}" />
									</g:customCell>
									<g:customCell>
										<g:ListBox ui:field="fromListBox" />
									</g:customCell>
									<g:customCell>
										<g:RadioButton ui:field="openIssuesRb" name="showIssuesRb"
											value="true" styleName="{aonResources.css.aonBold}"> Abiertas </g:RadioButton>
									</g:customCell>
									<g:customCell>
										<g:RadioButton ui:field="closedIssuesRb" name="showIssuesRb"
											value="false"> Cerradas </g:RadioButton>
									</g:customCell>
									<g:customCell>
										<g:RadioButton ui:field="allIssuesRb" name="showIssuesRb"
											value="false"> Todas </g:RadioButton>
									</g:customCell>
								</g:row>
							</g:Grid>
						</g:HTMLPanel>
					</g:north>
					<g:center>
						<g:HTMLPanel styleName="aon-scroll-area">
							<g:SimpleLayoutPanel ui:field="resultsPanel"
								height="100%">
								<office:IssueGrid ui:field="dataGrid" />
							</g:SimpleLayoutPanel>
						</g:HTMLPanel>
					</g:center>
				</g:DockLayoutPanel>
				<g:ResizeLayoutPanel ui:field="readIssuePanel">
					<g:HTMLPanel styleName="aon-scroll-area">
						<g:SimpleLayoutPanel ui:field="readIssueLayoutPanel"
							height="100%" />
					</g:HTMLPanel>
				</g:ResizeLayoutPanel>

			</g:DeckLayoutPanel>
		</g:center>

		<g:west size="0">
			<g:StackLayoutPanel unit="EM" ui:field="stackLayoutPanel">
				<g:stack ui:field="tagStack">
					<g:header size='3'>
						<div class='{style.stackHeader}'>
							<div />
							ETIQUETAS
						</div>
					</g:header>
					<office:TagTree ui:field="tagTree" />
				</g:stack>
			</g:StackLayoutPanel>

		</g:west>


	</g:DockLayoutPanel>
</ui:UiBinder> 