<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
	xmlns:g="urn:import:com.google.gwt.user.client.ui" xmlns:cell='urn:import:com.google.gwt.user.cellview.client'
	xmlns:office='urn:import:com.esferalia.aon.gwt.office.client'
	xmlns:aon='urn:import:com.esferalia.aon.gwt.common.client.widget'>

	<ui:with type="com.esferalia.aon.gwt.common.client.i18n.AonHubMessages"
		field="msg"></ui:with>
	<ui:with type="com.esferalia.aon.gwt.common.client.css.AonResources"
		field="aonResources"></ui:with>

	<ui:style>
	.stackHeader {
		padding: 0.7em 0.5em 0.7em 0.6em;
	}
	
	.aon-editDataTable-buttonWest {
		min-height: 22px;
		border: 0;
		cursor: pointer;
		padding-left: 15px;
		padding-top: 0px;
		padding-bottom: 0px;
		padding-right: 0px;
		background-color: transparent;
		margin-right: 5px;
	}
	
	.vpanel-notices {
		border: 0px !important;
		margin-left: 5px !important;
	}
	
	.stackBorder-notices {
		border-left: 1px solid #BBB;
		border-top: 1px solid #BBB;
		border-bottom: 1px solid #BBB;
		border-right: 0px !important;
	}
	</ui:style>

	<g:DockLayoutPanel unit="PX">
		<g:north size="72">


			<g:FlowPanel>

				<g:FlowPanel styleName="aon-finding-title-toolbar">
					<g:HorizontalPanel>
						<g:HTMLPanel styleName="aon-finding-title">
							<g:HTMLPanel styleName="aon-finding-title-internal">
								<g:Label styleName="aon-outputText" text="Incidencias" />
							</g:HTMLPanel>
						</g:HTMLPanel>
						<g:HTMLPanel styleName="aon-finding-subtitle">
							<g:HTMLPanel styleName="aon-finding-subtitle-internal">
								<g:Label styleName="aon-outputText" />
							</g:HTMLPanel>
						</g:HTMLPanel>
						<g:HorizontalPanel styleName="aon-finding-toolbar">
							<g:HTMLPanel styleName="aon-finding-toolbar-item-group">
								<g:Button ui:field='openIssuesButton' styleName="aon-finding-toolbar-item
								 aon-icon-issue-opened"  enabled="false"
									text="Abiertas" />
								<g:Button ui:field='closedIssuesButton' styleName="aon-finding-toolbar-item
								 aon-icon-issue-opened"
									text="Cerradas" />
							</g:HTMLPanel>
						</g:HorizontalPanel>
					</g:HorizontalPanel>
				</g:FlowPanel>

				<g:FlowPanel styleName="aon-finding-title-toolbar">
					<g:HorizontalPanel>
						<g:HTMLPanel styleName="aon-finding-title">
							<g:HTMLPanel styleName="aon-finding-title-internal">
								<g:Label styleName="aon-outputText">Edici&oacute;n</g:Label>
							</g:HTMLPanel>
						</g:HTMLPanel>
						<g:HTMLPanel styleName="aon-finding-subtitle">
							<g:HTMLPanel styleName="aon-finding-subtitle-internal">
								<g:Label styleName="aon-outputText"></g:Label>
							</g:HTMLPanel>
						</g:HTMLPanel>
						<g:HTMLPanel styleName="aon-finding-toolbar-item-group">
							<g:Button ui:field='newIssueButton'
								styleName='aon-finding-toolbar-item {aonResources.css.aonIconReset}'
								text="AVISO" />
							<g:Button ui:field='tagButton'
								styleName='aon-finding-toolbar-item {aonResources.css.aonIconReset}'
								text="ETIQUETAS" />
							<g:Button ui:field='returnButton'
								styleName='aon-finding-toolbar-item {aonResources.css.aonIconPrevious}'
								text="VOLVER" enabled="false" />

						</g:HTMLPanel>
					</g:HorizontalPanel>
				</g:FlowPanel>
			</g:FlowPanel>
		</g:north>

		<g:center>
			<g:DeckLayoutPanel ui:field="deckPanel">
				<g:ResizeLayoutPanel ui:field="dockOfficePanel">
					<g:HTMLPanel styleName="aon-scroll-area">
						<g:SimpleLayoutPanel ui:field="resultsPanel"
							height="100%">
							<office:IssueGrid ui:field="dataGrid" />
						</g:SimpleLayoutPanel>
					</g:HTMLPanel>
				</g:ResizeLayoutPanel>				
				<g:HorizontalPanel ui:field="readIssuePanel" />

				

			</g:DeckLayoutPanel>

		</g:center>
	</g:DockLayoutPanel>
</ui:UiBinder> 