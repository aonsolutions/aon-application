						<g:Button ui:field="boton3" text="Boton 1" />
					</g:VerticalPanel>
				</g:Dock>
				<g:Dock direction='CENTER'>
					<g:VerticalPanel>
						<g:Label text="Label1"></g:Label>
						<g:Label text="Label1"></g:Label>
						<g:Label text="Label1"></g:Label>
