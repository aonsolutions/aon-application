<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
	xmlns:g="urn:import:com.google.gwt.user.client.ui" xmlns:cell='urn:import:com.google.gwt.user.cellview.client'
	xmlns:office='urn:import:com.esferalia.aon.gwt.office.client'
	xmlns:aon='urn:import:com.esferalia.aon.gwt.common.client.widget'>

	<ui:with type="com.esferalia.aon.gwt.common.client.i18n.CommonMessages"
		field="msg"></ui:with>
	<ui:with type="com.esferalia.aon.gwt.common.client.css.AonResources"
		field="aonResources"></ui:with>

	<ui:style>
	.options-scroll-panel>div {
		height: 99%;
	}
	
	.simple-panel {
		background: #FFFFFF;
	}
	</ui:style>


	<g:DockLayoutPanel unit="PX" height="100%" width="100%"
		ui:field="officePanel">
		<g:north size="40">
			<g:FlowPanel>
				<g:FlowPanel styleName="aon-finding-title-toolbar">
					<g:HorizontalPanel>
						<g:HTMLPanel styleName="aon-finding-title">
							<g:HTMLPanel styleName="aon-finding-title-internal">
								<g:Label styleName="aon-outputText" ui:field="titleLabel"
									text="{msg.notifications}" />
							</g:HTMLPanel>
						</g:HTMLPanel>
						<g:HTMLPanel styleName="aon-finding-subtitle">
							<g:HTMLPanel styleName="aon-finding-subtitle-internal">
								<g:Label styleName="aon-outputText"></g:Label>
							</g:HTMLPanel>
						</g:HTMLPanel>
						<g:HorizontalPanel styleName="aon-finding-toolbar">
							<g:HTMLPanel styleName="aon-finding-toolbar-item-group">
								<g:InlineLabel
									styleName="aon-finding-toolbar-item aon-finding-toolbar-item-no-border"
									text="{msg.repositories}" />
								<g:ListBox ui:field='repoListBox' />
							</g:HTMLPanel>
							<g:HTMLPanel styleName="aon-finding-toolbar-item-group">
								<g:InlineLabel
									styleName="aon-finding-toolbar-item aon-finding-toolbar-item-no-border"
									text="{msg.searchAonHub}" />
								<g:SuggestBox ui:field='nameEmployee' styleName="aon-inputText"
									width="300px" enabled="false" />
							</g:HTMLPanel>
						</g:HorizontalPanel>
					</g:HorizontalPanel>
				</g:FlowPanel>
			</g:FlowPanel>
		</g:north>

		<g:west size="120">
			<office:LeftButtonsMenuBar ui:field="leftButtonBarMenu" />
		</g:west>

		<g:center>
			<g:ResizeLayoutPanel ui:field="dockPanel">
				<g:HTMLPanel styleName="aon-scroll-area {style.options-scroll-panel}">
					<g:SimpleLayoutPanel ui:field="resultsPanel"
						styleName="aon-panelGrid-search {style.simple-panel}">
						<office:IssueGrid ui:field="dataGrid" />
					</g:SimpleLayoutPanel>
				</g:HTMLPanel>
			</g:ResizeLayoutPanel>
		</g:center>

		<g:south size="40">
			<g:FlowPanel>
				<g:Grid>
					<g:row>
						<g:customCell>
							<g:Label />
						</g:customCell>
					</g:row>
				</g:Grid>
			</g:FlowPanel>
		</g:south>

	</g:DockLayoutPanel>


</ui:UiBinder> 