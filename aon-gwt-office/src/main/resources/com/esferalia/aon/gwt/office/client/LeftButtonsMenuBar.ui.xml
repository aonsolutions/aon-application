<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
	xmlns:g="urn:import:com.google.gwt.user.client.ui" xmlns:cell='urn:import:com.google.gwt.user.cellview.client'
	xmlns:office='urn:import:com.esferalia.aon.gwt.office.client'
	xmlns:aon='urn:import:com.esferalia.aon.gwt.common.client.widget'
	xmlns:common='urn:import:com.esferalia.aon.gwt.common.client.widget'>

	<ui:with type="com.esferalia.aon.gwt.common.client.i18n.AonHubMessages"
		field="msg"></ui:with>
	<ui:with type="com.esferalia.aon.gwt.common.client.css.AonResources"
		field="aonResources"></ui:with>

	<ui:style>
	.vpanel {
		border: 0px !important;
		margin-left: 5px !important;
	}
	.tree-button-west {
	min-height: 22px;
	border: 0;
	cursor: pointer;
	padding-left: 15px;
	padding-top: 0px;
	padding-bottom: 0px;
	padding-right: 0px;
	background-color: transparent;
	margin-right: 5px;
}
		
	.button-href {
		border: none;
		font-family: arial, sans-serif;
		font-size: 12px;
		cursor: pointer;
		padding-left: 14px;
	}
	
	.principal-button {
		font-family: arial, sans-serif;
		cursor: pointer;
		font-size: 14px;
		padding-left: 10px;
		margin-left: 14px;
	}
	
	.button_bar {
		
	}
	
	.button_bar button {
		background: none !important;
		border: none;
		font-family: arial, sans-serif;
		font-size: 12px;
		cursor: pointer;
		padding-left: 14px;
	}
	</ui:style>
	
	<g:DockLayoutPanel unit='PX'>
		<g:north size='26'>
			<g:FlowPanel styleName="gwt-MenuBar-horizontal" ui:field="buttonBar">
				<common:OptionsToolbar ui:field="toolbar" />
			</g:FlowPanel>
		</g:north>

		<g:center>
			<g:Tree ui:field="tree" />
		</g:center>
	</g:DockLayoutPanel>
	
