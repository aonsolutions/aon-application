<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
	xmlns:g="urn:import:com.google.gwt.user.client.ui" 
	xmlns:c="urn:import:com.esferalia.aon.gwt.common.client.widget">
	<ui:style>
	.text-area textarea {
		resize: none;
	}
	</ui:style>

	<ui:with type="com.esferalia.aon.gwt.common.client.i18n.AonHubMessages"
		field="msg"></ui:with>
	<ui:with type="com.esferalia.aon.gwt.common.client.css.AonResources"
		field="aonResources"></ui:with>

	<g:DockLayoutPanel unit="PX" height="100%">
		<g:center>
			<g:VerticalPanel spacing="5" width="80%">
				<g:HTMLPanel>
					<table>
						<tr>
							<td>
								<g:InlineLabel styleName="{aonResources.css.aonBold}"
									text="{msg.sender}" />
							</td>
							<td>
								<g:SuggestBox ui:field="registrySuggesBox"
									styleName="{aonResources.css.aonInputText}" width="300px" />
							</td>
						</tr>
						<tr>
							<td>
								<g:InlineLabel styleName="{aonResources.css.aonBold}"
									text="{msg.title}" />

							</td>
							<td>
								<g:TextBox ui:field="title" width="300px"
									styleName="{aonResources.css.aonInputText}" />

							</td>
						</tr>
					</table>
				</g:HTMLPanel>

				<g:TabPanel ui:field="tabPanel" width="100%" styleName="{style.text-area}">
					<g:Tab text="{msg.write}">
						<g:TextArea ui:field="commentTextArea" characterWidth="10"
							visibleLines="9" width="98%" height="99%" />
					</g:Tab>
				</g:TabPanel>
				<g:HorizontalPanel spacing="10" ui:field="hPanel">
					<g:Button text="{msg.save}" ui:field="commentButton" />
				</g:HorizontalPanel>
			</g:VerticalPanel>
		</g:center>

		<g:east size="180">

			<g:FlowPanel>
				<g:VerticalPanel ui:field="vTypePanel" spacing="5">
					<g:Label text="{msg.noticeType}" />
				</g:VerticalPanel>
				<g:VerticalPanel ui:field="vPriorityPanel" spacing="5">
					<g:Label text="{msg.priority}" />
				</g:VerticalPanel>
				<g:VerticalPanel ui:field="vLabelsPanel" spacing="5">
					<g:Label text="{msg.labelsIssues}" />
				</g:VerticalPanel>

			</g:FlowPanel>

		</g:east>
	</g:DockLayoutPanel>
</ui:UiBinder> 