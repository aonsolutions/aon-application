<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
	xmlns:g="urn:import:com.google.gwt.user.client.ui" xmlns:c="urn:import:com.esferalia.aon.gwt.common.client.widget">
	<ui:style>
	.text-area textarea {
		resize: none;
	}
	</ui:style>

	<ui:with type="com.esferalia.aon.gwt.common.client.i18n.AonHubMessages"
		field="msg"></ui:with>
	<ui:with type="com.esferalia.aon.gwt.common.client.css.AonResources"
		field="aonResources"></ui:with>

	<g:DockLayoutPanel unit="PX" height="100%">
		<g:center>
			<g:VerticalPanel spacing="10" width="100%">
				<g:HTMLPanel>
					<table>
						<tr>
							<td>
								<g:InlineLabel styleName="{aonResources.css.aonBold}"
									text="{msg.login}" />
							</td>
							<td>
								<g:SuggestBox ui:field="loginSuggestBox" width="300px"
									styleName="{aonResources.css.aonInputText}" />
							</td>
						</tr>
						<tr>
							<td>
								<g:InlineLabel styleName="{aonResources.css.aonBold}"
									text="{msg.title}" title="{msg.titleNewNotice}" />
							</td>
							<td>
								<g:TextBox ui:field="titleTextBox" width="300px"
									styleName="{aonResources.css.aonInputText}" />
							</td>
						</tr>
						<tr>
							<td>
								<g:InlineLabel styleName="{aonResources.css.aonBold}"
									text="{msg.noticeType}" />
							</td>
							<td>
								<g:HorizontalPanel ui:field="hTypePanel"
									spacing="5" />
							</td>
						</tr>
						<tr>
							<td>
								<g:InlineLabel styleName="{aonResources.css.aonBold}"
									text="{msg.sender}" title="{msg.titleRemite}" />
							</td>
							<td>
								<g:TextBox ui:field="remiteTextBox" styleName="{aonResources.css.aonInputText}"
									width="300px" readOnly="true" />
							</td>
						</tr>
						<tr>
							<td>
								<g:InlineLabel styleName="{aonResources.css.aonBold}"
									text="{msg.company}" title="{msg.titleCompany}" />
							</td>
							<td>
								<g:TextBox ui:field="companyTextBox" styleName="{aonResources.css.aonInputText}"
									width="300px" readOnly="true" />
							</td>
						</tr>
						<tr>
							<td>
								<g:InlineLabel styleName="{aonResources.css.aonBold}"
									text="{msg.contact}" title="{msg.titlePhone}" />
							</td>
							<td>
								<g:TextBox ui:field="phoneTextBox" styleName="{aonResources.css.aonInputText}"
									width="300px" />
							</td>
						</tr>
						<tr>
							<td>
								<g:InlineLabel styleName="{aonResources.css.aonBold}"
									text="{msg.recipient}" title="{msg.titleRecipient}" />
							</td>
							<td>
								<g:SuggestBox ui:field="recipientSuggestBox"
									styleName="{aonResources.css.aonInputText}" width="300px" />
							</td>
						</tr>
					</table>
				</g:HTMLPanel>

				<g:TabPanel ui:field="tabPanel" width="100%" styleName="{style.text-area}">
					<g:Tab text="{msg.write}">
						<g:TextArea ui:field="commentTextArea" characterWidth="10"
							visibleLines="9" width="98%" height="99%" />
					</g:Tab>
				</g:TabPanel>
				<g:HorizontalPanel spacing="10" ui:field="hPanel">
					<g:Button text="{msg.save}" ui:field="commentButton" />
				</g:HorizontalPanel>
			</g:VerticalPanel>
		</g:center>

		<g:east size="180">
			<g:FlowPanel>
				<g:VerticalPanel spacing="15">
					<g:HorizontalPanel spacing="10">
						<g:Tree ui:field="priorityTree" animationEnabled="true" />
						<g:Button ui:field="addPriorityButton"
							styleName="aon-editDataTable-button aon-lookupButton-new-disabled aon-aux-right"
							title="Nueva Etiqueta" />
					</g:HorizontalPanel>
					<g:HorizontalPanel spacing="10">
						<g:Tree ui:field="labelsTree" animationEnabled="true" />
						<g:Button ui:field="addLabelButton"
							styleName="aon-editDataTable-button aon-lookupButton-new-disabled aon-aux-right"
							title="Nueva Etiqueta" />
					</g:HorizontalPanel>
				</g:VerticalPanel>
			</g:FlowPanel>
		</g:east>
	</g:DockLayoutPanel>
</ui:UiBinder> 