<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
	xmlns:g="urn:import:com.google.gwt.user.client.ui">

	<ui:with type="com.esferalia.aon.gwt.common.client.i18n.CommonMessages"
		field="msg"></ui:with>
	<ui:with type="com.esferalia.aon.gwt.common.client.css.AonResources"
		field="aonResources"></ui:with>

	<ui:style>
	.header-title {
		font-weight: bolder;
		font-size: 30px;
		font-color: #333;
		line-height: 1.1;
		word-wrap: break-word;
	}
	
	.header-title-number {
		color: #aaa;
	}
	
	.header-subtitle {
		color: #767676;
		font-size: 16px;
		line-height: 20px;
		padding-left: 31px;
	}
	
	.state {
		border-radius: 3px;
		color: #fff;
		display: inline-block;
		font-weight: bold;
		line-height: 20px;
		padding: 4px 8px;
		text-align: center;
	}
	
	.grid {
		width: 150px;
		height: 50px;
		padding: 5px;
		position: absolute;
		left: 220px;
		top: 350px;
	}
	</ui:style>
	<g:DockLayoutPanel unit="PX" height="100%" width="100%">
		<g:north size="100">
			<g:FlowPanel>
				<g:HTMLPanel styleName="{style.header-title}">
					<g:InlineLabel ui:field="titleLabel" />
					<g:InlineLabel ui:field="numberIssueLabel" styleName="{style.header-title-number}" />
				</g:HTMLPanel>
				<g:HTMLPanel>
					<g:InlineLabel ui:field="stateLabel" />
					<g:InlineLabel ui:field="userCreateLabel"
						styleName="{style.header-subtitle} aon-icon-employee" />
					<g:InlineLabel ui:field="whenCreateLabel"
						styleName="{style.header-subtitle} {style.header-title-number}" />
				</g:HTMLPanel>
			</g:FlowPanel>
		</g:north>

		<g:center>
			<g:FlowPanel ui:field="flowIssuesPanel">
			</g:FlowPanel>
		</g:center>

		<g:south size="150">
			<g:FlowPanel>
				<g:Grid>
					<g:row>
						<g:customCell>
							<g:Button ui:field="closeButton" text="Cerrar" />
						</g:customCell>
						<g:customCell>
							<g:Button ui:field="commentButton" text="Comentar" />
						</g:customCell>

					</g:row>
				</g:Grid>
			</g:FlowPanel>
		</g:south>

	</g:DockLayoutPanel>
</ui:UiBinder> 