<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
	xmlns:g="urn:import:com.google.gwt.user.client.ui" xmlns:o="urn:import:com.esferalia.aon.gwt.office.client">

	<ui:with type="com.esferalia.aon.gwt.common.client.i18n.CommonMessages"
		field="msg"></ui:with>
	<ui:with type="com.esferalia.aon.gwt.common.client.css.AonResources"
		field="aonResources"></ui:with>

	<ui:style
		type='com.esferalia.aon.gwt.office.client.IssuesLayoutPanel.MyStyle'>
		.header-title {
			font-weight: bolder;
			font-size: 30px;
			font-color: #333;
			line-height: 1.1;
			word-wrap: break-word;
		}
		
		.header-title-number {
			color: #aaa;
		}
		
		.header-subtitle {
			color: #767676;
			font-size: 16px;
			line-height: 20px;
		}
		
		.state-open {
			background-color: #6cc644;
		}
		
		.state-close {
			background-color: #bd2c00;;
		}
		
		.state {
			border-radius: 3px;
			color: #fff;
			display: inline-block;
			font-weight: bold;
			line-height: 20px;
			padding: 4px 8px 4px 17px;
			text-align: center;
		}
		
		.text-area textarea {
			resize: none;
		}
		</ui:style>
	<g:DockLayoutPanel unit="PX" height="100%" width="100%">
		<g:north size="40">
			<g:FlowPanel>
				<g:HTMLPanel styleName="{style.header-title}">
					<g:InlineLabel ui:field="titleLabel" />
					<g:InlineLabel ui:field="numberIssueLabel" styleName="{style.header-title-number}" />
				</g:HTMLPanel>
			</g:FlowPanel>
		</g:north>
		<g:north size="72">
			<g:FlowPanel>
				<g:HTMLPanel styleName="{style.header-subtitle}">
					<g:InlineLabel ui:field="stateLabel" styleName="{style.state}" />
					<g:InlineLabel ui:field="userCreateLabel" />
					<g:InlineLabel ui:field="whenCreateLabel" styleName="{style.header-title-number}" />
				</g:HTMLPanel>
				<g:HTMLPanel>
					<g:HorizontalPanel ui:field="hPanel" spacing="10" />
				</g:HTMLPanel>

			</g:FlowPanel>

		</g:north>

		<g:center>
			<g:ScrollPanel width="80%" height="100%">
				<g:VerticalPanel spacing="5"  width="80%" height="100%">
					<g:FlowPanel ui:field="flowIssuesPanel" />
					<g:TabPanel ui:field="tabPanel" width="100%"
						styleName="{style.text-area}">
						<g:Tab text="Escribir">
							<g:TextArea ui:field="commentTextArea" characterWidth="10"
								visibleLines="9" width="98%" height="99%" />
						</g:Tab>
					</g:TabPanel>
					<g:HorizontalPanel spacing="10" ui:field="buttonHPanel">
						<g:Button text="Comentar" ui:field="commentButton" />						
					</g:HorizontalPanel>

				</g:VerticalPanel>

			</g:ScrollPanel>
		</g:center>
		<g:south size="72">
			<g:Label />
		</g:south>
	</g:DockLayoutPanel>
</ui:UiBinder> 