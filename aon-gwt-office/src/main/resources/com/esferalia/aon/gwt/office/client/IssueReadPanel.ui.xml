<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
	xmlns:g="urn:import:com.google.gwt.user.client.ui">

	<ui:with type="com.esferalia.aon.gwt.common.client.i18n.AonHubMessages"
		field="msg"></ui:with>
	<ui:with type="com.esferalia.aon.gwt.common.client.css.AonResources"
		field="aonResources"></ui:with>

	<ui:style>
	.scrollpanel-options {
		padding-left: 20%;
	}
	
	.buttons {
		padding-top: 10px;
		text-align: right;
	}
	</ui:style>

	<g:DockLayoutPanel>
		<g:east size="350">
			<g:ScrollPanel>
				<g:VerticalPanel spacing="10" width="100%" height="100%">

					<g:AbsolutePanel width="150px">
						<g:VerticalPanel spacing="10">
							<g:HorizontalPanel>
								<g:Label text="Tipo Incidencia" styleName="{aonResources.css.aonBold}" />
								<g:Button ui:field="typeButton" text="Tipo incidencia"
									styleName="{aonResources.css.aonIconView} {aonResources.css.aonIconCommandButton}" />
							</g:HorizontalPanel>
							<g:Label ui:field="typeLabel"
								styleName="{aonResources.css.tagStyle} {aonResources.css.tagType}" />
						</g:VerticalPanel>
					</g:AbsolutePanel>

					<g:AbsolutePanel width="150px">
						<g:VerticalPanel spacing="10">
							<g:HorizontalPanel>
								<g:Label text="Prioridad" styleName="{aonResources.css.aonBold}" />
								<g:Button ui:field="priorityButton" text="Prioridad"
									styleName="{aonResources.css.aonIconView} {aonResources.css.aonIconCommandButton}" />
							</g:HorizontalPanel>
							<g:Label ui:field="priorityLabel"
								styleName="{aonResources.css.tagStyle} {aonResources.css.tagPriority}" />
						</g:VerticalPanel>
					</g:AbsolutePanel>

					<g:AbsolutePanel width="150px">
						<g:VerticalPanel ui:field="labelsVPanel" spacing="10">
							<g:HorizontalPanel>
								<g:Label text="Etiquetas" styleName="{aonResources.css.aonBold}" />
								<g:Button ui:field="tagButton" text="Etiquetas"
									styleName="{aonResources.css.aonIconView} {aonResources.css.aonIconCommandButton}" />
							</g:HorizontalPanel>
						</g:VerticalPanel>
					</g:AbsolutePanel>

				</g:VerticalPanel>
			</g:ScrollPanel>
		</g:east>
		<g:center>
			<g:ScrollPanel styleName="{style.scrollpanel-options}">
				<g:VerticalPanel spacing="10" height="100%">
					<g:VerticalPanel ui:field="headerVPanel" spacing="10" />
					<g:FlowPanel ui:field="historialVPanel" width="100%"
						height="100%" />
					<g:TextArea visibleLines="5" characterWidth="10"
						styleName="{aonResources.css.textAreaStyle}" ui:field="commentTextArea" />
					<g:Grid width="100%" height="100%">
						<g:row>
							<g:customCell>
								<g:HTMLPanel height="100%" width="100%">
									<div>
										<g:InlineLabel styleName="{aonResources.css.aonBold}"
											text="Usuario: " />
										<g:InlineLabel ui:field="userLogged"
											styleName="{aonResources.css.aonColorGreen}" />
									</div>
								</g:HTMLPanel>
							</g:customCell>
							<g:customCell>
								<g:HTMLPanel height="100%" width="100%">
									<div class="{style.buttons}">
										<g:Button ui:field="closedButton" text="Cerrar" />
										<g:Button ui:field="commentButton" text="Comentar"
											enabled="false" />
									</div>
								</g:HTMLPanel>
							</g:customCell>
						</g:row>
					</g:Grid>
				</g:VerticalPanel>
			</g:ScrollPanel>
		</g:center>
	</g:DockLayoutPanel>

</ui:UiBinder> 