<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
	xmlns:g="urn:import:com.google.gwt.user.client.ui">

	<ui:with type="com.esferalia.aon.gwt.common.client.i18n.AonHubMessages"
		field="msg"></ui:with>
	<ui:with type="com.esferalia.aon.gwt.common.client.css.AonResources"
		field="aonResources"></ui:with>

	<ui:style
		type='com.esferalia.aon.gwt.office.client.IssueReadPanel.GridStyle'>
		.scrollpanel-options {
			padding-left: 20%;
		}
		
		.row-background {
			background-color: #f0f0f4;
		}
		
		.options-text-area {
			width: 600px;
			resize: none;
		}
		
		.buttons {
			padding-top: 10px;
			text-align: right;
		}
		
		.edit-button {
			height: 16px;
			width: 16px;
		}
		
		.title {
			font-size: 20px;
			padding-bottom: 10px;
			padding-top: 10px;
			color: #aaa;
		}
		</ui:style>

	<g:ScrollPanel styleName="{style.scrollpanel-options}">
		<g:VerticalPanel height="100%">
			<g:Grid styleName="aon-panelGrid-formatting" cellSpacing="10"
				height="100%">
				<g:row>
					<g:customCell styleName="{aonResources.css.aonPanelGridOdd}">
						<g:Label styleName="aon-outputLabel" text="Remitente" />
					</g:customCell>
					<g:customCell styleName="{aonResources.css.aonPanelGridEven}">
						<g:Label ui:field="companyLabel" />
					</g:customCell>
				</g:row>
				<g:row>
					<g:customCell styleName="{aonResources.css.aonPanelGridOdd}">
						<g:Label styleName="aon-outputLabel" text="Tipo Aviso" />
					</g:customCell>
					<g:customCell styleName="{aonResources.css.aonPanelGridEven}">
						<g:Label ui:field="typeLabel" />
					</g:customCell>
				</g:row>
				<g:row>
					<g:customCell styleName="{aonResources.css.aonPanelGridOdd}">
						<g:Label styleName="aon-outputLabel" text="Prioridad" />
					</g:customCell>
					<g:customCell styleName="{aonResources.css.aonPanelGridEven}">
						<g:Label ui:field="priorityLabel" />
					</g:customCell>
				</g:row>
				<g:row>
					<g:customCell styleName="{aonResources.css.aonPanelGridOdd}">
						<g:Label styleName="aon-outputLabel" text="{msg.labelsIssues}" />
					</g:customCell>
					<g:customCell styleName="{aonResources.css.aonPanelGridEven}">
						<g:HorizontalPanel ui:field="labelsHPanel"
							spacing="5" />	
					</g:customCell>
				</g:row>
			</g:Grid>
			<g:VerticalPanel spacing="10" width="100%" height="100%">
				<g:Label styleName="{aonResources.css.aonBold} 
		{style.title}"
					ui:field="titleLabel" />
				<g:FlowPanel ui:field="historialVPanel" width="100%"
					height="100%" />
				<g:TextArea visibleLines="5" characterWidth="10"
					styleName="{style.options-text-area}" ui:field="commentTextArea" />
				<g:Grid width="100%" height="100%">
					<g:row>
						<g:customCell>
							<g:HTMLPanel height="100%" width="100%">
								<div>
									<g:InlineLabel styleName="{aonResources.css.aonBold}"
										text="Usuario: " />
									<g:InlineLabel ui:field="userLogged"
										styleName="{aonResources.css.aonColorGreen}" />
								</div>
							</g:HTMLPanel>
						</g:customCell>
						<g:customCell>
							<g:HTMLPanel height="100%" width="100%">
								<div class="{style.buttons}">
									<g:Button ui:field="closedButton" text="Cerrar" />
									<g:Button ui:field="commentButton" text="Comentar" enabled="false" />
								</div>
							</g:HTMLPanel>
						</g:customCell>
					</g:row>
				</g:Grid>
			</g:VerticalPanel>
		</g:VerticalPanel>
	</g:ScrollPanel>

</ui:UiBinder> 