<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
	xmlns:g="urn:import:com.google.gwt.user.client.ui">

	<ui:with type="com.esferalia.aon.gwt.common.client.i18n.AonHubMessages"
		field="msg"></ui:with>
	<ui:with type="com.esferalia.aon.gwt.common.client.css.AonResources"
		field="aonResources"></ui:with>

	<ui:style
		type='com.esferalia.aon.gwt.office.client.IssueReadPanel.GridStyle'>
		.form {
			padding: 10px;
		}
		
		.options-scroll-panel {
			height: 99%;
		}
		
		.row-background {
			background-color: #d1d1e0;
		}
		
		.options-text-area {
			width: 600px;
			resize: none;
		}
		
		.buttons {
			padding-top: 10px;
			text-align: right;
		}
		</ui:style>



	<g:HTMLPanel
		styleName="{aonResources.css.aonWidthAll} {aonResources.css.aonHeightAll} 
		{aonResources.css.aonGroup} {aonResources.css.aonGroupBody}">

		<table
			class="{aonResources.css.aonWidthAll} {style.form} 
		aon-panelGrid-formatting"
			cellspacing="10" cellpadding="0">

			<tr>
				<td class="{aonResources.css.aonPanelGridOdd}">
					<g:Label styleName="aon-outputLabel" text="Remitente" />
				</td>
				<td class="{aonResources.css.aonPanelGridEven}">
					<g:Label ui:field="companyLabel" />
				</td>
			</tr>

			<tr>
				<td class="{aonResources.css.aonPanelGridOdd}">
					<g:Label styleName="aon-outputLabel" text="Prioridad" />
				</td>
				<td class="{aonResources.css.aonPanelGridEven}">
					<g:Label ui:field="priorityLabel" />
				</td>
			</tr>

			<tr>
				<td class="{aonResources.css.aonPanelGridOdd}">
					<g:Label styleName="aon-outputLabel" text="{msg.labelsIssues}" />
				</td>
				<td class="{aonResources.css.aonPanelGridEven}">
					<g:HorizontalPanel ui:field="labelsHPanel" spacing="3"/>
				</td>
			</tr>
			<tr>
				<td colspan="2">
					<g:Label styleName="{aonResources.css.aonBold}" ui:field="titleLabel" />
				</td>
			</tr>
			<tr>
				<td colspan="2">
					<g:VerticalPanel ui:field="historialVPanel" />
				</td>
			</tr>
			<tr>
				<td>
				<g:InlineLabel styleName="{aonResources.css.aonBold}" text="Usuario: " />
					<g:InlineLabel ui:field="userLogged" styleName="{aonResources.css.aonColorGreen}"/>
				</td>
				<td>
					<div class="{style.buttons}">
						<g:Button ui:field="closedButton" text="Cerrar" />
						<g:Button ui:field="commentButton" text="Comentar"
							enabled="false" />
					</div>

				</td>
			</tr>
		</table>
	</g:HTMLPanel>

</ui:UiBinder> 