<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
	xmlns:g="urn:import:com.google.gwt.user.client.ui">

	<ui:with type="com.esferalia.aon.gwt.common.client.i18n.AonHubMessages"
		field="msg"></ui:with>
	<ui:with type="com.esferalia.aon.gwt.common.client.css.AonResources"
		field="aonResources"></ui:with>

	<ui:style>
	.form {
		padding: 10px;
	}
	
	.buttons {
		padding-top: 10px;
		text-align: right;
	}
	</ui:style>

	<g:HTMLPanel styleName="{style.form}">
		<g:Grid width="100%">
			<g:row>
				<g:customCell>
					<g:InlineLabel
						styleName="{aonResources.css.aonBold}
					{aonResources.css.aonIconTitle} {aonResources.css.aonIconCommandButton}"
						text="{msg.title}" />
				</g:customCell>
				<g:customCell>
					<g:TextBox ui:field="titleTextBox" styleName="{aonResources.css.aonInputText}"
						width="300px" />
				</g:customCell>
			</g:row>
			<g:row>
				<g:customCell>
					<g:InlineLabel
						styleName="{aonResources.css.aonBold}
					{aonResources.css.aonIconSearch} {aonResources.css.aonIconCommandButton}"
						text="Estado" />
				</g:customCell>
				<g:customCell>
					<g:HorizontalPanel ui:field="statusHPanel"
						spacing="5">
						<g:Label ui:field="newStatusButton"
							styleName="{aonResources.css.aonIconReset}
						{aonResources.css.aonIconCommandButton}" />
					</g:HorizontalPanel>
				</g:customCell>
			</g:row>

			<g:row>
				<g:customCell>
					<g:InlineLabel
						styleName="{aonResources.css.aonBold}
					{aonResources.css.aonIconJournal} {aonResources.css.aonIconCommandButton}"
						text="{msg.priority}" />
				</g:customCell>
				<g:customCell>
					<g:HorizontalPanel ui:field="priorityHPanel"
						spacing="5">
						<g:Label ui:field="newPriorityButton"
							styleName="{aonResources.css.aonIconReset}
						{aonResources.css.aonIconCommandButton}" />
					</g:HorizontalPanel>
				</g:customCell>
			</g:row>

			<g:row>
				<g:customCell>
					<g:InlineLabel
						styleName="{aonResources.css.aonBold}
					{aonResources.css.aonIconEmployee} {aonResources.css.aonIconCommandButton}"
						text="{msg.sender}" />
				</g:customCell>
				<g:customCell>
					<g:SuggestBox ui:field="registrySuggest"
						styleName="{aonResources.css.aonInputText}" width="300px" />
				</g:customCell>
			</g:row>

			<g:row>
				<g:customCell>
					<g:InlineLabel
						styleName="{aonResources.css.aonBold}
					{aonResources.css.aonIconLock} {aonResources.css.aonIconCommandButton}"
						text="Tipo aviso" />
				</g:customCell>
				<g:customCell>
					<g:HorizontalPanel ui:field="typeHPanel" spacing="5">
						<g:Label ui:field="newTypeButton"
							styleName="{aonResources.css.aonIconReset}
						{aonResources.css.aonIconCommandButton}" />
					</g:HorizontalPanel>
				</g:customCell>
			</g:row>
			<g:row>
				<g:customCell>
					<g:InlineLabel
						styleName="{aonResources.css.aonBold}
					{aonResources.css.aonIconTitle} {aonResources.css.aonIconCommandButton}"
						text="Etiquetas" />
				</g:customCell>
				<g:customCell>
					<g:HorizontalPanel ui:field="labelsHPanel"
						spacing="5">
						<g:Label ui:field="newLabelButton"
							styleName="{aonResources.css.aonIconReset}
						{aonResources.css.aonIconCommandButton}" />
					</g:HorizontalPanel>
				</g:customCell>

			</g:row>

		</g:Grid>

		<div>
			<g:TextArea ui:field="commentTextArea" characterWidth="10"
				visibleLines="9" width="98%" height="99%" />
		</div>

		<div class="{style.buttons}">
			<g:Button ui:field="cancelButton" text="Cancelar" />
			<g:Button ui:field="acceptButton" text="Aceptar" />
		</div>

	</g:HTMLPanel>
</ui:UiBinder> 