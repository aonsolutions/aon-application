<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
	xmlns:g="urn:import:com.google.gwt.user.client.ui">

	<ui:with type="com.esferalia.aon.gwt.common.client.i18n.AonHubMessages"
		field="msg"></ui:with>
	<ui:with type="com.esferalia.aon.gwt.common.client.css.AonResources"
		field="aonResources"></ui:with>

	<ui:style>
	.options-scroll-panel {
		height: 99%;
	}
	
	.options-text-area {
		height: 200px;
		resize: none;
	}
	
	.form {
		padding: 10px;
	}
	
	.buttons {
		padding-top: 10px;
		text-align: right;
	}
	</ui:style>

	<g:ScrollPanel
		styleName="{aonResources.css.aonScrollArea} {style.options-scroll-panel}">
		<g:HTMLPanel>
			<table class="{aonResources.css.aonPanelGrid}" style="height:90%">

				<tr>
					<td class="{aonResources.css.aonPanelGridOdd}">
						<g:InlineLabel styleName="{aonResources.css.aonBold}"
							text="{msg.date}" />
					</td>
					<td>
						<g:InlineLabel styleName="{aonResources.css.aonBold}"
							text="{msg.aonHubDateFormat}" ui:field="dateLabel" />
					</td>
					<td>
						<g:InlineLabel ui:field="statusLabel" />
					</td>
				</tr>

				<tr>
					<td class="{aonResources.css.aonPanelGridOdd}">
						<g:InlineLabel styleName="{aonResources.css.aonBold}"
							text="{msg.sender}" />
					</td>
					<td class="{aonResources.css.aonPanelGridEven}">
						<g:SuggestBox styleName="{aonResources.css.aonInputText}"
							width="500px" enabled="false" ui:field="rmediaSuggest" />

					</td>
					<td>
						<g:InlineLabel
							styleName="{aonResources.css.aonIconReset} {aonResources.css.aonIconCommandButton}" />
					</td>
				</tr>

				<tr>
					<td>
					</td>
					<td>
						<table>
							<tr>
								<td class="{aonResources.css.aonPanelGridOdd}">
									<g:InlineLabel text="{msg.company}" />
								</td>
								<td class="{aonResources.css.aonPanelGridEven}">
									<g:SuggestBox styleName="{aonResources.css.aonInputText}"
										width="300px" enabled="false" ui:field="registrySuggest" />
								</td>
							</tr>
						</table>
					</td>
					<td>
						<g:InlineLabel
							styleName="{aonResources.css.aonIconReset} {aonResources.css.aonIconCommandButton}" />
					</td>
				</tr>

				<tr>
					<td class="{aonResources.css.aonPanelGridOdd}">
						<g:InlineLabel text="{msg.title}" styleName="aon-outputLabel aon-input-required" />
					</td>
					<td class="{aonResources.css.aonPanelGridEven}">
						<g:TextBox ui:field="titleTextBox" styleName="{aonResources.css.aonInputText}"
							width="100%" />
					</td>
					<td>
					</td>
				</tr>
				<tr>
					<td colspan="2">
						<g:InlineLabel styleName="{aonResources.css.aonBold}"
							text="{msg.userSender}" />
						<g:InlineLabel ui:field="loggedLabel"
							styleName="{aonResources.css.aonColorGreen}" />

					</td>
					<td>
						<div class="{style.buttons}">
							<g:Button ui:field="cancelButton" text="{msg.cancel}" />
							<g:Button ui:field="acceptButton" text="{msg.accept}" enabled="false" />
						</div>

					</td>

				</tr>

			</table>
		</g:HTMLPanel>

	</g:ScrollPanel>

</ui:UiBinder> 