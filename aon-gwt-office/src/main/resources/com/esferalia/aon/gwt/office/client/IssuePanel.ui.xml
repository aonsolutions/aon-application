<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
	xmlns:g="urn:import:com.google.gwt.user.client.ui">

	<ui:with type="com.esferalia.aon.gwt.common.client.i18n.AonHubMessages"
		field="msg"></ui:with>
	<ui:with type="com.esferalia.aon.gwt.common.client.css.AonResources"
		field="aonResources"></ui:with>

	<ui:style>
	.options-scroll-panel {
		height: 99%;
	}
	
	.options-text-area {
		width: 600px;
		height: 200px;
	}
	
	.form {
		padding: 10px;
	}
	
	.buttons {
		padding-top: 10px;
		text-align: right;
	}
	</ui:style>

	<g:ScrollPanel
		styleName="{aonResources.css.aonScrollArea} {style.options-scroll-panel}">
		<g:HTMLPanel>
			<table class="{aonResources.css.aonPanelGrid}" style="height:90%">

				<tr>
					<td class="{aonResources.css.aonPanelGridOdd}">
						<g:InlineLabel styleName="{aonResources.css.aonBold}"
							text="Fecha" />
					</td>
					<td>
						<g:InlineLabel styleName="{aonResources.css.aonBold}"
							text="dd/mm/AAAA - HH:MM" ui:field="dateLabel" />
					</td>
					<td>
						<g:InlineLabel styleName="{aonResources.css.aonBold}"
							text="Estado: OPEN" />
					</td>
				</tr>

				<tr>
					<td class="{aonResources.css.aonPanelGridOdd}">
						<g:InlineLabel styleName="{aonResources.css.aonBold}"
							text="Remitente" />
					</td>
					<td class="{aonResources.css.aonPanelGridEven}">
						<g:SuggestBox styleName="{aonResources.css.aonInputText}"
							width="100%" enabled="false" ui:field="registrySuggest" />
					</td>
					<td>
						<g:InlineLabel
							styleName="{aonResources.css.aonIconReset} {aonResources.css.aonIconCommandButton}" />
					</td>
				</tr>

				<tr>
					<td>
					</td>
					<td>
						<table>
							<tr>
								<td class="{aonResources.css.aonPanelGridOdd}">
									<g:InlineLabel text="Contacto" />
								</td>
								<td class="{aonResources.css.aonPanelGridEven}">
									<g:SuggestBox styleName="{aonResources.css.aonInputText}"
										width="300px" enabled="false" />
								</td>
							</tr>
						</table>
					</td>
					<td>
						<g:InlineLabel
							styleName="{aonResources.css.aonIconReset} {aonResources.css.aonIconCommandButton}" />
					</td>
				</tr>

				<tr>
					<td class="{aonResources.css.aonPanelGridOdd}">
						<g:InlineLabel text="{msg.title}" />
					</td>
					<td class="{aonResources.css.aonPanelGridEven}">
						<g:TextBox ui:field="titleTextBox" styleName="{aonResources.css.aonInputText}"
							width="100%" />
					</td>
					<td>
					</td>
				</tr>

				<tr>
					<td class="{aonResources.css.aonPanelGridOdd}">
						<g:InlineLabel styleName="{aonResources.css.aonBold}"
							text="{msg.priority}" />
					</td>
					<td class="{aonResources.css.aonPanelGridEven}">
						<g:HorizontalPanel ui:field="priorityHPanel">
						</g:HorizontalPanel>
					</td>
				</tr>

				<tr>
					<td class="{aonResources.css.aonPanelGridOdd}">
						<g:InlineLabel styleName="{aonResources.css.aonBold}"
							text="Tipo de aviso" />
					</td>
					<td class="{aonResources.css.aonPanelGridEven}">
						<g:HorizontalPanel ui:field="typeHPanel">
						</g:HorizontalPanel>
					</td>
				</tr>


				<tr>
					<td class="{aonResources.css.aonPanelGridOdd}">
						<g:InlineLabel styleName="{aonResources.css.aonBold}"
							text="Etiquetas" />

					</td>
					<td class="{aonResources.css.aonPanelGridEven}">
						<g:VerticalPanel ui:field="vPanelTagsContainer" />					
					</td>
				</tr>

				<tr>
					<td colspan="3" class="{aonResources.css.aonPanelGridEven}">
						<g:TextArea ui:field="commentTextArea" characterWidth="10"
							visibleLines="9" styleName="{style.options-text-area}" />
					</td>
				</tr>

				<tr>
					<td colspan="2">
						<g:InlineLabel ui:field="loggedLabel" />
					</td>
					<td>
						<div class="{style.buttons}">
							<g:Button ui:field="cancelButton" text="Cancelar" />
							<g:Button ui:field="acceptButton" text="Aceptar" />
						</div>

					</td>

				</tr>
			</table>
		</g:HTMLPanel>

	</g:ScrollPanel>

</ui:UiBinder> 