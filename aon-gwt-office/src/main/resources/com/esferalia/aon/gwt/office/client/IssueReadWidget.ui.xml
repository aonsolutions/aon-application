<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
	xmlns:g="urn:import:com.google.gwt.user.client.ui" xmlns:o="urn:import:com.esferalia.aon.gwt.office.client">

	<ui:style type='com.esferalia.aon.gwt.office.client.IssueReadWidget.MyStyle'>
	.issue-panel {
		border-top: 2px solid #f3f3f3;
		padding-bottom: 10px;
	}
	
	.issue-header {
		background-color: #dfdfc5;
		padding-bottom: 14px;
		padding-left: 14px;
		padding-top: 14px;
	}
	
	.issue-header-subtitle {
		color: #767676;
	}
	
	.issue-body {
		resize: none;
		border: none;
		background: transparent;
		color: none;
	}
	
	.row-even {
		margin-left: 150px;
	}
	</ui:style>
	<g:FlowPanel ui:field="issuePanel" styleName="{style.issue-panel}"
		width="80%">
		<g:FlexTable ui:field="flexTable" />
	</g:FlowPanel>
</ui:UiBinder> 