<?xml version="1.0"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
  <parent>
    <groupId>com.code.aon</groupId>
    <artifactId>aon.parent</artifactId>
    <version>6.2.0-SNAPSHOT</version>
  </parent>
  <modelVersion>4.0.0</modelVersion>
  <groupId>com.esferalia.aon</groupId>
  <artifactId>aon.sql.payroll</artifactId>
  <version>6.2.0-SNAPSHOT</version>
  <description>AON SQL PAYROLL</description>
  <name>AON SQL PAYROLL</name>
  <build>
    <plugins>
      <plugin>
        <groupId>com.esferalia.aon</groupId>
        <artifactId>aon-maven-plugin</artifactId>
        <executions>
        	<execution>
        		<goals>
        			<goal>generate-db</goal>
        		</goals>
        	</execution>
        </executions>
	<configuration>
		<targetPackage>com.esferalia.aon.payroll.sql</targetPackage>
		<dbtables>deduction_concept,payment_concept,system.*,contract.*,salary.*</dbtables>
	</configuration>
      </plugin>
    </plugins>
  </build>
</project>
