<?xml version="1.0"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
	<parent>
		<groupId>com.code.aon</groupId>
		<artifactId>aon.parent</artifactId>
		<version>8.3-SNAPSHOT</version>
	</parent>
	<modelVersion>4.0.0</modelVersion>
	<groupId>com.esferalia.aon</groupId>
	<artifactId>aon.sql.payroll</artifactId>
	<description>AON SQL PAYROLL</description>
	<name>AON SQL PAYROLL</name>
	<build>
		<plugins>
			<plugin>
				<groupId>com.esferalia.aon</groupId>
				<artifactId>aon-maven-plugin</artifactId>
				<version>${project.version}</version>
				<executions>
					<execution>
						<goals>
							<goal>generate-db</goal>
						</goals>
					</execution>
				</executions>
				<configuration>
					<targetPackage>com.esferalia.aon.payroll.sql</targetPackage>
					<dbtables>domain,registry,person,raddress,rattach,category,enterprise.*,customer,workplace.*,agreement.*,calendar.*,deduction_concept,payment_concept,bonus_concept,system.*,contract.*,salary.*,cnae2009.*,payroll.*,user.*,irpf.*,geozone_irpf.*,app_param,fs_model190,fs_model190_detail,fs_model180,fs_model180_detail,company,geozone,invoice,invoice_detail,invoice_tax,fs_vat,fs_vat_detail,fs_vat_declaration,fs_model390</dbtables>
				</configuration>
			</plugin>
		</plugins>
	</build>
</project>




