<?xml version="1.0" encoding="ISO-8859-1"?>

<!DOCTYPE report-config 
	PUBLIC "-//CODE-AON//DTD Report Config//EN" 
	"http://co-de.com/aon/report-config.dtd">

<report-config>
	<default-config>
		<fetch-mode paginated="false" />
	</default-config>

	<!--  *********  CustomerList  ********* -->
	<report id="customerList" description="Customers List">
		<template path="/com/code/aon/ui/customer/report/customer.jasper"/>
		<bean key="com.code.aon.customer.Customer" />
		<criteria provider="#{customer}"/>
		<params>
			<param id="REPORT_RESOURCE_BUNDLE" value="com.code.aon.ui.customer.i18n.messages" />
			<param id="company" value="#{company.obtainCompany}" />
			<param id="logoImageFile" value="#{company.getAttachAsInputStream}" />
		</params>
	</report>

	<!--  *********  InvoiceList  ********* -->
	<report id="salesInvoiceList" description="Sales Invoice's List">
		<template path="/com/code/aon/ui/finance/report/salesInvoiceList.jasper"/>
		<bean key="com.code.aon.finance.Invoice" />
		<criteria provider="#{feeInvoicing}"/>
		<!-- 
		<fetch-mode paginated="true" page-count="500" virtualizer-max-size="50"/>
		 -->
		<params>
			<param id="REPORT_RESOURCE_BUNDLE" value="com.code.aon.ui.finance.i18n.messages" />
			<param id="company" value="#{company.obtainCompany}" />
			<param id="PriceStrategy" value="#{feeInvoicing.getPriceStrategy}" />
			<param id="logoImageFile" value="#{company.getAttachAsInputStream}" />
			<param id="customer" value="#{feeInvoicing.getCustomer}" />
		</params>
	</report>

	<report id="invoiceList" description="Purchase Invoice's List">
		<template path="/com/code/aon/ui/finance/report/invoiceList.jasper"/>
		<bean key="com.code.aon.finance.Invoice" />
		<criteria provider="#{purchaseDirectInvoicing}"/>

		<params>
			<param id="REPORT_RESOURCE_BUNDLE" value="com.code.aon.ui.finance.i18n.messages" />
			<param id="company" value="#{company.obtainCompany}" />
			<param id="PriceStrategy" value="#{purchaseDirectInvoicing.getPriceStrategy}" />
			<param id="logoImageFile" value="#{company.getAttachAsInputStream}" />
		</params>
	</report>

	<!--  *********  Sale Invoice Print  ********* -->
	<report id="saleInvoice" description="Fee Invoice's Report">
		<template path="/com/code/aon/ui/finance/report/feeInvoicing.jasper"/>
		<collection provider="#{saleInvoice}" forceRefresh="true"/>

		<params>
			<param id="REPORT_RESOURCE_BUNDLE" value="com.code.aon.ui.finance.i18n.report" />
			<param id="company" value="#{company.obtainCompany}" />
			<param id="PriceStrategy" value="#{saleInvoice.getPriceStrategy}" />
			<param id="logoImageFile" value="#{company.getAttachAsInputStream}" />
			<param id="recordData" value="#{company.getCompanyRecordData}" />
			<param id="phone" value="#{company.obtainPhone}" />
			<param id="fax" value="#{company.obtainFax}" />
			<param id="address" value="#{company.obtainAddress}" />
			<param id="printHeader" value="#{company.isPrintHeader}" />
			<param id="printRecordData" value="#{company.isPrintRecordData}" />
		</params>
		
		<nested-report report="invoiceDetail"/>
		<nested-report report="invoiceTaxBreakDown"/>
		<nested-report report="invoiceFinances"/>
	</report>

	<report id="invoiceDetail" description="feeInvoicing Details">
		<template path="/com/code/aon/ui/finance/report/feeInvoicingDetail.jasper"/>
	</report>

	<report id="invoiceTaxBreakDown" description="taxBreakDown">
		<template path="/com/code/aon/ui/finance/report/taxBreakDown.jasper"/>
	</report>

	<report id="invoiceFinances" description="feeInvoicing Finances">
		<template path="/com/code/aon/ui/finance/report/feeInvoicingFinances.jasper"/>
	</report>

	<!--  *********  InvoicePrint  ********* -->
	<report id="invoicePrint" description="Invoice's Report">
		<template path="/com/code/aon/ui/finance/report/feeInvoicing.jasper"/>
		<collection provider="#{invoicePrint}"/>

		<params>
			<param id="REPORT_RESOURCE_BUNDLE" value="com.code.aon.ui.finance.i18n.messages" />
			<param id="company" value="#{company.obtainCompany}" />
			<param id="PriceStrategy" value="#{feeInvoicing.getPriceStrategy}" />
			<param id="logoImageFile" value="#{company.getAttachAsInputStream}" />
			<param id="recordData" value="#{company.getCompanyRecordData}" />
			<param id="phone" value="#{company.obtainPhone}" />
			<param id="fax" value="#{company.obtainFax}" />
			<param id="address" value="#{company.obtainAddress}" />
			<param id="printHeader" value="#{company.isPrintHeader}" />
			<param id="printRecordData" value="#{company.isPrintRecordData}" />
		</params>
		
		<nested-report report="invoiceDetail"/>
		<nested-report report="invoiceTaxBreakDown"/>
		<nested-report report="invoiceFinances"/>
	</report>

	<!--  *********  Receipt  ********* -->
	<report id="receipt" description="Receipt's Report">
		<template path="/com/code/aon/ui/finance/report/receipt.jasper"/>
		<collection provider="#{invoicePrint}"/>

		<params>
			<param id="REPORT_RESOURCE_BUNDLE" value="com.code.aon.ui.finance.i18n.messages" />
			<param id="company" value="#{company.obtainCompany}" />
			<param id="PriceStrategy" value="#{feeInvoicing.getPriceStrategy}" />
			<param id="logoImageFile" value="#{company.getAttachAsInputStream}" />
		</params>
		
		<nested-report report="invoiceDetail"/>
	</report>

	<!--  *********  FinanceList  ********* -->
	<report id="financeList" description="Finance List">
		<template path="/com/code/aon/ui/finance/report/financeList.jasper" />
		<bean key="com.code.aon.finance.Finance" />
		<criteria provider="#{finance}"/>
		<params>
			<param id="REPORT_RESOURCE_BUNDLE" value="com.code.aon.ui.finance.i18n.report" />
			<param id="logoImageFile" value="#{company.getAttachAsInputStream}" />
			<param id="company" value="#{company.obtainCompany}" />
			<param id="payment" value="#{financeSearch.getPayment}" />
		</params>
	</report>

	<!--  *********  FinanceBatchList  ********* -->
	<report id="fBatchList" description="Finance Batch List">
		<template path="/com/code/aon/ui/finance/report/fBatchList.jasper" />
		<collection provider="#{fBatchPrinter}" />
		<params>
			<param id="REPORT_RESOURCE_BUNDLE" value="com.code.aon.ui.finance.i18n.report" />
			<param id="logoImageFile" value="#{company.getAttachAsInputStream}" />
			<param id="company" value="#{company.obtainCompany}" />
		</params>
	</report>

	<!--  *********  FinanceBatch  ********* -->
	<report id="fBatch" description="Finance Batches' Report">
		<template path="/com/code/aon/ui/finance/report/fBatch.jasper"/>
		<collection provider="#{fbatch}"/>

		<params>
			<param id="REPORT_RESOURCE_BUNDLE" value="com.code.aon.ui.finance.i18n.report" />
			<param id="company" value="#{company.obtainCompany}" />
			<param id="logoImageFile" value="#{company.getAttachAsInputStream}" />
			<param id="total" value="#{fbatch.getToTotalAmount}" />
			<param id="totalRegs" value="#{fbatch.getToTotalDetails}" />
		</params>
		
		<nested-report report="fBatchDetail"/>
	</report>
	
	<report id="fBatchDetail" description="Finance Batch Details">
		<template path="/com/code/aon/ui/finance/report/fBatchDetail.jasper"/>
	</report>

	<!--  *********  feeCheckingPrint  ********* -->
	<report id="customeFeeChecking" description="Fee Checking">
		<template path="/com/code/aon/ui/finance/report/feeChecking.jasper"/>
		<collection provider="#{feeCheckingPrinter}"/>

		<params>
			<param id="REPORT_RESOURCE_BUNDLE" value="com.code.aon.ui.finance.i18n.report" />
			<param id="company" value="#{company.obtainCompany}" />
			<param id="logoImageFile" value="#{company.getAttachAsInputStream}" />
		</params>
		
		<nested-report report="feeCheckingDetail"/>
	</report>
	
	<report id="feeCheckingDetail" description="feeCheckingDetail">
		<template path="/com/code/aon/ui/finance/report/feeCheckingDetail.jasper"/>
	</report>

	<!--  *********  financeCheckingPrint  ********* -->
	<report id="financeChecking" description="Finance Checking">
		<template path="/com/code/aon/ui/finance/report/financeChecking.jasper"/>
		<collection provider="#{financeCheckingPrinter}"/>

		<params>
			<param id="REPORT_RESOURCE_BUNDLE" value="com.code.aon.ui.finance.i18n.report" />
			<param id="company" value="#{company.obtainCompany}" />
			<param id="logoImageFile" value="#{company.getAttachAsInputStream}" />
		</params>
		
		<nested-report report="financeCheckingDetail"/>
	</report>
	
	<report id="financeCheckingDetail" description="financeCheckingDetail">
		<template path="/com/code/aon/ui/finance/report/financeCheckingDetail.jasper"/>
	</report>

	<!--  **********************************************************
						      PRODUCT
		  ********************************************************** -->
	<report id="item" description="Items report">
		<template path="/com/code/aon/ui/product/report/item.jasper" />
		<bean key="com.code.aon.product.Item" />
		<criteria provider="#{item}" />
		<params>
			<param id="REPORT_RESOURCE_BUNDLE" value="com.code.aon.ui.product.i18n.messages" />
			<param id="logoImageFile" value="#{company.getAttachAsInputStream}" />
			<param id="company" value="#{company.obtainCompany}" />
		</params>
	</report>
	
	<!--  **********************************************************
						      ACCOUNTING
		  ********************************************************** -->
	<!--  BALANCE DE PERDIDAS Y GANACIAS -->
	<report id="profitAndLoss" description="ProfitAndLoss">
		<template path="/com/code/aon/ui/accounting/report/profitAndLoss.jasper"/>
		<collection provider="#{profitAndLossReport}"/>
		<params>
			<param id="REPORT_RESOURCE_BUNDLE" value="com.code.aon.ui.accounting.i18n.report" />
			<param id="company" value="#{company.obtainCompany}" />
			<param id="params" value="#{profitAndLossReport.getParameters}" />
			<param id="reportTitle" value="#{profitAndLossReport.getReportTitle}" />
		</params>
	</report>

	<!--  BALANCE MESUAL DE PERDIDAS Y GANACIAS -->
	<report id="profitAndLossMonthly" description="ProfitAndLossMonthly">
		<template path="/com/code/aon/ui/accounting/report/profitAndLossMonthly.jasper"/>
		<collection provider="#{profitAndLossMonthly}"/>
		<params>
			<param id="REPORT_RESOURCE_BUNDLE" value="com.code.aon.ui.accounting.i18n.report" />
			<param id="company" value="#{company.obtainCompany}" />
			<param id="params" value="#{profitAndLossReport.getParameters}" />
		</params>
	</report>

	<!--  BALANCE DE PERDIDAS Y GANACIAS PRESUPUESTADO -->
	<report id="budgetedProfitAndLoss" description="BudgetedProfitAndLoss">
		<template path="/com/code/aon/ui/accounting/report/profitAndLoss.jasper"/>
		<collection provider="#{budgetedProfitAndLossReport}"/>
		<params>
			<param id="REPORT_RESOURCE_BUNDLE" value="com.code.aon.ui.accounting.i18n.report" />
			<param id="company" value="#{company.obtainCompany}" />
			<param id="params" value="#{budgetedProfitAndLossReport.getParameters}" />
			<param id="reportTitle" value="#{budgetedProfitAndLossReport.getReportTitle}" />
		</params>
	</report>

	<!--  EXTRACTO DE CUENTA -->
	<report id="statement" description="Account Statement">
		<template path="/com/code/aon/ui/accounting/report/statement.jasper"/>
		<collection provider="#{statement}"/>
		<params>
			<param id="REPORT_RESOURCE_BUNDLE" value="com.code.aon.ui.accounting.i18n.report" />
			<param id="company" value="#{company.obtainCompany}" />
			<param id="openingEntry" value="#{statement.getOpeningEntry}" />
			<param id="fromOpeningEntry" value="#{statement.getFromOpeningEntry}" />
			<param id="periodBalance" value="#{statement.getPeriodBalance}" />
			<param id="params" value="#{trialBalance.getParameters}" />
		</params>
	</report>

	<!--  BALANCE DE SUMAS Y SALDOS -->
	<report id="trialBalance" description="trialBalance">
		<template path="/com/code/aon/ui/accounting/report/trialBalance.jasper"/>
		<collection provider="#{trialBalance}"/>
		<params>
			<param id="REPORT_RESOURCE_BUNDLE" value="com.code.aon.ui.accounting.i18n.report" />
			<param id="company" value="#{company.obtainCompany}" />
			<param id="summaryCollection" value="#{trialBalance.getSummaryCollection}" />
			<param id="params" value="#{trialBalance.getParameters}" />
		</params>
	</report>

	<!--  LISTADO DIARIO DE APUNTES -->
	<report id="journalBook" description="Listado Diario de Apuntes">
		<template path="/com/code/aon/ui/accounting/report/journalBook.jasper"/>
		<bean key="com.code.aon.account.AccountEntryDetail" />
		<criteria provider="#{journalReport}"/>
		<fetch-mode paginated="true" page-count="5000" virtualizer-max-size="1000" />
		<params>
			<param id="REPORT_RESOURCE_BUNDLE" value="com.code.aon.ui.accounting.i18n.report" />
			<param id="company" value="#{company.obtainCompany}" />
			<param id="fromDate" value="#{journalReport.getFromDate}" />
			<param id="toDate" value="#{journalReport.getToDate}" />
			<param id="date" value="#{journalReport.getDate}" />
			<param id="period" value="#{journalReport.getPeriod}" />
		</params>
	</report>
	
	<!--  LISTADO DEL LIBRO DE IVA -->
	<report id="vatBook" description="Listado del Libro de IVA">
		<template path="/com/code/aon/ui/finance/report/vatBook.jasper"/>
		<collection provider="#{vatReport}"/>
		<params>
			<param id="REPORT_RESOURCE_BUNDLE" value="com.code.aon.ui.finance.i18n.report" />
			<param id="company" value="#{company.obtainCompany}" />
			<param id="fromDate" value="#{vatReport.getFromDate}" />
			<param id="toDate" value="#{vatReport.getToDate}" />
			<param id="date" value="#{vatReport.getDate}" />
			<param id="title" value="#{vatReport.getTitle}" />
		</params>
	</report>

	<!--  LISTADO DEL LIBRO DE IVA -->
	<report id="vatSummaryBook" description="Listado Resumen del Libro de IVA">
		<template path="/com/code/aon/ui/finance/report/vatBookSummary.jasper"/>
		<collection provider="#{vatReport}"/>
		<params>
			<param id="REPORT_RESOURCE_BUNDLE" value="com.code.aon.ui.finance.i18n.report" />
			<param id="company" value="#{company.obtainCompany}" />
			<param id="fromDate" value="#{vatReport.getFromDate}" />
			<param id="toDate" value="#{vatReport.getToDate}" />
			<param id="date" value="#{vatReport.getDate}" />
			<param id="title" value="#{vatReport.getTitle}" />
			<param id="months" value="#{vatReport.getMonths}" />
		</params>
	</report>
	
	<!--  **********************************************************
						INVENTORY 
		  ********************************************************** -->

	<report id="inventory" description="Inventory Report">
		<template path="/com/code/aon/ui/warehouse/report/inventory.jasper" />
		<bean key="com.code.aon.warehouse.Inventory" />
		<criteria provider="#{inventory}" />
		<params>
			<param id="REPORT_RESOURCE_BUNDLE" value="com.code.aon.ui.warehouse.i18n.report" />
			<param id="logoImageFile" value="#{company.getAttachAsInputStream}" />
			<param id="company" value="#{company.obtainCompany}" />
		</params>
	</report>
	
	<report id="inventory_close" description="Inventory Count report">
		<template path="/com/code/aon/ui/warehouse/report/count.jasper" />
		<collection provider="#{inventoryDetail}" />
		<params>
			<param id="REPORT_RESOURCE_BUNDLE" value="com.code.aon.ui.warehouse.i18n.report" />
			<param id="logoImageFile" value="#{company.getAttachAsInputStream}" />
			<param id="company" value="#{company.obtainCompany}" />
		</params>
	</report>
	
	<report id="inventory_valued" description="Valued Inventory report">
		<template path="/com/code/aon/ui/warehouse/report/valued.jasper" />
		<collection provider="#{inventoryDetail}" />
		<params>
			<param id="REPORT_RESOURCE_BUNDLE" value="com.code.aon.ui.warehouse.i18n.report" />
			<param id="logoImageFile" value="#{company.getAttachAsInputStream}" />
			<param id="company" value="#{company.obtainCompany}" />			
		</params>
	</report>
	
</report-config>