<faces-config version="1.2"
	xmlns="http://java.sun.com/xml/ns/javaee"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://java.sun.com/xml/ns/javaee http://java.sun.com/xml/ns/javaee/web-facesconfig_1_2.xsd">
	
	<application>
		<message-bundle>com.code.aon.ui.common.i18n.messages</message-bundle>
		<locale-config>
			<default-locale>es</default-locale>
			<supported-locale>en</supported-locale>
		</locale-config>
		<view-handler>com.sun.facelets.FaceletViewHandler</view-handler>  
		<resource-bundle>
			<base-name>com.code.aon.ui.common.i18n.messages</base-name>
			<var>bundle</var>
		</resource-bundle>
		<resource-bundle>
			<base-name>com.code.aon.ui.enterprise.i18n.messages</base-name>
			<var>appBundle</var>
		</resource-bundle>
		<resource-bundle>
			<base-name>com.code.aon.ui.account.i18n.messages</base-name>
			<var>accountBundle</var>
		</resource-bundle>
		<resource-bundle>
			<base-name>com.code.aon.ui.accounting.i18n.messages</base-name>
			<var>accountingBundle</var>
		</resource-bundle>
		<resource-bundle>
			<base-name>com.code.aon.ui.commercial.i18n.messages</base-name>
			<var>commercialBundle</var>
		</resource-bundle>				
		<resource-bundle>
			<base-name>com.code.aon.ui.company.i18n.messages</base-name>
			<var>companyBundle</var>
		</resource-bundle>
		<resource-bundle>
			<base-name>com.code.aon.ui.config.i18n.messages</base-name>
			<var>configBundle</var>
		</resource-bundle>
		<resource-bundle>
			<base-name>com.code.aon.ui.customer.i18n.messages</base-name>
			<var>customerBundle</var>
		</resource-bundle>
		<resource-bundle>
			<base-name>com.code.aon.ui.finance.i18n.messages</base-name>
			<var>financeBundle</var>
		</resource-bundle>
		<resource-bundle>
			<base-name>com.code.aon.ui.geozone.i18n.messages</base-name>
			<var>geozoneBundle</var>
		</resource-bundle>
		<resource-bundle>
			<base-name>com.code.aon.ui.product.i18n.messages</base-name>
			<var>productBundle</var>
		</resource-bundle>
		<resource-bundle>
			<base-name>com.code.aon.ui.registry.i18n.messages</base-name>
			<var>registryBundle</var>
		</resource-bundle>
		<resource-bundle>
			<base-name>com.code.aon.ui.sales.i18n.messages</base-name>
			<var>salesBundle</var>
		</resource-bundle>
		<resource-bundle>
			<base-name>com.code.aon.bridge.i18n.messages</base-name>
			<var>securityBundle</var>
		</resource-bundle>
		<resource-bundle>
			<base-name>com.code.aon.ui.supplier.i18n.messages</base-name>
			<var>supplierBundle</var>
		</resource-bundle>
		<resource-bundle>
			<base-name>com.code.aon.ui.warehouse.i18n.messages</base-name>
			<var>warehouseBundle</var>
		</resource-bundle>
	</application>

	<!-- ***************** FAILED LOGIN ******************** --> 
	<managed-bean>
		<managed-bean-name>failedLogin</managed-bean-name>
		<managed-bean-class>com.code.aon.bridge.session.FailedLogin</managed-bean-class>
		<managed-bean-scope>request</managed-bean-scope>
	</managed-bean>

	<!-- ***************** LOGGED USER ******************** --> 
	<managed-bean>
		<managed-bean-name>loggedUser</managed-bean-name>
		<managed-bean-class>com.code.aon.bridge.session.LoggedUser</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
	</managed-bean>

	<!-- *************** RESOURCE RESOLVER ***************** --> 
	<managed-bean>
		<managed-bean-name>aonResource</managed-bean-name>
		<managed-bean-class>
			com.code.aon.ui.resources.bean.ResourceResolver
		</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
		<managed-property>
			<property-name>resourceContextPath</property-name>
			<value>aon-enterprise</value>
		</managed-property>		
		<managed-property>
			<property-name>resourceURIPreffix</property-name>
			<value>/aonResource/3.4.0</value>
		</managed-property>		
	</managed-bean>

	<!--  **** AON CONFIGURATION **** -->
	<managed-bean>
		<managed-bean-name>aonConfiguration</managed-bean-name>
		<managed-bean-class>
			com.code.aon.ui.common.controller.ConfigurationController
		</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
		<managed-property>
			<property-name>styleSheets</property-name>
			<list-entries>
				<value>#{aonResource.resolve['/aon-richCss.css']}</value>
				<value>#{aonResource.resolveLocal['/css/enterprise.css']}</value>
			</list-entries>
		</managed-property>
	</managed-bean>

	<!-- *************************************** -->
	<!-- ************ NAVIGATION *************** -->
	<!-- *************************************** -->

	<navigation-rule>
		<navigation-case>
			<from-outcome>logout</from-outcome>
			<to-view-id>/home.jsf</to-view-id>
			<redirect />
		</navigation-case>
	</navigation-rule>

	<!-- =================== Application Menu Navigation Rules ================= -->	

	<navigation-rule>
		<navigation-case>
			<from-outcome>sales</from-outcome>
			<to-view-id>/facelet/menu/sales.xhtml</to-view-id> 
		</navigation-case>
		<navigation-case>
			<from-outcome>purchase</from-outcome>
			<to-view-id>/facelet/menu/purchase.xhtml</to-view-id> 
		</navigation-case>
		<navigation-case>
			<from-outcome>warehouse</from-outcome>
			<to-view-id>/facelet/menu/warehouse.xhtml</to-view-id> 
		</navigation-case>
		<navigation-case>
			<from-outcome>treasury</from-outcome>
			<to-view-id>/facelet/menu/treasury.xhtml</to-view-id> 
		</navigation-case>
		<navigation-case>
			<from-outcome>accounting</from-outcome>
			<to-view-id>/facelet/menu/accounting.xhtml</to-view-id> 
		</navigation-case>
		<navigation-case>
			<from-outcome>config</from-outcome>
			<to-view-id>/facelet/menu/config.xhtml</to-view-id> 
		</navigation-case>
	</navigation-rule>

</faces-config>