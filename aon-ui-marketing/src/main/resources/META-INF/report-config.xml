<?xml version="1.0" encoding="ISO-8859-1"?>

<!DOCTYPE report-config 
	PUBLIC "-//CODE-AON//DTD Report Config//EN" 
	"http://co-de.com/aon/report-config.dtd">

<report-config>

	<!--  **********************************************************
						      Target
		  ********************************************************** -->
	<report id="marketingTargetList" description="Targets List">
		<template path="/com/code/aon/ui/commercial/report/target.jasper"/>
		<bean key="com.code.aon.marketing.MarketingTarget" />
		<criteria provider="#{target}"/>
		<params>
			<param id="REPORT_RESOURCE_BUNDLE" value="com.code.aon.ui.commercial.i18n.report" />
			<param id="logoImageFile" value="#{company.getAttachAsInputStream}" />
			<param id="company" value="#{company.obtainCompany}" />
		</params>
	</report>
	<report id="marketingTargetListDetail" description="Target Detailed report ">
		<template path="/com/code/aon/ui/commercial/report/targetDetail.jasper" />
		<bean key="com.code.aon.marketing.MarketingTarget" />
		<criteria provider="#{target}"/>
		<params>
			<param id="REPORT_RESOURCE_BUNDLE" value="com.code.aon.ui.commercial.i18n.report" />
			<param id="logoImageFile" value="#{company.getAttachAsInputStream}" />
			<param id="printHeader" value="#{company.isPrintHeader}" />
			<param id="company" value="#{company.obtainCompany}" />
		</params>
	</report>
	<report id="marketingTargetListDetailExcel" description="Target Detailed Excel report ">
		<template path="/com/code/aon/ui/commercial/report/targetDetailExcel.jasper" />
		<bean key="com.code.aon.marketing.MarketingTarget" />
		<criteria provider="#{target}"/>
		<params>
			<param id="REPORT_RESOURCE_BUNDLE" value="com.code.aon.ui.commercial.i18n.report" />
			<param id="printHeader" value="#{company.isPrintHeader}" />
		</params>
	</report>
	
</report-config>