<!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Strict//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-strict.dtd">
<html xmlns="http://www.w3.org/1999/xhtml" xml:lang="en" lang="en">
<head>

<meta http-equiv="content-type" content="text/html; charset=utf-8" />
<meta http-equiv="content-language" content="en" />

<link href="preview.css" rel="stylesheet" type="text/css" />

<script src="http://ajax.googleapis.com/ajax/libs/jquery/1.7.1/jquery.min.js" type="text/javascript"></script>
<script src="preview.js" type="text/javascript"></script>

<title>Lector RSS aonSolutions</title>

<script type="text/javascript">
$(document).ready(function() {
#if ( ${channels.size()} > 1 )
	setRSSFeed('#menu');	

	$('#menu').change(function() {
		setRSSFeed(this);
	});

	function setRSSFeed(obj) {
		var feedurl = $('option:selected', obj).val();
		
		if (feedurl) {
			feedurl = feedurl + "?nocache=" + (new Date).getTime() + '$!{URLSuffix}';
			$('#test').rssfeed(feedurl, {$!{parameters}});
		}
	}
#else
	var feedurl = '${channelURL}rss-${channels.get(0).id}.xml?nocache=' + (new Date).getTime() + '$!{URLSuffix}';
	$('#test').rssfeed(feedurl, {$!{parameters}});
#end
});
</script>

</head>
<body>
#if ( ${channels.size()} > 1 )
	<b>Canales RSS</b>
	<select id="menu">
	#foreach($channel in $channels)
		<option value="${channelURL}rss-${channel.id}.xml">$esc.html(${channel.name})</option>
	#end
	</select>
	<br>
#end
<div id="test"></div>

</body>
</html>