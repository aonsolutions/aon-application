<?xml version="1.0" encoding="UTF-8"?>

<!DOCTYPE bean-config 
	PUBLIC "-//CODE-AON//DTD Bean Config//EN" 
	"http://co-de.com/aon/bean-config.dtd">

<bean-config>

	<bean description="">
		<pojo>com.code.aon.groupware.Campaign</pojo>
		<vetoListeners>
	        <vetoListener>com.code.aon.company.event.EnterpriseContainerBeanVetoListener</vetoListener>
		</vetoListeners>
	</bean>

	<bean description="">
		<pojo>com.code.aon.groupware.CampaignType</pojo>
		<vetoListeners>
	        <vetoListener>com.code.aon.company.event.EnterpriseContainerBeanVetoListener</vetoListener>
		</vetoListeners>
	</bean>

	<bean description="">
		<pojo>com.code.aon.groupware.DailyTracking</pojo>
		<vetoListeners>
	        <vetoListener>com.code.aon.company.event.EnterpriseContainerBeanVetoListener</vetoListener>
		</vetoListeners>
	</bean>

	<bean description="">
		<pojo>com.code.aon.groupware.Process</pojo>
		<vetoListeners>
	        <vetoListener>com.code.aon.company.event.EnterpriseContainerBeanVetoListener</vetoListener>
		</vetoListeners>
	</bean>

	<bean description="">
		<pojo>com.code.aon.groupware.ProcessTask</pojo>
		<listeners>
	        <listener>com.code.aon.groupware.event.ProcessTaskBeanListener</listener>
		</listeners>
	</bean>

	<bean description="">
		<pojo>com.code.aon.groupware.Task</pojo>
		<vetoListeners>
	        <vetoListener>com.code.aon.company.event.EnterpriseContainerBeanVetoListener</vetoListener>
		</vetoListeners>
	</bean>

</bean-config>