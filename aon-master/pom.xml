<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
	<parent>
		<groupId>com.code.aon</groupId>
		<artifactId>aon.parent</artifactId>
		<version>6.2.0-SNAPSHOT</version>
	</parent>
	<modelVersion>4.0.0</modelVersion>
	<groupId>com.code.aon</groupId>
	<artifactId>aon-master</artifactId>
	<version>6.2.0-SNAPSHOT</version>
	<description>AON MASTER</description>
	<name>AON-MASTER</name>

	<scm>
		<developerConnection>scm:svn:http://dev.esferalia.com/repos/aon-application/trunk/aon-master</developerConnection>
		<connection>scm:svn:http://dev.esferalia.com/repos/aon-application/trunk/aon-master</connection>
		<url>http://dev.esferalia.com/websvn/wsvn/aon-master</url>
	</scm>


	<dependencies>
		<dependency>
			<groupId>com.code.aon</groupId>
			<artifactId>aon-dbutils</artifactId>
			<version>${pom.version}</version>
			<scope>compile</scope>
		</dependency>
		<dependency>
			<groupId>commons-lang</groupId>
			<artifactId>commons-lang</artifactId>
			<version>2.5</version>
			<scope>compile</scope>
		</dependency>

		<dependency>
			<groupId>org.slf4j</groupId>
			<artifactId>slf4j-api</artifactId>
			<version>1.5.11</version>
			<scope>compile</scope>
		</dependency>

		
		<!-- TEST DEPENDENCIES -->
		<dependency>
			<groupId>junit</groupId>
			<artifactId>junit</artifactId>
			<version>4.1</version>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>mysql</groupId>
			<artifactId>mysql-connector-java</artifactId>
			<version>5.0.8</version>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.slf4j</groupId>
			<artifactId>slf4j-jcl</artifactId>
			<version>1.5.11</version>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<plugin>
				<groupId>org.codehaus.mojo</groupId>
				<artifactId>buildnumber-maven-plugin</artifactId>
				<version>1.0-beta-4</version>
				<executions>
					<execution>
						<phase>validate</phase>
						<goals>
							<goal>create</goal>
						</goals>
					</execution>
				</executions>
				<configuration>
					<doCheck>false</doCheck>
					<doUpdate>false</doUpdate>
				</configuration>
			</plugin>
	</plugins>
	</build>

	<profiles>
		<profile>
			<id>rpm-release</id>
			<activation>
				<property>
					<name>rpm.release</name>
					<value>true</value>
				</property>
			</activation>
			<build>
				<plugins>
					<!-- Para construir el RPM -->
					<plugin>

						<groupId>org.codehaus.mojo</groupId>
						<artifactId>rpm-maven-plugin</artifactId>
						<version>2.0.1</version>
						<extensions>true</extensions>

						<executions>
							<execution>
								<id>rpm-build</id>
								<goals>
									<goal>attached-rpm</goal>
								</goals>
							</execution>
						</executions>

						<configuration>
							<group>Applications/Aon</group>
							<release>${buildNumber}</release>
							<copyright>2010, esferalia Networks S.A</copyright>
							<requires>
								<require>slf4j</require>
								<require>aon-dbutils</require>
								<require>jakarta-commons-lang</require>
								<require>mysql-connector-java</require>
								<require>jakarta-commons-logging</require>
								<require>aon-directory-client &gt;= 5.0.0-4</require>
							</requires>
							<mappings>
								<mapping>
									<filemode>644</filemode>
									<username>root</username>
									<groupname>root</groupname>
									<directory>/usr/share/java</directory>
									<sources>
										<source>
											<location>target</location>
											<includes>
												<include>${project.artifactId}-${project.version}.jar</include>
											</includes>
										</source>
										<softlinkSource>
											<location>/usr/share/java/${project.artifactId}-${project.version}.jar</location>
											<destination>${project.artifactId}.jar</destination>

										</softlinkSource>
									</sources>

								</mapping>
								<mapping>
									<sources>
										<source>
											<location>src/main/scripts</location>
											<excludes>
												<exclude>postinstall</exclude>
											</excludes>
										</source>
									</sources>
									<filemode>755</filemode>
									<username>root</username>
									<groupname>root</groupname>
									<directory>/usr/share/aon-master/bin</directory>
								</mapping>

								<mapping>
									<!-- 
									<filemode>755</filemode>
									<username>root</username>
									<groupname>root</groupname>
									-->
									<directory>/etc/cron.daily</directory>
									<sources>
										<softlinkSource>
											<location>/usr/share/aon-master/bin/automysqlbackup.sh</location>
											<destination>automysqlbackup</destination>
										</softlinkSource>
									</sources>
								</mapping>
								
							</mappings>

							<postinstallScriptlet>
								<scriptFile>src/main/scripts/postinstall</scriptFile>
								<fileEncoding>utf-8</fileEncoding>
							</postinstallScriptlet>

						</configuration>
					</plugin>



				</plugins>
			</build>
		</profile>
	</profiles>

</project>
 
