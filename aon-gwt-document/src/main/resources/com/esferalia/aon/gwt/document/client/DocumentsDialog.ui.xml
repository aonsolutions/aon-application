<ui:UiBinder xmlns:ui='urn:ui:com.google.gwt.uibinder'
	xmlns:g='urn:import:com.google.gwt.user.client.ui' 
	xmlns:es3='urn:import:com.google.gwt.user.client.ui'
	xmlns:datepicker='urn:import:com.google.gwt.user.datepicker.client'>
	
	<ui:Style>

		.form {
			padding: 10px; 		
		}

		.label {
			margin-top:10x;
			font-weight: bold;
			padding: 1px 0.5em;
			white-space: nowrap;
			background-color: #F2F2F2;
		}

		.labeltop {
			margin-top:10x;
			font-weight: bold;
			padding: 1px 0.5em;
			vertical-align: top;			
			white-space: nowrap;
			background-color: #F2F2F2;
		}

		.field {
			padding: 1px 0.5em;
		}
		
		.buttons {
			padding-top: 10px; 		
			text-align: right;
		}

		.info {
		}

		.warn {
		}

		.error {
		}

		.messages {
			padding-left: 0.5em;
			padding-bottom: 10px; 		
		}
		.form textarea {
			resize: none;
		}

	</ui:Style>
	<g:HTMLPanel styleName="{style.form}">
		<div>
		<g:Label ui:field="label">
		</g:Label>
		</div>
		<div>
		<g:FlexTable ui:field="grid">
			
		</g:FlexTable>
		</div>
		<div class="{style.buttons}">
			<g:Button ui:field="cancelButton"></g:Button>
			<g:Button ui:field="acceptButton"></g:Button>
		</div>
	
	</g:HTMLPanel>

</ui:UiBinder>