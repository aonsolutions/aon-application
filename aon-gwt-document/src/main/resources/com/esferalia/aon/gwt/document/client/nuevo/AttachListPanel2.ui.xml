
<!DOCTYPE html [
    <!ENTITY nbsp "&#160;"> 
]>
<ui:UiBinder xmlns:ui='urn:ui:com.google.gwt.uibinder' xmlns:doc='urn:import:com.esferalia.aon.gwt.issues.client'
	xmlns:g='urn:import:com.google.gwt.user.client.ui' xmlns:aon='urn:import:com.esferalia.aon.gwt.common.client.widget'
	xmlns:c="urn:import:com.google.gwt.user.cellview.client" xmlns:b="http://java.sun.com/jstl/core"	
	xmlns:p='urn:import:com.vaadin.polymer.paper.widget'
	xmlns:i='urn:import:com.vaadin.polymer.iron.widget'
	xmlns:v='urn:import:com.vaadin.polymer.vaadin.widget'
	xmlns:a="urn:import:com.esferalia.aon.gwt.issues.client"
	>

    <ui:style>
   
    </ui:style>

<g:HTMLPanel addStyleNames="iron-list-doc"> 

	<style is="custom-style">
			
            .iron-list-doc iron-list {
                background-color:#fff;
                padding-bottom: 0px;
                margin:10px;
                border-top: 1px solid #ddd;
            }
            .iron-list-doc .item {
        		padding: 10px;
        		background-color: white;
        		border: 1px solid #ddd;
       	 		border-top:0px;
       	 		cursor:pointer;
            }
            
            .iron-list-doc .pad {
            	padding-left: 30px;
                display: inline-block;
                @apply(--layout-flex);
                @apply(--layout-vertical);
            }
            .iron-list-doc .primary {
                font-size: 16px;
                font-weight: bold;
            }
    </style>
       <i:IronList ui:field="grid" as="item" addStyleNames="fit" selectionEnabled="true">
            <template>
                <div>
                    <div class="item">
                    	<iron-icon style="color:[[item.color]];position:absolute;" icon="error-outline"/>
                        <div class="pad">
                            <div class="primary">	
                           		[[item.name]]                      
                            </div>
                        </div>
                    </div>
        		</div>
        	</template>
  		</i:IronList>
  	</g:HTMLPanel>
</ui:UiBinder>
