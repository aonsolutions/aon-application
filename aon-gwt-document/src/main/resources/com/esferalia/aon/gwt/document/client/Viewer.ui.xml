<ui:UiBinder xmlns:ui='urn:ui:com.google.gwt.uibinder'
	xmlns:g='urn:import:com.google.gwt.user.client.ui' xmlns:doc='urn:import:com.esferalia.aon.gwt.document.client'>

	<ui:style>
		.editor {
			position:absolute !important;
			width:100%;
			background-color: rgba(0,0,0,0.8);
			
     		height: 100%;
		}

		.document {
			margin-top: 38px;
			margin-left: auto;
			margin-right: auto;
			margin-bottom: 15px;
		}
		
		.prueba{
			background-color: rgba(0,0,0,0.8);
		}
		.menu{
			background-color:  rgba(0,0,0,1);
			width: 100%;
			padding-left:100px;
			padding-top:5px;
			height: 38px;
			top: 0px;
			left:0px;
			position: absolute;
		}
		.auxiliar{
			background-color:  rgba(0,0,0,0);
			width: 100%;
			padding-left:100px;
			padding-top:5px;
			height: 60px;
			top: 0px;
			left:0px;
			position: absolute;
		}
		
		.auxiliar2{
			background-color:  rgba(0,0,0,0);
			left:0px;
			position:absolute;
			height: 100%;
			width: 150px;
		}
		.auxiliar3{
			background-color:  rgba(0,0,0,0);
			right:0px;
			position:absolute;
			height: 100%;
			width: 150px;
		}
		
		.button{
			position:absolute;
			left: 15px;
			bottom: 50%;
		}
		
		.button2{
			position: absolute;
    		right: 0px;
		}
		
		.button3{
			position: absolute;
    		right: 15px;
    		bottom: 50%;
		}
		
		.aon-editDataTable-button2 {
    		border: 0px none;
    		cursor: pointer;
    		padding: 0px 0px 0px 15px;
    		background-color: transparent;
    		margin-right: 5px;
    		min-height: 35px;
			min-width: 35px;
		}
		.aon-editDataTable-button3 {
    		border: 0px none;
    		cursor: pointer;
    		padding: 0px 0px 0px 15px;
    		background-color: transparent;
    		margin-right: 5px;
    		min-height: 32px;
			min-width: 32px;
		}
		
		.size{
			width: 100%;	
		}
		
		.label{
			color: #FFF;
			padding-left: 25px;
			padding-top: 10px;
			min-height: 22px;
		}
		.actions{
			left:40%;
			position:absolute;
		}
		
	</ui:style >
		
		<g:SimplePanel ui:field="simple" styleName="{style.size}">
			<!--  g:VerticalPanel styleName="{style.size}" -->

				<g:SimplePanel styleName="{style.prueba}">
			
				<g:HorizontalPanel>
					<g:ScrollPanel styleName="{style.editor}" ui:field="scrollPanel">
						<g:VerticalPanel styleName="{style.document}">
							<g:HTML  ui:field='container'  />
						</g:VerticalPanel>
					</g:ScrollPanel>
					<g:HorizontalPanel ui:field="auxiliar" styleName="{style.auxiliar}">
						<g:Label></g:Label>
						<g:Label></g:Label>
					</g:HorizontalPanel>
					<g:HorizontalPanel ui:field="auxiliar2" styleName="{style.auxiliar2}">
						<g:Label></g:Label>
						<g:Label></g:Label>
					</g:HorizontalPanel>
					<g:HorizontalPanel ui:field="auxiliar3" styleName="{style.auxiliar3}">
						<g:Label></g:Label>
						<g:Label></g:Label>
					</g:HorizontalPanel>
					<g:HorizontalPanel ui:field="menu" visible="false" styleName="{style.menu}">
						<g:Label ui:field="title" styleName="{style.label}"></g:Label>
						<g:HorizontalPanel styleName="{style.actions}">
							<g:Button ui:field="print" styleName="{style.aon-editDataTable-button3} aon-icon-print"></g:Button>
							<g:Button ui:field="share" styleName="{style.aon-editDataTable-button3} aon-icon-share2"></g:Button>
							<g:Button ui:field="download" styleName="{style.aon-editDataTable-button3} aon-icon-download2"></g:Button>
						</g:HorizontalPanel>
						<g:Button ui:field="close" styleName="{style.button2} {style.aon-editDataTable-button3} aon-icon-close2"></g:Button>
					</g:HorizontalPanel>
					<g:Button ui:field="prev" visible="false" styleName="{style.button} {style.aon-editDataTable-button2} aon-prev-button"></g:Button>			
					<g:Button ui:field="next" visible="false" styleName="{style.button3} {style.aon-editDataTable-button2} aon-next-button"></g:Button>
				</g:HorizontalPanel>
				</g:SimplePanel>
			<!-- /g:VerticalPanel -->
		</g:SimplePanel>

</ui:UiBinder>