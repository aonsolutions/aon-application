
<!DOCTYPE html [
    <!ENTITY nbsp "&#160;"> 
]>
<ui:UiBinder xmlns:ui='urn:ui:com.google.gwt.uibinder' xmlns:doc='urn:import:com.esferalia.aon.gwt.issues.client'
	xmlns:g='urn:import:com.google.gwt.user.client.ui' xmlns:aon='urn:import:com.esferalia.aon.gwt.common.client.widget'
	xmlns:c="urn:import:com.google.gwt.user.cellview.client" xmlns:b="http://java.sun.com/jstl/core"
	

	xmlns:p='urn:import:com.vaadin.polymer.paper.widget'
	xmlns:i='urn:import:com.vaadin.polymer.iron.widget'>
	
    <ui:with type="com.esferalia.aon.gwt.common.client.css.AonResources"
		field="aonResources"></ui:with>
<ui:style>

</ui:style>
    <g:HTMLPanel styleName="aon-panelGrid-search searchPanel-document {aonResources.css.aonMarginLeft5} {aonResources.css.aonMarginRight5}">
		<div class="aon-panelGrid-search-info">					
			<g:HorizontalPanel styleName="aon-width-all">
				<g:HTMLPanel>
					<span class="aon-panelGrid-search-info-internal" style="position: relative;top: 2px;">Filtrar:</span>						
				</g:HTMLPanel>
				<g:HTMLPanel>
					<a style="font-size:10px;font-weight:bold;float:right;"
						onclick="" href="#">
						<span class="aon-outputText">
			  		 	 	<g:Button ui:field="advanceSearch" text="Búsqueda Avanzada" styleName="aon-editDataTable-button aon-icon-search">
										    	    
				    		</g:Button>
						</span>
					</a>	
					<a style="font-size:10px;font-weight:bold;float:right;"
						onclick="" href="#">
						<span class="aon-outputText">
				  	 	 	<g:Button ui:field="cleanFilterButton" text="Limpiar Filtro" styleName="aon-editDataTable-button aon-icon-rubber">
					    		
				    		</g:Button>
						</span>
					</a>
				</g:HTMLPanel>
			</g:HorizontalPanel>					
		</div>
		<table class="aon-panelGrid">
			<tr>
				<td>
					<span class="aon-panelGrid-search-info-internal2-document">Nombre:</span>
				</td>
				<td style="width:600px">
					<g:TextBox ui:field="searchBox" styleName="aon-search-box-document">
					</g:TextBox>
				</td>
				<td>
					<span class="aon-panelGrid-search-info-internal2-document">Empresa:</span>
				</td>
				<td style="width:350px;">
					<g:SuggestBox ui:field="enterpriseSearchBox" styleName="aon-search-box2-document"
						autoSelectEnabled="true" popupStyleName="aon-search-box-popup-document">
					</g:SuggestBox>
				</td>    
				<td style="padding-left:20px;"><g:Button ui:field="reset" visible="true" styleName="aon-editDataTable-button aon-icon-home"></g:Button></td>
					<td><g:Button visible="false" ui:field="searchButton" styleName="aon-editDataTable-button"> </g:Button> 
				</td>
				<td><g:Button visible="false" ui:field="eSearchButton" styleName="aon-editDataTable-button"> </g:Button> 
				</td>
			</tr>
		</table>
	</g:HTMLPanel>
</ui:UiBinder>
