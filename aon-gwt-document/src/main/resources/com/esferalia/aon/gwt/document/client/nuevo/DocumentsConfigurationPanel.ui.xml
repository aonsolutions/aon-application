
<!DOCTYPE html [
    <!ENTITY nbsp "&#160;"> 
]>
<ui:UiBinder xmlns:ui='urn:ui:com.google.gwt.uibinder' xmlns:doc='urn:import:com.esferalia.aon.gwt.issues.client'
	xmlns:g='urn:import:com.google.gwt.user.client.ui' xmlns:aon='urn:import:com.esferalia.aon.gwt.common.client.widget'
	xmlns:c="urn:import:com.google.gwt.user.cellview.client" xmlns:b="http://java.sun.com/jstl/core"
	xmlns:p='urn:import:com.vaadin.polymer.paper.widget'
	xmlns:i='urn:import:com.vaadin.polymer.iron.widget'
>

 <ui:style>
  		.heading {
            background-color: #f3f3f3;
            border: 1px solid #ddd;
            font-size: 18px;
            cursor: pointer;
            -webkit-tap-highlight-color: rgba(0,0,0,0);
            width: 100%;
        }

        @external .iron-selected, .selector-sample;

        .selector-sample iron-selector > * {
            padding: 8px;
        }

        .selector-sample .iron-selected {
            background-color: #ddd;
        }
    </ui:style>

	<g:HTMLPanel ui:field="panel">      
	    <i:IronSelector ui:field="menuSelector">
            <p:PaperItem ui:field="allFilesPaper">
            	<i:IronIcon icon="attachment"/>
               	<div>Todos los Archivos</div>
            	<p:PaperRipple/>
            </p:PaperItem>
			<p:PaperItem ui:field="systemPaper">
        		<i:IronIcon icon="mail"/>
              	<div>Mensajes de Sistema</div>
               	<p:PaperRipple/>
            </p:PaperItem>   
           	<p:PaperItem ui:field="lotePaper">
            	<i:IronIcon icon="mail"/>
            	<div>Lote</div>
            	<p:PaperRipple/>
            </p:PaperItem>     	
        </i:IronSelector>
        
        <g:Button ui:field="categoryButton" addStyleNames="{style.heading}">Categorias</g:Button>
		<i:IronCollapse ui:field="categoryCollapse">
			<i:IronSelector ui:field="categorySelector" multi="true">
           
            </i:IronSelector>
        </i:IronCollapse>
        
        <g:Button ui:field="tagButton" addStyleNames="{style.heading}">Etiquetas</g:Button>
		<i:IronCollapse ui:field="tagCollapse">
			<i:IronSelector ui:field="tagSelector" multi="true">
            	
            </i:IronSelector>
        </i:IronCollapse>
        
    </g:HTMLPanel>

</ui:UiBinder>
