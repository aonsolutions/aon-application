
<!DOCTYPE html [
    <!ENTITY nbsp "&#160;"> 
]>
<ui:UiBinder xmlns:ui='urn:ui:com.google.gwt.uibinder' xmlns:doc='urn:import:com.esferalia.aon.gwt.document.client'
	xmlns:g='urn:import:com.google.gwt.user.client.ui' xmlns:aon='urn:import:com.esferalia.aon.gwt.common.client.widget'
	xmlns:c="urn:import:com.google.gwt.user.cellview.client" xmlns:b="http://java.sun.com/jstl/core"

	>

	<ui:style>
	
	    paper-item {
        	position: relative;
            overflow: hidden;
            padding:0px;
     		min-height: 32px !important;
    		font-size: 14px !important;
    		cursor: pointer;
        }
        
		.scrollable {
			height: 400px;
			width: 250px;
			border: 1px solid #ccc;
			text-align: left;
		}
	
		@external .gwt-SplitLayoutPanel-HDragger;
		@external .gwt-SplitLayoutPanel-VDragger;
		@external .gwt-DisclosurePanel .content;
		@external .gwt-DisclosurePanel .header;
		@external .aon-editDataTable-button;
		@external .gwt-StackLayoutPanelHeader;
		@external .gwt-SuggestBoxPopup .item-selected;
		@external .gwt-DialogBox;
		@external .gwt-DialogBox .Caption;
		@external .gwt-DialogBox .dialogTopCenter;
		@external .gwt-StackLayoutPanel;
		@external .gwt-MenuBarPopup;
		@external .gwt-StackLayoutPanelContent;
		
		.gwt-MenuBarPopup {
			margin: 0px !important;
			background: none repeat scroll 0% 0% #FFF !important;
			border: 1px solid #DDDDDD !important;
			padding: 4px 0px !important;
			box-shadow: 2px 2px 5px 1px #EBEBEF !important;
		}
	
		.gwt-StackLayoutPanelHeader {
			border-right: 0px !important;
		}
		
		.gwt-StackLayoutPanelContent {
			border-right: 0px !important;
		}
	
		.gwt-StackLayoutPanel {
			border-right: 1px solid #BBB;
		}
		
		.gwt-DialogBox .dialogTopCenter {
			background: none repeat scroll 0% 0% rgb(255, 255, 255);
			padding: 1px;
		}
		
		.gwt-DialogBox .Caption {
			background-color: #D4CFC7;
			border-color: #D4CFC7;
			background-image:
				url(/aon-aio/a4j/g/3_3_3.Finalorg.richfaces.renderkit.html.GradientA/DATB/eAF79urt8fNXmAAXoQUq.jspx);
		}
		
		.gwt-SuggestBoxPopup .item-selected {
			background: #BFBFBF !important;
		}
		
		.gwt-SplitLayoutPanel .gwt-SplitLayoutPanel-HDragger {
			background-color: #FFF !important;
		}
		
		.gwt-SplitLayoutPanel .gwt-SplitLayoutPanel-VDragger {
			background: #FFF !important;
		}
		
		.gwt-DisclosurePanel .content {
			border-left: 3px solid #FFF !important;
			padding: 4px 8px 4px 0px !important;
			margin-left: 20px !important;
		}
		
		.gwt-DisclosurePanel .header td{
			font-family: "Roboto", "Noto", sans-serif !important;
    		font-size: 14px !important;
   			line-height: 24px !important;
		    color: #212121 !important;
		}
		
		.aon-editDataTable-button {
			margin-rigth: 0px !important;
			padding-left: 20px !important;
		}
		
		.gwt-StackLayoutPanelHeader {
			background: none repeat scroll 0% 0% #EBEBEF !important;
		}
		
		.gwt-DialogBox {
			top: 30% !important;
			left: 40% !important;
		}
		
	</ui:style>	

	<g:SplitLayoutPanel ui:field="splitLayoutPanel"
		styleName="{style.gwt-SplitLayoutPanel}">
		<!-- **************************** WEST ***************************** -->
		<g:west size='275'>
			<g:StackLayoutPanel ui:field="stack1"  unit='EM'>
				<g:stack>
					<g:header size='3'>
						<div class='stackHeader-document aon-documental-docs'>
							Documentos
						</div>
					</g:header>
					<g:ScrollPanel styleName="stackBorder-document">
						
						<g:HTMLPanel>
							
							<g:VerticalPanel styleName="vpanel-document">
							
							<g:Button ui:field="allFilesPaper" text="Todos los Archivos" styleName="aon-editDataTable-button">
							
							</g:Button>
							
							<g:Button ui:field="systemPaper" text="Archivos de Sistema" styleName="aon-editDataTable-button">
							
							</g:Button>
							
							<g:Button ui:field="lotePaper" text="Lote" styleName="aon-editDataTable-button">
							
							</g:Button>
							<g:Button ui:field="betaVersion" text="Versión Alpha" styleName="aon-editDataTable-button">
							
							</g:Button>
										    			
							<g:HorizontalPanel>
								<g:DisclosurePanel ui:field="dpanel" styleName="gwt-DisclosurePanel">
								
								</g:DisclosurePanel>
								<g:Button ui:field="catButton" styleName="aon-editDataTable-button aon-lookupButton-new-disabled aon-aux-right" title="Nueva Categoria"></g:Button>
							
							</g:HorizontalPanel>
							<g:HorizontalPanel>
								<g:DisclosurePanel ui:field="epanel" styleName="gwt-DisclosurePanel">

								</g:DisclosurePanel>
								<g:Button ui:field="tagButton" styleName="aon-editDataTable-button aon-lookupButton-new-disabled aon-aux-right" title="Nueva Etiqueta"></g:Button>
							</g:HorizontalPanel>
							</g:VerticalPanel>
						</g:HTMLPanel>
					</g:ScrollPanel>
				</g:stack>
				<g:stack>
					<g:header size='3'>
						<div class='stackHeader-document aon-google-drive'>	
							    Mi Drive
						</div>
					</g:header>
					<g:ScrollPanel styleName="stackBorder-document">
					<g:AbsolutePanel>
						<!-- g:ScrollPanel ui:field="treepanel" width="100%" height="100%">
						    
						    
						</g:ScrollPanel-->
						<g:VerticalPanel styleName="vpanel-document">
							<g:Button ui:field="upDrive" styleName="aon-aux-up aon-editDataTable-buttonWest-document aon-icon-new" text="Subir"></g:Button>
							<g:SimplePanel ui:field="sp">
								
							</g:SimplePanel>
						</g:VerticalPanel>
						
						
						<!--g:Tree ui:field="tree"/ -->
					</g:AbsolutePanel>
					</g:ScrollPanel>
				</g:stack>
			</g:StackLayoutPanel>
		</g:west>

		<!-- **************************** FIN WEST **************************** -->
		<!-- **************************** CENTER **************************** -->
		<g:center>
			<g:DockLayoutPanel unit="EM">
				<g:north size="2">
					<g:FlowPanel styleName="aon-finding-title-toolbar">
						<g:HorizontalPanel ui:field="gestionDocs" visible="true">
							<g:HTMLPanel styleName="aon-finding-title">
								<g:HTMLPanel styleName="aon-finding-title-internal">
									<g:Label styleName="aon-outputText">Documentos</g:Label>
								</g:HTMLPanel>
							</g:HTMLPanel>
							<g:HTMLPanel styleName="aon-finding-subtitle">
								<g:HTMLPanel styleName="aon-finding-aubtitle-internal">
									<g:Label styleName="aon-outputText" text=" " />
								</g:HTMLPanel>
							</g:HTMLPanel>
							<g:HorizontalPanel  ui:field="ftoolbar" width="301px" styleName="aon-finding-toolbar">
								<g:HTMLPanel styleName="aon-finding-toolbar-item-group">
									<g:Label ui:field="sConvenios" visible="false" styleName='aon-finding-toolbar-item aon-icon-serviconvenios'
										text="ServiConvenios" />
								</g:HTMLPanel>
								<g:HTMLPanel styleName="aon-finding-toolbar-item-group">
									<g:Button ui:field="newFile" visible="true" styleName='aon-finding-toolbar-item aon-icon-new'
										text="Nuevo" />
								</g:HTMLPanel>
								<g:HTMLPanel styleName="aon-finding-toolbar-item-group">
									<g:Button ui:field="editFile" visible="false" styleName='aon-finding-toolbar-item aon-icon-edit'
										text="Editar" />
								</g:HTMLPanel>
								<g:HTMLPanel styleName="aon-finding-toolbar-item-group">
									<g:Button ui:field="delFile" visible="false" styleName='aon-finding-toolbar-item aon-icon-delete'
										text="Borrar" />
								</g:HTMLPanel>
								<g:HTMLPanel styleName="aon-finding-toolbar-item-group">
									<g:Button ui:field="optionFile" visible="false" styleName='aon-finding-toolbar-item aon-icon-option'
										text="Opciones" />
								</g:HTMLPanel>
							</g:HorizontalPanel>
							
							
							
							<g:HorizontalPanel ui:field="prueba2" styleName="aon-aux-right">
								
								<g:HTMLPanel styleName="aon-finding-toolbar-item-group">
									<g:Button ui:field="categories" visible="false" styleName='aon-finding-toolbar-item aon-icon-category'
										text="Categorías" />
								</g:HTMLPanel>
								<g:HTMLPanel styleName="aon-finding-toolbar-item-group">
									<g:Button ui:field="tags" visible="false" styleName='aon-finding-toolbar-item aon-icon-tag'
										text="Etiquetas" />
								</g:HTMLPanel>
							</g:HorizontalPanel>
						</g:HorizontalPanel>
						<g:HorizontalPanel visible="false" ui:field="gestionLote" >
							<g:HTMLPanel styleName="aon-finding-title">
								<g:HTMLPanel styleName="aon-finding-title-internal">
									<g:Label styleName="aon-outputText">Gestión de Lote</g:Label>
								</g:HTMLPanel>
							</g:HTMLPanel>
							<g:HTMLPanel styleName="aon-finding-subtitle">
								<g:HTMLPanel styleName="aon-finding-aubtitle-internal">
									<g:Label styleName="aon-outputText" text=" " />
							</g:HTMLPanel>								</g:HTMLPanel>
							<g:HorizontalPanel styleName="aon-finding-toolbar">
								<g:HTMLPanel styleName="aon-finding-toolbar-item-group">
									<g:Button ui:field="send" visible="false" styleName='aon-finding-toolbar-item aon-icon-webmail2'
										text="Enviar Email" />
								</g:HTMLPanel>
								<g:HTMLPanel styleName="aon-finding-toolbar-item-group">
									<g:Button ui:field="clean" visible="false" styleName='aon-finding-toolbar-item aon-icon-rubber'
										text="Limpiar" />
								</g:HTMLPanel>								
							</g:HorizontalPanel>
						</g:HorizontalPanel>
					</g:FlowPanel>
			
				</g:north>
				<g:center>
					<g:DockLayoutPanel unit="EM">
						<!-- Search & Options -->

						<g:north size="8">

							<g:HTMLPanel  styleName="aon-panelGrid-search searchPanel-document">
								<div class="aon-panelGrid-search-info">
								
									<g:HorizontalPanel styleName="aon-width-all">
										<g:HTMLPanel>
											<span class="aon-panelGrid-search-info-internal" style="position: relative;top: 2px;">Filtrar:</span>						
										</g:HTMLPanel>


										<g:HTMLPanel>
											<a style="font-size:10px;font-weight:bold;float:right;"
												onclick="" href="#">
												<span class="aon-outputText">
										  	 	 	<g:Button ui:field="advanceSearch" text="Búsqueda Avanzada" styleName="aon-editDataTable-button aon-icon-search">
										    	    
										    		</g:Button>
												</span>
											</a>	
											<a style="font-size:10px;font-weight:bold;float:right;"
												onclick="" href="#">
												<span class="aon-outputText">
										  	 	 	<g:Button ui:field="cleanFilterButton" text="Limpiar Filtro" styleName="aon-editDataTable-button aon-icon-rubber">
										    		
										    		</g:Button>
												</span>
											</a>
										</g:HTMLPanel>
									</g:HorizontalPanel>					
								</div>
								<table class="aon-panelGrid">
									<tr>
										<td>
											<span class="aon-panelGrid-search-info-internal2-document">Nombre:</span>
										</td>
										<td style="width:600px">
											<g:TextBox ui:field="searchBox" styleName="aon-search-box-document">
											</g:TextBox>
										</td>
										<td>
											<span class="aon-panelGrid-search-info-internal2-document">Empresa:</span>
										</td>
										<td style="width:350px;">
											<g:SuggestBox ui:field="enterpriseSearchBox" styleName="aon-search-box2-document"
													autoSelectEnabled="true" popupStyleName="aon-search-box-popup-document">
											</g:SuggestBox>
										</td>    
										<td style="padding-left:20px;"><g:Button ui:field="reset" visible="true" styleName="aon-editDataTable-button aon-icon-home"></g:Button></td>
										<td><g:Button visible="false" ui:field="searchButton" styleName="aon-editDataTable-button"> </g:Button> 
										</td>
										<td><g:Button visible="false" ui:field="eSearchButton" styleName="aon-editDataTable-button"> </g:Button> 
										</td>
									</tr>
								</table>
							</g:HTMLPanel>
						</g:north>
						<g:center>
							<c:DataGrid ui:field='dataGrid'></c:DataGrid>
						</g:center>
					</g:DockLayoutPanel>
				</g:center>
				<g:east size="1">
					<g:AbsolutePanel></g:AbsolutePanel>
				</g:east>
			</g:DockLayoutPanel>
		</g:center>
		<!-- **************************** FIN CENTER **************************** -->
	</g:SplitLayoutPanel>

</ui:UiBinder>
