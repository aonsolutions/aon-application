
<!DOCTYPE html [
    <!ENTITY nbsp "&#160;"> 
]>
<ui:UiBinder xmlns:ui='urn:ui:com.google.gwt.uibinder' 
	xmlns:g='urn:import:com.google.gwt.user.client.ui' 
	xmlns:c="urn:import:com.google.gwt.user.cellview.client" 
	xmlns:b="http://java.sun.com/jstl/core"	
	xmlns:p='urn:import:com.vaadin.polymer.paper.widget'
	xmlns:i='urn:import:com.vaadin.polymer.iron.widget'
	xmlns:v='urn:import:com.vaadin.polymer.vaadin.widget'
	>

    <ui:style>
   
    </ui:style>

<g:HTMLPanel addStyleNames="iron-list-doc"> 

	<style is="custom-style">
			
            .iron-list-doc iron-list {
                background-color:#fff;
                padding-bottom: 0px;
                margin:10px;
                border-top: 1px solid #ddd;
            }
            .iron-list-doc .item {
				@apply --layout-horizontal;
        		padding: 10px;
        		background-color: white;
        		border: 1px solid #ddd;
       	 		border-top:0px;
       	 		cursor:pointer;
            }
            
            .iron-list-doc .pad {
            	padding-left: 10px;
                display: inline-block;
                @apply(--layout-flex);
                @apply(--layout-vertical);
            }
            .iron-list-doc .primary {
                font-size: 16px;
                font-weight: 400;
            }
    </style>
       <i:IronList ui:field="grid" as="item" addStyleNames="fit" selectionEnabled="true">
            <template>
                <div alt="[[item.id]]">
                    <div class="item">
                    	<paper-checkbox alt="[[item.id]]" style="padding-top:5px;" onclick="selection(this.alt)"></paper-checkbox>
                    	<iron-icon icon="[[item.icon]]"/>
                        <div class="pad">
                            <div class="primary">
								<span alt="[[item.id]]" onclick="viewDocument(this.alt)"> 
	                           		[[item.title]]
								</span>
								<template is="dom-if" if="{{item.confidential}}"> 
									<iron-icon style="height: 18px;" icon="lock"/>
                           		</template>
                           		<template is="dom-if" if="{{item.category.name}}"> 
                           			<span style="background-color: gray;color: white;
										font-size: 12px;font-weight: 600;padding: 2px;
									    margin-right: 5px;">[[item.category.name]]
									</span>
								</template>
								<template is="dom-repeat" items="[[item.tags]]" as="label"> 
									<span style="background-color: gray;color: white;
											font-size: 12px;font-weight: 600;padding: 2px;
											    margin-right: 5px;">[[label.name]]
									</span>
								</template>  
                            </div>
                            <template is="dom-if" if="{{item.date}}"> 
	                            <div class="secondary">[[item.date]] - [[item.size]] </div>
                            </template>
                            <template is="dom-if" if="{{!item.date}}"> 
	                            <div class="secondary">[[item.size]] </div>
							</template>
                        </div>
                        <paper-icon-button icon="more-vert" alt="[[item.id]]" onclick="optionsDocument(this, this.alt)"></paper-icon-button>
                	</div>
        		</div>
        	</template>
  		</i:IronList>
  	</g:HTMLPanel>
</ui:UiBinder>
