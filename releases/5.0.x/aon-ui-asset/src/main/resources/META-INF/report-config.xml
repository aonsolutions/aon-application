<?xml version="1.0" encoding="ISO-8859-1"?>

<!DOCTYPE report-config 
	PUBLIC "-//CODE-AON//DTD Report Config//EN" 
	"http://co-de.com/aon/report-config.dtd">

<report-config>

	<!--  *********  Asset Stat Print  ********* -->
	<report id="yearStatsList" description="Asset Statistics Report">
		<template path="/com/code/aon/ui/asset/report/dateYearStat.jasper" />
		<!--
			<bean key="com.code.aon.finance.Invoice" /> 
			<fetch-mode	paginated="true" page-count="500" virtualizer-max-size="50"/>
		-->
		<collection provider="#{assetCollections.stats}" />
		<params>
			<param id="REPORT_RESOURCE_BUNDLE" value="com.code.aon.ui.asset.i18n.report" />
			<param id="year" value="#{assetCollections.getYear}" />
			<param id="monthName" value="#{assetCollections.getMonthName}" />
			<param id="name" value="#{assetCollections.getName}" />
			<param id="dateRange" value="#{assetCollections.getDateRange}" />
			<param id="statType" value="#{assetCollections.getStatType}" /> 
			<param id="company" value="#{company.obtainCompany}" />
			<param id="logoImageFile" value="#{company.getAttachAsInputStream}" />
			<!--
				<param id="printHeaders" value="#{true}" />
			-->
		</params>
	</report>

</report-config>