<?xml version="1.0" encoding="UTF-8" ?>
<config
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.esferalia.com/finance finance.xsd"
	xmlns="http://www.esferalia.com/config" >
	
	<company:config version="1.0" xmlns:company="http://www.esferalia.com/company">
		<company:company 
			showRegistryBank="true" 
			showCompanyOtherData="true"
			showPanelTabSet="false" 
			showEInvoice="false"
			showDigitalCertificate="false"
		/>
	</company:config>

	<customer:config version="1.0" xmlns:customer="http://www.esferalia.com/customer">
		<customer:customer
			showDeliveryData="false" 
			showFinanceData="true" 
			showProjectData="false"
			showFinanceFeeData="false" 
			showAccount="true"
			showTariff="false" 
			showSegment="false"
			showNote="false"
			showRelationship="false"
			showRecordData="false"
			showTaxInfoData="true"
			showAddInfo="false"
			showDirStaff="false"
			showHistory="false"
		/>
	</customer:config>

	<registry:config version="1.0" xmlns:registry="http://www.esferalia.com/registry">
		<registry:rmedia showSendEmail="true" />
	</registry:config>

	<supplier:config version="1.0" xmlns:supplier="http://www.esferalia.com/supplier">
		<supplier:supplier
			showFinanceData="true" 
			showAccount="true"
			showSegment="false"
			showTaxInfoData="true"
			showAddInfo="false"
		/>
	</supplier:config>

	<finance:config version="1.0" xmlns:finance="http://www.esferalia.com/finance">
		<finance:creditor
			showFinanceData="true" 
			showAccount="true"
			showTaxInfoData="true"
			showAddInfo="false"
			showSegment="false"
		/>
		<finance:invoice
			showWarehouseData="false" 
		/>
	</finance:config>
</config>

