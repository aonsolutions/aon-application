<?xml version="1.0" encoding="UTF-8"?>
<table tableName="tax_detail">
    <columns>
        <column label="Identificador unico del Historico de Impuestos"
            name="id" sqlType="integer" type="integer"/>
        <column label="Identificador del Impuesto" name="tax"
            sqlType="integer" type="integer"/>
        <column label="Fecha de inicio de vigencia" name="start_date"
            sqlType="date" type="date"/>
        <column label="Fecha de fin de vigencia" name="end_date"
            sqlType="date" type="date"/>
        <column label="Porcentaje de recargo" name="value"
            sqlType="double" type="double"/>
        <column label="Porcentaje de recargo de equivalencia"
            name="surcharge" sqlType="double" type="double"/>
    </columns>
    <virtualColumns/>
    <primaryKey>
        <column name="id"/>
    </primaryKey>
    <joins>
        <join description="tax_detail_ibfk_1" foreignPath="data/tax.exdm.xml">
            <sourceColumns>
                <column name="tax"/>
            </sourceColumns>
        </join>
    </joins>
    <descriptionColumns/>
</table>
