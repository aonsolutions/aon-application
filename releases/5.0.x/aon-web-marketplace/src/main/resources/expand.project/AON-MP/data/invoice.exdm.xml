<?xml version="1.0" encoding="UTF-8"?>
<table tableName="invoice">
    <columns>
        <column label="Identificador unico de la Factura" name="id"
            sqlType="integer" type="integer"/>
        <column label="Serie de la Factura" length="3" name="series"
            sqlType="char" type="string"/>
        <column label="Numero de la Factura" name="number"
            sqlType="integer" type="integer"/>
        <column label="Identificador del Cliente o Proveedor"
            name="registry" sqlType="integer" type="integer"/>
        <column label="Numero de Documento del Cliente o Proveedor"
            length="16" name="rdocument" sqlType="varchar" type="string"/>
        <column label="Nombre completo del Cliente o Proveedor"
            length="128" name="rname" sqlType="varchar" type="string"/>
        <column
            label="Identificador de la Direccion de envio de la Factura"
            name="raddress" sqlType="integer" type="integer"/>
        <column label="Fecha de emision de la Factura" name="issue_date"
            sqlType="date" type="date"/>
        <column label="Nivel de seguridad de la Factura" length="2"
            name="security_level" sqlType="tinyint" type="string"/>
        <column label="Estado de la Factura" length="2" name="status"
            sqlType="tinyint" type="string"/>
        <column label="Tipo de Factura (Compra o Venta)" length="2"
            name="type" sqlType="tinyint" type="string"/>
        <column label="Indica si la Factura esta exenta de Impuestos"
            length="1" name="taxFree" sqlType="bit" type="string"/>
        <column
            label="Indica si la Factura tiene recargo de equivalencia"
            length="1" name="surcharge" sqlType="bit" type="string"/>
    </columns>
    <virtualColumns/>
    <primaryKey>
        <column name="id"/>
    </primaryKey>
    <joins>
        <join description="invoice_ibfk_3" foreignPath="data/registry.exdm.xml">
            <sourceColumns>
                <column name="registry"/>
            </sourceColumns>
        </join>
        <join description="invoice_ibfk_4" foreignPath="data/raddress.exdm.xml">
            <sourceColumns>
                <column name="raddress"/>
            </sourceColumns>
        </join>
    </joins>
    <descriptionColumns/>
</table>
