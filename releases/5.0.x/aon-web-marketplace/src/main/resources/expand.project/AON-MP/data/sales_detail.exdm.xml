<?xml version="1.0" encoding="UTF-8"?>
<table tableName="sales_detail">
    <columns>
        <column
            label="Identificador unico del Detalle del Pedido de Venta"
            name="id" sqlType="integer" type="integer"/>
        <column label="Identificador del Pedido de Venta" name="sales"
            sqlType="integer" type="integer"/>
        <column label="Numero de linea del Detalle dentro del Pedido"
            name="line" sqlType="smallint" type="short"/>
        <column label="Identificador del Articulo del Detalle de Pedido"
            name="item" sqlType="integer" type="integer"/>
        <column label="Descripcion del Detalle de Pedido" length="64"
            name="description" sqlType="varchar" type="string"/>
        <column label="Cantidad del Detalle de Pedido" name="quantity"
            sqlType="double" type="double"/>
        <column label="Precio del Detalle de Pedido" name="price"
            sqlType="double" type="double"/>
        <column label="Descuentos del Detalle de Pedido" length="32"
            name="discount_expr" sqlType="varchar" type="string"/>
        <column label="Tasas del Detalle de Pedido" name="taxes"
            sqlType="double" type="double"/>
        <column label="Estado del Detalle de Pedido" length="2"
            name="status" sqlType="tinyint" type="string"/>
    </columns>
    <virtualColumns/>
    <primaryKey>
        <column name="id"/>
    </primaryKey>
    <joins>
        <join description="sales_detail_ibfk_1" foreignPath="data/sales.exdm.xml">
            <sourceColumns>
                <column name="sales"/>
            </sourceColumns>
        </join>
        <join description="sales_detail_ibfk_2" foreignPath="data/item.exdm.xml">
            <sourceColumns>
                <column name="item"/>
            </sourceColumns>
        </join>
    </joins>
    <descriptionColumns/>
</table>
