<?xml version="1.0" encoding="UTF-8"?>
<view description="Productos por familia" sqlSentence="SELECT invoice_detail.item, product.name description, &#xd;&#xa;&#x9;SUM(invoice_detail.quantity), &#xd;&#xa;&#x9;SUM(TRUNCATE(invoice_detail.taxable_base * ((invoice_tax.percentage + invoice.surcharge + 100) / 100), 2))&#xd;&#xa;  FROM invoice_detail, invoice, pcategory, item, product, invoice_tax&#xd;&#xa; WHERE product.id = item.product&#xd;&#xa;   AND invoice_detail.item = item.id &#xd;&#xa;   AND invoice_detail.invoice = invoice.id &#xd;&#xa;   AND invoice_tax.invoice_detail = invoice_detail.id&#xd;&#xa;   AND invoice.type = 0&#xd;&#xa;   AND product.category = pcategory.id &#xd;&#xa;   AND pcategory.id = ? AND invoice.issue_date BETWEEN ? AND ?&#xd;&#xa; GROUP BY invoice_detail.item">
    <parameters>
        <parameter columnReference="data/pcategory.exdm.xml/id" label=""
            name="pcategory" type="INTEGER"/>
        <parameter name="initDate" type="DATE"/>
        <parameter name="endDate" type="DATE"/>
    </parameters>
    <results>
        <result accessName="ITEM_ID" columnId="item"
            columnReference="data/invoice_detail.exdm.xml/item"
            export="true" label="Codigo" tableId="invoice_detail" type="INTEGER"/>
        <result accessName="ITEM_NAME" columnId="name"
            columnReference="data/product.exdm.xml/name" export="true"
            label="Articulo" tableId="product" type="STRING"/>
        <result accessName="quantity" columnId="" label="Cantidad" type="DOUBLE"/>
        <result accessName="total" columnId="" label="Total" type="DOUBLE"/>
    </results>
    <dataModelReferences>
        <dataModelReference id="data/invoice.exdm.xml"/>
        <dataModelReference id="data/invoice_detail.exdm.xml"/>
        <dataModelReference id="data/item.exdm.xml"/>
        <dataModelReference id="data/pcategory.exdm.xml"/>
        <dataModelReference id="data/product.exdm.xml"/>
    </dataModelReferences>
</view>
