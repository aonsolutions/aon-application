<?xml version="1.0" encoding="UTF-8"?>
<table tableName="income_detail">
    <columns>
        <column
            label="Identificador unico del Detalle del Albaran de Compra"
            name="id" sqlType="integer" type="integer"/>
        <column label="Identificador del Albaran de Compra"
            name="income" sqlType="integer" type="integer"/>
        <column
            label="Identificador del Articulo del Detalle de Albaran"
            name="item" sqlType="integer" type="integer"/>
        <column label="Descripcion del Detalle de Albaran" length="64"
            name="description" sqlType="varchar" type="string"/>
        <column label="Identificador del Almacen" name="warehouse"
            sqlType="integer" type="integer"/>
        <column label="Cantidad del Detalle de Albaran" name="quantity"
            sqlType="double" type="double"/>
        <column label="Precio del Detalle de Albaran" name="price"
            sqlType="double" type="double"/>
        <column label="Descuentos del Detalle de Albaran" length="32"
            name="discount_expr" sqlType="varchar" type="string"/>
        <column
            label="Identificador del Detalle del Pedido de Compra asociado"
            name="purchase_detail" sqlType="integer" type="integer"/>
    </columns>
    <virtualColumns/>
    <primaryKey>
        <column name="id"/>
    </primaryKey>
    <joins>
        <join description="income_detail_ibfk_2" foreignPath="data/item.exdm.xml">
            <sourceColumns>
                <column name="item"/>
            </sourceColumns>
        </join>
        <join description="income_detail_ibfk_3" foreignPath="data/warehouse.exdm.xml">
            <sourceColumns>
                <column name="warehouse"/>
            </sourceColumns>
        </join>
        <join description="income_detail_ibfk_4" foreignPath="data/purchase_detail.exdm.xml">
            <sourceColumns>
                <column name="purchase_detail"/>
            </sourceColumns>
        </join>
        <join description="income_detail_ibfk_5" foreignPath="data/income.exdm.xml">
            <sourceColumns>
                <column name="income"/>
            </sourceColumns>
        </join>
    </joins>
    <descriptionColumns/>
</table>
