<?xml version="1.0" encoding="UTF-8"?>
<table tableName="rpaymethod">
    <columns>
        <column
            label="Identificador unico de la Forma de Pago de la Persona o Empresa"
            name="id" sqlType="integer" type="integer"/>
        <column
            label="Identificador del Registro de la Persona o Empresa"
            name="registry" sqlType="integer" type="integer"/>
        <column label="Identificador de la Forma de Pago"
            name="pay_method" sqlType="integer" type="integer"/>
        <column label="Identificador de la Entidad Bancaria"
            name="rbank" sqlType="integer" type="integer"/>
        <column label="Numero de Vencimientos" name="number_of_pymnts"
            sqlType="smallint" type="short"/>
        <column label="Dias al primer Vencimiento"
            name="days_to_first_pymnt" sqlType="smallint" type="short"/>
        <column label="Dias entre Vencimientos"
            name="days_between_pymnts" sqlType="smallint" type="short"/>
        <column label="Dias de pago" length="8" name="pymnt_days"
            sqlType="varchar" type="string"/>
    </columns>
    <virtualColumns/>
    <primaryKey>
        <column name="id"/>
    </primaryKey>
    <joins>
        <join description="rpaymethod_ibfk_1" foreignPath="data/pay_method.exdm.xml">
            <sourceColumns>
                <column name="pay_method"/>
            </sourceColumns>
        </join>
        <join description="rpaymethod_ibfk_2" foreignPath="data/rbank.exdm.xml">
            <sourceColumns>
                <column name="rbank"/>
            </sourceColumns>
        </join>
        <join description="rpaymethod_ibfk_3" foreignPath="data/registry.exdm.xml">
            <sourceColumns>
                <column name="registry"/>
            </sourceColumns>
        </join>
    </joins>
    <descriptionColumns/>
</table>
