<faces-config version="1.2"
	xmlns="http://java.sun.com/xml/ns/javaee"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://java.sun.com/xml/ns/javaee http://java.sun.com/xml/ns/javaee/web-facesconfig_1_2.xsd">

	<application>
		<resource-bundle>
			<base-name>com.code.aon.ui.registry.i18n.messages</base-name>
			<var>registryBundle</var>
		</resource-bundle>
	</application>
	
	<!-- ************ COLLECTION **************** -->
	<managed-bean>
		<managed-bean-name>registryCollections</managed-bean-name>
		<managed-bean-class>
			com.code.aon.ui.registry.controller.RegistryCollectionsController
		</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
	</managed-bean>

	<!-- ************ CATEGORY ************** -->
	<managed-bean>
		<managed-bean-name>category</managed-bean-name>
		<managed-bean-class>
			com.code.aon.ui.form.BasicController
		</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
		<managed-property>
			<property-name>queryOnStartUP</property-name>
			<value>true</value>
		</managed-property>
		<managed-property>
			<property-name>pojo</property-name>
			<value>com.code.aon.registry.Category</value>
		</managed-property>
		<managed-property>
			<property-name>beanName</property-name>
			<value>category</value>
		</managed-property>
	</managed-bean>
	
	<!-- ************ RELATIONSHIP ************** -->
	<managed-bean>
		<managed-bean-name>relationship</managed-bean-name>
		<managed-bean-class>
			com.code.aon.ui.form.BasicController
		</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
		<managed-property>
			<property-name>queryOnStartUP</property-name>
			<value>true</value>
		</managed-property>
		<managed-property>
			<property-name>pojo</property-name>
			<value>com.code.aon.registry.Relationship</value>
		</managed-property>
		<managed-property>
			<property-name>beanName</property-name>
			<value>relationship</value>
		</managed-property>
	</managed-bean>

	<!-- ************ SEGMENT ************** -->
	<managed-bean>
		<managed-bean-name>segment</managed-bean-name>
		<managed-bean-class>
			com.code.aon.ui.form.BasicController
		</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
		<managed-property>
			<property-name>queryOnStartUP</property-name>
			<value>true</value>
		</managed-property>
		<managed-property>
			<property-name>pojo</property-name>
			<value>com.code.aon.registry.Segment</value>
		</managed-property>
		<managed-property>
			<property-name>beanName</property-name>
			<value>segment</value>
		</managed-property>
	</managed-bean>
	
	<!--  **** PERSON **** -->
	<managed-bean>
		<managed-bean-name>person</managed-bean-name>
		<managed-bean-class>com.code.aon.ui.registry.controller.RegistryController</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
		<managed-property>
			<property-name>queryOnStartUP</property-name>
			<value>false</value>
		</managed-property>
		<managed-property>
			<property-name>beanName</property-name>
			<value>person</value>
		</managed-property>
		<managed-property>
			<property-name>pojo</property-name>
			<value>com.code.aon.person.Person</value>
		</managed-property>
		<managed-property>
			<property-name>defaultOrder</property-name>
			<value>Person_registry_surname,Person_registry_name</value>
		</managed-property>
		<managed-property>
			<property-name>listenerClasses</property-name>
			<list-entries>
				<value-class>com.code.aon.ui.form.event.IControllerListener</value-class>
				<value>#{personSearch}</value>
				<value>#{personForm}</value>
				<value>#{personAddressListener}</value>
				<value>#{personMediaListener}</value>
			</list-entries>
		</managed-property>
		<managed-property>
			<property-name>optionalListenerClasses</property-name>
			<value>#{personOptionalListeners}</value>
		</managed-property>		
	</managed-bean>

	<managed-bean>
		<managed-bean-name>personOptionalListeners</managed-bean-name>
	    <managed-bean-class>java.util.LinkedList</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
	</managed-bean>

	<managed-bean>
		<managed-bean-name>personSearch</managed-bean-name>
		<managed-bean-class>com.code.aon.ui.registry.controller.event.RegistrySearchListener</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
	</managed-bean>

	<managed-bean>
		<managed-bean-name>personForm</managed-bean-name>
		<managed-bean-class>com.code.aon.ui.registry.controller.event.RegistryFormListener</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
	</managed-bean>	

	<!--  **** PERSON ADDRESS **** -->
	<managed-bean>
		<managed-bean-name>personAddress</managed-bean-name>
		<managed-bean-class>com.code.aon.ui.form.LinesController</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
		<managed-property>
			<property-name>pojo</property-name>
			<value>com.code.aon.registry.RegistryAddress</value>
		</managed-property>
		<managed-property>
			<property-name>beanName</property-name>
			<value>personAddress</value>
		</managed-property>
		<managed-property>
			<property-name>cascadeDelete</property-name>
			<value>true</value>
		</managed-property>
		<managed-property>
			<property-name>masterControllerName</property-name>
			<value>person</value>
		</managed-property>
		<managed-property>
			<property-name>propertyMap</property-name>
			<map-entries>
				<map-entry>
					<key>id</key>
					<value>registry.id</value>
				</map-entry>
			</map-entries>
		</managed-property>		
		<managed-property>
			<property-name>listenerClasses</property-name>
			<list-entries>
				<value-class>com.code.aon.ui.form.event.IControllerListener</value-class>
				<value>#{personAddressControllerListener}</value>
			</list-entries>
		</managed-property>
	</managed-bean>
	
	<managed-bean>
		<managed-bean-name>personAddressControllerListener</managed-bean-name>
		<managed-bean-class>com.code.aon.ui.registry.controller.event.RegistryAddressControllerListener</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
	</managed-bean>

	<managed-bean>
		<managed-bean-name>personAddressListener</managed-bean-name>
		<managed-bean-class>com.code.aon.ui.form.listener.LinesControllerListener</managed-bean-class>
		<managed-bean-scope>none</managed-bean-scope>
		<managed-property>
			<property-name>childBean</property-name>
			<value>personAddress</value>
		</managed-property>
		<managed-property>
			<property-name>aliasMap</property-name>
			<map-entries>
				<map-entry>
					<key>RegistryAddress_registry_id</key>
					<value>id</value>
				</map-entry>
			</map-entries>
		</managed-property>
	</managed-bean>

	<!--  **** PERSON MEDIA **** -->
	<managed-bean>
		<managed-bean-name>personMedia</managed-bean-name>
		<managed-bean-class>com.code.aon.ui.form.LinesController</managed-bean-class> 
		<managed-bean-scope>session</managed-bean-scope>
		<managed-property>
			<property-name>pojo</property-name>
			<value>com.code.aon.registry.RegistryMedia</value>
		</managed-property>
		<managed-property>
			<property-name>beanName</property-name>
			<value>personMedia</value>
		</managed-property>
		<managed-property>
			<property-name>defaultOrder</property-name>
			<value>RegistryMedia_mediaType,RegistryMedia_administrative desc,RegistryMedia_commercial desc,RegistryMedia_technical desc</value>
		</managed-property>
		<managed-property>
			<property-name>cascadeDelete</property-name>
			<value>true</value>
		</managed-property>
		<managed-property>
			<property-name>masterControllerName</property-name>
			<value>person</value>
		</managed-property>
		<managed-property>
			<property-name>propertyMap</property-name>
			<map-entries>
				<map-entry>
					<key>id</key>
					<value>registry.id</value>
				</map-entry>
			</map-entries>
		</managed-property>		
	</managed-bean>
	
	<managed-bean>
		<managed-bean-name>personMediaListener</managed-bean-name>
		<managed-bean-class>com.code.aon.ui.form.listener.LinesControllerListener</managed-bean-class>
		<managed-bean-scope>none</managed-bean-scope>
		<managed-property>
			<property-name>childBean</property-name>
			<value>personMedia</value>
		</managed-property>
		<managed-property>
			<property-name>aliasMap</property-name>
			<map-entries>
				<map-entry>
					<key>RegistryMedia_registry_id</key>
					<value>id</value>
				</map-entry>
			</map-entries>
		</managed-property>
	</managed-bean>

	<!-- ************ RPAYMETHOD LISTENER ************** -->
	<managed-bean>
		<managed-bean-name>rPayMethodControllerListener</managed-bean-name>
		<managed-bean-class>com.code.aon.ui.registry.controller.event.RegistryPayMethodControllerListener</managed-bean-class>
		<managed-bean-scope>none</managed-bean-scope>
	</managed-bean>


	<!-- ========================================================== -->
	<!-- ======================= LOOKUPS ========================== -->
	<!-- ========================================================== -->
	
	<!-- ************ REGISTRY LOOKUP ************** -->
	<managed-bean>
		<managed-bean-name>registryLookup</managed-bean-name>
		<managed-bean-class>com.code.aon.faces.controller.RichLookupBean</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
		<managed-property>
			<property-name>beanName</property-name>
			<value>registryLookup</value>
		</managed-property>
		<managed-property>
			<property-name>foreignPojo</property-name>
			<value>com.code.aon.registry.Registry</value>
		</managed-property>
		<managed-property>
			<property-name>listPagePath</property-name>
			<value>/com/code/aon/ui/registry/facelet/lookup/registry/list.xhtml</value>
		</managed-property>
		<managed-property>
			<property-name>searchPagePath</property-name>
			<value>/com/code/aon/ui/registry/facelet/lookup/registry/search.xhtml</value>
		</managed-property>
		<managed-property>
			<property-name>newPagePath</property-name>
			<value>/com/code/aon/ui/registry/facelet/lookup/registry/form.xhtml</value>
		</managed-property>
		<managed-property>
			<property-name>listenerClasses</property-name>
			<list-entries>
				<value-class>com.code.aon.ui.form.event.IControllerListener</value-class>
				<value>#{registryFormListener}</value>
			</list-entries>
		</managed-property>				
	</managed-bean>
	<managed-bean>
		<managed-bean-name>registryFormListener</managed-bean-name>
		<managed-bean-class>com.code.aon.ui.registry.controller.event.RegistryFormListener</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
	</managed-bean>	
	
	<!-- ************ PERSON LOOKUP ************** -->
	<managed-bean>
		<managed-bean-name>personLookup</managed-bean-name>
		<managed-bean-class>com.code.aon.ui.registry.controller.RegistryRichLookupBean</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
		<managed-property>
			<property-name>beanName</property-name>
			<value>personLookup</value>
		</managed-property>
		<managed-property>
			<property-name>foreignPojo</property-name>
			<value>com.code.aon.person.Person</value>
		</managed-property>
		<managed-property>
			<property-name>defaultOrder</property-name>
			<value>Person_registry_surname,Person_registry_name</value>
		</managed-property>
		<managed-property>
			<property-name>listPagePath</property-name>
			<value>/com/code/aon/ui/registry/facelet/person/listBasic.xhtml</value>
		</managed-property>
		<managed-property>
			<property-name>searchPagePath</property-name>
			<value>/com/code/aon/ui/registry/facelet/person/searchBasicContent.xhtml</value>
		</managed-property>
		<managed-property>
			<property-name>newPagePath</property-name>
			<value>/com/code/aon/ui/registry/facelet/person/formNewContent.xhtml</value>
		</managed-property>
		<managed-property>
			<property-name>listenerClasses</property-name>
			<list-entries>
				<value-class>com.code.aon.ui.form.event.IControllerListener</value-class>
				<value>#{personSearch}</value>
				<value>#{personForm}</value>
			</list-entries>
		</managed-property>				
	</managed-bean>

	<!-- ======================= NAVIGATION ========================== -->
	<navigation-rule>
		<navigation-case>
			<from-outcome>relationship_form</from-outcome>
			<to-view-id>/com/code/aon/ui/registry/facelet/relationship/grid.xhtml</to-view-id>
		</navigation-case>
		<navigation-case>
			<from-outcome>segment_form</from-outcome>
			<to-view-id>/com/code/aon/ui/registry/facelet/segment/grid.xhtml</to-view-id>
		</navigation-case>
	</navigation-rule>

		
	<!-- =================== Person ========================== -->
	<navigation-rule>
		<navigation-case>
			<from-outcome>person_form</from-outcome>
			<to-view-id>/com/code/aon/ui/registry/facelet/person/form.xhtml</to-view-id>
		</navigation-case>
		<navigation-case>
			<from-outcome>person_list</from-outcome>
			<to-view-id>/com/code/aon/ui/registry/facelet/person/list.xhtml</to-view-id>
		</navigation-case>
		<navigation-case>
			<from-outcome>person_search</from-outcome>
			<to-view-id>/com/code/aon/ui/registry/facelet/person/search.xhtml</to-view-id>
		</navigation-case>
	</navigation-rule>	
	
</faces-config>
