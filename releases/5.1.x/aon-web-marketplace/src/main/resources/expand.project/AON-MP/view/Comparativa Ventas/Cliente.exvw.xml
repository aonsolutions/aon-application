<?xml version="1.0" encoding="UTF-8"?>
<view description="" sqlSentence="SELECT registry.id, document, name, alias, &#xd;&#xa;   &#x9;SUM(IF(invoice.issue_date BETWEEN ? AND ?, TRUNCATE(invoice_detail.quantity, 3), 0)),&#xd;&#xa;   &#x9;SUM(IF(invoice.issue_date BETWEEN ? AND ?, TRUNCATE(invoice_detail.taxable_base * ((invoice_tax.percentage + invoice.surcharge + 100) / 100), 2), 0)),&#xd;&#xa;   &#x9;SUM(IF(invoice.issue_date BETWEEN ? AND ?, 0, TRUNCATE(invoice_detail.quantity, 3))),&#xd;&#xa;   &#x9;SUM(IF(invoice.issue_date BETWEEN ? AND ?, 0, TRUNCATE(invoice_detail.taxable_base * ((invoice_tax.percentage + invoice.surcharge + 100) / 100), 2)))&#xd;&#xa;  FROM registry, invoice, invoice_detail, invoice_tax&#xd;&#xa; WHERE invoice.registry = registry.id &#xd;&#xa;   AND invoice_detail.invoice = invoice.id&#xd;&#xa;   AND (&#xd;&#xa;       invoice.issue_date BETWEEN ? AND ?&#xd;&#xa;       OR invoice.issue_date BETWEEN DATE_SUB(?, INTERVAL 1 YEAR) AND DATE_SUB(?, INTERVAL 1 YEAR)&#xd;&#xa;       )&#xd;&#xa;   AND invoice_tax.invoice_detail = invoice_detail.id&#xd;&#xa;   AND invoice.type = ?&#xd;&#xa; GROUP BY 1,2,3,4">
    <parameters>
        <parameter name="initdate1" type="DATE"/>
        <parameter name="endate1" type="DATE"/>
        <parameter name="initdate2" type="DATE"/>
        <parameter name="enddate2" type="DATE"/>
        <parameter name="initdate3" type="DATE"/>
        <parameter name="enddate3" type="DATE"/>
        <parameter name="initdate4" type="DATE"/>
        <parameter name="enddate4" type="DATE"/>
        <parameter name="inidate5" type="DATE"/>
        <parameter name="enddate5" type="DATE"/>
        <parameter name="inidate6" type="DATE"/>
        <parameter name="enddate6" type="DATE"/>
        <parameter name="type" type="INTEGER"/>
    </parameters>
    <results>
        <result accessName="CUSTOMER_ID" columnId="id" export="true"
            label="Codigo" tableId="registry" type="INTEGER"/>
        <result accessName="document" columnId="document"
            label="CIF / NIF" tableId="registry" type="STRING"/>
        <result accessName="CUSTOMER_NAME" columnId="name" export="true"
            label="Nombre" tableId="registry" type="STRING"/>
        <result accessName="alias" columnId="alias" label="Alias"
            tableId="registry" type="STRING"/>
        <result accessName="quantity" label="Cantidad (Kg.)" type="DOUBLE"/>
        <result accessName="period"
            columnId="SUM(IF(invoice.issue_date BETWEEN ? AND ?, TRUNCATE(invoice_detail.taxable_base * ((invoice_tax.percentage + invoice.surcharge + 100) / 100), 2), 0))"
            label="Periodo" type="DOUBLE"/>
        <result accessName="quantity2" label="Cantidad (Kg.)" type="DOUBLE"/>
        <result accessName="period2"
            columnId="SUM(IF(invoice.issue_date BETWEEN ? AND ?, 0, TRUNCATE(invoice_detail.taxable_base * ((invoice_tax.percentage + invoice.surcharge + 100) / 100), 2)))"
            label="Mismo periodo Año Anterior" type="DOUBLE"/>
    </results>
    <dataModelReferences/>
</view>
