<?xml version="1.0" encoding="UTF-8"?>
<table tableName="delivery_detail">
    <columns>
        <column
            label="Identificador unico del Detalle del Albaran de Venta"
            name="id" sqlType="integer" type="integer"/>
        <column label="Numero de linea del Detalle dentro del Albaran"
            name="line" sqlType="smallint" type="short"/>
        <column label="Identificador del Albaran de Venta"
            name="delivery" sqlType="integer" type="integer"/>
        <column
            label="Identificador del Articulo del Detalle de Albaran"
            name="item" sqlType="integer" type="integer"/>
        <column label="Descripcion del Detalle de Albaran" length="64"
            name="description" sqlType="varchar" type="string"/>
        <column label="Identificador del Almacen" name="warehouse"
            sqlType="integer" type="integer"/>
        <column label="Cantidad del Detalle de Albaran" name="quantity"
            sqlType="double" type="double"/>
        <column label="Precio del Detalle de Albaran" name="price"
            sqlType="double" type="double"/>
        <column label="Descuentos del Detalle de Albaran" length="32"
            name="discount_expr" sqlType="varchar" type="string"/>
        <column
            label="Identificador del Detalle del Pedido de Venta asociado"
            name="sales_detail" sqlType="integer" type="integer"/>
    </columns>
    <virtualColumns/>
    <primaryKey>
        <column name="id"/>
    </primaryKey>
    <joins>
        <join description="delivery_detail_ibfk_1" foreignPath="data/delivery.exdm.xml">
            <sourceColumns>
                <column name="delivery"/>
            </sourceColumns>
        </join>
        <join description="delivery_detail_ibfk_2" foreignPath="data/warehouse.exdm.xml">
            <sourceColumns>
                <column name="warehouse"/>
            </sourceColumns>
        </join>
        <join description="delivery_detail_ibfk_3" foreignPath="data/item.exdm.xml">
            <sourceColumns>
                <column name="item"/>
            </sourceColumns>
        </join>
        <join description="delivery_detail_ibfk_4" foreignPath="data/sales_detail.exdm.xml">
            <sourceColumns>
                <column name="sales_detail"/>
            </sourceColumns>
        </join>
    </joins>
    <descriptionColumns/>
</table>
