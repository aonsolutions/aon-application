<faces-config version="1.2"
	xmlns="http://java.sun.com/xml/ns/javaee"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://java.sun.com/xml/ns/javaee http://java.sun.com/xml/ns/javaee/web-facesconfig_1_2.xsd">

	<application>
		<resource-bundle>
			<base-name>com.code.aon.ui.db.i18n.messages</base-name>
			<var>dbManagerBundle</var>
		</resource-bundle>
	</application>

	<!-- ************ DB MANAGER ************** -->
	<managed-bean>
		<managed-bean-name>dbManager</managed-bean-name>
		<managed-bean-class>
			com.code.aon.ui.db.controller.DBManager
		</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
	</managed-bean>

	<!-- =================== Communication Center ================= -->	
	<navigation-rule>
		<navigation-case>
			<from-outcome>dbManager_export</from-outcome>
			<to-view-id>/com/code/aon/ui/db/facelet/manager/export.xhtml</to-view-id>
		</navigation-case>
		<navigation-case>
			<from-outcome>dbManager_import</from-outcome>
			<to-view-id>/com/code/aon/ui/db/facelet/manager/import.xhtml</to-view-id>
		</navigation-case>
	</navigation-rule>					
	
</faces-config>