<?xml version="1.0" encoding="ISO-8859-1"?>
<!DOCTYPE report-config 
	PUBLIC "-//CODE-AON//DTD Report Config//EN" 
	"http://co-de.com/aon/report-config.dtd">

<report-config>
	<default-config>
		<fetch-mode paginated="false" />
	</default-config>

	<!--  **********************************************************
						      Campaign Monitor
		  ********************************************************** -->
	<report id="campaignMonitorReport" description="Campaign Monitor Report">
		<template path="/com/code/aon/ui/campaign/report/campaignMonitorReport.jasper" />
		<collection provider="#{campaignDossier}"/>
		<params>
			<param id="REPORT_RESOURCE_BUNDLE" value="com.code.aon.ui.campaign.i18n.report" />
			<param id="logoImageFile" value="#{company.getAttachAsInputStream}" />
			<param id="company" value="#{company.obtainCompany}" />
		</params>
	</report>

</report-config>