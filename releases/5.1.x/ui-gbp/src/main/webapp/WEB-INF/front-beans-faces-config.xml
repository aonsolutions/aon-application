<?xml version="1.0"?>
<!DOCTYPE faces-config PUBLIC
  "-//Sun Microsystems, Inc.//DTD JavaServer Faces Config 1.1//EN"
  "http://java.sun.com/dtd/web-facesconfig_1_1.dtd">

<faces-config>

	<!-- ************ FRONT COLLECTIONS ************** -->
	<managed-bean>
		<managed-bean-name>FrontGBPCollections</managed-bean-name>
		<managed-bean-class>com.code.ui.gbp.front.controller.FrontGBPCollectionsController</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
	</managed-bean>

	<!-- ************ FRONT LOGIN ************** -->
	<managed-bean>
		<managed-bean-name>login</managed-bean-name>
		<managed-bean-class>com.code.ui.gbp.front.controller.FrontLoginController</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
	</managed-bean>

	<!-- ************ FRONT SUMMARY ************** -->
	<managed-bean>
		<managed-bean-name>frontSummary</managed-bean-name>
		<managed-bean-class>com.code.ui.gbp.front.controller.FrontSummaryController</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
	</managed-bean>

	<!-- ************ FRONT OFFER ************** -->
	<managed-bean>
		<managed-bean-name>frontOffer</managed-bean-name>
		<managed-bean-class>com.code.ui.gbp.front.controller.FrontOfferController</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
		<managed-property>
			<property-name>queryOnStartUP</property-name>
			<value>true</value>
		</managed-property>
		<managed-property>
			<property-name>pojo</property-name>
			<value>com.code.gbp.Offer</value>
		</managed-property>
		<managed-property>
			<property-name>beanName</property-name>
			<value>frontOffer</value>
		</managed-property>
		<managed-property>
			<property-name>pageLimit</property-name>
			<value>20</value>
		</managed-property>
		<managed-property>
			<property-name>listenerClasses</property-name>
			<list-entries>
				<value-class>com.code.aon.ui.form.event.IControllerListener</value-class>
				<value>#{frontOfferControllerListener}</value>
				<value>#{frontOfferIncidenceListener}</value>
			</list-entries>
		</managed-property>
	</managed-bean>	
	
	<managed-bean>
		<managed-bean-name>frontOfferControllerListener</managed-bean-name>
		<managed-bean-class>
			com.code.ui.gbp.front.event.FrontOfferControllerListener
		</managed-bean-class>
		<managed-bean-scope>none</managed-bean-scope>
	</managed-bean>
	
	<managed-bean>
		<managed-bean-name>frontOfferIncidenceListener</managed-bean-name>
		<managed-bean-class>
			com.code.aon.ui.form.listener.LinesControllerListener
		</managed-bean-class>
		<managed-bean-scope>none</managed-bean-scope>
		<managed-property>
			<property-name>childBean</property-name>
			<value>frontOfferIncidence</value>
		</managed-property>
		<managed-property>
			<property-name>aliasMap</property-name>
			<map-entries>
				<map-entry>
					<key>Incidence_sourceId</key>
                    <value>id</value>
				</map-entry>
			</map-entries>
		</managed-property>
	</managed-bean>

	<!-- ************* FRONT OFFER INCIDENCE ***************** -->
	<managed-bean>
		<managed-bean-name>frontOfferIncidence</managed-bean-name>
		<managed-bean-class>com.code.aon.ui.form.LinesController</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
		<managed-property>
			<property-name>queryOnStartUP</property-name>
			<value>true</value>
		</managed-property>
		<managed-property>
			<property-name>pojo</property-name>
			<value>com.code.gbp.Incidence</value>
		</managed-property>
		<managed-property>
			<property-name>cascadeDelete</property-name>
			<value>true</value>
		</managed-property>
		<managed-property>
			<property-name>masterControllerName</property-name>
			<value>frontOffer</value>
		</managed-property>
		<managed-property>
			<property-name>propertyMap</property-name>
			<map-entries>
				<map-entry>
					<key>id</key>
					<value>sourceId</value>
				</map-entry>
			</map-entries>
		</managed-property>
		<managed-property>
			<property-name>listenerClasses</property-name>
			<list-entries>
				<value-class>com.code.aon.ui.form.event.IControllerListener</value-class>
				<value>#{frontOfferIncidenceControllerListener}</value>
			</list-entries>
		</managed-property>
	</managed-bean>
	
	<managed-bean>
		<managed-bean-name>frontOfferIncidenceControllerListener</managed-bean-name>
		<managed-bean-class>
			com.code.ui.gbp.front.event.FrontOfferIncidenceControllerListener
		</managed-bean-class>
		<managed-bean-scope>none</managed-bean-scope>
	</managed-bean>
	
	<!-- ************ FRONT PRO FORMA ************** -->
	<managed-bean>
		<managed-bean-name>frontProForma</managed-bean-name>
		<managed-bean-class>com.code.ui.gbp.front.controller.FrontProFormaInvoiceController</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
		<managed-property>
			<property-name>queryOnStartUP</property-name>
			<value>true</value>
		</managed-property>
		<managed-property>
			<property-name>pojo</property-name>
			<value>com.code.gbp.ProFormaInvoice</value>
		</managed-property>
		<managed-property>
			<property-name>beanName</property-name>
			<value>frontProForma</value>
		</managed-property>
		<managed-property>
			<property-name>pageLimit</property-name>
			<value>20</value>
		</managed-property>
		<managed-property>
			<property-name>listenerClasses</property-name>
			<list-entries>
				<value-class>com.code.aon.ui.form.event.IControllerListener</value-class>
				<value>#{frontProFormaControllerListener}</value>
				<value>#{frontProFormaIncidenceListener}</value>
			</list-entries>
		</managed-property>
	</managed-bean>	
	
	<managed-bean>
		<managed-bean-name>frontProFormaControllerListener</managed-bean-name>
		<managed-bean-class>
			com.code.ui.gbp.front.event.FrontProFormaInvoiceControllerListener
		</managed-bean-class>
		<managed-bean-scope>none</managed-bean-scope>
	</managed-bean>
	
	<managed-bean>
		<managed-bean-name>frontProFormaIncidenceListener</managed-bean-name>
		<managed-bean-class>
			com.code.aon.ui.form.listener.LinesControllerListener
		</managed-bean-class>
		<managed-bean-scope>none</managed-bean-scope>
		<managed-property>
			<property-name>childBean</property-name>
			<value>frontProFormaIncidence</value>
		</managed-property>
		<managed-property>
			<property-name>aliasMap</property-name>
			<map-entries>
				<map-entry>
					<key>Incidence_sourceId</key>
                    <value>id</value>
				</map-entry>
			</map-entries>
		</managed-property>
	</managed-bean>

	<!-- ************* FRONT PRO FORMA INCIDENCE ***************** -->
	<managed-bean>
		<managed-bean-name>frontProFormaIncidence</managed-bean-name>
		<managed-bean-class>com.code.aon.ui.form.LinesController</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
		<managed-property>
			<property-name>queryOnStartUP</property-name>
			<value>true</value>
		</managed-property>
		<managed-property>
			<property-name>pojo</property-name>
			<value>com.code.gbp.Incidence</value>
		</managed-property>
		<managed-property>
			<property-name>cascadeDelete</property-name>
			<value>true</value>
		</managed-property>
		<managed-property>
			<property-name>masterControllerName</property-name>
			<value>frontProForma</value>
		</managed-property>
		<managed-property>
			<property-name>propertyMap</property-name>
			<map-entries>
				<map-entry>
					<key>id</key>
					<value>sourceId</value>
				</map-entry>
			</map-entries>
		</managed-property>
		<managed-property>
			<property-name>listenerClasses</property-name>
			<list-entries>
				<value-class>com.code.aon.ui.form.event.IControllerListener</value-class>
				<value>#{frontProFormaIncidenceControllerListener}</value>
			</list-entries>
		</managed-property>
	</managed-bean>
	
	<managed-bean>
		<managed-bean-name>frontProFormaIncidenceControllerListener</managed-bean-name>
		<managed-bean-class>
			com.code.ui.gbp.front.event.FrontProFormaInvoiceIncidenceControllerListener
		</managed-bean-class>
		<managed-bean-scope>none</managed-bean-scope>
	</managed-bean>	
	
	<!-- ************ FRONT PROOF ************** -->
	<managed-bean>
		<managed-bean-name>frontProof</managed-bean-name>
		<managed-bean-class>com.code.ui.gbp.front.controller.FrontProofController</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
		<managed-property>
			<property-name>queryOnStartUP</property-name>
			<value>true</value>
		</managed-property>
		<managed-property>
			<property-name>pojo</property-name>
			<value>com.code.gbp.ProFormaInvoice</value>
		</managed-property>
		<managed-property>
			<property-name>beanName</property-name>
			<value>frontProof</value>
		</managed-property>
		<managed-property>
			<property-name>pageLimit</property-name>
			<value>20</value>
		</managed-property>
		<managed-property>
			<property-name>listenerClasses</property-name>
			<list-entries>
				<value-class>com.code.aon.ui.form.event.IControllerListener</value-class>
				<value>#{frontProofControllerListener}</value>
			</list-entries>
		</managed-property>
	</managed-bean>	
	
	<managed-bean>
		<managed-bean-name>frontProofControllerListener</managed-bean-name>
		<managed-bean-class>
			com.code.ui.gbp.front.event.FrontProofControllerListener
		</managed-bean-class>
		<managed-bean-scope>none</managed-bean-scope>
	</managed-bean>
	
</faces-config>