
#/bin/sh


function link(){
        LIBRARY=$1;
        JAR=$(find /usr/share/java -name "${LIBRARY}-*.jar");
        [ ! -z $JAR  ] && ln -sf $JAR /usr/share/java/${LIBRARY}.jar;
}



link aon-master
link slf4j-api
link slf4j-jcl
link commons-lang

ln -sf  /usr/share/aon-master/bin/automysqlbackup.sh /etc/cron.daily/automysqlbackup

. aondir-functions

CLASSPATH=/usr/share/java/mysql-connector-java.jar
CLASSPATH=$CLASSPATH:/usr/share/java/aon-dbutils.jar:/usr/share/java/aon-master.jar
CLASSPATH=$CLASSPATH:/usr/share/java/slf4j-jcl.jar:/usr/share/java/slf4j-api.jar
CLASSPATH=$CLASSPATH:/usr/share/java/commons-logging.jar:/usr/share/java/commons-lang.jar



for db_connection in $(aondir_db_connections); do

        URL=$(perl -e 'if ("'$db_connection'"=~ /([^?]*)/) { print "$1\n" }');
        DB=$(perl -e 'if ("'$db_connection'"=~ /jdbc:mysql:\/\/\d+.\d+.\d+.\d+:\d+\/([^?]*)/) { print "$1\n" }');

        echo -n "Actualizando '$DB'..." ;
        ERR=$(java -classpath $CLASSPATH com.code.aon.master.Main $URL  dbuser serubd2000 com.mysql.jdbc.Driver 2>&1);
        [ $? -eq 0 ] && echo -e "\\033[1;32mOK\\033[0;39m" || echo -e "\\033[1;31mERROR $ERR\\033[0;39m";

done






