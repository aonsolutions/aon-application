<?xml version="1.0" encoding="UTF-8"?>
<table tableName="pcategory">
    <columns>
        <column label="Identificador unico de la Categoria" name="id"
            sqlType="integer" type="integer"/>
        <column label="Nombre de la Categoria" length="32" name="name"
            sqlType="varchar" type="string"/>
        <column label="Patron para los detalles de Articulos"
            length="64" name="detail_pattern" sqlType="varchar" type="string"/>
        <column label="Identificador del Grupo de Categorias"
            name="pcategory_group" sqlType="integer" type="integer"/>
    </columns>
    <virtualColumns/>
    <primaryKey>
        <column name="id"/>
    </primaryKey>
    <joins>
        <join description="pcategory_fk_1" foreignPath="data/pcategory_group.exdm.xml">
            <sourceColumns>
                <column name="pcategory_group"/>
            </sourceColumns>
        </join>
    </joins>
    <descriptionColumns/>
</table>
