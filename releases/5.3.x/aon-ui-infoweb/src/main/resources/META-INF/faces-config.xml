<faces-config version="1.2"
	xmlns="http://java.sun.com/xml/ns/javaee"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://java.sun.com/xml/ns/javaee http://java.sun.com/xml/ns/javaee/web-facesconfig_1_2.xsd">

	<application>
		<resource-bundle>
			<base-name>com.code.aon.ui.infoweb.i18n.messages</base-name>
			<var>infowebBundle</var>
		</resource-bundle>
	</application>

	<!-- **** COMPANY WEB INFO **** --> 
	<managed-bean>
		<managed-bean-name>companyWebInfo</managed-bean-name>
		<managed-bean-class>
			com.code.aon.ui.infoweb.controller.CompanyWebInfoController
		</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
		<managed-property>
			<property-name>pojo</property-name>
			<value>com.code.aon.infoweb.WebInfo</value>
		</managed-property>
		<managed-property>
			<property-name>beanName</property-name>
			<value>companyWebInfo</value>
		</managed-property>
		<managed-property>
			<property-name>listenerClasses</property-name>
			<list-entries>
				<value-class>com.code.aon.ui.form.event.IControllerListener</value-class>
				<value>#{webInfoControllerListener}</value>
			</list-entries>
		</managed-property>
	</managed-bean>


	<managed-bean>
		<managed-bean-name>webPage</managed-bean-name>
		<managed-bean-class>com.code.aon.ui.infoweb.controller.CompanyWebInfoPageController</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
		<managed-property>
			<property-name>queryOnStartUP</property-name>
			<value>true</value>
		</managed-property>
		<managed-property>
			<property-name>pojo</property-name>
			<value>com.code.aon.infoweb.WebInfoPage</value>
		</managed-property>
		<managed-property>
			<property-name>beanName</property-name>
			<value>webPage</value>
		</managed-property>		
		<managed-property>
			<property-name>defaultOrder</property-name>
			<value>WebInfoPage_position</value>
		</managed-property>
		<managed-property>
			<property-name>listenerClasses</property-name>
			<list-entries>
				<value-class>com.code.aon.ui.form.event.IControllerListener</value-class>
				<value>#{webPageControllerListener}</value>
			</list-entries>
		</managed-property>
	</managed-bean>

	<managed-bean>
		<managed-bean-name>webPageControllerListener</managed-bean-name>
		<managed-bean-class>com.code.aon.ui.infoweb.event.CompanyWebInfoPageControllerListener</managed-bean-class>
		<managed-bean-scope>none</managed-bean-scope>
	</managed-bean>

	<managed-bean>
		<managed-bean-name>webPageStyle</managed-bean-name>
		<managed-bean-class>com.code.aon.ui.infoweb.controller.CompanyWebInfoStyleController</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
		<managed-property>
			<property-name>pojo</property-name>
			<value>com.code.aon.infoweb.WebInfoStyle</value>
		</managed-property>
		<managed-property>
			<property-name>beanName</property-name>
			<value>webPageStyle</value>
		</managed-property>				
	</managed-bean>

	<!-- ******************
		COLLECTIONS CONTROLLER
		*******************  	 -->
	<managed-bean>
		<managed-bean-name>webinfoCollections</managed-bean-name>
		<managed-bean-class>com.code.aon.ui.infoweb.controller.CollectionsController</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
	</managed-bean>

	<managed-bean>
		<managed-bean-name>generator</managed-bean-name>
		<managed-bean-class>com.code.aon.ui.infoweb.controller.GeneratorController</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
	</managed-bean>

	<navigation-rule>
		<navigation-case>
			<from-outcome>companyWebInfo</from-outcome>
			<to-view-id>/com/code/aon/ui/infoweb/facelet/companyWebInfo/form.xhtml</to-view-id>
		</navigation-case>
		<navigation-case>
			<from-outcome>webPage</from-outcome>
			<to-view-id>/com/code/aon/ui/infoweb/facelet/webPage/form.xhtml</to-view-id>
		</navigation-case>
		<navigation-case>
			<from-outcome>webPageStyle</from-outcome>
			<to-view-id>/com/code/aon/ui/infoweb/facelet/webPageStyle/form.xhtml</to-view-id>
		</navigation-case>
		<navigation-case>
			<from-outcome>generator</from-outcome>
			<to-view-id>/com/code/aon/ui/infoweb/facelet/generator/form.xhtml</to-view-id>
		</navigation-case>
	</navigation-rule>
	
</faces-config>