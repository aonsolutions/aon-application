<?xml version="1.0" encoding="UTF-8"?>
<table tableName="composition_detail">
    <columns>
        <column
            label="Identificador unico del Detalle de la Composicion"
            name="id" sqlType="integer" type="integer"/>
        <column label="Identificador de la Composicion"
            name="composition" sqlType="integer" type="integer"/>
        <column label="Identificador del Articulo subproducto"
            name="item" sqlType="integer" type="integer"/>
        <column label="Descripcion del Articulo subproducto" length="64"
            name="description" sqlType="varchar" type="string"/>
        <column label="Cantidad de Articulo subproducto" name="quantity"
            sqlType="double" type="double"/>
        <column label="Precio del Articulo subproducto" name="price"
            sqlType="double" type="double"/>
    </columns>
    <virtualColumns/>
    <primaryKey>
        <column name="id"/>
    </primaryKey>
    <joins>
        <join description="composition_detail_ibfk_1" foreignPath="data/composition.exdm.xml">
            <sourceColumns>
                <column name="composition"/>
            </sourceColumns>
        </join>
        <join description="composition_detail_ibfk_2" foreignPath="data/item.exdm.xml">
            <sourceColumns>
                <column name="item"/>
            </sourceColumns>
        </join>
    </joins>
    <descriptionColumns/>
</table>
