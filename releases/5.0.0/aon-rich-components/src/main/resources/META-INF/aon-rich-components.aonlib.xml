<?xml version="1.0"?>
<components namespace="http://www.code.es/aon-rich-components">

	<component localName="lookupInputText">
    	<attribute name="styleClass" value="aon-lookupInputText" />
	</component>
	
	<component localName="lookupButton">
    	<attribute name="immediate" value="true" type="1" />
	</component>
	
	<component localName="lookupButtonPopup">
    	<attribute name="styleClass" value="aon-lookupButtonPopup" />
	</component>
	
	<component localName="confirmButton">
    	<attribute name="styleClass" value="aon-confirmButton" />
	</component>

	<component localName="selectInputDate">
    	<attribute name="popupDateFormat" alias="datePattern" />			
    	<attribute name="renderAsPopup" alias="popup" value="true" type="1" />
    	<attribute name="todayControlMode" value="hidden"/>    	
    	<attribute name="partialSubmit" value="ondateselected" ignore="true" />
    	<attribute name="inputClass" value="aon-selectInputDate-inputClass" />
    	<attribute name="disabledStyleClass" value="aon-selectInputDate-inputClass-disabled" />
    	<attribute name="buttonClass" value="aon-selectInputDate-buttonClass" />
    	<attribute name="inputSize" value="10" type="2" />
    	<attribute name="enableManualInput" value="true" type="1" />    	
	</component>
	
	<component localName="div">
    	<attribute name="layout" value="block"/>			
	</component>

	<component localName="panelGrid">
    	<attribute name="styleClass" value="aon-panelGrid" />
    	<attribute name="cellpadding" value="0" />	
    	<attribute name="cellspacing" value="0" />		
    	<attribute name="columnClasses" value="aon-panelGrid-odd,aon-panelGrid-even" />    		
	</component>

	<component localName="graphicImage">
    	<attribute name="styleClass" value="aon-graphicImage" />			
	</component>

	<component localName="outputText">
    	<attribute name="styleClass" value="aon-outputText" />			
	</component>

	<component localName="outputLabel">
    	<attribute name="styleClass" value="aon-outputLabel" />			
	</component>

	<component localName="form">
    	<attribute name="styleClass" value="aon-form" />			
	</component>

	<component localName="messages">
    	<attribute name="showSummary" value="false" type="1" />			
    	<attribute name="showDetail" value="true" type="1" />
    	<attribute name="errorClass" value="aon-message-error" />
    	<attribute name="fatalClass" value="aon-message-fatal-error" />
    	<attribute name="infoClass" value="aon-message-info" />
	</component>

	<component localName="commandButton">
    	<attribute name="styleClass" value="aon-commandButton" />
    	<attribute name="reRender" value="aonContent" />			
	</component>

	<component localName="commandLink">
    	<attribute name="styleClass" value="aon-commandLink" />
    	<attribute name="disabledStyleClass" value="aon-commandLink-disabled" />			
    	<attribute name="reRender" value="aonContent" />
	</component>
	
	<component localName="panelTabSet">
    	<attribute name="switchType" value="ajax" />
    	<attribute name="styleClass" value="aon-panelTabSet" />		
    	<attribute name="contentClass" value="aon-panelTabSet-contentClass" /> 
    	<attribute name="disabledTabClass" value="aon-panelTabSet-disabledTabClass" /> 
    	<attribute name="headerClass" value="aon-panelTabSet-headerClass" />
    	<attribute name="inactiveTabClass" value="aon-panelTabSet-inactiveTabClass" />
    	<attribute name="tabClass" value="aon-panelTabSet-tabClass" />		
	</component>

	<component localName="panelTab">
		<attribute name="styleClass" value="aon-panelTab" />
	</component>
	
	<component localName="inputText">
    	<attribute name="styleClass" value="aon-inputText" />
		<attribute name="disabledStyleClass" value="aon-inputText-disabled" />
	</component>

	<component localName="inputTextarea">
    	<attribute name="styleClass" value="aon-inputTextarea" />
    	<attribute name="disabledStyleClass" value="aon-inputText-disabled" />			
	</component>

	<component localName="inputRichText">
    	<attribute name="styleClass" value="aon-inputRichText" />
    	<attribute name="language" value="#{facesContext.application.defaultLocale.language}" />			
	</component>

	<component localName="inputSecret">
    	<attribute name="styleClass" value="aon-inputSecret" />
    	<attribute name="disabledStyleClass" value="aon-inputText-disabled" />			
	</component>

	<component localName="selectOneMenu">
    	<attribute name="styleClass" value="aon-selectOneMenu" />			
	</component>

	<component localName="selectOneRadio">
    	<attribute name="styleClass" value="aon-selectOneRadio" />
    	<attribute name="partialSubmit" value="onclick" ignore="true"/>			
	</component>

	<component localName="selectBooleanCheckbox">
    	<attribute name="styleClass" value="aon-selectBooleanCheckbox" />
		<attribute name="partialSubmit" value="onclick" ignore="true" />    				
	</component>

	<component localName="selectManyCheckbox">
    	<attribute name="styleClass" value="aon-selectManyCheckbox" />			
    	<attribute name="partialSubmit" value="onclick" ignore="true" />		    	
	</component>

	<component localName="dataTable">
    	<attribute name="styleClass" value="aon-dataTable" />			
    	<attribute name="headerClass" value="aon-dataTable-header" />
    	<attribute name="footerClass" value="aon-dataTable-footer" />    	
    	<attribute name="rowClasses" value="aon-dataTable-row-odd, aon-dataTable-row-even" />
    	<attribute name="cellpadding" value="0" />
    	<attribute name="cellspacing" value="0" />
	</component>

	<component localName="extendedDataTable">
    	<attribute name="headerClass" value="aon-dataTable-header" />
    	<attribute name="footerClass" value="aon-dataTable-footer" />    	
    	<attribute name="rowClasses" value="aon-dataTable-row-odd, aon-dataTable-row-even" />
    	<attribute name="cellpadding" value="0" />
    	<attribute name="cellspacing" value="0" />
	</component>

	<component localName="editDataTable">
    	<attribute name="styleClass" value="aon-editDataTable" />			
    	<attribute name="headerClass" value="aon-editDataTable-header" />
    	<attribute name="footerClass" value="aon-editDataTable-footer" />
    	<attribute name="rowClasses" value="aon-editDataTable-row-odd, aon-editDataTable-row-even" />
    	<attribute name="cellpadding" value="0" />
    	<attribute name="cellspacing" value="0" />
	</component>

	<component localName="dataPaginator">
    	<attribute name="paginatorMaxPages" alias="maxPages" />			
    	<attribute name="pageCountVar" alias="pagesVar" />
    	<attribute name="paginator" ignore="true" />
    	<attribute name="inactiveStyleClass" value="aon-dataScroller-inactive" />
    	<attribute name="selectedStyleClass" value="aon-dataScroller-selected" />
    	<attribute name="ajaxSingle" value="false" type="1" />
	</component>

	<component localName="rowSelector">
    	<attribute name="multiple" ignore="true" />
    	<attribute name="selectedClass" ignore="true" />
    	<attribute name="mouseOverClass" ignore="true" />
    	<attribute name="event" value="onRowClick" />
    	<attribute name="toggleOnClick" alias="rendered" />
    	<attribute name="reRender" value="aonContent" />
	</component>

	<component localName="mediaOutput">
    	<attribute name="styleClass" value="aon-border" />			
	</component>

	<component localName="menuBar">
    	<attribute name="styleClass" value="aon-menuBar" />			
    	<attribute name="contentClass" value="aon-menuBar-content" />
    	<attribute name="itemSeparator" value="line" />
	</component>
	
	<component localName="dropDownMenu">  
		<attribute name="styleClass" value="aon-dropDownMenu" /> 			
    	<attribute name="itemClass" value="aon-dropDownMenu-item" />
    	<attribute name="selectItemClass" value="aon-dropDownMenu-selectItem" />
    	<attribute name="disabledItemClass" value="aon-dropDownMenu-disabledItem" />   		
    	<attribute name="event" value="onclick" />
	</component>
	
	<component localName="menuGroup">
		<attribute name="styleClass" value="aon-menuGroup-styleClass" /> 
	</component>
	
	<component localName="menuItem">
		<attribute name="styleClass" value="aon-menuItem-styleClass" /> 
		<attribute name="iconClass" value="aon-menuItem-iconClass" />
		<attribute name="selectClass" value="aon-menuItem-selectClass" /> 				
		<attribute name="submitMode" value="ajax" />       
		<attribute name="immediate" value="true" type="1" />
		<attribute name="reRender" value="aonContent" />
	</component>
	
	<component localName="panelCollapsible">
    	<attribute name="switchType" value="ajax" />
    	<attribute name="expanded" alias="opened" />
		<attribute name="styleClass" value="aon-portlet" /> 
		<attribute name="headerClass" value="aon-portlet-title" /> 
		<attribute name="bodyClass" value="aon-portlet-body" /> 	
	</component>
	
	<component localName="panel">
		<attribute name="styleClass" value="aon-group" /> 
		<attribute name="headerClass" value="aon-group-title" /> 
		<attribute name="bodyClass" value="aon-group-body" /> 	
	</component>

	<component localName="fileUpload">
    	<attribute name="addControlLabel" value="#{bundle.aon_fileUpload_add}" />
    	<attribute name="stopControlLabel" value="#{bundle.aon_fileUpload_stop}" />
    	<attribute name="stopEntryControlLabel" value="#{bundle.aon_fileUpload_stop}" />
    	<attribute name="uploadControlLabel" value="#{bundle.aon_fileUpload_upload}" />
    	<attribute name="listHeight" value="0px" />
    	<attribute name="immediateUpload" value="true" type="1" />    	
    	<attribute name="autoclear" value="true" type="1" />
	</component>
</components>