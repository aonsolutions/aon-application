<?xml version="1.0" encoding="ISO-8859-1"?>

<!DOCTYPE report-config 
	PUBLIC "-//CODE-AON//DTD Report Config//EN" 
	"http://co-de.com/aon/report-config.dtd">

<report-config>
	<default-config>
		<fetch-mode paginated="false" />
	</default-config>

	<!-- *********** PROOF *************** -->
	<report id="proof" description="Proof report">
		<template path="/com/code/ui/gbp/report/proof.jasper" />
		<collection provider="#{frontProof}"/>
		<params>
			<param id="REPORT_RESOURCE_BUNDLE" value="com.code.ui.gbp.i18n.messages" />
			<param id="signatures" value="#{frontProof.getSignatures}" />
			<param id="banks" value="#{frontProof.getBanks}" />
		</params>
		<nested-report report="proofSignatures"/>
		<nested-report report="proofBanks"/>
	</report>
	
	<report id="proofSignatures" description="proofSignatures">
		<template path="/com/code/ui/gbp/report/proofSignatures.jasper"/>
	</report>

	<!-- *********** PRO FORMA INVOICE ************* -->
	<report id="proforma" description="Proforma report">
		<template path="/com/code/ui/gbp/report/proof.jasper" />
		<collection provider="#{proForma}"/>
		<params>
			<param id="REPORT_RESOURCE_BUNDLE" value="com.code.ui.gbp.i18n.messages" />
			<param id="signatures" value="#{proForma.getSignatures}" />
			<param id="banks" value="#{proForma.getBanks}" />
		</params>
		<nested-report report="proofSignatures"/>
		<nested-report report="proofBanks"/>
	</report>
	
	<report id="proofSignatures" description="proofSignatures">
		<template path="/com/code/ui/gbp/report/proofSignatures.jasper"/>
	</report>
	<report id="proofBanks" description="proofBanks">
		<template path="/com/code/ui/gbp/report/proofBanks.jasper"/>
	</report>
	
	<!--  *********  SUPPLIER LIST  ********* -->
	<report id="suppliers" description="Suppliers report">
		<template path="/com/code/ui/gbp/report/suppliers.jasper" />
		<bean key="com.code.gbp.Supplier" />
		<criteria provider="#{supplier}" />
		<params>
			<param id="REPORT_RESOURCE_BUNDLE" value="com.code.ui.gbp.i18n.messages" />
		</params>
	</report>
	
	<!--  *********  SUPPLIER TO  ********* -->
	<report id="supplier_to" description="Supplier report">
		<template path="/com/code/ui/gbp/report/supplier_to.jasper" />
		<collection provider="#{supplierToReport}"/>
		<params>
			<param id="REPORT_RESOURCE_BUNDLE" value="com.code.ui.gbp.i18n.messages" />
		</params>
		<nested-report report="supplier_addinfos"/>
		<nested-report report="supplier_contacts"/>
		<nested-report report="supplier_campaigns"/>
		<nested-report report="supplier_economicDatas"/>
		<nested-report report="supplier_observations"/>
		<nested-report report="supplier_contactPersons"/>
	</report>
	
	<report id="supplier_addinfos" description="supplier_addinfos">
		<template path="/com/code/ui/gbp/report/supplier_addinfos.jasper"/>
	</report>
	
	<report id="supplier_contacts" description="supplier_contacts">
		<template path="/com/code/ui/gbp/report/supplier_contacts.jasper"/>
	</report>
	
	<report id="supplier_campaigns" description="supplier_contacts">
		<template path="/com/code/ui/gbp/report/supplier_campaigns.jasper"/>
	</report>
	
	<report id="supplier_economicDatas" description="supplier_contacts">
		<template path="/com/code/ui/gbp/report/supplier_economicDatas.jasper"/>
	</report>
	
	<report id="supplier_observations" description="supplier_observations">
		<template path="/com/code/ui/gbp/report/supplier_observations.jasper"/>
	</report>
	
	<report id="supplier_contactPersons" description="supplier_contactPersons">
		<template path="/com/code/ui/gbp/report/supplier_contactPersons.jasper"/>
	</report>
	
	<!--  *********  CAMPAIGN LIST  ********* -->
	<report id="campaigns" description="Campaigns report">
		<template path="/com/code/ui/gbp/report/campaigns.jasper" />
		<bean key="com.code.gbp.Campaign" />
		<criteria provider="#{campaign}" />
		<params>
			<param id="REPORT_RESOURCE_BUNDLE" value="com.code.ui.gbp.i18n.messages" />
		</params>
	</report>
	
	<!--  *********  CAMPAIGN TO  ********* -->
	<report id="campaign_to" description="Campaign report">
		<template path="/com/code/ui/gbp/report/campaign_to.jasper" />
		<collection provider="#{campaignToReport}"/>
		<params>
			<param id="REPORT_RESOURCE_BUNDLE" value="com.code.ui.gbp.i18n.messages" />
		</params>
		<nested-report report="campaign_suppliers"/>
	</report>
	
	<report id="campaign_suppliers" description="campaign_suppliers">
		<template path="/com/code/ui/gbp/report/campaign_suppliers.jasper"/>
	</report>
	
	<!--  *********  OFFER LIST  ********* -->
	<report id="offers" description="Offers report">
		<template path="/com/code/ui/gbp/report/offers.jasper" />
		<bean key="com.code.gbp.Offer" />
		<criteria provider="#{offer}" />
		<params>
			<param id="REPORT_RESOURCE_BUNDLE" value="com.code.ui.gbp.i18n.messages" />
		</params>
	</report>
	
	<!--  *********  OFFER TO  ********* -->
	<report id="offer_to" description="Offer report">
		<template path="/com/code/ui/gbp/report/offer_to.jasper" />
		<collection provider="#{offerToReport}"/>
		<params>
			<param id="REPORT_RESOURCE_BUNDLE" value="com.code.ui.gbp.i18n.messages" />
		</params>
		<nested-report report="offer_incidences"/>
		<nested-report report="offer_signatures"/>
	</report>
	
	<report id="offer_incidences" description="offer_incidences">
		<template path="/com/code/ui/gbp/report/offer_incidences.jasper"/>
	</report>
	
	<report id="offer_signatures" description="offer_signatures">
		<template path="/com/code/ui/gbp/report/offer_signatures.jasper"/>
	</report>
	
	<!--  ********* PROFORMAINVOICES LIST  ********* -->
	<report id="proFormaInvoices" description="ProFormaInvoices report">
		<template path="/com/code/ui/gbp/report/proFormaInvoices.jasper" />
		<bean key="com.code.gbp.ProFormaInvoice" />
		<criteria provider="#{proForma}" />
		<params>
			<param id="REPORT_RESOURCE_BUNDLE" value="com.code.ui.gbp.i18n.messages" />
		</params>
	</report>

	<!--  *********  PROFORMAINVOICES TO  ********* -->
	<report id="proForma_to" description="proForma report">
		<template path="/com/code/ui/gbp/report/proForma_to.jasper" />
		<collection provider="#{proFormaToReport}"/>
		<params>
			<param id="REPORT_RESOURCE_BUNDLE" value="com.code.ui.gbp.i18n.messages" />
		</params>
		<nested-report report="offer_incidences"/>
		<nested-report report="offer_signatures"/>
		<nested-report report="proForma_banks"/>
	</report>

	<report id="proForma_banks" description="proForma_banks">
		<template path="/com/code/ui/gbp/report/proForma_banks.jasper"/>
	</report>
	
	<!--  *********  ESTADISTICAS ********* -->
	<report id="supplier_evolution_stat" description="Evolucion de proveedores">
		<template path="/com/code/ui/gbp/stats/supplierEvolution.jasper" />
		<collection provider="#{supplierEvolutionReport}"/>
		<params>
			<param id="REPORT_RESOURCE_BUNDLE" value="com.code.ui.gbp.i18n.messages" />
			<param id="INIT_DATE" value="#{supplierEvolutionReport.getFromDate}" />
			<param id="END_DATE" value="#{supplierEvolutionReport.getToDate}" />
		</params>
	</report>

	<report id="campaign_evolution_stat" description="Evolucion de Campanyas">
		<template path="/com/code/ui/gbp/stats/campaignEvolution.jasper" />
		<collection provider="#{campaignEvolutionReport}"/>
		<params>
			<param id="REPORT_RESOURCE_BUNDLE" value="com.code.ui.gbp.i18n.messages" />
		</params>
	</report>

	<report id="supplier_type_evolution_stat" description="Evolucion de tipos de proveedores">
		<template path="/com/code/ui/gbp/stats/supplierTypeEvolution.jasper" />
		<collection provider="#{supplierTypeEvolutionReport}"/>
		<params>
			<param id="REPORT_RESOURCE_BUNDLE" value="com.code.ui.gbp.i18n.messages" />
			<param id="INIT_DATE" value="#{supplierTypeEvolutionReport.getFromDate}" />
			<param id="END_DATE" value="#{supplierTypeEvolutionReport.getToDate}" />
		</params>
	</report>

	<report id="offer_control_stat" description="Offer Control">
		<template path="/com/code/ui/gbp/stats/offerControl.jasper" />
		<collection provider="#{offerControlReport}"/>
		<params>
			<param id="REPORT_RESOURCE_BUNDLE" value="com.code.ui.gbp.i18n.messages" />
			<param id="INIT_DATE" value="#{offerControlReport.getFromDate}" />
			<param id="END_DATE" value="#{offerControlReport.getToDate}" />
			<param id="AREA" value="#{offerControlReport.getArea}" />
		</params>
	</report>

	<report id="invoice_control_stat" description="Invoice Control">
		<template path="/com/code/ui/gbp/stats/invoiceControl.jasper" />
		<collection provider="#{invoiceControlReport}"/>
		<params>
			<param id="REPORT_RESOURCE_BUNDLE" value="com.code.ui.gbp.i18n.messages" />
			<param id="INIT_DATE" value="#{invoiceControlReport.getFromDate}" />
			<param id="END_DATE" value="#{invoiceControlReport.getToDate}" />
		</params>
	</report>

	<report id="campaign_comparer_stat" description="Invoice Control">
		<template path="/com/code/ui/gbp/stats/campaignComparer.jasper" />
		<collection provider="#{campaignComparerReport}"/>
		<params>
			<param id="REPORT_RESOURCE_BUNDLE" value="com.code.ui.gbp.i18n.messages" />
		</params>
	</report>

	<report id="anual_comparer_stat" description="Invoice Control">
		<template path="/com/code/ui/gbp/stats/anualComparer.jasper" />
		<collection provider="#{anualComparerReport}"/>
		<params>
			<param id="REPORT_RESOURCE_BUNDLE" value="com.code.ui.gbp.i18n.messages" />
		</params>
	</report>

	<report id="byarea_evolution_stat" description="Area Evolution">
		<template path="/com/code/ui/gbp/stats/ByAreaEvolution.jasper" />
		<collection provider="#{byAreaEvolutionReport}"/>
		<params>
			<param id="REPORT_RESOURCE_BUNDLE" value="com.code.ui.gbp.i18n.messages" />
			<param id="INIT_DATE" value="#{byAreaEvolutionReport.getFromDate}" />
			<param id="END_DATE" value="#{byAreaEvolutionReport.getToDate}" />
		</params>
	</report>

</report-config>