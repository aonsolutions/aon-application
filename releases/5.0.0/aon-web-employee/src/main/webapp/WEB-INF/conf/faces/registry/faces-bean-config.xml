<?xml version="1.0"?>
<!DOCTYPE faces-config PUBLIC
  "-//Sun Microsystems, Inc.//DTD JavaServer Faces Config 1.1//EN"
  "http://java.sun.com/dtd/web-facesconfig_1_1.dtd">

<faces-config>

	<!--  **** COMPANY **** -->
	<managed-bean>
		<managed-bean-name>company</managed-bean-name>
		<managed-bean-class>com.code.aon.web.employee.controller.CompanyController</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
		<managed-property>
			<property-name>queryOnStartUP</property-name>
			<value>true</value>
		</managed-property>
		<managed-property>
			<property-name>pojo</property-name>
			<value>com.code.aon.company.Company</value>
		</managed-property>
		<managed-property>
			<property-name>listenerClasses</property-name>
			<list-entries>
				<value-class>com.code.aon.ui.form.event.IControllerListener</value-class>
				<value>#{companyLogoControllerListener}</value>
				<value>#{companyControllerListener}</value>
				<value>#{companyAddressListener}</value>
			</list-entries>
		</managed-property>
	</managed-bean>
	
	<managed-bean>
		<managed-bean-name>companyLogoControllerListener</managed-bean-name>
		<managed-bean-class>com.code.aon.ui.company.event.CompanyLogoControllerListener</managed-bean-class>
		<managed-bean-scope>none</managed-bean-scope>
	</managed-bean>

	<managed-bean>
		<managed-bean-name>companyControllerListener</managed-bean-name>
		<managed-bean-class>com.code.aon.ui.company.event.CompanyControllerListener</managed-bean-class>
		<managed-bean-scope>none</managed-bean-scope>
	</managed-bean>

	<managed-bean>
		<managed-bean-name>companyAddressListener</managed-bean-name>
		<managed-bean-class>com.code.aon.ui.company.event.CompanyAddressListener</managed-bean-class>
		<managed-bean-scope>none</managed-bean-scope>
	</managed-bean>

	<managed-bean>
		<managed-bean-name>companyAddress</managed-bean-name>
		<managed-bean-class>com.code.aon.ui.form.BasicController</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
		<managed-property>
			<property-name>pojo</property-name>
			<value>com.code.aon.registry.RegistryAddress</value>
		</managed-property>
		<managed-property>
			<property-name>listenerClasses</property-name>
			<list-entries>
				<value-class>com.code.aon.ui.form.event.IControllerListener</value-class>
				<value>#{companyRegistryChildListener}</value>
				<value>#{companyAddressListener}</value>
			</list-entries>
		</managed-property>
	</managed-bean>

	<managed-bean>
		<managed-bean-name>companyRegistryChildListener</managed-bean-name>
		<managed-bean-class>com.code.aon.ui.form.listener.ChildControllerListener</managed-bean-class>
		<managed-bean-scope>none</managed-bean-scope>
		<managed-property>
			<property-name>masterBean</property-name>
			<value>company</value>
		</managed-property>
		<managed-property>
			<property-name>masterPropertyName</property-name>
			<value>registry</value>
		</managed-property>
	</managed-bean>

</faces-config>