<?xml version="1.0"?>
<!DOCTYPE faces-config PUBLIC
  "-//Sun Microsystems, Inc.//DTD JavaServer Faces Config 1.1//EN"
  "http://java.sun.com/dtd/web-facesconfig_1_1.dtd">

<faces-config>

    <managed-bean>
        <managed-bean-name>calendarManager</managed-bean-name>
        <managed-bean-class>com.code.aon.ui.planner.CalendarManagerBean</managed-bean-class>
        <managed-bean-scope>application</managed-bean-scope>
    </managed-bean>

	<managed-bean>
		<managed-bean-name>planner</managed-bean-name>
		<managed-bean-class>com.code.aon.ui.planner.PlannerController</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
        <managed-property>
            <property-name>mode</property-name>
            <value>1</value>
        </managed-property>
        <managed-property>
            <property-name>theme</property-name>
            <value>evolution</value>
        </managed-property>
        <managed-property>
            <property-name>readonly</property-name>
            <value>false</value>
        </managed-property>
        <managed-property>
            <property-name>tooltip</property-name>
            <value>true</value>
        </managed-property>
        <managed-property>
            <property-name>detailedRowHeight</property-name>
            <value>26</value>
        </managed-property>
	</managed-bean>

    <managed-bean>
    	<managed-bean-name>plannerEntryRenderer</managed-bean-name>
    	<managed-bean-class>com.code.aon.ui.planner.renderer.ScheduleEntryRenderer</managed-bean-class>
    	<managed-bean-scope>application</managed-bean-scope>
    </managed-bean>

    <managed-bean>
        <managed-bean-name>workingTime</managed-bean-name>
        <managed-bean-class>com.code.aon.ui.planner.WorkingTimeController</managed-bean-class>
        <managed-bean-scope>session</managed-bean-scope>
    </managed-bean>

    <managed-bean>
        <managed-bean-name>event</managed-bean-name>
        <managed-bean-class>com.code.aon.ui.planner.EventManager</managed-bean-class>
        <managed-bean-scope>session</managed-bean-scope>
		<managed-property>
			<property-name>listenerClasses</property-name>
			<list-entries>
				<value-class>com.code.aon.planner.IPlannerListener</value-class>
				<value>#{workingTime}</value>
				<value>#{calendars}</value>
			</list-entries>
		</managed-property>
    </managed-bean>

	<managed-bean>
		<managed-bean-name>incidences</managed-bean-name>
		<managed-bean-class>com.code.aon.ui.planner.IncidencesController</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
		<managed-property>
			<property-name>listenerClasses</property-name>
			<list-entries>
				<value-class>com.code.aon.ui.form.event.IControllerListener</value-class>
				<value>#{resourceLoaderListener}</value>
			</list-entries>
		</managed-property>
	</managed-bean>

	<managed-bean>
		<managed-bean-name>resourceLoaderListener</managed-bean-name>
		<managed-bean-class>com.code.aon.web.employee.event.PlannerResourceLoaderListener</managed-bean-class>
		<managed-bean-scope>none</managed-bean-scope>
	</managed-bean>

	<managed-bean>
		<managed-bean-name>incidenceType</managed-bean-name>
		<managed-bean-class>com.code.aon.ui.form.BasicController</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
		<managed-property>
			<property-name>queryOnStartUP</property-name>
			<value>true</value>
		</managed-property>
		<managed-property>
			<property-name>pojo</property-name>
			<value>com.code.aon.planner.core.IncidenceType</value>
		</managed-property>
		<managed-property>
			<property-name>pageLimit</property-name>
			<value>20</value>
		</managed-property>
	</managed-bean>

</faces-config>