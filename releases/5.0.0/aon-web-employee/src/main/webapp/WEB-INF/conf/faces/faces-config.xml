	    <to-view-id>/facelet/calendars/yearly_calendar.faces</to-view-id>
	</navigation-case>
	<navigation-case>
      	<from-outcome>calendars_form</from-outcome>
	    <to-view-id>/facelet/calendars/form.faces</to-view-id>
	</navigation-case>
	<navigation-case>
      	<from-outcome>incidences_form</from-outcome>
	    <to-view-id>/facelet/calendars/incidences.faces</to-view-id>
	</navigation-case>
	<navigation-case>
      	<from-outcome>incidence</from-outcome>
	    <to-view-id>/facelet/configuration/incidence/grid.faces</to-view-id>
	</navigation-case>
	<navigation-case>
      	<from-outcome>expenditures</from-outcome>
	    <to-view-id>/facelet/configuration/expenditures/grid.faces</to-view-id>
	</navigation-case>
	<navigation-case>
      	<from-outcome>evaluate</from-outcome>
	    <to-view-id>/facelet/configuration/evaluate/grid.faces</to-view-id>
	</navigation-case>
	<navigation-case>
      	<from-outcome>company</from-outcome>
	    <to-view-id>/facelet/configuration/company/form.faces</to-view-id>
	</navigation-case>
	<navigation-case>
      	<from-outcome>workactivity</from-outcome>
	    <to-view-id>/facelet/configuration/workactivity/list.faces</to-view-id>
	</navigation-case>
	<navigation-case>
      	<from-outcome>department</from-outcome>
	    <to-view-id>/facelet/department/tree.faces</to-view-id>
	</navigation-case>
	<navigation-case>
      	<from-outcome>worker_salary</from-outcome>
	    <to-view-id>/facelet/calculator/workerSalary/param.faces</to-view-id>
	</navigation-case>
	<navigation-case>
      	<from-outcome>expenses_from_gross_salary</from-outcome>
	    <to-view-id>/facelet/calculator/expensesGross/param.faces</to-view-id>
	</navigation-case>
	<navigation-case>
      	<from-outcome>expenses_from_net_salary</from-outcome>
	    <to-view-id>/facelet/calculator/expensesNet/param.faces</to-view-id>
	</navigation-case>
	<navigation-case>
      	<from-outcome>worker_dismissal</from-outcome>
	    <to-view-id>/facelet/calculator/expensesDismissal/param.faces</to-view-id>
	</navigation-case>
  </navigation-rule>

</faces-config>
