		<to-view-id>/facelet/homepage/content.faces</to-view-id>
	</navigation-case>
	 <navigation-case>
        <from-outcome>firstContent</from-outcome>
        <to-view-id>/facelet/homepage/firstContent.faces</to-view-id>
    </navigation-case>
	<navigation-case>
      	<from-outcome>employee</from-outcome>
	    <to-view-id>/facelet/employee/list.faces</to-view-id>
	</navigation-case>
	<navigation-case>
