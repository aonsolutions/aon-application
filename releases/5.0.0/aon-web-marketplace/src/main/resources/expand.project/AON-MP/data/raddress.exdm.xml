<?xml version="1.0" encoding="UTF-8"?>
<table tableName="raddress">
    <columns>
        <column
            label="Identificador unico de la Direccion de la Persona o Empresa"
            name="id" sqlType="integer" type="integer"/>
        <column
            label="Identificador del Registro de la Persona o Empresa"
            name="registry" sqlType="integer" type="integer"/>
        <column label="Tipo de Direccion" length="2" name="type"
            sqlType="tinyint" type="string"/>
        <column label="Destinatario" length="128" name="recipient"
            sqlType="varchar" type="string"/>
        <column label="Tipo de via" length="2" name="street_type"
            sqlType="tinyint" type="string"/>
        <column label="Primera parte de la Direccion" length="128"
            name="address" sqlType="varchar" type="string"/>
        <column label="Segunda parte de la Direccion" length="128"
            name="address2" sqlType="varchar" type="string"/>
        <column label="Tercera parte de la Direccion" length="128"
            name="address3" sqlType="varchar" type="string"/>
        <column label="Codigo Postal" length="16" name="zip"
            sqlType="varchar" type="string"/>
        <column label="Localidad" length="64" name="city"
            sqlType="varchar" type="string"/>
        <column label="Identificador de la Zona Geografica"
            name="geozone" sqlType="integer" type="integer"/>
    </columns>
    <virtualColumns/>
    <primaryKey>
        <column name="id"/>
    </primaryKey>
    <joins>
        <join description="raddress_ibfk_1" foreignPath="data/registry.exdm.xml">
            <sourceColumns>
                <column name="registry"/>
            </sourceColumns>
        </join>
        <join description="raddress_ibfk_2" foreignPath="data/geozone.exdm.xml">
            <sourceColumns>
                <column name="geozone"/>
            </sourceColumns>
        </join>
    </joins>
    <descriptionColumns/>
</table>
