<?xml version="1.0" encoding="UTF-8"?>
<table tableName="production_detail">
    <columns>
        <column label="Identificador unico del Detalle de la Produccion"
            name="id" sqlType="integer" type="integer"/>
        <column label="Identificador de la Produccion" name="production"
            sqlType="integer" type="integer"/>
        <column label="Identificador del Articulo subproducto"
            name="item" sqlType="integer" type="integer"/>
        <column label="Descripcion del Articulo subproducto" length="64"
            name="description" sqlType="varchar" type="string"/>
        <column
            label="Cantidad inicial del Articulo subproducto en la Composicion"
            name="initial_quantity" sqlType="double" type="double"/>
        <column label="Cantidad del Articulo subproducto"
            name="quantity" sqlType="double" type="double"/>
        <column label="Precio del Articulo subproducto" name="price"
            sqlType="double" type="double"/>
    </columns>
    <virtualColumns/>
    <primaryKey>
        <column name="id"/>
    </primaryKey>
    <joins>
        <join description="production_detail_ibfk_1" foreignPath="data/production.exdm.xml">
            <sourceColumns>
                <column name="production"/>
            </sourceColumns>
        </join>
        <join description="production_detail_ibfk_2" foreignPath="data/item.exdm.xml">
            <sourceColumns>
                <column name="item"/>
            </sourceColumns>
        </join>
    </joins>
    <descriptionColumns/>
</table>
