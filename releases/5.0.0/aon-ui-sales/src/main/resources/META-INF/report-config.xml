<?xml version="1.0" encoding="ISO-8859-1"?>

<!DOCTYPE report-config 
	PUBLIC "-//CODE-AON//DTD Report Config//EN" 
	"http://co-de.com/aon/report-config.dtd">

<report-config>
	
		<!--  **********************************************************
						      SALES
		  ********************************************************** -->
	<report id="sales" description="Sales report ">
		<template path="/com/code/aon/ui/sales/report/sales.jasper" />
		<collection provider="#{sales}" forceRefresh="true"/>
		<params>
			<param id="REPORT_RESOURCE_BUNDLE" value="com.code.aon.ui.sales.i18n.report" />
			<param id="logoImageFile" value="#{company.getAttachAsInputStream}" />
			<param id="company" value="#{company.obtainCompany}" />
			<param id="logoImageFile" value="#{company.getAttachAsInputStream}" />
			<param id="recordData" value="#{company.getCompanyRecordData}" />
			<param id="company" value="#{company.obtainCompany}" />
			<param id="phone" value="#{company.obtainPhone}" />
			<param id="fax" value="#{company.obtainFax}" />
			<param id="email" value="#{company.obtainEmail}" />
			<param id="web" value="#{company.obtainWeb}" />
			<param id="address" value="#{company.obtainAddress}" />
			<param id="printRecordData" value="#{company.isPrintRecordData}"/>
			<param id="printHeader" value="#{company.isPrintHeader}" />
			<param id="PriceStrategy" value="#{salesDetail.getPriceStrategy}" />
			<param id="TotalPrice" value="#{sales.getTotalPrice}" />
			<param id="defaultPayMethod" value="#{sales.getDefaultPayMethod}" />
		</params>
		
		<nested-report report="salesDetail"/>
	 	<nested-report report="salesVatBreakDown"/>	
	</report>
		
	<report id="salesDetail" description="Sales Details Subreport">
		<template path="/com/code/aon/ui/sales/report/salesDetail.jasper" />	
	</report>
	
	<report id="salesVatBreakDown" description="VatBreakDown's Subreport">
		<template path="/com/code/aon/ui/sales/report/salesVatBreakDown.jasper"/>
	</report>

	<report id="salesList2" description="Listado de sales">
		<template path="/com/code/aon/ui/sales/report/salesList.jasper" />
		<bean key="com.code.aon.sales.Sales" />
		<criteria provider="#{sales}"/>
		<params>
			<param id="REPORT_RESOURCE_BUNDLE" value="com.code.aon.ui.sales.i18n.report" />
			<param id="company" value="#{company.obtainCompany}" />
			<param id="logoImageFile" value="#{company.getAttachAsInputStream}" />
			<param id="recordData" value="#{company.getCompanyRecordData}" />
			<param id="phone" value="#{company.obtainPhone}" />
			<param id="fax" value="#{company.obtainFax}" />
			<param id="email" value="#{company.obtainEmail}" />
			<param id="web" value="#{company.obtainWeb}" />
			<param id="address" value="#{company.obtainAddress}" />
			<param id="printRecordData" value="#{company.isPrintRecordData}"/>
			<param id="printHeader" value="#{company.isPrintHeader}" />
			<param id="PriceStrategy" value="#{salesDetail.getPriceStrategy}" />
			<param id="TotalPrice" value="#{sales.getTotalPrice}" />
			<param id="defaultPayMethod" value="#{sales.getDefaultPayMethod}" />
		</params>
	</report>

	<report id="salesDetailledList" description="Listado Detallado de sales">
		<template path="/com/code/aon/ui/sales/report/salesDetailledList.jasper" />
		<bean key="com.code.aon.sales.Sales" />
		<criteria provider="#{sales}"/>
		<params>
			<param id="REPORT_RESOURCE_BUNDLE" value="com.code.aon.ui.sales.i18n.report" />
			<param id="company" value="#{company.obtainCompany}" />
			<param id="logoImageFile" value="#{company.getAttachAsInputStream}" />
			<param id="recordData" value="#{company.getCompanyRecordData}" />
			<param id="phone" value="#{company.obtainPhone}" />
			<param id="fax" value="#{company.obtainFax}" />
			<param id="email" value="#{company.obtainEmail}" />
			<param id="web" value="#{company.obtainWeb}" />
			<param id="address" value="#{company.obtainAddress}" />
			<param id="printRecordData" value="#{company.isPrintRecordData}"/>
			<param id="printHeader" value="#{company.isPrintHeader}" />
			<param id="PriceStrategy" value="#{salesDetail.getPriceStrategy}" />
			<param id="TotalPrice" value="#{sales.getTotalPrice}" />
			<param id="defaultPayMethod" value="#{sales.getDefaultPayMethod}" />
		</params>
		<nested-report report="salesListDetail"/>
		<nested-report report="salesListTaxBreakDown"/>
	</report>
	
	<report id="salesListDetail" description="sales Details">
		<template path="/com/code/aon/ui/sales/report/salesListDetail.jasper" />
	</report>
	<report id="salesListTaxBreakDown" description="taxBreakDown">
		<template path="/com/code/aon/ui/sales/report/salesListTaxBreakDown.jasper"/>
	</report></report-config>