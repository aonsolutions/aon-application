<!DOCTYPE hibernate-configuration PUBLIC
	"-//Hibernate/Hibernate Configuration DTD 3.0//EN"
	"http://hibernate.sourceforge.net/hibernate-configuration-3.0.dtd">

<hibernate-configuration>

	<session-factory>

		<property name="connection.provider_class">com.code.aon.common.dao.hibernate.DBCPConnectionProvider</property>
		<property name="connection.service">jboss.admin:service=AonSecurity</property>

		<property name="connection.datasource">java:comp/env/jdbc/CMS</property>
		<property name="show_sql">true</property>
		<property name="dialect">org.hibernate.dialect.MySQLInnoDBDialect</property>

		<!-- Mapping files -->
		<mapping class="com.code.aon.cms.Language"/>
		<mapping class="com.code.aon.cms.Config"/>
		<mapping class="com.code.aon.cms.ConfigDetail"/>
		<mapping class="com.code.aon.cms.GenericPage"/>
		<mapping class="com.code.aon.cms.GenericPageDetail"/>
		<mapping class="com.code.aon.cms.Menu"/>
		<mapping class="com.code.aon.cms.MenuOption"/>
		<mapping class="com.code.aon.cms.MenuOptionDetail"/>
		<mapping class="com.code.aon.cms.Header"/>
		<mapping class="com.code.aon.cms.HeaderDetail"/>
		<mapping class="com.code.aon.cms.Footer"/>
		<mapping class="com.code.aon.cms.FooterDetail"/>

	</session-factory>

</hibernate-configuration>