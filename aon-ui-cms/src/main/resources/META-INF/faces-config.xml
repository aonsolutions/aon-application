<faces-config version="1.2" xmlns="http://java.sun.com/xml/ns/javaee"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://java.sun.com/xml/ns/javaee http://java.sun.com/xml/ns/javaee/web-facesconfig_1_2.xsd">

	<!-- ************** ARTICLE ************** -->
	<managed-bean>
		<managed-bean-name>article</managed-bean-name>
		<managed-bean-class>com.code.aon.ui.cms.controller.ArticleController</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
		<managed-property>
			<property-name>pojo</property-name>
			<value>com.code.aon.cms.Article</value>
		</managed-property>
		<managed-property>
			<property-name>pojoI18n</property-name>
			<value>com.code.aon.cms.ArticleDetail</value>
		</managed-property>
		<managed-property>
			<property-name>beanName</property-name>
			<value>article</value>
		</managed-property>
		<managed-property>
			<property-name>defaultOrder</property-name>
			<value>Article_alias</value>
		</managed-property>
		<managed-property>
			<property-name>joinAlias</property-name>
			<value>ArticleDetail_article_id</value>
		</managed-property>
		<managed-property>
			<property-name>languageAlias</property-name>
			<value>ArticleDetail_language_id</value>
		</managed-property>
		<managed-property>
			<property-name>listenerClasses</property-name>
			<list-entries>
				<value-class>com.code.aon.ui.form.event.IControllerListener</value-class>
				<value>#{articleListener}</value>
			</list-entries>
		</managed-property>
	</managed-bean>

	<managed-bean>
		<managed-bean-name>articleListener</managed-bean-name>
		<managed-bean-class>com.code.aon.ui.cms.event.ArticleControllerListener</managed-bean-class>
		<managed-bean-scope>none</managed-bean-scope>
	</managed-bean>

	<!-- ************** ARTICLE CATEGORY ************** -->
	<managed-bean>
		<managed-bean-name>articleCategory</managed-bean-name>
		<managed-bean-class>com.code.aon.ui.cms.controller.ArticleCategoryController</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
		<managed-property>
			<property-name>pojo</property-name>
			<value>com.code.aon.cms.ArticleCategory</value>
		</managed-property>
		<managed-property>
			<property-name>pojoI18n</property-name>
			<value>com.code.aon.cms.ArticleCategoryDetail</value>
		</managed-property>
		<managed-property>
			<property-name>beanName</property-name>
			<value>articleCategory</value>
		</managed-property>
		<managed-property>
			<property-name>joinAlias</property-name>
			<value>ArticleCategoryDetail_articleCategory_id</value>
		</managed-property>
		<managed-property>
			<property-name>languageAlias</property-name>
			<value>ArticleCategoryDetail_language_id</value>
		</managed-property>
		<managed-property>
			<property-name>defaultOrder</property-name>
			<value>ArticleCategory_alias</value>
		</managed-property>
	</managed-bean>

	<!-- ************** ARTICLE RELATED ************** -->
	<managed-bean>
		<managed-bean-name>articleRelated</managed-bean-name>
		<managed-bean-class>com.code.aon.ui.cms.controller.ArticleRelatedController</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
		<managed-property>
			<property-name>queryOnStartUP</property-name>
			<value>true</value>
		</managed-property>
		<managed-property>
			<property-name>pojo</property-name>
			<value>com.code.aon.cms.ArticleRelated</value>
		</managed-property>
		<managed-property>
			<property-name>beanName</property-name>
			<value>articleRelated</value>
		</managed-property>
		<managed-property>
			<property-name>pageLimit</property-name>
			<value>10</value>
		</managed-property>
		<managed-property>
			<property-name>listenerClasses</property-name>
			<list-entries>
				<value-class>com.code.aon.ui.form.event.IControllerListener</value-class>
				<value>#{articleRelatedListener}</value>
			</list-entries>
		</managed-property>
	</managed-bean>

	<managed-bean>
		<managed-bean-name>articleRelatedListener</managed-bean-name>
		<managed-bean-class>com.code.aon.ui.cms.event.ArticleRelatedControllerListener</managed-bean-class>
		<managed-bean-scope>none</managed-bean-scope>
	</managed-bean>

	<!-- ************** ARTICLE DOCUMENT ************** -->
	<managed-bean>
		<managed-bean-name>articleDocument</managed-bean-name>
		<managed-bean-class>com.code.aon.ui.cms.controller.ArticleDocumentController</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
		<managed-property>
			<property-name>pojo</property-name>
			<value>com.code.aon.cms.ArticleDocument</value>
		</managed-property>
		<managed-property>
			<property-name>pojoI18n</property-name>
			<value>com.code.aon.cms.ArticleDocumentDetail</value>
		</managed-property>
		<managed-property>
			<property-name>beanName</property-name>
			<value>articleDocument</value>
		</managed-property>
		<managed-property>
			<property-name>joinAlias</property-name>
			<value>ArticleDocumentDetail_articleDocument_id</value>
		</managed-property>
		<managed-property>
			<property-name>languageAlias</property-name>
			<value>ArticleDocumentDetail_language_id</value>
		</managed-property>
		<managed-property>
			<property-name>queryOnStartUP</property-name>
			<value>true</value>
		</managed-property>
		<managed-property>
			<property-name>pageLimit</property-name>
			<value>10</value>
		</managed-property>
		<managed-property>
			<property-name>listenerClasses</property-name>
			<list-entries>
				<value-class>com.code.aon.ui.form.event.IControllerListener</value-class>
				<value>#{articleDocumentControllerListener}</value>
			</list-entries>
		</managed-property>
	</managed-bean>

	<managed-bean>
		<managed-bean-name>articleDocumentControllerListener</managed-bean-name>
		<managed-bean-class>com.code.aon.ui.cms.event.ArticleDocumentControllerListener</managed-bean-class>
		<managed-bean-scope>none</managed-bean-scope>
	</managed-bean>

	<!-- ************** ARTICLE LOOKUP ************** -->
	<managed-bean>
		<managed-bean-name>articleLookup</managed-bean-name>
		<managed-bean-class>com.code.aon.faces.controller.RichLookupBean</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
		<managed-property>
			<property-name>beanName</property-name>
			<value>articleLookup</value>
		</managed-property>
		<managed-property>
			<property-name>foreignPojo</property-name>
			<value>com.code.aon.cms.Article</value>
		</managed-property>
		<managed-property>
			<property-name>defaultOrder</property-name>
			<value>Article_alias</value>
		</managed-property>
		<managed-property>
			<property-name>listPagePath</property-name>
			<value>/com/code/aon/ui/cms/facelet/lookup/article/list.xhtml</value>
		</managed-property>
		<managed-property>
			<property-name>searchPagePath</property-name>
			<value>/com/code/aon/ui/cms/facelet/lookup/article/search.xhtml</value>
		</managed-property>
	</managed-bean>

	<!-- =================== Article ========================== -->
	<navigation-rule>
		<navigation-case>
			<from-outcome>articleCategory_list</from-outcome>
			<to-view-id>/com/code/aon/ui/cms/facelet/articleCategory/list.xhtml</to-view-id>
		</navigation-case>
		<navigation-case>
			<from-outcome>articleCategory_form</from-outcome>
			<to-view-id>/com/code/aon/ui/cms/facelet/articleCategory/form.xhtml</to-view-id>
		</navigation-case>
		<navigation-case>
			<from-outcome>articleCategory_search</from-outcome>
			<to-view-id>/com/code/aon/ui/cms/facelet/articleCategory/search.xhtml</to-view-id>
		</navigation-case>
		<navigation-case>
			<from-outcome>article_list</from-outcome>
			<to-view-id>/com/code/aon/ui/cms/facelet/article/list.xhtml</to-view-id>
		</navigation-case>
		<navigation-case>
			<from-outcome>article_form</from-outcome>
			<to-view-id>/com/code/aon/ui/cms/facelet/article/form.xhtml</to-view-id>
		</navigation-case>
		<navigation-case>
			<from-outcome>article_search</from-outcome>
			<to-view-id>/com/code/aon/ui/cms/facelet/article/search.xhtml</to-view-id>
		</navigation-case>
	</navigation-rule>

</faces-config>
