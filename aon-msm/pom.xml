<?xml version="1.0"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
  <parent>
    <groupId>com.code.aon</groupId>
    <artifactId>aon.parent</artifactId>
    <version>8.0-SNAPSHOT</version>
  </parent>
  <modelVersion>4.0.0</modelVersion>
  <artifactId>aon-msm</artifactId>
  <packaging>pom</packaging>
  <description>aon Solutions high-availability clusters with memcached.</description>
  <name>AON MEMCACHED SESSION MANAGER</name>
  <properties>
    <maven.build.timestamp.format>dd/MM/yyyy</maven.build.timestamp.format>
  </properties>
  <scm>
    <developerConnection>scm:svn:http://dev.esferalia.com/repos/aon-application/trunk/aon-solutions-release</developerConnection>
    <connection>scm:svn:http://dev.esferalia.com/repos/aon-application/trunk/aon-solutions-release</connection>
  </scm>
  <build>
    <plugins>
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>buildnumber-maven-plugin</artifactId>
        <version>1.2</version>
        <executions>
          <execution>
            <phase>validate</phase>
            <goals>
              <goal>create</goal>
            </goals>
          </execution>
        </executions>
        <configuration>
          <doCheck>false</doCheck>
          <doUpdate>false</doUpdate>
        </configuration>
      </plugin>
    </plugins>
  </build>
  <dependencies>
    <dependency>
      <groupId>spy</groupId>
      <artifactId>spymemcached</artifactId>
      <version>2.8.1</version>
      <scope>runtime</scope>
      <optional>false</optional>
    </dependency>
    <dependency>
      <groupId>de.javakaffee.msm</groupId>
      <artifactId>memcached-session-manager</artifactId>
      <version>1.8.1</version>
      <scope>runtime</scope>
      <optional>false</optional>
    </dependency>
    <dependency>
      <groupId>de.javakaffee.msm</groupId>
      <artifactId>memcached-session-manager-tc6</artifactId>
      <version>1.8.1</version>
      <scope>runtime</scope>
      <optional>false</optional>
    </dependency>
    <dependency>
      <groupId>de.javakaffee.msm</groupId>
      <artifactId>msm-kryo-serializer</artifactId>
      <version>1.8.1</version>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>de.javakaffee</groupId>
      <artifactId>kryo-serializers</artifactId>
      <version>0.11</version>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>com.googlecode</groupId>
      <artifactId>kryo</artifactId>
      <version>1.04</version>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>com.googlecode</groupId>
      <artifactId>minlog</artifactId>
      <version>1.2</version>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>com.googlecode</groupId>
      <artifactId>reflectasm</artifactId>
      <version>1.01</version>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>asm</groupId>
      <artifactId>asm</artifactId>
      <version>3.2</version>
      <scope>runtime</scope>
    </dependency>
  </dependencies>
  <profiles>
    <profile>
      <id>rpm-release</id>
      <activation>
        <property>
          <name>rpm.release</name>
          <value>true</value>
        </property>
      </activation>
      <build>
        <plugins>
          <!-- Para construir el RPM -->
          <plugin>
            <groupId>org.codehaus.mojo</groupId>
            <artifactId>rpm-maven-plugin</artifactId>
            <version>2.0.1</version>
            <extensions>true</extensions>
            <executions>
              <execution>
                <goals>
                  <goal>attached-rpm</goal>
                </goals>
              </execution>
            </executions>
            <configuration>
              <group>Applications/Aon</group>
              <release>${buildNumber}</release>
              <copyright>2014, esferalia Networks S.A</copyright>
              <requires>
                <require>tomcat6</require>
                <require>aon-aio</require>
                <require>libxslt</require>
              </requires>
              <mappings>
                <mapping>
                  <filemode>755</filemode>
                  <username>tomcat</username>
                  <groupname>tomcat</groupname>
                  <directoryIncluded>false</directoryIncluded>
                  <directory>/usr/share/tomcat6/lib</directory>
                  <dependency>
                    <includes>
                      <include>spy:spymemcached:2.8.1</include>
                      <include>de.javakaffee.msm:memcached-session-manager:1.8.1</include>
                      <include>de.javakaffee.msm:memcached-session-manager-tc6:1.8.1</include>
                    </includes>
                  </dependency>
                </mapping>
                <mapping>
                  <filemode>755</filemode>
                  <username>tomcat</username>
                  <groupname>tomcat</groupname>
                  <directoryIncluded>false</directoryIncluded>
                  <directory>/usr/share/tomcat6/webapps/aon-aio/WEB-INF/lib</directory>
                  <dependency>
                    <includes>
                      <include>asm:asm:3.2</include>
                      <include>com.googlecode:reflectasm:1.01</include>
                      <include>com.googlecode:kryo:1.04</include>
                      <include>com.googlecode:minlog:1.2</include>
                      <include>de.javakaffee:kryo-serializers:0.11</include>
                      <include>de.javakaffee.msm:msm-kryo-serializer:1.8.1</include>
                    </includes>
                  </dependency>
                </mapping>
              </mappings>
              <postinstallScriptlet>
                <scriptFile>src/main/scripts/postinstall</scriptFile>
                <fileEncoding>utf-8</fileEncoding>
              </postinstallScriptlet>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
    <profile>
      <id>perform-stats</id>
    </profile>
  </profiles>
</project>
