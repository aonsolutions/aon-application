<?xml version="1.0" encoding="ISO-8859-1"?>

<!DOCTYPE report-config 
	PUBLIC "-//CODE-AON//DTD Report Config//EN" 
	"http://co-de.com/aon/report-config.dtd">

<report-config>


	<!--  ********* Reservation Sale Invoice ********* -->
	<report id="selectedInvoice" description="Fee Hotel Invoice's Report Template">
		<template path="/com/esferalia/aon/ui/pms/report/saleInvoice.jasper" />
		<collection provider="#{selectedInvoice}" forceRefresh="true" />
		<params>
			<param id="REPORT_RESOURCE_BUNDLE" value="com.esferalia.aon.ui.pms.i18n.report" />
			<param id="PriceStrategy" value="#{saleInvoice.getPriceStrategy}" />
			<param id="printHeader" value="#{company.isPrintHeader}" />
			<param id="printRecordData" value="#{company.isPrintRecordData}" />
			<param id="invoiceDetailPrinter" value="#{invoiceDetailByDeliveryPrinter.getInstance}" />
			<param id="pmsInvoicePrinter" value="#{pmsInvoicePrinter.getInstance}" />
		</params>
	</report>

	<!--  *********  Sale Invoice ********* -->
	<report id="saleInvoice" description="Fee Hotel Invoice's Report Template">
		<template path="/com/esferalia/aon/ui/pms/report/saleInvoice.jasper" />
		<collection provider="#{saleInvoice}" forceRefresh="true" />
		<params>
			<param id="REPORT_RESOURCE_BUNDLE" value="com.esferalia.aon.ui.pms.i18n.report" />
			<param id="PriceStrategy" value="#{saleInvoice.getPriceStrategy}" />
			<param id="printHeader" value="#{company.isPrintHeader}" />
			<param id="printRecordData" value="#{company.isPrintRecordData}" />
			<param id="invoiceDetailPrinter" value="#{invoiceDetailByDeliveryPrinter.getInstance}" />
			<param id="pmsInvoicePrinter" value="#{pmsInvoicePrinter.getInstance}" />
		</params>
	</report>
	
	<report id="invoicePrint" description="Hotel Invoice's Report">
		<template path="/com/esferalia/aon/ui/pms/report/saleInvoice.jasper" />
		<bean key="com.code.aon.finance.Invoice" />
		<criteria provider="#{invoicePrint}"/>
		<params>
			<param id="REPORT_RESOURCE_BUNDLE" value="com.esferalia.aon.ui.pms.i18n.report" />
			<param id="PriceStrategy" value="#{saleInvoice.getPriceStrategy}" />
			<param id="company" value="#{company.obtainCompany}" />
			<param id="logoImageFile" value="#{company.getAttachAsInputStream}" />
			<param id="recordData" value="#{company.getCompanyRecordData}" />
			<param id="address" value="#{company.obtainAddress}" />
			<param id="phone" value="#{company.obtainPhone}" />
			<param id="fax" value="#{company.obtainFax}" />
			<param id="email" value="#{company.obtainEmail}" />
			<param id="web" value="#{company.obtainWeb}" />
			<param id="printHeader" value="#{company.isPrintHeader}" />
			<param id="printRecordData" value="#{company.isPrintRecordData}" />
			<param id="invoiceDetailPrinter" value="#{invoiceDetailByDeliveryPrinter.getInstance}" />
			<param id="invoicePrinter" value="#{invoicePrinter.getInstance}" />
		</params>
	</report>

</report-config>