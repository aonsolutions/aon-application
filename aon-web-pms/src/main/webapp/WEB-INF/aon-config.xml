<?xml version="1.0" encoding="UTF-8" ?>
<config
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xmlns="http://www.esferalia.com/common" >

	<registry:config version="1.0" xmlns:registry="http://www.esferalia.com/registry">
		<registry:rmedia 
			showSendEmail="true" 
		/>
	</registry:config>
		
	<config:config version="1.1" xmlns:config="http://www.esferalia.com/config" >
		<config:series
			showOfferData="false"
			showSalesData="false"
			showDeliveryData="false"
			showInvoiceData="true"
			showTasData="false"
		/>
	</config:config>	

	<company:config version="1.5" xmlns:company="http://www.esferalia.com/company">
		<company:company 
			showRegistryBank="true" 
			showCompanyOtherData="true"
			showPanelTabSet="true" 
			showEInvoice="true"
			showDigitalCertificate="true"
			showDirStaff="false"
			showSaleInvoiceReportParams="false"
		/>
		<company:enterprise 
			showFinanceData="false" 
			showAddInfo="true"
			showDirStaff="false"
			standalone="false"
			showEnterpriseParams="false"
			showPayrollData="false"
			showPersonInSearch="false"
			showProject="false"
		/>				
	</company:config>

	<customer:config version="1.1" xmlns:customer="http://www.esferalia.com/customer">
		<customer:customer
			showOfferData="false"
			showSalesData="false"
			showDeliveryData="false" 
			showFinanceData="true" 
			showProjectData="false"
			showFinanceFeeData="true" 
			showTaxInfoData="true"
			showAccount="true"
			showTariff="true" 
			showSegment="true"
			showNote="true"
			showRelationship="false"
			showRecordData="false"
			showAddInfo="true"
			showDirStaff="false"
			showHistory="true"
			showAbsence="false"
			showLoan="false"
			showCourse="false"			
		/>
	</customer:config>

	<supplier:config version="1.0" xmlns:supplier="http://www.esferalia.com/supplier">
		<supplier:supplier
			showFinanceData="true" 
			showTaxInfoData="true"
			showAccount="true"
			showSegment="true"
			showAddInfo="true"
		/>
	</supplier:config>

	<finance:config version="1.1" xmlns:finance="http://www.esferalia.com/finance">
		<finance:creditor
			showFinanceData="true" 
			showTaxInfoData="true"
			showAccount="true"
			showSegment="true"
			showAddInfo="true"
		/>
		<finance:invoice
			showWarehouseData="true" 
			showTasData="false" 
			showSendEmail="true"
		/>
	</finance:config>

	<product:config version="1.3" xmlns:product="http://www.esferalia.com/product">
		<product:catalogue
			showEcommerceData="false"
		/>
		<product:product
			showBarcode="false"
			showType="true"
			showBrand="false"
			showSalesPrice="true"
			showStock="false"
			showTariff="true"
			showCatalogues="true"
			showComposition="true"
			showAlternatives="false"
			showSuppliers="true"
			showAccount="true"
			showAddInfo="true"
			showAttachment="false"
			showEcommerceData="false"
			showHistory="true"
		/>
 		<product:productCategory
 			showCategoryGroup="false"
 		/>
	</product:config>

	<commercial:config version="1.4" xmlns:commercial="http://www.esferalia.com/commercial">
		<commercial:offer
			showInvoicing="true"
			showSalesOrder="false"
			showSeller="true"
			showTasData="false"
		/>
		<commercial:target
			showTaxInfoData="true"
			showEcommerceTab="false"
			showProfile="false"
			showSearchOnlyCustomers="true"
			showProject="true"
			showProduct="true"
			showSeller="true"
			showAddInfo="true"
			showSupplier="true"
			showTariff="true"
			showFinanceData="true"
			showNote="true"
		/>
	</commercial:config>

	<webmail:config version="1.3" xmlns:webmail="http://www.esferalia.com/webmail" >
		<webmail:webmail
			connect="true"
			showDomainMailAccounts="true"
			connectDomainMailAccounts="false"
		/>
	</webmail:config>	

	<groupware:config version="1.0" xmlns:groupware="http://www.esferalia.com/groupware">
		<groupware:alarm
			showPending="true"
			showList="true"
			showNew="true"
			showGoToCallCenter="true"
			showGoToCommercialMarketing="true"
		/>
	</groupware:config>
		
</config>
