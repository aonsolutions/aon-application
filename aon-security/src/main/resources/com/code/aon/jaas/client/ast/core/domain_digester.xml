<?xml version="1.0" encoding="ISO-8859-1"?>
<digester-rules>
	<object-create-rule pattern="storage" classname="com.code.aon.jaas.storage.DomainStorage"/>

	<pattern value="*/domain">
		<object-create-rule classname="com.code.aon.jaas.client.ast.core.Domain" />
		<call-method-rule pattern="id" methodname="setId" paramcount="0" />

		<pattern value="access-policy">
			<object-create-rule classname="com.code.aon.jaas.client.ast.core.AccessPolicy" />

			<call-method-rule pattern="id" methodname="setId" paramcount="0" />
			<call-method-rule pattern="domain" methodname="setSecurityDomain" paramcount="0" />
			<call-method-rule pattern="max-def-users" methodname="setMaxDefinedUsers" paramcount="0" />
			<call-method-rule pattern="max-all-users" methodname="setMaxAllowedUsers" paramcount="0" />
			<call-method-rule pattern="max-ses-user" methodname="setMaxSessions4User" paramcount="0" />
			<call-method-rule pattern="ex-if-exceeded" methodname="setExceptionThrowableIfMaximumExceeded" paramcount="0" />
			
			<set-next-rule methodname="setAccessPolicy"/>
		</pattern>

		<pattern value="datasource-metadata">
			<object-create-rule classname="com.code.aon.jaas.client.ast.core.DataSourceMetaData" />

			<call-method-rule pattern="connection-url" methodname="setConnectionURL" paramcount="0" />
			<call-method-rule pattern="driver-class" methodname="setDriverClass" paramcount="0" />
			<call-method-rule pattern="username" methodname="setUsername" paramcount="0" />
			<call-method-rule pattern="password" methodname="setPassword" paramcount="0" />

			<set-next-rule methodname="setDataSourceMetaData"/>
		</pattern>

		<pattern value="application">
			<object-create-rule classname="com.code.aon.jaas.client.ast.core.DomainApplication" />
			<call-method-rule pattern="id" methodname="setId" paramcount="0" />

			<pattern value="datasource-metadata">
				<object-create-rule classname="com.code.aon.jaas.client.ast.core.DataSourceMetaData" />
	
				<call-method-rule pattern="connection-url" methodname="setConnectionURL" paramcount="0" />
				<call-method-rule pattern="driver-class" methodname="setDriverClass" paramcount="0" />
				<call-method-rule pattern="username" methodname="setUsername" paramcount="0" />
				<call-method-rule pattern="password" methodname="setPassword" paramcount="0" />
	
				<set-next-rule methodname="setDataSourceMetaData"/>
			</pattern>

			<pattern value="profiles/relation">
				<object-create-rule classname="com.code.aon.jaas.client.ast.core.Relation" />
	
				<call-method-rule pattern="id" methodname="setId" paramcount="0" />
				<call-method-rule pattern="list/id" methodname="addRelation" paramcount="0" />
		
				<set-next-rule methodname="addProfile"/>
			</pattern>
			<pattern value="users/relation">
				<object-create-rule classname="com.code.aon.jaas.client.ast.core.Relation" />
	
				<call-method-rule pattern="id" methodname="setId" paramcount="0" />
				<call-method-rule pattern="list/id" methodname="addRelation" paramcount="0" />
		
				<set-next-rule methodname="addUser"/>
			</pattern>
			
			<set-next-rule methodname="add"/>
		</pattern>

		<pattern value="standalone/user">
			<object-create-rule classname="com.code.aon.jaas.client.ast.core.User" />

			<call-method-rule pattern="id" methodname="setId" paramcount="0" />
			<call-method-rule pattern="name" methodname="setName" paramcount="0" />
			<call-method-rule pattern="description" methodname="setDescription" paramcount="0" />
			<call-method-rule pattern="password" methodname="setPasswd" paramcount="0" />
	
			<set-next-rule methodname="add"/>
		</pattern>

		<set-next-rule methodname="setDomain"/>
	</pattern>

</digester-rules>