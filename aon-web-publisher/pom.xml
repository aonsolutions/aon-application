<?xml version="1.0"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
	<parent>
		<groupId>com.code.aon</groupId>
		<artifactId>aon.web.parent</artifactId>
		<version>6.70</version>
		<relativePath>../aon-web-parent</relativePath>
	</parent>
	<modelVersion>4.0.0</modelVersion>
	<artifactId>aon-publisher</artifactId>
	<packaging>war</packaging>
	<description>AON WEB PUBLISHER</description>
	<name>AON WEB PUBLISHER</name>
	<build>
		<finalName>aon-publisher</finalName>
		<plugins>
			<!-- Para construir el RPM -->
			<plugin>
				<groupId>org.codehaus.mojo</groupId>
				<artifactId>rpm-maven-plugin</artifactId>
				<version>2.0.1</version>
			</plugin>
		</plugins>
	</build>
	<dependencies>
		<dependency>
			<groupId>com.code.aon</groupId>
			<artifactId>aon.ui.resources</artifactId>
			<version>${project.version}</version>
			<scope>compile</scope>
			<exclusions>
				<exclusion>
					<groupId>com.code.aon</groupId>
					<artifactId>aon.ui.dbutils</artifactId>
				</exclusion>
			</exclusions>				
		</dependency>
		<dependency>
			<groupId>com.code.aon</groupId>
			<artifactId>aon.ui.publisher</artifactId>
			<version>${project.version}</version>
			<scope>compile</scope>
		</dependency>		
	</dependencies>
</project>
 
