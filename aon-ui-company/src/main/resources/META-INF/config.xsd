<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
	<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
		xmlns="http://www.esferalia.com/company" targetNamespace="http://www.esferalia.com/company"
		elementFormDefault="qualified">
	<xs:element name="config">	
		<xs:complexType>
		    <xs:sequence>
		      <xs:element ref="company" />
		      <xs:element ref="enterprise" />
		    </xs:sequence>		
			<xs:attribute name="version" type="xs:string" use="required" fixed="1.4"/>		    
		</xs:complexType>
	</xs:element>
	<xs:element name="company">
		<xs:complexType>
			<xs:attribute name="showRegistryBank" type="xs:boolean" use="required"/>
			<xs:attribute name="showCompanyOtherData" type="xs:boolean" use="required"/>
			<xs:attribute name="showPanelTabSet" type="xs:boolean" use="required"/>
			<xs:attribute name="showEInvoice" type="xs:boolean" use="required"/>
			<xs:attribute name="showDigitalCertificate" type="xs:boolean" use="required"/>
			<xs:attribute name="showDirStaff" type="xs:boolean" use="required"/>
		</xs:complexType>
	</xs:element>
	<xs:element name="enterprise">
		<xs:complexType>
			<xs:attribute name="showFinanceData" type="xs:boolean" use="required"/>
			<xs:attribute name="showAddInfo" type="xs:boolean" use="required"/>
			<xs:attribute name="showDirStaff" type="xs:boolean" use="required"/>
			<xs:attribute name="standalone" type="xs:boolean" use="required"/>
			<xs:attribute name="showEnterpriseParams" type="xs:boolean" use="required"/>
			<xs:attribute name="showPayrollData" type="xs:boolean" use="required"/>
			<xs:attribute name="showPersonInSearch" type="xs:boolean" use="required"/>
			<xs:attribute name="showProject" type="xs:boolean" use="required"/>
		</xs:complexType>
	</xs:element>
</xs:schema>
