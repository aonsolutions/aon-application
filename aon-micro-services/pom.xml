    <finalName>aon-micro-services</finalName>
    <plugins>
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>build-helper-maven-plugin</artifactId>
        <executions>
          <execution>
            <id>parse-version</id>
            <goals>
              <goal>parse-version</goal>
            </goals>
            <configuration />
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-war-plugin</artifactId>
        <version>3.2.2</version>
        <configuration>
          <!--archive>
            <manifest>
              <addDefaultSpecificationEntries>true</addDefaultSpecificationEntries>
              <addDefaultImplementationEntries>true</addDefaultImplementationEntries>
            </manifest>
            <manifestEntries>
              <dbVersion>${dbVersion}</dbVersion>
              <buildNumber>${env.BUILD_NUMBER}</buildNumber>
              <buildDate>${maven.build.timestamp}</buildDate>
              <buildRevision>${buildNumber}</buildRevision>
            </manifestEntries>
          </archive-->
          <webResources>
            <resource>
              <!-- this is relative to the pom.xml directory -->
              <directory>../aon-web-aio/src/main/webapp</directory>
              <!-- the list has a default value of ** -->  
              <includes>
                <include>js/**</include>
                <include>css/**</include>
                <include>images/**</include>
              </includes>
              <!-- there's no default value for this 
              <excludes>
                <exclude>**/*.jsp</exclude>
                <exclude>**/*.xhtml</exclude>
              </excludes>
              -->
            </resource>
            <resource>
              <!-- this is relative to the pom.xml directory -->
              <directory>../aon-ui-finance/src/main/resources</directory>
	      <includes>
                <include>com/code/aon/ui/finance/pdfjs/**</include>
	      </includes>
            </resource>
          </webResources>          
        </configuration>
        <executions>
          <execution>
            <id>execution1</id>
            <phase>package</phase>
            <configuration />
            <!--goals>
              <goal>manifest</goal>
            </goals-->
          </execution>
        </executions>
      </plugin>
