<?xml version="1.0" encoding="ISO-8859-1"?>

<!DOCTYPE report-config 
	PUBLIC "-//CODE-AON//DTD Report Config//EN" 
	"http://co-de.com/aon/report-config.dtd">

<report-config>
	
	<report id="salaryReport" description="Salary report ">
		<template path="/com/code/aon/ui/employee/report/salary.jasper" />
		<bean key="com.code.aon.employee.Salary" />
		<criteria provider="#{salary}"/>
		<params>
			<param id="REPORT_RESOURCE_BUNDLE" value="com.code.aon.ui.employee.i18n.report" />
			<param id="printHeader" value="#{company.isPrintHeader}" />
			<param id="company" value="#{company.obtainCompany}" />
			<param id="title" value="#{customer.getReportTitle}" />
		</params>
	</report>
	
</report-config>