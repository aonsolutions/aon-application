<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="month" columnCount="7" printOrder="Horizontal" pageWidth="175" pageHeight="70" columnWidth="25" leftMargin="0" rightMargin="0" topMargin="0" bottomMargin="0">
	<property name="ireport.scriptlethandling" value="0"/>
	<property name="ireport.encoding" value="UTF-8"/>
	<property name="ireport.zoom" value="3.0"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<import value="net.sf.jasperreports.engine.*"/>
	<import value="java.util.*"/>
	<import value="net.sf.jasperreports.engine.data.*"/>
	<parameter name="printHeaders" class="java.lang.Boolean" isForPrompting="false"/>
	<parameter name="logoImageFile" class="java.io.InputStream"/>
	<parameter name="company" class="com.code.aon.company.Company" isForPrompting="false"/>
	<parameter name="nestedReports" class="java.util.Map"/>
	<field name="date" class="java.util.Date"/>
	<title>
		<band splitType="Stretch"/>
	</title>
	<pageHeader>
		<band height="10" splitType="Stretch">
			<textField>
				<reportElement positionType="Float" x="0" y="0" width="25" height="10"/>
				<box>
					<topPen lineWidth="0.5"/>
					<bottomPen lineWidth="0.5"/>
				</box>
				<textElement textAlignment="Center" verticalAlignment="Middle">
					<font size="7"/>
				</textElement>
				<textFieldExpression class="java.lang.String"><![CDATA[$R{calendar_weekDay_monday}]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement positionType="Float" x="25" y="0" width="25" height="10"/>
				<box>
					<topPen lineWidth="0.5"/>
					<bottomPen lineWidth="0.5"/>
				</box>
				<textElement textAlignment="Center" verticalAlignment="Middle">
					<font size="7"/>
				</textElement>
				<textFieldExpression class="java.lang.String"><![CDATA[$R{calendar_tuesday}]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement positionType="Float" x="50" y="0" width="25" height="10"/>
				<box>
					<topPen lineWidth="0.5"/>
					<bottomPen lineWidth="0.5"/>
				</box>
				<textElement textAlignment="Center" verticalAlignment="Middle">
					<font size="7"/>
				</textElement>
				<textFieldExpression class="java.lang.String"><![CDATA[$R{calendar_wednesday}]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement positionType="Float" x="75" y="0" width="25" height="10"/>
				<box>
					<topPen lineWidth="0.5"/>
					<bottomPen lineWidth="0.5"/>
				</box>
				<textElement textAlignment="Center" verticalAlignment="Middle">
					<font size="7"/>
				</textElement>
				<textFieldExpression class="java.lang.String"><![CDATA[$R{calendar_thursday}]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement positionType="Float" x="100" y="0" width="25" height="10"/>
				<box>
					<topPen lineWidth="0.5"/>
					<bottomPen lineWidth="0.5"/>
				</box>
				<textElement textAlignment="Center" verticalAlignment="Middle">
					<font size="7"/>
				</textElement>
				<textFieldExpression class="java.lang.String"><![CDATA[$R{calendar_friday}]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement positionType="Float" x="125" y="0" width="25" height="10"/>
				<box>
					<topPen lineWidth="0.5"/>
					<bottomPen lineWidth="0.5"/>
				</box>
				<textElement textAlignment="Center" verticalAlignment="Middle">
					<font size="7"/>
				</textElement>
				<textFieldExpression class="java.lang.String"><![CDATA[$R{calendar_saturday}]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement positionType="Float" x="150" y="0" width="25" height="10"/>
				<box>
					<topPen lineWidth="0.5"/>
					<bottomPen lineWidth="0.5"/>
				</box>
				<textElement textAlignment="Center" verticalAlignment="Middle">
					<font size="7"/>
				</textElement>
				<textFieldExpression class="java.lang.String"><![CDATA[$R{calendar_sunday}]]></textFieldExpression>
			</textField>
		</band>
	</pageHeader>
	<detail>
		<band height="10" splitType="Stretch">
			<textField pattern="dd" isBlankWhenNull="true">
				<reportElement positionType="Float" x="0" y="0" width="25" height="10">
					<printWhenExpression><![CDATA[$F{date}!=null]]></printWhenExpression>
				</reportElement>
				<box>
					<topPen lineWidth="0.25"/>
					<leftPen lineWidth="0.25"/>
					<bottomPen lineWidth="0.25"/>
					<rightPen lineWidth="0.25"/>
				</box>
				<textElement textAlignment="Center" verticalAlignment="Middle">
					<font size="7"/>
				</textElement>
				<textFieldExpression class="java.util.Date"><![CDATA[$F{date}]]></textFieldExpression>
			</textField>
		</band>
	</detail>
</jasperReport>
