<?xml version="1.0"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
	<parent>
		<groupId>com.code.aon</groupId>
		<artifactId>aon.parent</artifactId>
		<version>8.27-SNAPSHOT</version>
	</parent>
	<modelVersion>4.0.0</modelVersion>
	<groupId>com.esferalia.aon</groupId>
	<artifactId>aon.payroll</artifactId>
	<description>AON PAYROLL</description>
	<name>AON PAYROLL</name>
	<build>
		<plugins>
			<plugin>
				<artifactId>maven-surefire-plugin</artifactId>
				<version>2.10</version>
				<configuration>
					<workingDirectory>target</workingDirectory>
				</configuration>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-surefire-plugin</artifactId>
				<configuration>
					<systemProperties>
						<property>
							<name>dbName</name>
							<value>aon_jooq_</value>
						</property>
					</systemProperties>
				</configuration>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-jar-plugin</artifactId>
				<executions>
					<execution>
						<goals>
							<goal>test-jar</goal>
						</goals>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>
	<dependencies>

		<dependency>
			<groupId>com.esferalia.aon</groupId>
			<artifactId>aon.watson</artifactId>
			<version>${project.version}</version>
			<scope>compile</scope>
		</dependency>
		<dependency>
			<groupId>com.esferalia.aon</groupId>
			<artifactId>aon.occam</artifactId>
			<version>${project.version}</version>
			<scope>compile</scope>
		</dependency>
		<!-- We must remove this as soon as possible. -->
		<dependency>
			<groupId>com.esferalia.aon</groupId>
			<artifactId>aon.entity</artifactId>
			<version>${project.version}</version>
			<scope>compile</scope>
		</dependency>
		<dependency>
			<groupId>com.esferalia.aon</groupId>
			<artifactId>aon.entity.common</artifactId>
			<version>${project.version}</version>
			<scope>compile</scope>
		</dependency>
		<dependency>
			<groupId>com.esferalia.aon</groupId>
			<artifactId>aon.master.jooq</artifactId>
			<version>${project.version}</version>
			<scope>compile</scope>
		</dependency>
		<dependency>
			<groupId>com.esferalia.aon</groupId>
			<artifactId>aon.calendar</artifactId>
			<version>${project.version}</version>
			<scope>compile</scope>
		</dependency>
		<dependency>
			<groupId>com.code.aon</groupId>
			<artifactId>aon.company</artifactId>
			<version>${project.version}</version>
			<scope>compile</scope>
		</dependency>
		<dependency>
			<groupId>com.code.aon</groupId>
			<artifactId>aon.registry</artifactId>
			<version>${project.version}</version>
			<scope>compile</scope>
		</dependency>
		<dependency>
			<groupId>com.esferalia.aon</groupId>
			<artifactId>aon.salary</artifactId>
			<version>${project.version}</version>
			<scope>compile</scope>
		</dependency>
		<dependency>
			<groupId>net.aonsolutions</groupId>
			<artifactId>aon.tgss</artifactId>
			<version>${project.version}</version>
			<scope>compile</scope>
		</dependency>
		<dependency>
			<groupId>junit</groupId>
			<artifactId>junit</artifactId>
			<version>4.8</version>
			<type>jar</type>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>com.code.aon</groupId>
			<artifactId>aon.customer</artifactId>
			<version>${project.version}</version>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.slf4j</groupId>
			<artifactId>slf4j-jcl</artifactId>
			<version>1.5.11</version>
			<scope>runtime</scope>
		</dependency>
		<dependency>
			<groupId>mysql</groupId>
			<artifactId>mysql-connector-java</artifactId>
			<version>5.1.10</version>
			<scope>compile</scope>
			<optional>false</optional>
		</dependency>
		<!-- <dependency> <groupId>com.aeat</groupId> <artifactId>Retenciones2011xml</artifactId> 
			<scope>compile</scope> <version>1.0</version> </dependency> <dependency> 
			<groupId>com.aeat</groupId> <artifactId>ModRet2011</artifactId> <scope>compile</scope> 
			<version>1.0</version> </dependency> -->
		<dependency>
			<groupId>es.aeat</groupId>
			<artifactId>ModRet2013</artifactId>
			<scope>compile</scope>
			<version>1.00</version>
		</dependency>
		<dependency>
			<groupId>es.aeat</groupId>
			<artifactId>PRET-RW13_shared</artifactId>
			<scope>compile</scope>
			<version>1.00</version>
		</dependency>
		<dependency>
			<groupId>es.aeat</groupId>
			<artifactId>ModRet2015</artifactId>
			<scope>compile</scope>
			<version>1.0</version>
		</dependency>
		<dependency>
			<groupId>es.aeat</groupId>
			<artifactId>PRET-R150_shared</artifactId>
			<scope>compile</scope>
			<version>1.0</version>
		</dependency>
		<dependency>
			<groupId>com.esferalia.aon</groupId>
			<artifactId>aon.aeat</artifactId>
			<version>${project.version}</version>
			<scope>compile</scope>
		</dependency>
		<dependency>
			<groupId>org.apache.commons</groupId>
			<artifactId>commons-math3</artifactId>
			<scope>compile</scope>
			<version>3.2</version>
		</dependency>

		<dependency>
			<groupId>com.code.aon</groupId>
			<artifactId>aon.pool</artifactId>
			<version>${project.version}</version>
			<scope>compile</scope>
		</dependency>
	</dependencies>
	<profiles>
		<profile>
			<id>rpm-release</id>
			<activation>
				<property>
					<name>rpm.release</name>
					<value>true</value>
				</property>
			</activation>
			<build>
				<plugins>
					<!-- Build el RPM -->
					<plugin>
						<groupId>org.codehaus.mojo</groupId>
						<artifactId>rpm-maven-plugin</artifactId>
						<version>2.0.1</version>
						<extensions>true</extensions>
						<executions>
							<execution>
								<id>rpm-build</id>
								<goals>
									<goal>attached-rpm</goal>
								</goals>
							</execution>
						</executions>

						<configuration>
							<group>Applications/Aon</group>
							<release>${buildNumber}</release>
							<copyright>2015, AON SOLUTIONS S.L.U</copyright>
							<requires>
								<require>apache-commons-cli</require>
								<require>mysql-connector-java</require>
							</requires>
							<mappings>
								<mapping>
									<filemode>644</filemode>
									<username>root</username>
									<groupname>root</groupname>
									<directory>/usr/share/java</directory>
									<dependency>
										<includes>
											<include>commons-cli:commons-cli</include>
											<include>com.code.aon:aon.common</include>
											<include>net.aonsolutions:aon.tgss</include>
											<include>com.esferalia.aon:aon.occam</include>
											<include>com.esferalia.aon:aon.salary</include>
										</includes>
									</dependency>
									<sources>
										<source>
											<location>target</location>
											<includes>
												<include>${project.artifactId}-${project.version}.jar</include>
											</includes>
										</source>
										<softlinkSource>
											<location>/usr/share/java/commons-cli-1.2.jar</location>
											<destination>commons-cli.jar</destination>
										</softlinkSource>
										<softlinkSource>
											<location>/usr/share/java/aon.tgss-${project.version}.jar</location>
											<destination>aon-tgss.jar</destination>
										</softlinkSource>
										<softlinkSource>
											<location>/usr/share/java/${project.artifactId}-${project.version}.jar</location>
											<destination>aon-payroll.jar</destination>
										</softlinkSource>
										<softlinkSource>
											<location>/usr/share/java/aon.tgss-${project.version}.jar</location>
											<destination>aon-tgss.jar</destination>
										</softlinkSource>
										<softlinkSource>
											<location>/usr/share/java/aon.common-${project.version}.jar</location>
											<destination>aon-common.jar</destination>
										</softlinkSource>
										<softlinkSource>
											<location>/usr/share/java/aon.occam-${project.version}.jar</location>
											<destination>aon-occam.jar</destination>
										</softlinkSource>
										<softlinkSource>
											<location>/usr/share/java/aon.salary-${project.version}.jar</location>
											<destination>aon-salary.jar</destination>
										</softlinkSource>
									</sources>
								</mapping>
								<mapping>
									<sources>
										<source>
											<location>src/main/scripts</location>
										</source>
									</sources>
									<filemode>755</filemode>
									<username>root</username>
									<groupname>root</groupname>
									<directory>/usr/bin</directory>
								</mapping>
							</mappings>
						</configuration>
					</plugin>
				</plugins>
			</build>
		</profile>
	</profiles>
</project>
