<faces-config version="1.2"
	xmlns="http://java.sun.com/xml/ns/javaee"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://java.sun.com/xml/ns/javaee http://java.sun.com/xml/ns/javaee/web-facesconfig_1_2.xsd">
	
	<application>
		<message-bundle>com.code.aon.ui.common.i18n.messages</message-bundle>
		<locale-config>
			<default-locale>es</default-locale>
			<supported-locale>en</supported-locale>
		</locale-config>
		<view-handler>com.sun.facelets.FaceletViewHandler</view-handler>  
	</application>

	<!-- ***************** FAILED LOGIN ******************** --> 
	<managed-bean>
		<managed-bean-name>failedLogin</managed-bean-name>
		<managed-bean-class>com.code.aon.bridge.session.FailedLogin</managed-bean-class>
		<managed-bean-scope>request</managed-bean-scope>
	</managed-bean>

	<!-- ***************** LOGGED USER ******************** --> 
	<managed-bean>
		<managed-bean-name>loggedUser</managed-bean-name>
		<managed-bean-class>com.code.aon.bridge.session.LoggedUser</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
	</managed-bean>

	<!-- *************** RESOURCE RESOLVER ***************** --> 
	<managed-bean>
		<managed-bean-name>aonResource</managed-bean-name>
		<managed-bean-class>
			com.code.aon.ui.resources.bean.ResourceResolver
		</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
		<managed-property>
			<property-name>resourceContextPath</property-name>
			<value>aon-distribution</value>
		</managed-property>		
		<managed-property>
			<property-name>resourceURIPreffix</property-name>
			<value>/aonResource/1.6.5</value>
		</managed-property>		
	</managed-bean>

	<!--  **** AON CONFIGURATION **** -->
	<managed-bean>
		<managed-bean-name>aonConfiguration</managed-bean-name>
		<managed-bean-class>
			com.code.aon.ui.common.controller.ConfigurationController
		</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
		<managed-property>
			<property-name>styleSheets</property-name>
			<list-entries>
				<value>/aonResource/aon-richCss.css</value>
			</list-entries>
		</managed-property>
		<managed-property>
			<property-name>applicationBundles</property-name>
			<map-entries>
				<map-entry>
					<key>bundle</key>
					<value>com.code.aon.ui.common.i18n.messages</value>
				</map-entry>
				<map-entry>
					<key>appBundle</key>
					<value>com.code.aon.ui.distribution.i18n.messages</value>
				</map-entry>
				<map-entry>
					<key>companyBundle</key>
                    <value>com.code.aon.ui.company.i18n.messages</value>
				</map-entry>
				<map-entry>
					<key>configBundle</key>
                    <value>com.code.aon.ui.config.i18n.messages</value>
				</map-entry>
				<map-entry>
					<key>customerBundle</key>
                    <value>com.code.aon.ui.customer.i18n.messages</value>
				</map-entry>
				<map-entry>
					<key>financeBundle</key>
                    <value>com.code.aon.ui.finance.i18n.messages</value>
				</map-entry>
				<map-entry>
					<key>geozoneBundle</key>
                    <value>com.code.aon.ui.geozone.i18n.messages</value>
				</map-entry>
				<map-entry>
					<key>productBundle</key>
                    <value>com.code.aon.ui.product.i18n.messages</value>
				</map-entry>
				<map-entry>
					<key>registryBundle</key>
                    <value>com.code.aon.ui.registry.i18n.messages</value>
				</map-entry>
				<map-entry>
					<key>salesBundle</key>
                    <value>com.code.aon.ui.sales.i18n.messages</value>
				</map-entry>
				<map-entry>
					<key>securityBundle</key>
                    <value>com.code.aon.bridge.i18n.messages</value>
				</map-entry>
				<map-entry>
					<key>supplierBundle</key>
                    <value>com.code.aon.ui.supplier.i18n.messages</value>
				</map-entry>
			</map-entries>
		</managed-property>
	</managed-bean>

  <!-- *************************************** -->
  <!-- ************ NAVIGATION *************** -->
  <!-- *************************************** -->
  
  <navigation-rule>
    <navigation-case>
      <from-outcome>logout</from-outcome>
      <to-view-id>/home.jsf</to-view-id>
      <redirect />
    </navigation-case>
  </navigation-rule>

</faces-config>