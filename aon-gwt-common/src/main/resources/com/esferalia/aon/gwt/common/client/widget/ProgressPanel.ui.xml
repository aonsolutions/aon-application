<ui:UiBinder xmlns:ui='urn:ui:com.google.gwt.uibinder'
	xmlns:g='urn:import:com.google.gwt.user.client.ui'>

	<ui:style>
		.button-bar {
			border: none !important;
			background: none !important;
		}
		
		.button-bar button {
			float: right;
			width: 16px;
			height: 16px;
			margin-left: 5px;
			margin-right: 5px;
		}
		
	</ui:style>


	<g:DockLayoutPanel styleName="aon-width-all" ui:field="dockLayoutPanel">
		<g:north size="26">
			<g:FlowPanel styleName="{style.button-bar} gwt-MenuBar-horizontal"
				ui:field="flowPanel">
			</g:FlowPanel>
		</g:north>
		<g:center>
			<g:ScrollPanel styleName="aon-width-all">
				<g:FlexTable  ui:field="flexTable" styleName="aon-width-all"/>
			</g:ScrollPanel>
		</g:center>
	</g:DockLayoutPanel>

</ui:UiBinder>
