
<!DOCTYPE html [
    <!ENTITY nbsp "&#160;"> 
]>
<ui:UiBinder xmlns:ui='urn:ui:com.google.gwt.uibinder' 
	xmlns:g='urn:import:com.google.gwt.user.client.ui' xmlns:aon='urn:import:com.esferalia.aon.gwt.common.client.widget'
	xmlns:c="urn:import:com.google.gwt.user.cellview.client" xmlns:b="http://java.sun.com/jstl/core"
	
	xmlns:p='urn:import:com.vaadin.polymer.paper.widget'
	xmlns:i='urn:import:com.vaadin.polymer.iron.widget'>

<ui:with type="com.esferalia.aon.gwt.common.client.css.AonGwtIssuesResources" field="issuesResources"></ui:with>
<ui:with type="com.esferalia.aon.gwt.common.client.css.AonResources" field="aonResources"></ui:with>
		
<ui:style>

	@external .vaadin-combo-box-overlay;
	@external .vaadin-combo-box;

	.vaadin-combo-box-overlay{
		z-index: 1000 !important;
		max-height:300px !important;
	}	

	.vaadin-combo-box{
		z-index: 1000 !important;
		max-height:300px !important;
	}	
</ui:style>
<g:DockLayoutPanel ui:field="dockLayoutPanel">
	<g:north size="40">
		<g:SimpleLayoutPanel ui:field="toolbar" />
	</g:north>
	<g:west size="0">
		<g:SimpleLayoutPanel styleName="{issuesResources.css.aonConfigurationPanelIssues}" ui:field="westContent"/>
	</g:west>
	<g:center>
		<g:SimpleLayoutPanel ui:field="content" styleName=""/>
	</g:center>
</g:DockLayoutPanel>

</ui:UiBinder>
