<ui:UiBinder xmlns:ui='urn:ui:com.google.gwt.uibinder'
	xmlns:g='urn:import:com.google.gwt.user.client.ui' 
	xmlns:es3='urn:import:com.google.gwt.user.client.ui'
	xmlns:datepicker='urn:import:com.google.gwt.user.datepicker.client'>
	
	<ui:Style>

		
		@external .gwt-RichTextArea;
		
		.gwt-RichTextArea{
			border:0px !important;	
		}
		

	</ui:Style>
	<g:HTMLPanel styleName="form-send-email-dialog form-template">
		<div>
			<g:VerticalPanel ui:field="vp"></g:VerticalPanel>
		</div>
		<!-- Menu con opciones de correo (Enviar)  -->
		<div>
		
		<g:AbsolutePanel ui:field="mailpanel">
		<g:HTMLPanel>
		<div class="aon-toolbar">
			<g:HorizontalPanel ui:field="header" styleName=" aon-finding-toolbar-item-group">
				<!-- g:Button ui:field="sendGmailButton" styleName="aon-icon-google-gmail aon-finding-toolbar-item" text="Enviar"></g:Button>			
				<g:Button ui:field="sendMailButton" styleName="aon-icon-accept aon-finding-toolbar-item" text="Enviar"></g:Button-->
			</g:HorizontalPanel>
		</div>
		
		<!-- Tabla información de envío (de, para, cc, bcc, asunto & adjuntar ficheros) -->
		<div>
			<g:FlexTable ui:field="grid" visible="true">
			
			</g:FlexTable>
		</div>
		<div style="padding-top:10px"></div>
		<div style="border:1px solid #BBB;" >
			<g:FlexTable ui:field="textEditor" visible="true">
			
			</g:FlexTable>		
		</div>
		</g:HTMLPanel>
		</g:AbsolutePanel>
		
		</div>

	</g:HTMLPanel>

</ui:UiBinder>