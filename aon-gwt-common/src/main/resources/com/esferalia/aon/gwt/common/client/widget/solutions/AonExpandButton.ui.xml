<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
	xmlns:g="urn:import:com.google.gwt.user.client.ui">

	<ui:style type="com.esferalia.aon.gwt.common.client.widget.solutions.AonExpandButton.MyStyle">
	
		.mainButton {
			width: 35px !important;
			height: 35px !important;
			position: relative !important;
		}
		
		.footerButton {
			height: 10px !important;
			width: 10px !important;
			position: absolute !important;
			bottom: 38% !important;
    		right: 6% !important;
		}
		
		.footerButton:hover {background-color: transparent !important;}
		
		.footerButton:focus{background-color: transparent !important;}
		
		.innerButton{
			position: absolute !important;
			height: 35px !important;
			width: 35px !important;
			left: 0 !important;
		}
		
	</ui:style>

	<g:HTMLPanel debugId='buttonBarBeta' styleName="{style.mainButton}" ui:field='mainButton' />
	
</ui:UiBinder> 
