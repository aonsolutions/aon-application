<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
	xmlns:g="urn:import:com.google.gwt.user.client.ui">

	<ui:style type="com.esferalia.aon.gwt.common.client.widget.solutions.AonAgreementsToolbar.MyStyle">
	
		.toolbar{
			width: 100%;
			display: flex;
			justify-content: space-between;
			align-items: center;
			height: 40px;
			border-top: 0px none;
			border-bottom: 1px solid rgb(221, 221, 221);
			font-size: 16px;
		}
		
		.headerSection{
			display: flex;
			align-items: center;
			padding: 0 15px;
		}
		
		.toolsSection{
			display: flex;
			align-items: center;
			justify-content: flex-end;
			padding: 0 15px;
		}
		
		.title{
			text-transform: uppercase;
		}
		
	</ui:style>

	<g:HTMLPanel debugId='buttonBarBeta' styleName="{style.toolbar}" ui:field='toolbar'>
		<g:HTMLPanel styleName="{style.headerSection}" ui:field="headerSection"></g:HTMLPanel>
		<g:HTMLPanel styleName="{style.toolsSection}" ui:field="toolsSection"></g:HTMLPanel>
	</g:HTMLPanel>
</ui:UiBinder> 
