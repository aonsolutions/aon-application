<ui:UiBinder xmlns:ui='urn:ui:com.google.gwt.uibinder'
	xmlns:g='urn:import:com.google.gwt.user.client.ui'>

	<ui:image field='close' src='close.gif' />
	<ui:image field='header' src='header.png' />
	<ui:image field='headerBack' src='headerBack.png' />

	<ui:with type="com.esferalia.aon.gwt.common.client.css.AonResources" field="aonResources"></ui:with>
	
	<g:HTMLPanel styleName="{aonResources.css.customDialogPanel}" >
		<div class="{aonResources.css.customDialogHeader}">
			<div class="{aonResources.css.customDialogTitle}">
				<g:Label ui:field="captionLabel" />
				<g:Button styleName="{aonResources.css.customDialogClose}"
					 ui:field="closeButton" />
			</div>
		</div>
	</g:HTMLPanel>

</ui:UiBinder>
