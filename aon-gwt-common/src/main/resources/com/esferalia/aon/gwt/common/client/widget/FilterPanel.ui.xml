		<g:HorizontalPanel ui:field="filterHorizontal" styleName="aon-width-all">
			<g:HTMLPanel>
				<span class="aon-panelGrid-search-info-internal" style="position: relative;top: 2px;">Filtrar:</span>
				<g:HorizontalPanel ui:field="filterLabelPanel">
				
				</g:HorizontalPanel>
			</g:HTMLPanel>			
		</g:HorizontalPanel>					
	</div>
    
    <g:HorizontalPanel ui:field="panel" >
        <p:PaperIconButton ui:field="cleanFilter" icon="close" style="position:absolute;right:15px;" />
	</g:HorizontalPanel>
    
</g:HTMLPanel>

