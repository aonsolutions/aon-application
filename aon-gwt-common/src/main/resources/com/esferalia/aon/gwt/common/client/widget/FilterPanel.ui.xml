	xmlns:g='urn:import:com.google.gwt.user.client.ui' 
	xmlns:p='urn:import:com.vaadin.polymer.paper.widget'
	xmlns:i='urn:import:com.vaadin.polymer.iron.widget'>
    	
<ui:with type="com.esferalia.aon.gwt.common.client.css.AonGwtIssuesResources" field="issuesResources" />

<g:HTMLPanel  styleName="aon-panelGrid-search" height="55px" >
