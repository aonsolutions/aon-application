<ui:UiBinder xmlns:ui='urn:ui:com.google.gwt.uibinder'
	xmlns:g='urn:import:com.google.gwt.user.client.ui'>

	<ui:with type="com.esferalia.aon.gwt.common.client.css.AonResources" field="aonResources"></ui:with>

	<g:AbsolutePanel styleName="{aonResources.css.aonPointerEventsNone}">
		<g:FlowPanel styleName="{aonResources.css.aonSelector}">
			<g:Button styleName="{aonResources.css.aonIconCommandButton} {aonResources.css.aonIconMaximize} {aonResources.css.aonPointerEventsAuto}"
				ui:field="maximizeButton"/>
			<g:Button styleName="{aonResources.css.aonIconCommandButton} {aonResources.css.aonIconMinimize} {aonResources.css.aonPointerEventsAuto}"
				ui:field="minimizeButton"/>
		</g:FlowPanel>
		<g:at top='0' left='0' >
			<g:SimpleLayoutPanel ui:field="contentPanel"  
				styleName="{aonResources.css.aonWidthAll} {aonResources.css.aonHeightAll} {aonResources.css.aonPointerEventsNone}"/>
		</g:at>
	</g:AbsolutePanel>

