<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
	xmlns:g="urn:import:com.google.gwt.user.client.ui">

	<ui:style>
	.newButton {
		float: right;
	}
	.searchTextBox {
		float: left;
		margin-top: 2px;
	}
	
	.legend-icon {
		margin-top: 3px;
	}
	</ui:style>

	<g:FlowPanel styleName="gwt-MenuBar-horizontal" debugId='buttonBar' ui:field='buttonBar'>
		<g:TextBox styleName="gwt-TextBox {style.searchTextBox}" debugId='searchTextBox' ui:field='searchTextBox' visible="false"/>
		
		<g:HTMLPanel styleName="{style.legend-icon}">

			<g:Button styleName="gwt-MenuItem aon-icon-view" debugId='viewButton' ui:field='viewButton' />

			<g:Button debugId='pasteButton' ui:field='pasteButton'
				styleName='aon-editDataTable-button aon-icon-paste {style.newButton}'
				title="Pegar (Ctrl+V)" />

			<g:Button debugId='copyButton' ui:field='copyButton'
				styleName='aon-editDataTable-button aon-icon-copy {style.newButton}'
				title="Copiar (Ctrl+C)" />

			<g:Button debugId='draftButton' ui:field='draftButton'
				styleName='aon-editDataTable-button aon-icon-draft {style.newButton}'
				title="Enviar a la papelera" />

			<g:Button debugId='newButton' ui:field='newButton'
				styleName='aon-editDataTable-button aon-icon-reset {style.newButton}'
				title="Nuevo" />

			<g:Button styleName="gwt-MenuItem aon-icon-collpaseAll"
				debugId='collapseAllButton' ui:field='collapseAllButton' />

		</g:HTMLPanel>
	</g:FlowPanel>
</ui:UiBinder> 
