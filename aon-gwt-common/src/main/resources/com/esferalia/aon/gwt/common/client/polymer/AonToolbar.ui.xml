
<!DOCTYPE html [
    <!ENTITY nbsp "&#160;"> 
]>
<ui:UiBinder xmlns:ui='urn:ui:com.google.gwt.uibinder'
	xmlns:g='urn:import:com.google.gwt.user.client.ui' xmlns:aon='urn:import:com.esferalia.aon.gwt.common.client.widget'
	xmlns:c="urn:import:com.google.gwt.user.cellview.client" xmlns:b="http://java.sun.com/jstl/core"
	
	xmlns:p='urn:import:com.vaadin.polymer.paper.widget'
	xmlns:i='urn:import:com.vaadin.polymer.iron.widget'>

<ui:style>
	
</ui:style>

<g:HTMLPanel addStyleNames="paper-toolbar">
    <style is="custom-style">
  		paper-toolbar ::shadow #topBar {
			color:#000;
    		height:var(--paper-toolbar-height, 40px);
      	}
    </style>
	<p:PaperToolbar height="40px" styleName="aon-menuBar" 
			style="border-top: 0px;">
       	<p:PaperIconButton ui:field="menuButton" icon="menu"/>
       	<g:Label ui:field="title" styleName="title" text="Toolbar"/>
      	<p:PaperIconButton ui:field="statsButton" icon="assessment"/>
      	<p:PaperIconButton ui:field="infoButton" icon="info-outline"/>
      	<p:PaperIconButton ui:field="refreshButton" icon="refresh"/>
       	<p:PaperIconButton ui:field="addButton" icon="add" />
       	<p:PaperIconButton ui:field="editButton" icon="create" />
   		<p:PaperIconButton ui:field="deleteButton" icon="delete" />
   		<p:PaperIconButton ui:field="moreOptionButton" icon="more-vert" />
   		
    </p:PaperToolbar>
</g:HTMLPanel>

</ui:UiBinder>
