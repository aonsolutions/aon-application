
<!DOCTYPE html [
    <!ENTITY nbsp "&#160;"> 
]>
<ui:UiBinder xmlns:ui='urn:ui:com.google.gwt.uibinder'
	xmlns:g='urn:import:com.google.gwt.user.client.ui' xmlns:aon='urn:import:com.esferalia.aon.gwt.common.client.widget'
	xmlns:c="urn:import:com.google.gwt.user.cellview.client" xmlns:b="http://java.sun.com/jstl/core"
	
	xmlns:p='urn:import:com.vaadin.polymer.paper.widget'
	xmlns:i='urn:import:com.vaadin.polymer.iron.widget'>

<ui:with type="com.esferalia.aon.gwt.common.client.css.AonResources"
	field="aonResources"></ui:with>

<g:HTMLPanel addStyleNames="paper-toolbar">
    <style is="custom-style">
  		paper-toolbar ::shadow #topBar {
			color:#000;
    		height:var(--paper-toolbar-height, 40px);
      	}
    </style>
	<p:PaperToolbar height="40px" styleName="aon-menuBar" 
			style="border-top: 0px;border-bottom: 1px solid #ddd;background-color:#ffffff">
       	<p:PaperIconButton ui:field="menuButton" title="menu" icon="menu"/>
       	<p:PaperButton ui:field="titleButton">
		    <g:InlineLabel ui:field="titleLabel" text="Toolbar" styleName="title" />
		</p:PaperButton>
	    <g:HorizontalPanel styleName="{aonResources.css.aonButtonRight}">
     		<p:PaperIconButton ui:field="searchButton" title="Búsqueda" visible="true" icon="search"/>
     		<g:TextBox ui:field="searchTextBox" visible="false" styleName="{aonResources.css.aonSearchTextBox}"></g:TextBox>
      		<p:PaperIconButton ui:field="downloadButton" title="Descargar" visible="false" icon="file-download"/>
       		<p:PaperIconButton ui:field="sendButton" title="Enviar" visible="false" icon="mail"/>
   			<p:PaperIconButton ui:field="editButton" title="Editar" icon="create" />
   			<p:PaperIconButton ui:field="deleteButton" title="Borrar" icon="delete" />
       		<p:PaperIconButton ui:field="fastFilterButton" title="Filtro Rápido" visible="false" icon="filter-list"/>
      		<p:PaperIconButton ui:field="statsButton" title="Estadísticas" icon="assessment"/>
      		<p:PaperIconButton ui:field="infoButton" title="Información" icon="info-outline"/>
      		<p:PaperIconButton ui:field="refreshButton" title="Refrescar" icon="refresh"/>
       		<p:PaperIconButton ui:field="addButton" title="Añadir" icon="add" />
       		
   			<p:PaperIconButton ui:field="moreOptionButton" title="Más Opciones" icon="more-vert" />
   		</g:HorizontalPanel>
    </p:PaperToolbar>
</g:HTMLPanel>

</ui:UiBinder>
