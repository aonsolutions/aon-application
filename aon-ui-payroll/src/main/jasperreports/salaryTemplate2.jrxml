							</jr:columnHeader>
							<jr:detailCell height="12">
								<textField isBlankWhenNull="true">
									<reportElement style="text_TD" x="4" y="0" width="234" height="12"/>
									<textElement/>
									<textFieldExpression><![CDATA[$F{description}]]></textFieldExpression>
								</textField>
