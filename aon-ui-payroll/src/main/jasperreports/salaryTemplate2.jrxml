							</jr:columnHeader>
							<jr:detailCell height="12">
								<textField>
									<reportElement style="text_TD" x="2" y="0" width="20" height="12"/>
									<textElement textAlignment="Center"/>
									<textFieldExpression><![CDATA[$F{type} == PaymentType.SALARY_IN_KIND ? "E" : "D"]]></textFieldExpression>
								</textField>
