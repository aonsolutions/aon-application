									<textElement/>
									<text><![CDATA[TIPO]]></text>
								</staticText>
							</jr:columnHeader>
							<jr:detailCell height="12">
								<staticText>
									<reportElement style="text_TD" x="4" y="0" width="81" height="12">
										<printWhenExpression><![CDATA[$F{paymentConcept} != null && $F{paymentConcept}.matches("P[0].*")]]></printWhenExpression>
									</reportElement>
									<textElement/>
									<text><![CDATA[Salario Base]]></text>
								</staticText>
								<staticText>
									<reportElement style="text_TD" x="4" y="0" width="81" height="12">
										<printWhenExpression><![CDATA[$F{paymentConcept} != null && $F{paymentConcept}.matches("P[1].*")]]></printWhenExpression>
									</reportElement>
									<textElement/>
									<text><![CDATA[Personales]]></text>
								</staticText>
								<staticText>
									<reportElement style="text_TD" x="4" y="0" width="81" height="12">
										<printWhenExpression><![CDATA[$F{paymentConcept} != null && $F{paymentConcept}.matches("P[2].*")]]></printWhenExpression>
									</reportElement>
									<textElement/>
									<text><![CDATA[Puesto Trabajo]]></text>
								</staticText>
								<staticText>
									<reportElement style="text_TD" x="4" y="0" width="81" height="12">
										<printWhenExpression><![CDATA[$F{paymentConcept} != null && $F{paymentConcept}.matches("P[3].*")]]></printWhenExpression>
									</reportElement>
									<textElement/>
									<text><![CDATA[Cantidad/Calidad]]></text>
								</staticText>
								<staticText>
									<reportElement style="text_TD" x="4" y="0" width="81" height="12">
										<printWhenExpression><![CDATA[$F{paymentConcept} != null && $F{paymentConcept}.matches("P[4].*")]]></printWhenExpression>
									</reportElement>
									<textElement/>
									<text><![CDATA[Devengos Sup. Mes]]></text>
								</staticText>
								<staticText>
									<reportElement style="text_TD" x="4" y="0" width="81" height="12">
										<printWhenExpression><![CDATA[$F{paymentConcept} != null && $F{paymentConcept}.matches("P[7].*")]]></printWhenExpression>
									</reportElement>
									<textElement/>
									<text><![CDATA[Indemnizaciones]]></text>
								</staticText>
								<staticText>
									<reportElement style="text_TD" x="4" y="0" width="81" height="12">
										<printWhenExpression><![CDATA[$F{paymentConcept} != null && $F{paymentConcept}.matches("P[^0,1,2,3,4,7].*")]]></printWhenExpression>
									</reportElement>
									<textElement/>
									<text><![CDATA[Otros Devengos]]></text>
