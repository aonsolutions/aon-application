<?xml version="1.0" encoding="ISO-8859-1"?>

<!DOCTYPE report-config 
	PUBLIC "-//CODE-AON//DTD Report Config//EN" 
	"http://co-de.com/aon/report-config.dtd">

<report-config>
	<!--  **********************************************************
						      CONTRACT
		  ********************************************************** -->
		  
	<!--  IMPRESION DE CONTRATO -->
	<report id="contractReport" description="Impresion del contrato de trabajo">
		<template path="/com/esferalia/aon/ui/payroll/report/contract.jasper"/>
		<collection provider="#{contractGenerationWizard}"/>
		<params>
			<param id="REPORT_RESOURCE_BUNDLE" value="com.esferalia.aon.ui.payroll.i18n.report" />
		</params>
		<nested-report report="contractEnterpriseDetail"/>
	</report>
	<report id="contractEnterpriseDetail" description="Impresion de los datos de empresa del contrato de trabajo">
		<template path="/com/esferalia/aon/ui/payroll/report/contractEnterprise.jasper"/>
	</report>
		  
	<!--  IMPRESION DE COPIA BASICA -->
	<report id="contractBasicCopyReport" description="Impresion de la copia basica del contrato de trabajo">
		<template path="/com/esferalia/aon/ui/payroll/report/contractBasicCopy.jasper"/>
		<collection provider="#{contractGenerationWizard}"/>
		<params>
			<param id="REPORT_RESOURCE_BUNDLE" value="com.esferalia.aon.ui.payroll.i18n.report" />
		</params>
	</report>
	
	<!--  IMPRESION DE LA NOMINA -->
	<report id="currentSalaryReport" description="Current Salary report ">
<!--  
		<template path="/com/esferalia/aon/ui/payroll/report/salary.jasper" />
-->
		<template path="/com/esferalia/aon/ui/payroll/report/salaryTemplateTAI.jasper" />
		<collection provider="#{salary}" forceRefresh="true"/>
		<params>
			<param id="REPORT_RESOURCE_BUNDLE" value="com.esferalia.aon.ui.payroll.i18n.report" />
			<param id="printHeader" value="#{company.isPrintHeader}" />
			<param id="company" value="#{company.obtainCompany}" />
			<param id="logoImageFile" value="#{salary.getAttachAsInputStream}" />
		</params>
	</report>
	
	<report id="salaryReport" description="Salary report ">
<!--  
		<template path="/com/esferalia/aon/ui/payroll/report/salary.jasper" />
-->
		<template path="/com/esferalia/aon/ui/payroll/report/salaryTemplateTAI.jasper" />
		<bean key="com.esferalia.aon.payroll.Salary" />
		<criteria provider="#{salary}"/>
		<params>
			<param id="REPORT_RESOURCE_BUNDLE" value="com.esferalia.aon.ui.payroll.i18n.report" />
			<param id="printHeader" value="#{company.isPrintHeader}" />
			<param id="company" value="#{company.obtainCompany}" />
			<param id="logoImageFile" value="#{salary.getAttachAsInputStream}" />
		</params>
	</report>
	
	<!--  IMPRESION DEL BORRADOR DE LA NOMINA -->
	<report id="currentSalaryDraftReport" description="Current Salary Draft report ">
		<template path="/com/esferalia/aon/ui/payroll/report/salary.jasper" />
		<collection provider="#{salaryDraft}" forceRefresh="true"/>
		<params>
			<param id="REPORT_RESOURCE_BUNDLE" value="com.esferalia.aon.ui.payroll.i18n.report" />
			<param id="printHeader" value="#{company.isPrintHeader}" />
			<param id="company" value="#{company.obtainCompany}" />
			<param id="logoImageFile" value="#{company.getAttachAsInputStream}" />
			<param id="showBackground" value="#{salaryDraft.isShowBackground}" />
		</params>
	</report>
	
	<!--  IMPRESION DE LOS COSTES DE EMPRESA -->
	<report id="salaryExpenseReport" description="Salary Expense Report">
		<template path="/com/esferalia/aon/ui/payroll/report/salaryExpense.jasper" />
		<collection provider="#{salaryExpense}" />
		<params>
			<param id="REPORT_RESOURCE_BUNDLE" value="com.esferalia.aon.ui.payroll.i18n.report" />
			<param id="printHeader" value="#{company.isPrintHeader}" />
			<param id="company" value="#{company.obtainCompany}" />
			<param id="year" value="#{salaryExpense.getYear}" />
			<param id="month" value="#{salaryExpense.getMonth}" />
		</params>
	</report>

	<!--  IMPRESION DE LOS COSTES DE EMPRESA DEL MES ACTUAL -->
	<report id="currentSalaryExpenseReport" description="Salary Expense Report">
		<template path="/com/esferalia/aon/ui/payroll/report/salaryExpense.jasper" />
		<collection provider="#{salaryExpense}" />
		<params>
			<param id="REPORT_RESOURCE_BUNDLE" value="com.esferalia.aon.ui.payroll.i18n.report" />
			<param id="printHeader" value="#{company.isPrintHeader}" />
			<param id="company" value="#{company.obtainCompany}" />
			<param id="year" value="#{salaryExpense.getYear}" />
			<param id="month" value="#{salaryExpense.getMonth}" />
		</params>
	</report>
	
</report-config>