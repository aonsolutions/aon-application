<?xml version="1.0" encoding="ISO-8859-1"?>

<!DOCTYPE report-config 
	PUBLIC "-//CODE-AON//DTD Report Config//EN" 
	"http://co-de.com/aon/report-config.dtd">

<report-config>
	<!--
		********************************************************** CONTRACT
		**********************************************************
	-->

	<!--  IMPRESION DE CONTRATO -->
	<report id="contractReport" description="Impresion del contrato de trabajo">
		<template path="/com/esferalia/aon/ui/payroll/report/contract.jasper" />
		<collection provider="#{contractGenerationWizard}" />
		<params>
			<param id="REPORT_RESOURCE_BUNDLE" value="com.code.aon.ui.common.i18n.report" />
		</params>
		<nested-report report="contractEnterpriseDetail" />
	</report>
	<report id="contractEnterpriseDetail"
		description="Impresion de los datos de empresa del contrato de trabajo">
		<template
			path="/com/esferalia/aon/ui/payroll/report/contractEnterprise.jasper" />
	</report>

	<!--  IMPRESION DE COPIA BASICA -->
	<report id="contractBasicCopyReport"
		description="Impresion de la copia basica del contrato de trabajo">
		<template
			path="/com/esferalia/aon/ui/payroll/report/contractBasicCopy.jasper" />
		<collection provider="#{contractGenerationWizard}" />
		<params>
			<param id="REPORT_RESOURCE_BUNDLE" value="com.code.aon.ui.common.i18n.report" />
		</params>
	</report>

	<!--  
		TEMPLATES DE IMPRESION DE LA NOMINA 
	-->
	<report id="salary" description="Default salary report ">
		<template path="/com/esferalia/aon/ui/payroll/report/salary.jasper" />
		<collection provider="#{salary}" forceRefresh="true" />
		<params>
		</params>
	</report>

	<report id="idazkiak_es" description="Spanish Idazkiak salary report ">
		<template path="/com/esferalia/aon/ui/payroll/report/idazkiak_es.jasper" />
		<collection provider="#{salary}" forceRefresh="true" />
		<params>
		</params>
	</report>

	<report id="nominasta" description="Default Nominasta salary report ">
		<template path="/com/esferalia/aon/ui/payroll/report/nominasta.jasper" />
		<collection provider="#{salary}" forceRefresh="true" />
		<params>
		</params>
	</report>

	<report id="nominasta_ldh" description="Lopez de Hoyos Delegation's Nominasta salary report ">
		<template path="/com/esferalia/aon/ui/payroll/report/nominasta_ldh.jasper" />
		<collection provider="#{salary}" forceRefresh="true" />
		<params>
		</params>
	</report>

	<report id="salaryList" description="Salary List report ">
		<template path="/com/esferalia/aon/ui/payroll/report/salary.jasper" />
		<bean key="com.esferalia.aon.payroll.Salary" />
		<criteria provider="#{salary}" />
		<params>
			<param id="REPORT_RESOURCE_BUNDLE" value="com.code.aon.ui.common.i18n.report" />
			<param id="printHeader" value="#{company.isPrintHeader}" />
			<param id="company" value="#{company.obtainCompany}" />
			<param id="logoImageFile" value="#{salary.getAttachAsInputStream}" />
		</params>
	</report>
	<!--  
		TEMPLATES DE IMPRESION DEL IRPF 
	-->
	<report id="irpf2013" description="IRPF 2013 report ">
		<template path="/com/esferalia/aon/ui/payroll/report/aeatRetencionesSalida2013.jasper" />
		<collection provider="#{irpfResult}" forceRefresh="true" />
		<params>
		</params>
	</report>

	<!--  
		TEMPLATES DE IMPRESION DEL BORRADOR DE LA NOMINA 
	-->
	<report id="salaryDraftExtended" description="Current Salary Draft report ">
		<template path="/com/esferalia/aon/ui/payroll/report/salaryExtended.jasper" />
		<collection provider="#{salaryDraft}" forceRefresh="true" />
		<params>
			<param id="REPORT_RESOURCE_BUNDLE" value="com.code.aon.ui.common.i18n.report" />
			<param id="printHeader" value="#{company.isPrintHeader}" />
			<param id="company" value="#{company.obtainCompany}" />
			<param id="logoImageFile" value="#{company.getAttachAsInputStream}" />
			<param id="showBackground" value="#{salaryDraft.isShowBackground}" />
		</params>
		<nested-report report="salaryPaymentDetail"/>
	</report>
	<report id="salaryPaymentDetail" description="Salary Payment Detail">
		<template path="/com/esferalia/aon/ui/payroll/report/salaryPaymentDetail.jasper" />
	</report>

	<report id="salaryDraft" description="Current Salary Draft report ">
		<template path="/com/esferalia/aon/ui/payroll/report/salary.jasper" />
		<collection provider="#{salaryDraft}" forceRefresh="true" />
		<params>
			<param id="REPORT_RESOURCE_BUNDLE" value="com.code.aon.ui.common.i18n.report" />
			<param id="printHeader" value="#{company.isPrintHeader}" />
			<param id="company" value="#{company.obtainCompany}" />
			<param id="logoImageFile" value="#{company.getAttachAsInputStream}" />
			<param id="showBackground" value="#{salaryDraft.isShowBackground}" />
		</params>
	</report>

	<report id="salaryDraftTemplate1" description="Current Salary Draft report ">
		<template
			path="/com/esferalia/aon/ui/payroll/report/salaryTemplate1.jasper" />
		<collection provider="#{salaryDraft}" forceRefresh="true" />
		<params>
			<param id="REPORT_RESOURCE_BUNDLE" value="com.code.aon.ui.common.i18n.report" />
			<param id="printHeader" value="#{company.isPrintHeader}" />
			<param id="company" value="#{company.obtainCompany}" />
			<param id="logoImageFile" value="#{company.getAttachAsInputStream}" />
			<param id="showBackground" value="#{salaryDraft.isShowBackground}" />
		</params>
	</report>

	<!--  IMPRESION DE LOS COSTES DE EMPRESA -->
	<report id="salaryExpenseReport" description="Salary Expense Report">
		<template path="/com/esferalia/aon/ui/payroll/report/salaryExpense.jasper" />
		<collection provider="#{salaryExpense}" />
		<params>
			<param id="REPORT_RESOURCE_BUNDLE" value="com.code.aon.ui.common.i18n.report" />
			<param id="printHeader" value="#{company.isPrintHeader}" />
			<param id="company" value="#{company.obtainCompany}" />
			<param id="year" value="#{salaryExpense.getYear}" />
			<param id="month" value="#{salaryExpense.getMonth}" />
		</params>
	</report>

	<!--  IMPRESION DE LOS COSTES DE EMPRESA DEL MES ACTUAL -->
	<report id="currentSalaryExpenseReport" description="Salary Expense Report">
		<template path="/com/esferalia/aon/ui/payroll/report/salaryExpense.jasper" />
		<collection provider="#{salaryExpense}" />
		<params>
			<param id="REPORT_RESOURCE_BUNDLE" value="com.code.aon.ui.common.i18n.report" />
			<param id="printHeader" value="#{company.isPrintHeader}" />
			<param id="company" value="#{company.obtainCompany}" />
			<param id="year" value="#{salaryExpense.getYear}" />
			<param id="month" value="#{salaryExpense.getMonth}" />
		</params>
	</report>

	<!--  IMPRESION DE EL MODELO 145 -->
	<report id="mod145Report" description="Salary Expense Report">
		<template path="/com/esferalia/aon/ui/payroll/report/mod145.jasper" />
		<collection provider="#{irpfData}" />
		<params>
			<param id="REPORT_RESOURCE_BUNDLE" value="com.code.aon.ui.common.i18n.report" />
			<param id="printHeader" value="#{company.isPrintHeader}" />
			<param id="company" value="#{company.obtainCompany}" />
			<param id="descendants" value="#{irpfData.getDescentant}" />
		</params>
	</report>

	<!--  IMPRESION DE LA DOMICILIACION BANCARIA DEL CENTRO DE FORMACION -->
	<report id="trainingDirectDebit" description="Training center direct debit report">
		<template path="/com/esferalia/aon/ui/payroll/report/trainingDirectDebit.jasper" />
		<collection provider="#{contract}" />
		<params>
			<param id="REPORT_RESOURCE_BUNDLE" value="com.code.aon.ui.common.i18n.report" />
			<param id="company" value="#{company.obtainCompany}" />
			<param id="logoImageFile" value="#{company.getAttachAsInputStream}" />
			<param id="signatureImageFile" value="#{company.getSignatureAttachAsInputStream}" />
			<param id="printHeader" value="#{company.isPrintHeader}" />
			<param id="centerLogoImageFile" value="#{contract.getTrainingCenterLogo}" />
			<param id="trainingCenter" value="#{contract.getTrainingCenter}" />
			<param id="trainingCenterDirStaff" value="#{contract.getTrainingCenterDirStaff}" />
			<param id="parentDomainName" value="#{parentDomain.getName}" />
			<param id="parentDomainPhone" value="#{parentDomain.getPhone}" />
		</params>
	</report>

</report-config>
