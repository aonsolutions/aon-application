<?xml version="1.0"?>
<!DOCTYPE faces-config PUBLIC
  "-//Sun Microsystems, Inc.//DTD JavaServer Faces Config 1.1//EN"
  "http://java.sun.com/dtd/web-facesconfig_1_1.dtd">

<faces-config>
	<!-- =================== Navigation Rules ================= -->

	<navigation-rule>
		<navigation-case>
			<from-outcome>finance_list</from-outcome>
			<to-view-id>/finance/facelet/finance/list.faces</to-view-id>
		</navigation-case>
		<navigation-case>
			<from-outcome>finance_search</from-outcome>
			<to-view-id>/finance/facelet/finance/search.faces</to-view-id>
		</navigation-case>
		<navigation-case>
			<from-outcome>finance_form</from-outcome>
			<to-view-id>/finance/facelet/finance/form.faces</to-view-id>
		</navigation-case>
	</navigation-rule>

	<navigation-rule>
		<navigation-case>
			<from-outcome>customer_sw</from-outcome>
			<to-view-id>/finance/facelet/sw/customer.faces</to-view-id>
		</navigation-case>
		<navigation-case>
			<from-outcome>customer_sw_search</from-outcome>
			<to-view-id>/finance/facelet/sw/customerSearch.faces</to-view-id>
		</navigation-case>
	</navigation-rule>
	
	<navigation-rule>
		<navigation-case>
			<from-outcome>supplier_sw</from-outcome>
			<to-view-id>/finance/facelet/sw/supplier.faces</to-view-id>
		</navigation-case>
		<navigation-case>
			<from-outcome>supplier_sw_search</from-outcome>
			<to-view-id>/finance/facelet/sw/supplierSearch.faces</to-view-id>
		</navigation-case>
	</navigation-rule>
	
	<navigation-rule>
		<navigation-case>
			<from-outcome>bank_sw</from-outcome>
			<to-view-id>/finance/facelet/sw/bank.faces</to-view-id>
		</navigation-case>
		<navigation-case>
			<from-outcome>bank_sw_search</from-outcome>
			<to-view-id>/finance/facelet/sw/bankSearch.faces</to-view-id>
		</navigation-case>
	</navigation-rule>

	<!-- **************** MENU  *************** -->
	<navigation-rule>
		<navigation-case>
			<from-outcome>finance</from-outcome>
			<to-view-id>/finance/facelet/finance/search.faces</to-view-id>
		</navigation-case>
	</navigation-rule>

</faces-config>
