<?xml version="1.0"?>
<!DOCTYPE faces-config PUBLIC
  "-//Sun Microsystems, Inc.//DTD JavaServer Faces Config 1.1//EN"
  "http://java.sun.com/dtd/web-facesconfig_1_1.dtd">

<faces-config>

	<!-- ************ COLLECTION **************** -->
	<managed-bean>
		<managed-bean-name>financeCollections</managed-bean-name>
		<managed-bean-class>
			com.code.aon.ui.finance.controller.FinanceCollectionsController
		</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
	</managed-bean>

	<!-- ************* FINANCE ***************** -->
	<managed-bean>
		<managed-bean-name>finance</managed-bean-name>
		<managed-bean-class>
			com.code.aon.ui.finance.controller.FinanceController
		</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
		<managed-property>
			<property-name>queryOnStartUP</property-name>
			<value>true</value>
		</managed-property>
		<managed-property>
			<property-name>pojo</property-name>
			<value>com.code.aon.finance.Finance</value>
		</managed-property>
		<managed-property>
			<property-name>listenerClasses</property-name>
			<list-entries>
				<value-class>
					com.code.aon.ui.form.event.IControllerListener
				</value-class>
				<value>#{financeTrackingListener}</value>
			</list-entries>
		</managed-property>
	</managed-bean>
	
	<managed-bean>
		<managed-bean-name>financeTrackingListener</managed-bean-name>
		<managed-bean-class>
			com.code.aon.ui.form.listener.LinesControllerListener
		</managed-bean-class>
		<managed-bean-scope>none</managed-bean-scope>
		<managed-property>
			<property-name>childBean</property-name>
			<value>financeTracking</value>
		</managed-property>
		<managed-property>
			<property-name>aliasMap</property-name>
			<map-entries>
				<map-entry>
					<key>FinanceTracking_finance_id</key>
                    <value>id</value>
				</map-entry>
			</map-entries>
		</managed-property>
	</managed-bean>
	
	<!-- ************* FINANCETRACKING ***************** -->
	<managed-bean>
		<managed-bean-name>financeTracking</managed-bean-name>
		<managed-bean-class>com.code.aon.ui.form.LinesController</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
		<managed-property>
			<property-name>queryOnStartUP</property-name>
			<value>true</value>
		</managed-property>
		<managed-property>
			<property-name>pojo</property-name>
			<value>com.code.aon.finance.FinanceTracking</value>
		</managed-property>
		<managed-property>
			<property-name>cascadeDelete</property-name>
			<value>true</value>
		</managed-property>
		<managed-property>
			<property-name>masterControllerName</property-name>
			<value>finance</value>
		</managed-property>
		<managed-property>
			<property-name>propertyMap</property-name>
			<map-entries>
				<map-entry>
					<key>id</key>
					<value>finance.id</value>
				</map-entry>
			</map-entries>
		</managed-property>
	</managed-bean>
	
	<!-- ************* CUSTOMER ***************** -->
	<managed-bean>
		<managed-bean-name>customerLookup</managed-bean-name>
		<managed-bean-class>
			com.code.aon.ui.customer.controller.CustomerLookupController
		</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
		<managed-property>
			<property-name>queryOnStartUP</property-name>
			<value>true</value>
		</managed-property>
		<managed-property>
			<property-name>foreignPojo</property-name>
			<value>com.code.aon.customer.Customer</value>
		</managed-property>
		<managed-property>
			<property-name>aliasPrefix</property-name>
			<value>Customer_Lookup</value>
		</managed-property>
		<managed-property>
			<property-name>foreignJoinProperties</property-name>
			<list-entries>
				<value>id</value>
			</list-entries>
		</managed-property>
		<managed-property>
			<description>Needed for Search Select Window</description>
			<property-name>searchPagePath</property-name>
			<value>/finance/facelet/sw/customerSearch.faces</value>
		</managed-property>
	</managed-bean>
	
	<!-- ************* SUPPLIER ***************** -->
	<managed-bean>
		<managed-bean-name>supplierLookup</managed-bean-name>
		<managed-bean-class>
			com.code.aon.ui.purchase.controller.SupplierLookupController
		</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
		<managed-property>
			<property-name>queryOnStartUP</property-name>
			<value>true</value>
		</managed-property>
		<managed-property>
			<property-name>foreignPojo</property-name>
			<value>com.code.aon.purchase.Supplier</value>
		</managed-property>
		<managed-property>
			<property-name>aliasPrefix</property-name>
			<value>Supplier_Lookup</value>
		</managed-property>
		<managed-property>
			<property-name>foreignJoinProperties</property-name>
			<list-entries>
				<value>id</value>
			</list-entries>
		</managed-property>
		<managed-property>
			<description>Needed for Search Select Window</description>
			<property-name>searchPagePath</property-name>
			<value>/finance/facelet/sw/supplierSearch.faces</value>
		</managed-property>
	</managed-bean>
	
