<?xml version="1.0" encoding="UTF-8"?>

<!DOCTYPE bean-config 
	PUBLIC "-//CODE-AON//DTD Bean Config//EN" 
	"http://co-de.com/aon/bean-config.dtd">

<bean-config>

	<bean description="Listener para controlar los nombres de usuarios (emails)">
		<pojo>com.code.aon.ebackoffice.Ectarget</pojo>
		<vetoListeners>
	        <vetoListener>com.code.aon.ebackoffice.event.EctargetBeanVetoListener</vetoListener>
		</vetoListeners>
	</bean>
	
	<bean description="Listener para controlar que solo una configuracion activa">
		<pojo>com.code.aon.ebackoffice.Ecconfig</pojo>
		<vetoListeners>
	        <vetoListener>com.code.aon.ebackoffice.event.EcconfigBeanVetoListener</vetoListener>
		</vetoListeners>
	</bean>

</bean-config>