<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<ui:UiBinder xmlns:ui='urn:ui:com.google.gwt.uibinder'
	xmlns:g='urn:import:com.google.gwt.user.client.ui'>

	<ui:with type="com.esferalia.aon.gwt.common.client.i18n.CommonMessages"
		field="msg"></ui:with>
	<ui:with type="com.esferalia.aon.gwt.common.client.css.AonResources"
		field="aonResources"></ui:with>

	<g:FlowPanel height="100%"
		styleName="{aonResources.css.aonFindingTitleToolbar} {aonResources.css.aonWidthAll}">
		<g:HorizontalPanel>
			<g:HTMLPanel styleName="{aonResources.css.aonFindingTitle}">
				<g:HTMLPanel styleName="{aonResources.css.aonFindingTitleInternal}">
					<g:Label text="" ui:field="label" />
				</g:HTMLPanel>
			</g:HTMLPanel>
			<g:HTMLPanel styleName="aon-finding-subtitle">
				<g:HTMLPanel styleName="{aonResources.css.aonFindingSubtitleIternal}">
					<g:Label></g:Label>
				</g:HTMLPanel>
			</g:HTMLPanel>
			<g:HTMLPanel width="400px" styleName="{aonResources.css.aonFindingToolbar}">
				<g:HTMLPanel ui:field="buttonPanel"
					styleName="{aonResources.css.aonFindingToolbarItemGroup} {aonResources.css.aonWidthAll}">

				</g:HTMLPanel>
			</g:HTMLPanel>
		</g:HorizontalPanel>
	</g:FlowPanel>

</ui:UiBinder>
