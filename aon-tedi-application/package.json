{
  "name": "functions",
  "description": "Cloud Functions for Firebase",
  "main": "lib/index.js",
  "scripts": {
    "format": "prettier --write \"src/**/*.ts\" \"src/**/*.js\"",
    "lint": "tslint -p tsconfig.json",
    "copy-resources": "grunt copy",
    "build": "rimraf lib/ && tsc && npm run copy-resources",
    "test-mocha": "nyc mocha --opts ./test/mocha.opts",
    "test-cov": "nyc node_modules/mocha/bin/_mocha --opts ./test/mocha.opts",
    "_test-cov": "$env:GOOGLE_APPLICATION_CREDENTIALS='./test/service-account-key.json' nyc node_modules/mocha/bin/_mocha --opts ./test/mocha.opts",
    "test": "npm run test-cov && grunt clean",
    "prepare": "npm run format && npm run lint && npm run build && npm run test",
    "serve": "firebase serve --only functions",
    "shell": "firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log"
  },
  "dependencies": {
    "@google-cloud/vision": "^1.4.0",
    "aws-sdk": "^2.696.0",
    "file-type": "^14.6.2",
    "googleapis": "^39.2.0",
    "moment": "^2.22.2",
    "pdf.js-extract": "^0.1.1",
    "request": "^2.88.2",
    "rxjs": "^6.4.0",
    "voca": "^1.4.0"
  },
  "_dependencies": {
    "@google-cloud/automl": "^1.10.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.2",
    "@types/busboy": "^0.2.3",
    "@types/chai": "^4.2.7",
    "@types/chai-datetime": "0.0.33",
    "@types/cheerio": "^0.22.11",
    "@types/cors": "^2.8.5",
    "@types/faker": "^4.1.5",
    "@types/file-type": "^10.9.1",
    "@types/hapi__joi": "^15.0.1",
    "@types/js-base64": "^2.3.1",
    "@types/mailparser": "^2.7.3",
    "@types/mocha": "^5.2.7",
    "@types/multer": "^1.3.10",
    "@types/mysql": "^2.15.7",
    "@types/nconf": "^0.10.0",
    "@types/node": "^14.0.13",
    "@types/pdfkit": "^0.7.36",
    "@types/pify": "^3.0.2",
    "@types/sharp": "^0.22.2",
    "@types/supertest": "^2.0.7",
    "@types/voca": "^1.4.0",
    "browserify": "^16.5.1",
    "chai": "^4.2.0",
    "chai-datetime": "^1.5.0",
    "commander": "^2.16.0",
    "faker": "^4.1.0",
    "firebase-functions-test": "^0.1.6",
    "grunt": "^1.0.4",
    "grunt-contrib-clean": "^2.0.0",
    "grunt-contrib-copy": "^1.0.0",
    "install": "^0.12.2",
    "json-loader": "^0.5.7",
    "mailparser": "^2.7.7",
    "mocha": "^5.2.0",
    "mysql": "^2.17.1",
    "npm": "^6.13.3",
    "nyc": "^14.1.1",
    "prettier": "^1.19.1",
    "randexp": "^0.5.3",
    "read-chunk": "^3.2.0",
    "serverless-webpack": "^5.3.2",
    "source-map-support": "^0.5.16",
    "supertest": "^4.0.2",
    "tinyify": "^2.5.2",
    "ts-node": "^8.5.4",
    "tslint": "^5.20.1",
    "tslint-config-prettier": "^1.18.0",
    "typescript": "^3.7.3",
    "webpack": "^4.43.0",
    "webpack-cli": "^3.3.11"
  },
  "engines": {
    "node": "11"
  },
  "private": true,
  "nyc": {
    "extends": "@istanbuljs/nyc-config-typescript",
    "extension": [
      ".ts"
    ],
    "include": [
      ".",
      "src"
    ],
    "all": true,
    "reporter": [
      "text",
      "html"
    ],
    "check-coverage": true,
    "statements": 1,
    "functions": 1,
    "branches": 1,
    "lines": 1
  }
}
