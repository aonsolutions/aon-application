<?xml version="1.0" encoding="ISO-8859-1"?>

<!DOCTYPE report-config 
	PUBLIC "-//CODE-AON//DTD Report Config//EN" 
	"http://co-de.com/aon/report-config.dtd">

<report-config>

	<!-- ================================================================== -->
	<!--  INFORMES POR EMPRESA -->
	<!-- ================================================================== -->
	<report id="informeTgcEmpresa" description="Impresion del informe de prueba de empresa">
		<template path="/com/esferalia/tgc/ui/payroll/report/enterprise/informeTgcEmpresa.jasper" />
		<bean key="com.code.aon.company.Enterprise" />
		<criteria provider="#{enterprise}" />
		<params>
			<param id="REPORT_RESOURCE_BUNDLE" value="com.esferalia.tgc.ui.payroll.i18n.report" />
		</params>
	</report>

	<!-- ================================================================== -->
	<!--  INFORMES POR CONTRATO -->
	<!-- ================================================================== -->
	<report id="informeTgcContrato" description="Impresion del informe de prueba de contrato">
		<template path="/com/esferalia/tgc/ui/payroll/report/contract/informeTgcContrato.jasper" />
		<!--  
		<collection provider="#{contract}" forceRefresh="true" />
		-->
		<bean key="com.esferalia.aon.payroll.Contract" />
		<criteria provider="#{contract}" />
		<params>
			<param id="REPORT_RESOURCE_BUNDLE" value="com.esferalia.tgc.ui.payroll.i18n.report" />
		</params>
	</report>
	
	<report id="informeTgc2Contrato" description="Impresion del informe de prueba de contrato">
		<template path="/com/esferalia/tgc/ui/payroll/report/contract/informeTgc2Contrato.jasper" />
		<bean key="com.esferalia.aon.payroll.Contract" />
		<criteria provider="#{contract}" />
		<params>
			<param id="REPORT_RESOURCE_BUNDLE" value="com.esferalia.tgc.ui.payroll.i18n.report" />
		</params>
	</report>

	<!-- ================================================================== -->
	<!--  INFORMES POR PERSONA -->
	<!-- ================================================================== -->
	<report id="informeTgcPersona" description="Impresion del informe de prueba de presona">
		<template path="/com/esferalia/tgc/ui/payroll/report/person/informeTgcPersona.jasper" />
		<bean key="com.code.aon.person.Person" />
		<params>
			<param id="REPORT_RESOURCE_BUNDLE" value="com.esferalia.tgc.ui.payroll.i18n.report" />
		</params>
	</report>
	
	<report id="informeTgcAlphabetical" description="Listado alfabético de persona">
		<template path="/com/esferalia/tgc/ui/payroll/report/person/informeTgcAlphabetical.jasper" />
	<bean key="com.code.aon.person.Person" />
		<criteria provider="#{person}" />
		<params>
			<param id="REPORT_RESOURCE_BUNDLE" value="com.esferalia.tgc.ui.payroll.i18n.report" />
		</params>
	</report>
	
</report-config>