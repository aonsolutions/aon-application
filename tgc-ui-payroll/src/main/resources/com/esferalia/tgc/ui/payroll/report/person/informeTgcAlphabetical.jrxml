			<rightPen lineWidth="1.0"/>
		</box>
	</style>
	<parameter name="nestedReports" class="java.util.Map"/>
	<parameter name="showBackground" class="java.lang.Boolean">
		<defaultValueExpression><![CDATA[new Boolean(false)]]></defaultValueExpression>
	</parameter>
	<parameter name="company" class="com.code.aon.company.Company" isForPrompting="false"/>
