	<variable name="formatter" class="java.text.SimpleDateFormat">
		<initialValueExpression><![CDATA[new SimpleDateFormat("dd' de 'MMMMMMMMMMM' de 'yyyy")]]></initialValueExpression>
	</variable>
	<variable name="isFirstPage" class="java.lang.Boolean">
		<variableExpression><![CDATA[new Boolean($V{PAGE_NUMBER}.intValue()==1)]]></variableExpression>
	</variable>
	<group name="salary_GROUP" isStartNewPage="true">
