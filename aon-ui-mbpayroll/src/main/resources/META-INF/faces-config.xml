<faces-config version="1.2"
	xmlns="http://java.sun.com/xml/ns/javaee"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://java.sun.com/xml/ns/javaee http://java.sun.com/xml/ns/javaee/web-facesconfig_1_2.xsd">

	<application>
		<resource-bundle>
			<base-name>com.esferalia.aon.ui.payroll.i18n.messages</base-name>
			<var>payrollBundle</var>
		</resource-bundle>
	</application>

	<!-- ************ Payroll Collections **************** -->
	<managed-bean>
		<managed-bean-name>payrollCollections</managed-bean-name>
		<managed-bean-class>
			com.esferalia.aon.ui.payroll.controller.PayrollCollections
		</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
	</managed-bean>
	
	<!-- ************ Certificate Controller **************** -->
	<managed-bean>
		<managed-bean-name>enterpriseCertificate</managed-bean-name>
		<managed-bean-class>
			com.esferalia.aon.ui.payroll.controller.CertificateController
		</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
	</managed-bean>
	
	<!-- ************ Remesa Certificado Wizard **************** -->
	<managed-bean>
		<managed-bean-name>certificateBatchGenerationWizard</managed-bean-name>
		<managed-bean-class>
			com.esferalia.aon.ui.payroll.controller.CertificateBatchGenerationWizard
		</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
	</managed-bean>

	<!-- ************ Remesa Certificado Wizard **************** -->
	<managed-bean>
		<managed-bean-name>certificateFileGenerationWizard</managed-bean-name>
		<managed-bean-class>
			com.esferalia.aon.ui.payroll.controller.CertificateFileGenerationWizard
		</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
	</managed-bean>
	
	<!-- ************ Proceso de creacion de contratos **************** -->
	<managed-bean>
		<managed-bean-name>contractGenerationWizard</managed-bean-name>
		<managed-bean-class>
			com.esferalia.aon.ui.payroll.controller.ContractGenerationWizard
		</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
	</managed-bean>
	
	<!-- ************ Proceso de creacion del fichero AFI **************** -->
	<managed-bean>
		<managed-bean-name>contractBatchWizard</managed-bean-name>
		<managed-bean-class>
			com.esferalia.aon.ui.payroll.controller.ContractBatchWizard
		</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
	</managed-bean>

	<!-- =================== ParteIT Wizard Management========================== -->

	<navigation-rule id="certificateFileGenerationWizard">
	    <navigation-case>
    	  	<from-outcome>certificateFileGenerationWizard_step0</from-outcome>
    		<to-view-id>/com/esferalia/aon/ui/payroll/facelet/certificateFileGeneration/step0.xhtml</to-view-id>
	    </navigation-case>
	    <navigation-case>
    	  	<from-outcome>certificateFileGenerationWizard_step1</from-outcome>
    		<to-view-id>/com/esferalia/aon/ui/payroll/facelet/certificateFileGeneration/step1.xhtml</to-view-id>
	    </navigation-case>
	    <navigation-case>
    	  	<from-outcome>certificateFileGenerationWizard_step2</from-outcome>
    		<to-view-id>/com/esferalia/aon/ui/payroll/facelet/certificateFileGeneration/step2.xhtml</to-view-id>
	    </navigation-case>
	    <navigation-case>
    	  	<from-outcome>certificateFileGenerationWizard_step3</from-outcome>
    		<to-view-id>/com/esferalia/aon/ui/payroll/facelet/certificateFileGeneration/step3.xhtml</to-view-id>
	    </navigation-case>
	</navigation-rule>

	<navigation-rule id="certificateBatchGenerationWizard">
	    <navigation-case>
    	  	<from-outcome>certificateBatchGenerationWizard_step0</from-outcome>
    		<to-view-id>/com/esferalia/aon/ui/payroll/facelet/certificateBatchGeneration/step0.xhtml</to-view-id>
	    </navigation-case>
	    <navigation-case>
    	  	<from-outcome>certificateBatchGenerationWizard_step1</from-outcome>
    		<to-view-id>/com/esferalia/aon/ui/payroll/facelet/certificateBatchGeneration/step1.xhtml</to-view-id>
	    </navigation-case>
	    <navigation-case>
    	  	<from-outcome>certificateBatchGenerationWizard_step2</from-outcome>
    		<to-view-id>/com/esferalia/aon/ui/payroll/facelet/certificateBatchGeneration/step2.xhtml</to-view-id>
	    </navigation-case>
	</navigation-rule>

	<navigation-rule id="contractGenerationWizard">
	    <navigation-case>
    	  	<from-outcome>contractGenerationWizard_step0</from-outcome>
    		<to-view-id>/com/esferalia/aon/ui/payroll/facelet/contractGeneration/step0.xhtml</to-view-id>
	    </navigation-case>
	    <navigation-case>
    	  	<from-outcome>contractGenerationWizard_step1</from-outcome>
    		<to-view-id>/com/esferalia/aon/ui/payroll/facelet/contractGeneration/step1.xhtml</to-view-id>
	    </navigation-case>
	    <navigation-case>
    	  	<from-outcome>contractGenerationWizard_step2</from-outcome>
    		<to-view-id>/com/esferalia/aon/ui/payroll/facelet/contractGeneration/step2.xhtml</to-view-id>
	    </navigation-case>
	    <navigation-case>
    	  	<from-outcome>contractGenerationWizard_step3</from-outcome>
    		<to-view-id>/com/esferalia/aon/ui/payroll/facelet/contractGeneration/step3.xhtml</to-view-id>
	    </navigation-case>
	    <navigation-case>
    	  	<from-outcome>contractGenerationWizard_step4</from-outcome>
    		<to-view-id>/com/esferalia/aon/ui/payroll/facelet/contractGeneration/step4.xhtml</to-view-id>
	    </navigation-case>
	    <navigation-case>
    	  	<from-outcome>contractGenerationWizard_step5</from-outcome>
    		<to-view-id>/com/esferalia/aon/ui/payroll/facelet/contractGeneration/step5.xhtml</to-view-id>
	    </navigation-case>
	</navigation-rule>

	<navigation-rule id="contractBatchWizard">
	    <navigation-case>
    	  	<from-outcome>contractBatchWizard_step0</from-outcome>
    		<to-view-id>/com/esferalia/aon/ui/payroll/facelet/contractBatch/step0.xhtml</to-view-id>
	    </navigation-case>
	    <navigation-case>
    	  	<from-outcome>contractBatchWizard_step1</from-outcome>
    		<to-view-id>/com/esferalia/aon/ui/payroll/facelet/contractBatch/step1.xhtml</to-view-id>
	    </navigation-case>
	    <navigation-case>
    	  	<from-outcome>contractBatchWizard_step2</from-outcome>
    		<to-view-id>/com/esferalia/aon/ui/payroll/facelet/contractBatch/step2.xhtml</to-view-id>
	    </navigation-case>
	    <navigation-case>
    	  	<from-outcome>contractBatchWizard_step3</from-outcome>
    		<to-view-id>/com/esferalia/aon/ui/payroll/facelet/contractBatch/step3.xhtml</to-view-id>
	    </navigation-case>
	</navigation-rule>

</faces-config>
