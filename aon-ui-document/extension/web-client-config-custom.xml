<alfresco-config>

   <config evaluator="string-compare" condition="Views">
      <views>
         <view-defaults>
			<browse>
				<!-- allowable values: list|details|icons -->
				<view>details</view>
				<page-size>
					<list>20</list>
					<details>20</details>
					<icons>20</icons>
				</page-size>
			</browse>
         </view-defaults>
      </views>
   </config>

   <config evaluator="aspect-name" condition="aon:enterpriseDocument">
      <property-sheet>
         <show-property name="aon:enterpriseId" display-label-id="aon.enterpriseId" />
      </property-sheet>
   </config>

   <config evaluator="string-compare" condition="Action Wizards">
      <aspects>
         <aspect name="aon:enterpriseDocument" display-label-id="aon.enterpriseDocument" />
      </aspects>
   </config>
   
</alfresco-config>