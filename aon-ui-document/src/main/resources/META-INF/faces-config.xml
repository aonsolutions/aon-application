<faces-config version="1.2"
	xmlns="http://java.sun.com/xml/ns/javaee"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://java.sun.com/xml/ns/javaee http://java.sun.com/xml/ns/javaee/web-facesconfig_1_2.xsd">

	<application>
		<resource-bundle>
			<base-name>com.code.aon.ui.document.i18n.messages</base-name>
			<var>documentBundle</var>
		</resource-bundle>
	</application>
	
	<!-- ********* AlfrescoCategory CONVERTER ************* -->
	<converter>
		<converter-for-class>com.code.aon.document.AlfrescoCategory</converter-for-class>
		<converter-class>com.code.aon.ui.document.converter.AlfrescoCategoryConverter</converter-class>
	</converter>
	
	<!-- ************* MANAGER ***************** -->
	<managed-bean>
		<managed-bean-name>manager</managed-bean-name>
		<managed-bean-class>
			com.code.aon.ui.document.controller.ManagerController
		</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
	</managed-bean>	
	
	<!-- ************ ENTERPRISE DOCUMENT ************** -->
	<managed-bean>
		<managed-bean-name>enterpriseDocument</managed-bean-name>
		<managed-bean-class>
			com.code.aon.ui.document.controller.EnterpriseDocumentController
		</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
		<managed-property>
			<property-name>queryOnStartUP</property-name>
			<value>true</value>
		</managed-property>
		<managed-property>
			<property-name>pojo</property-name>
			<value>com.code.aon.document.EnterpriseDocument</value>
		</managed-property>
		<managed-property>
			<property-name>beanName</property-name>
			<value>enterpriseDocument</value>
		</managed-property>
		<managed-property>
			<property-name>saveState</property-name>
			<value>false</value>
		</managed-property>
		<managed-property>
			<property-name>defaultOrder</property-name>
			<value>cm:name</value>
		</managed-property>
		<managed-property>
			<property-name>listenerClasses</property-name>
			<list-entries>
				<value-class>com.code.aon.ui.form.event.IControllerListener</value-class>
				<value>#{enterpriseDocumentListener}</value>
				<value>#{enterpriseDocumentSearch}</value>
			</list-entries>
		</managed-property>				
	</managed-bean>
	
	<managed-bean>
		<managed-bean-name>enterpriseDocumentListener</managed-bean-name>
		<managed-bean-class>com.code.aon.ui.document.event.EnterpriseDocumentControllerListener</managed-bean-class>
		<managed-bean-scope>none</managed-bean-scope>
	</managed-bean>		
	
	<managed-bean>
		<managed-bean-name>enterpriseDocumentSearch</managed-bean-name>
		<managed-bean-class>com.code.aon.ui.document.event.EnterpriseDocumentSearchListener</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
	</managed-bean>	
	
	<!--  **** ENTERPRISE TREE **** -->
	<managed-bean>
		<managed-bean-name>enterpriseTree</managed-bean-name>
		<managed-bean-class>com.code.aon.ui.document.tree.EnterpriseTree</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
	</managed-bean>
	
	<managed-bean>
		<managed-bean-name>enterpriseTreeControllerListener</managed-bean-name>
		<managed-bean-class>com.code.aon.ui.document.event.EnterpriseTreeControllerListener</managed-bean-class>
		<managed-bean-scope>none</managed-bean-scope>
	</managed-bean>	
	
	<!-- ************ ALFRESCO CATEGORY GROUP ************** -->
	<managed-bean>
		<managed-bean-name>alfrescoCategoryGroup</managed-bean-name>
		<managed-bean-class>
			com.code.aon.ui.document.controller.AlfrescoCategoryGroupController
		</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
		<managed-property>
			<property-name>queryOnStartUP</property-name>
			<value>true</value>
		</managed-property>
		<managed-property>
			<property-name>pojo</property-name>
			<value>com.code.aon.document.AlfrescoCategory</value>
		</managed-property>
		<managed-property>
			<property-name>beanName</property-name>
			<value>alfrescoCategoryGroup</value>
		</managed-property>
		<managed-property>
			<property-name>defaultOrder</property-name>
			<value>cm:name</value>
		</managed-property>		
		<managed-property>
			<property-name>saveState</property-name>
			<value>false</value>
		</managed-property>
		<managed-property>
			<property-name>listenerClasses</property-name>
			<list-entries>
				<value-class>com.code.aon.ui.form.event.IControllerListener</value-class>
				<value>#{alfrescoCategroyGroupListener}</value>
			</list-entries>
		</managed-property>				
	</managed-bean>
	
	<managed-bean>
		<managed-bean-name>alfrescoCategroyGroupListener</managed-bean-name>
		<managed-bean-class>com.code.aon.ui.document.event.AlfrescoCategroyGroupControllerListener</managed-bean-class>
		<managed-bean-scope>none</managed-bean-scope>
	</managed-bean>		
	
	<!-- ************ ALFRESCO CATEGORY ************** -->
	<managed-bean>
		<managed-bean-name>alfrescoCategory</managed-bean-name>
		<managed-bean-class>
			com.code.aon.ui.document.controller.AlfrescoCategoryController
		</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
		<managed-property>
			<property-name>queryOnStartUP</property-name>
			<value>true</value>
		</managed-property>
		<managed-property>
			<property-name>pojo</property-name>
			<value>com.code.aon.document.AlfrescoCategory</value>
		</managed-property>
		<managed-property>
			<property-name>beanName</property-name>
			<value>alfrescoCategory</value>
		</managed-property>
		<managed-property>
			<property-name>defaultOrder</property-name>
			<value>cm:name</value>
		</managed-property>		
		<managed-property>
			<property-name>saveState</property-name>
			<value>false</value>
		</managed-property>
	</managed-bean>	
	
	<!-- ************ BATCH DOCUMENT ************** -->
	<managed-bean>
		<managed-bean-name>batchDocument</managed-bean-name>
		<managed-bean-class>
			com.code.aon.ui.document.controller.BatchDocument
		</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
		<managed-property>
			<property-name>beanName</property-name>
			<value>batchDocument</value>
		</managed-property>		
	</managed-bean>	
	
	<!-- =================== Enterprise Document ========================== -->
	<navigation-rule>
		<navigation-case>
			<from-outcome>enterpriseDocument_search</from-outcome>
			<to-view-id>/com/code/aon/ui/document/facelet/enterpriseDocument/search.xhtml</to-view-id>
		</navigation-case>
		<navigation-case>
			<from-outcome>enterpriseDocument_form</from-outcome>
			<to-view-id>/com/code/aon/ui/document/facelet/enterpriseDocument/form.xhtml</to-view-id>
		</navigation-case>
	</navigation-rule>	

	<!-- =================== Alfresco Category ========================== -->
	<navigation-rule>
		<navigation-case>
			<from-outcome>alfrescoCategoryGroup_list</from-outcome>
			<to-view-id>/com/code/aon/ui/document/facelet/alfrescoCategoryGroup/list.xhtml</to-view-id>
		</navigation-case>
		<navigation-case>
			<from-outcome>alfrescoCategoryGroup_form</from-outcome>
			<to-view-id>/com/code/aon/ui/document/facelet/alfrescoCategoryGroup/form.xhtml</to-view-id>
		</navigation-case>
	</navigation-rule>	

	<!-- =================== Enterprise Tree  ========================== -->
	<navigation-rule>
		<navigation-case>
			<from-outcome>enterprise_formTree</from-outcome>
			<to-view-id>/com/code/aon/ui/document/facelet/enterpriseTree/formTree.xhtml</to-view-id>
		</navigation-case>
		<navigation-case>
			<from-outcome>enterpriseDocument_formTree</from-outcome>
			<to-view-id>/com/code/aon/ui/document/facelet/enterpriseDocument/formTree.xhtml</to-view-id>
		</navigation-case>
		<navigation-case>
			<from-outcome>project_formTree</from-outcome>
			<to-view-id>/com/code/aon/ui/document/facelet/enterpriseDocument/projectFormTree.xhtml</to-view-id>
		</navigation-case>
	</navigation-rule>
	
	<!-- =================== Batch Document ========================== -->
	<navigation-rule>
		<navigation-case>
			<from-outcome>batchDocument_form</from-outcome>
			<to-view-id>/com/code/aon/ui/document/facelet/batchDocument/form.xhtml</to-view-id>
		</navigation-case>
		<navigation-case>
			<from-outcome>batchDocument_search</from-outcome>
			<to-view-id>/com/code/aon/ui/document/facelet/batchDocument/search.xhtml</to-view-id>
		</navigation-case>
		<navigation-case>
			<from-outcome>batchDocument_list</from-outcome>
			<to-view-id>/com/code/aon/ui/document/facelet/batchDocument/list.xhtml</to-view-id>
		</navigation-case>
	</navigation-rule>	
	
		
</faces-config>