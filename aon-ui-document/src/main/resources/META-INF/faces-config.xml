<faces-config version="1.2"
	xmlns="http://java.sun.com/xml/ns/javaee"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://java.sun.com/xml/ns/javaee http://java.sun.com/xml/ns/javaee/web-facesconfig_1_2.xsd">

	<!-- ********* AlfrescoCategory CONVERTER ************* -->
	<converter>
		<converter-for-class>com.code.aon.document.AlfrescoCategory</converter-for-class>
		<converter-class>com.code.aon.ui.document.converter.AlfrescoCategoryConverter</converter-class>
	</converter>
	
	<!-- ************* MANAGER ***************** -->
	<managed-bean>
		<managed-bean-name>manager</managed-bean-name>
		<managed-bean-class>
			com.code.aon.ui.document.controller.ManagerController
		</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
	</managed-bean>	
	
	<!-- ************ ENTERPRISE DOCUMENT ************** -->
	<managed-bean>
		<managed-bean-name>enterpriseDocument</managed-bean-name>
		<managed-bean-class>
			com.code.aon.ui.document.controller.EnterpriseDocumentController
		</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
		<managed-property>
			<property-name>queryOnStartUP</property-name>
			<value>true</value>
		</managed-property>
		<managed-property>
			<property-name>pojo</property-name>
			<value>com.code.aon.document.EnterpriseDocument</value>
		</managed-property>
		<managed-property>
			<property-name>beanName</property-name>
			<value>enterpriseDocument</value>
		</managed-property>
		<managed-property>
			<property-name>cascadeDelete</property-name>
			<value>true</value>
		</managed-property>
		<managed-property>
			<property-name>saveState</property-name>
			<value>false</value>
		</managed-property>
		<managed-property>
			<property-name>masterControllerName</property-name>
			<value>enterprise</value>
		</managed-property>
		<managed-property>
			<property-name>propertyMap</property-name>
			<map-entries>
				<map-entry>
					<key>id</key>
					<value>enterprise.id</value>
				</map-entry>
			</map-entries>
		</managed-property>
		<managed-property>
			<property-name>defaultOrder</property-name>
			<value>cm:name</value>
		</managed-property>
		<managed-property>
			<property-name>listenerClasses</property-name>
			<list-entries>
				<value-class>com.code.aon.ui.form.event.IControllerListener</value-class>
				<value>#{enterpriseDocumentListener}</value>
				<value>#{enterpriseDocumentSearch}</value>
			</list-entries>
		</managed-property>				
	</managed-bean>
	
	<managed-bean>
		<managed-bean-name>enterpriseDocumentListener</managed-bean-name>
		<managed-bean-class>com.code.aon.ui.document.event.EnterpriseDocumentControllerListener</managed-bean-class>
		<managed-bean-scope>none</managed-bean-scope>
	</managed-bean>		
	
	<managed-bean>
		<managed-bean-name>enterpriseDocumentSearch</managed-bean-name>
		<managed-bean-class>com.code.aon.ui.document.event.EnterpriseDocumentSearchListener</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
	</managed-bean>	
	
	<!-- =================== Enterprise Document ========================== -->
	<navigation-rule>
		<navigation-case>
			<from-outcome>enterpriseDocument_search</from-outcome>
			<to-view-id>/com/code/aon/ui/document/facelet/enterpriseDocument/search.xhtml</to-view-id>
		</navigation-case>
		<navigation-case>
			<from-outcome>enterpriseDocument_list</from-outcome>
			<to-view-id>/com/code/aon/ui/document/facelet/enterpriseDocument/list.xhtml</to-view-id>
		</navigation-case>
		<navigation-case>
			<from-outcome>enterpriseDocument_form</from-outcome>
			<to-view-id>/com/code/aon/ui/document/facelet/enterpriseDocument/form.xhtml</to-view-id>
		</navigation-case>
	</navigation-rule>	
	
</faces-config>
