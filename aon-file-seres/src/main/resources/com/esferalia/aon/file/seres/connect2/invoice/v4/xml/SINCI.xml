<?xml version="1.0" encoding="ISO-8859-1"?>
<register name="SINCI">
	<field name="Tipo de Registro SINCI" value="SINCI" format="AlphaNumeric" pattern="X(6)" />
	<field name="Número de línea de impuesto" value="bean" bean ="SINCI" property="numeroDeLineaDeImpuesto" format="Numeric" pattern="9(2)" />
	<field name="Calificador Tipo de Impuesto" value="bean" bean ="SINCI" property="calificadorTipoDeImpuesto" format="AlphaNumeric" pattern="X(6)" />
	<field name="% Tipo de Impuesto" value="bean" bean ="SINCI" property="porcentajeTipoDeImpuesto" format="Numeric" pattern="9(3).99" />
	<field name="Importe Tipo de Impuesto" value="bean" bean ="SINCI" property="importeTipoDeImpuesto" format="Numeric" pattern="9(14).999" />
	<field name="Base Imponible" value="bean" bean ="SINCI" property="baseImponible" format="Numeric" pattern="9(14).999" />
</register>