	<field name="Cantidad Dividida (11)" value="bean" bean="SEH1G" property="cantidadDividida_11_" format="Numeric" pattern="9(2).999" />
	<field name="Peso Envío Dividido en KGM" value="bean" bean="SEH1G" property="pesoEnvioDivididoEnKGM" format="Numeric" pattern="9(2).999" />
</register>