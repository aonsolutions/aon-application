	<field name="Número Aviso de Expedición" value="bean" bean="SEH1G" property="numeroAvisoDeExpedicion" format="AlphaNumeric" pattern="X(17)" />
	<field name="Código Emisor  (MS)" value="bean" bean="SEH1G" property="codigoEmisor_MS_" format="AlphaNumeric" pattern="X(17)" />
	<field name="Código Receptor (MR)" value="bean" bean="SEH1G" property="codigoReceptor_MR_" format="AlphaNumeric" pattern="X(17)" />
	<field name="Número de Jerarquía de Embalaje" value="bean" bean="SEH1G" property="numeroDeJerarquiaDeEmbalaje" format="Numeric" pattern="9(12)" />
	<field name="Número de Sub-jerarquía de Embalaje" value="bean" bean="SEH1G" property="numeroDeSub_jerarquiaDeEmbalaje" format="AlphaNumeric" pattern="X(12)" />
