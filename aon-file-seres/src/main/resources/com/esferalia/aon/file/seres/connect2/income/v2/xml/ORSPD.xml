<?xml version="1.0" encoding="ISO-8859-1"?>
<register name="ORSPD">
<field name="Tipo registro ORSPD" value="ORSPD" format="AlphaNumeric" pattern="X(6)" />
<field name="Número Descuento/Cargo" value="bean" bean ="ORSPD" property="numeroDescuento_Cargo" format="Numeric" pattern="9(2)" />
<field name="Indicador Descuento/Cargo (A/C)" value="bean" bean ="ORSPD" property="indicadorDescuento_Cargo_A_C_" format="AlphaNumeric" pattern="X(1)" />
<field name="Indicador Secuencia de cálculo" value="bean" bean ="ORSPD" property="indicadorSecuenciaDeCalculo" format="AlphaNumeric" pattern="X(3)" />
<field name="Tipo Descuento/Cargo" value="bean" bean ="ORSPD" property="tipoDescuento_Cargo" format="AlphaNumeric" pattern="X(3)" />
<field name="Descripción Descuento/Cargo" value="bean" bean ="ORSPD" property="descripcionDescuento_Cargo" format="AlphaNumeric" pattern="X(70)" />
<field name="Porcentaje Descuento/Cargo" value="bean" bean ="ORSPD" property="porcentajeDescuento_Cargo" format="Numeric" pattern="9(4).9999" />
<field name="Importe Descuento/Cargo" value="bean" bean ="ORSPD" property="importeDescuento_Cargo" format="Numeric" pattern="9(14).999" />
<field name="Importe Total Sujeto a Aplicación (13)" value="bean" bean ="ORSPD" property="importeTotalSujetoAAplicación_13_" format="Numeric" pattern="9(14).999" />
<field name="Descuentos Monetarios por Unidad" value="bean" bean ="ORSPD" property="descuentosMonetariosPorUnidad" format="Numeric" pattern="9(14).999" />
<field name="Unidad de Medida" value="bean" bean ="ORSPD" property="unidadDeMedida" format="AlphaNumeric" pattern="X(6)" />
</register>