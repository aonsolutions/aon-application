<?xml version="1.0" encoding="ISO-8859-1"?>
<xs:schema targetNamespace="http://www.seg-social.es/creta/esquemas/V100/RelacionNominalTrabajadores" xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns="http://www.seg-social.es/creta/esquemas/V100/RelacionNominalTrabajadores" elementFormDefault="qualified" attributeFormDefault="unqualified">
	<xs:element name="RelacionNominalTrabajadores">
		<xs:complexType>
			<xs:sequence>
				<xs:element ref="Autorizado"/>
				<xs:element ref="Liquidacion"/>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<xs:element name="Autorizado">
		<xs:simpleType>
			<xs:restriction base="xs:string">
				<xs:pattern value="\d\d\d\d\d\d\d\d"/>
			</xs:restriction>
		</xs:simpleType>
	</xs:element>
	<xs:element name="Liquidacion">
		<xs:complexType>
			<xs:sequence>
				<xs:element ref="Ccc"/>
				<xs:element ref="CccConcertado" minOccurs="0"/>
				<xs:element ref="PeriodoDesde"/>
				<xs:element ref="PeriodoHasta"/>
				<xs:element ref="Tipo"/>
				<xs:element ref="FechaControl" minOccurs="0"/>
				<xs:element ref="Estado"/>
				<xs:element ref="FechaHoraRecaudacion"/>
				<xs:element ref="DatosCabeceraRNT"/>
				<xs:element ref="DatosCuerpoRNT"/>
				<xs:element ref="DatosPieRNT"/>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<xs:complexType name="CtaCot">
		<xs:sequence>
			<xs:element ref="Regimen"/>
			<xs:element ref="Provincia"/>
			<xs:element ref="Numero"/>
		</xs:sequence>
	</xs:complexType>
	<xs:element name="Ccc" type="CtaCot"/>
	<xs:element name="CccConcertado" type="CtaCot"/>
	<xs:element name="Regimen">
		<xs:simpleType>
			<xs:restriction base="xs:string">
				<xs:pattern value="\d\d\d\d"/>
			</xs:restriction>
		</xs:simpleType>
	</xs:element>
	<xs:element name="Provincia">
		<xs:simpleType>
			<xs:restriction base="xs:string">
				<xs:pattern value="\d\d"/>
			</xs:restriction>
		</xs:simpleType>
	</xs:element>
	<xs:element name="Numero">
		<xs:simpleType>
			<xs:restriction base="xs:string">
				<xs:pattern value="\d{9}"/>
			</xs:restriction>
		</xs:simpleType>
	</xs:element>
	<xs:complexType name="Periodo">
		<xs:sequence>
			<xs:element ref="Mes"/>
			<xs:element ref="Anho"/>
		</xs:sequence>
	</xs:complexType>
	<xs:element name="Mes">
		<xs:simpleType>
			<xs:restriction base="xs:string">
				<xs:enumeration value="12"/>
				<xs:enumeration value="11"/>
				<xs:enumeration value="10"/>
				<xs:enumeration value="09"/>
				<xs:enumeration value="08"/>
				<xs:enumeration value="07"/>
				<xs:enumeration value="06"/>
				<xs:enumeration value="05"/>
				<xs:enumeration value="04"/>
				<xs:enumeration value="03"/>
				<xs:enumeration value="02"/>
				<xs:enumeration value="01"/>
			</xs:restriction>
		</xs:simpleType>
	</xs:element>
	<xs:element name="Anho">
		<xs:simpleType>
			<xs:restriction base="xs:string">
				<xs:length value="4"/>
				<xs:pattern value="\d{4}"/>
			</xs:restriction>
		</xs:simpleType>
	</xs:element>
	<xs:element name="PeriodoDesde" type="Periodo"/>
	<xs:element name="PeriodoHasta" type="Periodo"/>
	<xs:element name="Tipo">
		<xs:simpleType>
			<xs:restriction base="xs:string">
				<xs:minLength value="3"/>
				<xs:maxLength value="3"/>
			</xs:restriction>
		</xs:simpleType>
	</xs:element>
	<xs:element name="FechaControl" type="Periodo"/>
	<xs:element name="Estado">
		<xs:simpleType>
			<xs:restriction base="xs:string">
				<xs:length value="1"/>
			</xs:restriction>
		</xs:simpleType>
	</xs:element>
	<xs:element name="FechaHoraRecaudacion">
		<xs:complexType>
			<xs:sequence>
				<xs:element ref="FechaRecaudacion"/>
				<xs:element ref="HoraRecaudacion"/>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<xs:element name="FechaRecaudacion" type="Fecha"/>
	<xs:element name="HoraRecaudacion">
		<xs:simpleType>
			<xs:restriction base="xs:string">
				<xs:length value="6"/>
				<xs:pattern value="\d{6}"/>
			</xs:restriction>
		</xs:simpleType>
	</xs:element>
	<xs:element name="DatosCabeceraRNT">
		<xs:complexType>
			<xs:sequence>
				<xs:element ref="DatosEnvio"/>
				<xs:element ref="DatosLiquidacion"/>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<xs:element name="DatosEnvio">
		<xs:complexType>
			<xs:sequence>
				<xs:element ref="Autorizado"/>
				<xs:element ref="Envio"/>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<xs:element name="Envio">
		<xs:simpleType>
			<xs:restriction base="xs:string">
				<xs:length value="10"/>
				<xs:pattern value="\d{10}"/>
			</xs:restriction>
		</xs:simpleType>
	</xs:element>
	<xs:element name="DatosLiquidacion">
		<xs:complexType>
			<xs:sequence>
				<xs:element ref="Ccc"/>
				<xs:element ref="PeriodoDesde"/>
				<xs:element ref="PeriodoHasta"/>
				<xs:element ref="DescripcionTipoLiquidacion"/>
				<xs:element ref="RazonSocial"/>
				<xs:element ref="Empresario"/>
				<xs:element ref="EntidadAtEp"/>
				<xs:element ref="NumeroTrabajadores"/>
				<xs:element ref="NumeroLiquidacion"/>
				<xs:element ref="AlcanceCalculo"/>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<xs:element name="DescripcionTipoLiquidacion">
		<xs:simpleType>
			<xs:restriction base="xs:string">
				<xs:maxLength value="50"/>
			</xs:restriction>
		</xs:simpleType>
	</xs:element>
	<xs:element name="RazonSocial">
		<xs:simpleType>
			<xs:restriction base="xs:string">
				<xs:maxLength value="55"/>
			</xs:restriction>
		</xs:simpleType>
	</xs:element>
	<xs:element name="Empresario" type="Ipf"/>
	<xs:element name="EntidadAtEp">
		<xs:simpleType>
			<xs:restriction base="xs:string">
				<xs:maxLength value="50"/>
			</xs:restriction>
		</xs:simpleType>
	</xs:element>
	<xs:element name="NumeroTrabajadores">
		<xs:simpleType>
			<xs:restriction base="xs:string">
				<xs:minLength value="1"/>
				<xs:maxLength value="6"/>
			</xs:restriction>
		</xs:simpleType>
	</xs:element>
	<xs:element name="NumeroLiquidacion">
		<xs:simpleType>
			<xs:restriction base="xs:string">
				<xs:length value="17"/>
				<xs:pattern value="\d{17}"/>
			</xs:restriction>
		</xs:simpleType>
	</xs:element>
	<xs:element name="AlcanceCalculo">
		<xs:simpleType>
			<xs:restriction base="xs:string">
				<xs:maxLength value="50"/>
			</xs:restriction>
		</xs:simpleType>
	</xs:element>
	<xs:element name="DatosCuerpoRNT">
		<xs:complexType>
			<xs:sequence>
				<xs:element ref="LineaRNT" maxOccurs="unbounded"/>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<xs:element name="LineaRNT">
		<xs:complexType>
			<xs:sequence>
				<xs:element ref="NafLRNT"/>
				<xs:element ref="IpfLRNT"/>
				<xs:element ref="CafLRNT"/>
				<xs:element ref="FechaDesdeLRNT"/>
				<xs:element ref="FechaHastaLRNT"/>
				<xs:element ref="DiasCotizadosLRNT"/>
				<xs:element ref="HorasCotizadasLRNT" minOccurs="0"/>
				<xs:element ref="DescripcionLRNT"/>
				<xs:element ref="ImporteLRNT"/>
				<xs:element ref="HorasComplementariasLRNT" minOccurs="0"/>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<xs:element name="NafLRNT">
		<xs:simpleType>
			<xs:restriction base="xs:string">
				<xs:pattern value="\d{12}"/>
			</xs:restriction>
		</xs:simpleType>
	</xs:element>
	<xs:element name="IpfLRNT" type="Ipf"/>
	<xs:complexType name="Ipf">
		<xs:sequence>
			<xs:element ref="TipoIpf"/>
			<xs:element ref="NumeroIpf"/>
		</xs:sequence>
	</xs:complexType>
	<xs:element name="TipoIpf">
		<xs:simpleType>
			<xs:restriction base="xs:string">
				<xs:pattern value="\w"/>
			</xs:restriction>
		</xs:simpleType>
	</xs:element>
	<xs:element name="NumeroIpf">
		<xs:simpleType>
			<xs:restriction base="xs:string">
				<xs:pattern value="\w{10}"/>
			</xs:restriction>
		</xs:simpleType>
	</xs:element>
	<xs:element name="CafLRNT">
		<xs:simpleType>
			<xs:restriction base="xs:string">
				<xs:maxLength value="5"/>
			</xs:restriction>
		</xs:simpleType>
	</xs:element>
	<xs:complexType name="Fecha">
		<xs:sequence>
			<xs:element ref="Dia"/>
			<xs:element ref="Mes"/>
			<xs:element ref="Anho"/>
		</xs:sequence>
	</xs:complexType>
	<xs:element name="Dia">
		<xs:simpleType>
			<xs:restriction base="xs:string">
				<xs:minLength value="2"/>
				<xs:maxLength value="2"/>
				<xs:pattern value="\d\d"/>
			</xs:restriction>
		</xs:simpleType>
	</xs:element>
	<xs:element name="FechaDesdeLRNT" type="Fecha"/>
	<xs:element name="FechaHastaLRNT" type="Fecha"/>
	<xs:element name="DiasCotizadosLRNT">
		<xs:simpleType>
			<xs:restriction base="xs:string">
				<xs:minLength value="1"/>
				<xs:maxLength value="2"/>
			</xs:restriction>
		</xs:simpleType>
	</xs:element>
	<xs:element name="HorasCotizadasLRNT">
		<xs:simpleType>
			<xs:restriction base="xs:string">
				<xs:minLength value="1"/>
				<xs:maxLength value="3"/>
			</xs:restriction>
		</xs:simpleType>
	</xs:element>
	<xs:element name="DescripcionLRNT">
		<xs:simpleType>
			<xs:restriction base="xs:string">
				<xs:maxLength value="50"/>
			</xs:restriction>
		</xs:simpleType>
	</xs:element>
	<xs:element name="ImporteLRNT">
		<xs:simpleType>
			<xs:restriction base="xs:string">
				<xs:minLength value="1"/>
				<xs:maxLength value="11"/>
			</xs:restriction>
		</xs:simpleType>
	</xs:element>
	<xs:element name="HorasComplementariasLRNT">
		<xs:simpleType>
			<xs:restriction base="xs:string">
				<xs:minLength value="1"/>
				<xs:maxLength value="3"/>
			</xs:restriction>
		</xs:simpleType>
	</xs:element>
	<xs:element name="DatosPieRNT">
		<xs:complexType>
			<xs:sequence>
				<xs:element ref="DatosPieInformeRNT"/>
				<xs:element ref="DatosPiePaginaRNT"/>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<xs:element name="DatosPieInformeRNT">
		<xs:complexType>
			<xs:sequence>
				<xs:element ref="LineaPieIRNT" maxOccurs="unbounded"/>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<xs:element name="LineaPieIRNT">
		<xs:complexType>
			<xs:sequence>
				<xs:element ref="TipoLineaPieIRNT"/>
				<xs:element ref="DescripcionSumaIRNT"/>
				<xs:element ref="ImporteSumaIRNT"/>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<xs:element name="TipoLineaPieIRNT">
		<xs:simpleType>
			<xs:restriction base="xs:string">
				<xs:enumeration value="B"/>
				<xs:enumeration value="C"/>
			</xs:restriction>
		</xs:simpleType>
	</xs:element>
	<xs:element name="DescripcionSumaIRNT">
		<xs:simpleType>
			<xs:restriction base="xs:string">
				<xs:maxLength value="50"/>
			</xs:restriction>
		</xs:simpleType>
	</xs:element>
	<xs:element name="ImporteSumaIRNT">
		<xs:simpleType>
			<xs:restriction base="xs:string">
				<xs:minLength value="1"/>
				<xs:maxLength value="11"/>
			</xs:restriction>
		</xs:simpleType>
	</xs:element>
	<xs:element name="DatosPiePaginaRNT">
		<xs:complexType>
			<xs:sequence>
				<xs:element ref="Autorizado"/>
				<xs:element ref="FechaAutorizacionPieRNT"/>
				<xs:element ref="TitularAutorizacionPieRNT"/>
				<xs:element ref="CodificacionesInformaticas"/>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<xs:element name="FechaAutorizacionPieRNT" type="Fecha"/>
	<xs:element name="TitularAutorizacionPieRNT">
		<xs:simpleType>
			<xs:restriction base="xs:string">
				<xs:maxLength value="55"/>
			</xs:restriction>
		</xs:simpleType>
	</xs:element>
	<xs:element name="CodificacionesInformaticas">
		<xs:complexType>
			<xs:sequence>
				<xs:element ref="ReferenciaCI"/>
				<xs:element ref="FechaCI"/>
				<xs:element ref="HoraCI"/>
				<xs:element ref="HuellaCI"/>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<xs:element name="ReferenciaCI">
		<xs:simpleType>
			<xs:restriction base="xs:string">
				<xs:length value="14"/>
				<xs:pattern value="\w{14}"/>
			</xs:restriction>
		</xs:simpleType>
	</xs:element>
	<xs:element name="FechaCI" type="Fecha"/>
	<xs:element name="HoraCI">
		<xs:simpleType>
			<xs:restriction base="xs:string">
				<xs:length value="6"/>
				<xs:pattern value="\d{6}"/>
			</xs:restriction>
		</xs:simpleType>
	</xs:element>
	<xs:element name="HuellaCI">
		<xs:simpleType>
			<xs:restriction base="xs:string">
				<xs:length value="8"/>
				<xs:pattern value="\w{8}"/>
			</xs:restriction>
		</xs:simpleType>
	</xs:element>
</xs:schema>
