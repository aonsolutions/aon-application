<faces-config version="1.2"
	xmlns="http://java.sun.com/xml/ns/javaee"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://java.sun.com/xml/ns/javaee http://java.sun.com/xml/ns/javaee/web-facesconfig_1_2.xsd">

	<application>
		<resource-bundle>
			<base-name>com.code.aon.ui.geozone.i18n.messages</base-name>
			<var>geozoneBundle</var>
		</resource-bundle>
	</application>
	
	<!-- ************ COLLECTION **************** -->
	<managed-bean>
		<managed-bean-name>geozoneCollections</managed-bean-name>
		<managed-bean-class>
			com.code.aon.ui.geozone.controller.GeozoneCollectionsController
		</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
	</managed-bean>

	<!-- ************* GEOTREE ***************** -->
	<managed-bean>
		<managed-bean-name>geotreeParent</managed-bean-name>
		<managed-bean-class>
			com.code.aon.ui.form.BasicController
		</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
		<managed-property>
			<property-name>queryOnStartUP</property-name>
			<value>true</value>
		</managed-property>
		<managed-property>
			<property-name>pojo</property-name>
			<value>com.code.aon.geozone.GeoTree</value>
		</managed-property>
		<managed-property>
			<property-name>beanName</property-name>
			<value>geotreeParent</value>
		</managed-property>
		<managed-property>
			<property-name>defaultOrder</property-name>
			<value>GeoTree_child_name</value>
		</managed-property>
		<managed-property>
			<property-name>listenerClasses</property-name>
			<list-entries>
				<value-class>
					com.code.aon.ui.form.event.IControllerListener
				</value-class>
				<value>#{geotreeParentControllerListener}</value>
				<value>#{geotreeParentChildListener}</value>
			</list-entries>
		</managed-property>
	</managed-bean>
	
	<managed-bean>
		<managed-bean-name>geotreeParentControllerListener</managed-bean-name>
		<managed-bean-class>
			com.code.aon.ui.geozone.event.GeotreeParentControllerListener
		</managed-bean-class>
		<managed-bean-scope>none</managed-bean-scope>
	</managed-bean>
	
	<managed-bean>
		<managed-bean-name>geotreeParentChildListener</managed-bean-name>
		<managed-bean-class>
			com.code.aon.ui.form.listener.LinesControllerListener
		</managed-bean-class>
		<managed-bean-scope>none</managed-bean-scope>
		<managed-property>
			<property-name>childBean</property-name>
			<value>geotreeChild</value>
		</managed-property>
		<managed-property>
			<property-name>aliasMap</property-name>
			<map-entries>
				<map-entry>
					<key>GeoTree_parent_id</key>
                    <value>child.id</value>
				</map-entry>
			</map-entries>
		</managed-property>
	</managed-bean>
	
	<managed-bean>
		<managed-bean-name>geotreeChild</managed-bean-name>
		<managed-bean-class>com.code.aon.ui.form.LinesController</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
		<managed-property>
			<property-name>queryOnStartUP</property-name>
			<value>true</value>
		</managed-property>
		<managed-property>
			<property-name>pojo</property-name>
			<value>com.code.aon.geozone.GeoTree</value>
		</managed-property>
		<managed-property>
			<property-name>beanName</property-name>
			<value>geotreeParent</value>
		</managed-property>
		<managed-property>
			<property-name>defaultOrder</property-name>
			<value>GeoTree_child_name</value>
		</managed-property>
		<managed-property>
			<property-name>cascadeDelete</property-name>
			<value>false</value>
		</managed-property>
		<managed-property>
			<property-name>masterControllerName</property-name>
			<value>geotreeParent</value>
		</managed-property>
		<managed-property>
			<property-name>propertyMap</property-name>
			<map-entries>
				<map-entry>
					<key>child.id</key>
					<value>parent.id</value>
				</map-entry>
			</map-entries>
		</managed-property>
	</managed-bean>

  <!-- =================== Navigation Rules ================= -->
  <navigation-rule>
    <navigation-case>
      <from-outcome>geotreeParent_form</from-outcome>
      <to-view-id>/com/code/aon/ui/geozone/facelet/geozone/form.xhtml</to-view-id>
    </navigation-case>
    <navigation-case>
      <from-outcome>geotreeParent_list</from-outcome>
      <to-view-id>/com/code/aon/ui/geozone/facelet/geozone/list.xhtml</to-view-id>
    </navigation-case>
  </navigation-rule>

</faces-config>
