<faces-config version="1.2" xmlns="http://java.sun.com/xml/ns/javaee"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://java.sun.com/xml/ns/javaee http://java.sun.com/xml/ns/javaee/web-facesconfig_1_2.xsd">

	<managed-bean>
		<managed-bean-name>registryStat</managed-bean-name>
		<managed-bean-class>com.code.aon.ui.stat.controller.RegistryStatEngineController</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
	</managed-bean>

	<managed-bean>
		<managed-bean-name>productStat</managed-bean-name>
		<managed-bean-class>com.code.aon.ui.stat.controller.ProductStatEngineController</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
	</managed-bean>

	<managed-bean>
		<managed-bean-name>projectStat</managed-bean-name>
		<managed-bean-class>com.code.aon.ui.stat.controller.ProjectStatEngineController</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
	</managed-bean>

	<managed-bean>
		<managed-bean-name>commercialStat</managed-bean-name>
		<managed-bean-class>com.code.aon.ui.stat.controller.CommercialStatEngineController</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
	</managed-bean>

	<managed-bean>
		<managed-bean-name>tasStat</managed-bean-name>
		<managed-bean-class>com.code.aon.ui.stat.controller.TasStatEngineController</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
		<managed-property>
			<property-name>beanName</property-name>
			<value>tasStat</value>
		</managed-property>										
	</managed-bean>

	<!-- *************Registry Stats***************** -->
	<navigation-rule>
		<navigation-case>
			<from-outcome>registry_search_stat</from-outcome>
			<to-view-id>/com/code/aon/ui/stat/facelet/registryStat/search.xhtml</to-view-id>
		</navigation-case>
		<navigation-case>
			<from-outcome>registry_stats</from-outcome>
			<to-view-id>/com/code/aon/ui/stat/facelet/registryStat/registryStat.xhtml</to-view-id>
		</navigation-case>
	</navigation-rule>

	<!-- *************Product Stats***************** -->
	<navigation-rule>
		<navigation-case>
			<from-outcome>product_search_stat</from-outcome>
			<to-view-id>/com/code/aon/ui/stat/facelet/productStat/search.xhtml</to-view-id>
		</navigation-case>
		<navigation-case>
			<from-outcome>product_stats</from-outcome>
			<to-view-id>/com/code/aon/ui/stat/facelet/productStat/productStat.xhtml</to-view-id>
		</navigation-case>
	</navigation-rule>

	<!-- *************Project Stats***************** -->
	<navigation-rule>
		<navigation-case>
			<from-outcome>project_search_stat</from-outcome>
			<to-view-id>/com/code/aon/ui/stat/facelet/projectStat/search.xhtml</to-view-id>
		</navigation-case>
		<navigation-case>
			<from-outcome>project_stats</from-outcome>
			<to-view-id>/com/code/aon/ui/stat/facelet/projectStat/projectStat.xhtml</to-view-id>
		</navigation-case>
	</navigation-rule>

	<!-- *************Commercial Stats***************** -->
	<navigation-rule>
		<navigation-case>
			<from-outcome>commercial_category_stat_search</from-outcome>
			<to-view-id>/com/code/aon/ui/stat/facelet/commercialCategory/search.xhtml</to-view-id>
		</navigation-case>
		<navigation-case>
			<from-outcome>commercial_category_stats_year</from-outcome>
			<to-view-id>/com/code/aon/ui/stat/facelet/commercialCategory/yearStats.xhtml</to-view-id>
		</navigation-case>
		<navigation-case>
			<from-outcome>commercial_product_stat_search</from-outcome>
			<to-view-id>/com/code/aon/ui/stat/facelet/commercialCategory/searchProduct.xhtml</to-view-id>
		</navigation-case>
		<navigation-case>
			<from-outcome>commercial_product_stats</from-outcome>
			<to-view-id>/com/code/aon/ui/stat/facelet/commercialCategory/productStats.xhtml</to-view-id>
		</navigation-case>
		<navigation-case>
			<from-outcome>commercial_geozone_stat_search</from-outcome>
			<to-view-id>/com/code/aon/ui/stat/facelet/commercialGeozone/search.xhtml</to-view-id>
		</navigation-case>
		<navigation-case>
			<from-outcome>commercial_geozone_stats_year</from-outcome>
			<to-view-id>/com/code/aon/ui/stat/facelet/commercialGeozone/yearStats.xhtml</to-view-id>
		</navigation-case>
		<navigation-case>
			<from-outcome>commercial_seller_stat_search</from-outcome>
			<to-view-id>/com/code/aon/ui/stat/facelet/commercialSeller/search.xhtml</to-view-id>
		</navigation-case>
		<navigation-case>
			<from-outcome>commercial_seller_stats_year</from-outcome>
			<to-view-id>/com/code/aon/ui/stat/facelet/commercialSeller/yearStats.xhtml</to-view-id>
		</navigation-case>
		<navigation-case>
			<from-outcome>commercial_target_stat_search</from-outcome>
			<to-view-id>/com/code/aon/ui/stat/facelet/commercialTarget/search.xhtml</to-view-id>
		</navigation-case>
		<navigation-case>
			<from-outcome>commercial_target_stats_year</from-outcome>
			<to-view-id>/com/code/aon/ui/stat/facelet/commercialTarget/yearStats.xhtml</to-view-id>
		</navigation-case>
		<navigation-case>
			<from-outcome>commercial_seller_search</from-outcome>
			<to-view-id>/com/code/aon/ui/stat/facelet/commercialSellerControl/search.xhtml</to-view-id>
		</navigation-case>
		<navigation-case>
			<from-outcome>commercial_seller_stat</from-outcome>
			<to-view-id>/com/code/aon/ui/stat/facelet/commercialSellerControl/sellerStat.xhtml</to-view-id>
		</navigation-case>
		<navigation-case>
			<from-outcome>commercial_search_view</from-outcome>
			<to-view-id>/com/code/aon/ui/stat/facelet/commercialSellerControl/searchView.xhtml</to-view-id>
		</navigation-case>
		<navigation-case>
			<from-outcome>commercial_seller_view</from-outcome>
			<to-view-id>/com/code/aon/ui/stat/facelet/commercialSellerControl/controlView.xhtml</to-view-id>
		</navigation-case>
		<navigation-case>
			<from-outcome>commercial_activity_view</from-outcome>
			<to-view-id>/com/code/aon/ui/stat/facelet/commercialSellerControl/activityView.xhtml</to-view-id>
		</navigation-case>
		<navigation-case>
			<from-outcome>commercial_activity_list</from-outcome>
			<to-view-id>/com/code/aon/ui/stat/facelet/commercialSellerControl/activityList.xhtml</to-view-id>
		</navigation-case>
		<navigation-case>
			<from-outcome>offers_list</from-outcome>
			<to-view-id>/com/code/aon/ui/stat/facelet/generic/offerList.xhtml</to-view-id>
		</navigation-case>
	</navigation-rule>

	<!-- ************* TAS Stats***************** -->
	<navigation-rule>
		<navigation-case>
			<from-outcome>tasStat_search</from-outcome>
			<to-view-id>/com/code/aon/ui/stat/facelet/tasStat/search.xhtml</to-view-id>
		</navigation-case>
		<navigation-case>
			<from-outcome>tasStat_list</from-outcome>
			<to-view-id>/com/code/aon/ui/stat/facelet/tasStat/list.xhtml</to-view-id>
		</navigation-case>
		<navigation-case>
			<from-outcome>tasStat_owner_form</from-outcome>
			<to-view-id>/com/code/aon/ui/stat/facelet/tasStat/owner_form.xhtml</to-view-id>
		</navigation-case>
		<navigation-case>
			<from-outcome>tasStat_tasItem_form</from-outcome>
			<to-view-id>/com/code/aon/ui/stat/facelet/tasStat/tasItem_form.xhtml</to-view-id>
		</navigation-case>
	</navigation-rule>
	
</faces-config>