		<template path="/com/code/aon/ui/stat/report/commercialTemplate.jasper" />
		<collection provider="#{commercialStat.yearStats}" />
		<params>
			<param id="REPORT_RESOURCE_BUNDLE" value="com.code.aon.common.i18n.messages" />
			<param id="company" value="#{company.obtainCompany}" />
			<param id="reportName" value="#{commercialStat.getReportName}" />
