	<parameter name="printHeader" class="java.lang.Boolean" isForPrompting="false"/>
	<parameter name="nestedReports" class="java.util.Map"/>
	<parameter name="signatureImageFile" class="java.io.InputStream"/>
	<field name="id" class="java.lang.Integer"/>
	<field name="person" class="com.code.aon.person.Person"/>
	<field name="workPlace" class="com.code.aon.company.WorkPlace"/>
	<field name="startDate" class="java.util.Date"/>
	<field name="endDate" class="java.util.Date"/>
	<field name="advanceNoticeDate" class="java.util.Date"/>
	<background>
		<band height="802">
			<line>
				<reportElement key="line-6" x="553" y="241" width="4" height="1"/>
			</line>
			<line>
				<reportElement key="line-8" x="553" y="539" width="4" height="1"/>
			</line>
			<line>
				<reportElement key="line-5" x="-25" y="241" width="4" height="1"/>
			</line>
			<line>
				<reportElement key="line-7" x="-25" y="539" width="4" height="1"/>
			</line>
		</band>
	</background>
	<title>
		<band splitType="Stretch"/>
	</title>
	<pageHeader>
		<band splitType="Stretch"/>
	</pageHeader>
	<columnHeader>
		<band splitType="Stretch"/>
	</columnHeader>
	<detail>
		<band height="802" splitType="Stretch">
			<textField isBlankWhenNull="false">
				<reportElement key="textField-54" positionType="Float" x="44" y="123" width="450" height="20"/>
				<box>
					<topPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
					<leftPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
					<bottomPen lineWidth="0.0" lineColor="#000000"/>
					<rightPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
				</box>
				<textElement textAlignment="Right" verticalAlignment="Bottom">
					<font fontName="SansSerif" size="12" isBold="false" isUnderline="false" pdfFontName="Helvetica" isPdfEmbedded="false"/>
				</textElement>
				<textFieldExpression><![CDATA["En " + $F{workPlace}.getAddress().getGeozone().getName() + ", "
+ (new SimpleDateFormat("'a' dd 'de' MMMMM 'de' yyyy",$P{REPORT_LOCALE}).format($F{advanceNoticeDate}))]]></textFieldExpression>
			</textField>
			<textField isStretchWithOverflow="true" isBlankWhenNull="true">
				<reportElement key="textField-53" positionType="Float" x="44" y="665" width="225" height="20"/>
				<box>
					<topPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
					<leftPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
					<bottomPen lineWidth="0.0" lineColor="#000000"/>
					<rightPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
				</box>
				<textElement verticalAlignment="Bottom">
					<font fontName="SansSerif" size="12" isBold="false" pdfFontName="Helvetica"/>
				</textElement>
				<textFieldExpression><![CDATA["Fdo.: (trabajador)"]]></textFieldExpression>
			</textField>
			<textField isBlankWhenNull="false">
				<reportElement key="textField-54" positionType="Float" x="44" y="645" width="225" height="20"/>
				<box>
					<topPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
					<leftPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
					<bottomPen lineWidth="0.0" lineColor="#000000"/>
					<rightPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
				</box>
				<textElement verticalAlignment="Bottom">
					<font fontName="SansSerif" size="12" isBold="false" isUnderline="false" pdfFontName="Helvetica" isPdfEmbedded="false"/>
				</textElement>
				<textFieldExpression><![CDATA["Recibí y conforme:"]]></textFieldExpression>
			</textField>
			<textField isBlankWhenNull="true">
				<reportElement key="textField-54" positionType="Float" x="44" y="468" width="450" height="50"/>
				<box>
					<topPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
					<leftPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
					<bottomPen lineWidth="0.0" lineColor="#000000"/>
					<rightPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
				</box>
				<textElement textAlignment="Justified" verticalAlignment="Top">
					<font fontName="SansSerif" size="12" isBold="false" isUnderline="false" pdfFontName="Helvetica" isPdfEmbedded="false"/>
				</textElement>
				<textFieldExpression><![CDATA["Le rogamos firme el recibí de la copia adjunta a los únicos efectos de acreditar su notificación."]]></textFieldExpression>
			</textField>
			<textField isBlankWhenNull="false">
				<reportElement key="textField-54" positionType="Float" x="269" y="538" width="225" height="20"/>
				<box>
					<topPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
					<leftPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
					<bottomPen lineWidth="0.0" lineColor="#000000"/>
					<rightPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
				</box>
				<textElement textAlignment="Right" verticalAlignment="Bottom">
					<font fontName="SansSerif" size="12" isBold="false" isUnderline="false" pdfFontName="Helvetica" isPdfEmbedded="false"/>
				</textElement>
				<textFieldExpression><![CDATA["Fdo.: (Responsable empresa)"]]></textFieldExpression>
			</textField>
			<textField isBlankWhenNull="false">
				<reportElement key="textField-54" positionType="Float" x="44" y="518" width="450" height="20"/>
				<box>
					<topPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
					<leftPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
					<bottomPen lineWidth="0.0" lineColor="#000000"/>
					<rightPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
				</box>
				<textElement verticalAlignment="Bottom">
					<font fontName="SansSerif" size="12" isBold="false" isUnderline="false" pdfFontName="Helvetica" isPdfEmbedded="false"/>
				</textElement>
				<textFieldExpression><![CDATA["Atentamente,"]]></textFieldExpression>
			</textField>
			<textField isBlankWhenNull="false">
				<reportElement key="textField-54" positionType="Float" x="44" y="198" width="450" height="40"/>
				<box>
					<topPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
					<leftPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
					<bottomPen lineWidth="0.0" lineColor="#000000"/>
					<rightPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
				</box>
				<textElement verticalAlignment="Top">
					<font fontName="SansSerif" size="12" isBold="false" isUnderline="false" pdfFontName="Helvetica" isPdfEmbedded="false"/>
				</textElement>
				<textFieldExpression><![CDATA["Estimad"
+ ($F{person}.getGender().ordinal()==0?"o":"")
+ ($F{person}.getGender().ordinal()==1?"a":"")
+ ($F{person}.getGender().ordinal()==2?"o/a":"") + " "
+ $F{person}.getFullName() + ":"]]></textFieldExpression>
			</textField>
			<textField isBlankWhenNull="false">
				<reportElement key="textField-54" positionType="Float" x="44" y="398" width="450" height="70"/>
				<box>
					<topPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
					<leftPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
					<bottomPen lineWidth="0.0" lineColor="#000000"/>
					<rightPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
				</box>
				<textElement textAlignment="Justified" verticalAlignment="Top">
					<font fontName="SansSerif" size="12" isBold="false" isUnderline="false" pdfFontName="Helvetica" isPdfEmbedded="false"/>
				</textElement>
				<textFieldExpression><![CDATA["Una vez haya finalizado su contrato, estará a su disposición en las oficinas del Centro de trabajo, la liquidación correspondiente, tan pronto como muestre su conformidad con la misma."]]></textFieldExpression>
			</textField>
			<textField isBlankWhenNull="false">
				<reportElement key="textField-54" positionType="Float" x="44" y="328" width="450" height="70"/>
				<box>
					<topPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
					<leftPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
					<bottomPen lineWidth="0.0" lineColor="#000000"/>
					<rightPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
				</box>
				<textElement textAlignment="Justified" verticalAlignment="Top">
					<font fontName="SansSerif" size="12" isBold="false" isUnderline="false" pdfFontName="Helvetica" isPdfEmbedded="false"/>
				</textElement>
				<textFieldExpression><![CDATA["Por tanto en dicha fecha se producirá, la extinción del contrato de trabajo suscrito entre usted y nuestra compañía, lo que se le comunica, en plazo, a los efectos oportunos."]]></textFieldExpression>
			</textField>
			<textField pattern="" isBlankWhenNull="false">
				<reportElement key="textField-54" positionType="Float" x="44" y="238" width="450" height="90"/>
				<box>
					<topPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
					<leftPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
					<bottomPen lineWidth="0.0" lineColor="#000000"/>
					<rightPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
				</box>
				<textElement textAlignment="Justified" verticalAlignment="Top">
					<font fontName="SansSerif" size="12" isBold="false" isUnderline="false" pdfFontName="Helvetica" isPdfEmbedded="false"/>
				</textElement>
				<textFieldExpression><![CDATA["Por medio de la presente carta que se le entrega en el día de la fecha, le comunicamos que el próximo día "
+ (new SimpleDateFormat("dd 'de' MMMMM 'de' yyyy",$P{REPORT_LOCALE}).format($F{endDate})) + " "
+ "finaliza, por expiración del tiempo concertado, el contrato de trabajo de fecha "
+ (new SimpleDateFormat("dd/MM/yyyy").format($F{startDate}))
+ ", que le une a esta empresa."]]></textFieldExpression>
			</textField>
			<image scaleImage="RetainShape" hAlign="Left" vAlign="Top" isUsingCache="true" onErrorType="Blank">
				<reportElement key="image-1" positionType="Float" mode="Opaque" x="44" y="24" width="225" height="60" forecolor="#000000" backcolor="#FFFFFF"/>
				<box>
					<topPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
					<leftPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
					<bottomPen lineWidth="0.0" lineColor="#000000"/>
					<rightPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
				</box>
				<graphicElement fill="Solid"/>
				<imageExpression><![CDATA[$P{logoImageFile}]]></imageExpression>
			</image>
			<image scaleImage="RetainShape" hAlign="Center" vAlign="Top" isUsingCache="true" onErrorType="Blank">
				<reportElement key="image-1" positionType="Float" mode="Opaque" x="354" y="570" width="140" height="115" forecolor="#000000" backcolor="#FFFFFF"/>
				<box>
					<topPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
					<leftPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
					<bottomPen lineWidth="0.0" lineColor="#000000"/>
					<rightPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
				</box>
				<graphicElement fill="Solid"/>
				<imageExpression><![CDATA[$P{signatureImageFile}]]></imageExpression>
			</image>
			<textField isStretchWithOverflow="true" isBlankWhenNull="true">
				<reportElement key="textField-26" positionType="Float" stretchType="RelativeToBandHeight" x="269" y="44" width="225" height="20" isPrintWhenDetailOverflows="true"/>
				<box bottomPadding="2">
					<topPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
					<leftPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
					<bottomPen lineWidth="0.0" lineColor="#000000"/>
					<rightPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
				</box>
				<textElement textAlignment="Right" verticalAlignment="Bottom">
					<font fontName="SansSerif" size="12" pdfFontName="Helvetica"/>
				</textElement>
				<textFieldExpression><![CDATA[(($P{address}.getStreetType()!=null) ? $P{address}.getStreetType() : "")
+ (($P{address}.getStreetType()!=null) ? ". " : "")
+ (($P{address}.getAddress()==null)? "":$P{address}.getAddress())
+ (($P{address}.getNumber()==null)?"":" ")
+ (($P{address}.getNumber()==null)?"":$P{address}.getNumber())]]></textFieldExpression>
			</textField>
			<textField isBlankWhenNull="true">
				<reportElement key="textField-25" positionType="Float" x="269" y="64" width="225" height="20"/>
				<box>
					<topPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
					<leftPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
					<bottomPen lineWidth="0.0" lineColor="#000000"/>
					<rightPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
				</box>
				<textElement textAlignment="Right" verticalAlignment="Middle">
					<font fontName="SansSerif" size="12" pdfFontName="Helvetica"/>
				</textElement>
				<textFieldExpression><![CDATA[($P{address}.getZip()==null?"":$P{address}.getZip() + " ") + ($P{address}.getCity()==null?"":$P{address}.getCity() + " ") + "(" + $P{address}.getGeozone().getName() + ")"]]></textFieldExpression>
			</textField>
			<textField isStretchWithOverflow="true" isBlankWhenNull="true">
				<reportElement key="textField-23" x="269" y="24" width="225" height="20"/>
