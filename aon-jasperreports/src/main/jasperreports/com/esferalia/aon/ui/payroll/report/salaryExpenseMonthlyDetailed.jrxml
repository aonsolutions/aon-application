	<variable name="subtotalIrpf2" class="java.lang.Double" resetType="Group" resetGroup="person" calculation="Sum">
		<variableExpression><![CDATA[$F{salary}.getDeductions().getIrpf().getAmount()]]></variableExpression>
	</variable>
	<variable name="subtotalIrpf" class="java.lang.Double" resetType="Group" resetGroup="person" calculation="Sum">
		<variableExpression><![CDATA[( ($F{salary}.getInKindIrpfBase()!=null && $F{salary}.getInKindIrpfBase()!=0.00 && $F{salary}.getIrpfBase()!=null && $F{salary}.getIrpfBase()!=0.00)
    ? ($F{salary}.getDeductions().getIrpf().getAmount()
        - ($F{salary}.getInkindIrpfBase()
            * $F{salary}.getDeductions().getIrpf().getAmount()
            / $F{salary}.getIrpfBase()))
    : ($F{salary}.getDeductions().getIrpf()==null
        ? new Double(0.0)
        : $F{salary}.getDeductions().getIrpf().getAmount())
)]]></variableExpression>
	</variable>
