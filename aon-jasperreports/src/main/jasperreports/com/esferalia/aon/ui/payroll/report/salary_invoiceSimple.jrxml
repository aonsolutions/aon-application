	</variable>
	<variable name="printLines" class="java.lang.Integer">
		<variableExpression><![CDATA[$V{payments}.size() + $V{deductions}.size() + 1]]></variableExpression>
	</variable>
	<variable name="remainLines" class="java.lang.Integer">
		<variableExpression><![CDATA[38 - $V{printLines}]]></variableExpression>
	</variable>
	<variable name="signature" class="com.code.aon.registry.RegistryAttachment">
