	</variable>
	<variable name="salaryInKind" class="java.lang.Double">
		<variableExpression><![CDATA[$F{salary}.getPayments().getSalaryInKind().getAmount()]]></variableExpression>
	</variable>
	<variable name="irpfInKind" class="java.lang.Double">
		<variableExpression><![CDATA[($F{salary}.getInKindIrpfBase()!=null && $F{salary}.getInKindIrpfBase()!=0.00 ?
($F{salary}.getInkindIrpfBase()*
    $F{salary}.getDeductions().getIrpf().getAmount()/$F{salary}.getIrpfBase()):0.0)]]></variableExpression>
	</variable>
	<variable name="totalDeduction" class="java.lang.Double">
		<variableExpression><![CDATA[$F{salary}.getTotalDeduction() + $V{salaryInKind}]]></variableExpression>
	</variable>
	<variable name="totalPayment" class="java.lang.Double">
