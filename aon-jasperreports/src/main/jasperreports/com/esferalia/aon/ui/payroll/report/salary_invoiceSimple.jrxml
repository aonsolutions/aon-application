	<field name="salary" class="com.esferalia.aon.payroll.Salary"/>
	<variable name="payments" class="java.util.List">
		<variableExpression><![CDATA[ReportUtils.sort($F{salary}.getSalaryPayments(), "description")]]></variableExpression>
	</variable>
	<variable name="deductions" class="java.util.List">
		<variableExpression><![CDATA[ReportUtils.sort($F{salary}.getSalaryDeductions(),"type", "description")]]></variableExpression>
	</variable>
	<variable name="embargos" class="java.util.List">
		<variableExpression><![CDATA[ReportUtils.sort($F{salary}.getSalaryEmbargos(),"type", "description")]]></variableExpression>
	</variable>
	<variable name="printLines" class="java.lang.Integer">
		<variableExpression><![CDATA[$V{payments}.size() + $V{deductions}.size() + 1]]></variableExpression>
	</variable>
	<variable name="remainLines" class="java.lang.Integer">
		<variableExpression><![CDATA[38 - $V{printLines}]]></variableExpression>
	</variable>
	<variable name="signature" class="com.code.aon.registry.RegistryAttachment">
		<variableExpression><![CDATA[ReportUtils.getRAttach( $F{salary}.getContract().getWorkPlace().getEnterprise().getId(), RegistryAttachmentType.SIGNATURE)]]></variableExpression>
	</variable>
	<variable name="logo" class="com.code.aon.registry.RegistryAttachment" resetType="Page">
		<initialValueExpression><![CDATA[ReportUtils.getRAttach( $F{salary}.getContract().getWorkPlace().getEnterprise().getId(), RegistryAttachmentType.LOGO)]]></initialValueExpression>
	</variable>
	<variable name="salaryInKind" class="java.lang.Double">
		<variableExpression><![CDATA[$F{salary}.getPayments().getSalaryInKind().getAmount()]]></variableExpression>
	</variable>
	<variable name="irpfInKind" class="java.lang.Double">
		<variableExpression><![CDATA[($F{salary}.getInKindIrpfBase()!=null && $F{salary}.getInKindIrpfBase()!=0.00 ?
($F{salary}.getInkindIrpfBase()*
    $F{salary}.getDeductions().getIrpf().getAmount()/$F{salary}.getIrpfBase()):0.0)]]></variableExpression>
	</variable>
	<variable name="totalDeduction" class="java.lang.Double">
		<variableExpression><![CDATA[$F{salary}.getTotalDeduction() + $V{salaryInKind}]]></variableExpression>
	</variable>
	<variable name="totalPayment" class="java.lang.Double">
		<variableExpression><![CDATA[$F{salary}.getTotalPayment() + $V{salaryInKind}]]></variableExpression>
	</variable>
	<variable name="DoubleFormater" class="java.text.DecimalFormat" resetType="None">
		<variableExpression><![CDATA[new java.text.DecimalFormat("#,##0.00")]]></variableExpression>
		<initialValueExpression><![CDATA[new java.text.DecimalFormat("#,##0.00")]]></initialValueExpression>
	</variable>
