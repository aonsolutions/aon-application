						<datasetRun subDataset="deduction">
							<dataSourceExpression><![CDATA[new com.code.aon.report.jr.JRBeanCollectionDataSource($V{deductions})]]></dataSourceExpression>
						</datasetRun>
						<jr:column width="9">
							<jr:detailCell height="12">
								<rectangle>
