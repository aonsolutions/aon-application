				<staticText>
					<reportElement style="head" x="5" y="2" width="547" height="12"/>
					<textElement/>
					<text><![CDATA[II. DETERMINACIÓN DE LAS BASES DE COTIZACIÓN A LA SEGURIDAD SOCIAL:]]></text>
				</staticText>
				<staticText>
					<reportElement style="label" x="6" y="18" width="106" height="14"/>
					<textElement/>
					<text><![CDATA[Remuneración a cotizar S.S]]></text>
