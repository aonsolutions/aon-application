								</rectangle>
							</jr:detailCell>
						</jr:column>
						<jr:column width="301">
							<jr:detailCell height="12">
								<staticText>
									<reportElement style="label" x="0" y="0" width="301" height="12">
										<printWhenExpression><![CDATA[$F{type} == DeductionType.COMMON_CONTINGENCY]]></printWhenExpression>
									</reportElement>
									<textElement/>
									<text><![CDATA[Aportación trabajador a cuotas Seguridad Social]]></text>
								</staticText>
								<textField>
									<reportElement style="label" x="0" y="0" width="301" height="12">
										<printWhenExpression><![CDATA[$F{type} == DeductionType.IRPF && "IRPF".equals($F{deductionConcept})]]></printWhenExpression>
									</reportElement>
									<textElement/>
									<textFieldExpression><![CDATA[java.text.MessageFormat.format("Retención a cuenta I.R.P.F (D) {0}% sobre {1,number,#,##0.00}", $F{description}, $F{salary}.getMoneyIrpfBase())]]></textFieldExpression>
								</textField>
								<textField>
									<reportElement style="label" x="0" y="0" width="301" height="12">
										<printWhenExpression><![CDATA[$F{type} == DeductionType.IRPF && "IRPFE".equals($F{deductionConcept})]]></printWhenExpression>
									</reportElement>
									<textElement/>
									<textFieldExpression><![CDATA[java.text.MessageFormat.format("Ingreso a cuenta I.R.P.F (E) {0}% sobre {1,number,#,##0.00}", $F{description}, $F{salary}.getInkindIrpfBase())]]></textFieldExpression>
								</textField>
								<textField>
									<reportElement style="label" x="0" y="0" width="301" height="12">
										<printWhenExpression><![CDATA[$F{type} == DeductionType.OTHER]]></printWhenExpression>
									</reportElement>
									<textElement/>
									<textFieldExpression><![CDATA[$F{description}]]></textFieldExpression>
								</textField>
							</jr:detailCell>
