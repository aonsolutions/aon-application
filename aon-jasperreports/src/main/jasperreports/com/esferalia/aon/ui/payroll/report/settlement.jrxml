						<textElement textAlignment="Right"/>
						<textFieldExpression><![CDATA["En " + ReportUtils.toUpperCase($F{salary}.getContract().getWorkPlace().getAddress().getProvince()) + ",a "
+ ( new java.text.MessageFormat("{0,date,d}",$P{REPORT_LOCALE})).format( new Object [] {$F{salary}.getChargeDate()}, new StringBuffer(), null).toString()
+ " de "
+ ReportUtils.toUpperCase(( new java.text.MessageFormat("{0,date,MMMM}",$P{REPORT_LOCALE})).format( new Object [] {$F{salary}.getChargeDate()}, new StringBuffer(), null).toString())
+ " de "
+ ( new java.text.MessageFormat("{0,date,yyyy}",$P{REPORT_LOCALE})).format( new Object [] {$F{salary}.getChargeDate()}, new StringBuffer(), null).toString()]]></textFieldExpression>
