	<queryString language="hql">
		<![CDATA[FROM Salary WHERE id=77347]]>
	</queryString>
	<field name="salary" class="com.esferalia.aon.payroll.Salary"/>
	<variable name="payments" class="java.util.List">
		<variableExpression><![CDATA[ReportUtils.sort($F{salary}.getSalaryPayments(), "paymentConcept")]]></variableExpression>
	</variable>
	<variable name="deductions" class="java.util.List">
		<variableExpression><![CDATA[ReportUtils.sort($F{salary}.getSalaryDeductions(), "type" )]]></variableExpression>
	</variable>
	<variable name="remainLines" class="java.lang.Integer">
		<variableExpression><![CDATA[23 -  ( $V{payments} != null ? Math.max(1,$V{payments}.size()): 1 )]]></variableExpression>
	</variable>
	<variable name="total1" class="java.lang.Double">
		<variableExpression><![CDATA[$F{salary}.getRemuneration() + $F{salary}.getItBase() + $F{salary}.getExtraPayProration()]]></variableExpression>
	</variable>
	<variable name="importeCg" class="java.lang.Double">
		<variableExpression><![CDATA[$F{salary}.getDeductions().getCommonContingency().getAmount()]]></variableExpression>
	</variable>
	<variable name="prcCg" class="java.lang.Double">
		<variableExpression><![CDATA[$V{importeCg} / $F{salary}.getCommonBase() * 100]]></variableExpression>
	</variable>
	<variable name="importeAcc" class="java.lang.Double">
		<variableExpression><![CDATA[$F{salary}.getDeductions().getUnemployment().getAmount() + $F{salary}.getDeductions().getJobTraining().getAmount()]]></variableExpression>
	</variable>
	<variable name="prcAcc" class="java.lang.Double">
		<variableExpression><![CDATA[$V{importeAcc} / $F{salary}.getProfessionalBase() * 100]]></variableExpression>
	</variable>
	<variable name="importeHex" class="java.lang.Double">
		<variableExpression><![CDATA[$F{salary}.getDeductions().getStructuralOvertime().getAmount()]]></variableExpression>
	</variable>
	<variable name="prcHex" class="java.lang.Double">
		<variableExpression><![CDATA[$V{importeHex} / $F{salary}.getOvertimeBase() * 100]]></variableExpression>
	</variable>
	<variable name="importeHexNo" class="java.lang.Double">
		<variableExpression><![CDATA[$F{salary}.getDeductions().getNonStructuralOvertime().getAmount()]]></variableExpression>
	</variable>
	<variable name="prcHexNo" class="java.lang.Double">
		<variableExpression><![CDATA[$V{importeHexNo}  / $F{salary}.getNonEstructuralOvertimeBase() * 100]]></variableExpression>
	</variable>
	<variable name="totalLiquido" class="java.lang.Double">
		<variableExpression><![CDATA[$F{salary}.getTotalLiquid()]]></variableExpression>
	</variable>
	<variable name="impTotal" class="java.lang.Double">
		<variableExpression><![CDATA[$F{salary}.getTotalPayment()]]></variableExpression>
	</variable>
	<variable name="signature" class="com.code.aon.registry.RegistryAttachment">
		<variableExpression><![CDATA[null]]></variableExpression>
	</variable>
	<variable name="logo" class="com.code.aon.registry.RegistryAttachment">
		<initialValueExpression><![CDATA[ReportUtils.getRAttach( $F{salary}.getContract().getWorkPlace().getEnterprise().getId(), RegistryAttachmentType.LOGO)]]></initialValueExpression>
	</variable>
	<variable name="representativesLabor" class="java.util.List">
		<initialValueExpression><![CDATA[ReportUtils.getRepresentativesLabor($F{salary}.getContract().getWorkPlace().getEnterprise().getId())]]></initialValueExpression>
	</variable>
