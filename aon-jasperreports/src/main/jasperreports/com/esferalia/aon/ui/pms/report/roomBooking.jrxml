				</textElement>
				<textFieldExpression><![CDATA[$F{roomCancelled}]]></textFieldExpression>
			</textField>
			<textField pattern="###0" isBlankWhenNull="true">
				<reportElement key="textField-53" x="427" y="0" width="37" height="14" forecolor="#FF0000">
