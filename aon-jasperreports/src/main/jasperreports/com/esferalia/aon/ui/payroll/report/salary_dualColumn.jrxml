			<componentElement>
				<reportElement uuid="992e10de-7795-4ea3-8c9d-0e0b851943f4" key="table" positionType="Float" mode="Transparent" x="12" y="21" width="262" height="26" isRemoveLineWhenBlank="true"/>
				<jr:table xmlns:jr="http://jasperreports.sourceforge.net/jasperreports/components" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports/components http://jasperreports.sourceforge.net/xsd/components.xsd">
					<datasetRun subDataset="payments" uuid="1f74aa31-e035-4300-b246-baa01c225ce5">
						<dataSourceExpression><![CDATA[new com.code.aon.report.jr.JRBeanCollectionDataSource($V{payments})]]></dataSourceExpression>
					</datasetRun>
					<jr:column width="212" uuid="e4c7e06c-4ca3-47f4-abde-1faf6d3dc035">
						<jr:tableFooter height="15" rowSpan="1"/>
						<jr:groupHeader groupName="type">
							<jr:cell height="13" rowSpan="1">
								<textField isStretchWithOverflow="true" pattern="##00" isBlankWhenNull="true">
									<reportElement uuid="6ba5a00a-82dc-464d-8f84-f32deac1793b" style="label_dotts" x="0" y="0" width="212" height="13"/>
									<box>
										<bottomPen lineWidth="0.0" lineStyle="Solid"/>
									</box>
									<textElement>
										<font isBold="true" pdfFontName="Helvetica-Bold"/>
									</textElement>
									<textFieldExpression><![CDATA[$F{type}.ordinal() + ". " +
($F{type}.ordinal()==1?"PERCEPCIONES SALARIALES":$F{type}.getName( $P{REPORT_LOCALE} ).toUpperCase())]]></textFieldExpression>
								</textField>
							</jr:cell>
						</jr:groupHeader>
