	<queryString language="hql">
		<![CDATA[FROM Salary WHERE Id=9]]>
	</queryString>
	<field name="salary" class="com.esferalia.aon.payroll.Salary"/>
	<variable name="supplements" class="java.util.List">
		<variableExpression><![CDATA[$F{salary}.getPayments().getSalarySupplements().getValues()]]></variableExpression>
	</variable>
	<variable name="deductions" class="java.util.List">
		<variableExpression><![CDATA[ReportUtils.sort($F{salary}.getSalaryDeductions(),"type", "description")]]></variableExpression>
	</variable>
	<variable name="embargos" class="java.util.List">
		<variableExpression><![CDATA[ReportUtils.sort($F{salary}.getSalaryEmbargos(),"type", "description")]]></variableExpression>
	</variable>
	<variable name="compensations" class="java.util.List">
		<variableExpression><![CDATA[$F{salary}.getPayments().getCompensationOrPrepaidExpenses().getValues()]]></variableExpression>
	</variable>
	<variable name="others" class="java.util.List">
		<variableExpression><![CDATA[$F{salary}.getPayments().getOtherNonWages().getValues()]]></variableExpression>
	</variable>
	<variable name="ssBenefits" class="java.util.List">
		<variableExpression><![CDATA[$F{salary}.getPayments().getSpecialSecurityBenefits().getValues()]]></variableExpression>
	</variable>
	<variable name="salaryInKind" class="java.lang.Double">
		<variableExpression><![CDATA[$F{salary}.getPayments().getSalaryInKind().getAmount()]]></variableExpression>
	</variable>
	<variable name="totalPayment" class="java.lang.Double">
		<variableExpression><![CDATA[$F{salary}.getTotalPayment() + $V{salaryInKind}]]></variableExpression>
	</variable>
	<variable name="totalDeduction" class="java.lang.Double">
		<variableExpression><![CDATA[$F{salary}.getTotalDeduction() + $V{salaryInKind}]]></variableExpression>
	</variable>
	<variable name="printedLines" class="java.lang.Integer">
		<variableExpression><![CDATA[$V{supplements}.size()]]></variableExpression>
	</variable>
	<variable name="remainLines" class="java.lang.Integer">
		<variableExpression><![CDATA[$V{supplements}.size() <= 4 ? 4 - Math.max(1, $V{supplements}.size()) : 23]]></variableExpression>
	</variable>
	<variable name="signature" class="com.code.aon.registry.RegistryAttachment">
		<variableExpression><![CDATA[ReportUtils.getRAttach( $F{salary}.getContract().getWorkPlace().getEnterprise().getId(), RegistryAttachmentType.SIGNATURE)]]></variableExpression>
	</variable>
	<variable name="allPayments" class="java.util.List">
		<variableExpression><![CDATA[$F{salary}.getPayments().getOrderedPayment()]]></variableExpression>
	</variable>
	<variable name="remainPayments" class="java.lang.Integer">
		<variableExpression><![CDATA[$V{allPayments}.size() >= 15 ? 0 : (25-$V{allPayments}.size())]]></variableExpression>
	</variable>
