				<textElement verticalAlignment="Middle" markup="none">
					<font size="6" isItalic="false" pdfFontName="Helvetica"/>
				</textElement>
				<textFieldExpression><![CDATA["Importante: sólo podrán cumplimentar este apartado los contribuyentes que hayan adquirido su vivienda habitual, o hayan satisfecho cantidades por obras de rehabilitación de la misma, antes del 1 de enero de 2013."]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement uuid="470a5ee3-d704-448f-83c8-5b7fa7578f56" x="11" y="578" width="515" height="24"/>
				<textElement verticalAlignment="Middle" markup="none">
					<font size="6" isItalic="false" pdfFontName="Helvetica"/>
				</textElement>
				<textFieldExpression><![CDATA["Si está Vd. efectuando pagos por préstamos destinados a la adquisición o rehabilitación de su vivienda habitual por los que vaya a tener derecho a deducción por inversión en vivienda habitual en el IRPF y la cuantía total de sus retribuciones íntegras en concepto de rendimientos del trabajo procedentes de todos sus pagadores es inferior a 33.007,20 euros anuales, marque con una 'X' esta casilla"]]></textFieldExpression>
			</textField>
