					<font size="6" isItalic="false" pdfFontName="Helvetica"/>
				</textElement>
				<textFieldExpression><![CDATA[$R{payroll_mod145_pension2} + " Importe anual que está Vd. obligado a satisfacer por resolución judicial"]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement uuid="17f7e253-8ae7-4a93-8b5f-770585d0d58b" x="11" y="531" width="449" height="14"/>
