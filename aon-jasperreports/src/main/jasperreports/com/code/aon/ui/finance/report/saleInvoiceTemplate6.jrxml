+  " - "
+ ($P{address}.getZip()==null?"":$P{address}.getZip() + " ") + ($P{address}.getCity()==null?"":$P{address}.getCity() + " ") + ($P{address}.getGeozone()==null?"":"(" + $P{address}.getGeozone().getName() + ")")
