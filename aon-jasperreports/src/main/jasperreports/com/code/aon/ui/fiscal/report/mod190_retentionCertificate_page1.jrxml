					<paragraph lineSpacing="Single"/>
				</textElement>
				<text><![CDATA[Fecha y firma]]></text>
			</staticText>
			<staticText>
				<reportElement uuid="d1cb5304-17b0-4d0e-be51-330922d12a6a" key="textField-34" positionType="Float" mode="Opaque" x="0" y="556" width="333" height="16" isRemoveLineWhenBlank="true" isPrintWhenDetailOverflows="true"/>
