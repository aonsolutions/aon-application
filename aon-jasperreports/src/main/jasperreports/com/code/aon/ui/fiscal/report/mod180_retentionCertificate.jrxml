					<font fontName="SansSerif" size="9" isBold="false" pdfFontName="Helvetica"/>
					<paragraph lineSpacing="Single"/>
				</textElement>
				<textFieldExpression><![CDATA["Y para que conste y sirva de justificante al interesado, en cumplimiento de lo dispuesto en los artículos 108.3 del Reglamento del IRPF y 66.3 "+
"del Reglamento del Impuesto sobre Sociedades, se expide el presente"]]></textFieldExpression>
