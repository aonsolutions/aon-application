				</textElement>
				<textFieldExpression><![CDATA["TODOS LOS CAMPOS HAN DE SER CUMPLIMENTADOS OBLIGATORIAMENTE."]]></textFieldExpression>
			</textField>
			<textField isStretchWithOverflow="true" isBlankWhenNull="true">
				<reportElement key="textField-53" positionType="Float" x="22" y="579" width="492" height="11"/>
