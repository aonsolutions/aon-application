    + ($P{recordData}.getRecordDate()!=null?" con fecha " + new SimpleDateFormat("dd/MM/yyyy").format($P{recordData}.getRecordDate()):"")
    : "")
+ (new Boolean(($P{printName}.name().equals( "LEFT_SIDE" ) || $P{printRecordData} && $P{recordData}!=null) && $P{printNif}.name().equals( "LEFT_SIDE" )) ? ", " : "")
+ ($P{printNif}.name().equals( "LEFT_SIDE" ) ?
    $R{aon_company_document} + ": "
    +$P{company}.getDocumentCountry() + "-"
    +$P{company}.getDocument()
    : "")]]></textFieldExpression>
