			</textField>
			<textField isStretchWithOverflow="true" isBlankWhenNull="true">
				<reportElement key="textField-23" positionType="Float" mode="Opaque" x="264" y="246" width="246" height="25" isRemoveLineWhenBlank="true" forecolor="#000000" backcolor="#FFFFFF">
					<printWhenExpression><![CDATA[$V{prepaymentTotal}!=null]]></printWhenExpression>
