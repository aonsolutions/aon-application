	<pageFooter>
		<band height="60" splitType="Stretch">
			<line>
				<reportElement key="line-9" positionType="FixRelativeToBottom" x="21" y="36" width="489" height="1" forecolor="#999999"/>
				<graphicElement>
					<pen lineWidth="0.75"/>
				</graphicElement>
			</line>
			<textField isBlankWhenNull="true">
				<reportElement key="textField-56" positionType="FixRelativeToBottom" x="21" y="38" width="489" height="10"/>
				<box>
					<topPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
					<leftPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
					<bottomPen lineWidth="0.0" lineColor="#000000"/>
					<rightPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
				</box>
				<textElement textAlignment="Center" verticalAlignment="Middle">
					<font fontName="SansSerif" size="7" pdfFontName="Helvetica"/>
				</textElement>
				<textFieldExpression><![CDATA[($P{printAddress}.name().equals( "FOOTER" ) ?
$P{address}.getFullAddress()
+  " - "
+ ($P{address}.getZip()==null?"":$P{address}.getZip() + " ") + ($P{address}.getCity()==null?"":$P{address}.getCity() + " ") + "(" + $P{address}.getGeozone().getName() + ")"
+  " - "
+ "T: " + $P{phone}.getValue() + ($P{fax}==null?"":" - " + "F: " + $P{fax}.getValue())
: "")]]></textFieldExpression>
			</textField>
			<textField isBlankWhenNull="true">
				<reportElement key="textField-56" positionType="FixRelativeToBottom" x="21" y="25" width="489" height="10"/>
				<box>
					<topPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
					<leftPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
					<bottomPen lineWidth="0.0" lineColor="#000000"/>
					<rightPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
				</box>
				<textElement textAlignment="Center" verticalAlignment="Middle">
					<font fontName="SansSerif" size="7" pdfFontName="Helvetica"/>
				</textElement>
				<textFieldExpression><![CDATA[($P{printName}.name().equals( "FOOTER" ) ? $P{company}.getName() : "")
+ ($P{printName}.name().equals( "FOOTER" ) && $P{printNif}.name().equals( "FOOTER" ) ? " - " : "")
+ ($P{printNif}.name().equals( "FOOTER" ) ?
    $P{company}.getDocumentType().getName( $P{REPORT_LOCALE} ) + ": "
    +$P{company}.getDocumentCountry() + "-"
    +$P{company}.getDocument()
    : "")]]></textFieldExpression>
			</textField>
			<textField isBlankWhenNull="true">
				<reportElement key="textField-56" positionType="FixRelativeToBottom" x="21" y="48" width="489" height="10"/>
				<box>
					<topPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
					<leftPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
					<bottomPen lineWidth="0.0" lineColor="#000000"/>
					<rightPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
				</box>
				<textElement textAlignment="Center" verticalAlignment="Middle">
					<font fontName="SansSerif" size="7" pdfFontName="Helvetica"/>
				</textElement>
				<textFieldExpression><![CDATA[($P{printInternetData}.name().equals( "FOOTER" ) ?
$P{company}.getWeb().getValue() + " - " + $P{company}.getEmail().getValue()
: "")]]></textFieldExpression>
			</textField>
			<textField isStretchWithOverflow="true" isBlankWhenNull="true">
				<reportElement key="textField-56" mode="Opaque" x="21" y="0" width="489" height="25" isRemoveLineWhenBlank="true" backcolor="#CCCCCC"/>
				<box topPadding="1" leftPadding="2" bottomPadding="1" rightPadding="2">
					<topPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
					<leftPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
					<bottomPen lineWidth="0.0" lineColor="#000000"/>
					<rightPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
				</box>
				<textElement textAlignment="Justified" verticalAlignment="Middle">
					<font fontName="SansSerif" size="6" isItalic="true" pdfFontName="Helvetica-Oblique"/>
				</textElement>
				<textFieldExpression><![CDATA[$P{invoiceFooterText}]]></textFieldExpression>
			</textField>
		</band>
	</pageFooter>
	<summary>
		<band splitType="Stretch"/>
	</summary>
</jasperReport>
