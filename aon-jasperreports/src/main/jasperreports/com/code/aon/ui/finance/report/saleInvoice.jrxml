+  " - "
+ ($P{address}.getZip()==null?"":$P{address}.getZip() + " ") + ($P{address}.getCity()==null?"":$P{address}.getCity() + " ") + "(" + $P{address}.getGeozone().getName() + ")"
+  " - "
+ "T: " + $P{phone}.getValue() + ($P{fax}==null?"":" - " + "F: " + $P{fax}.getValue())
: "")
+ ($P{printAddress}.name().equals( "FOOTER" ) && $P{printInternetData}.name().equals( "FOOTER" ) ? " - " : "")
+ ($P{printInternetData}.name().equals( "FOOTER" ) ?
$P{company}.getWeb().getValue() + " - " + $P{company}.getEmail().getValue()
: "")]]></textFieldExpression>
