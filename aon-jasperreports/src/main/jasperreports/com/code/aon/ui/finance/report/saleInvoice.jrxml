+ ($P{printNif}.name().equals( "FOOTER" ) ?
    $P{company}.getDocumentType().getName( $P{REPORT_LOCALE} ) + ": "
    +$P{company}.getDocumentCountry() + "-"
    +$P{company}.getDocument()
