
<!DOCTYPE html [
    <!ENTITY nbsp "&#160;"> 
]>
<ui:UiBinder xmlns:ui='urn:ui:com.google.gwt.uibinder' xmlns:doc='urn:import:com.esferalia.aon.gwt.issues.client'
	xmlns:g='urn:import:com.google.gwt.user.client.ui' xmlns:aon='urn:import:com.esferalia.aon.gwt.common.client.widget'
	xmlns:c="urn:import:com.google.gwt.user.cellview.client" xmlns:b="http://java.sun.com/jstl/core"
	xmlns:p='urn:import:com.vaadin.polymer.paper.widget'
	xmlns:i='urn:import:com.vaadin.polymer.iron.widget'
>
<ui:with type="com.esferalia.aon.gwt.issues.client.css.AonGwtIssuesResources"
		field="issuesResources"></ui:with>

 <ui:style>
  		.heading {
            background-color: #f3f3f3;
            border: 1px solid #ddd;
            font-size: 18px;
            cursor: pointer;
            -webkit-tap-highlight-color: rgba(0,0,0,0);
            width: 100%;
        }

        @external .iron-selected, .selector-sample;

        .selector-sample iron-selector > * {
            padding: 8px;
        }

        .selector-sample .iron-selected {
            background-color: #ddd;
        }
    </ui:style>

	<g:HTMLPanel ui:field="panel"> 
	    <g:HorizontalPanel>       
	    	<p:PaperButton ui:field="faqButton" noink="true" styleName="{issuesResources.css.faqConfigurationButtonIssues}">FAQs</p:PaperButton>
	    	<p:PaperIconButton ui:field="newFaqButton" icon="add" ></p:PaperIconButton>
        </g:HorizontalPanel>

	    <g:Button ui:field="gitHeading" addStyleNames="{style.heading}">GitHub</g:Button>
		<i:IronCollapse ui:field="gitCollapse">
			<p:PaperInput ui:field="gitUsername"></p:PaperInput>
			<p:PaperInput ui:field="gitRepository"></p:PaperInput>
			<p:PaperInput ui:field="gitToken"></p:PaperInput>
		</i:IronCollapse>
    </g:HTMLPanel>

</ui:UiBinder>
