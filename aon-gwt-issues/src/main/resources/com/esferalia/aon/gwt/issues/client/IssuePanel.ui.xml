
<!DOCTYPE html [
    <!ENTITY nbsp "&#160;"> 
]>
<ui:UiBinder xmlns:ui='urn:ui:com.google.gwt.uibinder' xmlns:doc='urn:import:com.esferalia.aon.gwt.issues.client'
	xmlns:g='urn:import:com.google.gwt.user.client.ui' xmlns:aon='urn:import:com.esferalia.aon.gwt.common.client.widget'
	xmlns:c="urn:import:com.google.gwt.user.cellview.client" xmlns:b="http://java.sun.com/jstl/core"	
	xmlns:p='urn:import:com.vaadin.polymer.paper.widget'
	xmlns:i='urn:import:com.vaadin.polymer.iron.widget'
	xmlns:a="urn:import:com.esferalia.aon.gwt.issues.client"
	>


	<ui:with type="com.esferalia.aon.gwt.common.client.i18n.AonHubMessages"
		field="msg"></ui:with>
	<ui:with type="com.esferalia.aon.gwt.common.client.css.AonResources"
		field="aonResources"></ui:with>

	<ui:with type="com.esferalia.aon.gwt.issues.client.css.AonGwtIssuesResources"
		field="issuesResources"></ui:with>
	
	<ui:style>

		@external .gwt-PopupPanel;

		.gwt-PopupPanel {
			margin: 0px !important;
			border: 1px solid #EEE !important;
			padding: 4px 0px !important;
			width:200px;
		}
	</ui:style>
	
	<g:SplitLayoutPanel ui:field="dockLayoutPanel">
		<g:center>		    
			<g:ScrollPanel>
				<g:HTMLPanel height="100%" width="100%">
				    <p:PaperIconButton ui:field="returnButton" icon="arrow-back" style="position:fixed;" />
				    <p:PaperIconButton ui:field="principalButton" icon="home" style="margin-left:30px;position:fixed;" />
					<table width="100%" class="{issuesResources.css.tableIssues}">
						<tr>
							<td width="70%" class="{issuesResources.css.tableIssues}">
								<g:VerticalPanel styleName="{issuesResources.css.scrollpanelOptionsIssues}">
									<g:SimplePanel ui:field="headerPanel">
										<!-- g:VerticalPanel ui:field="headerVPanel"
											spacing="10" /-->
									</g:SimplePanel>
									<g:FlowPanel ui:field="historialVPanel" />
									
                					<g:TextArea visibleLines="5" characterWidth="10"
												styleName="{aonResources.css.textAreaStyle}" ui:field="commentTextArea" />
                					
									<g:Grid width="100%" height="100%">
										<g:row>
											<g:customCell>
												<g:HTMLPanel height="100%" width="100%">
													<div>
														<g:InlineLabel styleName="{aonResources.css.aonBold}"
															text="{msg.userSender}" />
														<g:InlineLabel ui:field="userLogged"
															styleName="{aonResources.css.aonColorGreen}" />
													</div>
													<div>
													    <p:PaperIconButton ui:field="sendButton" icon="mail" title="{msg.sendNotificacion}" />
														<p:PaperIconButton ui:field="removeIssueButton" icon="delete" title="Borrar tarea" />
													</div>
												</g:HTMLPanel>
											</g:customCell>
											<g:customCell>
												<g:HTMLPanel height="100%" width="100%">
													<div class="{issuesResources.css.buttonsIssues}">
														<p:PaperButton ui:field="duplicatedButton" visible="true" style="background-color:#3f51b5;color:#fff;"> Duplicar </p:PaperButton>
														<p:PaperButton ui:field="desduplicatedButton" visible="true" style="background-color:#3f51b5;color:#fff;"> Liberar </p:PaperButton>
														<p:PaperButton ui:field="closedButton" raised="true" style="background-color:#f44336;color:#fff;"> Cerrar </p:PaperButton>
														<p:PaperButton ui:field="reopenButton" raised="true" style="background-color:#4caf50;color:#fff;"> Abrir </p:PaperButton>
														<p:PaperButton ui:field="commentButton" disabled="true" raised="true"> Comentar </p:PaperButton>
													</div>
												</g:HTMLPanel>
											</g:customCell>
										</g:row>
									</g:Grid>
								</g:VerticalPanel>
							</td>
							<td width="30%" class="{issuesResources.css.tableIssues}">
								<g:VerticalPanel spacing="10">
									<g:FlowPanel>
										<g:VerticalPanel spacing="10">
											<g:HorizontalPanel>
												<g:Label text="{msg.typeOfIssue}" styleName="{aonResources.css.aonBold}" />
												<g:Button ui:field="typeButton" text="{msg.typeOfIssue}"
													styleName="{aonResources.css.aonIconView} 
				{aonResources.css.aonIconCommandButton}" />
											</g:HorizontalPanel>
											<g:HorizontalPanel>
												<g:Label ui:field="typeLabel"
													styleName="{aonResources.css.tagStyle} {issuesResources.css.tagTypeIssues}" />
												<p:PaperIconButton ui:field="typeDeleteButton" icon="close" style="padding:3px !important;"/>
											</g:HorizontalPanel>
										</g:VerticalPanel>
									</g:FlowPanel>
									<g:FlowPanel>
										<g:VerticalPanel spacing="10">
											<g:HorizontalPanel>
												<g:Label text="{msg.priority}" styleName="{aonResources.css.aonBold}" />
												<g:Button ui:field="priorityButton" text="Prioridad"
													styleName="{aonResources.css.aonIconView} 
				{aonResources.css.aonIconCommandButton}" />
											</g:HorizontalPanel>
											<g:HorizontalPanel>
												<g:Label ui:field="priorityLabel"
												styleName="{aonResources.css.tagStyle} {issuesResources.css.tagPriorityIssues}" />
											</g:HorizontalPanel>
										</g:VerticalPanel>
									</g:FlowPanel>
									<g:FlowPanel>
										<g:VerticalPanel ui:field="labelsVPanel"
											spacing="10">
											<g:HorizontalPanel>
												<g:Label text="{msg.labels}" styleName="{aonResources.css.aonBold}" />
												<g:Button ui:field="tagButton" text="{msg.labels}"
													styleName="{aonResources.css.aonIconView} 
				{aonResources.css.aonIconCommandButton}" />
											</g:HorizontalPanel>
										</g:VerticalPanel>
									</g:FlowPanel>

									<g:FlowPanel>
										<g:VerticalPanel spacing="10">
											<g:HorizontalPanel>
												<g:Label text="{msg.workgroup}" styleName="{aonResources.css.aonBold}" />
												<g:Button ui:field="workgroupButton" text="Grupo de Trabajo"
													styleName="{aonResources.css.aonIconView} 
				{aonResources.css.aonIconCommandButton}" />
											</g:HorizontalPanel>
											<g:HorizontalPanel>
												<g:Label ui:field="workgroupLabel"
													styleName="{aonResources.css.tagStyle} {issuesResources.css.tagPriorityIssues}" />
												<p:PaperIconButton ui:field="workgroupDeleteButton" icon="close" style="padding:3px !important;"/>
											</g:HorizontalPanel>										
										</g:VerticalPanel>
									</g:FlowPanel>

									<g:FlowPanel>
										<g:VerticalPanel ui:field="usersVPanel"
											spacing="10">
											<g:HorizontalPanel>
												<g:Label text="{msg.assignedTo}" styleName="{aonResources.css.aonBold}" />			
												<g:Button ui:field="userButton" text="{msg.assignedTo}"
													styleName="{aonResources.css.aonIconView} 
														{aonResources.css.aonIconCommandButton}" />
											</g:HorizontalPanel>
											<g:HorizontalPanel>
												<g:Label ui:field="userLabel"
													styleName="{aonResources.css.tagStyle} {issuesResources.css.tagNoticeIssues}" />		
												<p:PaperIconButton ui:field="userDeleteButton" icon="close" style="padding:3px !important;"/>
											</g:HorizontalPanel>
										</g:VerticalPanel>
									</g:FlowPanel>
								</g:VerticalPanel>
							</td>
						</tr>
					</table>
				</g:HTMLPanel>
			</g:ScrollPanel>
			
		</g:center>

		<g:south size="30">
			<aon:MinimizePanel ui:field="footPanel"
				styleName="{aonResources.css.aonSelector}">
				<g:TabLayoutPanel ui:field="tabLayout" barHeight="26"
					barUnit="PX" width="100%">
					<g:tab>
						<g:customHeader>
							<g:Label
								styleName="{aonResources.css.aonIconJournalLog} {aonResources.css.aonPaddingRight}"
								text="Contacto" />
						</g:customHeader>
						<aon:ResultsPanel ui:field="resultsPanel" />
					</g:tab>
					
					<g:tab>
						<g:customHeader>
							<g:Label
								styleName="{aonResources.css.aonIconInfo} {aonResources.css.aonPaddingRight} {aonResources.css.aonPaddingLeft20}"
								text="Facturas" />
						</g:customHeader>
						<g:ScrollPanel ui:field="informationPanel"
							styleName="{aonResources.css.aonTextCenter}" />
					</g:tab>
					
					<g:tab>
						<g:customHeader>
							<g:Label
								styleName="{aonResources.css.aonIconInfo} {aonResources.css.aonPaddingRight} {aonResources.css.aonPaddingLeft20}"
								text="Duplicados" />
						</g:customHeader>
						<g:ScrollPanel ui:field="duplicatePanel" />
					</g:tab>
				</g:TabLayoutPanel>
			</aon:MinimizePanel>
		</g:south>
	</g:SplitLayoutPanel>
</ui:UiBinder>
