<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
	xmlns:g="urn:import:com.google.gwt.user.client.ui" xmlns:aon='urn:import:com.esferalia.aon.gwt.common.client.widget'>
	<ui:style>
	.stackHeader {
		padding: .7em .5em .7em .6em;
	}
	
	.newButton {
		float: right;
	}
	
	.legend-icon {
		margin-top: 3px;
	}
	</ui:style>

	<g:DockLayoutPanel unit='PX'>
		<g:north size='26'>
			<g:FlowPanel styleName="gwt-MenuBar-horizontal" ui:field="buttonBar">
				<g:HTMLPanel styleName="{style.legend-icon}">
					<g:Button ui:field='draftButton'
						styleName='aon-editDataTable-button aon-icon-draft {style.newButton}'
						title="Eliminar" />

					<g:Button ui:field='newButton'
						styleName='aon-editDataTable-button aon-icon-reset {style.newButton}'
						title="Nuevo" />

					<g:Button ui:field='hideButton'
						styleName='aon-editDataTable-button aon-icon-cancel {style.newButton}'
						title="Ocultar" />
				</g:HTMLPanel>
			</g:FlowPanel>
		</g:north>
		<g:center>
			<g:ScrollPanel>
				<g:Tree ui:field="tree">
					<g:TreeItem ui:field="statusTreeItem" text="Estado" />
					<g:TreeItem ui:field="priorityTreeItem" text="Prioridad" />
					<g:TreeItem ui:field="typeTreeItem" text="Tipo" />
					<g:TreeItem ui:field="issueTreeItem" text="Incidencia" />
				</g:Tree>
			</g:ScrollPanel>
		</g:center>
	</g:DockLayoutPanel>
</ui:UiBinder> 