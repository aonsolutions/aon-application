
<!DOCTYPE html [
    <!ENTITY nbsp "&#160;"> 
]>
<ui:UiBinder xmlns:ui='urn:ui:com.google.gwt.uibinder' xmlns:doc='urn:import:com.esferalia.aon.gwt.issues.client'
	xmlns:g='urn:import:com.google.gwt.user.client.ui' xmlns:aon='urn:import:com.esferalia.aon.gwt.common.client.widget'
	xmlns:c="urn:import:com.google.gwt.user.cellview.client" xmlns:b="http://java.sun.com/jstl/core"
	

	xmlns:p='urn:import:com.vaadin.polymer.paper.widget'
	xmlns:i='urn:import:com.vaadin.polymer.iron.widget'>

<g:HTMLPanel addStyleNames="dialog-aon">
	<style is="custom-style">

    </style>
    
	<p:PaperDialog ui:field="dialog" withBackdrop="true" entryAnimation="scale-up-animation" exitAnimation="fade-out-animation">
    	<h2>
    		<g:Label ui:field="title" />
    	</h2>
    	<div>
    		<g:HTMLPanel ui:field="content" />
    	</div>
    	<div class="buttons">
        	<p:PaperButton ui:field="cancel" attributes="dialog-dismiss">Cancel</p:PaperButton>
            <p:PaperButton ui:field="accept" attributes="dialog-confirm">OK</p:PaperButton>
        </div>
    </p:PaperDialog>

</g:HTMLPanel>
</ui:UiBinder>
