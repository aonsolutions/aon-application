
<!DOCTYPE html [
    <!ENTITY nbsp "&#160;"> 
]>
<ui:UiBinder xmlns:ui='urn:ui:com.google.gwt.uibinder' xmlns:doc='urn:import:com.esferalia.aon.gwt.issues.client'
	xmlns:g='urn:import:com.google.gwt.user.client.ui' xmlns:aon='urn:import:com.esferalia.aon.gwt.common.client.widget'
	xmlns:c="urn:import:com.google.gwt.user.cellview.client" xmlns:b="http://java.sun.com/jstl/core"
	

	xmlns:p='urn:import:com.vaadin.polymer.paper.widget'
	xmlns:i='urn:import:com.vaadin.polymer.iron.widget'>
    	
<ui:with type="com.esferalia.aon.gwt.issues.client.css.AonGwtIssuesResources"
		field="issuesResources"></ui:with>

<ui:style>
	
		@external .gwt-PopupPanel;

		.gwt-PopupPanel {
			margin: 0px !important;
			border: 1px solid #EEE !important;
			padding: 4px 0px !important;
			width:200px;
		}    

</ui:style>

<g:HTMLPanel  styleName="aon-panelGrid-search {issuesResources.css.aonPanelGridSearchIssues}" >
   	<div class="aon-panelGrid-search-info {issuesResources.css.aonPanelGridSearchInfoIssues}">							
		<g:HorizontalPanel ui:field="filterHorizontal" styleName="aon-width-all">
			<g:HTMLPanel>
				<span class="aon-panelGrid-search-info-internal" style="position: relative;top: 2px;">Filtrar:</span>
				<g:InlineLabel ui:field="priorityLabel"></g:InlineLabel>
				<g:InlineLabel ui:field="tagLabel"></g:InlineLabel>
				<g:InlineLabel ui:field="typeLabel"></g:InlineLabel>
				<g:InlineLabel ui:field="creatorLabel"></g:InlineLabel>
				<g:InlineLabel ui:field="assignedLabel"></g:InlineLabel>
				<g:InlineLabel ui:field="workgroupLabel"></g:InlineLabel>
				<g:InlineLabel ui:field="enterpriseLabel"></g:InlineLabel>
				<g:InlineLabel ui:field="orderLabel"></g:InlineLabel>
				<g:InlineLabel ui:field="dateLabel"></g:InlineLabel>				
			</g:HTMLPanel>			
		</g:HorizontalPanel>					
	</div>
    
    <g:HorizontalPanel styleName="aon-width-all">
        
        <g:HorizontalPanel>
       		<g:TextBox ui:field="titleFilter" styleName="{issuesResources.css.aonSearchBoxIssues}"/>
        
        	<p:PaperButton ui:field="openButton" styleName="{issuesResources.css.aonPaperButtonFilterIssues}" >
				<i:IronIcon icon="error-outline" styleName="{issuesResources.css.aonIronIconFilterIssues}" />
				<g:InlineLabel ui:field="openLabel" text="Abierta" styleName="{issuesResources.css.aonInlineLabelFilterIssues}" />
			</p:PaperButton>
		
        	<p:PaperButton ui:field="closeButton" styleName="{issuesResources.css.aonPaperButtonFilterIssues}">
			    <i:IronIcon icon="check" styleName="{issuesResources.css.aonIronIconFilterIssues}" />
			    <g:InlineLabel ui:field="closeLabel" text="Cerrada" styleName="{issuesResources.css.aonInlineLabelFilterIssues}" />
			</p:PaperButton>	
		
    	    <p:PaperButton ui:field="removeButton" styleName="{issuesResources.css.aonPaperButtonFilterIssues}">
			    <i:IronIcon icon="remove-circle" styleName="{issuesResources.css.aonIronIconFilterIssues}" />
			    <g:InlineLabel ui:field="removeLabel" text="Borrada" styleName="{issuesResources.css.aonInlineLabelFilterIssues}" />
			</p:PaperButton>	
        </g:HorizontalPanel>
    
        <g:HorizontalPanel horizontalAlignment="right">
        	<p:PaperButton ui:field="priorityButton" styleName="{issuesResources.css.aonPaperButtonFilterIssues}">
			    <g:InlineLabel text="Prioridad" styleName="{issuesResources.css.aonInlineLabelFilterIssues}" />
        	    <i:IronIcon icon="arrow-drop-down" styleName="{issuesResources.css.aonIronIconFilterIssues}" />
			</p:PaperButton>
		
        	<p:PaperButton ui:field="tagButton" styleName="{issuesResources.css.aonPaperButtonFilterIssues}">
			    <g:InlineLabel text="Etiqueta" styleName="{issuesResources.css.aonInlineLabelFilterIssues}" />
        	    <i:IronIcon icon="arrow-drop-down" styleName="{issuesResources.css.aonIronIconFilterIssues}" />
			</p:PaperButton>	
		
        	<p:PaperButton ui:field="typeButton" styleName="{issuesResources.css.aonPaperButtonFilterIssues}">
			    <g:InlineLabel text="Tipo" styleName="{issuesResources.css.aonInlineLabelFilterIssues}" />
        	    <i:IronIcon icon="arrow-drop-down" styleName="{issuesResources.css.aonIronIconFilterIssues}" />
			</p:PaperButton>	
		
        	<p:PaperButton ui:field="creatorButton" styleName="{issuesResources.css.aonPaperButtonFilterIssues}">
			    <g:InlineLabel text="Creador" styleName="{issuesResources.css.aonInlineLabelFilterIssues}" />
           		<i:IronIcon icon="arrow-drop-down" styleName="{issuesResources.css.aonIronIconFilterIssues}" />
			</p:PaperButton>	
		
			<p:PaperButton ui:field="assignedButton" styleName="{issuesResources.css.aonPaperButtonFilterIssues}">
			    <g:InlineLabel text="Asignado" styleName="{issuesResources.css.aonInlineLabelFilterIssues}" />
        	    <i:IronIcon icon="arrow-drop-down" styleName="{issuesResources.css.aonIronIconFilterIssues}" />
			</p:PaperButton>
			
			<p:PaperButton ui:field="workgroupButton" styleName="{issuesResources.css.aonPaperButtonFilterIssues}">
			    <g:InlineLabel text="G T" styleName="{issuesResources.css.aonInlineLabelFilterIssues}" />
        	    <i:IronIcon icon="arrow-drop-down" styleName="{issuesResources.css.aonIronIconFilterIssues}" />
			</p:PaperButton>
			
			<p:PaperButton ui:field="enterpriseButton" styleName="{issuesResources.css.aonPaperButtonFilterIssues}">
			    <g:InlineLabel text="Empresa" styleName="{issuesResources.css.aonInlineLabelFilterIssues}" />
        	    <i:IronIcon icon="arrow-drop-down" styleName="{issuesResources.css.aonIronIconFilterIssues}" />
			</p:PaperButton>	
			
			<p:PaperButton ui:field="orderButton" styleName="{issuesResources.css.aonPaperButtonFilterIssues}">
			    <g:InlineLabel text="Orden" styleName="{issuesResources.css.aonInlineLabelFilterIssues}" />
        	    <i:IronIcon icon="arrow-drop-down" styleName="{issuesResources.css.aonIronIconFilterIssues}" />
			</p:PaperButton>	
			<p:PaperButton ui:field="dateButton" styleName="{issuesResources.css.aonPaperButtonFilterIssues}">
			    <g:InlineLabel text="Fecha" styleName="{issuesResources.css.aonInlineLabelFilterIssues}" />
        	    <i:IronIcon icon="arrow-drop-down" styleName="{issuesResources.css.aonIronIconFilterIssues}" />
			</p:PaperButton>	
		</g:HorizontalPanel>
		
	</g:HorizontalPanel>
    
</g:HTMLPanel>

</ui:UiBinder>
