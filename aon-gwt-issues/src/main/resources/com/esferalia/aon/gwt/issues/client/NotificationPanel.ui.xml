
<!DOCTYPE html [
    <!ENTITY nbsp "&#160;"> 
]>
<ui:UiBinder xmlns:ui='urn:ui:com.google.gwt.uibinder' xmlns:doc='urn:import:com.esferalia.aon.gwt.issues.client'
	xmlns:g='urn:import:com.google.gwt.user.client.ui' xmlns:aon='urn:import:com.esferalia.aon.gwt.common.client.widget'
	xmlns:c="urn:import:com.google.gwt.user.cellview.client" xmlns:b="http://java.sun.com/jstl/core"
	

	xmlns:p='urn:import:com.vaadin.polymer.paper.widget'
	xmlns:i='urn:import:com.vaadin.polymer.iron.widget'
	xmlns:v='urn:import:com.vaadin.polymer.vaadin.widget'
>

<ui:style>
	@external .toggle-label;

    .toggle-label {
    	color: #737373;
    	white-space: nowrap;
    	Overflow: hidden;
    	text-overflow: ellipsis;
    	font-family: 'Roboto', 'Noto', sans-serif;
    	-webkit-font-smoothing: antialiased;
    	font-size: 16px;
    	font-weight: 400;
    	line-height: 24px;
    }

	.comboBox{
		padding-left: 20px;
		padding-right: 20px;
	}	

	.toggle{
		padding-left: 20px;
		padding-right: 20px;
		padding-top: 30px;
		
	}	

</ui:style>

<g:HTMLPanel>
    <g:ScrollPanel>
    <g:VerticalPanel> 
    	<v:VaadinComboBox ui:field="emailComboBox" addStyleNames="{style.comboBox}"></v:VaadinComboBox>
    	<p:PaperToggleButton ui:field="logoToggle" addStyleNames="{style.toggle}">
    	     Incluir logo en la cabecera 
    	</p:PaperToggleButton>
    	<p:PaperSlider ui:field="logoSlider" pin="true" max="100"></p:PaperSlider>
		<v:VaadinComboBox ui:field="signComboBox" addStyleNames="{style.comboBox}"></v:VaadinComboBox>
		<p:PaperToggleButton ui:field="commentHistoryToggle" addStyleNames="{style.toggle}">
		     Incluir historial completo de comentarios 
		</p:PaperToggleButton>
		<p:PaperToggleButton ui:field="statusHistoryToggle" addStyleNames="{style.comboBox}">
		     Incluir historial completo de estados 
		</p:PaperToggleButton>
		<p:PaperInput ui:field="bccInput" addStyleNames="{style.comboBox}"></p:PaperInput>
		<v:VaadinComboBox ui:field="modeComboBox" addStyleNames="{style.comboBox}"></v:VaadinComboBox>
		<p:PaperToggleButton ui:field="notifyOpenToggle" addStyleNames="{style.toggle}">
			Notificar al abrir
		</p:PaperToggleButton>
		<p:PaperToggleButton ui:field="notifyCloseToggle" addStyleNames="{style.comboBox}">
		    Notificar al cerrar 
		</p:PaperToggleButton>
		<p:PaperToggleButton ui:field="notifyReopenToggle" addStyleNames="{style.comboBox}">
		    Notificar al re-abrir 
		</p:PaperToggleButton>
		<p:PaperToggleButton ui:field="notifyCommentToggle" addStyleNames="{style.comboBox}">
		    Notificar al comentar 
		</p:PaperToggleButton>
	</g:VerticalPanel>
	</g:ScrollPanel>
</g:HTMLPanel>

</ui:UiBinder>
