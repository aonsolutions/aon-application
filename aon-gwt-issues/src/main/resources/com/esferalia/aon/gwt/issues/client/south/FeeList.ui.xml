<ui:style>



</ui:style>
<g:HTMLPanel addStyleNames="fee-list-issue"> 

	<style is="custom-style">
					
            .fee-list-issue iron-list {
                padding-bottom: 0px;
            }
            .fee-list-issue .item {
       	 		border:0px;
       	 		cursor:pointer;
       	 		text-align:left;
            }

            .fee-list-issue .pad {
            	padding-left: 30px;
            }

    </style>
       <i:IronList ui:field="feeList" as="item" selectionEnabled="true">
            <template>
                <div>
                    <div class="item">
                    	<iron-icon  icon="event"/> 
                    	[[item.description]] 
					</div>
               	</div>
        	</template>
  		</i:IronList>
  	</g:HTMLPanel>
</ui:UiBinder>
