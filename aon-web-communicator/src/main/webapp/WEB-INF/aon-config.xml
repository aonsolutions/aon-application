<?xml version="1.0" encoding="UTF-8" ?>
<config
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.esferalia.com/finance finance.xsd"
	xmlns="http://www.esferalia.com/config" >

	<registry:config version="1.0" xmlns:registry="http://www.esferalia.com/registry">
		<registry:rmedia 
			showSendEmail="true" 
		/>
	</registry:config>
	
	<webmail:config version="1.0" xmlns:webmail="http://www.esferalia.com/webmail" />
		
	<company:config version="1.0" xmlns:company="http://www.esferalia.com/company">
		<company:company 
			showRegistryBank="true" 
			showCompanyOtherData="true"
			showPanelTabSet="true" 
			showDigitalCertificate="true"
			showEInvoice="false"
		/>
	</company:config>

	<marketing:config version="1.1" xmlns:marketing="http://www.esferalia.com/marketing">
		<marketing:campaign
			showSurvey="false"
			showPhoneActionMediaType="false"
		/>
		<marketing:communicationCenter
			showTarget="false"
		/>
	</marketing:config>
	
	<commercial:config version="1.1" xmlns:commercial="http://www.esferalia.com/commercial">
		<commercial:offer
			showInvoicing="false"
			showSalesOrder="false"
		/>
		<commercial:target
			showTaxInfoData="false"
			showEcommerceTab="false"
			showProfile="false"
			showSearchOnlyCustomers="false"
			showCommercialTracking="false"
			showProduct="false"
			showSeller="false"
			showAddInfo="true"			
		/>
	</commercial:config>
		
</config>