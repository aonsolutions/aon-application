<?xml version="1.0" encoding="UTF-8" ?>
<config
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xmlns="http://www.esferalia.com/common" >

	<registry:config version="1.0" xmlns:registry="http://www.esferalia.com/registry">
		<registry:rmedia 
			showSendEmail="true" 
		/>
	</registry:config>
	
	<webmail:config version="1.2" xmlns:webmail="http://www.esferalia.com/webmail" >
		<webmail:webmail
			connect="true"
			showDomainMailAccounts="true"
		/>
	</webmail:config>
		
	<config:config version="1.1" xmlns:config="http://www.esferalia.com/config" >
		<config:series
			showOfferData="false"
			showSalesData="false"
			showDeliveryData="false"
			showInvoiceData="false"
			showTasData="false"
		/>
	</config:config>	

	<company:config version="1.4" xmlns:company="http://www.esferalia.com/company">
		<company:company 
			showRegistryBank="true" 
			showCompanyOtherData="true"
			showPanelTabSet="true" 
			showDigitalCertificate="true"
			showEInvoice="false"
			showDirStaff="false"
		/>
		<company:enterprise 
			showFinanceData="false" 
			showAddInfo="true"
			showDirStaff="false"
			standalone="false"
			showEnterpriseParams="false"
			showPayrollData="false"
		/>				
	</company:config>

	<marketing:config version="1.2" xmlns:marketing="http://www.esferalia.com/marketing">
		<marketing:campaign
			showSurvey="true"
			showPhoneActionMediaType="true"
		/>
	</marketing:config>
	
	<commercial:config version="1.3" xmlns:commercial="http://www.esferalia.com/commercial">
		<commercial:offer
			showInvoicing="false"
			showSalesOrder="false"
			showSeller="true"
		/>
		<commercial:target
			showTaxInfoData="false"
			showEcommerceTab="false"
			showProfile="true"
			showSearchOnlyCustomers="false"
			showProject="false"
			showProduct="false"
			showSeller="false"
			showAddInfo="true"			
			showSupplier="false"
			showTariff="false"
			showFinanceData="false"
			showNote="true"			
		/>
	</commercial:config>
	
	<groupware:config version="1.0" xmlns:groupware="http://www.esferalia.com/groupware">
		<groupware:alarm
			showPending="true"
			showList="true"
			showNew="true"
			showGoToCallCenter="true"
			showGoToCommercialMarketing="true"
		/>
	</groupware:config>	
		
</config>