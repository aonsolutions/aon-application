	<modelVersion>4.0.0</modelVersion>
	<artifactId>aon-jasper-report</artifactId>
	<name>AON JASPER REPORTS</name>
	<description>AON JASPER REPORTS</description>

	<properties>
		<maven.compiler.source>1.8</maven.compiler.source>
		<maven.compiler.target>1.6</maven.compiler.target>
	</properties>
	
	<build>
		<plugins>
			<plugin>
			  <groupId>org.apache.maven.plugins</groupId>
			  <artifactId>maven-shade-plugin</artifactId>
			  <version>3.0.0</version>
			  <executions>
			    <execution>
			      <phase>package</phase>
			      <goals>
			        <goal>shade</goal>
			      </goals>
			      <configuration>
			        <artifactSet>
			          <excludes>
			            <exclude>com.amazonaws:aws-lambda-java-events</exclude>
			            <exclude>com.amazonaws:aws-lambda-java-core</exclude>
			          </excludes>
			        </artifactSet>
			      </configuration>
			    </execution>
			  </executions>
			</plugin>
		</plugins>
	</build>
	
