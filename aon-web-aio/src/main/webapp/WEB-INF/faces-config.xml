<faces-config version="1.2"
	xmlns="http://java.sun.com/xml/ns/javaee"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://java.sun.com/xml/ns/javaee http://java.sun.com/xml/ns/javaee/web-facesconfig_1_2.xsd">
	
	<application>
		<message-bundle>com.code.aon.common.i18n.messages</message-bundle>
		<locale-config>
			<default-locale>es</default-locale>
			<supported-locale>en</supported-locale>
		</locale-config> 
		<navigation-handler>com.code.aon.ui.audit.AuditNavigationHandler</navigation-handler>
	</application>

	<!-- *************** RESOURCE RESOLVER ***************** --> 
	<managed-bean>
		<managed-bean-name>aonResource</managed-bean-name>
		<managed-bean-class>
			com.code.aon.ui.resources.bean.ResourceResolver
		</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
	</managed-bean>

	<!--  **** AON CONFIGURATION **** -->
	<managed-bean>
		<managed-bean-name>aonConfiguration</managed-bean-name>
		<managed-bean-class>
			com.code.aon.ui.common.controller.ConfigurationController
		</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
		<managed-property>
			<property-name>styleSheets</property-name>
			<list-entries>
				<value>#{aonResource.resolve['/aon-richCss.css']}</value>
				<value>#{aonResource.resolveLocal['/css/aio.css']}</value>
			</list-entries>
		</managed-property>
	   <managed-property>
	      <property-name>properties</property-name>
	      <map-entries>
	         <map-entry>
	            <key>hideApplicationVersion</key>
	            <value>#{true}</value>
	         </map-entry>
	         <map-entry>
	            <key>showAbout</key>
	            <value>#{false}</value>
	         </map-entry>
	         <map-entry>
	            <key>showSearchResults</key>
	            <value>#{false}</value>
	         </map-entry>
	      </map-entries>
	   </managed-property>      	    				
	</managed-bean>

	<!--  **** EMAIL VERIFY CONTROLLER **** -->
	<managed-bean>
		<managed-bean-name>emailVerify</managed-bean-name>
		<managed-bean-class>
			com.code.aon.aio.controller.EmailVerifyController
		</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
	</managed-bean>

	<!--  **** DESKTOP CONTROLLER **** -->
	<managed-bean>
		<managed-bean-name>desktop</managed-bean-name>
		<managed-bean-class>
			com.code.aon.aio.controller.DesktopController
		</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
	</managed-bean>
	
	<!--  **** DASHBOEARD CONTROLLER **** -->
	<managed-bean>
		<managed-bean-name>dashboard</managed-bean-name>
		<managed-bean-class>
			com.code.aon.aio.controller.DashboardController
		</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
	</managed-bean>
	
	<!--  **** SEARCH CONTROLLER **** -->
	<managed-bean>
		<managed-bean-name>search</managed-bean-name>
		<managed-bean-class>
			com.code.aon.aio.controller.SearchController
		</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
	</managed-bean>

