   	<!-- ************************************************** -->
   	<!-- ************* OPTIONAL LISTENERS ***************** -->
   	<!-- ************************************************** -->
	
	<!-- ************ ACCOUNT LISTENERS ******************* -->
	<managed-bean>
		<managed-bean-name>accountOptionalListeners</managed-bean-name>
	    <managed-bean-class>java.util.LinkedList</managed-bean-class>
		<managed-bean-scope>none</managed-bean-scope>
		<list-entries>
			<value-class>com.code.aon.ui.form.event.IControllerListener</value-class>
			<!--  aon.ui.account.bridge -->
			<value>#{accountControllerCascadeListener}</value>
		</list-entries>
	</managed-bean>

	<!-- ************ CUSTOMER LISTENERS ******************* -->
	<managed-bean>
		<managed-bean-name>customerOptionalListeners</managed-bean-name>
	    <managed-bean-class>java.util.LinkedList</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
		<list-entries>
			<value-class>com.code.aon.ui.form.event.IControllerListener</value-class>
			<!--  aon.ui.finance -->
			<value>#{customerFeeChildListener}</value>
			<!-- aon-ui-project-->
			<value>#{customerProjectListener}</value>
			<!-- aon-ui-academy-->
			<value>#{customerAbsenceChildListener}</value>
			<value>#{customerAlumnLoanChildListener}</value>
			<value>#{customerAlumnCourseChildListener}</value>
			<value>#{alumnControllerListener}</value>
			<!--  aon.ui.customer -->
			<value>#{customerPersonListener}</value>
			<!--  aon.ui.registry -->
			<value>#{customerSellerListener}</value>
			<value>#{customerProfileListener}</value>
			<value>#{customerSupplierListener}</value>			
		</list-entries>
	</managed-bean>

	<!-- ************ PRODUCT LISTENERS ******************* -->
