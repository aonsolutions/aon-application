			<value>#{itemCompositionChildListener}</value>				
			<value>#{itemCustomerChildListener}</value>
			<value>#{itemSupplierChildListener}</value>
			<value>#{itemTariffChildListener}</value>
		</list-entries>
	</managed-bean>

