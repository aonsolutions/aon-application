  <profiles>
    <profile>
      <id>rpm-release</id>
      <activation>
        <property>
          <name>rpm.release</name>
          <value>true</value>
        </property>
      </activation>
      <dependencies>
        <dependency>
          <groupId>com.code.aon</groupId>
          <artifactId>aon.jaas</artifactId>
          <version>${project.version}</version>
          <scope>compile</scope>
        </dependency>
        <dependency>
          <groupId>com.code.aon</groupId>
          <artifactId>aon.pool</artifactId>
          <version>${project.version}</version>
          <scope>compile</scope>
        </dependency>
        <dependency>
          <groupId>com.mchange</groupId>
          <artifactId>c3p0</artifactId>
          <version>0.9.2</version>
          <scope>compile</scope>
        </dependency>
        <dependency>
          <groupId>com.qzindustries</groupId>
          <artifactId>qz-print</artifactId>
          <version>1.8.0</version>
          <scope>compile</scope>
        </dependency>
      </dependencies>
      <build>
        <pluginManagement>
          <plugins>
            <plugin>
              <artifactId>maven-war-plugin</artifactId>
              <configuration>
                <packagingExcludes>
                WEB-INF/lib/c3p0*.jar,
                WEB-INF/lib/aon.jaas*.jar,
                WEB-INF/lib/aon.pool*.jar,
                WEB-INF/lib/qz-print*.jar,
                </packagingExcludes>
              </configuration>
            </plugin>
            <!-- Para construir el RPM -->
            <plugin>
              <groupId>org.codehaus.mojo</groupId>
              <artifactId>rpm-maven-plugin</artifactId>
              <version>2.1-alpha-2</version>
              <extensions>true</extensions>
              <executions>
                <execution>
                  <id>tomcat8-rpm-build</id>
                  <goals>
                    <goal>attached-rpm</goal>
                  </goals>
                  <!-- Se indica la configuracion dentro de la ejecucion, para no 
										sobrescribir la de JBOSS -->
                  <configuration>
                    <group>Applications/Aon</group>
                    <name>aon-aio8</name>
                    <!-- Se utiliza el parametro calssifier para diferenciar la ejcución 
											de la de Jboss web-parent. -->
                    <classifier>TOMCAT8</classifier>
                    <release>tomcat8_${buildNumber}</release>
                    <copyright>2009, esferalia Networks S.A</copyright>
                    <requires>
                      <require>tomcat8</require>
                      <require>mysql-connector-java</require>
                      <require>slf4j</require>
                      <require>urw-fonts</require>

                      <require>cairo</require>
                      <require>libGL</require>
                      <require>libGLU</require>
                      <require>cups-libs</require>
                      <require>dbus-glib</require>
                      <require>libXinerama</require>
                      <require>libreoffice4.3</require>
                      <require>libreoffice4.3-ure</require>
                      <require>libobasis4.3-base</require>
                      <require>libobasis4.3-calc</require>
                      <require>libobasis4.3-core01</require>
                      <require>libobasis4.3-core02</require>
                      <require>libobasis4.3-core03</require>
                      <require>libobasis4.3-core04</require>
                      <require>libobasis4.3-core05</require>
                      <require>libobasis4.3-core06</require>
                      <require>libobasis4.3-core07</require>
                      <require>libobasis4.3-draw</require>
                      <require>libobasis4.3-en-US</require>
                      <require>libobasis4.3-en-US-base</require>
                      <require>libobasis4.3-en-US-calc</require>
                      <require>libobasis4.3-en-US-math</require>
                      <require>libobasis4.3-en-US-res</require>
                      <require>libobasis4.3-en-US-writer</require>
                      <require>libobasis4.3-extension-beanshell-script-provider</require>
                      <require>libobasis4.3-extension-javascript-script-provider</require>
                      <require>libobasis4.3-extension-mediawiki-publisher</require>
                      <require>libobasis4.3-extension-nlpsolver</require>
                      <require>libobasis4.3-extension-pdf-import</require>
                      <require>libobasis4.3-extension-report-builder</require>
                      <require>libobasis4.3-filter-data</require>
                      <require>libobasis4.3-graphicfilter</require>
                      <require>libobasis4.3-images</require>
                      <require>libobasis4.3-impress</require>
                      <require>libobasis4.3-kde-integration</require>
                      <require>libobasis4.3-math</require>
                      <require>libobasis4.3-ogltrans</require>
                      <require>libobasis4.3-onlineupdate</require>
                      <require>libobasis4.3-ooofonts</require>
                      <require>libobasis4.3-ooolinguistic</require>
                      <require>libobasis4.3-postgresql-sdbc</require>
                      <require>libobasis4.3-python-script-provider</require>
                      <require>libobasis4.3-pyuno</require>
                      <require>libobasis4.3-writer</require>
                      <require>libobasis4.3-xsltfilter</require>

                    </requires>
                    <mappings>
                      <mapping>
                        <directory>/var/lib/tomcat8/webapps/aon-aio</directory>
                        <filemode>755</filemode>
                        <username>tomcat</username>
                        <groupname>tomcat</groupname>
                        <directoryIncluded>false</directoryIncluded>
                        <sources>
                          <source>
                            <location>target/aon-aio</location>
                            <excludes>
                              <exclude>**/MANIFEST.MF</exclude>
                              <exclude>**/aon.jaas*.jar</exclude>
                              <exclude>**/aon.pool*.jar</exclude>
                              <exclude>**/c3p0*.jar</exclude>
                              <exclude>**/mchange-commons-java*.jar</exclude>
                              <exclude>**/commons-lang*.jar</exclude>
                              <exclude>**/commons-dbutils*.jar</exclude>
                              <exclude>**/qz-print*.jar</exclude>
                            </excludes>
                          </source>
                        </sources>
                      </mapping>
                      <mapping>
                        <directory>/var/lib/tomcat8/webapps/aon-aio/META-INF</directory>
                        <filemode>755</filemode>
                        <username>tomcat</username>
                        <groupname>tomcat</groupname>
                        <directoryIncluded>false</directoryIncluded>
                        <sources>
                          <source>
                            <includes>
                              <include>MANIFEST.MF</include>
                            </includes>
                            <location>src/main/webapp/META-INF</location>
                          </source>
                        </sources>
                      </mapping>
                      <mapping>
                        <directory>/etc/tomcat8/</directory>
                        <filemode>755</filemode>
                        <username>tomcat</username>
                        <groupname>tomcat</groupname>
                        <directoryIncluded>false</directoryIncluded>
			<configuration>noreplace</configuration>
                        <sources>
                          <source>
                            <includes>
                              <include>login.config</include>
                            </includes>
                            <location>src/main/scripts/</location>
                          </source>
                        </sources>
                      </mapping>
                      <mapping>
                        <directory>/etc/aon-aio/</directory>
                        <configuration>noreplace</configuration>
                        <filemode>755</filemode>
                        <username>tomcat</username>
                        <groupname>tomcat</groupname>
                        <sources>
                          <source>
                            <includes>
                              <include>connection</include>
                              <include>default.pool-properties</include>
                              <include>pro-aonsolutions-net.pool-properties</include>
                            </includes>
                            <location>src/main/scripts/</location>
                          </source>
                        </sources>
                      </mapping>
                      <mapping>
                        <directory>/usr/share/java/tomcat8/</directory>
                        <filemode>755</filemode>
                        <username>tomcat</username>
                        <groupname>tomcat</groupname>
                        <dependency>
                          <includes>
                            <include>com.code.aon:aon.jaas:${project.version}</include>
                            <include>com.code.aon:aon.pool:${project.version}</include>
                            <include>com.mchange:c3p0:0.9.2</include>
                            <include>com.mchange:mchange-commons-java:0.2.3.3</include>
                            <include>commons-lang:commons-lang:2.5</include>
                            <include>commons-dbutils:commons-dbutils:1.5</include>
                          </includes>
                        </dependency>
                        <sources>
                          <softlinkSource>
                            <location>/usr/share/java/slf4j/api.jar</location>
                            <destination>slf4j-api.jar</destination>
                          </softlinkSource>
                          <softlinkSource>
                            <location>/usr/share/java/slf4j/jdk14.jar</location>
                            <destination>slf4j-jdk14.jar</destination>
                          </softlinkSource>
                          <softlinkSource>
                            <location>/usr/share/java/commons-logging-api.jar</location>
                            <destination>commons-logging-api.jar</destination>
                          </softlinkSource>
                          <softlinkSource>
                            <location>/usr/share/java/mysql-connector-java.jar</location>
                            <destination>mysql-connector-java.jar</destination>
                          </softlinkSource>
                        </sources>
                      </mapping>
                      <mapping>
                        <directory>/usr/share/java/</directory>
                        <filemode>755</filemode>
                        <username>root</username>
                        <groupname>root</groupname>
                        <dependency>
                          <includes>
                            <include>com.qzindustries:qz-print:1.8.0</include>
                          </includes>
                        </dependency>
                        <sources>
                          <softlinkSource>
                            <location>/usr/share/java/qz-print-1.8.0.jar</location>
                            <destination>qz-print.jar</destination>
                          </softlinkSource>
                        </sources>
                      </mapping>
                      <mapping>
                        <directory>/usr/share/java/</directory>
                        <filemode>755</filemode>
                        <username>root</username>
                        <groupname>root</groupname>
                        <directoryIncluded>false</directoryIncluded>
                        <sources>
                          <source>
                            <includes>
                              <include>qz-print_jnlp.jnlp</include>
                            </includes>
                            <location>src/main/scripts/</location>
                          </source>
                        </sources>
                      </mapping>
                    </mappings>
                    <postinstallScriptlet>
                      <scriptFile>src/main/scripts/postinstall_tomcat8.sh</scriptFile>
                      <fileEncoding>utf-8</fileEncoding>
                    </postinstallScriptlet>
                  </configuration>
                </execution>
              </executions>
            </plugin>
          </plugins>
        </pluginManagement>
      </build>
    </profile>
  </profiles>
</project>
