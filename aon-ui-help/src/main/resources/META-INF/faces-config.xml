<faces-config version="1.2"
	xmlns="http://java.sun.com/xml/ns/javaee"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://java.sun.com/xml/ns/javaee http://java.sun.com/xml/ns/javaee/web-facesconfig_1_2.xsd">

	<!-- **** HELP CONTROLLER **** -->
	<managed-bean id="help">
		<managed-bean-name>help</managed-bean-name>
		<managed-bean-class>com.code.aon.ui.help.controller.HelpController</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
	</managed-bean>

	<!-- VIMEO -->
	<managed-bean>
		<managed-bean-name>vimeo</managed-bean-name>
		<managed-bean-class>com.code.aon.web.help.service.vimeo.VimeoService</managed-bean-class>
		<managed-bean-scope>request</managed-bean-scope>
	</managed-bean>


	<!-- *************** HELP SWITCHER ***************** -->
	<managed-bean>
		<managed-bean-name>helpSwitcher</managed-bean-name>
		<managed-bean-class>com.code.aon.ui.help.controller.HelpSwitcher</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
		<managed-property>
			<property-name>beanName</property-name>
			<value>helpSwitcher</value>
		</managed-property>
		<managed-property>
			<property-name>pageLimit</property-name>
			<value>11</value>
		</managed-property>
	</managed-bean>


	<!-- =================== Application Menu Navigation Rules ================= -->

	<navigation-rule>
		<navigation-case>
			<from-outcome>main_help</from-outcome>
			<to-view-id>/com/code/aon/web/help/main_help.xhtml</to-view-id>
		</navigation-case>
	</navigation-rule>


</faces-config>
