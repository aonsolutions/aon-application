<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE log4j:configuration SYSTEM "log4j.dtd">
<log4j:configuration>

	<!-- ================================= -->
	<!-- Preserve messages in a local file -->
	<!-- ================================= -->
	<appender name="console" class="org.apache.log4j.ConsoleAppender">
		<layout class="org.apache.log4j.PatternLayout">
			<param name="ConversionPattern" value="%-5p  %c %F(%M:%L) %d{dd.MM.yyyy HH:mm:ss}  %m%n" />
		</layout>
	</appender>

	<appender name="sync-log-debug" class="org.apache.log4j.DailyRollingFileAppender">
		<param name="File" value="${catalina.home}/log/ecm.log"/>
		<param name="Append" value="true" />
		<param name="Threshold" value="DEBUG" />
		<!--param name="MaxFileSize" value="200KB" / -->
		<!--param name="MaxBackupIndex" value="1" / -->
		<layout class="org.apache.log4j.PatternLayout">
			<param name="ConversionPattern" value="%d %-5p [%c %F(%M:%L)] %m%n"/>
		</layout>
	</appender>

	<appender name="log-debug" class="org.apache.log4j.AsyncAppender">
		<appender-ref ref="sync-log-debug" />
	</appender>

   <appender name="SMTP" class="org.apache.log4j.net.SMTPAppender">
     <errorHandler class="org.jboss.logging.util.OnlyOnceErrorHandler"/>
     <param name="Threshold" value="ERROR"/>
     <param name="To" value="ecastellano@co-de.com"/>
     <param name="From" value="iayerbe@co-de.com"/>
     <param name="Subject" value="JBoss Sever Errors"/>
     <param name="SMTPHost" value="192.168.2.190"/>
     <param name="BufferSize" value="10"/>
     <layout class="org.apache.log4j.PatternLayout">
       <param name="ConversionPattern" value="[%d{ABSOLUTE},%c{1}] %m%n"/>
     </layout>
   </appender>

	<!-- ================ -->
	<!-- Limit categories -->
	<!-- ================ -->
	<!-- log for external libraries is set to WARN -->
	<category name="org">
		<priority value="WARN" />
	</category>
	<category name="com">
		<priority value="WARN" />
	</category>
	<category name="org.apache.jackrabbit">
		<priority value="WARN" />
	</category>
	<category name="net.sf.jmimemagic">
		<priority value="WARN" />
	</category>
	<category name="es.code">
		<priority value="DEBUG" />
	</category>

	<!-- ======================= -->
	<!-- Setup the Root category -->
	<!-- ======================= -->
	<root>
		<priority value="ALL" />
		<appender-ref ref="console" />
		<appender-ref ref="log-debug" />
		<!--  appender-ref ref="SMTP" / -->
	</root>

</log4j:configuration>