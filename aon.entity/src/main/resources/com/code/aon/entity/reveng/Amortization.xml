<table name="amortization">
	<foreign-key constraint-name="FK_AMORTIZATION_FIX_ACCOUNT">
		<many-to-one property="fixedAssetAccount" />
	</foreign-key>
	<foreign-key constraint-name="FK_AMORTIZATION_ACC_ACCOUNT">
		<many-to-one property="accumulatedAccount" />
	</foreign-key>
	<foreign-key constraint-name="FK_AMORTIZATION_ALL_ACCOUNT">
		<many-to-one property="allocationAccount" />
	</foreign-key>
</table>
