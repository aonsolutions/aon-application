<?xml version="1.0" encoding="UTF-8" ?>
<config
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xmlns="http://www.esferalia.com/common" >
	
	<config:config version="1.1" xmlns:config="http://www.esferalia.com/config" >
		<config:series
			showOfferData="false"
			showSalesData="false"
			showDeliveryData="false"
			showInvoiceData="false"
			showTasData="false"
		/>
	</config:config>	

	<company:config version="1.4" xmlns:company="http://www.esferalia.com/company">
		<company:company 
			showRegistryBank="false" 
			showCompanyOtherData="false"
			showPanelTabSet="true" 
			showEInvoice="false"
			showDigitalCertificate="false"
			showDirStaff="false"
		/>
		<company:enterprise 
			showFinanceData="false" 
			showAddInfo="true"
			showDirStaff="false"
			standalone="false"
			showEnterpriseParams="false"
			showPayrollData="false"
			showPersonInSearch="false"
		/>		
	</company:config>
	
	<webmail:config version="1.2" xmlns:webmail="http://www.esferalia.com/webmail" >
		<webmail:webmail
			connect="true"
			showDomainMailAccounts="false"
		/>
	</webmail:config>	

</config>
