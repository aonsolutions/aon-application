<?xml version="1.0"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
	<parent>
		<groupId>com.code.aon</groupId>
		<artifactId>aon.parent</artifactId>
		<version>8.114</version>
	</parent>
	<modelVersion>4.0.0</modelVersion>
	<artifactId>aon.audabridge.api</artifactId>
	<name>AON AUDABRIDGE API</name>
	<build>
		<plugins>
			<plugin>
				<groupId>org.jvnet.jax-ws-commons</groupId>
				<artifactId>jaxws-maven-plugin</artifactId>
				<version>2.2</version>
				<executions>
					<execution>
						<goals>
							<goal>wsimport</goal>
						</goals>
						<configuration>
<!-- 						
							<wsdlUrls>
								<wsdlUrl>http://audabridge.audatex.es/AudaBridge/services/AudaBridge?wsdl</wsdlUrl>
							</wsdlUrls>
 -->
 							<wsdlDirectory>src/main/wsdl</wsdlDirectory>
							<wsdlFiles>
         						<wsdlFile>AudaBridge.wsdl</wsdlFile>
							</wsdlFiles>
							<packageName>com.code.aon.audabridge</packageName>
						</configuration>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build> 
</project>
 
