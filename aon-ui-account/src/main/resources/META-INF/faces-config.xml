<faces-config version="1.2"
xmlns="http://java.sun.com/xml/ns/javaee"
xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
xsi:schemaLocation="http://java.sun.com/xml/ns/javaee http://java.sun.com/xml/ns/javaee/web-facesconfig_1_2.xsd">

  <!--  *************** COLLECTIONS ***************** -->
  <managed-bean>
    <managed-bean-name>accountCollections</managed-bean-name>
    <managed-bean-class>
    com.code.aon.ui.account.controller.AccountCollectionsController</managed-bean-class>
    <managed-bean-scope>session</managed-bean-scope>
  </managed-bean>
  <!-- **************** ACCOUNT ************************** -->
  <managed-bean>
    <managed-bean-name>account</managed-bean-name>
    <managed-bean-class>
    com.code.aon.ui.account.controller.AccountController</managed-bean-class>
    <managed-bean-scope>session</managed-bean-scope>
    <managed-property>
      <property-name>queryOnStartUP</property-name>
      <value>true</value>
    </managed-property>
    <managed-property>
      <property-name>pojo</property-name>
      <value>com.code.aon.account.Account</value>
    </managed-property>
    <managed-property>
      <property-name>beanName</property-name>
      <value>account</value>
    </managed-property>
    <managed-property>
      <property-name>listenerClasses</property-name>
      <list-entries>
        <value-class>
        com.code.aon.ui.form.event.IControllerListener</value-class>
        <value>#{accountControllerListener}</value>
        <value>#{accountAppParamsControllerListener}</value>
      </list-entries>
    </managed-property>
    <managed-property>
      <property-name>optionalListenerClasses</property-name>
      <value>#{accountOptionalListeners}</value>
    </managed-property>
  </managed-bean>
  <managed-bean>
    <managed-bean-name>
    accountAppParamsControllerListener</managed-bean-name>
    <managed-bean-class>
    com.code.aon.ui.account.event.AccountAppParamsControllerListener</managed-bean-class>
    <managed-bean-scope>none</managed-bean-scope>
  </managed-bean>
  <managed-bean>
    <managed-bean-name>
    accountControllerListener</managed-bean-name>
    <managed-bean-class>
    com.code.aon.ui.account.event.AccountControllerListener</managed-bean-class>
    <managed-bean-scope>none</managed-bean-scope>
  </managed-bean>
  <managed-bean>
    <managed-bean-name>accountOptionalListeners</managed-bean-name>
    <managed-bean-class>java.util.LinkedList</managed-bean-class>
    <managed-bean-scope>none</managed-bean-scope>
  </managed-bean>
  <!-- ************ ACCOUNT LOOKUP ************** -->
  <managed-bean>
    <managed-bean-name>accountLookup</managed-bean-name>
    <managed-bean-class>com.code.aon.ui.account.controller.AccountRichLookupBean</managed-bean-class>
    <managed-bean-scope>session</managed-bean-scope>
    <managed-property>
      <property-name>beanName</property-name>
      <value>accountLookup</value>
    </managed-property>
    <managed-property>
      <property-name>foreignPojo</property-name>
      <value>com.code.aon.account.Account</value>
    </managed-property>
    <managed-property>
      <property-name>defaultOrder</property-name>
      <value>Account_code</value>
    </managed-property>
    <managed-property>
      <property-name>defaultExpressions</property-name>
      <map-entries>
      	<map-entry>
      		<key>Account_entryEnabled</key>
      		<value>true</value>
      	</map-entry>
      	<map-entry>
      		<key>Account_active</key>
      		<value>true</value>
      	</map-entry>
      </map-entries>
    </managed-property>
	<managed-property>
		<property-name>suggestAlias</property-name>
		<value>Account_description</value>
	</managed-property>
    <managed-property>
      <property-name>listPagePath</property-name>
      <value>/com/code/aon/ui/account/facelet/account/listContent.xhtml</value>
    </managed-property>
    <managed-property>
      <property-name>searchPagePath</property-name>
      <value>/com/code/aon/ui/account/facelet/lookup/account/search.xhtml</value>
    </managed-property>
    <managed-property>
      <property-name>newPagePath</property-name>
      <value>/com/code/aon/ui/account/facelet/account/formNewContent.xhtml</value>
    </managed-property>
  </managed-bean>
  <!--  ********* ACCOUNT EXPORTER  ***************** -->
  <managed-bean>
    <managed-bean-name>accountExporter</managed-bean-name>
    <managed-bean-class>
    com.code.aon.ui.account.controller.AccountExporter</managed-bean-class>
    <managed-bean-scope>session</managed-bean-scope>
  </managed-bean>
  <!--  ********* ACCOUNT IMPORTER  ***************** -->
  <managed-bean>
    <managed-bean-name>accountImporter</managed-bean-name>
    <managed-bean-class>
    com.code.aon.ui.account.controller.AccountImporter</managed-bean-class>
    <managed-bean-scope>session</managed-bean-scope>
  </managed-bean>
  
   <!--  ********* PGC EXPORT GWT CONTROLLER  ***************** -->
  <managed-bean>
		<managed-bean-name>pgcExport</managed-bean-name>
		<managed-bean-class>com.code.aon.ui.account.controller.PGCExportGwtController</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
	</managed-bean>
  <!-- ****************************************** -->
  <!-- ******** NAVIGATION RULES **************** -->
  <!-- ****************************************** -->
  <!-- ****************** ACCOUNT **************** -->
  <navigation-rule>
    <navigation-case>
      <from-outcome>account_form</from-outcome>
      <to-view-id>
      /com/code/aon/ui/account/facelet/account/form.xhtml</to-view-id>
    </navigation-case>
    <navigation-case>
      <from-outcome>account_list</from-outcome>
      <to-view-id>
      /com/code/aon/ui/account/facelet/account/list.xhtml</to-view-id>
    </navigation-case>
    <navigation-case>
      <from-outcome>account_search</from-outcome>
      <to-view-id>
      /com/code/aon/ui/account/facelet/account/search.xhtml</to-view-id>
    </navigation-case>
  </navigation-rule>
  <!-- ****************** ACCOUNT EXPORTER **************** -->
  <navigation-rule>
    <navigation-case>
      <from-outcome>accountExporter_form</from-outcome>
      <to-view-id>
      /com/code/aon/ui/account/facelet/account/exporter/form.xhtml</to-view-id>
    </navigation-case>
  </navigation-rule>
  <!-- ****************** ACCOUNT IMPORTER **************** -->
  <navigation-rule>
    <navigation-case>
      <from-outcome>accountImporter_form</from-outcome>
      <to-view-id>
      /com/code/aon/ui/account/facelet/account/importer/form.xhtml</to-view-id>
    </navigation-case>
  </navigation-rule>
</faces-config>
