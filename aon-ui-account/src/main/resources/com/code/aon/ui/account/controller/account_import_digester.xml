<?xml version="1.0" encoding="ISO-8859-1"?>

<digester-rules>

	<object-create-rule pattern="*/accounts"
		classname="com.code.aon.ui.account.controller.AccountImporterManager" />

	<pattern value="*/account">
		<object-create-rule
			classname="com.code.aon.account.Account" />

		<call-method-rule pattern="id" methodname="setId" paramcount="0" />
		<call-method-rule pattern="description" methodname="setDescription" paramcount="0" />
		<call-method-rule pattern="alias" methodname="setAlias" paramcount="0" />

		<set-next-rule methodname="addAccount" />
	</pattern>

</digester-rules>