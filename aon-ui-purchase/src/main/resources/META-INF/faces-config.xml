<faces-config version="1.2"
	xmlns="http://java.sun.com/xml/ns/javaee"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://java.sun.com/xml/ns/javaee http://java.sun.com/xml/ns/javaee/web-facesconfig_1_2.xsd">

	<!--  *************** COLLECTIONS ***************** -->
	<managed-bean>
		<managed-bean-name>purchaseCollections</managed-bean-name>
		<managed-bean-class>
			com.code.aon.ui.purchase.controller.PurchaseCollectionsController
		</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
	</managed-bean>

	<!--  *************** REPORT ***************** -->
	<managed-bean>
		<managed-bean-name>purchaseReport</managed-bean-name>
		<managed-bean-class>
			com.code.aon.ui.purchase.controller.PurchaseReportManager
		</managed-bean-class>
		<managed-bean-scope>request</managed-bean-scope>
	</managed-bean>
	
	<!-- ****** PURCHASE ****** -->
	<managed-bean>
		<managed-bean-name>purchase</managed-bean-name>
		<managed-bean-class>
			com.code.aon.ui.purchase.controller.PurchaseController
		</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
		<managed-property>
			<property-name>pojo</property-name>
			<value>com.code.aon.purchase.Purchase</value>
		</managed-property>
		<managed-property>
			<property-name>beanName</property-name>
			<value>purchase</value>
		</managed-property>
		<managed-property>
			<property-name>defaultOrder</property-name>
			<value>Purchase_issueDate desc,Purchase_series desc,Purchase_number desc</value>
		</managed-property>
		<managed-property>
			<property-name>listenerClasses</property-name>
			<list-entries>
				<value-class>
					com.code.aon.ui.form.event.IControllerListener
				</value-class>
				<value>#{purchaseSearch}</value>
				<value>#{purchaseScopeListener}</value>
				<value>#{purchaseHeaderControllerListener}</value>
				<value>#{purchaseControllerListener}</value>
				<value>#{purchaseDetailChildListener}</value>
				<value>#{nullableBankAccountValidatorListener}</value>
			</list-entries>
		</managed-property>
		<managed-property>
			<property-name>emailControllerListenerClasses</property-name>
			<value>#{purchaseEmailOptionalListeners}</value>
		</managed-property>
	</managed-bean>
	
	<managed-bean>
		<managed-bean-name>purchaseEmailOptionalListeners</managed-bean-name>
	    <managed-bean-class>java.util.LinkedList</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
	</managed-bean>

	<managed-bean>
		<managed-bean-name>purchaseSearch</managed-bean-name>
		<managed-bean-class>
			com.code.aon.ui.purchase.event.PurchaseSearchListener
		</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
	</managed-bean>

	<managed-bean>
		<managed-bean-name>purchaseScopeListener</managed-bean-name>
		<managed-bean-class>com.code.aon.ui.config.event.ScopeFilterListener</managed-bean-class>
		<managed-bean-scope>none</managed-bean-scope>
		<managed-property>
			<property-name>aliasName</property-name>
			<value>Purchase_scope_id</value>
		</managed-property>
	</managed-bean>
	
 	<managed-bean>
		<managed-bean-name>purchaseHeaderControllerListener</managed-bean-name>
		<managed-bean-class>com.code.aon.ui.config.event.HeaderControllerListener</managed-bean-class>
		<managed-bean-scope>none</managed-bean-scope>
	</managed-bean>	
	
	<managed-bean>
		<managed-bean-name>purchaseControllerListener</managed-bean-name>
		<managed-bean-class>
			com.code.aon.ui.purchase.event.PurchaseControllerListener
		</managed-bean-class>
		<managed-bean-scope>none</managed-bean-scope>
	</managed-bean>

	<managed-bean>
		<managed-bean-name>purchaseDetailChildListener</managed-bean-name>
		<managed-bean-class>
			com.code.aon.ui.form.listener.LinesControllerListener
		</managed-bean-class>
		<managed-bean-scope>none</managed-bean-scope>
		<managed-property>
			<property-name>childBean</property-name>
			<value>purchaseDetail</value>
		</managed-property>
		<managed-property>
			<property-name>aliasMap</property-name>
			<map-entries>
				<map-entry>
					<key>PurchaseDetail_purchase_id</key>
                    <value>id</value>
				</map-entry>
			</map-entries>
		</managed-property>
	</managed-bean>

	<!-- ****** PURCHASE DETAIL ****** -->
	<managed-bean>
		<managed-bean-name>purchaseDetail</managed-bean-name>
		<managed-bean-class>
			com.code.aon.ui.purchase.controller.PurchaseDetailController
		</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
		<managed-property>
			<property-name>pageLimit</property-name>
			<value>-1</value>
		</managed-property>
		<managed-property>
			<property-name>pojo</property-name>
			<value>com.code.aon.purchase.PurchaseDetail</value>
		</managed-property>
		<managed-property>
			<property-name>beanName</property-name>
			<value>purchaseDetail</value>
		</managed-property>
		<managed-property>
			<property-name>defaultOrder</property-name>
			<value>PurchaseDetail_line</value>
		</managed-property>
		<managed-property>
			<property-name>masterControllerName</property-name>
			<value>purchase</value>
		</managed-property>
		<managed-property>
			<property-name>propertyMap</property-name>
			<map-entries>
				<map-entry>
					<key>id</key>
					<value>purchase.id</value>
				</map-entry>
			</map-entries>
		</managed-property>
		<managed-property>
			<property-name>cascadeDelete</property-name>
			<value>true</value>
		</managed-property>
		<managed-property>
			<property-name>listenerClasses</property-name>
			<list-entries>
				<value-class>com.code.aon.ui.form.event.IControllerListener</value-class>
				<value>#{purchaseDetailControllerListener}</value>
				<value>#{purchaseDetailCompositeListener}</value>
			</list-entries>
		</managed-property>
	</managed-bean>
	
	<managed-bean>
		<managed-bean-name>purchaseDetailControllerListener</managed-bean-name>
		<managed-bean-class>
			com.code.aon.ui.purchase.event.PurchaseDetailControllerListener
		</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
	</managed-bean>
	
	<managed-bean>
		<managed-bean-name>purchaseDetailCompositeListener</managed-bean-name>
		<managed-bean-class>
			com.code.aon.ui.purchase.event.PurchaseDetailCompositeListener
		</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
	</managed-bean>
	
	<!-- ************ PURCHASE PRINT ************* -->
	<managed-bean>
		<managed-bean-name>purchasePrint</managed-bean-name>
		<managed-bean-class>
			com.code.aon.ui.purchase.controller.PurchasePrintController
		</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
		<managed-property>
			<property-name>pojo</property-name>
			<value>com.code.aon.purchase.Purchase</value>
		</managed-property>
		<managed-property>
			<property-name>beanName</property-name>
			<value>purchasePrint</value>
		</managed-property>
		<managed-property>
			<property-name>defaultOrder</property-name>
			<value>Purchase_issueDate desc</value>
		</managed-property>										
		<managed-property>
			<property-name>listenerClasses</property-name>
			<list-entries>
				<value-class>
					com.code.aon.ui.form.event.IControllerListener
				</value-class>
				<value>#{purchasePrintSearch}</value>
			</list-entries>
		</managed-property>		
		<managed-property>
			<property-name>emailControllerListenerClasses</property-name>
			<value>#{purchasePrintEmailOptionalListeners}</value>
		</managed-property>
	</managed-bean>

	<managed-bean>
		<managed-bean-name>purchasePrintSearch</managed-bean-name>
		<managed-bean-class>
			com.code.aon.ui.purchase.event.PurchaseSearchListener
		</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
	</managed-bean>
	
	<managed-bean>
		<managed-bean-name>purchasePrintEmailOptionalListeners</managed-bean-name>
	    <managed-bean-class>java.util.LinkedList</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
	</managed-bean>
	
	<!-- ************* PURCHASE PROPOSAL ***************** -->
	<managed-bean>
		<managed-bean-name>proposal</managed-bean-name>
		<managed-bean-class>com.code.aon.ui.purchase.controller.ProposalController</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
		<managed-property>
			<property-name>queryOnStartUP</property-name>
			<value>true</value>
		</managed-property>
		<managed-property>
			<property-name>pojo</property-name>
			<value>com.code.aon.purchase.Proposal</value>
		</managed-property>
		<managed-property>
			<property-name>beanName</property-name>
			<value>proposal</value>
		</managed-property>		
		<managed-property>
			<property-name>defaultOrder</property-name>
			<value>Proposal_issueDate</value>
		</managed-property>
		<managed-property>
			<property-name>listenerClasses</property-name>
			<list-entries>
				<value-class>com.code.aon.ui.form.event.IControllerListener</value-class>
				<value>#{proposalControllerListener}</value>
				<value>#{proposalSearch}</value>
				<value>#{proposalDetailListener}</value>
			</list-entries>
		</managed-property>				
	</managed-bean>
	
	<managed-bean>
		<managed-bean-name>proposalControllerListener</managed-bean-name>
		<managed-bean-class>com.code.aon.ui.purchase.event.ProposalControllerListener</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
	</managed-bean>
	
	<managed-bean>
		<managed-bean-name>proposalSearch</managed-bean-name>
		<managed-bean-class>com.code.aon.ui.purchase.event.ProposalSearchListener</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
	</managed-bean>
	
	<managed-bean>
		<managed-bean-name>proposalDetailListener</managed-bean-name>
		<managed-bean-class>com.code.aon.ui.form.listener.LinesControllerListener</managed-bean-class>
		<managed-bean-scope>none</managed-bean-scope>
		<managed-property>
			<property-name>childBean</property-name>
			<value>proposalDetail</value>
		</managed-property>
		<managed-property>
			<property-name>aliasMap</property-name>
			<map-entries>
				<map-entry>
					<key>ProposalDetail_proposal_id</key>
                    <value>id</value>
				</map-entry>
			</map-entries>
		</managed-property>
	</managed-bean>
	
	<!-- ************* PURCHASE PROPOSAL DETAIL ***************** -->
	<managed-bean>
		<managed-bean-name>proposalDetail</managed-bean-name>
		<managed-bean-class>com.code.aon.ui.purchase.controller.ProposalDetailController</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
		<managed-property>
			<property-name>queryOnStartUP</property-name>
			<value>true</value>
		</managed-property>
		<managed-property>
			<property-name>pojo</property-name>
			<value>com.code.aon.purchase.ProposalDetail</value>
		</managed-property>
		<managed-property>
			<property-name>beanName</property-name>
			<value>proposalDetail</value>
		</managed-property>		
		<managed-property>
			<property-name>pageLimit</property-name>
			<value>-1</value>
		</managed-property>
		<managed-property>
			<property-name>defaultOrder</property-name>
			<value>ProposalDetail_id</value>
		</managed-property>			
		<managed-property>
			<property-name>cascadeDelete</property-name>
			<value>true</value>
		</managed-property>
		<managed-property>
			<property-name>masterControllerName</property-name>
			<value>proposal</value>
		</managed-property>
		<managed-property>
			<property-name>propertyMap</property-name>
			<map-entries>
				<map-entry>
					<key>id</key>
					<value>proposal.id</value>
				</map-entry>
			</map-entries>
		</managed-property>	
		<managed-property>
			<property-name>listenerClasses</property-name>
			<list-entries>
				<value-class>com.code.aon.ui.form.event.IControllerListener</value-class>
				<value>#{proposalDetailControllerListener}</value>
			</list-entries>
		</managed-property>				
	</managed-bean>
	
	<managed-bean>
		<managed-bean-name>proposalDetailControllerListener</managed-bean-name>
		<managed-bean-class>com.code.aon.ui.purchase.event.ProposalDetailControllerListener</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
	</managed-bean>
	
	<!-- ************* PURCHASE PROPOSAL ORDER ***************** -->
	<managed-bean>
		<managed-bean-name>purchaseOrder</managed-bean-name>
		<managed-bean-class>com.code.aon.ui.purchase.controller.PurchaseOrderController</managed-bean-class>
		<managed-bean-scope>session</managed-bean-scope>
		<managed-property>
			<property-name>beanName</property-name>
			<value>purchaseOrder</value>
		</managed-property>				
	</managed-bean>
	
	
   	<!-- ************************************************ -->
   	<!-- ************* NAVIGATION RULES ***************** -->
   	<!-- ************************************************ -->
	<navigation-rule>
		<navigation-case>
			<from-outcome>purchase_list</from-outcome>
			<to-view-id>/com/code/aon/ui/purchase/facelet/purchase/list.xhtml</to-view-id>
		</navigation-case>
		<navigation-case>
			<from-outcome>purchase_form</from-outcome>
			<to-view-id>/com/code/aon/ui/purchase/facelet/purchase/form.xhtml</to-view-id>
		</navigation-case>
		<navigation-case>
			<from-outcome>purchase_search</from-outcome>
			<to-view-id>/com/code/aon/ui/purchase/facelet/purchase/search.xhtml</to-view-id>
		</navigation-case>
	</navigation-rule>
	
	<!-- =================== Purchase Print ========================== -->
	<navigation-rule>
		<navigation-case>
			<from-outcome>purchasePrint_search</from-outcome>
			<to-view-id>/com/code/aon/ui/purchase/facelet/purchasePrint/search.xhtml</to-view-id>
		</navigation-case>
		<navigation-case>
			<from-outcome>purchasePrint_list</from-outcome>
			<to-view-id>/com/code/aon/ui/purchase/facelet/purchasePrint/list.xhtml</to-view-id>
		</navigation-case>
	</navigation-rule>
	
	<!-- =================== Purchase proposal ================= -->
	<navigation-rule>
		<navigation-case>
			<from-outcome>proposal_search</from-outcome>
			<to-view-id>/com/code/aon/ui/purchase/facelet/proposal/search.xhtml</to-view-id>
		</navigation-case>
		<navigation-case>
			<from-outcome>proposal_list</from-outcome>
			<to-view-id>/com/code/aon/ui/purchase/facelet/proposal/list.xhtml</to-view-id>
		</navigation-case>
		<navigation-case>
			<from-outcome>proposal_form</from-outcome>
			<to-view-id>/com/code/aon/ui/purchase/facelet/proposal/form.xhtml</to-view-id>
		</navigation-case>
	</navigation-rule> 		
	
	<!-- =================== Purchase order ================= -->
	<navigation-rule>
		<navigation-case>
			<from-outcome>purchaseOrder_list</from-outcome>
			<to-view-id>/com/code/aon/ui/purchase/facelet/purchaseOrder/list.xhtml</to-view-id>
		</navigation-case>
		<navigation-case>
			<from-outcome>purchaseOrder_grid</from-outcome>
			<to-view-id>/com/code/aon/ui/purchase/facelet/purchaseOrder/grid.xhtml</to-view-id>
		</navigation-case>
	</navigation-rule> 		
	
</faces-config>